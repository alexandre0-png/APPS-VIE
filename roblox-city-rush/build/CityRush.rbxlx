]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[--[[
	Util.lua : petites fonctions pures partagées.
]]

local Util = {}

function Util.formatCash(n)
	n = math.floor(n or 0)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	out = out:gsub("^%s+", "")
	return (n < 0 and "-" or "") .. out .. " $"
end

function Util.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Util.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function Util.flatDistance(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

function Util.moveToward(current, target, maxDelta)
	if math.abs(target - current) <= maxDelta then
		return target
	end
	return current + math.sign(target - current) * maxDelta
end

-- Mini signal (pas de dépendance à BindableEvent => pas de copie profonde des arguments)
local Signal = {}
Signal.__index = Signal

function Util.newSignal()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handler = { fn = fn }
	table.insert(self._handlers, handler)
	return {
		Disconnect = function()
			local i = table.find(self._handlers, handler)
			if i then
				table.remove(self._handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, h in ipairs(table.clone(self._handlers)) do
		task.spawn(h.fn, ...)
	end
end

-- Choix pondéré dans une liste {{id=..., weight=...}}
function Util.weightedPick(list, rng)
	local total = 0
	for _, e in ipairs(list) do
		total += e.weight
	end
	local r = (rng and rng:NextNumber() or math.random()) * total
	for _, e in ipairs(list) do
		r -= e.weight
		if r <= 0 then
			return e
		end
	end
	return list[#list]
end

function Util.deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = Util.deepCopy(v)
	end
	return c
end

-- Complète t avec les valeurs manquantes de defaults (récursif)
function Util.reconcile(t, defaults)
	for k, v in pairs(defaults) do
		if t[k] == nil then
			t[k] = Util.deepCopy(v)
		elseif type(v) == "table" and type(t[k]) == "table" then
			Util.reconcile(t[k], v)
		end
	end
	return t
end

return Util
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX22"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX7"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Main.server.lua : point d'entrée serveur de CITY RUSH.
	Ordre : remotes -> données -> économie -> monde -> services dépendants -> boucles -> apparition des joueurs.
]]

local Players = game:GetService("Players")

Players.CharacterAutoLoads = false
Players.RespawnTime = 3

local Services = script.Parent:WaitForChild("Services")
local RemoteService = require(Services.RemoteService)
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local World = require(Services.WorldService)
local Pedestrians = require(Services.PedestrianService)
local VehicleService = require(Services.VehicleService)
local WantedService = require(Services.WantedService)
local MissionService = require(Services.MissionService)
local CollectibleService = require(Services.CollectibleService)
local EventService = require(Services.EventService)
local LeaderboardService = require(Services.LeaderboardService)
local MonetizationService = require(Services.MonetizationService)

-- Les joueurs peuvent arriver pendant la génération : on gère leur apparition dès maintenant.
local function loadCharacter(player)
	if player.Parent then
		player:LoadCharacter()
	end
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				task.delay(Players.RespawnTime, loadCharacter, player)
			end)
		end
	end)
	task.spawn(function()
		local t = os.clock()
		while player.Parent and (not workspace:GetAttribute("WorldReady") or not DataService.get(player)) and os.clock() - t < 40 do
			task.wait(0.2)
		end
		if not player.Parent then
			return
		end
		loadCharacter(player)
		local profile = DataService.get(player)
		if profile and profile.Stats.joins == 1 then
			-- premier lancement : la Citadine apparaît automatiquement
			task.wait(2.5)
			VehicleService.spawnFor(player, "citadine")
			RemoteService.notify(player, "Bienvenue à CITY RUSH ! Ta Citadine t'attend. Touche G = garage.", "good")
		end
	end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayer(p)
end

RemoteService.init()
DataService.init()
EconomyService.init()
World.build()
Pedestrians.init()
VehicleService.init()
VehicleService.setDependencies(World, Pedestrians, WantedService)
WantedService.init(World)
MissionService.init(World)
CollectibleService.init(World)
MonetizationService.init()

VehicleService.start()
Pedestrians.start()
WantedService.start()
MissionService.start()
CollectibleService.start()
EventService.start(World)
LeaderboardService.start(World)

workspace:SetAttribute("WorldReady", true)
print("[CityRush] Serveur prêt")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX21"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CollectibleService</string><ProtectedString name="Source"><![CDATA[--[[
	CollectibleService : 30 étoiles dorées cachées dans la ville (stockées par joueur).
	Détection par proximité côté serveur (aucune confiance accordée au client).
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local RemoteService = require(script.Parent.RemoteService)
local EconomyService = require(script.Parent.EconomyService)
local DataService = require(script.Parent.DataService)

local CollectibleService = {}

local stars = {} -- { id, pos }
local RADIUS = 9

local function collectedList(profile)
	local list = {}
	for key in pairs(profile.Collected) do
		table.insert(list, tonumber(key))
	end
	table.sort(list)
	return list
end

local function sendList(player)
	local profile = DataService.get(player)
	if profile then
		RemoteService.fire("Collected", player, collectedList(profile), #stars)
	end
end

local function collect(player, profile, id)
	profile.Collected[tostring(id)] = true
	local count = 0
	for _ in pairs(profile.Collected) do
		count += 1
	end
	profile.Stats.collected = count
	local paid = EconomyService.addCash(player, Config.Collectibles.Reward, "star")
	EconomyService.addXP(player, 15)
	RemoteService.notify(player, string.format("Étoile dorée %d/%d  +%s", count, #stars, Util.formatCash(paid)), "star")
	local bonus = Config.Collectibles.Milestones[count]
	if bonus then
		local b = EconomyService.addCash(player, bonus, "milestone")
		RemoteService.notify(player, string.format("Palier %d étoiles ! Bonus %s", count, Util.formatCash(b)), "levelup")
	end
	DataService.markDirty(player)
	EconomyService.checkAchievements(player)
	EconomyService.markState(player)
	sendList(player)
end

function CollectibleService.init(world)
	local folder = Instance.new("Folder")
	folder.Name = "Stars"
	folder.Parent = world.Root

	for i, pos in ipairs(world.StarSpots) do
		local p = Instance.new("Part")
		p.Name = "GoldStar"
		p.Size = Vector3.new(3.4, 3.4, 3.4)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(45), 0, math.rad(45))
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 205, 40)
		p:SetAttribute("StarId", i)
		p.Parent = folder
		game:GetService("CollectionService"):AddTag(p, "GoldStar")
		local light = Instance.new("PointLight")
		light.Color = p.Color
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = p
		table.insert(stars, { id = i, pos = pos })
	end

	DataService.Loaded:Connect(function(player)
		sendList(player)
	end)
	RemoteService.on("RequestState", 1, nil, sendList)
end

function CollectibleService.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in ipairs(Players:GetPlayers()) do
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local profile = DataService.get(player)
				if hrp and profile then
					local pos = hrp.Position
					for _, s in ipairs(stars) do
						if (s.pos - pos).Magnitude < RADIUS and not profile.Collected[tostring(s.id)] then
							collect(player, profile, s.id)
						end
					end
				end
			end
		end
	end)
end

return CollectibleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService : chargement / sauvegarde des profils joueurs (DataStore).
	- Verrou de session (JobId) pour éviter la duplication entre serveurs
	- Réessais avec pcall, sauvegarde automatique, sauvegarde à la fermeture
	- Mode temporaire (Studio sans API / échec) : le joueur peut jouer, rien n'est écrasé
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}
DataService.Loaded = Util.newSignal() -- (player, profile)
DataService.Removing = Util.newSignal() -- (player, profile) avant sauvegarde finale

local LOCK_TIMEOUT = 120
local DEFAULT = {
	Cash = Config.StartCash,
	Level = 1,
	XP = 0,
	Owned = { citadine = true },
	Colors = {}, -- [vehicleId] = {r,g,b}
	Stats = {
		missions = 0, deliveries = 0, taxis = 0, races = 0, heists = 0,
		fiveStars = 0, busted = 0, collected = 0, studs = 0, km = 0, joins = 0, bestRace = 0,
	},
	Collected = {}, -- [tostring(id)] = true
	Achv = {},
	Daily = { day = 0, streak = 0 },
	PeakCash = 0,
}

local store
local board
local profiles = {} -- [player] = {data=..., temp=bool, dirty=bool}
local saving = {}

local function getStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	end
	local ok2, result2 = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.CashBoardName)
	end)
	if ok2 then
		board = result2
	end
end

local function key(player)
	return "Player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return nil, "nostore"
	end
	local attempts = 0
	while attempts < 6 and player.Parent do
		attempts += 1
		local locked = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old)
				old = old or { data = nil }
				if old.job and old.job ~= game.JobId and os.time() - (old.lockTime or 0) < LOCK_TIMEOUT then
					locked = true
					return nil -- annule l'écriture
				end
				old.job = game.JobId
				old.lockTime = os.time()
				return old
			end)
		end)
		if ok and not locked and result then
			return result.data or {}, nil
		elseif ok and locked then
			task.wait(5)
		else
			if not ok then
				warn("[DataService] Chargement échoué:", result)
				if RunService:IsStudio() then
					break -- Studio sans accès API : mode temporaire immédiat
				end
			end
			task.wait(2 + attempts)
		end
	end
	return nil, "failed"
end

local function saveProfile(player, release)
	local p = profiles[player]
	if not p or p.temp or saving[player] then
		return
	end
	saving[player] = true
	local snapshot = Util.deepCopy(p.data)
	local wrote = false
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			old = old or {}
			if old.job and old.job ~= game.JobId and os.time() - (old.lockTime or 0) < LOCK_TIMEOUT then
				return nil -- un autre serveur détient le profil : on n'écrase pas
			end
			old.data = snapshot
			if release then
				old.job = nil
			else
				old.job = game.JobId
			end
			old.lockTime = os.time()
			wrote = true
			return old
		end)
	end)
	if ok and wrote then
		p.dirty = false
	elseif not ok then
		warn("[DataService] Sauvegarde échouée pour", player.Name, err)
	end
	if board and snapshot.PeakCash ~= nil then
		pcall(function()
			board:SetAsync(tostring(player.UserId), math.floor(snapshot.Cash))
		end)
	end
	saving[player] = nil
end

function DataService.get(player)
	local p = profiles[player]
	return p and p.data or nil
end

function DataService.markDirty(player)
	local p = profiles[player]
	if p then
		p.dirty = true
	end
end

function DataService.isTemp(player)
	local p = profiles[player]
	return p ~= nil and p.temp
end

local function onPlayerAdded(player)
	if profiles[player] then
		return
	end
	local raw, reason = loadData(player)
	if not player.Parent then
		return
	end
	local temp = false
	if raw == nil then
		temp = true
		raw = {}
		if reason == "failed" and not RunService:IsStudio() then
			-- Ne pas laisser jouer avec un profil vide qui pourrait masquer la vraie progression
			player:Kick("Impossible de charger tes données. Reviens dans quelques instants !")
			return
		end
	end
	local data = Util.reconcile(raw, DEFAULT)
	data.Stats.joins += 1
	profiles[player] = { data = data, temp = temp, dirty = true }
	DataService.Loaded:Fire(player, data)
end

local function onPlayerRemoving(player)
	local p = profiles[player]
	if not p then
		return
	end
	DataService.Removing:Fire(player, p.data)
	saveProfile(player, true)
	profiles[player] = nil
end

function DataService.init()
	getStore()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	task.spawn(function()
		while true do
			task.wait(Config.SaveInterval)
			for player, p in pairs(profiles) do
				if p.dirty and player.Parent then
					task.spawn(saveProfile, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveProfile(player, true)
				pending -= 1
			end)
		end
		local t = os.clock()
		while pending > 0 and os.clock() - t < 25 do
			task.wait(0.2)
		end
	end)
end

function DataService.saveNow(player)
	saveProfile(player, false)
end

function DataService.getBoard()
	return board
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--[[
	EconomyService : argent, XP/niveaux, statistiques, succès, récompense quotidienne,
	achat de véhicules, état envoyé au client.
	Toutes les modifications d'état passent par ici (autorité serveur).
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent.DataService)
local RemoteService = require(script.Parent.RemoteService)

local EconomyService = {}

local passes = {} -- [player] = { VIP = bool, BOOST = bool }
local stateDirty = {}
EconomyService.DoubleXP = false
EconomyService.LevelUp = Util.newSignal() -- (player, newLevel)

local function profileOf(player)
	return DataService.get(player)
end

local function dailyInfo(profile)
	local today = os.time() // 86400
	local available = profile.Daily.day < today
	local streak = profile.Daily.streak
	if available then
		streak = (profile.Daily.day == today - 1) and (streak + 1) or 1
	end
	local capped = math.min(streak, Config.Daily.MaxStreak)
	return available, streak, Config.Daily.Base + Config.Daily.PerStreak * (capped - 1)
end

function EconomyService.hasPass(player, key)
	return passes[player] ~= nil and passes[player][key] == true
end

function EconomyService.setPass(player, key, value)
	passes[player] = passes[player] or {}
	passes[player][key] = value
	stateDirty[player] = true
end

function EconomyService.canUseVehicle(player, id)
	local profile = profileOf(player)
	local spec = Config.getVehicle(id)
	if not profile or not spec then
		return false
	end
	if spec.gamepass then
		return EconomyService.hasPass(player, spec.gamepass)
	end
	return profile.Owned[id] == true
end

local function buildState(player, profile)
	local daily, streak, reward = dailyInfo(profile)
	local owned = {}
	for _, v in ipairs(Config.Vehicles) do
		if EconomyService.canUseVehicle(player, v.id) then
			owned[v.id] = true
		end
	end
	return {
		Cash = profile.Cash,
		Level = profile.Level,
		XP = profile.XP,
		XPNeed = Config.xpForNext(profile.Level),
		Owned = owned,
		Colors = profile.Colors,
		Stats = profile.Stats,
		Achv = profile.Achv,
		Vip = EconomyService.hasPass(player, "VIP"),
		Boost = EconomyService.hasPass(player, "BOOST"),
		DailyAvailable = daily,
		DailyStreak = streak,
		DailyReward = reward,
		DoubleXP = EconomyService.DoubleXP,
		ServerTime = os.time(),
	}
end

local function updateLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local cash = ls:FindFirstChild("Argent")
	local lvl = ls:FindFirstChild("Niveau")
	if cash then
		cash.Value = math.floor(profile.Cash)
	end
	if lvl then
		lvl.Value = profile.Level
	end
end

function EconomyService.pushState(player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	updateLeaderstats(player, profile)
	RemoteService.fire("State", player, buildState(player, profile))
end

function EconomyService.markState(player)
	stateDirty[player] = true
end

function EconomyService.notify(player, text, kind)
	RemoteService.notify(player, text, kind)
end

-- ====================================================================
-- Argent
-- ====================================================================
function EconomyService.getCash(player)
	local p = profileOf(player)
	return p and p.Cash or 0
end

-- Gain "gagné" : applique le multiplicateur VIP. Retourne le montant réellement crédité.
function EconomyService.addCash(player, amount, reason)
	local profile = profileOf(player)
	if not profile or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	if EconomyService.hasPass(player, "VIP") then
		amount *= 2
	end
	amount = math.floor(amount)
	profile.Cash += amount
	profile.PeakCash = math.max(profile.PeakCash, profile.Cash)
	DataService.markDirty(player)
	stateDirty[player] = true
	return amount
end

-- Crédit brut (achats Robux, remboursements) sans multiplicateur
function EconomyService.grantCashRaw(player, amount)
	local profile = profileOf(player)
	if not profile or amount <= 0 then
		return
	end
	profile.Cash += math.floor(amount)
	profile.PeakCash = math.max(profile.PeakCash, profile.Cash)
	DataService.markDirty(player)
	stateDirty[player] = true
end

function EconomyService.spendCash(player, amount)
	local profile = profileOf(player)
	if not profile or amount < 0 or profile.Cash < amount then
		return false
	end
	profile.Cash -= amount
	DataService.markDirty(player)
	stateDirty[player] = true
	return true
end

-- Retire jusqu'à `amount` (arrestation). Retourne le montant perdu.
function EconomyService.loseCash(player, amount)
	local profile = profileOf(player)
	if not profile then
		return 0
	end
	local lost = math.max(0, math.min(profile.Cash, math.floor(amount)))
	profile.Cash -= lost
	DataService.markDirty(player)
	stateDirty[player] = true
	return lost
end

-- ====================================================================
-- XP / niveau
-- ====================================================================
function EconomyService.addXP(player, amount)
	local profile = profileOf(player)
	if not profile or amount <= 0 then
		return
	end
	if EconomyService.DoubleXP then
		amount *= 2
	end
	profile.XP += math.floor(amount)
	while profile.Level < Config.MaxLevel and profile.XP >= Config.xpForNext(profile.Level) do
		profile.XP -= Config.xpForNext(profile.Level)
		profile.Level += 1
		local bonus = 100 * profile.Level
		profile.Cash += bonus
		RemoteService.notify(player, string.format("NIVEAU %d ! Bonus %s", profile.Level, Util.formatCash(bonus)), "levelup")
		EconomyService.LevelUp:Fire(player, profile.Level)
	end
	if profile.Level >= Config.MaxLevel then
		profile.XP = 0
	end
	DataService.markDirty(player)
	stateDirty[player] = true
end

-- ====================================================================
-- Statistiques & succès
-- ====================================================================
function EconomyService.checkAchievements(player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	for _, a in ipairs(Config.Achievements) do
		if not profile.Achv[a.id] and (profile.Stats[a.stat] or 0) >= a.goal then
			profile.Achv[a.id] = true
			local paid = EconomyService.addCash(player, a.reward, "achievement")
			RemoteService.notify(player, string.format("Succès : %s  (+%s)", a.name, Util.formatCash(paid)), "achv")
			DataService.markDirty(player)
		end
	end
end

function EconomyService.addStat(player, stat, n)
	local profile = profileOf(player)
	if not profile then
		return
	end
	profile.Stats[stat] = (profile.Stats[stat] or 0) + (n or 1)
	DataService.markDirty(player)
	stateDirty[player] = true
	EconomyService.checkAchievements(player)
end

function EconomyService.setStatMax(player, stat, value)
	local profile = profileOf(player)
	if profile and value > (profile.Stats[stat] or 0) then
		profile.Stats[stat] = value
		DataService.markDirty(player)
		EconomyService.checkAchievements(player)
	end
end

function EconomyService.addDistance(player, studs)
	local profile = profileOf(player)
	if not profile or studs <= 0 then
		return
	end
	profile.Stats.studs += studs
	local km = profile.Stats.studs * 0.00028
	if math.floor(km) ~= math.floor(profile.Stats.km) then
		profile.Stats.km = km
		EconomyService.checkAchievements(player)
		stateDirty[player] = true
	else
		profile.Stats.km = km
	end
	DataService.markDirty(player)
end

-- ====================================================================
-- Actions client -> serveur
-- ====================================================================
local function onBuy(player, vehicleId)
	local profile = profileOf(player)
	local spec = Config.getVehicle(vehicleId)
	if not profile or not spec or spec.price <= 0 then
		return
	end
	if profile.Owned[vehicleId] then
		RemoteService.notify(player, "Tu possèdes déjà ce véhicule.", "info")
		return
	end
	if profile.Level < spec.level then
		RemoteService.notify(player, string.format("Niveau %d requis.", spec.level), "bad")
		return
	end
	if not EconomyService.spendCash(player, spec.price) then
		RemoteService.notify(player, "Pas assez d'argent !", "bad")
		return
	end
	profile.Owned[vehicleId] = true
	DataService.markDirty(player)
	RemoteService.notify(player, string.format("Achat : %s !", spec.name), "good")
	EconomyService.pushState(player)
end

local function onColor(player, vehicleId, index)
	local profile = profileOf(player)
	if not profile or not EconomyService.canUseVehicle(player, vehicleId) then
		return
	end
	if index ~= math.floor(index) or index < 1 or index > #Config.VehicleColors then
		return
	end
	profile.Colors[vehicleId] = index
	DataService.markDirty(player)
	stateDirty[player] = true
end

local function onClaimDaily(player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local available, streak, reward = dailyInfo(profile)
	if not available then
		return
	end
	profile.Daily.day = os.time() // 86400
	profile.Daily.streak = streak
	local paid = EconomyService.addCash(player, reward, "daily")
	RemoteService.notify(player, string.format("Récompense quotidienne : %s (série %d)", Util.formatCash(paid), streak), "good")
	DataService.markDirty(player)
	EconomyService.pushState(player)
end

local function setupPlayer(player, profile)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Argent"
	cash.Parent = ls
	local lvl = Instance.new("IntValue")
	lvl.Name = "Niveau"
	lvl.Parent = ls
	ls.Parent = player
	updateLeaderstats(player, profile)
	EconomyService.checkAchievements(player)
	EconomyService.pushState(player)
end

function EconomyService.init()
	DataService.Loaded:Connect(setupPlayer)

	RemoteService.on("RequestBuy", 0.5, function(id)
		return type(id) == "string" and #id < 24
	end, onBuy)
	RemoteService.on("RequestColor", 0.3, function(id, i)
		return type(id) == "string" and #id < 24 and type(i) == "number"
	end, onColor)
	RemoteService.on("ClaimDaily", 1, nil, onClaimDaily)
	RemoteService.on("RequestState", 1, nil, function(player)
		EconomyService.pushState(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		passes[player] = nil
		stateDirty[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			for player in pairs(stateDirty) do
				stateDirty[player] = nil
				if player.Parent then
					EconomyService.pushState(player)
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--[[
	EventService : événements mondiaux récurrents
	- Largage de caisses : des caisses d'argent apparaissent dans la ville, premier arrivé premier servi
	- Heure double XP
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local RemoteService = require(script.Parent.RemoteService)
local EconomyService = require(script.Parent.EconomyService)

local EventService = {}

local rng = Random.new()
local World
local crates = {}

local function randomRoadPoint()
	local line = rng:NextInteger(0, 5)
	local c = -500 + Config.Map.Pitch * line
	local t = rng:NextNumber(-460, 460)
	if rng:NextInteger(0, 1) == 1 then
		return Vector3.new(c, 3, t)
	end
	return Vector3.new(t, 3, c)
end

local function runAirdrop()
	local cfg = Config.Airdrop
	local folder = Instance.new("Folder")
	folder.Name = "Airdrop"
	folder.Parent = World.Root
	local positions = {}
	for _ = 1, cfg.Crates do
		local pos = randomRoadPoint()
		table.insert(positions, pos)
		local crate = Instance.new("Part")
		crate.Name = "AirdropCrate"
		crate.Size = Vector3.new(4, 4, 4)
		crate.Position = pos + Vector3.new(0, 1, 0)
		crate.Anchored = true
		crate.CanCollide = false
		crate.Color = Color3.fromRGB(90, 230, 120)
		crate.Material = Enum.Material.Neon
		crate.Parent = folder
		local beam = Instance.new("Part")
		beam.Size = Vector3.new(120, 2, 2)
		beam.CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		beam.Shape = Enum.PartType.Cylinder
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
		beam.Transparency = 0.7
		beam.Color = crate.Color
		beam.Material = Enum.Material.Neon
		beam.Parent = crate
		table.insert(crates, { part = crate, pos = pos })
	end
	RemoteService.fireAll("Banner", {
		kind = "airdrop",
		text = string.format("LARGAGE DE CAISSES ! %d caisses d'argent dans la ville (%d s)", cfg.Crates, cfg.Duration),
		positions = positions,
		duration = cfg.Duration,
	})
	local t0 = os.clock()
	while os.clock() - t0 < cfg.Duration and #crates > 0 do
		task.wait(0.3)
		for i = #crates, 1, -1 do
			local c = crates[i]
			for _, player in ipairs(Players:GetPlayers()) do
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - c.pos).Magnitude < 10 then
					local paid = EconomyService.addCash(player, cfg.Reward, "airdrop")
					EconomyService.addXP(player, 20)
					RemoteService.notify(player, string.format("Caisse récupérée ! +%s", Util.formatCash(paid)), "good")
					c.part:Destroy()
					table.remove(crates, i)
					break
				end
			end
		end
	end
	for _, c in ipairs(crates) do
		c.part:Destroy()
	end
	crates = {}
	folder:Destroy()
	RemoteService.fireAll("Banner", { kind = "airdrop_end", text = "Largage terminé.", positions = {}, duration = 0 })
end

local function runDoubleXP()
	local cfg = Config.DoubleXP
	EconomyService.DoubleXP = true
	for _, p in ipairs(Players:GetPlayers()) do
		EconomyService.markState(p)
	end
	RemoteService.fireAll("Banner", { kind = "doublexp", text = "HEURE DOUBLE XP ! (5 minutes)", positions = {}, duration = cfg.Duration })
	task.wait(cfg.Duration)
	EconomyService.DoubleXP = false
	for _, p in ipairs(Players:GetPlayers()) do
		EconomyService.markState(p)
	end
end

function EventService.start(world)
	World = world
	task.spawn(function()
		task.wait(150)
		while true do
			if #Players:GetPlayers() > 0 then
				runAirdrop()
			end
			task.wait(rng:NextNumber(Config.Airdrop.MinInterval, Config.Airdrop.MaxInterval))
		end
	end)
	task.spawn(function()
		task.wait(600)
		while true do
			if #Players:GetPlayers() > 0 then
				runDoubleXP()
			end
			task.wait(rng:NextNumber(Config.DoubleXP.MinInterval, Config.DoubleXP.MaxInterval))
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--[[
	LeaderboardService : classement mondial de l'argent (OrderedDataStore)
	affiché sur le panneau de la place centrale et dans le menu Profil.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = require(script.Parent.DataService)
local RemoteService = require(script.Parent.RemoteService)

local LeaderboardService = {}

local names = {}
local latest = {}

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and n or ("Joueur " .. userId)
	return names[userId]
end

local function buildGui(board)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LeaderboardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(880, 480)
	gui.Parent = board
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 60)
	title.BackgroundColor3 = Color3.fromRGB(255, 196, 0)
	title.BorderSizePixel = 0
	title.Text = "TOP 10 - FORTUNES"
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 40
	title.TextColor3 = Color3.fromRGB(20, 22, 30)
	title.Parent = bg
	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Position = UDim2.new(0, 20, 0, 60 + (i - 1) * 41)
		row.Size = UDim2.new(1, -40, 0, 38)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.GothamBold
		row.TextSize = 28
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = i <= 3 and Color3.fromRGB(255, 210, 80) or Color3.fromRGB(235, 235, 240)
		row.Text = ""
		row.Parent = bg
		rows[i] = row
	end
	return rows
end

local function refresh(rows)
	local board = DataService.getBoard()
	if not board then
		return
	end
	local ok, pages = pcall(function()
		return board:GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local ok2, page = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not ok2 then
		return
	end
	latest = {}
	for i, entry in ipairs(page) do
		local userId = tonumber(entry.key)
		local n = userId and nameOf(userId) or "?"
		latest[i] = { name = n, cash = entry.value }
		if rows[i] then
			rows[i].Text = string.format("%d.  %s  -  %s", i, n, Util.formatCash(entry.value))
		end
	end
	for i = #page + 1, 10 do
		if rows[i] then
			rows[i].Text = ""
		end
	end
	RemoteService.fireAll("Leaderboard", latest)
end

function LeaderboardService.start(world)
	local board = world.Root:FindFirstChild("Decor") and nil
	for _, d in ipairs(world.Root:GetDescendants()) do
		if d.Name == "LeaderboardBoard" then
			board = d
			break
		end
	end
	local rows = board and buildGui(board) or {}
	Players.PlayerAdded:Connect(function(player)
		task.delay(8, function()
			if player.Parent and #latest > 0 then
				RemoteService.fire("Leaderboard", player, latest)
			end
		end)
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			refresh(rows)
			task.wait(120)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[--[[
	MissionService : livraison, taxi, course de rue, braquage.
	Tout est validé côté serveur : positions des objectifs, temps, récompenses.
	Le client ne reçoit que l'état d'affichage (titre, objectif, position, échéance).
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local RemoteService = require(script.Parent.RemoteService)
local EconomyService = require(script.Parent.EconomyService)
local DataService = require(script.Parent.DataService)
local VehicleService = require(script.Parent.VehicleService)
local WantedService = require(script.Parent.WantedService)
local PedestrianService = require(script.Parent.PedestrianService)

local MissionService = {}

local rng = Random.new()
local World
local active = {} -- [player] = mission
local cooldowns = {} -- [player] = { [type] = os.clock() }
local passenger = {} -- [player] = model (passager de taxi visible au point de prise en charge)

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function seated(player)
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.SeatPart ~= nil
end

local function sendMission(player)
	local m = active[player]
	if not m then
		RemoteService.fire("Mission", player, nil)
		return
	end
	RemoteService.fire("Mission", player, {
		type = m.type,
		title = m.title,
		text = m.text,
		target = m.target,
		radius = m.radius,
		deadline = m.deadline,
		step = m.step,
		steps = m.steps,
		reward = m.reward,
		color = m.color,
	})
end

local function clearPassenger(player)
	local p = passenger[player]
	if p then
		p:Destroy()
		passenger[player] = nil
	end
end

local function finish(player, success, message, kind)
	local m = active[player]
	if not m then
		return
	end
	active[player] = nil
	clearPassenger(player)
	cooldowns[player] = cooldowns[player] or {}
	cooldowns[player][m.type] = os.clock()
	if message then
		RemoteService.notify(player, message, kind or (success and "good" or "bad"))
	end
	sendMission(player)
end

local function reward(player, cash, xp, statKey)
	local paid = EconomyService.addCash(player, cash, "mission")
	EconomyService.addXP(player, xp)
	EconomyService.addStat(player, "missions", 1)
	if statKey then
		EconomyService.addStat(player, statKey, 1)
	end
	return paid
end

local function pickFar(list, from, minD, maxD)
	local candidates = {}
	for _, p in ipairs(list) do
		local d = Util.flatDistance(p, from)
		if d >= minD and d <= maxD then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		for _, p in ipairs(list) do
			if Util.flatDistance(p, from) >= minD then
				table.insert(candidates, p)
			end
		end
	end
	if #candidates == 0 then
		candidates = list
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

-- ====================================================================
-- Démarrage des missions
-- ====================================================================
local function canStart(player, kind)
	local profile = DataService.get(player)
	local cfg = Config.Missions[kind]
	if not profile or not cfg then
		return false
	end
	if active[player] then
		RemoteService.notify(player, "Termine ou abandonne ta mission en cours.", "info")
		return false
	end
	if profile.Level < cfg.minLevel then
		RemoteService.notify(player, string.format("%s : niveau %d requis.", cfg.title, cfg.minLevel), "bad")
		return false
	end
	local cd = cooldowns[player] and cooldowns[player][kind]
	if cd and os.clock() - cd < cfg.cooldown then
		RemoteService.notify(player, string.format("Reviens dans %d s.", math.ceil(cfg.cooldown - (os.clock() - cd))), "info")
		return false
	end
	if kind ~= "heist" and WantedService.getStars(player) > 0 then
		RemoteService.notify(player, "Tu es recherché ! Sème la police d'abord.", "bad")
		return false
	end
	local hrp = hrpOf(player)
	if not hrp then
		return false
	end
	return true, profile, cfg, hrp
end

local function startDelivery(player)
	local ok, profile, cfg, hrp = canStart(player, "delivery")
	if not ok then
		return
	end
	local target = pickFar(World.DeliveryPoints, hrp.Position, 180, 700)
	local dist = Util.flatDistance(target, hrp.Position)
	local limit = cfg.timeBase + dist / cfg.studsPerSec
	active[player] = {
		type = "delivery", title = cfg.title, text = "Livre la pizza avant la fin du temps !",
		target = target, radius = 9, startPos = hrp.Position, dist = dist,
		deadline = now() + limit, limit = limit, step = 1, steps = 1,
		reward = math.floor(cfg.baseReward + dist * cfg.perStud), color = Color3.fromRGB(255, 150, 80),
	}
	RemoteService.notify(player, "Pizza chargée ! Direction le point de livraison.", "good")
	sendMission(player)
end

local function startTaxi(player)
	local ok, profile, cfg, hrp = canStart(player, "taxi")
	if not ok then
		return
	end
	if not seated(player) then
		RemoteService.notify(player, "Monte dans une voiture pour faire le taxi.", "info")
		return
	end
	local pickup = pickFar(World.TaxiStops, hrp.Position, 40, 450)
	local drop = pickFar(World.TaxiStops, pickup, 250, 800)
	local limit = cfg.timeBase + (Util.flatDistance(pickup, hrp.Position) + Util.flatDistance(pickup, drop)) / cfg.studsPerSec
	active[player] = {
		type = "taxi", title = cfg.title, text = "Va chercher le client.",
		target = pickup, radius = 14, pickup = pickup, drop = drop, startPos = hrp.Position,
		deadline = now() + limit, limit = limit, step = 1, steps = 2,
		reward = math.floor(cfg.baseReward + Util.flatDistance(pickup, drop) * cfg.perStud), color = Color3.fromRGB(255, 214, 0),
	}
	-- passager visible
	task.spawn(function()
		local rig = PedestrianService.newRig({
			head = Color3.fromRGB(234, 184, 146), torso = Color3.fromRGB(240, 130, 60),
			arms = Color3.fromRGB(240, 130, 60), legs = Color3.fromRGB(50, 60, 90),
		})
		if rig then
			rig.Name = "Client"
			rig:PivotTo(CFrame.new(pickup + Vector3.new(0, 3, 0)))
			local r = rig:FindFirstChild("HumanoidRootPart")
			if r then
				r.Anchored = true
			end
			rig.Parent = workspace
			if active[player] and active[player].pickup == pickup then
				passenger[player] = rig
			else
				rig:Destroy()
			end
		end
	end)
	RemoteService.notify(player, "Client en attente ! Va le chercher.", "good")
	sendMission(player)
end

local function startRace(player)
	local ok, profile, cfg, hrp = canStart(player, "race")
	if not ok then
		return
	end
	if not seated(player) then
		RemoteService.notify(player, "Il faut un véhicule pour courir !", "info")
		return
	end
	local circuit = World.RaceCircuit
	active[player] = {
		type = "race", title = cfg.title, text = "Passe tous les points de contrôle !",
		target = circuit[1], radius = 32, index = 1, startPos = hrp.Position,
		deadline = now() + cfg.timeLimit, limit = cfg.timeLimit, startedAt = now(),
		step = 1, steps = #circuit, reward = cfg.baseReward, color = Color3.fromRGB(255, 70, 70),
	}
	RemoteService.notify(player, "Course lancée ! Fonce !", "good")
	sendMission(player)
end

local crackers = {} -- joueurs en train de percer le coffre

local function startHeist(player)
	local ok, profile, cfg, hrp = canStart(player, "heist")
	if not ok then
		return
	end
	active[player] = {
		type = "heist", title = cfg.title, text = "Rejoins la planque avec le butin !",
		target = World.Hideout, radius = 12, startPos = hrp.Position,
		deadline = now() + 240, limit = 240, step = 1, steps = 1,
		reward = cfg.baseReward, color = Color3.fromRGB(80, 255, 120),
	}
	WantedService.addHeat(player, Config.Wanted.HeistHeat, "Braquage")
	RemoteService.notify(player, "Coffre vidé ! La police arrive, fonce à la planque !", "bad")
	sendMission(player)
end

local STARTERS = { delivery = startDelivery, taxi = startTaxi, race = startRace, heist = startHeist }

-- ====================================================================
-- Progression (boucle 4 Hz)
-- ====================================================================
local function completeMission(player, m)
	local cfg = Config.Missions[m.type]
	local t = now()
	if m.type == "delivery" then
		local timeLeft = m.deadline - t
		local bonus = math.floor(math.max(0, timeLeft) * 2)
		local paid = reward(player, m.reward + bonus, cfg.xp, "deliveries")
		finish(player, true, string.format("Livraison réussie ! +%s", Util.formatCash(paid)))
	elseif m.type == "taxi" then
		local timeLeft = m.deadline - t
		local bonus = math.floor(math.max(0, timeLeft) * 3)
		local paid = reward(player, m.reward + bonus, cfg.xp, "taxis")
		finish(player, true, string.format("Course terminée ! +%s", Util.formatCash(paid)))
	elseif m.type == "race" then
		local elapsed = t - m.startedAt
		local timeLeft = math.max(0, m.deadline - t)
		local bonus = math.floor(timeLeft * 10)
		local paid = reward(player, m.reward + bonus, cfg.xp, "races")
		local profile = DataService.get(player)
		if profile and (profile.Stats.bestRace == 0 or elapsed < profile.Stats.bestRace) then
			profile.Stats.bestRace = math.floor(elapsed * 10) / 10
			DataService.markDirty(player)
		end
		finish(player, true, string.format("Course gagnée en %s ! +%s", Util.formatTime(elapsed), Util.formatCash(paid)))
	elseif m.type == "heist" then
		local paid = reward(player, m.reward, cfg.xp, "heists")
		finish(player, true, string.format("Casse réussi ! +%s", Util.formatCash(paid)))
	end
end

local function step()
	for player, m in pairs(active) do
		local hrp = hrpOf(player)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then
			finish(player, false, "Mission échouée.")
		elseif now() > m.deadline then
			finish(player, false, "Temps écoulé ! Mission échouée.")
		else
			local near = Util.flatDistance(hrp.Position, m.target) <= m.radius and math.abs(hrp.Position.Y - m.target.Y) < 30
			if near then
				if m.type == "taxi" then
					if m.step == 1 and seated(player) then
						clearPassenger(player)
						m.step = 2
						m.target = m.drop
						m.text = "Dépose le client à destination."
						RemoteService.notify(player, "Client à bord ! En route.", "good")
						sendMission(player)
					elseif m.step == 2 and seated(player) then
						completeMission(player, m)
					end
				elseif m.type == "race" then
					if not seated(player) then
						-- on exige d'être en véhicule : pas de raccourci à pied
					elseif m.index >= #World.RaceCircuit then
						completeMission(player, m)
					else
						m.index += 1
						m.step = m.index
						m.target = World.RaceCircuit[m.index]
						sendMission(player)
					end
				else
					completeMission(player, m)
				end
			end
		end
	end
end

-- ====================================================================
-- Prompts
-- ====================================================================
local function attachMissionPrompt(pad)
	local kind = pad:GetAttribute("Mission")
	if not STARTERS[kind] then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = pad:GetAttribute("Label") or "Démarrer"
	prompt.ObjectText = Config.Missions[kind].title
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	if kind == "heist" then
		prompt.HoldDuration = Config.Missions.heist.crackTime
		prompt.ActionText = "Percer le coffre"
	else
		prompt.HoldDuration = 0.3
	end
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		STARTERS[kind](player)
	end)
end

local function attachDealerPrompt(pad)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Voir les véhicules"
	prompt.ObjectText = "Concessionnaire"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		RemoteService.fire("OpenPanel", player, "dealer")
	end)
end

function MissionService.failFor(player, message)
	if active[player] then
		finish(player, false, message)
	end
end

function MissionService.init(world)
	World = world
	for _, pad in ipairs(CollectionService:GetTagged("MissionHub")) do
		attachMissionPrompt(pad)
	end
	for _, pad in ipairs(CollectionService:GetTagged("DealerHub")) do
		attachDealerPrompt(pad)
	end

	RemoteService.on("AbandonMission", 1, nil, function(player)
		if active[player] then
			finish(player, false, "Mission abandonnée.", "info")
		end
	end)

	WantedService.Busted:Connect(function(player)
		local m = active[player]
		if m then
			if m.type == "heist" then
				finish(player, false, "Butin confisqué par la police !", "bad")
			else
				finish(player, false, "Mission interrompue.", "bad")
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearPassenger(player)
		active[player] = nil
		cooldowns[player] = nil
		crackers[player] = nil
	end)
end

function MissionService.start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			step()
		end
	end)
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationService : achats intégrés (Developer Products) et Game Passes.
	- ProcessReceipt idempotent (reçus déjà traités mémorisés dans le profil)
	- Les IDs sont dans MonetizationIds (remplis par tools/publish.py)
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Ids = require(Shared:WaitForChild("MonetizationIds"))

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local RemoteService = require(script.Parent.RemoteService)

local MonetizationService = {}

local function productByRealId(productId)
	for _, p in ipairs(Config.Products) do
		if Ids.Products[p.key] and Ids.Products[p.key] ~= 0 and Ids.Products[p.key] == productId then
			return p
		end
	end
	return nil
end

local function passKeyById(passId)
	for key, id in pairs(Ids.GamePasses) do
		if id ~= 0 and id == passId then
			return key
		end
	end
	return nil
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	profile.Receipts = profile.Receipts or {}
	local rid = tostring(info.PurchaseId)
	if profile.Receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = productByRealId(info.ProductId)
	if not product then
		warn("[Monetization] Produit inconnu", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	EconomyService.grantCashRaw(player, product.cash)
	profile.Receipts[rid] = os.time()
	-- on ne garde que les 60 derniers reçus
	local count = 0
	for _ in pairs(profile.Receipts) do
		count += 1
	end
	if count > 60 then
		local oldestKey, oldest = nil, math.huge
		for k, t in pairs(profile.Receipts) do
			if t < oldest then
				oldest, oldestKey = t, k
			end
		end
		profile.Receipts[oldestKey] = nil
	end
	DataService.markDirty(player)
	RemoteService.notify(player, string.format("Merci ! +%s", Util.formatCash(product.cash)), "good")
	task.spawn(DataService.saveNow, player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player)
	for key, id in pairs(Ids.GamePasses) do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				EconomyService.setPass(player, key, true)
			end
		end
	end
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local key = passKeyById(passId)
			if key then
				EconomyService.setPass(player, key, true)
				RemoteService.notify(player, "Pass activé, merci !", "good")
			end
		end
	end)

	DataService.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">PedestrianService</string><ProtectedString name="Source"><![CDATA[--[[
	PedestrianService : piétons qui se promènent sur les trottoirs, rigs R15 classiques Roblox,
	renversements (étourdis, sans violence), billets lâchés ; fabrique aussi les rigs de policiers.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local EconomyService = require(script.Parent.EconomyService)

local Pedestrians = {}

local TARGET_COUNT = 22

-- animations R15 standard de Roblox
local ANIM_IDLE = "rbxassetid://507766666"
local ANIM_WALK = "rbxassetid://507777826"
local ANIM_RUN = "rbxassetid://507767714"

local rng = Random.new()
local folder
local peds = {} -- [model] = data
local drops = {} -- { part, value, expires }

local SKIN = {
	Color3.fromRGB(255, 204, 153), Color3.fromRGB(234, 184, 146), Color3.fromRGB(190, 140, 100),
	Color3.fromRGB(125, 85, 60), Color3.fromRGB(95, 65, 45),
}
local CLOTH = {
	Color3.fromRGB(230, 70, 70), Color3.fromRGB(70, 130, 230), Color3.fromRGB(80, 190, 110),
	Color3.fromRGB(240, 190, 60), Color3.fromRGB(150, 80, 210), Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(60, 60, 70), Color3.fromRGB(240, 130, 60),
}
local PANTS = { Color3.fromRGB(50, 60, 90), Color3.fromRGB(40, 40, 46), Color3.fromRGB(110, 90, 70), Color3.fromRGB(70, 80, 110) }

Pedestrians.Folder = nil

-- Crée un rig R15 coloré. colors = {head, torso, arms, legs}
function Pedestrians.newRig(colors)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = colors.head
	desc.TorsoColor = colors.torso
	desc.LeftArmColor = colors.arms
	desc.RightArmColor = colors.arms
	desc.LeftLegColor = colors.legs
	desc.RightLegColor = colors.legs
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	desc:Destroy()
	if not ok or not model then
		warn("[Pedestrians] Création du rig échouée:", model)
		return nil
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	return model
end

-- Joue idle / marche selon la vitesse (côté serveur, répliqué)
function Pedestrians.setupAnimation(model, runAnim)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local function load(id)
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok then
			track.Looped = true
			return track
		end
		return nil
	end
	local idle = load(ANIM_IDLE)
	local walk = load(runAnim and ANIM_RUN or ANIM_WALK)
	if idle then
		idle:Play()
	end
	hum.Running:Connect(function(speed)
		if not walk or not idle then
			return
		end
		if speed > 0.8 then
			if idle.IsPlaying then
				idle:Stop(0.2)
			end
			if not walk.IsPlaying then
				walk:Play(0.2)
			end
			walk:AdjustSpeed(math.clamp(speed / 14, 0.5, 1.6))
		else
			if walk.IsPlaying then
				walk:Stop(0.2)
			end
			if not idle.IsPlaying then
				idle:Play(0.2)
			end
		end
	end)
end

local function sidewalkPoint(i, j)
	local c = Config.blockCenter(i, j)
	local side = rng:NextInteger(1, 4)
	local t = rng:NextNumber(-70, 70)
	local r = 73
	if side == 1 then
		return Vector3.new(c.X + t, 3, c.Z - r)
	elseif side == 2 then
		return Vector3.new(c.X + t, 3, c.Z + r)
	elseif side == 3 then
		return Vector3.new(c.X - r, 3, c.Z + t)
	end
	return Vector3.new(c.X + r, 3, c.Z + t)
end

local function randomBlock()
	return rng:NextInteger(1, 5), rng:NextInteger(1, 5)
end

local function spawnOne()
	local colors = {
		head = SKIN[rng:NextInteger(1, #SKIN)],
		torso = CLOTH[rng:NextInteger(1, #CLOTH)],
		arms = CLOTH[rng:NextInteger(1, #CLOTH)],
		legs = PANTS[rng:NextInteger(1, #PANTS)],
	}
	colors.arms = rng:NextNumber() < 0.5 and colors.torso or colors.head
	local model = Pedestrians.newRig(colors)
	if not model then
		return
	end
	model.Name = "Pedestrian"
	model:SetAttribute("Pedestrian", true)
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.WalkSpeed = rng:NextNumber(7, 12)
	local i, j = randomBlock()
	model:PivotTo(CFrame.new(sidewalkPoint(i, j)))
	model.Parent = folder
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp:SetNetworkOwner(nil)
	end
	Pedestrians.setupAnimation(model, false)
	peds[model] = { model = model, hum = hum, hrp = hrp, target = nil, nextPick = 0, state = "walk", i = i, j = j }
end

function Pedestrians.fromPart(part)
	local m = part:FindFirstAncestorOfClass("Model")
	if m and peds[m] then
		return m
	end
	return nil
end

function Pedestrians.dropCash(pos)
	local part = Instance.new("Part")
	part.Name = "CashDrop"
	part.Size = Vector3.new(2.4, 0.15, 1.2)
	part.Color = Color3.fromRGB(90, 220, 110)
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.Anchored = true
	part.CFrame = CFrame.new(pos + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
	part.Parent = folder
	table.insert(drops, { part = part, value = rng:NextInteger(8, 25), expires = os.clock() + 25 })
end

-- Étourdit un piéton ; retourne false s'il est déjà à terre
function Pedestrians.knockdown(model, velocity)
	local d = peds[model]
	if not d or d.state == "down" or not d.hrp or not d.hrp.Parent then
		return false
	end
	d.state = "down"
	d.hum.PlatformStand = true
	local dir = Vector3.new(velocity.X, 0, velocity.Z)
	dir = dir.Magnitude > 1 and dir.Unit or Vector3.new(0, 0, 1)
	d.hrp.AssemblyLinearVelocity = dir * 38 + Vector3.new(0, 34, 0)
	d.hrp.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
	Pedestrians.dropCash(d.hrp.Position)
	task.delay(3, function()
		if d.hrp and d.hrp.Parent then
			local p = d.hrp.Position
			d.hrp.CFrame = CFrame.new(p.X, p.Y + 2, p.Z)
			d.hrp.AssemblyAngularVelocity = Vector3.zero
			d.hum.PlatformStand = false
			d.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			d.state = "walk"
			d.nextPick = 0
		end
	end)
	return true
end

local function aiStep()
	local now = os.clock()
	for model, d in pairs(peds) do
		if not model.Parent or not d.hrp or not d.hrp.Parent then
			peds[model] = nil
			if model.Parent then
				model:Destroy()
			end
		elseif d.state == "walk" then
			local pos = d.hrp.Position
			if pos.Y < -6 then
				peds[model] = nil
				model:Destroy()
			elseif not d.target or now > d.nextPick or Util.flatDistance(pos, d.target) < 4 then
				local bi = math.clamp(d.i + rng:NextInteger(-1, 1), 1, 5)
				local bj = math.clamp(d.j + rng:NextInteger(-1, 1), 1, 5)
				d.i, d.j = bi, bj
				d.target = sidewalkPoint(bi, bj)
				d.nextPick = now + rng:NextNumber(10, 22)
				d.hum.WalkSpeed = rng:NextNumber(7, 12)
				d.hum:MoveTo(d.target)
			elseif d.hrp.AssemblyLinearVelocity.Magnitude < 0.5 and now > (d.stuckCheck or 0) then
				d.stuckCheck = now + 3
				d.hum.Jump = true
				d.hum:MoveTo(d.target)
			end
		end
	end
end

local function dropsStep()
	local now = os.clock()
	local players = Players:GetPlayers()
	for i = #drops, 1, -1 do
		local dr = drops[i]
		local remove = false
		if not dr.part.Parent or now > dr.expires then
			remove = true
		else
			for _, p in ipairs(players) do
				local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - dr.part.Position).Magnitude < 8 then
					EconomyService.addCash(p, dr.value, "pickup")
					remove = true
					break
				end
			end
		end
		if remove then
			dr.part:Destroy()
			table.remove(drops, i)
		end
	end
end

function Pedestrians.init()
	folder = Instance.new("Folder")
	folder.Name = "Pedestrians"
	folder.Parent = workspace
	Pedestrians.Folder = folder
end

function Pedestrians.start()
	task.spawn(function()
		local n = 0
		while n < TARGET_COUNT do
			spawnOne()
			n += 1
			task.wait(0.15)
		end
		-- maintien de la population
		while true do
			task.wait(5)
			local count = 0
			for _ in pairs(peds) do
				count += 1
			end
			if count < TARGET_COUNT then
				spawnOne()
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			aiStep()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			dropsStep()
		end
	end)
end

return Pedestrians
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">RemoteService</string><ProtectedString name="Source"><![CDATA[--[[
	RemoteService : crée tous les RemoteEvents et fournit une connexion sécurisée
	(limite de fréquence par joueur + validation du type des arguments).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local RemoteService = {}

local FOLDER_NAME = "CityRushRemotes"

-- Serveur -> Client
local SERVER_TO_CLIENT = { "State", "Notify", "Wanted", "Mission", "Banner", "OpenPanel", "Busted", "Leaderboard", "Collected" }
-- Client -> Serveur
local CLIENT_TO_SERVER = { "RequestSpawn", "RequestBuy", "RequestColor", "AbandonMission", "ClaimDaily", "RequestState" }

local folder
local events = {}
local registrations = 0
local lastCall = {} -- [player][name] = os.clock()

function RemoteService.init()
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in ipairs(SERVER_TO_CLIENT) do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
		events[name] = e
	end
	for _, name in ipairs(CLIENT_TO_SERVER) do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
		events[name] = e
	end
	folder.Parent = ReplicatedStorage

	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

function RemoteService.fire(name, player, ...)
	local e = events[name]
	if e and player and player.Parent then
		e:FireClient(player, ...)
	end
end

function RemoteService.notify(player, text, kind)
	RemoteService.fire("Notify", player, text, kind or "info")
end

function RemoteService.fireAll(name, ...)
	local e = events[name]
	if e then
		e:FireAllClients(...)
	end
end

-- handler(player, ...) ; validator(...) -> boolean (optionnel)
function RemoteService.on(name, cooldown, validator, handler)
	local e = events[name]
	assert(e, "Remote inconnu: " .. tostring(name))
	registrations += 1
	local slot = name .. "#" .. registrations
	e.OnServerEvent:Connect(function(player, ...)
		local now = os.clock()
		lastCall[player] = lastCall[player] or {}
		local last = lastCall[player][slot]
		if last and now - last < cooldown then
			return
		end
		lastCall[player][slot] = now
		if validator and not validator(...) then
			return
		end
		handler(player, ...)
	end)
end

return RemoteService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">VehicleBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	VehicleBuilder : construit les modèles de voitures (blocs Roblox) et leur physique "arcade".

	Physique : 1 LinearVelocity en mode Plan (vitesse avant + adhérence latérale nulle)
	           + 1 AngularVelocity (rotation de lacet), pilotés par le client du conducteur
	           (VehicleController) ou par le serveur pour les voitures de police (IA).
	Repère : l'avant du véhicule est -Z (LookVector), le conducteur est sur le siège gauche.
]]

local CollectionService = game:GetService("CollectionService")

local VehicleBuilder = {}

local DARK = Color3.fromRGB(30, 30, 34)
local GLASS = Color3.fromRGB(70, 110, 150)
local CHROME = Color3.fromRGB(190, 195, 205)

local function darker(c, f)
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- Construit le modèle. opts.static = true : décor (ancré, sans siège ni physique).
function VehicleBuilder.build(spec, color, opts)
	opts = opts or {}
	local W, L = spec.w, spec.l
	local style = spec.style
	local convertible = (style == "sport" or style == "super")

	local model = Instance.new("Model")
	model.Name = spec.name

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(W, 1.6, L)
	chassis.CFrame = CFrame.new(0, 0, 0)
	chassis.Color = color
	chassis.Material = Enum.Material.SmoothPlastic
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	chassis.CustomPhysicalProperties = PhysicalProperties.new(1, 0.05, 0, 1, 1)
	chassis.Anchored = opts.static == true
	chassis.Parent = model
	model.PrimaryPart = chassis

	local function add(name, size, offset, col, mat, extra)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = CFrame.new(offset)
		p.Color = col
		p.Material = mat or Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = opts.static == true
		if extra then
			for k, v in pairs(extra) do
				p[k] = v
			end
		end
		p.Parent = model
		if not opts.static then
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = p
			w.Parent = p
		end
		return p
	end

	-- Géométrie de l'habitacle selon le style
	local cabinLen, cabinZ
	if style == "hatch" then
		cabinLen, cabinZ = 0.62 * L, 0.06 * L
	elseif style == "sedan" then
		cabinLen, cabinZ = 0.46 * L, 0.06 * L
	elseif style == "pickup" then
		cabinLen, cabinZ = 0.36 * L, -0.12 * L
	elseif style == "muscle" then
		cabinLen, cabinZ = 0.40 * L, 0.08 * L
	elseif style == "sport" then
		cabinLen, cabinZ = 0.30 * L, 0.02 * L
	else -- super
		cabinLen, cabinZ = 0.28 * L, 0.06 * L
	end
	local cabinH = spec.cabinH
	local topY = 0.8

	if convertible then
		-- Pare-brise + arceau, pas de toit
		add("Windshield", Vector3.new(W - 1.2, cabinH * 0.7, 0.3), Vector3.new(0, topY + cabinH * 0.35, cabinZ - cabinLen / 2), GLASS, Enum.Material.Glass, { Transparency = 0.4 })
		add("Dash", Vector3.new(W - 1.2, 0.8, 1.2), Vector3.new(0, topY + 0.4, cabinZ - cabinLen / 2 + 0.4), darker(color, 0.5))
		add("RollBar", Vector3.new(W - 2, 0.5, 0.6), Vector3.new(0, topY + cabinH * 0.9, cabinZ + cabinLen / 2), darker(color, 0.7))
	else
		add("Cabin", Vector3.new(W - 1.1, cabinH, cabinLen), Vector3.new(0, topY + cabinH / 2, cabinZ), GLASS, Enum.Material.Glass, { Transparency = 0.35 })
		add("Roof", Vector3.new(W - 0.9, 0.4, cabinLen + 0.3), Vector3.new(0, topY + cabinH + 0.2, cabinZ), color)
	end

	-- Pare-chocs, feux
	add("BumperF", Vector3.new(W + 0.2, 0.8, 0.7), Vector3.new(0, -0.35, -L / 2 - 0.2), DARK)
	add("BumperR", Vector3.new(W + 0.2, 0.8, 0.7), Vector3.new(0, -0.35, L / 2 + 0.2), DARK)
	local hx = W / 2 - 1.2
	for _, sx in ipairs({ -1, 1 }) do
		local hl = add("Headlight", Vector3.new(1.5, 0.8, 0.3), Vector3.new(sx * hx, 0.15, -L / 2 - 0.05), Color3.fromRGB(255, 244, 200), Enum.Material.Neon)
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Front
		light.Range = 70
		light.Angle = 70
		light.Brightness = 2.5
		light.Enabled = false
		light.Parent = hl
		CollectionService:AddTag(hl, "Headlight")
		add("Taillight", Vector3.new(1.5, 0.7, 0.3), Vector3.new(sx * hx, 0.2, L / 2 + 0.05), Color3.fromRGB(230, 30, 30), Enum.Material.Neon)
	end

	-- Détails par style
	if style == "pickup" then
		local bedZ = L * 0.27
		local bedLen = L * 0.42
		add("BedFloor", Vector3.new(W - 0.6, 0.4, bedLen), Vector3.new(0, 0.95, bedZ), darker(color, 0.6))
		add("BedL", Vector3.new(0.4, 1.4, bedLen), Vector3.new(-(W / 2 - 0.5), 1.5, bedZ), color)
		add("BedR", Vector3.new(0.4, 1.4, bedLen), Vector3.new(W / 2 - 0.5, 1.5, bedZ), color)
		add("BedBack", Vector3.new(W - 0.6, 1.4, 0.4), Vector3.new(0, 1.5, bedZ + bedLen / 2), color)
		add("BedFront", Vector3.new(W - 0.6, 1.4, 0.4), Vector3.new(0, 1.5, bedZ - bedLen / 2), color)
	elseif style == "muscle" then
		add("StripeHood", Vector3.new(1.6, 0.12, L * 0.34), Vector3.new(0, 0.86, -L * 0.28), Color3.fromRGB(245, 245, 245))
		add("StripeTrunk", Vector3.new(1.6, 0.12, L * 0.2), Vector3.new(0, 0.86, L * 0.4), Color3.fromRGB(245, 245, 245))
		add("HoodScoop", Vector3.new(2, 0.5, 2.4), Vector3.new(0, 1.05, -L * 0.25), DARK)
	elseif style == "sport" or style == "super" then
		local wz = L / 2 - 0.8
		add("WingPostL", Vector3.new(0.4, 1.6, 0.6), Vector3.new(-(W / 2 - 1.4), 1.6, wz), DARK)
		add("WingPostR", Vector3.new(0.4, 1.6, 0.6), Vector3.new(W / 2 - 1.4, 1.6, wz), DARK)
		add("Wing", Vector3.new(W + 0.2, 0.3, 2.2), Vector3.new(0, 2.5, wz), darker(color, 0.55))
		add("IntakeL", Vector3.new(0.3, 0.8, 2.4), Vector3.new(-(W / 2 + 0.05), 0.2, 0.5), DARK)
		add("IntakeR", Vector3.new(0.3, 0.8, 2.4), Vector3.new(W / 2 + 0.05, 0.2, 0.5), DARK)
		if style == "super" then
			add("Underglow", Vector3.new(W - 1.2, 0.2, L - 3), Vector3.new(0, -0.82, 0), Color3.fromRGB(120, 80, 255), Enum.Material.Neon)
		end
	elseif style == "hatch" or style == "sedan" then
		add("Grille", Vector3.new(W - 3, 0.6, 0.2), Vector3.new(0, -0.1, -L / 2 - 0.3), CHROME, Enum.Material.Metal)
	end

	if spec.taxi then
		local sign = add("TaxiSign", Vector3.new(2.6, 0.9, 1.2), Vector3.new(0, topY + cabinH + 0.85, cabinZ), Color3.fromRGB(255, 255, 255), Enum.Material.Neon)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.Parent = sign
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = "TAXI"
		tl.TextScaled = true
		tl.Font = Enum.Font.GothamBlack
		tl.TextColor3 = Color3.new(0, 0, 0)
		tl.Parent = gui
	end

	if spec.police then
		local barY = topY + cabinH + 0.65
		local red = add("SirenRed", Vector3.new(1.8, 0.7, 1.2), Vector3.new(-1.1, barY, cabinZ), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
		local blue = add("SirenBlue", Vector3.new(1.8, 0.7, 1.2), Vector3.new(1.1, barY, cabinZ), Color3.fromRGB(40, 80, 255), Enum.Material.Neon)
		CollectionService:AddTag(red, "SirenA")
		CollectionService:AddTag(blue, "SirenB")
		add("PoliceStripe", Vector3.new(W + 0.1, 0.9, L * 0.4), Vector3.new(0, 0.1, 0), Color3.fromRGB(25, 40, 90))
	end

	-- Roues (visuel) + colliders sphériques sans friction (physique)
	local wx = W / 2 - 0.1
	local wz = L / 2 - 2.8
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			add("Wheel", Vector3.new(1.3, 3, 3), Vector3.new(sx * wx, -0.6, sz * wz), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
			add("Hub", Vector3.new(1.4, 1.5, 1.5), Vector3.new(sx * (wx + 0.05), -0.6, sz * wz), CHROME, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
			if not opts.static then
				add("Collider", Vector3.new(3, 3, 3), Vector3.new(sx * (wx - 0.4), -0.6, sz * wz), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
					Shape = Enum.PartType.Ball,
					Transparency = 1,
					CanCollide = true,
					CustomPhysicalProperties = PhysicalProperties.new(0.3, 0, 0, 100, 100),
				})
			end
		end
	end

	if not opts.static then
		local seatZ = cabinZ
		local driver = Instance.new("VehicleSeat")
		driver.Name = "DriverSeat"
		driver.Size = Vector3.new(2, 1, 2)
		driver.CFrame = CFrame.new(-1.6, 0.35, seatZ)
		driver.Transparency = 1
		driver.Massless = true
		driver.TopSurface = Enum.SurfaceType.Smooth
		driver.BottomSurface = Enum.SurfaceType.Smooth
		driver.HeadsUpDisplay = false
		driver.MaxSpeed = 0
		driver.Torque = 0
		driver.Parent = model
		local w1 = Instance.new("WeldConstraint")
		w1.Part0 = chassis
		w1.Part1 = driver
		w1.Parent = driver
		driver:SetAttribute("CRVehicle", true)

		local pass = Instance.new("Seat")
		pass.Name = "PassengerSeat"
		pass.Size = Vector3.new(2, 1, 2)
		pass.CFrame = CFrame.new(1.6, 0.35, seatZ)
		pass.Transparency = 1
		pass.Massless = true
		pass.TopSurface = Enum.SurfaceType.Smooth
		pass.BottomSurface = Enum.SurfaceType.Smooth
		pass.Parent = model
		local w2 = Instance.new("WeldConstraint")
		w2.Part0 = chassis
		w2.Part1 = pass
		w2.Parent = pass

		-- Contraintes de conduite
		local mass = W * 1.6 * L * 1
		local att = Instance.new("Attachment")
		att.Name = "DriveAttachment"
		att.Parent = chassis

		local lv = Instance.new("LinearVelocity")
		lv.Name = "DriveVelocity"
		lv.Attachment0 = att
		lv.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		lv.PlaneVelocity = Vector2.new(0, 0)
		lv.MaxForce = mass * 250
		lv.Parent = chassis

		local av = Instance.new("AngularVelocity")
		av.Name = "TurnVelocity"
		av.Attachment0 = att
		av.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
		av.AngularVelocity = Vector3.new(0, 0, 0)
		av.MaxTorque = mass * 900
		av.ReactionTorqueEnabled = false
		av.Parent = chassis

		model:SetAttribute("CRVehicle", true)
		model:SetAttribute("VehicleId", spec.id)
		model:SetAttribute("MaxSpeed", spec.maxSpeed)
		model:SetAttribute("Accel", spec.accel)
		model:SetAttribute("Turn", spec.turn)
		model:SetAttribute("Mass", mass)
		if spec.police then
			model:SetAttribute("Police", true)
		end
	end

	return model
end

-- Hauteur du centre du châssis au dessus du sol
VehicleBuilder.RideHeight = 2.2

return VehicleBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[--[[
	VehicleService : apparition / suppression des véhicules, voitures publiques garées dans la rue,
	verrouillage du siège conducteur, détection des collisions avec piétons et mobilier,
	distance parcourue.
	La conduite des voitures de joueurs est simulée par le client du conducteur (VehicleController).
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local VehicleBuilder = require(script.Parent.VehicleBuilder)
local RemoteService = require(script.Parent.RemoteService)
local EconomyService = require(script.Parent.EconomyService)
local DataService = require(script.Parent.DataService)

local VehicleService = {}

local World
local Pedestrians -- injecté (peut être nil)
local Wanted -- injecté (peut être nil)

local vehiclesFolder
local playerVehicle = {} -- [player] = model
local lastSpawn = {} -- [player] = os.clock()
local publicCars = {} -- liste de {model, home, emptySince}
local rng = Random.new()
local hitParams = OverlapParams.new()
hitParams.FilterType = Enum.RaycastFilterType.Include

function VehicleService.setDependencies(world, pedestrians, wanted)
	World = world
	Pedestrians = pedestrians
	Wanted = wanted
	hitParams.FilterDescendantsInstances = { world.BreakFolder, pedestrians and pedestrians.Folder or world.BreakFolder }
end

local function groundHeight(pos, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local r = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -200, 0), params)
	return r and r.Position.Y or nil
end

local function applyColor(model, color)
	local chassis = model.PrimaryPart
	chassis.Color = color
	for _, name in ipairs({ "Roof", "BedL", "BedR", "BedBack", "BedFront" }) do
		local p = model:FindFirstChild(name)
		if p then
			p.Color = color
		end
	end
end

-- Crée un véhicule (non parenté au monde tant que l'appelant ne le décide pas)
local function create(spec, color, cf)
	local model = VehicleBuilder.build(spec, color)
	model:PivotTo(cf)
	model.Parent = vehiclesFolder
	return model
end

local function driverSeat(model)
	return model:FindFirstChild("DriverSeat")
end

function VehicleService.getDriver(model)
	local seat = driverSeat(model)
	if seat and seat.Occupant then
		return Players:GetPlayerFromCharacter(seat.Occupant.Parent)
	end
	return nil
end

-- Véhicule dans lequel se trouve le joueur (conducteur ou passager)
function VehicleService.getOccupiedVehicle(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat and seat.Parent and seat.Parent:GetAttribute("CRVehicle") then
		return seat.Parent
	end
	return nil
end

local function hookSeats(model)
	local seat = driverSeat(model)
	if not seat then
		return
	end
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occ = seat.Occupant
		if not occ then
			return
		end
		local player = Players:GetPlayerFromCharacter(occ.Parent)
		if not player then
			return
		end
		local ownerId = model:GetAttribute("OwnerUserId")
		if ownerId and ownerId ~= player.UserId then
			-- voiture personnelle verrouillée pour le conducteur
			task.defer(function()
				occ.Sit = false
				occ.Jump = true
			end)
			RemoteService.notify(player, "Cette voiture est verrouillée (propriétaire uniquement).", "bad")
			return
		end
		if model:GetAttribute("Police") then
			return
		end
		-- vol d'une voiture publique près de la police => chaleur
		if not ownerId and Wanted and Wanted.copNear then
			if Wanted.copNear(player, 70) then
				Wanted.addHeat(player, 15, "Vol de voiture")
			end
		end
		model:SetAttribute("LastDriver", player.UserId)
	end)
end

-- ====================================================================
-- Voitures de joueurs
-- ====================================================================
function VehicleService.despawnFor(player)
	local m = playerVehicle[player]
	if m then
		m:Destroy()
		playerVehicle[player] = nil
	end
end

function VehicleService.spawnFor(player, vehicleId)
	local profile = DataService.get(player)
	local spec = Config.getVehicle(vehicleId)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not profile or not spec or not hrp or not hum or hum.Health <= 0 then
		return
	end
	if not EconomyService.canUseVehicle(player, vehicleId) then
		RemoteService.notify(player, "Tu ne possèdes pas ce véhicule.", "bad")
		return
	end
	local now = os.clock()
	if lastSpawn[player] and now - lastSpawn[player] < Config.VehicleSpawnCooldown then
		RemoteService.notify(player, "Patiente un instant avant de rappeler un véhicule.", "info")
		return
	end
	lastSpawn[player] = now

	VehicleService.despawnFor(player)

	local look = hrp.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.1 then
		flatLook = Vector3.new(0, 0, -1)
	end
	flatLook = flatLook.Unit
	local pos = hrp.Position + flatLook * (spec.l / 2 + 6)
	local gy = groundHeight(pos, { char, vehiclesFolder }) or (hrp.Position.Y - 3)
	local colorIndex = profile.Colors[vehicleId]
	local color = colorIndex and Config.VehicleColors[colorIndex] or spec.color
	local cf = CFrame.lookAt(Vector3.new(pos.X, gy + VehicleBuilder.RideHeight + 0.3, pos.Z), Vector3.new(pos.X, gy + VehicleBuilder.RideHeight + 0.3, pos.Z) + flatLook)
	local model = create(spec, color, cf)
	model:SetAttribute("OwnerUserId", player.UserId)
	playerVehicle[player] = model
	hookSeats(model)
	local seat = driverSeat(model)
	task.defer(function()
		if seat and seat.Parent and hum.Parent and hum.Health > 0 then
			seat:Sit(hum)
		end
	end)
end

-- ====================================================================
-- Voitures publiques (garées)
-- ====================================================================
local function spawnPublicAt(entry)
	local pick = Util.weightedPick(Config.PublicCars, rng)
	local spec = Config.getVehicle(pick.id)
	local color = Config.VehicleColors[rng:NextInteger(1, #Config.VehicleColors)]
	local gy = entry.home.Position.Y
	local cf = entry.home + Vector3.new(0, VehicleBuilder.RideHeight + 0.2 - 0.3 + (gy - entry.home.Position.Y), 0)
	local model = create(spec, color, cf)
	model:SetAttribute("Public", true)
	hookSeats(model)
	entry.model = model
	entry.emptySince = nil
end

local function playersNear(pos, radius)
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - pos).Magnitude < radius then
			return true
		end
	end
	return false
end

local function publicLoop()
	while true do
		task.wait(5)
		for _, e in ipairs(publicCars) do
			local m = e.model
			if not m or not m.Parent then
				spawnPublicAt(e)
			else
				local chassis = m.PrimaryPart
				local occupied = false
				for _, s in ipairs({ m:FindFirstChild("DriverSeat"), m:FindFirstChild("PassengerSeat") }) do
					if s and s.Occupant then
						occupied = true
					end
				end
				if occupied then
					e.emptySince = nil
				else
					e.emptySince = e.emptySince or os.clock()
					if chassis and os.clock() - e.emptySince > 90 and (chassis.Position - e.home.Position).Magnitude > 8 and not playersNear(chassis.Position, 80) then
						m:Destroy()
						spawnPublicAt(e)
					end
				end
				if chassis and chassis.Position.Y < -8 then
					m:Destroy()
					spawnPublicAt(e)
				end
			end
		end
	end
end

-- ====================================================================
-- Voitures de police (IA pilotée par WantedService)
-- ====================================================================
function VehicleService.spawnCruiser(cf)
	local model = create(Config.Police, Config.Police.color, cf)
	model:SetAttribute("Police", true)
	for _, seatName in ipairs({ "DriverSeat", "PassengerSeat" }) do
		local seat = model:FindFirstChild(seatName)
		if seat then
			seat.Disabled = true -- les voitures de police ne sont pas volables
		end
	end
	model.PrimaryPart:SetNetworkOwner(nil)
	return model
end

-- ====================================================================
-- Collisions & statistiques (boucle 10 Hz sur les véhicules conduits par un joueur)
-- ====================================================================
local lastPos = {} -- [player] = Vector3
local distAcc = {} -- [player] = studs cumulés

local function hitLoop()
	local acc = 0
	while true do
		task.wait(0.1)
		acc += 0.1
		for _, player in ipairs(Players:GetPlayers()) do
			local model = VehicleService.getOccupiedVehicle(player)
			local seat = model and driverSeat(model)
			if model and seat and seat.Occupant and Players:GetPlayerFromCharacter(seat.Occupant.Parent) == player and not model:GetAttribute("Police") then
				local chassis = model.PrimaryPart
				local speed = chassis.AssemblyLinearVelocity.Magnitude
				-- distance (plafonnée pour ignorer les téléportations)
				local lp = lastPos[player]
				if lp then
					local d = (chassis.Position - lp).Magnitude
					if d < 40 then
						distAcc[player] = (distAcc[player] or 0) + d
					end
				end
				lastPos[player] = chassis.Position
				if acc >= 1 and (distAcc[player] or 0) > 0 then
					EconomyService.addDistance(player, distAcc[player])
					distAcc[player] = 0
				end
				if speed > 22 then
					local size = chassis.Size
					local cf = chassis.CFrame * CFrame.new(0, 1, -size.Z / 2 - 1)
					local parts = workspace:GetPartBoundsInBox(cf, Vector3.new(size.X + 2, 4, 5), hitParams)
					for _, part in ipairs(parts) do
						if part.Parent == World.BreakFolder then
							if World.breakProp(part) and Wanted then
								Wanted.addHeat(player, Config.Wanted.SmashPropHeat, "Vandalisme")
							end
						elseif Pedestrians then
							local ped = Pedestrians.fromPart(part)
							if ped and Pedestrians.knockdown(ped, chassis.AssemblyLinearVelocity) and Wanted then
								Wanted.addHeat(player, Config.Wanted.HitPedestrianHeat, "Piéton renversé")
								EconomyService.addStat(player, "hits", 1)
							end
						end
					end
				end
			else
				lastPos[player] = nil
			end
		end
		if acc >= 1 then
			acc = 0
		end
	end
end

local function fallLoop()
	while true do
		task.wait(2)
		for player, m in pairs(playerVehicle) do
			if m.Parent and m.PrimaryPart and m.PrimaryPart.Position.Y < -8 then
				m:Destroy()
				playerVehicle[player] = nil
				RemoteService.notify(player, "Ton véhicule a coulé ! Rappelle-le depuis ton garage (G).", "bad")
			elseif not m.Parent then
				playerVehicle[player] = nil
			end
		end
	end
end

function VehicleService.init()
	vehiclesFolder = Instance.new("Folder")
	vehiclesFolder.Name = "Vehicles"
	vehiclesFolder.Parent = workspace

	RemoteService.on("RequestSpawn", 0.5, function(id)
		return type(id) == "string" and #id < 24
	end, function(player, id)
		VehicleService.spawnFor(player, id)
	end)

	Players.PlayerRemoving:Connect(function(player)
		VehicleService.despawnFor(player)
		lastSpawn[player] = nil
		lastPos[player] = nil
		distAcc[player] = nil
	end)
end

function VehicleService.start()
	for _, cf in ipairs(World.ParkingSpots) do
		local entry = { home = cf }
		table.insert(publicCars, entry)
		spawnPublicAt(entry)
	end
	task.spawn(publicLoop)
	task.spawn(hitLoop)
	task.spawn(fallLoop)
end

return VehicleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">WantedService</string><ProtectedString name="Source"><![CDATA[--[[
	WantedService : niveau de recherche (0-5 étoiles), policiers à pied et voitures de police (IA),
	arrestations, Pay'n'Spray. Toute la logique est côté serveur.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local RemoteService = require(script.Parent.RemoteService)
local EconomyService = require(script.Parent.EconomyService)
local DataService = require(script.Parent.DataService)
local PedestrianService = require(script.Parent.PedestrianService)
local VehicleService = require(script.Parent.VehicleService)

local WantedService = {}
WantedService.Busted = Util.newSignal() -- (player)

local W = Config.Wanted
local World
local rng = Random.new()
local states = {} -- [player] = state
local copTemplate
local copFolder

local function starsFromHeat(heat)
	if heat < 1 then
		return 0
	end
	return math.min(W.MaxStars, math.ceil(heat / W.HeatPerStar))
end

local function getState(player)
	local s = states[player]
	if not s then
		s = { heat = 0, stars = 0, cops = {}, cruisers = {}, lastNear = os.clock(), immuneUntil = 0, sentStars = -1, sentEvading = false, stopTimer = 0, spawning = false }
		states[player] = s
	end
	return s
end

local function hrpOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function playerSpeed(player)
	local v = VehicleService.getOccupiedVehicle(player)
	if v and v.PrimaryPart then
		return v.PrimaryPart.AssemblyLinearVelocity.Magnitude, true
	end
	local hrp = hrpOf(player)
	return hrp and hrp.AssemblyLinearVelocity.Magnitude or 0, false
end

local function push(player, s, evading)
	if s.sentStars ~= s.stars or s.sentEvading ~= evading then
		s.sentStars = s.stars
		s.sentEvading = evading
		RemoteService.fire("Wanted", player, s.stars, evading)
	end
end

-- ====================================================================
-- API
-- ====================================================================
function WantedService.addHeat(player, amount, reason)
	local s = getState(player)
	if os.clock() < s.immuneUntil or not DataService.get(player) then
		return
	end
	local before = s.stars
	s.heat = math.min(100, s.heat + amount)
	s.stars = starsFromHeat(s.heat)
	s.lastNear = os.clock()
	if s.stars > before then
		RemoteService.notify(player, string.format("%s ! Niveau de recherche : %d", reason or "Recherché", s.stars), "bad")
		if s.stars >= 5 then
			EconomyService.addStat(player, "fiveStars", 1)
		end
	end
	push(player, s, false)
end

function WantedService.getStars(player)
	local s = states[player]
	return s and s.stars or 0
end

local function removeCops(s)
	for _, m in ipairs(s.cops) do
		if m.Parent then
			m:Destroy()
		end
	end
	for _, c in ipairs(s.cruisers) do
		if c.model and c.model.Parent then
			c.model:Destroy()
		end
	end
	s.cops = {}
	s.cruisers = {}
end

function WantedService.clear(player)
	local s = getState(player)
	s.heat = 0
	s.stars = 0
	removeCops(s)
	push(player, s, false)
end

function WantedService.copNear(player, radius)
	local hrp = hrpOf(player)
	if not hrp then
		return false
	end
	for _, m in ipairs(copFolder:GetChildren()) do
		local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
		if r and (r.Position - hrp.Position).Magnitude < radius then
			return true
		end
	end
	return false
end

local function bust(player)
	local s = getState(player)
	if os.clock() < s.immuneUntil then
		return
	end
	s.immuneUntil = os.clock() + 6
	local cash = EconomyService.getCash(player)
	local lost = EconomyService.loseCash(player, math.min(math.floor(cash * W.BustedCashPercent), W.BustedMaxLoss))
	EconomyService.addStat(player, "busted", 1)
	RemoteService.fire("Busted", player, lost)
	WantedService.clear(player)
	WantedService.Busted:Fire(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Sit = false
	end
	task.delay(0.6, function()
		local c2 = player.Character
		if c2 and c2.Parent then
			c2:PivotTo(World.PolicePoint)
			local ff = Instance.new("ForceField")
			ff.Visible = true
			ff.Parent = c2
			task.delay(5, function()
				ff:Destroy()
			end)
		end
	end)
end

-- ====================================================================
-- Policiers à pied
-- ====================================================================
local function groundPointNear(pos, minD, maxD)
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(minD, maxD)
		local p = pos + Vector3.new(math.cos(a) * d, 60, math.sin(a) * d)
		local r = workspace:Raycast(p, Vector3.new(0, -120, 0))
		if r and r.Position.Y < 3 and r.Position.Y > -1 then
			return r.Position + Vector3.new(0, 3, 0)
		end
	end
	return nil
end

local function spawnCop(player, s)
	if not copTemplate then
		return
	end
	local hrp = hrpOf(player)
	if not hrp then
		return
	end
	local pos = groundPointNear(hrp.Position, 70, 120)
	if not pos then
		return
	end
	local m = copTemplate:Clone()
	m.Name = "Policier"
	m:SetAttribute("Cop", true)
	m:SetAttribute("Target", player.UserId)
	m:PivotTo(CFrame.new(pos))
	m.Parent = copFolder
	local r = m:FindFirstChild("HumanoidRootPart")
	if r then
		r:SetNetworkOwner(nil)
	end
	PedestrianService.setupAnimation(m, true)
	table.insert(s.cops, m)
end

local function copStep(player, s, hrp)
	local speed, inVehicle = playerSpeed(player)
	local walk = 12 + s.stars * 2.5
	for i = #s.cops, 1, -1 do
		local m = s.cops[i]
		local r = m.Parent and m:FindFirstChild("HumanoidRootPart")
		if not r then
			table.remove(s.cops, i)
		else
			local hum = m:FindFirstChildOfClass("Humanoid")
			local d = (r.Position - hrp.Position).Magnitude
			if d > 260 or r.Position.Y < -8 then
				-- trop loin ou tombé : se replace près du joueur
				local p = groundPointNear(hrp.Position, 90, 130)
				if p then
					m:PivotTo(CFrame.new(p))
				end
			else
				hum.WalkSpeed = walk
				hum:MoveTo(hrp.Position)
				if r.AssemblyLinearVelocity.Magnitude < 1.5 and d > 6 then
					hum.Jump = true
				end
			end
			if d < 5.5 and (not inVehicle or speed < 10) and speed < 24 then
				bust(player)
				return
			end
		end
	end
end

-- ====================================================================
-- Voitures de police (IA arcade, suit le réseau de routes)
-- ====================================================================
local function gridLine(n)
	return -500 + Config.Map.Pitch * n
end

local function nearestLine(v)
	local n = math.clamp(math.floor((v + 500) / Config.Map.Pitch + 0.5), 0, 5)
	return n, gridLine(n)
end

local function lineOfSight(from, to, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local origin = from + Vector3.new(0, 3, 0)
	local r = workspace:Raycast(origin, (to + Vector3.new(0, 3, 0)) - origin, params)
	return r == nil
end

local function spawnCruiser(player, s)
	local hrp = hrpOf(player)
	if not hrp then
		return
	end
	-- intersection à 150-380 studs
	local best
	for _ = 1, 12 do
		local ix, iz = rng:NextInteger(0, 5), rng:NextInteger(0, 5)
		local p = World.RoadNodes[ix][iz]
		local d = Util.flatDistance(p, hrp.Position)
		if d > 150 and d < 380 then
			best = p
			break
		end
	end
	if not best then
		return
	end
	local dir = Util.flat(hrp.Position - best)
	local axisDir = math.abs(dir.X) > math.abs(dir.Z) and Vector3.new(math.sign(dir.X), 0, 0) or Vector3.new(0, 0, math.sign(dir.Z))
	local at = best + Vector3.new(0, 2.6, 0)
	local model = VehicleService.spawnCruiser(CFrame.lookAt(at, at + axisDir))
	table.insert(s.cruisers, { model = model, cmd = 0, stuck = 0, reverseUntil = 0, plan = nil })
end

local function cruiserStep(c, target, stars, dt)
	local model = c.model
	local chassis = model.PrimaryPart
	local lv = chassis and chassis:FindFirstChild("DriveVelocity")
	local av = chassis and chassis:FindFirstChild("TurnVelocity")
	if not lv or not av then
		return
	end
	local pos = chassis.Position
	local look = chassis.CFrame.LookVector
	local right = chassis.CFrame.RightVector
	local vel = chassis.AssemblyLinearVelocity
	local fwd = vel:Dot(look)
	local flatLook = Util.flat(look)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
	local now = os.clock()

	-- waypoint
	local waypoint
	local dist = Util.flatDistance(pos, target)
	if dist < 110 and lineOfSight(pos, target, { model, copFolder, workspace:FindFirstChild("Pedestrians"), workspace:FindFirstChild("Vehicles") }) then
		waypoint = target
		c.plan = nil
	else
		local alongZ = math.abs(flatLook.Z) >= math.abs(flatLook.X)
		local sgn = alongZ and math.sign(flatLook.Z) or math.sign(flatLook.X)
		if sgn == 0 then
			sgn = 1
		end
		local s = alongZ and pos.Z or pos.X
		local _, lateralLine = nearestLine(alongZ and pos.X or pos.Z)
		-- intersection devant le véhicule
		local aheadIdx = sgn > 0 and 5 or 0
		if sgn > 0 then
			for n = 0, 5 do
				if gridLine(n) > s + 12 then
					aheadIdx = n
					break
				end
			end
		else
			for n = 5, 0, -1 do
				if gridLine(n) < s - 12 then
					aheadIdx = n
					break
				end
			end
		end
		local nodeAlong = gridLine(aheadIdx)
		local node = alongZ and Vector3.new(lateralLine, 0, nodeAlong) or Vector3.new(nodeAlong, 0, lateralLine)
		local dNode = Util.flatDistance(pos, node)
		waypoint = node
		if dNode < 45 then
			-- décision au carrefour : on choisit la sortie la plus proche de la cible
			if not c.plan or c.plan.node ~= node then
				local options = {}
				local fwdDir = alongZ and Vector3.new(0, 0, sgn) or Vector3.new(sgn, 0, 0)
				local rightDir = Vector3.new(-fwdDir.Z, 0, fwdDir.X)
				for _, dir in ipairs({ fwdDir, rightDir, -rightDir }) do
					local nxt = node + dir * Config.Map.Pitch
					if math.abs(nxt.X) <= 500 and math.abs(nxt.Z) <= 500 then
						table.insert(options, { p = nxt, d = Util.flatDistance(nxt, target) })
					end
				end
				table.sort(options, function(a, b)
					return a.d < b.d
				end)
				c.plan = { node = node, nxt = options[1] and options[1].p or node + fwdDir * Config.Map.Pitch }
			end
			waypoint = c.plan.nxt
		else
			c.plan = nil
		end
	end

	-- direction souhaitée
	local to = Util.flat(waypoint - pos)
	local toUnit = to.Magnitude > 0.1 and to.Unit or flatLook
	local x = right:Dot(toUnit)
	local zc = look:Dot(toUnit)
	local steer = math.clamp(x * 2.4, -1, 1)
	if zc < -0.2 then
		steer = x >= 0 and 1 or -1
	end

	-- récupération si bloqué
	if math.abs(fwd) < 4 and now > c.reverseUntil then
		c.stuck += dt
		if c.stuck > 1.6 then
			c.reverseUntil = now + 1.1
			c.stuck = 0
		end
	elseif math.abs(fwd) >= 4 then
		c.stuck = 0
	end
	local maxSpeed = Config.Police.maxSpeed * (0.72 + 0.06 * stars)
	local targetSpeed = maxSpeed * math.clamp(1 - math.abs(x) * 0.55, 0.4, 1)
	if now < c.reverseUntil then
		targetSpeed = -22
		steer = -steer
	end
	local rate = fwd < targetSpeed and Config.Police.accel or 60
	local cmd = fwd + math.clamp(targetSpeed - fwd, -rate * dt, rate * dt)
	lv.PlaneVelocity = Vector2.new(0, -cmd)
	local speedFactor = math.clamp(math.abs(fwd) / 18, 0, 1) * (1 - 0.4 * math.min(1, math.abs(fwd) / maxSpeed))
	av.AngularVelocity = Vector3.new(0, -steer * Config.Police.turn * speedFactor * (fwd >= 0 and 1 or -1), 0)

	-- redresse si retourné
	if chassis.CFrame.UpVector.Y < 0.3 then
		chassis.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
		chassis.AssemblyLinearVelocity = Vector3.zero
		chassis.AssemblyAngularVelocity = Vector3.zero
	end
end

local function cruiserLoop()
	local last = os.clock()
	while true do
		task.wait(0.1)
		local now = os.clock()
		local dt = now - last
		last = now
		for player, s in pairs(states) do
			local hrp = hrpOf(player)
			for i = #s.cruisers, 1, -1 do
				local c = s.cruisers[i]
				if not c.model or not c.model.Parent or not c.model.PrimaryPart then
					table.remove(s.cruisers, i)
				elseif not hrp or s.stars == 0 then
					c.model:Destroy()
					table.remove(s.cruisers, i)
				else
					local chassis = c.model.PrimaryPart
					local d = (chassis.Position - hrp.Position).Magnitude
					if chassis.Position.Y < -8 or d > 520 then
						c.model:Destroy()
						table.remove(s.cruisers, i)
					else
						cruiserStep(c, hrp.Position, s.stars, dt)
						-- arrestation : voiture de police collée au joueur immobilisé
						local speed = playerSpeed(player)
						if d < 14 and speed < 7 then
							s.stopTimer += dt
							if s.stopTimer > 1.8 then
								s.stopTimer = 0
								bust(player)
							end
						end
					end
				end
			end
			if s.stars == 0 or #s.cruisers == 0 then
				s.stopTimer = 0
			end
		end
	end
end

-- ====================================================================
-- Boucle principale (4 Hz)
-- ====================================================================
local function mainLoop()
	local last = os.clock()
	while true do
		task.wait(0.25)
		local now = os.clock()
		local dt = now - last
		last = now
		for _, player in ipairs(Players:GetPlayers()) do
			local s = states[player]
			local hrp = hrpOf(player)
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if s and hrp and hum and hum.Health > 0 then
				if s.stars > 0 then
					local near = WantedService.copNear(player, W.LoseDistance)
					if not near then
						for _, c in ipairs(s.cruisers) do
							if c.model.PrimaryPart and (c.model.PrimaryPart.Position - hrp.Position).Magnitude < W.LoseDistance then
								near = true
							end
						end
					end
					if near then
						s.lastNear = now
					else
						s.heat = math.max(0, s.heat - W.DecayPerSec * dt)
						local newStars = starsFromHeat(s.heat)
						if newStars ~= s.stars then
							s.stars = newStars
							if newStars == 0 then
								RemoteService.notify(player, "Tu as semé la police !", "good")
								removeCops(s)
							end
						end
					end
					push(player, s, not near)
					-- maintien des effectifs
					local wantCops = W.MaxCopsByStars[s.stars] or 0
					if #s.cops < wantCops and not s.spawning then
						spawnCop(player, s)
					end
					local wantCruisers = W.MaxCruisersByStars[s.stars] or 0
					if #s.cruisers < wantCruisers and now - (s.lastCruiser or 0) > 5 then
						s.lastCruiser = now
						spawnCruiser(player, s)
					end
					copStep(player, s, hrp)
				end
			elseif s and hum and hum.Health <= 0 and s.stars > 0 then
				WantedService.clear(player)
			end
		end
	end
end

-- ====================================================================
-- Pay'n'Spray
-- ====================================================================
local function setupSprayPrompt(pad)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Se faire oublier"
	prompt.ObjectText = "Pay'n'Spray"
	prompt.HoldDuration = 1.2
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		local s = states[player]
		if not s or s.stars == 0 then
			RemoteService.notify(player, "Tu n'es pas recherché !", "info")
			return
		end
		local cost = W.SprayCostPerStar * s.stars
		if EconomyService.spendCash(player, cost) then
			WantedService.clear(player)
			RemoteService.notify(player, string.format("Casier effacé pour %s", Util.formatCash(cost)), "good")
		else
			RemoteService.notify(player, string.format("Il faut %s pour te faire oublier.", Util.formatCash(cost)), "bad")
		end
	end)
end

function WantedService.init(world)
	World = world
	copFolder = Instance.new("Folder")
	copFolder.Name = "Cops"
	copFolder.Parent = workspace

	local function onChar(player, char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				if states[player] and states[player].stars > 0 then
					WantedService.clear(player)
				end
			end)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		getState(player)
		player.CharacterAdded:Connect(function(c)
			onChar(player, c)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		getState(player)
		player.CharacterAdded:Connect(function(c)
			onChar(player, c)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		local s = states[player]
		if s then
			removeCops(s)
			states[player] = nil
		end
	end)

	for _, pad in ipairs(CollectionService:GetTagged("SprayHub")) do
		setupSprayPrompt(pad)
	end
end

function WantedService.start()
	-- Gabarit policier (créé une fois, cloné ensuite)
	task.spawn(function()
		copTemplate = PedestrianService.newRig({
			head = Color3.fromRGB(234, 184, 146),
			torso = Color3.fromRGB(30, 50, 120),
			arms = Color3.fromRGB(30, 50, 120),
			legs = Color3.fromRGB(25, 30, 60),
		})
	end)
	task.spawn(mainLoop)
	task.spawn(cruiserLoop)
end

return WantedService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[--[[
	WorldService : génère toute la ville avec des Parts natives Roblox (aucun asset externe).
	Grille 5x5 de blocs, routes, bâtiments par quartier, props destructibles, lampadaires,
	points d'intérêt (missions, concession, police...), éclairage et cycle jour/nuit.
	Appel : World.build() (bloquant, yield) puis World.* pour lire les points d'intérêt.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local VehicleBuilder = require(script.Parent.VehicleBuilder)

local World = {}

local M = Config.Map
local SW_H = M.SidewalkHeight -- hauteur du dessus des trottoirs
local ROAD_H = M.RoadHeight
local rng = Random.new(1337)

-- Données exposées
World.ParkingSpots = {} -- CFrame (position au sol + orientation le long de la route)
World.DeliveryPoints = {} -- Vector3
World.TaxiStops = {} -- Vector3
World.StarSpots = {} -- Vector3
World.RaceCircuit = {} -- Vector3
World.RoadNodes = {} -- [ix][iz] = Vector3
World.Spawn = CFrame.new(0, 3, 0)
World.PolicePoint = CFrame.new(0, 3, 372)
World.Hideout = Vector3.new(0, 0.5, -400)
World.Bank = Vector3.new(0, 0.5, -200)
World.Ready = false

local root, fRoads, fBuild, fBands, fProps, fBreak, fDecor
local made = 0

local function mk(parent, size, cf, color, material, extra)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	if typeof(cf) == "Vector3" then
		p.CFrame = CFrame.new(cf)
	else
		p.CFrame = cf
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local tag
	if extra then
		for k, v in pairs(extra) do
			if k == "Tag" then
				tag = v
			else
				p[k] = v
			end
		end
	end
	p.Parent = parent
	if tag then
		CollectionService:AddTag(p, tag)
	end
	made += 1
	if made % 350 == 0 then
		task.wait()
	end
	return p
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local NOCOLLIDE = { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }

local function sign(part, text, offsetY, width, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(width or 260, 56)
	bb.StudsOffset = Vector3.new(0, offsetY or 6, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 320
	bb.Parent = part
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundColor3 = rgb(20, 22, 30)
	tl.BackgroundTransparency = 0.15
	tl.Text = text
	tl.Font = Enum.Font.GothamBlack
	tl.TextSize = 26
	tl.TextColor3 = color or rgb(255, 255, 255)
	tl.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = tl
	local st = Instance.new("UIStroke")
	st.Color = color or rgb(255, 196, 0)
	st.Thickness = 2
	st.Parent = tl
end

-- Pastille lumineuse interactive (le serveur y attache les ProximityPrompt selon le tag/attribut)
local function hubPad(pos, color, tag, attrs, label)
	local pad = mk(fDecor, Vector3.new(0.5, 12, 12), CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, {
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		Transparency = 0.25,
		Tag = tag,
	})
	pad.Name = "Hub_" .. tag
	for k, v in pairs(attrs or {}) do
		pad:SetAttribute(k, v)
	end
	local beam = mk(fDecor, Vector3.new(60, 3, 3), CFrame.new(pos + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, {
		Shape = Enum.PartType.Cylinder,
		Transparency = 0.8,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	beam.Name = "HubBeam"
	if label then
		sign(pad, label, 9, 300, color)
	end
	return pad
end

-- ====================================================================
-- Briques de décor
-- ====================================================================
local function tree(x, z, big)
	local h = big and rng:NextNumber(10, 14) or rng:NextNumber(7, 10)
	mk(fProps, Vector3.new(1.6, h, 1.6), Vector3.new(x, SW_H + h / 2, z), rgb(110, 78, 50), Enum.Material.Wood)
	local d = h * 1.1 + 2
	mk(fProps, Vector3.new(d, d, d), Vector3.new(x, SW_H + h + d * 0.25, z), rgb(rng:NextInteger(50, 80), rng:NextInteger(130, 165), rng:NextInteger(50, 80)), Enum.Material.Grass, {
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		CastShadow = false,
	})
end

local function palm(x, z)
	local h = rng:NextNumber(14, 18)
	mk(fProps, Vector3.new(1.4, h, 1.4), Vector3.new(x, 0.3 + h / 2, z), rgb(150, 110, 70), Enum.Material.Wood)
	for k = 1, 5 do
		local a = k * math.pi * 2 / 5
		mk(fProps, Vector3.new(9, 0.4, 2.2), CFrame.new(x + math.cos(a) * 3.5, h + 0.2, z + math.sin(a) * 3.5) * CFrame.Angles(0, -a, math.rad(-18)), rgb(60, 150, 70), Enum.Material.Grass, NOCOLLIDE)
	end
end

local function lamp(x, z, rotY)
	mk(fProps, Vector3.new(0.7, 14, 0.7), Vector3.new(x, SW_H + 7, z), rgb(60, 62, 70), Enum.Material.Metal)
	mk(fProps, Vector3.new(2.4, 0.6, 1.4), CFrame.new(x, SW_H + 14, z) * CFrame.Angles(0, rotY, 0), rgb(255, 235, 170), Enum.Material.Neon, {
		Tag = "Lit",
		CanCollide = false,
		CastShadow = false,
	})
end

local function breakable(kind, x, z)
	local cf = CFrame.new(x, SW_H, z)
	local p
	if kind == "bench" then
		p = mk(fBreak, Vector3.new(6, 2.2, 1.8), cf * CFrame.new(0, 1.1, 0), rgb(120, 80, 50), Enum.Material.Wood)
	elseif kind == "hydrant" then
		p = mk(fBreak, Vector3.new(1.6, 2.8, 1.6), cf * CFrame.new(0, 1.4, 0), rgb(220, 50, 50), Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
		p.CFrame = cf * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.pi / 2)
	elseif kind == "bin" then
		p = mk(fBreak, Vector3.new(2.6, 2.2, 2.2), cf * CFrame.new(0, 1.3, 0), rgb(70, 130, 90), Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
		p.CFrame = cf * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.pi / 2)
	elseif kind == "crate" then
		p = mk(fBreak, Vector3.new(3.2, 3.2, 3.2), cf * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), rgb(176, 130, 80), Enum.Material.Wood)
	else -- mailbox
		p = mk(fBreak, Vector3.new(1.6, 3, 1.6), cf * CFrame.new(0, 1.5, 0), rgb(50, 90, 200), Enum.Material.Metal)
	end
	p.Name = kind
	return p
end

local function bandedTower(cx, cz, w, d, h, color, glass)
	mk(fBuild, Vector3.new(w, h, d), Vector3.new(cx, SW_H + h / 2, cz), color, Enum.Material.Concrete)
	local n = math.floor((h - 4) / 6)
	for k = 0, n - 1 do
		mk(fBands, Vector3.new(w + 0.5, 3.4, d + 0.5), Vector3.new(cx, SW_H + 4.5 + k * 6, cz), glass, Enum.Material.Glass, {
			CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Tag = "Lit",
		})
	end
	mk(fBuild, Vector3.new(w + 2, 1.2, d + 2), Vector3.new(cx, SW_H + h + 0.6, cz), rgb(70, 72, 80), Enum.Material.Concrete)
	if rng:NextNumber() < 0.5 then
		mk(fBuild, Vector3.new(0.8, 14, 0.8), Vector3.new(cx, SW_H + h + 8, cz), rgb(200, 200, 205), Enum.Material.Metal)
		mk(fBuild, Vector3.new(1.4, 1.4, 1.4), Vector3.new(cx, SW_H + h + 15, cz), rgb(255, 60, 60), Enum.Material.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
	end
end

local function house(cx, cz, faceDir, colorIdx)
	local pastel = {
		rgb(236, 214, 170), rgb(190, 220, 200), rgb(230, 190, 190), rgb(200, 205, 235),
		rgb(240, 230, 190), rgb(210, 190, 160),
	}
	local c = pastel[(colorIdx % #pastel) + 1]
	local w, h, d = 30, 14, 24
	mk(fBuild, Vector3.new(w, h, d), Vector3.new(cx, SW_H + h / 2, cz), c, Enum.Material.Brick)
	mk(fBuild, Vector3.new(w + 3, 1.2, d + 3), CFrame.new(cx, SW_H + h + 0.6, cz), rgb(150, 70, 60), Enum.Material.Slate)
	mk(fBuild, Vector3.new(w - 2, 3, d - 2), CFrame.new(cx, SW_H + h + 2.4, cz), rgb(150, 70, 60), Enum.Material.Slate)
	mk(fBuild, Vector3.new(3, 5, 3), Vector3.new(cx + 9, SW_H + h + 4, cz - 4), rgb(120, 60, 50), Enum.Material.Brick)
	-- face avant : +/- Z
	local fz = cz + faceDir * (d / 2)
	mk(fBuild, Vector3.new(4, 7.5, 0.5), Vector3.new(cx, SW_H + 3.75, fz + faceDir * 0.1), rgb(90, 60, 40), Enum.Material.Wood, { CanCollide = false })
	for _, sx in ipairs({ -9, 9 }) do
		mk(fBands, Vector3.new(5, 4, 0.4), Vector3.new(cx + sx, SW_H + 7, fz + faceDir * 0.1), rgb(120, 170, 210), Enum.Material.Glass, {
			CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Tag = "Lit",
		})
	end
	-- allée + point de livraison
	mk(fBuild, Vector3.new(5, 0.1, 20), Vector3.new(cx, SW_H + 0.05, fz + faceDir * 11), rgb(190, 185, 175), Enum.Material.Concrete, { CanCollide = false })
	table.insert(World.DeliveryPoints, Vector3.new(cx, SW_H, fz + faceDir * 21))
	-- clôture basse (destructible)
	breakable("mailbox", cx + 6, fz + faceDir * 21)
end

local function warehouse(cx, cz, w, d, h, color)
	mk(fBuild, Vector3.new(w, h, d), Vector3.new(cx, SW_H + h / 2, cz), color, Enum.Material.Metal)
	mk(fBuild, Vector3.new(w + 1.5, 1, d + 1.5), Vector3.new(cx, SW_H + h + 0.5, cz), rgb(90, 92, 98), Enum.Material.Metal)
	mk(fBuild, Vector3.new(w * 0.25, h * 0.7, 0.6), Vector3.new(cx, SW_H + h * 0.35, cz - d / 2 - 0.1), rgb(60, 62, 68), Enum.Material.Metal, { CanCollide = false })
	for k = -1, 1, 2 do
		mk(fBands, Vector3.new(w * 0.18, 2, d + 0.5), Vector3.new(cx + k * w * 0.32, SW_H + h - 3, cz), rgb(100, 140, 170), Enum.Material.Glass, {
			CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Tag = "Lit",
		})
	end
end

local function container(x, z, rotY, level)
	local cols = { rgb(200, 60, 50), rgb(50, 110, 190), rgb(230, 170, 40), rgb(60, 150, 90), rgb(120, 120, 130) }
	mk(fBuild, Vector3.new(7, 7, 24), CFrame.new(x, SW_H + 3.5 + (level or 0) * 7, z) * CFrame.Angles(0, rotY, 0), cols[rng:NextInteger(1, #cols)], Enum.Material.CorrodedMetal)
end

-- ====================================================================
-- Routes et blocs
-- ====================================================================
local function buildGroundAndRoads()
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -12, 0), Vector3.new(4000, 16, 4000), Enum.Material.Water)

	mk(fRoads, Vector3.new(M.GroundHalf * 2, 6, M.GroundHalf * 2), Vector3.new(0, -3, 0), rgb(96, 150, 78), Enum.Material.Grass).Name = "Ground"

	local span = 1040
	local asphalt = rgb(58, 60, 66)
	for k = 0, 5 do
		local c = -500 + M.Pitch * k
		mk(fRoads, Vector3.new(M.RoadWidth, 0.6, span), Vector3.new(c, 0, 0), asphalt, Enum.Material.Asphalt)
		mk(fRoads, Vector3.new(span, 0.6, M.RoadWidth), Vector3.new(0, 0, c), asphalt, Enum.Material.Asphalt)
	end
	-- marquage central pointillé (on évite les intersections)
	for k = 0, 5 do
		local c = -500 + M.Pitch * k
		local t = -500
		while t < 500 do
			local nearNode = false
			for n = 0, 5 do
				if math.abs(t - (-500 + M.Pitch * n)) < 30 then
					nearNode = true
					break
				end
			end
			if not nearNode then
				mk(fDecor, Vector3.new(0.8, 0.1, 12), Vector3.new(c, 0.35, t), rgb(240, 200, 60), Enum.Material.SmoothPlastic, NOCOLLIDE)
				mk(fDecor, Vector3.new(12, 0.1, 0.8), Vector3.new(t, 0.35, c), rgb(240, 200, 60), Enum.Material.SmoothPlastic, NOCOLLIDE)
			end
			t += 32
		end
	end
	-- passages piétons au centre
	for _, ix in ipairs({ 2, 3 }) do
		for _, iz in ipairs({ 2, 3 }) do
			local p = World.RoadNodes[ix][iz]
			for s = -1, 1, 2 do
				for k = -3, 3 do
					mk(fDecor, Vector3.new(1.6, 0.1, 9), Vector3.new(p.X + k * 3.8, 0.35, p.Z + s * 26), rgb(240, 240, 240), Enum.Material.SmoothPlastic, NOCOLLIDE)
					mk(fDecor, Vector3.new(9, 0.1, 1.6), Vector3.new(p.X + s * 26, 0.35, p.Z + k * 3.8), rgb(240, 240, 240), Enum.Material.SmoothPlastic, NOCOLLIDE)
				end
			end
		end
	end

	-- digue périphérique visible + mur invisible haut
	local H = M.GroundHalf
	local gapZ0, gapZ1 = 40, 150 -- ouverture pour la jetée (côté est)
	local function wall(size, pos)
		mk(fDecor, size, pos, rgb(150, 152, 158), Enum.Material.Concrete)
		mk(fDecor, Vector3.new(size.X, 60, size.Z), pos + Vector3.new(0, 33, 0), rgb(255, 255, 255), Enum.Material.SmoothPlastic, { Transparency = 1, CanQuery = false })
	end
	wall(Vector3.new(H * 2, 5, 4), Vector3.new(0, 2.5, -H + 2))
	wall(Vector3.new(H * 2, 5, 4), Vector3.new(0, 2.5, H - 2))
	wall(Vector3.new(4, 5, H * 2), Vector3.new(-H + 2, 2.5, 0))
	-- côté est en deux morceaux (jetée au milieu)
	wall(Vector3.new(4, 5, (H + gapZ0) - 0), Vector3.new(H - 2, 2.5, -H + (H + gapZ0) / 2))
	wall(Vector3.new(4, 5, H - gapZ1), Vector3.new(H - 2, 2.5, gapZ1 + (H - gapZ1) / 2))
end

local function buildBlockSlab(i, j, material, color)
	local c = Config.blockCenter(i, j)
	mk(fRoads, Vector3.new(M.BlockSize, SW_H, M.BlockSize), Vector3.new(c.X, SW_H / 2, c.Z), color or rgb(176, 176, 180), material or Enum.Material.Concrete).Name = ("Block_%d_%d"):format(i, j)
	-- lampadaires sur les bords
	for s = -1, 1, 2 do
		lamp(c.X + s * 76, c.Z - 40, 0)
		lamp(c.X + s * 76, c.Z + 40, 0)
		lamp(c.X - 40, c.Z + s * 76, math.pi / 2)
		lamp(c.X + 40, c.Z + s * 76, math.pi / 2)
	end
	-- mobilier urbain destructible
	local kinds = { "bench", "hydrant", "bin", "crate", "mailbox" }
	for _ = 1, 4 do
		local side = rng:NextInteger(1, 4)
		local t = rng:NextNumber(-60, 60)
		local x, z
		if side == 1 then
			x, z = c.X + t, c.Z - 74
		elseif side == 2 then
			x, z = c.X + t, c.Z + 74
		elseif side == 3 then
			x, z = c.X - 74, c.Z + t
		else
			x, z = c.X + 74, c.Z + t
		end
		breakable(kinds[rng:NextInteger(1, #kinds)], x, z)
	end
	return c
end

-- ====================================================================
-- Quartiers
-- ====================================================================
local function districtDowntown(i, j)
	local c = buildBlockSlab(i, j)
	local cols = { rgb(120, 130, 145), rgb(150, 155, 165), rgb(95, 105, 120), rgb(170, 150, 130), rgb(80, 90, 110) }
	local glass = { rgb(60, 100, 140), rgb(40, 70, 100), rgb(70, 120, 120) }
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			local h = rng:NextInteger(40, 150)
			if not (i == 3 and j == 2 and sz == 1) then -- la banque occupe le côté sud de ce bloc
			bandedTower(c.X + sx * 38, c.Z + sz * 38, rng:NextInteger(44, 56), rng:NextInteger(44, 56), h, cols[rng:NextInteger(1, #cols)], glass[rng:NextInteger(1, #glass)])
			end
		end
	end
	return c
end

local function districtResidential(i, j)
	local c = buildBlockSlab(i, j)
	local k = 0
	for _, row in ipairs({ -1, 1 }) do
		for col = -1, 1 do
			k += 1
			local hx, hz = c.X + col * 50, c.Z + row * 38
			if not (i == 1 and j == 3 and row == -1 and col == 1) then -- emplacement de la pizzeria
				house(hx, hz, row, k + i + j)
				tree(hx + 20 * (col == 0 and 1 or -col), hz + row * 4, false)
			end
		end
	end
	return c
end

local function districtIndustrial(i, j)
	local c = buildBlockSlab(i, j, Enum.Material.Concrete, rgb(150, 150, 150))
	warehouse(c.X - 30, c.Z - 38, 70, 50, 24, rgb(130, 140, 150))
	warehouse(c.X + 36, c.Z + 38, 60, 50, 20, rgb(140, 120, 100))
	for k = 0, 2 do
		container(c.X + 50, c.Z - 40 + k * 8, math.pi / 2, k % 2)
		container(c.X - 52, c.Z + 38 + (k - 1) * 8, math.pi / 2, 0)
	end
	for _ = 1, 6 do
		breakable("crate", c.X + rng:NextNumber(-60, 60), c.Z + rng:NextNumber(-8, 8))
	end
	return c
end

