-- ====================================================================
-- Jumps (rampes) et étoiles
-- ====================================================================
local function jumpRamp(x, z, rotY)
	local len, rise = 30, 12
	local ang = math.atan(rise / len)
	local cf = CFrame.new(x, 0.3 + rise / 2, z) * CFrame.Angles(0, rotY, 0) * CFrame.Angles(ang, 0, 0)
	-- l'avant (-Z local) monte : rotation +X relève -Z
	mk(fProps, Vector3.new(16, 1.2, math.sqrt(len * len + rise * rise)), cf, rgb(255, 160, 40), Enum.Material.Metal)
	local fwd = CFrame.Angles(0, rotY, 0).LookVector
	local starPos = Vector3.new(x, 0, z) + fwd * 42 + Vector3.new(0, 16, 0)
	table.insert(World.StarSpots, starPos)
end

local function placeStars()
	-- 4 étoiles sur rampes (routes périphériques)
	jumpRamp(-500, -350, 0) -- route ouest, vers -Z
	jumpRamp(500, 350, math.pi) -- route est, vers +Z
	jumpRamp(-350, 500, math.pi / 2 * -1) -- route sud
	jumpRamp(350, -500, math.pi / 2) -- route nord

	-- étoiles au sol : recoins de blocs (toujours sur trottoir)
	local c0 = rng
	local spots = {
		{ 1, 1 }, { 2, 1 }, { 4, 1 }, { 1, 3 }, { 1, 5 }, { 2, 5 }, { 4, 5 }, { 5, 5 }, { 5, 4 }, { 5, 2 },
		{ 3, 1 }, { 2, 3 }, { 4, 3 }, { 3, 4 }, { 5, 1 }, { 1, 2 }, { 1, 4 }, { 3, 2 }, { 2, 2 }, { 4, 4 }, { 4, 2 },
	}
	for k, b in ipairs(spots) do
		local c = Config.blockCenter(b[1], b[2])
		local a = c0:NextNumber(0, math.pi * 2)
		local r = 62
		table.insert(World.StarSpots, Vector3.new(c.X + math.cos(a) * r, SW_H + 3, c.Z + math.sin(a) * r))
		if #World.StarSpots >= Config.Collectibles.Count - 5 then
			break
		end
	end
	-- jetée, plage, toits bas
	table.insert(World.StarSpots, Vector3.new(M.GroundHalf + 100, 4, 95))
	table.insert(World.StarSpots, Vector3.new(M.GroundHalf + 190, 4, 95))
	table.insert(World.StarSpots, Vector3.new(M.GroundHalf - 70, 4, -300))
	table.insert(World.StarSpots, Vector3.new(M.GroundHalf - 70, 4, 300))
	table.insert(World.StarSpots, Vector3.new(-610, 4, 0))
	while #World.StarSpots > Config.Collectibles.Count do
		table.remove(World.StarSpots)
	end
end

-- ====================================================================
-- Points de circulation
-- ====================================================================
local function computeNodes()
	for ix = 0, 5 do
		World.RoadNodes[ix] = {}
		for iz = 0, 5 do
			World.RoadNodes[ix][iz] = Config.nodePos(ix, iz)
		end
	end
	local ring = { { 5, 0 }, { 2, 0 }, { 0, 0 }, { 0, 3 }, { 0, 5 }, { 3, 5 }, { 5, 5 }, { 5, 3 } }
	for _, n in ipairs(ring) do
		table.insert(World.RaceCircuit, World.RoadNodes[n[1]][n[2]])
	end
end

local function computeParking()
	local count = 0
	local tries = 0
	while count < 30 and tries < 400 do
		tries += 1
		local alongZ = rng:NextInteger(0, 1) == 1
		local line = rng:NextInteger(0, 5)
		local c = -500 + M.Pitch * line
		local t = rng:NextNumber(-470, 470)
		-- éviter les intersections
		local ok = true
		for n = 0, 5 do
			if math.abs(t - (-500 + M.Pitch * n)) < 55 then
				ok = false
			end
		end
		if ok then
			local side = rng:NextInteger(0, 1) == 1 and 1 or -1
			local pos, yaw
			if alongZ then
				pos = Vector3.new(c + side * 12, 0.3, t)
				yaw = side > 0 and math.pi or 0
			else
				pos = Vector3.new(t, 0.3, c + side * 12)
				yaw = side > 0 and -math.pi / 2 or math.pi / 2
			end
			table.insert(World.ParkingSpots, CFrame.new(pos) * CFrame.Angles(0, yaw, 0))
			count += 1
		end
	end
end

local function computeTaxiStops()
	for _ = 1, 12 do
		local i, j = rng:NextInteger(1, 5), rng:NextInteger(1, 5)
		local c = Config.blockCenter(i, j)
		local side = rng:NextInteger(1, 4)
		local t = rng:NextNumber(-50, 50)
		local p
		if side == 1 then
			p = Vector3.new(c.X + t, SW_H, c.Z - 76)
		elseif side == 2 then
			p = Vector3.new(c.X + t, SW_H, c.Z + 76)
		elseif side == 3 then
			p = Vector3.new(c.X - 76, SW_H, c.Z + t)
		else
			p = Vector3.new(c.X + 76, SW_H, c.Z + t)
		end
		table.insert(World.TaxiStops, p)
	end
end

-- ====================================================================
-- Lumière & jour/nuit
-- ====================================================================
local function setupLighting()
	Lighting.Brightness = 2.5
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.OutdoorAmbient = rgb(110, 115, 130)
	Lighting.Ambient = rgb(70, 72, 82)
	Lighting.GeographicLatitude = 30
	Lighting.ClockTime = 12
	for _, name in ipairs({ "CRAtmosphere", "CRBloom", "CRColor", "CRSunRays" }) do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Name = "CRAtmosphere"
	atm.Density = 0.28
	atm.Offset = 0.2
	atm.Color = rgb(190, 205, 225)
	atm.Decay = rgb(120, 130, 150)
	atm.Glare = 0.1
	atm.Haze = 1.4
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CRBloom"
	bloom.Intensity = 0.25
	bloom.Size = 22
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "CRColor"
	cc.Saturation = 0.12
	cc.Contrast = 0.06
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "CRSunRays"
	rays.Intensity = 0.05
	rays.Spread = 0.6
	rays.Parent = Lighting
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.45
	clouds.Density = 0.5
	clouds.Parent = workspace.Terrain
	workspace.Terrain.WaterTransparency = 0.7
	workspace.Terrain.WaterColor = rgb(30, 110, 160)
	workspace.Terrain.WaterWaveSize = 0.3
end

local function startDayCycle()
	task.spawn(function()
		local clock = 12
		local step = 24 / Config.DayLengthSeconds
		while true do
			task.wait(1)
			clock = (clock + step) % 24
			Lighting.ClockTime = clock
		end
	end)
end

-- ====================================================================
-- Props destructibles
-- ====================================================================
local brokenQueue = 0
function World.breakProp(part)
	if not part or not part.Parent or part.Parent ~= fBreak then
		return false
	end
	local original = part:Clone()
	local home = fBreak
	part.Anchored = false
	part.CanCollide = false
	part.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(25, 45), rng:NextNumber(-25, 25))
	part.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
	part.Name = "Debris"
	part.Parent = fDecor
	Debris:AddItem(part, 4)
	task.delay(35, function()
		if home and home.Parent then
			original.Parent = home
		end
	end)
	return true
end

World.BreakFolder = nil

-- ====================================================================
-- Construction principale
-- ====================================================================
function World.build()
	local old = workspace:FindFirstChild("City")
	if old then
		old:Destroy()
	end
	root = folder("City", workspace)
	fRoads = folder("Roads", root)
	fBuild = folder("Buildings", root)
	fBands = folder("Windows", root)
	fProps = folder("Props", root)
	fBreak = folder("Breakables", root)
	fDecor = folder("Decor", root)
	World.BreakFolder = fBreak
	World.Root = root

	setupLighting()
	computeNodes()
	buildGroundAndRoads()

	local builders = {
		residential = districtResidential,
		industrial = districtIndustrial,
		downtown = districtDowntown,
		plaza = districtPlaza,
		harbor = districtHarbor,
		beach = districtBeach,
		stadium = districtStadium,
		park = districtPark,
		payspray = districtPaySpray,
		police = districtPolice,
		dealer = districtDealer,
	}
	for j = 1, M.Grid do
		for i = 1, M.Grid do
			builders[Config.Districts[j][i]](i, j)
		end
	end

	addBank(3, 2)
	addPizzeria(1, 3)
	addTaxiStand(3, 3)
	addHideout()
	placeStars()
	computeParking()
	computeTaxiStops()
	startDayCycle()

	root:SetAttribute("Built", true)
	World.Ready = true
	print(string.format("[World] Ville générée : %d parts", made))
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX33"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX32"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX23"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--[[
	Client.client.lua : point d'entrée client de CITY RUSH.
	Écran de chargement, mise à l'échelle de l'interface (téléphone / tablette / PC / console),
	puis initialisation des contrôleurs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Controllers = script.Parent:WaitForChild("Controllers")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local UI = require(Controllers:WaitForChild("UI"))
local State = require(Controllers:WaitForChild("State"))

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- ScreenGui principal (le HUD est sous la barre Roblox : IgnoreGuiInset = false)
local gui = UI.new("ScreenGui", {
	Name = "CityRushGui", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false, DisplayOrder = 5, Parent = playerGui,
})
local uiScale = UI.new("UIScale", { Parent = gui })
local function updateScale()
	local vp = workspace.CurrentCamera.ViewportSize
	local base = UserInputService.TouchEnabled and 560 or 900
	uiScale.Scale = math.clamp(vp.Y / base, 0.6, 1.25)
end
updateScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

-- Écran de chargement
local loading = UI.new("ScreenGui", { Name = "CityRushLoading", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, Parent = playerGui })
local bg = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(16, 18, 26), BorderSizePixel = 0, Parent = loading })
UI.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(600, 90), Text = "CITY RUSH", TextSize = 72, Font = Enum.Font.GothamBlack, TextColor3 = UI.Theme.Accent, Parent = bg })
local tip = UI.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.fromOffset(700, 30), Text = "Chargement de la ville...", TextSize = 22, TextColor3 = UI.Theme.Muted, Parent = bg })
local TIPS = {
	"Vole n'importe quelle voiture garée dans la rue !",
	"Shift = nitro. R = remettre la voiture sur ses roues.",
	"Évite de renverser des piétons : la police te surveille.",
	"30 étoiles dorées sont cachées, certaines sont dans les airs.",
	"Le Pay'n'Spray efface ton niveau de recherche contre de l'argent.",
}

local started = false
local function start()
	if started then
		return
	end
	started = true
	State.init()
	require(Controllers:WaitForChild("VehicleController")).init()
	require(Controllers:WaitForChild("Atmosphere")).init()
	require(Controllers:WaitForChild("Hud")).init(gui)
	require(Controllers:WaitForChild("Panels")).init(gui)
end

task.spawn(function()
	local t0 = os.clock()
	local i = 1
	repeat
		tip.Text = TIPS[(i % #TIPS) + 1]
		i += 1
		task.wait(1.2)
	until workspace:GetAttribute("WorldReady") or os.clock() - t0 > 90
	-- contrôleurs prêts dès que le serveur a créé les remotes
	ReplicatedStorage:WaitForChild("CityRushRemotes", 30)
	start()
	-- attendre le personnage
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 20)
	task.wait(1)
	for _ = 1, 20 do
		bg.BackgroundTransparency += 0.05
		for _, c in ipairs(bg:GetChildren()) do
			if c:IsA("TextLabel") then
				c.TextTransparency = bg.BackgroundTransparency
			end
		end
		task.wait(0.03)
	end
	loading:Destroy()
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX31"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Atmosphere</string><ProtectedString name="Source"><![CDATA[--[[
	Atmosphere.lua : effets visuels côté client
	- fenêtres et lampadaires allumés la nuit (tag "Lit")
	- phares des véhicules occupés la nuit
	- gyrophares de police
	- étoiles dorées qui tournent / masquées une fois collectées
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local State = require(script.Parent.State)

local Atmosphere = {}

local isNight = false
local lit = {} -- [part] = {material, color}
local litList = {}

local function nightNow()
	local t = Lighting.ClockTime
	return t >= 18.3 or t < 5.7
end

local function applyLit(part, night)
	local info = lit[part]
	if not info or not part.Parent then
		return
	end
	if night and info.on then
		part.Material = Enum.Material.Neon
		part.Color = info.warm
	else
		part.Material = info.material
		part.Color = info.color
	end
end

local function registerLit(part)
	if not part:IsA("BasePart") or lit[part] then
		return
	end
	local h = (math.floor(part.Position.X * 7 + part.Position.Y * 13 + part.Position.Z * 3)) % 10
	lit[part] = {
		material = part.Material, color = part.Color, on = h < 7,
		warm = (part.Material == Enum.Material.Neon) and part.Color or Color3.fromRGB(255, 226 - h * 4, 150 + h * 3),
	}
	table.insert(litList, part)
	if part.Material == Enum.Material.Neon then
		lit[part].on = false -- lampadaires : déjà lumineux
	end
	applyLit(part, isNight)
end

local function setNight(night)
	isNight = night
	-- appliqué par lots pour éviter une saccade
	task.spawn(function()
		local n = 0
		for i = #litList, 1, -1 do
			local p = litList[i]
			if not p.Parent then
				lit[p] = nil
				table.remove(litList, i)
			else
				applyLit(p, night)
				n += 1
				if n % 150 == 0 then
					RunService.Heartbeat:Wait()
				end
			end
		end
	end)
end

function Atmosphere.init()
	for _, p in ipairs(CollectionService:GetTagged("Lit")) do
		registerLit(p)
	end
	CollectionService:GetInstanceAddedSignal("Lit"):Connect(registerLit)

	-- boucle lente : nuit / phares
	task.spawn(function()
		while true do
			local night = nightNow()
			if night ~= isNight then
				setNight(night)
			end
			for _, hl in ipairs(CollectionService:GetTagged("Headlight")) do
				local light = hl:FindFirstChildOfClass("SpotLight")
				local seat = hl.Parent and hl.Parent:FindFirstChild("DriverSeat")
				if light then
					light.Enabled = night and seat ~= nil and seat.Occupant ~= nil
				end
			end
			task.wait(1)
		end
	end)

	-- gyrophares
	task.spawn(function()
		local flip = false
		while true do
			flip = not flip
			for _, p in ipairs(CollectionService:GetTagged("SirenA")) do
				p.Transparency = flip and 0 or 0.7
			end
			for _, p in ipairs(CollectionService:GetTagged("SirenB")) do
				p.Transparency = flip and 0.7 or 0
			end
			task.wait(0.22)
		end
	end)

	-- étoiles dorées
	local t0 = os.clock()
	local function starVisible(part)
		local id = part:GetAttribute("StarId")
		local taken = id and State.collected[id]
		part.LocalTransparencyModifier = taken and 1 or 0
		local l = part:FindFirstChildOfClass("PointLight")
		if l then
			l.Enabled = not taken
		end
		return not taken
	end
	local bases = {}
	RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		for _, part in ipairs(CollectionService:GetTagged("GoldStar")) do
			bases[part] = bases[part] or part.CFrame
			if starVisible(part) then
				local b = bases[part]
				part.CFrame = CFrame.new(b.Position + Vector3.new(0, math.sin(t * 2 + b.X) * 0.6, 0)) * CFrame.Angles(math.rad(45), t * 1.5, math.rad(45))
			end
		end
	end)
end

return Atmosphere
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud.lua : interface de jeu permanente (niveau, argent, radar, étoiles de recherche,
	mission, notifications, compteur de vitesse, bannières d'événements, écran d'arrestation).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local MapView = require(script.Parent.MapView)
local VehicleController = require(script.Parent.VehicleController)

local Hud = {}
local T = UI.Theme
local player = Players.LocalPlayer
local KIND_COLORS = {
	good = T.Good, bad = T.Bad, info = T.Info, levelup = T.Accent, star = T.Accent, achv = Color3.fromRGB(170, 100, 255),
}

local gui, root
local refs = {}
local pillar, pillarGui

local function ping(id)
	local s = Instance.new("Sound")
	s.SoundId = id or "rbxasset://sounds/electronicpingshort.wav"
	s.Volume = 0.5
	s.Parent = SoundService
	s:Play()
	task.delay(2, function()
		s:Destroy()
	end)
end

-- ====================================================================
-- Notifications
-- ====================================================================
local function toast(text, kind)
	local color = KIND_COLORS[kind] or T.Info
	local f = UI.panel({
		Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Parent = refs.toasts,
	})
	UI.stroke(f, color, 2)
	UI.padding(f, 10)
	local l = UI.label({
		Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, Text = text,
		TextSize = kind == "levelup" and 22 or 17, TextColor3 = color == T.Info and T.Text or color, Parent = f,
	})
	f.BackgroundTransparency = 1
	UI.tween(f, TweenInfo.new(0.2), { BackgroundTransparency = 0.1 })
	if kind == "levelup" or kind == "star" or kind == "good" or kind == "achv" then
		ping()
	end
	task.delay(4.5, function()
		if f.Parent then
			UI.tween(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			UI.tween(l, TweenInfo.new(0.4), { TextTransparency = 1 })
			task.wait(0.45)
			f:Destroy()
		end
	end)
end

-- ====================================================================
-- Construction
-- ====================================================================
