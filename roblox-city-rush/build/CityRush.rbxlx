	refs.xp2 = UI.label({ Position = UDim2.fromOffset(105, 4), Size = UDim2.fromOffset(100, 24), Text = "", TextSize = 13, TextColor3 = T.Good, TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
