local function buildHints()
	if UserInputService.TouchEnabled then
		return
	end
	UI.label({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -8), Size = UDim2.fromOffset(520, 18),
		Text = "G Garage · B Boutique · M Carte · P Profil · Shift Nitro · R Redresser · Saut = sortir", TextSize = 13,
		TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = root,
	})
end

-- ====================================================================
-- Mise à jour
-- ====================================================================
local function onState(d)
	refs.level.Text = "Niv. " .. d.Level
	refs.xpFill.Size = UDim2.fromScale(math.clamp(d.XP / d.XPNeed, 0, 1), 1)
	refs.xpText.Text = string.format("%d / %d XP", d.XP, d.XPNeed)
	refs.cash.Text = Util.formatCash(d.Cash)
	refs.vip.Text = d.Vip and "VIP" or ""
	refs.xp2.Text = d.DoubleXP and "XP x2 !" or ""
	if refs.menuButtons and refs.menuButtons.daily then
		refs.menuButtons.daily.BackgroundColor3 = d.DailyAvailable and T.Accent or T.Panel
	end
end

local function onWanted(stars, evading)
	for i, s in ipairs(refs.stars) do
		s.Visible = stars > 0
		s.TextColor3 = i <= stars and Color3.fromRGB(255, 215, 40) or Color3.fromRGB(80, 80, 90)
	end
	refs.wantedText.Text = stars > 0 and (evading and "Fuis hors de vue de la police..." or "La police te poursuit !") or ""
	refs.wantedText.TextColor3 = evading and T.Muted or T.Bad
end

local function clearPillar()
	if pillar then
		pillar:Destroy()
		pillar = nil
	end
end

local function onMission(m)
	clearPillar()
	if not m then
		refs.missionPanel.Visible = false
		return
	end
	refs.missionPanel.Visible = true
	refs.mTitle.Text = m.title
	refs.mText.Text = m.text
	refs.mReward.Text = "Gain : " .. Util.formatCash(m.reward) .. (m.steps > 1 and m.type == "race" and string.format("  (point %d/%d)", m.step, m.steps) or "")
	refs.mTitle.TextColor3 = m.color or T.Accent

	pillar = Instance.new("Part")
	pillar.Name = "MissionPillar"
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(300, m.radius * 1.4, m.radius * 1.4)
	pillar.CFrame = CFrame.new(m.target + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	pillar.Material = Enum.Material.Neon
	pillar.Color = m.color or T.Accent
	pillar.Transparency = 0.6
	pillar.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 34)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 90, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = math.huge
	bb.Parent = pillar
	pillarGui = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3, BackgroundColor3 = Color3.new(0, 0, 0), Parent = bb })
	UI.corner(pillarGui, 8)
end

local function onBanner(info)
	if info.kind == "airdrop" then
		State.airdropPositions = info.positions
		task.delay(info.duration or 120, function()
			State.airdropPositions = nil
		end)
	elseif info.kind == "airdrop_end" then
		State.airdropPositions = nil
	end
	refs.bannerText.Text = info.text
	UI.tween(refs.banner, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 110) })
	ping()
	task.delay(7, function()
		UI.tween(refs.banner, TweenInfo.new(0.4), { Position = UDim2.new(0.5, 0, 0, -80) })
	end)
end

local function onBusted(lost)
	refs.busted.Visible = true
	refs.bustedSub.Text = lost > 0 and ("Amende : " .. Util.formatCash(lost)) or "Tu t'en sors sans amende."
	refs.busted.BackgroundTransparency = 0.2
	UI.tween(refs.busted, TweenInfo.new(2.6), { BackgroundTransparency = 1 })
	task.delay(2.6, function()
		refs.busted.Visible = false
	end)
end

function Hud.init(screenGui)
	gui = screenGui
	root = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	buildLevel()
	buildCash()
	buildMenuButtons()
	buildWanted()
	buildToasts()
	buildMission()
	buildSpeedo()
	buildBanner()
	buildBusted()
	buildHints()

	local radarSize = UserInputService.TouchEnabled and 130 or 170
	refs.radar = MapView.new(root, Vector2.new(radarSize, radarSize), 0.32, { Position = UDim2.fromOffset(10, 72) })

	State.Changed:Connect(onState)
	State.WantedChanged:Connect(onWanted)
	State.MissionChanged:Connect(onMission)
	State.Notified:Connect(toast)
	State.Banner:Connect(onBanner)
	State.BustedSignal:Connect(onBusted)
	if State.data then
		onState(State.data)
	end
	if State.mission then
		onMission(State.mission)
	end

	VehicleController.Updated:Connect(function(speed, boost, driving)
		refs.speedo.Visible = driving
		if refs.boostButton then
			refs.boostButton.Visible = driving
		end
		if driving then
			refs.speed.Text = tostring(math.floor(speed))
			refs.boostFill.Size = UDim2.fromScale(boost, 1)
		end
	end)

	-- boucle d'affichage (radar 10 Hz, mission, étoiles clignotantes)
	local acc = 0
	local blink = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		blink += dt
		if State.stars > 0 and State.evading then
			local on = math.floor(blink * 3) % 2 == 0
			for i, s in ipairs(refs.stars) do
				if i <= State.stars then
					s.TextTransparency = on and 0 or 0.6
				end
			end
		end
		local m = State.mission
		if m and refs.missionPanel.Visible then
			local left = m.deadline - (workspace:GetServerTimeNow())
			refs.mTime.Text = Util.formatTime(left)
			refs.mTime.TextColor3 = left < 15 and T.Bad or T.Text
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = Util.flatDistance(hrp.Position, m.target)
				refs.mInfo.Text = string.format("Distance : %d m", math.floor(d * 0.28))
				if pillarGui then
					pillarGui.Text = string.format("%d m", math.floor(d * 0.28))
				end
			end
		end
		if acc < 0.1 then
			return
		end
		acc = 0
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local look = workspace.CurrentCamera.CFrame.LookVector
			refs.radar:update(hrp.Position, math.deg(math.atan2(look.X, -look.Z)))
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">MapView</string><ProtectedString name="Source"><![CDATA[--[[
	MapView : carte nord en haut (nord = -Z). Utilisée pour le mini-radar et la grande carte.
	Le décor de la carte est dessiné à partir de Config (grille, quartiers, POI).
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)

local MapView = {}
MapView.__index = MapView

local HALF = Config.Map.GroundHalf
local COLORS = {
	residential = Color3.fromRGB(190, 200, 170), industrial = Color3.fromRGB(140, 140, 145),
	downtown = Color3.fromRGB(120, 135, 160), plaza = Color3.fromRGB(215, 200, 170),
	harbor = Color3.fromRGB(150, 150, 160), beach = Color3.fromRGB(231, 208, 150),
	stadium = Color3.fromRGB(110, 170, 110), park = Color3.fromRGB(80, 150, 70),
	payspray = Color3.fromRGB(200, 195, 160), police = Color3.fromRGB(120, 140, 190), dealer = Color3.fromRGB(150, 190, 215),
}

function MapView.new(parent, size, scale, props)
	local self = setmetatable({}, MapView)
	self.scale = scale
	self.size = size
	props = props or {}
	props.Size = UDim2.fromOffset(size.X, size.Y)
	props.BackgroundColor3 = Color3.fromRGB(30, 100, 150)
	props.ClipsDescendants = true
	props.BorderSizePixel = 0
	props.Parent = parent
	self.frame = UI.new("Frame", props)
	UI.corner(self.frame, 12)
	UI.stroke(self.frame, UI.Theme.Accent, 2)

	local total = HALF * 2 * scale
	self.canvas = UI.new("Frame", {
		Size = UDim2.fromOffset(total, total),
		BackgroundColor3 = Color3.fromRGB(96, 150, 78),
		BorderSizePixel = 0,
		Parent = self.frame,
	})
	local function rect(x, z, w, d, color, z_index)
		return UI.new("Frame", {
			Position = UDim2.fromOffset((x - w / 2 + HALF) * scale, (z - d / 2 + HALF) * scale),
			Size = UDim2.fromOffset(math.max(1, w * scale), math.max(1, d * scale)),
			BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z_index or 1, Parent = self.canvas,
		})
	end
	for j = 1, Config.Map.Grid do
		for i = 1, Config.Map.Grid do
			local c = Config.blockCenter(i, j)
			rect(c.X, c.Z, Config.Map.BlockSize, Config.Map.BlockSize, COLORS[Config.Districts[j][i]] or Color3.new(1, 1, 1), 2)
		end
	end
	for k = 0, 5 do
		local c = -500 + Config.Map.Pitch * k
		rect(c, 0, Config.Map.RoadWidth, 1040, Color3.fromRGB(70, 72, 80), 1)
		rect(0, c, 1040, Config.Map.RoadWidth, Color3.fromRGB(70, 72, 80), 1)
	end
	for _, poi in ipairs(Config.POIs) do
		local dot = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((poi.x + HALF) * scale, (poi.z + HALF) * scale),
			Size = UDim2.fromOffset(18, 18), BackgroundColor3 = poi.color, Text = poi.glyph,
			Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = Color3.new(0, 0, 0), ZIndex = 5, Parent = self.canvas,
		})
		UI.corner(dot, 9)
	end

	self.blipLayer = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Parent = self.canvas })
	self.pool = {}
	self.used = 0
	self.me = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1, Text = "▲", Font = Enum.Font.GothamBlack, TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 10, Parent = self.frame,
	})
	UI.new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, Parent = self.me })
	return self
end

function MapView:blip(worldPos, color, size, glyph)
	self.used += 1
	local b = self.pool[self.used]
	if not b then
		b = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Text = "", Font = Enum.Font.GothamBlack,
			TextSize = 11, TextColor3 = Color3.new(0, 0, 0), ZIndex = 6, Parent = self.blipLayer,
		})
		UI.corner(b, 20)
		self.pool[self.used] = b
	end
	b.Visible = true
	b.BackgroundColor3 = color
	b.Size = UDim2.fromOffset(size or 10, size or 10)
	b.Text = glyph or ""
	b.Position = UDim2.fromOffset((worldPos.X + HALF) * self.scale, (worldPos.Z + HALF) * self.scale)
end

function MapView:update(centerPos, heading)
	self.used = 0
	local s = self.scale
	self.canvas.Position = UDim2.fromOffset(self.size.X / 2 - (centerPos.X + HALF) * s, self.size.Y / 2 - (centerPos.Z + HALF) * s)
	if heading then
		self.me.Rotation = heading
	end
	local m = State.mission
	if m and m.target then
		self:blip(m.target, m.color or Color3.new(1, 1, 1), 16, "★")
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				self:blip(hrp.Position, Color3.fromRGB(120, 220, 255), 8)
			end
		end
	end
	local cops = workspace:FindFirstChild("Cops")
	if cops then
		for _, c in ipairs(cops:GetChildren()) do
			local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
			if r then
				self:blip(r.Position, Color3.fromRGB(70, 110, 255), 9)
			end
		end
	end
	local drops = State.airdropPositions
	if drops then
		for _, p in ipairs(drops) do
			self:blip(p, Color3.fromRGB(90, 230, 120), 12, "$")
		end
	end
	for i = self.used + 1, #self.pool do
		self.pool[i].Visible = false
	end
end

return MapView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[--[[
	Panels.lua : fenêtres modales (garage / concessionnaire, boutique Robux, profil + succès + classement,
	grande carte, récompense quotidienne). Raccourcis clavier : G, B, P, M.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Ids = require(Shared:WaitForChild("MonetizationIds"))

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local MapView = require(script.Parent.MapView)

local Panels = {}
local T = UI.Theme
local player = Players.LocalPlayer

local gui, window, titleLabel, content, current, bigMap
local rebuild

local function clear()
	for _, c in ipairs(content:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	if bigMap then
		bigMap = nil
	end
end

local function scroll(parent)
	local s = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 6, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent,
	})
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = s })
	UI.new("UIPadding", { PaddingRight = UDim.new(0, 10), Parent = s })
	return s
end

local function bar(parent, label, value, max, color, y)
	UI.label({ Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(70, 14), Text = label, TextSize = 12, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = parent })
	local b = UI.new("Frame", { Position = UDim2.fromOffset(72, y + 2), Size = UDim2.fromOffset(120, 10), BackgroundColor3 = T.PanelLight, BorderSizePixel = 0, Parent = parent })
	UI.corner(b, 5)
	local fill = UI.new("Frame", { Size = UDim2.fromScale(math.clamp(value / max, 0.04, 1), 1), BackgroundColor3 = color, BorderSizePixel = 0, Parent = b })
	UI.corner(fill, 5)
end

-- ====================================================================
-- Véhicules (garage et concessionnaire)
-- ====================================================================
local function vehiclePanel(mode)
	local list = scroll(content)
	local d = State.data
	if not d then
		return
	end
	for order, v in ipairs(Config.Vehicles) do
		local owned = d.Owned[v.id] == true
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 116), BackgroundColor3 = T.PanelLight, LayoutOrder = order, Parent = list })
		UI.label({ Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(240, 24), Text = v.name, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local info = UI.new("Frame", { Position = UDim2.fromOffset(12, 40), Size = UDim2.fromOffset(200, 50), BackgroundTransparency = 1, Parent = row })
		bar(info, "Vitesse", v.maxSpeed, 180, T.Bad, 0)
		bar(info, "Accélération", v.accel, 90, T.Accent, 16)
		bar(info, "Maniabilité", v.turn, 2.3, T.Info, 32)
		local color = (d.Colors and d.Colors[v.id] and Config.VehicleColors[d.Colors[v.id]]) or v.color
		UI.new("Frame", { Position = UDim2.fromOffset(12, 96), Size = UDim2.fromOffset(100, 4), BackgroundColor3 = color, BorderSizePixel = 0, Parent = row })

		local right = UI.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(190, 100), BackgroundTransparency = 1, Parent = row })
		if owned and (mode == "garage" or v.price <= 0 or true) then
			UI.button({ Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(190, 38), Text = "SORTIR", BackgroundColor3 = T.Good, TextSize = 18, Parent = right }, function()
				State.send("RequestSpawn", v.id)
				Panels.close()
			end)
			local sw = UI.new("Frame", { Position = UDim2.fromOffset(0, 48), Size = UDim2.fromOffset(190, 44), BackgroundTransparency = 1, Parent = right })
			UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(20, 20), CellPadding = UDim2.fromOffset(4, 4), Parent = sw })
			for idx, c in ipairs(Config.VehicleColors) do
				UI.button({ Size = UDim2.fromOffset(20, 20), Text = "", BackgroundColor3 = c, Parent = sw }, function()
					State.send("RequestColor", v.id, idx)
				end)
			end
		else
			local text, enabled
			if v.gamepass then
				text, enabled = "Réservé VIP", false
			elseif d.Level < v.level then
				text, enabled = string.format("Niveau %d requis", v.level), false
			else
				text, enabled = "ACHETER  " .. Util.formatCash(v.price), d.Cash >= v.price
			end
			local b = UI.button({ Size = UDim2.fromOffset(190, 44), Text = text, TextSize = 15, BackgroundColor3 = enabled and T.Accent or Color3.fromRGB(70, 70, 80), TextColor3 = enabled and Color3.new(0, 0, 0) or T.Muted, Parent = right }, function()
				if enabled then
					State.send("RequestBuy", v.id)
				end
			end)
			UI.label({ Position = UDim2.fromOffset(0, 52), Size = UDim2.fromOffset(190, 40), Text = v.gamepass and "Achète le pass VIP dans la boutique" or (enabled and "" or string.format("Prix %s - niveau %d", Util.formatCash(v.price), v.level)), TextSize = 12, TextColor3 = T.Muted, TextWrapped = true, Parent = right })
			b.Active = enabled
		end
	end
end

-- ====================================================================
-- Boutique Robux
-- ====================================================================
local function shopPanel()
	local list = scroll(content)
	UI.label({ Size = UDim2.new(1, 0, 0, 24), Text = "Argent", TextSize = 20, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = list })
	for i, p in ipairs(Config.Products) do
		local id = Ids.Products[p.key] or 0
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.PanelLight, LayoutOrder = 1 + i, Parent = list })
		UI.label({ Position = UDim2.fromOffset(12, 6), Size = UDim2.fromOffset(260, 24), Text = p.name, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.label({ Position = UDim2.fromOffset(12, 32), Size = UDim2.fromOffset(260, 22), Text = p.desc, TextSize = 14, TextColor3 = T.Good, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(120, 40), Text = id ~= 0 and ("R$ " .. p.robux) or "Bientôt", BackgroundColor3 = id ~= 0 and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(70, 70, 80), Parent = row }, function()
			if id ~= 0 then
				MarketplaceService:PromptProductPurchase(player, id)
			end
		end)
	end
	UI.label({ Size = UDim2.new(1, 0, 0, 24), Text = "Passes", TextSize = 20, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 10, Parent = list })
	for i, p in ipairs(Config.GamePasses) do
		local id = Ids.GamePasses[p.key] or 0
		local has = State.data and ((p.key == "VIP" and State.data.Vip) or (p.key == "BOOST" and State.data.Boost))
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = T.PanelLight, LayoutOrder = 10 + i, Parent = list })
		UI.label({ Position = UDim2.fromOffset(12, 6), Size = UDim2.fromOffset(300, 24), Text = p.name, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.label({ Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -150, 0, 36), Text = p.desc, TextSize = 13, TextColor3 = T.Muted, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = row })
		UI.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(120, 40), Text = has and "Possédé" or (id ~= 0 and ("R$ " .. p.robux) or "Bientôt"), BackgroundColor3 = has and T.Good or (id ~= 0 and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(70, 70, 80)), Parent = row }, function()
			if id ~= 0 and not has then
				MarketplaceService:PromptGamePassPurchase(player, id)
			end
		end)
	end
end

-- ====================================================================
-- Profil : statistiques, succès, classement
-- ====================================================================
local function profilePanel()
	local list = scroll(content)
	local d = State.data
	if not d then
		return
	end
	local function line(order, a, b)
		local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = order, Parent = list })
		UI.label({ Size = UDim2.fromScale(0.6, 1), Text = a, TextSize = 16, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.4, 1), Text = b, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
	end
	local s = d.Stats
	line(1, "Niveau", tostring(d.Level))
	line(2, "Argent", Util.formatCash(d.Cash))
	line(3, "Distance parcourue", string.format("%.1f km", s.km or 0))
	line(4, "Missions réussies", tostring(s.missions or 0))
	line(5, "Livraisons / Taxis / Courses", string.format("%d / %d / %d", s.deliveries or 0, s.taxis or 0, s.races or 0))
	line(6, "Braquages réussis", tostring(s.heists or 0))
	line(7, "Étoiles dorées", string.format("%d / %d", s.collected or 0, State.totalStars))
	line(8, "Arrestations", tostring(s.busted or 0))
	line(9, "Meilleure course", (s.bestRace or 0) > 0 and Util.formatTime(s.bestRace) or "-")
	UI.label({ Size = UDim2.new(1, 0, 0, 28), Text = "Succès", TextSize = 20, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 20, Parent = list })
	for i, a in ipairs(Config.Achievements) do
		local done = d.Achv and d.Achv[a.id]
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = done and Color3.fromRGB(36, 70, 50) or T.PanelLight, LayoutOrder = 20 + i, Parent = list })
		UI.label({ Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -120, 0, 22), Text = (done and "✔ " or "") .. a.name, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.label({ Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -120, 0, 20), Text = a.desc, TextSize = 12, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.label({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 24), Text = "+" .. Util.formatCash(a.reward), TextSize = 14, TextColor3 = T.Good, Parent = row })
	end
	UI.label({ Size = UDim2.new(1, 0, 0, 28), Text = "Classement des fortunes", TextSize = 20, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 50, Parent = list })
	if #State.leaderboard == 0 then
		UI.label({ Size = UDim2.new(1, 0, 0, 24), Text = "Chargement du classement...", TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 51, Parent = list })
	end
	for i, r in ipairs(State.leaderboard) do
		line(50 + i, string.format("%d. %s", i, r.name), Util.formatCash(r.cash))
	end
end

-- ====================================================================
-- Carte
-- ====================================================================
local function mapPanel()
	local size = window.AbsoluteSize
	local side = math.max(260, math.min(size.X - 40, size.Y - 90))
	local holder = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	bigMap = MapView.new(holder, Vector2.new(side, side), side / (Config.Map.GroundHalf * 2) * 1.0, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	-- carte centrée sur la ville, le marqueur est repositionné au joueur
	local scale = side / (Config.Map.GroundHalf * 2)
	bigMap:update(Vector3.zero, nil)
	if hrp then
		bigMap.me.Position = UDim2.fromOffset((hrp.Position.X + Config.Map.GroundHalf) * scale, (hrp.Position.Z + Config.Map.GroundHalf) * scale)
		bigMap.me.Parent = bigMap.canvas
		local look = workspace.CurrentCamera.CFrame.LookVector
		bigMap.me.Rotation = math.deg(math.atan2(look.X, -look.Z))
	end
	bigMap.canvas.Position = UDim2.fromOffset(0, 0)
	local legend = UI.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -2), Size = UDim2.new(1, -8, 0, 36), Text = "P Pizzeria · T Taxi · $ Banque · C Course · V Concession · S Pay'n'Spray · ! Police · H Planque", TextSize = 12, TextColor3 = T.Muted, TextWrapped = true, Parent = holder })
	legend.ZIndex = 20
end

-- ====================================================================
-- Quotidien
-- ====================================================================
local function dailyPanel()
	local d = State.data
	local box = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	UI.label({ Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 40), Text = "Récompense quotidienne", TextSize = 28, TextColor3 = T.Accent, Parent = box })
	if not d then
		return
	end
	UI.label({ Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 30), Text = string.format("Série en cours : %d jour(s) (max %d)", d.DailyStreak, Config.Daily.MaxStreak), TextSize = 18, Parent = box })
	local row = UI.new("Frame", { Position = UDim2.new(0.5, 0, 0, 105), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(7 * 54, 50), BackgroundTransparency = 1, Parent = box })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = row })
	for i = 1, Config.Daily.MaxStreak do
		local reached = i < d.DailyStreak or (i == d.DailyStreak and not d.DailyAvailable)
		local cell = UI.panel({ Size = UDim2.fromOffset(50, 50), BackgroundColor3 = reached and T.Good or T.PanelLight, Parent = row })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = tostring(i), TextSize = 22, TextColor3 = reached and Color3.new(0, 0, 0) or T.Text, Parent = cell })
	end
	UI.label({ Position = UDim2.fromOffset(0, 170), Size = UDim2.new(1, 0, 0, 30), Text = d.DailyAvailable and ("Aujourd'hui : " .. Util.formatCash(d.DailyReward)) or "Reviens demain pour la suite !", TextSize = 22, TextColor3 = T.Good, Parent = box })
	if d.DailyAvailable then
		UI.button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 215), Size = UDim2.fromOffset(240, 50), Text = "RÉCUPÉRER", TextSize = 22, BackgroundColor3 = T.Accent, TextColor3 = Color3.new(0, 0, 0), Parent = box }, function()
			State.send("ClaimDaily")
		end)
	end
end

local BUILDERS = {
	garage = { "Garage", function() vehiclePanel("garage") end },
	dealer = { "Concessionnaire", function() vehiclePanel("dealer") end },
	shop = { "Boutique", shopPanel },
	profile = { "Profil", profilePanel },
	map = { "Carte de la ville", mapPanel },
	daily = { "Cadeau quotidien", dailyPanel },
}

rebuild = function()
	if not current then
		return
	end
	clear()
	titleLabel.Text = BUILDERS[current][1]
	BUILDERS[current][2]()
end

function Panels.close()
	current = nil
	window.Visible = false
end

function Panels.open(name)
	if not BUILDERS[name] then
		return
	end
	if current == name then
		Panels.close()
		return
	end
	current = name
	window.Visible = true
	rebuild()
end

function Panels.init(screenGui)
	gui = screenGui
	window = UI.panel({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.8, 0, 0.8, 0),
		Visible = false, ZIndex = 20, Parent = gui,
	})
	local lim = UI.new("UISizeConstraint", { MaxSize = Vector2.new(680, 520), MinSize = Vector2.new(300, 240), Parent = window })
	UI.stroke(window, T.Accent, 2)
	titleLabel = UI.label({ Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -80, 0, 34), Text = "", TextSize = 24, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left, Parent = window })
	UI.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(40, 34), Text = "✕", TextSize = 20, BackgroundColor3 = T.Bad, Parent = window }, Panels.close)
	content = UI.new("Frame", { Position = UDim2.fromOffset(12, 52), Size = UDim2.new(1, -24, 1, -64), BackgroundTransparency = 1, Parent = window })

	State.Changed:Connect(function()
		if current and current ~= "map" then
			rebuild()
		end
	end)
	State.LeaderboardChanged:Connect(function()
		if current == "profile" then
			rebuild()
		end
	end)
	State.PanelRequested:Connect(function(name)
		if name == "dealer" and current == "dealer" then
			return
		end
		Panels.open(name)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local k = input.KeyCode
		if k == Enum.KeyCode.G then
			Panels.open("garage")
		elseif k == Enum.KeyCode.B then
			Panels.open("shop")
		elseif k == Enum.KeyCode.P then
			Panels.open("profile")
		elseif k == Enum.KeyCode.M then
			Panels.open("map")
		end
	end)

	-- cadeau quotidien proposé une fois par session
	local shown = false
	State.Changed:Connect(function(d)
		if d.DailyAvailable and not shown then
			shown = true
			task.delay(6, function()
				if not current then
					Panels.open("daily")
				end
			end)
		end
	end)
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--[[
	State.lua : état client synchronisé avec le serveur (lecture seule côté UI).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local State = {}
State.Changed = Util.newSignal() -- (data)
State.MissionChanged = Util.newSignal() -- (mission|nil)
State.WantedChanged = Util.newSignal() -- (stars, evading)
State.Notified = Util.newSignal() -- (text, kind)
State.Banner = Util.newSignal() -- (info)
State.PanelRequested = Util.newSignal() -- (name)
State.BustedSignal = Util.newSignal() -- (lost)
State.LeaderboardChanged = Util.newSignal() -- (rows)
State.CollectedChanged = Util.newSignal() -- (list, total)

State.data = nil
State.mission = nil
State.stars = 0
State.evading = false
State.collected = {}
State.totalStars = 30
State.leaderboard = {}
State.serverOffset = 0

local remotes

function State.remote(name)
	return remotes:WaitForChild(name)
end

function State.send(name, ...)
	local r = remotes:FindFirstChild(name)
	if r then
		r:FireServer(...)
	end
end

function State.init()
	remotes = ReplicatedStorage:WaitForChild("CityRushRemotes")

	State.remote("State").OnClientEvent:Connect(function(data)
		State.data = data
		State.Changed:Fire(data)
	end)
	State.remote("Notify").OnClientEvent:Connect(function(text, kind)
		State.Notified:Fire(text, kind)
	end)
	State.remote("Wanted").OnClientEvent:Connect(function(stars, evading)
		State.stars = stars
		State.evading = evading
		State.WantedChanged:Fire(stars, evading)
	end)
	State.remote("Mission").OnClientEvent:Connect(function(m)
		State.mission = m
		State.MissionChanged:Fire(m)
	end)
	State.remote("Banner").OnClientEvent:Connect(function(info)
		State.Banner:Fire(info)
	end)
	State.remote("OpenPanel").OnClientEvent:Connect(function(name)
		State.PanelRequested:Fire(name)
	end)
	State.remote("Busted").OnClientEvent:Connect(function(lost)
		State.BustedSignal:Fire(lost)
	end)
	State.remote("Leaderboard").OnClientEvent:Connect(function(rows)
		State.leaderboard = rows
		State.LeaderboardChanged:Fire(rows)
	end)
	State.remote("Collected").OnClientEvent:Connect(function(list, total)
		State.collected = {}
		for _, id in ipairs(list) do
			State.collected[id] = true
		end
		State.totalStars = total or State.totalStars
		State.CollectedChanged:Fire(list, total)
	end)

	State.send("RequestState")
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI.lua : petites fabriques d'interface au style Roblox (Gotham, coins arrondis).
]]

local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local UI = {}
UI.Theme = Config.Theme

function UI.new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(parent, radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

function UI.stroke(parent, color, thickness)
	return UI.new("UIStroke", {
		Color = color or UI.Theme.PanelLight,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UI.padding(parent, px)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		Parent = parent,
	})
end

function UI.panel(props)
	props.BackgroundColor3 = props.BackgroundColor3 or UI.Theme.Panel
	props.BorderSizePixel = 0
	local f = UI.new("Frame", props)
	UI.corner(f, 12)
	return f
end

function UI.label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or UI.Theme.Text
	props.TextSize = props.TextSize or 18
	return UI.new("TextLabel", props)
end

-- Bouton avec petit effet de pression
function UI.button(props, onClick)
	props.BackgroundColor3 = props.BackgroundColor3 or UI.Theme.PanelLight
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or UI.Theme.Text
	props.TextSize = props.TextSize or 18
	props.AutoButtonColor = true
	props.BorderSizePixel = 0
	local b = UI.new("TextButton", props)
	UI.corner(b, 10)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

function UI.tween(inst, info, goal)
	local t = TweenService:Create(inst, info, goal)
	t:Play()
	return t
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">VehicleController</string><ProtectedString name="Source"><![CDATA[--[[
	VehicleController : pilotage arcade du véhicule par le client du conducteur.
	Lit les entrées du VehicleSeat (clavier, manette, joystick tactile gérés par Roblox),
	écrit la vitesse cible dans les contraintes créées par le serveur.
	Nitro : Shift / bouton X manette / bouton tactile. R : remettre le véhicule sur ses roues.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local State = require(script.Parent.State)

local VehicleController = {}
VehicleController.Updated = Util.newSignal() -- (kmh, boostFraction, driving)
VehicleController.Driving = false

local player = Players.LocalPlayer
local boostHeld = false
local conn
local flipTimer = 0

function VehicleController.setBoost(on)
	boostHeld = on
end

local function uprightReset(chassis)
	local pos = chassis.Position
	local look = chassis.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	chassis.AssemblyLinearVelocity = Vector3.zero
	chassis.AssemblyAngularVelocity = Vector3.zero
	chassis.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)) * CFrame.Angles(0, yaw, 0)
end

local function stop(camera)
	if conn then
		conn:Disconnect()
		conn = nil
	end
	VehicleController.Driving = false
	boostHeld = false
	VehicleController.Updated:Fire(0, 0, false)
	if camera then
		camera.FieldOfView = 70
	end
end

local function startDriving(hum, seat)
	local model = seat.Parent
	local chassis = model.PrimaryPart
	local lv = chassis and chassis:FindFirstChild("DriveVelocity")
	local av = chassis and chassis:FindFirstChild("TurnVelocity")
	if not lv or not av then
		return
	end
	local camera = workspace.CurrentCamera
	local maxSpeed = model:GetAttribute("MaxSpeed") or 80
	local accel = model:GetAttribute("Accel") or 40
	local turn = model:GetAttribute("Turn") or 2
	local boost = Config.BoostMax
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.3, 0.6)
	emitter.Speed = NumberRange.new(8, 14)
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 80, 30))
	emitter.Size = NumberSequence.new(1.6, 0)
	emitter.LightEmission = 1
	emitter.Parent = chassis

	VehicleController.Driving = true
	if conn then
		conn:Disconnect()
	end
	conn = RunService.Heartbeat:Connect(function(dt)
		dt = math.min(dt, 0.05)
		if not seat.Parent or seat.Occupant ~= hum or not chassis.Parent then
			emitter:Destroy()
			stop(camera)
			return
		end
		local throttle = seat.ThrottleFloat
		local steer = seat.SteerFloat
		local look = chassis.CFrame.LookVector
		local vel = chassis.AssemblyLinearVelocity
		local fwd = vel:Dot(look)
		local data = State.data
		local hasBoostPass = data and data.Boost

		local boosting = boostHeld and boost > 0 and throttle > 0
		if boosting then
			boost = math.max(0, boost - Config.BoostDrainPerSec * (hasBoostPass and 0.5 or 1) * dt)
		else
			boost = math.min(Config.BoostMax, boost + Config.BoostRegenPerSec * (hasBoostPass and 2 or 1) * dt)
		end
		emitter.Rate = boosting and 60 or 0

		local mul = boosting and 1.35 or 1
		local target
		if throttle >= 0 then
			target = throttle * maxSpeed * mul
		else
			target = throttle * maxSpeed * 0.35
		end
		local rate
		if throttle == 0 then
			rate = 24
		elseif throttle * fwd < 0 then
			rate = 120 -- freinage
		else
			rate = accel * (boosting and 1.7 or 1)
		end
		local cmd = fwd + math.clamp(target - fwd, -rate * dt, rate * dt)
		lv.PlaneVelocity = Vector2.new(0, -cmd)

		local speedFactor = math.clamp(math.abs(fwd) / 18, 0, 1) * (1 - 0.4 * math.min(1, math.abs(fwd) / (maxSpeed * 1.3)))
		av.AngularVelocity = Vector3.new(0, -steer * turn * speedFactor * (fwd >= 0 and 1 or -1), 0)

		-- retournement automatique
		if chassis.CFrame.UpVector.Y < 0.35 then
			flipTimer += dt
			if flipTimer > 1.5 then
				flipTimer = 0
				uprightReset(chassis)
			end
		else
			flipTimer = 0
		end

		camera.FieldOfView = camera.FieldOfView + ((70 + math.clamp(math.abs(fwd) / maxSpeed, 0, 1.3) * 16 + (boosting and 6 or 0)) - camera.FieldOfView) * math.min(1, dt * 4)
		VehicleController.Updated:Fire(math.abs(fwd), boost / Config.BoostMax, true)
	end)
end

local function onCharacter(char)
	local hum = char:WaitForChild("Humanoid")
	hum.Seated:Connect(function(active, seat)
		if active and seat and seat:IsA("VehicleSeat") and seat:GetAttribute("CRVehicle") then
			startDriving(hum, seat)
		end
	end)
end

function VehicleController.init()
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonX then
			boostHeld = true
		elseif input.KeyCode == Enum.KeyCode.R and not processed and VehicleController.Driving then
			local c = player.Character
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			local seat = hum and hum.SeatPart
			if seat and seat.Parent and seat.Parent.PrimaryPart then
				uprightReset(seat.Parent.PrimaryPart)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonX then
			boostHeld = false
		end
	end)
end

return VehicleController
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>