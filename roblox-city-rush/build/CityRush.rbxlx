	local defs = {
		{ "garage", "🚗", "Garage (G)" }, { "shop", "💎", "Boutique (B)" }, { "profile", "🏆", "Profil (P)" },
		{ "map", "🗺", "Carte (M)" }, { "daily", "🎁", "Cadeau" },
