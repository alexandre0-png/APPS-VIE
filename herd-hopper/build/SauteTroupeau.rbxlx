-- ---------------------------------------------------------------------------
-- Mise à jour périodique
-- ---------------------------------------------------------------------------

local function rebuildLives(maxLives, lives)
	if builtLives ~= maxLives then
		builtLives = maxLives
		for _, child in ipairs(refs.livesRow:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		refs.hearts = {}
		for i = 1, maxLives do
			local heart = UI.heart(refs.livesRow, 24, PINK)
			heart.LayoutOrder = i
			refs.hearts[i] = heart
		end
	end
	for i, heart in ipairs(refs.hearts or {}) do
		local color = i <= lives and PINK or Color3.fromRGB(70, 74, 90)
		for _, part in ipairs(heart:GetChildren()) do
			if part:IsA("Frame") then
				part.BackgroundColor3 = color
			end
		end
	end
end

local function updateScores()
	local list = ClientState.Scores
	for i = 1, 6 do
		local row = refs.rows[i]
		local entry = list[i]
		if entry then
			local you = entry.id == player.UserId
			row.Text = ("%d. %s  %s"):format(i, entry.n, Util.formatNumber(entry.s))
			row.TextColor3 = you and UI.Colors.Accent or UI.Colors.Text
			row.Visible = true
		else
			row.Visible = false
		end
	end
end

local function update()
	local phase = workspace:GetAttribute("Phase") or "Intermission"
	local waiting = workspace:GetAttribute("Waiting")
	local remaining = (workspace:GetAttribute("PhaseEnd") or 0) - workspace:GetServerTimeNow()
	local status = ClientState.Status
	local playing = ClientState.isPlaying() or status == "Dead"
	local running = phase == "Running"
	local ready = workspace:GetAttribute("ReadyCount") or 0

	-- bandeau
	if phase == "Intermission" then
		refs.bannerText.Text = waiting and "Personne n'est parti" or ("Départ dans " .. Util.formatTime(remaining))
	elseif phase == "Countdown" then
		refs.bannerText.Text = "Prépare-toi !"
	elseif phase == "Running" then
		refs.bannerText.Text = "Temps restant : " .. Util.formatTime(remaining)
	else
		refs.bannerText.Text = "Bilan"
	end

	-- compte à rebours géant + nom de la zone
	if phase == "Countdown" then
		local n = math.ceil(remaining)
		refs.countdown.Visible = true
		if n >= 1 then
			refs.countdown.Text = tostring(n)
			if n ~= lastCountdown then
				lastCountdown = n
				Sfx.play("tick")
			end
		else
			refs.countdown.Text = "GO !"
			if lastCountdown ~= 0 then
				lastCountdown = 0
				Sfx.play("go")
			end
		end
		local round = workspace:GetAttribute("Round") or 0
		if round ~= lastRound and ClientState.isPlaying() then
			lastRound = round
			local zone = Config.Zones[workspace:GetAttribute("StartZone") or 1]
			HUD.feedback({
				kind = "event",
				title = zone.name,
				sub = "Danger : " .. zone.hazard.name .. ". Ne touche pas le sol !",
			})
		end
	else
		refs.countdown.Visible = false
		lastCountdown = -1
	end

	-- indications
	if running and status == "Lobby" then
		refs.hint.Text = "Une expédition est en cours : ton zoo travaille, rejoins la suivante."
	elseif running and (status == "Out" or status == "Finished") then
		refs.hint.Text = status == "Finished" and "Expédition terminée !" or "Tu regardes la suite de l'expédition."
	elseif phase == "Intermission" then
		refs.hint.Text = waiting and "Choisis une zone dans EXPÉDITION et appuie sur PARTIR."
			or ("%d prêt(s). Tu peux encore te préparer."):format(ready)
		if not waiting then
			refs.hint.Text = TIPS[math.floor(os.clock() / 6) % #TIPS + 1]
		end
	else
		refs.hint.Text = ""
	end

	-- blocs de jeu
	local showScore = playing or status == "Out" or status == "Finished"
	refs.scoreBox.Visible = showScore and (running or phase == "Countdown")
	refs.board.Visible = (running or phase == "Countdown") and #ClientState.Scores > 0
	refs.rideBox.Visible = status == "Riding"
	refs.action.Visible = ClientState.isPlaying()
	refs.lasso.Visible = ClientState.isPlaying()
	refs.zone.Visible = playing and running

	if refs.scoreBox.Visible then
		refs.score.Text = Util.formatNumber(player:GetAttribute("RunScore") or 0)
		local combo = player:GetAttribute("Combo") or 0
		if combo ~= lastCombo then
			lastCombo = combo
			if combo >= 2 then
				refs.comboScale.Scale = 1.4
				UI.tween(refs.comboScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
		refs.combo.Text = combo >= 2 and ("COMBO x%.1f"):format(player:GetAttribute("ComboMult") or 1) or ""
		UI.tween(refs.comboFill, 0.1, { Size = UDim2.new(player:GetAttribute("ComboLeft") or 0, 0, 1, 0) })
		refs.runGold.Text = ("Or gagné : %s · animaux : %d"):format(
			Util.formatNumber(player:GetAttribute("RunGold") or 0),
			player:GetAttribute("Captures") or 0
		)
		rebuildLives(player:GetAttribute("MaxLives") or 1, player:GetAttribute("Lives") or 1)
		refs.lassoText.Text = ("Lassos de capture : %d  (Q)"):format(player:GetAttribute("Lasso") or 0)
		local zoneIdx = player:GetAttribute("ZoneIdx") or 1
		refs.zone.Text = ("ZONE %d · %s"):format(zoneIdx, Config.Zones[zoneIdx].name)
	end

	-- animal monté
	if refs.rideBox.Visible then
		local name = player:GetAttribute("RideName") or ""
		local hearted = player:GetAttribute("RideHeart") == true
		local boss = player:GetAttribute("RideBoss") == true
		refs.rideName.Text = boss and ("BOSS · " .. name) or name
		refs.tameBar.Visible = hearted
		if hearted then
			local progress = player:GetAttribute("TameProgress") or 0
			UI.tween(refs.tameFill, 0.1, { Size = UDim2.new(progress, 0, 1, 0) })
			refs.tameText.Text = player:GetAttribute("CanCollect") and "RÉCUPÈRE-LE !" or "CONFIANCE"
		else
			refs.rideName.Text = refs.rideName.Text .. " (pas de cœur)"
		end
	end

	-- bouton d'action contextuel
	if refs.action.Visible then
		if status == "Riding" then
			refs.action.Text = "SAUTER"
			refs.action.BackgroundColor3 = UI.Colors.Accent
		elseif status == "Air" or status == "Down" then
			refs.action.Text = "LASSO DE SAUT"
			refs.action.BackgroundColor3 = CreatureFx.hasTarget() and UI.Colors.Accent or UI.Colors.Info
		else
			refs.action.Text = "..."
			refs.action.BackgroundColor3 = UI.Colors.Muted
		end
	end

	-- récupérer / lasso de capture
	local canCollect = player:GetAttribute("CanCollect") == true and status == "Riding"
	refs.collect.Visible = canCollect
	if canCollect then
		refs.collectScale.Scale = 1 + math.sin(os.clock() * 9) * 0.07
	end
	if refs.lasso.Visible then
		local charges = player:GetAttribute("Lasso") or 0
		local aimed = CreatureFx.lassoTarget() ~= nil
		refs.lasso.Text = ("LASSO\nx%d"):format(charges)
		refs.lasso.BackgroundColor3 = (aimed and charges > 0) and PINK or UI.Colors.PanelLight
	end

	-- sol mortel : bordure rouge quand on est bas en l'air
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local low = hrp ~= nil and (status == "Air") and hrp.Position.Y < 11 and hrp.Position.Y < 150
	refs.danger.Visible = low
	if low then
		refs.dangerStroke.Transparency = 0.45 + 0.2 * math.sin(os.clock() * 14)
		if os.clock() - lastWarnTick > 0.35 then
			lastWarnTick = os.clock()
			Sfx.play("tick")
		end
	end

	-- continuer après une mort
	local reviveLeft = player:GetAttribute("ReviveLeft") or 0
	refs.revive.Visible = status == "Dead" and reviveLeft > 0
	if refs.revive.Visible then
		refs.reviveText.Text = ("Continuer avec une vie de plus ? (%d s)"):format(reviveLeft)
	end
end

-- ---------------------------------------------------------------------------
-- Messages et résultats
-- ---------------------------------------------------------------------------

function HUD.feedback(payload)
	if type(payload) ~= "table" then
		return
	end
	local style = KIND_STYLE[payload.kind] or KIND_STYLE.hook
	feedbackToken = feedbackToken + 1
	local token = feedbackToken

	refs.toastTitle.Text = tostring(payload.title or "")
	refs.toastTitle.TextColor3 = style.color
	refs.toastSub.Text = tostring(payload.sub or "")
	refs.toast.Position = UDim2.new(0.5, 0, 0.3, 14)
	refs.toast.Visible = true
	UI.tween(refs.toast, 0.18, { Position = UDim2.new(0.5, 0, 0.3, 0) }, Enum.EasingStyle.Back)

	if style.sound then
		Sfx.play(style.sound)
	end
	if style.shake then
		CameraRig.shake(style.shake, 0.4)
	end

	task.delay(payload.kind == "tame" and 2.6 or 1.8, function()
		if token == feedbackToken then
			refs.toast.Visible = false
		end
	end)
end

function HUD.showResults(payload)
	if type(payload) ~= "table" or type(payload.list) ~= "table" then
		return
	end
	for _, child in ipairs(refs.resultsList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local myRank = nil
	local mine = nil
	for index, entry in ipairs(payload.list) do
		local you = entry.id == player.UserId
		if you then
			myRank = entry.rank
			mine = entry
		end
		local row = UI.frame(refs.resultsList, {
			Size = UDim2.new(1, -8, 0, 46),
			BackgroundColor3 = you and UI.Colors.PanelLight or UI.Colors.Panel,
			LayoutOrder = index,
			ZIndex = 21,
		})
		UI.corner(row, 10)
		if you then
			UI.stroke(row, UI.Colors.Accent, 2)
		end
		UI.text(row, {
			Size = UDim2.new(0, 44, 1, 0),
			Text = "#" .. entry.rank,
			maxSize = 24,
			TextColor3 = entry.rank == 1 and UI.Colors.Accent or UI.Colors.Text,
			ZIndex = 22,
		})
		UI.text(row, {
			Size = UDim2.new(0.36, 0, 1, -8),
			Position = UDim2.new(0, 48, 0, 4),
			Text = entry.n,
			maxSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 22,
		})
		UI.text(row, {
			Size = UDim2.new(0.24, 0, 1, -8),
			Position = UDim2.new(0.42, 0, 0, 4),
			Text = Util.formatNumber(entry.score) .. " pts",
			maxSize = 18,
			TextColor3 = UI.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 22,
		})
		UI.text(row, {
			Size = UDim2.new(0.3, -8, 1, -8),
			Position = UDim2.new(0.68, 0, 0, 4),
			Text = ("+%s or  ·  %d animaux"):format(Util.formatNumber(entry.gold), entry.captures),
			maxSize = 16,
			TextColor3 = UI.Colors.Good,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 22,
		})
	end

	if mine and #mine.names > 0 then
		refs.resultsCaptures.Text = ("Nouveaux pensionnaires : %s. Os gagnés : %d."):format(
			table.concat(mine.names, ", "),
			mine.bones
		)
	else
		refs.resultsCaptures.Text = "Aucun animal récupéré cette fois. Cherche les cœurs roses !"
	end

	refs.results.Visible = true
	Sfx.play(myRank == 1 and "win" or "coin")

	resultsToken = resultsToken + 1
	local token = resultsToken
	task.delay(Config.Round.Results + 1, function()
		if token == resultsToken then
			refs.results.Visible = false
		end
	end)
end

function HUD.init()
	local gui = UI.make("ScreenGui", {
		Name = "HerdHopperHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	build(gui)

	ClientState.connect("Scores", updateScores)
	updateScores()

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator >= 0.1 then
			accumulator = 0
			update()
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Intro</string><ProtectedString name="Source"><![CDATA[-- Animation d'introduction : survol du zoo avec le titre, puis la caméra revient derrière le joueur.
-- Jouée une fois par session, dès que le profil est chargé. Un appui n'importe où la passe.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local CameraRig = require(script.Parent.CameraRig)
local Sfx = require(script.Parent.Sfx)

local Intro = {}

local player = Players.LocalPlayer
local played = false

local DURATION = 8

local function plotCenter()
	local center = player:GetAttribute("PlotCenter")
	if typeof(center) == "Vector3" then
		return center
	end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or Vector3.new(0, 330, 0)
end

local function play()
	if played or ClientState.Status ~= "Lobby" then
		return
	end
	played = true

	local center = plotCenter()
	local gui = UI.make("ScreenGui", {
		Name = "HerdHopperIntro",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
	}, player:WaitForChild("PlayerGui"))

	local bars = {}
	for _, top in ipairs({ true, false }) do
		bars[#bars + 1] = UI.frame(gui, {
			AnchorPoint = Vector2.new(0, top and 0 or 1),
			Position = UDim2.new(0, 0, top and 0 or 1, 0),
			Size = UDim2.new(1, 0, 0.12, 0),
			BackgroundColor3 = Color3.fromRGB(10, 12, 20),
		})
	end

	local title = UI.text(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.4, 0),
		Size = UDim2.new(0.8, 0, 0.18, 0),
		Text = "SAUTE-ZOO",
		maxSize = 110,
		TextColor3 = UI.Colors.Accent,
		TextTransparency = 1,
	})
	local lines = {
		"Ta tante t'a laissé un zoo. Il est vide.",
		"Pars en expédition : saute d'animal en animal.",
		"Un cœur rose ? Récupère-le : il rejoint ton zoo !",
	}
	local sub = UI.text(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.55, 0),
		Size = UDim2.new(0.8, 0, 0.07, 0),
		Text = lines[1],
		maxSize = 34,
		Font = UI.FontBody,
		TextTransparency = 1,
	})
	local hint = UI.text(gui, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.97, 0),
		Size = UDim2.new(0.5, 0, 0.04, 0),
		Text = "Touche l'écran pour passer",
		maxSize = 20,
		Font = UI.FontBody,
		TextColor3 = UI.Colors.Muted,
	})

	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		CameraRig.stopCinematic()
		gui:Destroy()
	end

	CameraRig.cinematic(function(t)
		-- survol circulaire au-dessus du zoo, qui descend lentement
		local angle = t * 0.32 + 0.6
		local radius = 95 - t * 5
		local height = 70 - t * 4.5
		local eye = center + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
		return CFrame.lookAt(eye, center + Vector3.new(0, 4, 0))
	end, DURATION, finish)

	-- titre et phrases en fondu
	task.spawn(function()
		UI.tween(title, 1.2, { TextTransparency = 0 })
		Sfx.play("go")
		task.wait(1.6)
		for index, line in ipairs(lines) do
			if finished then
				return
			end
			sub.Text = line
			UI.tween(sub, 0.5, { TextTransparency = 0 })
			task.wait(1.8)
			UI.tween(sub, 0.4, { TextTransparency = 1 })
			task.wait(0.45)
			if index == #lines then
				break
			end
		end
	end)

	local connection
	connection = UserInputService.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Keyboard
			or input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			connection:Disconnect()
			finish()
		end
	end)
	task.delay(DURATION + 0.5, function()
		if connection.Connected then
			connection:Disconnect()
		end
		finish()
	end)
	hint.Visible = true
	bars[1].Visible = true
end

function Intro.init()
	local function try()
		if ClientState.Data and ClientState.Data.loaded and player.Character and player:GetAttribute("PlotCenter") then
			task.delay(1.2, play)
		end
	end
	ClientState.connect("Data", try)
	player:GetAttributeChangedSignal("PlotCenter"):Connect(try)
	try()
end

return Intro
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[-- Menus du parc : Expédition (zone + départ), Zoo (caisse, animaux, améliorations), Boutique (équipement,
-- chapeaux, cordes), Quêtes & histoire, Boutique Robux. Le client ne fait que demander : le serveur valide tout.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Species = require(Shared.Species)
local Util = require(Shared.Util)
local Zoo = require(Shared.Zoo)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)

local Menu = {}

local player = Players.LocalPlayer
local refs = {}
local openName = nil
local shopTab = "upgrade"
local lastMessage = ""
local readyState = false
local PINK = Color3.fromRGB(255, 96, 160)

local function clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function setMessage(text, good)
	lastMessage = text
	if refs.message then
		refs.message.Text = text
		refs.message.TextColor3 = good and UI.Colors.Good or UI.Colors.Bad
	end
end

local function invoke(remote, ...)
	local args = table.pack(...)
	task.spawn(function()
		local ok, result = pcall(function()
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end)
		if ok and type(result) == "table" then
			setMessage(result.msg or "", result.ok)
			Sfx.play(result.ok and "coin" or "down")
		else
			setMessage("Erreur de communication avec le serveur.", false)
		end
	end)
end

local function loading(content)
	UI.text(content, { Size = UDim2.new(1, 0, 0, 40), Text = "Chargement de ton profil...", maxSize = 24, ZIndex = 32 })
end

-- ---------------------------------------------------------------------------
-- Lignes génériques
-- ---------------------------------------------------------------------------

local function listFrame(parent, position, size)
	local scroll = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 31,
	}, parent)
	UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	return scroll
end

local function row(parent, order, title, desc, buttonText, buttonColor, onClick, swatch, height)
	local frame = UI.frame(parent, {
		Size = UDim2.new(1, -8, 0, height or 62),
		BackgroundColor3 = UI.Colors.PanelLight,
		LayoutOrder = order,
		ZIndex = 32,
	})
	UI.corner(frame, 12)
	local left = 10
	if swatch then
		local dot = UI.frame(frame, {
			Size = UDim2.new(0, 30, 0, 30),
			Position = UDim2.new(0, 10, 0.5, -15),
			BackgroundColor3 = swatch,
			ZIndex = 33,
		})
		UI.corner(dot, 15)
		UI.stroke(dot, UI.Colors.Dark, 2)
		left = 50
	end
	UI.text(frame, {
		Size = UDim2.new(1, -left - 150, 0, 26),
		Position = UDim2.new(0, left, 0, 6),
		Text = title,
		maxSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 33,
	})
	UI.text(frame, {
		Size = UDim2.new(1, -left - 150, 0, (height or 62) - 38),
		Position = UDim2.new(0, left, 0, 32),
		Text = desc,
		maxSize = 15,
		Font = UI.FontBody,
		TextColor3 = UI.Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		outline = false,
		ZIndex = 33,
	})
	local button = UI.button(frame, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 132, 0, 42),
		Text = buttonText,
		BackgroundColor3 = buttonColor,
		maxSize = 18,
		ZIndex = 33,
	})
	if onClick then
		button.Activated:Connect(onClick)
	end
	return frame, button
end

local function animalLabel(key)
	local def, variant = Zoo.parseKey(key)
	if not def then
		return key
	end
	if def.boss then
		return def.name
	end
	return variant == 1 and def.name or (def.name .. " " .. Config.Variants[variant].name)
end

-- ---------------------------------------------------------------------------
-- Expédition
-- ---------------------------------------------------------------------------

local function renderExpedition(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		loading(content)
		return
	end

	local lives = Config.Run.BaseLives + ((data.passes.life and Config.Monetization.LifePassBonus) or 0) + data.revives
	local lasso = Config.Run.BaseLasso
		+ data.zooUp.lasso
		+ ((data.passes.lasso and Config.Monetization.LassoPassBonus) or 0)
	UI.text(content, {
		Size = UDim2.new(1, 0, 0, 40),
		Text = ("Tu pars avec %d vie(s) et %d lasso(s) de capture. Le sol est mortel : saute d'animal en animal !"):format(
			lives,
			lasso
		),
		maxSize = 17,
		Font = UI.FontBody,
		ZIndex = 32,
	})

	local list = listFrame(content, UDim2.new(0, 0, 0, 44), UDim2.new(1, 0, 1, -44 - 70))
	for index, zone in ipairs(Config.Zones) do
		local unlocked = data.zones[zone.key]
		local selected = data.zone == zone.key
		local boss = Species.ById[zone.boss]
		local desc = ("Danger : %s · boss : %s"):format(zone.hazard.name, boss and boss.name or "?")
		if not unlocked then
			desc = ("Verrouillée : %d animaux différents requis (tu en as %d)."):format(zone.unlock, data.zoo.owned)
		end
		local text, color, handler
		if not unlocked then
			text, color = "VERROUILLÉE", UI.Colors.Muted
		elseif selected then
			text, color = "CHOISIE", UI.Colors.Good
		else
			text, color = "CHOISIR", UI.Colors.Info
			handler = function()
				invoke(Remotes.ZooAction, "zone", zone.key)
			end
		end
		row(list, index, ("ZONE %d · %s"):format(index, zone.name), desc, text, color, handler, zone.hazard.color)
	end

	local readyCount = workspace:GetAttribute("ReadyCount") or 0
	local go = UI.button(content, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(0.8, 0, 0, 56),
		Text = readyState and ("ANNULER · %d prêt(s)"):format(readyCount) or "PARTIR EN EXPÉDITION",
		BackgroundColor3 = readyState and UI.Colors.Warn or UI.Colors.Good,
		maxSize = 26,
		ZIndex = 33,
	})
	go.Activated:Connect(function()
		readyState = not readyState
		Remotes.Ready:FireServer(data.zone, readyState)
		Sfx.play(readyState and "go" or "click")
		if openName == "expedition" then
			renderExpedition(content)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- Zoo
-- ---------------------------------------------------------------------------

local function pendingEstimate(data)
	local zoo = data.zoo
	local elapsed = math.max(0, os.time() - zoo.serverTime)
	local estimate = zoo.pending + zoo.rate / 60 * elapsed
	local cap = math.max(zoo.pending, zoo.rate * zoo.capMinutes)
	return math.floor(math.min(estimate, cap))
end

local function renderZoo(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		loading(content)
		return
	end
	local zoo = data.zoo

	local cash =
		UI.frame(content, { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = UI.Colors.PanelLight, ZIndex = 32 })
	UI.corner(cash, 12)
	refs.cashLabel = UI.text(cash, {
		Size = UDim2.new(1, -170, 0, 30),
		Position = UDim2.new(0, 12, 0, 6),
		Text = "",
		maxSize = 26,
		TextColor3 = UI.Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 33,
	})
	refs.cashLabel.Text = ("Caisse : %s or"):format(Util.formatNumber(pendingEstimate(data)))
	local boost = zoo.boostLeft > 0 and (" · BOOST x2 (%d min)"):format(math.ceil(zoo.boostLeft / 60)) or ""
	UI.text(cash, {
		Size = UDim2.new(1, -170, 0, 26),
		Position = UDim2.new(0, 12, 0, 38),
		Text = ("%d animaux · %d enclos · %s or/min%s"):format(
			zoo.owned,
			zoo.slots,
			Util.formatNumber(zoo.rate),
			boost
		),
		maxSize = 15,
		Font = UI.FontBody,
		TextColor3 = UI.Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		outline = false,
		ZIndex = 33,
	})
	local collect = UI.button(cash, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 140, 0, 46),
		Text = "COLLECTER",
		BackgroundColor3 = UI.Colors.Good,
		maxSize = 20,
		ZIndex = 33,
	})
	collect.Activated:Connect(function()
		invoke(Remotes.ZooAction, "collect")
	end)

	local list = listFrame(content, UDim2.new(0, 0, 0, 78), UDim2.new(1, 0, 1, -78 - 26))
	refs.message = UI.text(content, {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -24),
		Text = lastMessage,
		maxSize = 18,
		Font = UI.FontBody,
		ZIndex = 32,
	})
	local order = 0
	local function header(text)
		order = order + 1
		UI.text(list, {
			Size = UDim2.new(1, -8, 0, 28),
			Text = text,
			maxSize = 20,
			TextColor3 = UI.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
			ZIndex = 32,
		})
	end

	header("AMÉLIORATIONS DU ZOO (or)")
	for _, def in ipairs(Config.ZooUpgrades) do
		order = order + 1
		local level = data.zooUp[def.id] or 0
		local maxed = level >= def.max
		local price = def.costs[level + 1]
		row(
			list,
			order,
			("%s (niv. %d/%d)"):format(def.name, level, def.max),
			def.desc,
			maxed and "MAX" or (Util.formatNumber(price) .. " or"),
			maxed and UI.Colors.Muted or (data.coins >= price and UI.Colors.Good or UI.Colors.Warn),
			(not maxed) and function()
				invoke(Remotes.ZooAction, "zoo", def.id)
			end or nil
		)
	end

	header("TES ANIMAUX (os : " .. data.bones .. ")")
	local owned = {}
	for key, entry in pairs(data.animals) do
		table.insert(owned, { key = key, entry = entry })
	end
	table.sort(owned, function(a, b)
		if a.entry.income ~= b.entry.income then
			return a.entry.income > b.entry.income
		end
		return a.key < b.key
	end)
	if #owned == 0 then
		order = order + 1
		UI.text(list, {
			Size = UDim2.new(1, -8, 0, 40),
			Text = "Ton zoo est vide. Pars en expédition et récupère un animal à cœur rose !",
			maxSize = 16,
			Font = UI.FontBody,
			LayoutOrder = order,
			ZIndex = 32,
		})
	end
	for _, item in ipairs(owned) do
		order = order + 1
		local e = item.entry
		local maxed = e.cost == nil
		row(
			list,
			order,
			("%s · niv. %d"):format(animalLabel(item.key), e.level),
			("Rapporte %s or/min · %d exemplaire(s)"):format(Util.formatNumber(e.income), e.copies),
			maxed and "MAX" or (e.cost .. " os"),
			maxed and UI.Colors.Muted or (data.bones >= e.cost and UI.Colors.Good or UI.Colors.Warn),
			(not maxed) and function()
				invoke(Remotes.ZooAction, "animal", item.key)
			end or nil
		)
	end
end

-- ---------------------------------------------------------------------------
-- Boutique (équipement, chapeaux, cordes)
-- ---------------------------------------------------------------------------

local function renderShop(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		loading(content)
		return
	end

	local tabs = {
		{ id = "upgrade", label = "ÉQUIPEMENT" },
		{ id = "hat", label = "CHAPEAUX" },
		{ id = "rope", label = "CORDES" },
	}
	for index, tab in ipairs(tabs) do
		local selected = shopTab == tab.id
		local b = UI.button(content, {
			Position = UDim2.new((index - 1) / 3, 2, 0, 0),
			Size = UDim2.new(1 / 3, -4, 0, 40),
			Text = tab.label,
			BackgroundColor3 = selected and UI.Colors.Accent or UI.Colors.PanelLight,
			TextColor3 = selected and UI.Colors.Dark or UI.Colors.Text,
			maxSize = 20,
			ZIndex = 32,
		})
		b.Activated:Connect(function()
			shopTab = tab.id
			Sfx.play("click")
			renderShop(content)
		end)
	end

	local list = listFrame(content, UDim2.new(0, 0, 0, 48), UDim2.new(1, 0, 1, -48 - 26))
	refs.message = UI.text(content, {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -24),
		Text = lastMessage,
		maxSize = 18,
		Font = UI.FontBody,
		ZIndex = 32,
	})

	if shopTab == "upgrade" then
		for index, def in ipairs(Config.Upgrades) do
			local level = data.upgrades[def.id] or 0
			local maxed = level >= def.max
			local price = def.costs[level + 1]
			row(
				list,
				index,
				("%s  (niv. %d/%d)"):format(def.name, level, def.max),
				def.desc,
				maxed and "MAX" or (Util.formatNumber(price) .. " or"),
				maxed and UI.Colors.Muted or (data.coins >= price and UI.Colors.Good or UI.Colors.Warn),
				(not maxed) and function()
					invoke(Remotes.Buy, "upgrade", def.id)
				end or nil
			)
		end
	else
		local isHat = shopTab == "hat"
		local items = isHat and Config.Hats or Config.Ropes
		local owned = isHat and data.owned.hats or data.owned.ropes
		local equippedId = isHat and data.equipped.hat or data.equipped.rope
		for index, def in ipairs(items) do
			local text, color, handler
			if equippedId == def.id then
				text, color = "ÉQUIPÉ", UI.Colors.Muted
			elseif owned[def.id] then
				text, color = "ÉQUIPER", UI.Colors.Info
				handler = function()
					invoke(Remotes.Equip, isHat and "hat" or "rope", def.id)
				end
			elseif def.pass then
				text, color = "ZOO PREMIUM", UI.Colors.Muted
			else
				text = Util.formatNumber(def.price) .. " or"
				color = data.coins >= def.price and UI.Colors.Good or UI.Colors.Warn
				handler = function()
					invoke(Remotes.Buy, isHat and "hat" or "rope", def.id)
				end
			end
			row(
				list,
				index,
				def.name,
				isHat and "Un look unique pour ton gardien de zoo." or "Change la couleur de ton lasso.",
				text,
				color,
				handler,
				(not isHat) and def.color or nil
			)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Quêtes et histoire
-- ---------------------------------------------------------------------------

local function renderQuests(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		loading(content)
		return
	end

	local list = listFrame(content, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, -26))
	refs.message = UI.text(content, {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -24),
		Text = lastMessage,
		maxSize = 18,
		Font = UI.FontBody,
		ZIndex = 32,
	})

	local order = 0
	local story = data.story
	if story then
		order = order + 1
		local card = UI.frame(list, {
			Size = UDim2.new(1, -8, 0, 122),
			BackgroundColor3 = UI.Colors.PanelLight,
			LayoutOrder = order,
			ZIndex = 32,
		})
		UI.corner(card, 12)
		UI.stroke(card, PINK, 2)
		UI.text(card, {
			Size = UDim2.new(1, -170, 0, 26),
			Position = UDim2.new(0, 12, 0, 6),
			Text = ("HISTOIRE %d/%d · %s"):format(story.index, story.total, story.title),
			maxSize = 20,
			TextColor3 = PINK,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 33,
		})
		UI.text(card, {
			Size = UDim2.new(1, -170, 0, 56),
			Position = UDim2.new(0, 12, 0, 34),
			Text = story.text,
			maxSize = 15,
			Font = UI.FontBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			outline = false,
			ZIndex = 33,
		})
		UI.text(card, {
			Size = UDim2.new(1, -170, 0, 22),
			Position = UDim2.new(0, 12, 1, -28),
			Text = ("Objectif : %d/%d · récompense : %d or, %d os"):format(
				story.progress,
				story.target,
				story.gold,
				story.bones
			),
			maxSize = 14,
			Font = UI.FontBody,
			TextColor3 = UI.Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			outline = false,
			ZIndex = 33,
		})
		local claim = UI.button(card, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 140, 0, 46),
			Text = story.ready and "RÉCUPÉRER" or "EN COURS",
			BackgroundColor3 = story.ready and UI.Colors.Good or UI.Colors.Panel,
			maxSize = 18,
			ZIndex = 33,
		})
		if story.ready then
			claim.Activated:Connect(function()
				invoke(Remotes.ZooAction, "story")
			end)
		end
	else
		order = order + 1
		UI.text(list, {
			Size = UDim2.new(1, -8, 0, 40),
			Text = "Histoire terminée : tu as le plus beau zoo du monde !",
			maxSize = 18,
			TextColor3 = PINK,
			LayoutOrder = order,
			ZIndex = 32,
		})
	end

	local riddle = data.riddle
	if riddle then
		order = order + 1
		local text, color, handler
		if riddle.claimed then
			text, color = "RÉSOLUE", UI.Colors.Muted
		elseif riddle.solved then
			text, color = "RÉCUPÉRER", UI.Colors.Good
			handler = function()
				invoke(Remotes.ZooAction, "riddle")
			end
		else
			text, color = "À RÉSOUDRE", UI.Colors.PanelLight
		end
		row(
			list,
			order,
			"Énigme du jour",
			riddle.text .. (" Récupère-le : +%d or, +%d os."):format(riddle.gold, riddle.bones),
			text,
			color,
			handler,
			nil,
			88
		)
	end

	local daily = data.daily
	order = order + 1
	row(
		list,
		order,
		"Cadeau du jour",
		daily.claimable and ("+%d or · série actuelle : %d jour(s)"):format(daily.reward, daily.streak)
			or "Déjà récupéré. Reviens demain pour prolonger ta série !",
		daily.claimable and "RÉCUPÉRER" or "REVIENS DEMAIN",
		daily.claimable and UI.Colors.Good or UI.Colors.Muted,
		daily.claimable and function()
			invoke(Remotes.ClaimDaily)
		end or nil
	)

	for index, quest in ipairs(data.quests) do
		order = order + 1
		local done = quest.progress >= quest.target
		local text, color, handler
		if quest.claimed then
			text, color = "FAIT", UI.Colors.Muted
		elseif done then
			text, color = ("+%d or"):format(quest.reward), UI.Colors.Good
			handler = function()
				invoke(Remotes.ClaimQuest, index)
			end
		else
			text, color = ("%d/%d"):format(quest.progress, quest.target), UI.Colors.PanelLight
		end
		row(list, order, quest.label, ("Récompense : %d or"):format(quest.reward), text, color, handler)
	end

	order = order + 1
	local stats = UI.frame(
		list,
		{ Size = UDim2.new(1, -8, 0, 92), BackgroundColor3 = UI.Colors.Panel, LayoutOrder = order, ZIndex = 32 }
	)
	UI.corner(stats, 12)
	UI.stroke(stats, UI.Colors.PanelLight, 2)
	local lines = {
		("Meilleur score : %s · Victoires : %d · Expéditions : %d"):format(
			Util.formatNumber(data.bestScore),
			data.wins,
			data.rounds
		),
		("Animaux récupérés : %d · Animaux différents : %d · Distance : %s m"):format(
			data.captures,
			data.zoo.owned,
			Util.formatNumber(data.distance)
		),
	}
	if data.persistent == false then
		table.insert(lines, "Sauvegarde indisponible : ta progression ne sera pas enregistrée.")
	end
	UI.text(stats, {
		Size = UDim2.new(1, -16, 1, -12),
		Position = UDim2.new(0, 8, 0, 6),
		Text = table.concat(lines, "\n"),
		maxSize = 17,
		Font = UI.FontBody,
		outline = false,
		ZIndex = 33,
	})
end

-- ---------------------------------------------------------------------------
-- Boutique Robux
-- ---------------------------------------------------------------------------

local PRODUCT_DESC = {
	gold = function(p)
		return ("+%s or, utilisables partout"):format(Util.formatNumber(p.amount))
	end,
	bones = function(p)
		return ("+%d os pour améliorer tes animaux"):format(p.amount)
	end,
	boost = function(p)
		return ("Revenus du zoo x2 pendant %d minutes"):format(p.amount)
	end,
	revive = function()
		return "Une vie de plus en pleine expédition (ou gardée pour la prochaine)"
	end,
}

local function renderRobux(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		loading(content)
		return
	end
	local list = listFrame(content, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0))
	local store = data.store or { passes = {}, products = {} }
	local order = 0

	local function header(text)
		order = order + 1
		UI.text(list, {
			Size = UDim2.new(1, -8, 0, 30),
			Text = text,
			maxSize = 22,
			TextColor3 = UI.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
			ZIndex = 32,
		})
	end
	local function priceText(entry)
		if not entry.available then
			return "BIENTÔT"
		end
		return entry.price and ("R$ " .. entry.price) or "ACHETER"
	end

	UI.text(list, {
		Size = UDim2.new(1, -8, 0, 22),
		Text = "La partie de base reste gratuite : ces achats sont facultatifs.",
		maxSize = 15,
		Font = UI.FontBody,
		TextColor3 = UI.Colors.Muted,
		LayoutOrder = 0,
		ZIndex = 32,
	})
	header("PASS PERMANENTS")
	for _, entry in ipairs(store.passes) do
		order = order + 1
		local owned = data.passes and data.passes[entry.key]
		local handler = nil
		if entry.available and not owned then
			handler = function()
				Sfx.play("click")
				Remotes.Prompt:FireServer("pass", entry.key)
			end
		end
		row(
			list,
			order,
			entry.name,
			entry.desc,
			owned and "POSSÉDÉ" or priceText(entry),
			owned and UI.Colors.Muted or (entry.available and UI.Colors.Good or UI.Colors.PanelLight),
			handler
		)
	end

	header("OR, OS ET AUTRES")
	for _, entry in ipairs(store.products) do
		order = order + 1
		local handler = nil
		if entry.available then
			handler = function()
				Sfx.play("click")
				Remotes.Prompt:FireServer("product", entry.key)
			end
		end
		local describe = PRODUCT_DESC[entry.kind]
		row(
			list,
			order,
			entry.name,
			describe and describe(entry) or "",
			priceText(entry),
			entry.available and UI.Colors.Good or UI.Colors.PanelLight,
			handler
		)
	end
end

-- ---------------------------------------------------------------------------
-- Panneau et boutons
-- ---------------------------------------------------------------------------

local RENDERERS = {
	expedition = { title = "EXPÉDITION", fn = renderExpedition },
	zoo = { title = "TON ZOO", fn = renderZoo },
	shop = { title = "BOUTIQUE", fn = renderShop },
	quests = { title = "HISTOIRE & QUÊTES", fn = renderQuests },
	robux = { title = "BOUTIQUE ROBUX", fn = renderRobux },
}

local function render()
	if openName and RENDERERS[openName] then
		refs.title.Text = RENDERERS[openName].title
		RENDERERS[openName].fn(refs.content)
	end
end

local function open(name)
	openName = name
	refs.panel.Visible = true
	Sfx.play("click")
	render()
end

local function close()
	openName = nil
	refs.panel.Visible = false
	Sfx.play("click")
end

local function questBadge()
	local data = ClientState.Data
	if not data or not data.loaded then
		return false
	end
	if
		data.daily.claimable
		or (data.story and data.story.ready)
		or (data.riddle and data.riddle.solved and not data.riddle.claimed)
	then
		return true
	end
	for _, quest in ipairs(data.quests) do
		if not quest.claimed and quest.progress >= quest.target then
			return true
		end
	end
	return false
end

local function refreshChrome()
	local data = ClientState.Data
	if data and data.loaded then
		refs.coins.Text = ("Or : %s · Os : %d"):format(Util.formatNumber(data.coins), data.bones)
	else
		refs.coins.Text = "Chargement..."
	end
	refs.badge.Visible = questBadge()
end

local function refreshVisibility()
	local visible = not ClientState.inRun()
	refs.buttons.Visible = visible
	refs.coinsBox.Visible = visible
	if not visible and openName then
		close()
	end
end

function Menu.init()
	local gui = UI.make("ScreenGui", {
		Name = "HerdHopperMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- colonne de boutons
	refs.buttons = UI.frame(gui, {
		Name = "Buttons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.new(0, 160, 0, 5 * 52),
		BackgroundTransparency = 1,
	})
	UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, refs.buttons)
	local defs = {
		{ id = "expedition", label = "EXPÉDITION", color = UI.Colors.Good },
		{ id = "zoo", label = "MON ZOO", color = PINK },
		{ id = "shop", label = "BOUTIQUE", color = UI.Colors.Accent },
		{ id = "quests", label = "HISTOIRE", color = UI.Colors.Info },
		{ id = "robux", label = "ROBUX", color = Color3.fromRGB(255, 120, 90) },
	}
	for index, def in ipairs(defs) do
		local b = UI.button(refs.buttons, {
			Size = UDim2.new(1, 0, 0, 46),
			Text = def.label,
			BackgroundColor3 = def.color,
			LayoutOrder = index,
			maxSize = 22,
		})
		b.Activated:Connect(function()
			if openName == def.id then
				close()
			else
				open(def.id)
			end
		end)
		if def.id == "quests" then
			refs.badge = UI.frame(b, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 4, 0, -4),
				Size = UDim2.new(0, 16, 0, 16),
				BackgroundColor3 = UI.Colors.Bad,
				Visible = false,
				ZIndex = 5,
			})
			UI.corner(refs.badge, 8)
			UI.stroke(refs.badge, UI.Colors.Dark, 2)
		end
	end

	-- or et os
	refs.coinsBox = UI.frame(gui, {
		Name = "Coins",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(0, 230, 0, 40),
		BackgroundTransparency = 0.15,
	})
	UI.corner(refs.coinsBox, 12)
	UI.stroke(refs.coinsBox, UI.Colors.Dark, 2)
	refs.coins = UI.text(refs.coinsBox, {
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.new(0, 6, 0, 4),
		Text = "Chargement...",
		maxSize = 20,
		TextColor3 = UI.Colors.Accent,
	})

	-- panneau modal
	refs.panel = UI.frame(gui, {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.8, 0, 0.84, 0),
		Visible = false,
		ZIndex = 30,
	})
	UI.make("UISizeConstraint", { MaxSize = Vector2.new(780, 540), MinSize = Vector2.new(320, 240) }, refs.panel)
	UI.corner(refs.panel, 18)
	UI.stroke(refs.panel, UI.Colors.Accent, 3)
	refs.title = UI.text(refs.panel, {
		Size = UDim2.new(1, -120, 0, 44),
		Position = UDim2.new(0, 16, 0, 8),
		Text = "",
		maxSize = 32,
		TextColor3 = UI.Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
	})
	local closeButton = UI.button(refs.panel, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 84, 0, 38),
		Text = "FERMER",
		BackgroundColor3 = UI.Colors.Bad,
		TextColor3 = UI.Colors.Text,
		maxSize = 18,
		ZIndex = 31,
	})
	closeButton.Activated:Connect(close)
	refs.content = UI.frame(refs.panel, {
		Position = UDim2.new(0, 14, 0, 58),
		Size = UDim2.new(1, -28, 1, -70),
		BackgroundTransparency = 1,
		ZIndex = 31,
	})

	ClientState.connect("Data", function()
		refreshChrome()
		if openName then
			render()
		end
	end)
	ClientState.connect("Status", refreshVisibility)

	-- le départ efface l'état « prêt » ; la caisse du zoo s'actualise chaque seconde
	workspace:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = workspace:GetAttribute("Phase")
		if phase == "Countdown" or phase == "Running" then
			readyState = false
		end
		if openName == "expedition" then
			render()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local data = ClientState.Data
			if openName == "zoo" and refs.cashLabel and refs.cashLabel.Parent and data and data.loaded then
				refs.cashLabel.Text = ("Caisse : %s or"):format(Util.formatNumber(pendingEstimate(data)))
			end
		end
	end)

	refreshChrome()
	refreshVisibility()
end

return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[-- Audio : effets sonores (fichiers fournis avec le client Roblox) et musique par lieu avec fondu enchaîné.
-- Les musiques se règlent dans Config.Audio.Music ; vides par défaut. Deux SoundGroups (Musique / Effets)
-- permettent le réglage du volume et le mode muet.

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sfx = {}

-- Fichiers du client Roblox. Si l'un manque, le son est simplement muet.
local SOUNDS = {
	launch = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.6, pitch = 1.2 },
	land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.5, pitch = 0.9 },
	hook = { id = "rbxasset://sounds/snap.mp3", volume = 0.7, pitch = 1.1 },
	tame = { id = "rbxasset://sounds/victory.wav", volume = 0.6, pitch = 1.3 },
	down = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.6, pitch = 1 },
	tick = { id = "rbxasset://sounds/button.wav", volume = 0.6, pitch = 1 },
	go = { id = "rbxasset://sounds/switch.wav", volume = 0.8, pitch = 0.9 },
	geyser = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.7, pitch = 1 },
	boom = { id = "rbxasset://sounds/impact_explosion_03.mp3", volume = 0.8, pitch = 1 },
	win = { id = "rbxasset://sounds/victory.wav", volume = 0.8, pitch = 1 },
	coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.2 },
	heart = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 1.7 },
	collect = { id = "rbxasset://sounds/victory.wav", volume = 0.7, pitch = 1.1 },
	lasso = { id = "rbxasset://sounds/snap.mp3", volume = 0.7, pitch = 0.8 },
	boss = { id = "rbxasset://sounds/impact_explosion_03.mp3", volume = 0.9, pitch = 0.6 },
	click = { id = "rbxasset://sounds/button.wav", volume = 0.4, pitch = 1.4 },
}

local MODES = { "all", "sfx", "mute" }
local MODE_LABELS = { all = "SON : TOUT", sfx = "SON : EFFETS", mute = "SON : MUET" }

local mode = "all"
local musicGroup, sfxGroup = nil, nil
local current = nil -- { key, sound }

local function applyVolumes()
	if not musicGroup then
		return
	end
	musicGroup.Volume = mode == "all" and Config.Audio.MusicVolume or 0
	sfxGroup.Volume = mode == "mute" and 0 or Config.Audio.SfxVolume
end

function Sfx.init()
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "HHMusic"
	musicGroup.Parent = SoundService
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "HHSfx"
	sfxGroup.Parent = SoundService
	applyVolumes()
end

function Sfx.play(name)
	local def = SOUNDS[name]
	if not def or mode == "mute" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.id
	sound.Volume = def.volume
	sound.PlaybackSpeed = def.pitch
	sound.SoundGroup = sfxGroup
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

-- Joue la musique d'un lieu (clé de Config.Audio.Music) avec un fondu enchaîné. Sans identifiant : silence.
function Sfx.setMusic(key)
	if current and current.key == key then
		return
	end
	local fade = Config.Audio.FadeSeconds
	if current then
		local old = current.sound
		TweenService:Create(old, TweenInfo.new(fade), { Volume = 0 }):Play()
		Debris:AddItem(old, fade + 0.2)
		current = nil
	end
	local id = Config.Audio.Music[key]
	if type(id) ~= "string" or id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. key
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.SoundGroup = musicGroup
	sound.Parent = SoundService
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(fade), { Volume = 1 }):Play()
	current = { key = key, sound = sound }
end

function Sfx.cycleMode()
	local index = table.find(MODES, mode) or 1
	mode = MODES[index % #MODES + 1]
	applyVolumes()
	return MODE_LABELS[mode]
end

function Sfx.modeLabel()
	return MODE_LABELS[mode]
end

return Sfx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Petite boîte à outils d'interface dans le style Roblox (coins arrondis, police Fredoka).

local TweenService = game:GetService("TweenService")

local UI = {}

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

UI.Colors = {
	Panel = C(30, 36, 56),
	PanelLight = C(46, 54, 84),
	Accent = C(255, 200, 70),
	Good = C(90, 200, 110),
	Bad = C(230, 80, 80),
	Warn = C(255, 150, 60),
	Info = C(110, 200, 255),
	Text = C(255, 255, 255),
	Muted = C(170, 182, 210),
	Dark = C(18, 22, 36),
}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamMedium

function UI.make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props or {}) do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(parent, radius)
	return UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

function UI.stroke(parent, color, thickness, transparency)
	return UI.make("UIStroke", {
		Color = color or UI.Colors.Dark,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function UI.frame(parent, props)
	local p = { BackgroundColor3 = UI.Colors.Panel, BorderSizePixel = 0 }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UI.make("Frame", p, parent)
end

-- Texte avec contour ; textSize = taille maximale (le texte se réduit pour tenir dans le cadre).
function UI.text(parent, props)
	local p = {
		BackgroundTransparency = 1,
		TextColor3 = UI.Colors.Text,
		Font = UI.Font,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
		BorderSizePixel = 0,
	}
	local maxSize = props.maxSize or 28
	local outline = props.outline
	for k, v in pairs(props) do
		if k ~= "maxSize" and k ~= "outline" then
			p[k] = v
		end
	end
	local label = UI.make("TextLabel", p, parent)
	UI.make("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8 }, label)
	if outline ~= false then
		UI.make("UIStroke", {
			Color = UI.Colors.Dark,
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}, label)
	end
	return label
end

function UI.button(parent, props)
	local p = {
		BackgroundColor3 = UI.Colors.Accent,
		TextColor3 = UI.Colors.Dark,
		Font = UI.Font,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
	}
	local maxSize = props.maxSize or 24
	for k, v in pairs(props) do
		if k ~= "maxSize" then
			p[k] = v
		end
	end
	local button = UI.make("TextButton", p, parent)
	UI.corner(button, 12)
	UI.stroke(button, UI.Colors.Dark, 2)
	UI.make("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8 }, button)

	-- survol : on éclaircit la couleur COURANTE (le code peut la changer) et on la restaure ensuite
	local resting = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		resting = button.BackgroundColor3
		TweenService:Create(button, TweenInfo.new(0.1), { BackgroundColor3 = resting:Lerp(Color3.new(1, 1, 1), 0.18) })
			:Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.1), { BackgroundColor3 = resting }):Play()
	end)
	return button
end

-- Cœur dessiné avec des cadres (aucune image, aucune police) : un losange et deux disques.
function UI.heart(parent, px, color)
	local root = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, px, 0, px) }, parent)
	UI.make("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.58, 0),
		Size = UDim2.new(0.52, 0, 0.52, 0),
		Rotation = 45,
	}, root)
	for _, x in ipairs({ 0.3, 0.7 }) do
		local lobe = UI.make("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0.36, 0),
			Size = UDim2.new(0.52, 0, 0.52, 0),
		}, root)
		UI.corner(lobe, px)
	end
	return root
end

function UI.tween(inst, seconds, props, style)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Visitors</string><ProtectedString name="Source"><![CDATA[-- Visiteurs du zoo : de petits personnages en blocs qui se promènent devant les enclos du joueur.
-- Purement visuels et locaux. Leur nombre grandit avec le zoo (attribut ZooVisitors, 2 à 30).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Visitors = {}

local player = Players.LocalPlayer
local crowd = {}
local folder = nil

local SHIRTS = {
	Color3.fromRGB(230, 90, 90),
	Color3.fromRGB(90, 160, 230),
	Color3.fromRGB(240, 200, 80),
	Color3.fromRGB(120, 200, 120),
	Color3.fromRGB(200, 120, 220),
	Color3.fromRGB(240, 150, 80),
}

local function makePart(parent, size, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function newVisitor(center, index)
	local model = Instance.new("Model")
	model.Name = "Visitor"
	local rng = Random.new(index * 97)
	local body = makePart(model, Vector3.new(1.6, 2.2, 1), SHIRTS[rng:NextInteger(1, #SHIRTS)])
	local head = makePart(model, Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(240, 200, 160))
	local legs = makePart(model, Vector3.new(1.4, 1.6, 0.9), Color3.fromRGB(60, 70, 100))
	model.Parent = folder
	local half = Config.Hub.PlotSize / 2 - 6
	local function pick()
		return center + Vector3.new(rng:NextNumber(-half, half), 0, rng:NextNumber(-half + 6, half))
	end
	local visitor = {
		model = model,
		body = body,
		head = head,
		legs = legs,
		pos = pick(),
		target = pick(),
		speed = rng:NextNumber(4, 7),
		phase = rng:NextNumber() * 6,
		pick = pick,
	}
	return visitor
end

local function setCount(n, center)
	while #crowd < n do
		table.insert(crowd, newVisitor(center, #crowd + 1))
	end
	while #crowd > n do
		local v = table.remove(crowd)
		v.model:Destroy()
	end
end

function Visitors.init()
	folder = Instance.new("Folder")
	folder.Name = "HerdHopperVisitors"
	folder.Parent = workspace

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < 0.05 then
			return
		end
		local step = accumulator
		accumulator = 0

		local center = player:GetAttribute("PlotCenter")
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		-- seulement quand le joueur est dans le parc (en hauteur)
		if typeof(center) ~= "Vector3" or not hrp or hrp.Position.Y < 150 then
			setCount(0, Vector3.zero)
			return
		end
		setCount(math.clamp(player:GetAttribute("ZooVisitors") or 2, 0, 30), center + Vector3.new(0, 0.1, 0))

		local t = os.clock()
		for _, v in ipairs(crowd) do
			local delta = v.target - v.pos
			if delta.Magnitude < 1.5 then
				v.target = v.pick()
			else
				v.pos = v.pos + delta.Unit * v.speed * step
			end
			local bob = math.abs(math.sin(t * 6 + v.phase)) * 0.25
			local facing = CFrame.lookAt(v.pos, v.pos + (delta.Magnitude > 0.1 and delta or Vector3.new(0, 0, 1)))
			v.legs.CFrame = facing * CFrame.new(0, 0.8 + bob, 0)
			v.body.CFrame = facing * CFrame.new(0, 2.7 + bob, 0)
			v.head.CFrame = facing * CFrame.new(0, 4.4 + bob, 0)
		end
	end)
end

return Visitors
]]></ProtectedString></Properties></Item></Item></Item></Item></Item>
