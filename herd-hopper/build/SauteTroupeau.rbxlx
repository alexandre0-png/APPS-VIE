}

-- Or gagné en fin d'expédition (le zoo en rapporte en plus, voir Config.Zoo).
Config.Rewards = {
	ScoreToCoins = 0.05,
	Place = { 80, 50, 30 },
	Participation = 15,
	CaptureGold = 20, -- × valeur × variante
	NewDiscovery = 40,
	SpeciesComplete = 250,
}

Config.Variants = {
