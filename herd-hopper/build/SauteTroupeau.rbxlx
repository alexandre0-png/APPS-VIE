<Item class="ReplicatedStorage" referent="RBX6"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX5"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Configuration centrale de Saute-Troupeau (Herd Hopper).
-- Toutes les valeurs d'équilibrage sont ici : on peut régler le jeu sans toucher aux systèmes.

local Config = {}

Config.Gravity = 90

-- Piste : axe +Z = sens de la course. Le sol est à Y = 0.
Config.Track = {
	HalfWidth = 62, -- limite latérale des bêtes (studs)
	WallX = 82, -- murs invisibles
	FinishZ = 3200, -- ligne d'arrivée
	FloorTop = 0,
	StartZ = 0,
}

Config.Lobby = {
	Center = Vector3.new(0, 320, -560),
	Size = Vector3.new(150, 6, 150),
}

Config.Round = {
	Intermission = 18,
	Countdown = 4,
	Duration = 120,
	Results = 11,
	MinPlayers = 1,
}

-- Mur de lave : avance de plus en plus vite et élimine les retardataires.
Config.Wall = {
	StartZ = -70,
	Speed0 = 12,
	Accel = 0.28,
	MaxSpeed = 46,
}

Config.Ride = {
	LaunchUp = 58, -- vitesse verticale du bond
	LaunchBoost = 18, -- vitesse avant ajoutée à celle de la bête
	AirLateral = 26, -- contrôle latéral en l'air
	AirMax = 2.4, -- durée max d'un vol avant chute forcée (s)
	SteerSpeed = 30, -- vitesse latérale d'une monture pilotée
	HookBaseRange = 58,
	HookRangePerLevel = 5,
	HookCooldown = 0.3,
	HookTolerance = 14, -- marge serveur pour la latence
	ComboWindowBase = 6,
	ComboWindowPerLevel = 0.6,
	ComboStep = 0.2,
	ComboMax = 10,
	DownTime = 1.8,
	BuckWarning = 1.2,
}

Config.Score = {
	RidePerSecond = 4,
	HookBonus = 15,
	LongHookDistance = 40,
	LongHookBonus = 25,
	DistanceFactor = 0.1,
	TameBase = 100,
	Finish = { 500, 300, 200 },
	FinishOther = 100,
}

Config.Tame = {
	PerLevel = 0.08, -- réduction du temps de dressage par niveau
	MinTime = 2.5,
}

Config.Rewards = {
	ScoreToCoins = 0.05,
	Place = { 80, 50, 30 },
	Participation = 15,
	TameCoins = 5,
	NewDiscovery = 40,
	SpeciesComplete = 250,
}

Config.Variants = {
	{ id = 1, name = "Normal", mult = 1, weight = 80 },
	{ id = 2, name = "Cristal", mult = 2, weight = 15 },
	{ id = 3, name = "Doré", mult = 4, weight = 5 },
}

-- Audio. Les musiques sont volontairement vides : aucun morceau libre de droits n'est fourni avec le jeu.
-- Colle ici des identifiants "rbxassetid://..." de morceaux dont tu as les droits (bibliothèque audio Roblox,
-- Creator Store ou fichiers à toi). Une chaîne vide = pas de musique pour ce lieu.
Config.Audio = {
	MusicVolume = 0.3,
	SfxVolume = 0.8,
	FadeSeconds = 2.5,
	Music = {
		lobby = "",
		savane = "",
		desert = "",
		forest = "",
		volcano = "",
		results = "",
	},
}

Config.Events = {
	FirstDelay = 14,
	MinGap = 11,
	MaxGap = 19,
	GeyserRadius = 15,
	MeteorRadius = 17,
	Telegraph = 2.0,
}

Config.Upgrades = {
	{
		id = "range",
		name = "Corde longue",
		desc = "Portée du lasso +5 m par niveau.",
		max = 5,
		costs = { 150, 300, 550, 900, 1400 },
	},
	{
		id = "taming",
		name = "Dresseur rapide",
		desc = "Temps de dressage -8 % par niveau.",
		max = 5,
		costs = { 150, 300, 550, 900, 1400 },
	},
	{
		id = "combo",
		name = "Souffle de combo",
		desc = "Fenêtre de combo +0,6 s par niveau.",
		max = 5,
		costs = { 200, 400, 700, 1100, 1600 },
	},
}

Config.Hats = {
	{ id = "none", name = "Aucun chapeau", price = 0 },
	{ id = "beanie", name = "Bonnet à pompon", price = 200 },
	{ id = "cowboy", name = "Chapeau de cow-boy", price = 250 },
	{ id = "viking", name = "Casque viking", price = 400 },
	{ id = "wizard", name = "Chapeau de sorcier", price = 500 },
	{ id = "dino", name = "Capuche de dino", price = 650 },
	{ id = "crown", name = "Couronne en or", price = 800 },
	{ id = "vip", name = "Cornes dorées VIP", price = 0, pass = "vip" },
}

-- Achats Robux. Mets ici les identifiants créés sur le Creator Dashboard (voir docs/PUBLICATION.md).
-- Tant qu'un id vaut 0, l'objet s'affiche « Bientôt » et ne peut pas être acheté.
Config.Monetization = {
	GamePasses = {
		{
			key = "double",
			id = 0,
			name = "Pièces x2",
			desc = "Double toutes les pièces gagnées en course, pour toujours.",
		},
		{ key = "rope", id = 0, name = "Corde longue +8 m", desc = "Portée du lasso +8 m en permanence." },
		{ key = "vip", id = 0, name = "VIP", desc = "Cornes dorées exclusives pour ton cavalier." },
	},
	Products = {
		{ key = "coins_s", id = 0, coins = 500, name = "Sac de 500 pièces" },
		{ key = "coins_m", id = 0, coins = 1500, name = "Coffre de 1 500 pièces" },
		{ key = "coins_l", id = 0, coins = 5000, name = "Trésor de 5 000 pièces" },
	},
	RopeBonus = 8,
}

Config.Ropes = {
	{ id = "classic", name = "Corde de chanvre", price = 0, color = Color3.fromRGB(210, 170, 100), neon = false },
	{ id = "fire", name = "Corde de feu", price = 300, color = Color3.fromRGB(255, 110, 30), neon = true },
	{ id = "ice", name = "Corde glacée", price = 300, color = Color3.fromRGB(120, 220, 255), neon = true },
	{ id = "toxic", name = "Corde toxique", price = 400, color = Color3.fromRGB(120, 255, 80), neon = true },
	{ id = "royal", name = "Corde royale", price = 600, color = Color3.fromRGB(180, 90, 255), neon = true },
	{ id = "gold", name = "Corde dorée", price = 900, color = Color3.fromRGB(255, 210, 60), neon = true },
}

-- Quêtes quotidiennes : 3 tirées chaque jour. mode "add" = cumul, "max" = meilleure valeur.
Config.QuestPool = {
	{ id = "tame", label = "Dompter %d créatures", target = 4, reward = 60, mode = "add" },
	{ id = "hooks", label = "Réussir %d lassos", target = 25, reward = 60, mode = "add" },
	{ id = "combo", label = "Atteindre un combo de %d", target = 6, reward = 80, mode = "max" },
	{ id = "distance", label = "Parcourir %d m en course", target = 1500, reward = 70, mode = "add" },
	{ id = "rounds", label = "Jouer %d manches", target = 3, reward = 50, mode = "add" },
	{ id = "score", label = "Marquer %d points en une manche", target = 900, reward = 90, mode = "max" },
	{ id = "rare", label = "Dompter %d bête Cristal ou Dorée", target = 1, reward = 100, mode = "add" },
}

Config.DailyReward = { Base = 50, PerStreak = 25, MaxStreak = 7 }

-- Biomes le long de la piste (utilisés par la carte, par l'ambiance côté client et par la boutique).
Config.Biomes = {
	{
		key = "savane",
		name = "SAVANE DORÉE",
		from = -5000,
		to = 900,
		ground = Color3.fromRGB(124, 168, 74),
		material = "Grass",
		cliff = Color3.fromRGB(158, 124, 88),
		cliffMaterial = "Rock",
		atmosphere = Color3.fromRGB(214, 226, 240),
		tint = Color3.fromRGB(255, 246, 228),
	},
	{
		key = "desert",
		name = "DÉSERT ROUGE",
		from = 900,
		to = 1700,
		ground = Color3.fromRGB(226, 182, 116),
		material = "Sand",
		cliff = Color3.fromRGB(196, 106, 66),
		cliffMaterial = "Sandstone",
		atmosphere = Color3.fromRGB(246, 214, 176),
		tint = Color3.fromRGB(255, 232, 205),
	},
	{
		key = "forest",
		name = "FORÊT GÉANTE",
		from = 1700,
		to = 2500,
		ground = Color3.fromRGB(70, 128, 66),
		material = "Grass",
		cliff = Color3.fromRGB(92, 100, 94),
		cliffMaterial = "Slate",
		atmosphere = Color3.fromRGB(176, 214, 196),
		tint = Color3.fromRGB(226, 255, 232),
	},
	{
		key = "volcano",
		name = "VOLCAN",
		from = 2500,
		to = 99999,
		ground = Color3.fromRGB(62, 54, 58),
		material = "Basalt",
		cliff = Color3.fromRGB(42, 36, 40),
		cliffMaterial = "Basalt",
		atmosphere = Color3.fromRGB(255, 168, 128),
		tint = Color3.fromRGB(255, 214, 190),
	},
}

function Config.biomeAt(z)
	for _, biome in ipairs(Config.Biomes) do
		if z < biome.to then
			return biome
		end
	end
	return Config.Biomes[#Config.Biomes]
end

function Config.findById(list, id)
	for _, item in ipairs(list) do
		if item.id == id then
			return item
		end
	end
	return nil
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Création / récupération des RemoteEvents et RemoteFunctions.
-- Le serveur crée tout au démarrage ; le client attend leur réplication.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Hook", -- C->S : id de la bête visée
	"Launch", -- C->S : quitter la monture
	"Steer", -- C->S : direction latérale [-1, 1]
	"Prompt", -- C->S : demande d'achat Robux (kind, key)
	"Data", -- S->C : profil du joueur
	"Status", -- S->C : état du joueur (Lobby, Riding, Air, Hooking, Down, Out, Finished)
	"Launched", -- S->C : vitesse initiale du bond
	"Feedback", -- S->C : messages / effets
	"Scores", -- S->C : classement en direct
	"Results", -- S->C : résultats de manche
}

local FUNCTIONS = {
	"Buy",
	"Equip",
	"ClaimDaily",
	"ClaimQuest",
}

local isServer = RunService:IsServer()
local folder

if isServer then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Remotes = {}

local function fetch(name, className)
	local remote = folder:FindFirstChild(name)
	if remote then
		return remote
	end
	if isServer then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name)
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = fetch(name, "RemoteEvent")
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = fetch(name, "RemoteFunction")
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Species</string><ProtectedString name="Source"><![CDATA[-- Les 7 espèces de bêtes. Chaque bête est construite en blocs Roblox (aucun asset externe).
-- Repère local : l'avant est -Z, le dessus est +Y. Les offsets "o" sont relatifs au centre du corps.
-- Palette : body / dark / light / accent / eye.

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function addEyes(parts, y, z, dx)
	table.insert(parts, { n = "EyeL", s = V(0.45, 0.55, 0.3), o = V(-dx, y, z), c = "eye" })
	table.insert(parts, { n = "EyeR", s = V(0.45, 0.55, 0.3), o = V(dx, y, z), c = "eye" })
end

-- Quatre pattes en trot diagonal.
local function quadLegs(size, hipY, hx, hz)
	return {
		{ n = "LegFL", s = size, hip = V(-hx, hipY, -hz), phase = 0, c = "dark" },
		{ n = "LegFR", s = size, hip = V(hx, hipY, -hz), phase = math.pi, c = "dark" },
		{ n = "LegBL", s = size, hip = V(-hx, hipY, hz), phase = math.pi, c = "dark" },
		{ n = "LegBR", s = size, hip = V(hx, hipY, hz), phase = 0, c = "dark" },
	}
end

local Species = {}

Species.List = {}

local function add(def)
	def.seat = V(0, def.body.s.Y / 2 + 2.1, def.seatZ or 0.4)
	table.insert(Species.List, def)
end

-- 1. Sanglier : petit, zigzag.
do
	local parts = {
		{ n = "Head", s = V(3.8, 3.4, 3.6), o = V(0, 0.3, -5.5), c = "dark" },
		{ n = "Snout", s = V(2.2, 1.6, 1.8), o = V(0, -0.4, -7.6), c = "accent" },
		{ n = "TuskL", s = V(0.4, 0.4, 1.4), o = V(-1.0, -1.1, -7.6), c = "light" },
		{ n = "TuskR", s = V(0.4, 0.4, 1.4), o = V(1.0, -1.1, -7.6), c = "light" },
		{ n = "EarL", s = V(0.8, 1.2, 0.5), o = V(-1.5, 2.3, -4.8), c = "dark" },
		{ n = "EarR", s = V(0.8, 1.2, 0.5), o = V(1.5, 2.3, -4.8), c = "dark" },
		{ n = "Mane", s = V(1.2, 0.8, 6), o = V(0, 2.3, 0), c = "dark" },
		{ n = "Tail", s = V(0.5, 0.5, 1.6), o = V(0, 1.2, 4.7), c = "dark" },
	}
	addEyes(parts, 0.9, -7.35, 1.1)
	add({
		id = "boar",
		name = "Sanglier",
		desc = "Petit et nerveux. Il zigzague sans cesse.",
		speed = 38,
		value = 1,
		weight = 26,
		tameTime = 5,
		buckAfter = 9,
		trait = "weave",
		weaveAmp = 14,
		weaveFreq = 0.9,
		rootY = 4.4,
		body = { s = V(5, 4, 8), c = "body" },
		palette = {
			body = C(139, 94, 60),
			dark = C(92, 60, 38),
			light = C(238, 226, 200),
			accent = C(255, 150, 170),
			eye = C(20, 20, 20),
		},
		parts = parts,
		legs = quadLegs(V(1.3, 2.4, 1.3), -2, 1.7, 2.8),
		wings = {},
	})
end

-- 2. Autruche des cimes : la plus rapide au sol.
do
	local parts = {
		{ n = "Neck", s = V(1.1, 4.5, 1.1), o = V(0, 3.9, -2.1), c = "light" },
		{ n = "Head", s = V(1.9, 1.7, 2.8), o = V(0, 6.6, -3.0), c = "body" },
		{ n = "Beak", s = V(0.9, 0.9, 2), o = V(0, 6.3, -5.0), c = "accent" },
		{ n = "Crest", s = V(0.5, 1.4, 1.2), o = V(0, 7.8, -2.6), c = "dark" },
		{ n = "TailA", s = V(2.4, 2.6, 1.6), o = V(0, 1.4, 3.8), c = "light" },
		{ n = "TailB", s = V(1.4, 2.0, 1.2), o = V(0, 2.8, 4.4), c = "dark" },
		{ n = "WingL", s = V(0.5, 2.4, 3.2), o = V(-1.9, 0.4, 0.3), c = "dark" },
		{ n = "WingR", s = V(0.5, 2.4, 3.2), o = V(1.9, 0.4, 0.3), c = "dark" },
	}
	addEyes(parts, 6.9, -4.1, 0.95)
	add({
		id = "ostrich",
		name = "Autruche des cimes",
		desc = "Foncière et rapide. Parfaite pour gagner du terrain.",
		speed = 52,
		value = 1.2,
		weight = 16,
		tameTime = 5,
		buckAfter = 8,
		trait = "sprint",
		weaveAmp = 2,
		weaveFreq = 0.6,
		rootY = 7,
		body = { s = V(3.4, 4, 6), c = "body" },
		palette = {
			body = C(176, 72, 56),
			dark = C(112, 44, 38),
			light = C(238, 214, 176),
			accent = C(255, 200, 50),
			eye = C(20, 20, 20),
		},
		parts = parts,
		legs = {
			{ n = "LegL", s = V(0.9, 5, 0.9), hip = V(-1.1, -2, 0.6), phase = 0, c = "accent" },
			{ n = "LegR", s = V(0.9, 5, 0.9), hip = V(1.1, -2, 0.6), phase = math.pi, c = "accent" },
		},
		wings = {},
	})
end

-- 3. Rhinocéros : charge par rafales.
do
	local parts = {
		{ n = "Head", s = V(4, 4, 4), o = V(0, -0.2, -6.2), c = "dark" },
		{ n = "Horn", s = V(0.9, 0.9, 2.8), o = V(0, 2.3, -8.1), c = "light", rot = V(-25, 0, 0) },
		{ n = "EarL", s = V(0.6, 1.2, 0.8), o = V(-1.6, 2.4, -4.6), c = "dark" },
		{ n = "EarR", s = V(0.6, 1.2, 0.8), o = V(1.6, 2.4, -4.6), c = "dark" },
		{ n = "Plates", s = V(6.4, 0.8, 2.2), o = V(0, 2.7, -2.5), c = "accent" },
		{ n = "Tail", s = V(0.5, 0.5, 2), o = V(0, 1.5, 5.4), c = "dark" },
	}
	addEyes(parts, 0.7, -8.15, 1.6)
	add({
		id = "rhino",
		name = "Rhinocéros",
		desc = "Charge par rafales : +50 % de vitesse toutes les 6 s.",
		speed = 33,
		value = 1.5,
		weight = 15,
		tameTime = 6,
		buckAfter = 11,
		trait = "charge",
		weaveAmp = 0,
		weaveFreq = 1,
		rootY = 5.5,
		body = { s = V(6, 5, 9), c = "body" },
		palette = {
			body = C(136, 138, 150),
			dark = C(96, 98, 110),
			light = C(236, 232, 218),
			accent = C(170, 120, 80),
			eye = C(20, 20, 20),
		},
		parts = parts,
		legs = quadLegs(V(1.7, 3, 1.7), -2.5, 2.0, 3.2),
		wings = {},
	})
end

-- 4. Bélier : bondit en courant.
do
	local parts = {
		{ n = "Head", s = V(2.6, 2.8, 2.8), o = V(0, 0.9, -4.3), c = "dark" },
		{ n = "HornL", s = V(0.9, 0.9, 1.8), o = V(-1.6, 1.9, -4.0), c = "accent" },
		{ n = "HornLB", s = V(0.9, 0.9, 0.9), o = V(-1.9, 1.2, -5.0), c = "accent" },
		{ n = "HornR", s = V(0.9, 0.9, 1.8), o = V(1.6, 1.9, -4.0), c = "accent" },
		{ n = "HornRB", s = V(0.9, 0.9, 0.9), o = V(1.9, 1.2, -5.0), c = "accent" },
		{ n = "EarL", s = V(0.4, 0.5, 1.0), o = V(-1.5, 1.8, -3.2), c = "dark" },
		{ n = "EarR", s = V(0.4, 0.5, 1.0), o = V(1.5, 1.8, -3.2), c = "dark" },
		{ n = "Tail", s = V(0.7, 0.7, 0.7), o = V(0, 0.8, 3.5), c = "body" },
	}
	addEyes(parts, 1.4, -5.65, 0.8)
	add({
		id = "ram",
		name = "Bélier",
		desc = "Il bondit à chaque foulée : spectaculaire et rapide.",
		speed = 42,
		value = 1.3,
		weight = 15,
		tameTime = 5,
		buckAfter = 9,
		trait = "hop",
		weaveAmp = 5,
		weaveFreq = 0.8,
		rootY = 4.8,
		body = { s = V(4, 3.6, 6.4), c = "body" },
		palette = {
			body = C(244, 240, 228),
			dark = C(70, 58, 56),
			light = C(255, 255, 255),
			accent = C(210, 180, 130),
			eye = C(255, 255, 255),
		},
		parts = parts,
		legs = quadLegs(V(1, 3, 1), -1.8, 1.3, 2.2),
		wings = {},
	})
end

-- 5. Mammouth : lent, très rentable, ne désarçonne jamais.
do
	local parts = {
		{ n = "Head", s = V(5, 5, 5), o = V(0, 1.0, -8.0), c = "body" },
		{ n = "TrunkA", s = V(1.6, 1.6, 3.2), o = V(0, -0.6, -11.0), c = "dark" },
		{ n = "TrunkB", s = V(1.4, 2.6, 1.4), o = V(0, -1.9, -12.2), c = "dark" },
		{ n = "TuskL", s = V(0.8, 0.8, 4.2), o = V(-1.8, -0.8, -10.8), c = "light", rot = V(0, 12, 0) },
		{ n = "TuskR", s = V(0.8, 0.8, 4.2), o = V(1.8, -0.8, -10.8), c = "light", rot = V(0, -12, 0) },
		{ n = "EarL", s = V(0.7, 4, 3.8), o = V(-3.1, 1.4, -7.2), c = "dark" },
		{ n = "EarR", s = V(0.7, 4, 3.8), o = V(3.1, 1.4, -7.2), c = "dark" },
		{ n = "Tuft", s = V(3, 1.2, 3), o = V(0, 3.8, -7.6), c = "dark" },
		{ n = "Tail", s = V(0.8, 0.8, 2.2), o = V(0, 1.4, 6.1), c = "dark" },
	}
	addEyes(parts, 1.8, -10.45, 1.6)
	add({
		id = "mammoth",
		name = "Mammouth",
		desc = "Lent mais très rentable. Ne te désarçonne jamais.",
		speed = 25,
		value = 2.5,
		weight = 9,
		tameTime = 8,
		buckAfter = nil,
		trait = "stable",
		weaveAmp = 0,
		weaveFreq = 1,
		rootY = 7.5,
		body = { s = V(8, 7, 11), c = "body" },
		palette = {
			body = C(118, 78, 50),
			dark = C(80, 52, 34),
			light = C(242, 232, 204),
			accent = C(200, 90, 60),
			eye = C(20, 20, 20),
		},
		parts = parts,
		legs = quadLegs(V(2.4, 4, 2.4), -3.5, 2.6, 3.8),
		wings = {},
	})
end

-- 6. Tricératops : solide, rentable.
do
	local parts = {
		{ n = "Head", s = V(3.6, 3.6, 3.8), o = V(0, 0.2, -6.2), c = "body" },
		{ n = "Frill", s = V(7, 6, 0.8), o = V(0, 2.0, -4.3), c = "accent", rot = V(-20, 0, 0) },
		{ n = "NoseHorn", s = V(0.8, 0.8, 1.8), o = V(0, 0.6, -8.9), c = "light" },
		{ n = "BrowL", s = V(0.7, 0.7, 2.6), o = V(-1.2, 1.8, -8.0), c = "light", rot = V(-15, 0, 0) },
		{ n = "BrowR", s = V(0.7, 0.7, 2.6), o = V(1.2, 1.8, -8.0), c = "light", rot = V(-15, 0, 0) },
		{ n = "Tail", s = V(1.4, 1.4, 3.5), o = V(0, 0, 6.3), c = "dark" },
	}
	addEyes(parts, 1.0, -8.05, 1.5)
	add({
		id = "trike",
		name = "Tricératops",
		desc = "Un bouclier vivant. Rentable et endurant.",
		speed = 30,
		value = 2,
		weight = 12,
		tameTime = 7,
		buckAfter = 14,
		trait = "tank",
		weaveAmp = 2,
		weaveFreq = 0.7,
		rootY = 4.85,
		body = { s = V(5.5, 4.5, 9), c = "body" },
		palette = {
			body = C(96, 166, 98),
			dark = C(64, 120, 72),
			light = C(246, 240, 214),
			accent = C(230, 120, 60),
			eye = C(20, 20, 20),
		},
		parts = parts,
		legs = quadLegs(V(1.6, 2.6, 1.6), -2.25, 1.9, 3.0),
		wings = {},
	})
end

-- 7. Wyverne : vole haut, rare et très rentable. Il faut la lasso en plein bond.
do
	local parts = {
		{ n = "Head", s = V(2.4, 2.4, 3), o = V(0, 0.8, -5.0), c = "body" },
		{ n = "Snout", s = V(1.4, 1.2, 1.6), o = V(0, 0.4, -6.8), c = "dark" },
		{ n = "Tail", s = V(1.2, 1.2, 4), o = V(0, -0.2, 5.5), c = "dark" },
		{ n = "TailTip", s = V(2, 0.4, 2), o = V(0, -0.2, 8), c = "accent" },
		{ n = "HornL", s = V(0.4, 0.4, 1.4), o = V(-0.7, 2.2, -4.5), c = "light" },
		{ n = "HornR", s = V(0.4, 0.4, 1.4), o = V(0.7, 2.2, -4.5), c = "light" },
		{ n = "Spine", s = V(0.6, 1, 5), o = V(0, 2.0, 0.5), c = "accent" },
	}
	addEyes(parts, 1.3, -6.45, 0.8)
	add({
		id = "wyvern",
		name = "Wyverne",
		desc = "Elle vole à 12 m du sol. Lasso-la en plein bond !",
		speed = 56,
		value = 3.5,
		weight = 7,
		tameTime = 6,
		buckAfter = 10,
		trait = "fly",
		weaveAmp = 8,
		weaveFreq = 0.5,
		rootY = 12,
		flying = true,
		body = { s = V(3, 3, 7), c = "body" },
		palette = {
			body = C(120, 70, 190),
			dark = C(70, 40, 120),
			light = C(240, 230, 255),
			accent = C(255, 110, 200),
			eye = C(255, 240, 80),
		},
		parts = parts,
		legs = {},
		wings = {
			{ n = "WingL", s = V(7, 0.35, 3.6), hip = V(-1.5, 1.0, -0.4), side = -1, c = "accent" },
			{ n = "WingR", s = V(7, 0.35, 3.6), hip = V(1.5, 1.0, -0.4), side = 1, c = "accent" },
		},
	})
end

Species.ById = {}
for _, def in ipairs(Species.List) do
	Species.ById[def.id] = def
end

return Species
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Petits utilitaires partagés (serveur + client).

local Util = {}

function Util.create(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Anti-spam des RemoteEvents : renvoie false si l'appel est trop rapproché.
local lastCall = {}

function Util.allow(player, key, interval)
	local now = os.clock()
	local bucket = lastCall[player]
	if not bucket then
		bucket = {}
		lastCall[player] = bucket
	end
	local last = bucket[key]
	if last and now - last < interval then
		return false
	end
	bucket[key] = now
	return true
end

function Util.forget(player)
	lastCall[player] = nil
end

function Util.pickWeighted(list, rng)
	local total = 0
	for _, item in ipairs(list) do
		total = total + item.weight
	end
	local roll = rng:NextNumber() * total
	for _, item in ipairs(list) do
		roll = roll - item.weight
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

function Util.formatNumber(n)
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^%s+", ""))
end

function Util.formatTime(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Util.isFiniteNumber(v)
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end

return Util
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX21"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX20"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Point d'entrée serveur de Saute-Troupeau.
-- Ordre : remotes -> services -> construction de la carte -> apparition des joueurs -> boucle de manches.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

-- Les joueurs n'apparaissent qu'une fois la carte construite.
Players.CharacterAutoLoads = false
Players.RespawnTime = 3
Workspace.Gravity = Config.Gravity

local Modules = script:WaitForChild("Modules")
local State = require(Modules.State)
local DataService = require(Modules.DataService)
local ProgressService = require(Modules.ProgressService)
local CreatureService = require(Modules.CreatureService)
local RideService = require(Modules.RideService)
local WallService = require(Modules.WallService)
local EventService = require(Modules.EventService)
local MapBuilder = require(Modules.MapBuilder)
local RoundService = require(Modules.RoundService)
local MonetizationService = require(Modules.MonetizationService)

-- Les joueurs ne se bousculent pas (sinon les cavaliers se percutent en l'air).
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
end)
pcall(function()
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

local function setCollisionGroup(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end)
end

local function onCharacterAdded(player, character)
	setCollisionGroup(character)
	task.spawn(function()
		character:WaitForChild("Humanoid", 10)
		character:WaitForChild("Head", 10)
		ProgressService.ApplyCosmetics(player)
	end)
	Remotes.Status:FireClient(player, "Lobby")
end

local handled = {}

local function onPlayerAdded(player)
	if handled[player] then
		return
	end
	handled[player] = true
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	task.spawn(function()
		DataService.Load(player)
		MonetizationService.LoadPasses(player)
		if not player.Parent then
			DataService.Release(player)
			return
		end
		ProgressService.EnsureDaily(player)
		ProgressService.RefreshAttributes(player)
		Remotes.Data:FireClient(player, ProgressService.Snapshot(player))
		ProgressService.ApplyCosmetics(player)
		if not DataService.IsPersistent(player) then
			Remotes.Feedback:FireClient(player, {
				kind = "warn",
				title = "SAUVEGARDE INDISPONIBLE",
				sub = "Ta progression ne sera pas enregistrée pendant cette session.",
			})
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	handled[player] = nil
	DataService.Release(player)
end)

DataService.Init()
ProgressService.Init()
RideService.Init()
MonetizationService.Init()

-- Carte (peut durer quelques secondes ; les joueurs attendent sans apparaître)
local wallRoot = MapBuilder.Build()
WallService.Init(wallRoot)
State.MapReady = true
Players.CharacterAutoLoads = true

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
	task.spawn(function()
		player:LoadCharacter()
	end)
end

-- Simulation
RunService.Heartbeat:Connect(function(dt)
	if State.Phase ~= "Running" then
		return
	end
	dt = math.min(dt, 0.1)
	CreatureService.Step(dt)
	WallService.Step(dt)
	RideService.Step(dt)
	EventService.Step(State.RunElapsed)
end)

-- Classement mondial du salon
task.spawn(function()
	task.wait(4)
	while true do
		MapBuilder.RefreshBoard()
		task.wait(90)
	end
end)

task.spawn(RoundService.Run)
]]></ProtectedString></Properties><Item class="Folder" referent="RBX19"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[-- Chapeaux : construits en blocs et soudés à la tête du personnage.

local Cosmetics = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Décalages relatifs au centre de la tête (le dessus de la tête est à y = +0.5).
-- shape : "Block" (défaut), "Ball" ou "Cyl" ; rot en degrés.
local HATS = {
	beanie = {
		{ s = V(2.3, 1.6, 2.3), o = V(0, 0.55, 0), c = C(214, 60, 60), shape = "Ball" },
		{ s = V(2.2, 0.35, 2.2), o = V(0, 0.15, 0), c = C(255, 255, 255) },
		{ s = V(0.9, 0.9, 0.9), o = V(0, 1.5, 0), c = C(255, 255, 255), shape = "Ball" },
	},
	cowboy = {
		{ s = V(0.2, 4.4, 4.4), o = V(0, 0.6, 0), c = C(150, 96, 56), shape = "Cyl", rot = V(0, 0, 90) },
		{ s = V(2.2, 1.3, 2.2), o = V(0, 1.2, 0), c = C(150, 96, 56) },
		{ s = V(2.3, 0.3, 2.3), o = V(0, 0.85, 0), c = C(80, 50, 30) },
	},
	viking = {
		{ s = V(2.4, 2.0, 2.4), o = V(0, 0.5, 0), c = C(150, 152, 160), mat = Enum.Material.Metal, shape = "Ball" },
		{ s = V(0.5, 1.4, 0.5), o = V(-1.3, 1.0, 0), c = C(240, 232, 205), rot = V(0, 0, 20) },
		{ s = V(0.5, 1.4, 0.5), o = V(1.3, 1.0, 0), c = C(240, 232, 205), rot = V(0, 0, -20) },
		{ s = V(0.5, 0.8, 0.5), o = V(-1.75, 1.9, 0), c = C(240, 232, 205), rot = V(0, 0, 40) },
		{ s = V(0.5, 0.8, 0.5), o = V(1.75, 1.9, 0), c = C(240, 232, 205), rot = V(0, 0, -40) },
	},
	wizard = {
		{ s = V(3.2, 0.2, 3.2), o = V(0, 0.6, 0), c = C(90, 50, 150) },
		{ s = V(2.2, 1.2, 2.2), o = V(0, 1.2, 0), c = C(90, 50, 150) },
		{ s = V(1.6, 1.2, 1.6), o = V(0, 2.4, 0), c = C(90, 50, 150) },
		{ s = V(1.0, 1.2, 1.0), o = V(0, 3.6, 0), c = C(90, 50, 150) },
		{ s = V(0.5, 0.8, 0.5), o = V(0, 4.5, 0), c = C(90, 50, 150) },
		{ s = V(0.7, 0.7, 0.7), o = V(0, 5.1, 0), c = C(255, 225, 80), mat = Enum.Material.Neon, shape = "Ball" },
	},
	dino = {
		{ s = V(2.3, 1.2, 2.3), o = V(0, 0.7, 0), c = C(96, 166, 98) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, 0.6), c = C(230, 120, 60) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, 0), c = C(230, 120, 60) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, -0.6), c = C(230, 120, 60) },
		{ s = V(0.6, 0.6, 0.6), o = V(-0.6, 1.3, -0.9), c = C(255, 255, 255), shape = "Ball" },
		{ s = V(0.6, 0.6, 0.6), o = V(0.6, 1.3, -0.9), c = C(255, 255, 255), shape = "Ball" },
	},
	vip = {
		{ s = V(2.2, 0.5, 2.2), o = V(0, 0.75, 0), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{
			s = V(0.6, 1.8, 0.6),
			o = V(-1.3, 1.5, 0),
			c = C(255, 214, 90),
			mat = Enum.Material.Metal,
			rot = V(0, 0, 25),
		},
		{
			s = V(0.6, 1.8, 0.6),
			o = V(1.3, 1.5, 0),
			c = C(255, 214, 90),
			mat = Enum.Material.Metal,
			rot = V(0, 0, -25),
		},
		{
			s = V(0.5, 1.0, 0.5),
			o = V(-1.9, 2.5, 0),
			c = C(255, 245, 180),
			mat = Enum.Material.Neon,
			rot = V(0, 0, 45),
		},
		{
			s = V(0.5, 1.0, 0.5),
			o = V(1.9, 2.5, 0),
			c = C(255, 245, 180),
			mat = Enum.Material.Neon,
			rot = V(0, 0, -45),
		},
	},
	crown = {
		{ s = V(2.2, 0.8, 2.2), o = V(0, 0.9, 0), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(-0.8, 1.7, -0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(0.8, 1.7, -0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(-0.8, 1.7, 0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(0.8, 1.7, 0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.5, 0.3), o = V(0, 0.9, -1.15), c = C(255, 60, 90), mat = Enum.Material.Neon },
	},
}

function Cosmetics.remove(character)
	local old = character:FindFirstChild("HHHat")
	if old then
		old:Destroy()
	end
end

function Cosmetics.applyHat(character, hatId)
	Cosmetics.remove(character)
	local spec = HATS[hatId]
	if not spec then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end

	local model = Instance.new("Model")
	model.Name = "HHHat"
	for index, def in ipairs(spec) do
		local part = Instance.new("Part")
		part.Name = "HatPart" .. index
		part.Size = def.s
		part.Color = def.c
		part.Material = def.mat or Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.CastShadow = false
		if def.shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif def.shape == "Cyl" then
			part.Shape = Enum.PartType.Cylinder
		end
		local rot = def.rot or Vector3.new(0, 0, 0)
		part.CFrame = head.CFrame * CFrame.new(def.o) * CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end
	model.Parent = character
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CreatureService</string><ProtectedString name="Source"><![CDATA[-- Troupeau : construction des bêtes, déplacement, apparition / disparition.
-- Chaque bête = un Model dont seule la pièce "Root" est ancrée ; les autres pièces sont soudées.
-- Déplacer Root (CFrame) déplace tout le monde et ne réplique qu'une pièce.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Util = require(Shared.Util)

local State = require(script.Parent.State)

local CreatureService = {}

local rng = Random.new()

local function variantColor(color, variantIdx)
	if variantIdx == 2 then
		return color:Lerp(Color3.fromRGB(110, 210, 255), 0.55)
	elseif variantIdx == 3 then
		return color:Lerp(Color3.fromRGB(255, 205, 60), 0.65)
	end
	return color
end

local function variantMaterial(variantIdx, override)
	if variantIdx == 2 then
		return Enum.Material.Ice
	elseif variantIdx == 3 then
		return Enum.Material.Metal
	end
	return override or Enum.Material.Plastic
end

local function newPart(name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	return part
end

-- Construit le modèle d'une bête (sans le parenter). Renvoie model, root.
function CreatureService.BuildModel(def, variantIdx)
	local palette = def.palette
	local model = Instance.new("Model")
	model.Name = "Beast"

	local function color(key)
		if key == "eye" then
			return palette.eye
		end
		return variantColor(palette[key], variantIdx)
	end

	local root = newPart("Root", def.body.s, color(def.body.c), variantMaterial(variantIdx))
	root.Anchored = true
	root.CFrame = CFrame.new(0, 0, 0)
	root.CastShadow = true
	root.Parent = model
	model.PrimaryPart = root

	for _, spec in ipairs(def.parts) do
		local part = newPart(
			spec.n,
			spec.s,
			color(spec.c),
			spec.c == "eye" and Enum.Material.SmoothPlastic or variantMaterial(variantIdx)
		)
		local rot = spec.rot or Vector3.new(0, 0, 0)
		part.CFrame = root.CFrame
			* CFrame.new(spec.o)
			* CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		part.CastShadow = spec.s.Magnitude > 3
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end

	for _, spec in ipairs(def.legs) do
		local pivot = Vector3.new(0, spec.s.Y / 2, 0)
		local part = newPart(spec.n, spec.s, color(spec.c), variantMaterial(variantIdx))
		part.CFrame = root.CFrame * CFrame.new(spec.hip) * CFrame.new(-pivot)
		part.CastShadow = false
		local motor = Instance.new("Motor6D")
		motor.Name = spec.n
		motor.Part0 = root
		motor.Part1 = part
		motor.C0 = CFrame.new(spec.hip)
		motor.C1 = CFrame.new(pivot)
		motor:SetAttribute("Phase", spec.phase)
		motor.Parent = part
		part.Parent = model
	end

	for _, spec in ipairs(def.wings) do
		local pivot = Vector3.new(-spec.side * spec.s.X / 2, 0, 0)
		local part = newPart(spec.n, spec.s, color(spec.c), variantMaterial(variantIdx))
		part.CFrame = root.CFrame * CFrame.new(spec.hip) * CFrame.new(-pivot)
		part.CastShadow = false
		local motor = Instance.new("Motor6D")
		motor.Name = spec.n
		motor.Part0 = root
		motor.Part1 = part
		motor.C0 = CFrame.new(spec.hip)
		motor.C1 = CFrame.new(pivot)
		motor:SetAttribute("Side", spec.side)
		motor.Parent = part
		part.Parent = model
	end

	return model, root
end

local function addEmitters(def, variantIdx, root)
	-- Poussière : activée uniquement quand la bête est montée.
	local dustAttachment = Instance.new("Attachment")
	dustAttachment.Name = "DustAttachment"
	if def.flying then
		dustAttachment.Position = Vector3.new(0, 0, 3)
	else
		dustAttachment.Position = Vector3.new(0, -def.rootY + 0.5, 2)
	end
	dustAttachment.Parent = root

	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"
	dust.Enabled = false
	dust.Rate = 26
	dust.Lifetime = NumberRange.new(0.5, 1.0)
	dust.Speed = NumberRange.new(4, 9)
	dust.SpreadAngle = Vector2.new(25, 25)
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0.2) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	dust.Color = ColorSequence.new(def.flying and Color3.fromRGB(200, 170, 255) or Color3.fromRGB(214, 190, 150))
	dust.EmissionDirection = Enum.NormalId.Back
	dust.Parent = dustAttachment

	if variantIdx > 1 then
		local spark = Instance.new("ParticleEmitter")
		spark.Name = "Sparkle"
		spark.Rate = 5
		spark.Lifetime = NumberRange.new(0.8, 1.4)
		spark.Speed = NumberRange.new(1, 3)
		spark.SpreadAngle = Vector2.new(180, 180)
		spark.LightEmission = 1
		spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
		spark.Color =
			ColorSequence.new(variantIdx == 3 and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(150, 230, 255))
		spark.Parent = root
	end
end

local function pickSpecies()
	return Util.pickWeighted(Species.List, rng)
end

local function pickVariant()
	return Util.pickWeighted(Config.Variants, rng).id
end

-- Crée une bête et l'ajoute au monde. Renvoie le record `creature`.
function CreatureService.Spawn(x, z, speciesId, variantIdx, speedFactor)
	local def = speciesId and Species.ById[speciesId] or pickSpecies()
	variantIdx = variantIdx or pickVariant()
	local variant = Config.Variants[variantIdx]

	local id = State.NextCreatureId
	State.NextCreatureId = id + 1

	local model, root = CreatureService.BuildModel(def, variantIdx)
	model.Name = "Beast" .. id
	model:SetAttribute("Id", id)
	model:SetAttribute("Species", def.id)
	model:SetAttribute("Variant", variantIdx)
	model:SetAttribute("BaseSpeed", def.speed)
	model:SetAttribute("Ridden", false)
	model:SetAttribute("Angry", false)
	addEmitters(def, variantIdx, root)

	local baseSpeed = def.speed * (0.9 + rng:NextNumber() * 0.2) * (speedFactor or 1)
	if variantIdx == 3 then
		baseSpeed = baseSpeed * 1.1
	end

	local creature = {
		id = id,
		def = def,
		variantIdx = variantIdx,
		variant = variant,
		model = model,
		root = root,
		x = x,
		z = z,
		baseSpeed = baseSpeed,
		speed = baseSpeed,
		phase = rng:NextNumber() * 10,
		age = 0,
		steer = 0,
		vx = 0,
		rider = nil,
		tamed = false,
		angry = false,
		removed = false,
		seat = CFrame.new(def.seat),
	}

	local y = def.rootY
	root.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(x, y, z + 1))
	model.Parent = State.CreaturesFolder
	State.Creatures[id] = creature
	return creature
end

function CreatureService.Remove(creature)
	if creature.removed then
		return
	end
	creature.removed = true
	State.Creatures[creature.id] = nil
	creature.model:Destroy()
end

function CreatureService.Clear()
	for _, creature in pairs(State.Creatures) do
		creature.removed = true
		creature.model:Destroy()
	end
	State.Creatures = {}
end

function CreatureService.SeatWorldCFrame(creature)
	return creature.root.CFrame * creature.seat
end

-- Bête libre la plus proche (pour remonter un joueur tombé). Renvoie nil si aucune.
function CreatureService.FindRescue(x, z)
	local best, bestScore = nil, math.huge
	for _, creature in pairs(State.Creatures) do
		if not creature.rider and not creature.removed then
			local dz = creature.z - z
			if dz > -25 and dz < 150 then
				local score = math.abs(dz - 20) + math.abs(creature.x - x) * 0.5
				if score < bestScore then
					best, bestScore = creature, score
				end
			end
		end
	end
	return best
end

local function activeBounds()
	local minZ, maxZ = math.huge, -math.huge
	local positions = {}
	for player, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" then
			local z = run.z or 0
			minZ = math.min(minZ, z)
			maxZ = math.max(maxZ, z)
			table.insert(positions, z)
		end
	end
	if #positions == 0 then
		return nil, nil, positions
	end
	return minZ, maxZ, positions
end

local function tooClose(x, z)
	for _, creature in pairs(State.Creatures) do
		if math.abs(creature.z - z) < 9 and math.abs(creature.x - x) < 9 then
			return true
		end
	end
	return false
end

local function trySpawnNear(z0, ahead)
	for _ = 1, 6 do
		local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 8)
		local z = z0 + ahead[1] + rng:NextNumber() * (ahead[2] - ahead[1])
		if z < Config.Track.FinishZ - 40 and not tooClose(x, z) then
			-- Les bêtes de devant sont un peu plus lentes pour rester rattrapables.
			return CreatureService.Spawn(x, z, nil, nil, 0.85 + rng:NextNumber() * 0.15)
		end
	end
	return nil
end

-- Remplit le troupeau au début de la manche.
function CreatureService.FillInitial()
	for _ = 1, 40 do
		local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 8)
		local z = 40 + rng:NextNumber() * 260
		if not tooClose(x, z) then
			CreatureService.Spawn(x, z)
		end
	end
end

function CreatureService.Step(dt)
	if State.Frozen then
		return
	end

	local half = Config.Track.HalfWidth
	local finishZ = Config.Track.FinishZ

	for _, creature in pairs(State.Creatures) do
		local def = creature.def
		creature.age = creature.age + dt

		local target = creature.baseSpeed
		if def.trait == "charge" then
			if (creature.age + creature.phase) % 6 < 1.2 then
				target = target * 1.5
			end
		end
		creature.speed = creature.speed + (target - creature.speed) * math.min(1, dt * 4)

		local vx
		if creature.rider then
			vx = creature.steer * Config.Ride.SteerSpeed
		else
			vx = math.sin(creature.age * def.weaveFreq + creature.phase) * def.weaveAmp
		end
		creature.vx = vx
		creature.x = math.clamp(creature.x + vx * dt, -half, half)
		creature.z = creature.z + creature.speed * dt

		local y = def.rootY
		if def.trait == "hop" then
			y = y + math.abs(math.sin((creature.age + creature.phase) * 3.2)) * 2.2
		elseif def.flying then
			y = y + math.sin((creature.age + creature.phase) * 2) * 1.2
		end
		creature.y = y

		local pos = Vector3.new(creature.x, y, creature.z)
		creature.root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(vx * 0.12, 0, 1)) * CFrame.Angles(0, 0, -vx * 0.004)
	end

	-- Disparition : trop loin derrière / devant les joueurs actifs, ou après l'arrivée.
	local minZ, maxZ, positions = activeBounds()
	local toRemove = nil
	for _, creature in pairs(State.Creatures) do
		local gone = creature.z > finishZ + 30
		if minZ and not creature.rider then
			if creature.z < minZ - 90 or creature.z > maxZ + 320 then
				gone = true
			end
		end
		if gone and not creature.rider then
			toRemove = toRemove or {}
			table.insert(toRemove, creature)
		end
	end
	if toRemove then
		for _, creature in ipairs(toRemove) do
			CreatureService.Remove(creature)
		end
	end

	-- Apparition : garantir de la densité devant chaque joueur actif.
	if not minZ then
		return
	end
	local total = 0
	for _ in pairs(State.Creatures) do
		total = total + 1
	end
	local desired = math.clamp(10 + 9 * #positions, 28, 64)
	local spawned = 0
	for _, pz in ipairs(positions) do
		if total >= 80 or spawned >= 3 then
			break
		end
		local ahead = 0
		for _, creature in pairs(State.Creatures) do
			if creature.z > pz and creature.z < pz + 170 then
				ahead = ahead + 1
			end
		end
		if ahead < 7 then
			if trySpawnNear(pz, { 60, 170 }) then
				spawned = spawned + 1
				total = total + 1
			end
		end
	end
	if total < desired and spawned < 3 then
		local pz = positions[rng:NextInteger(1, #positions)]
		if trySpawnNear(pz, { 40, 190 }) then
			total = total + 1
		end
	end
end

return CreatureService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Sauvegarde des joueurs (DataStore) + classement mondial (OrderedDataStore).
-- Règles de sécurité :
--  * si le chargement échoue, la sauvegarde est DÉSACTIVÉE pour ce joueur (on n'écrase jamais un vrai profil par un profil vide) ;
--  * sauvegarde automatique toutes les 60 s, à la sortie du joueur et à l'arrêt du serveur.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local STORE_NAME = "HerdHopper_Profiles_v1"
local BOARD_NAME = "HerdHopper_BestScore_v1"
local AUTOSAVE_INTERVAL = 60

local DataService = {}

local store = DataStoreService:GetDataStore(STORE_NAME)
local board = DataStoreService:GetOrderedDataStore(BOARD_NAME)

local profiles = {} -- [Player] = { data, canSave, dirty, version }

local function defaultData()
	return {
		coins = 0,
		bestScore = 0,
		wins = 0,
		rounds = 0,
		hooks = 0,
		tamedTotal = 0,
		distance = 0,
		tamed = {},
		completed = {},
		upgrades = { range = 0, taming = 0, combo = 0 },
		owned = { hats = { none = true }, ropes = { classic = true } },
		equipped = { hat = "none", rope = "classic" },
		daily = { last = 0, streak = 0 },
		quests = { day = 0, list = {} },
		receipts = {},
	}
end

local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = reconcile({}, value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

function DataService.Load(player)
	local key = "P_" .. player.UserId
	local data = nil
	local ok = false
	for attempt = 1, 3 do
		local success, result = pcall(function()
			return store:GetAsync(key)
		end)
		if success then
			data = result
			ok = true
			break
		end
		warn(("[Data] Chargement impossible (essai %d/3) : %s"):format(attempt, tostring(result)))
		task.wait(1.5)
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		data = reconcile(data, defaultData())
	end

	local profile = { data = data, canSave = ok, dirty = false, version = 0 }
	profiles[player] = profile
	return profile
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

function DataService.IsPersistent(player)
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

function DataService.MarkDirty(player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
		profile.version = profile.version + 1
	end
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not profile.dirty then
		return true
	end
	local version = profile.version
	local snapshot = deepCopy(profile.data)
	local err
	for attempt = 1, 3 do
		local ok
		ok, err = pcall(function()
			store:UpdateAsync("P_" .. player.UserId, function()
				return snapshot
			end)
		end)
		if ok then
			if profile.version == version then
				profile.dirty = false
			end
			return true
		end
		if attempt < 3 then
			task.wait(attempt * 1.5)
		end
	end
	warn("[Data] Sauvegarde échouée après 3 essais : " .. tostring(err))
	return false
end

function DataService.Release(player)
	DataService.Save(player)
	profiles[player] = nil
end

function DataService.SubmitBest(player, score)
	local value = math.floor(score)
	local userId = tostring(player.UserId)
	task.spawn(function()
		local err
		for attempt = 1, 3 do
			local ok
			ok, err = pcall(function()
				board:SetAsync(userId, value)
			end)
			if ok then
				return
			end
			task.wait(attempt * 2)
		end
		warn("[Data] Classement mondial indisponible : " .. tostring(err))
	end)
end

-- Renvoie { {userId=, score=}, ... } ou nil si indisponible.
function DataService.GetTop(count)
	local ok, result = pcall(function()
		local pages = board:GetSortedAsync(false, count)
		return pages:GetCurrentPage()
	end)
	if not ok then
		return nil
	end
	local list = {}
	for _, entry in ipairs(result) do
		table.insert(list, { userId = tonumber(entry.key), score = entry.value })
	end
	return list
end

function DataService.Init()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, player)
				task.wait(0.2)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player)
				pending = pending - 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 20 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- Événements de manche : Geysers (gros bonds gratuits) et Pluie de météores (éjecte les cavaliers).
-- Chaque événement est annoncé par un anneau au sol ("télégraphie") avant d'agir.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Fx = require(script.Parent.Fx)
local RideService = require(script.Parent.RideService)

local EventService = {}

local rng = Random.new()
local nextEventAt = 0

local function activeRuns()
	local list = {}
	for player, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Down" then
			table.insert(list, { player = player, run = run })
		end
	end
	return list
end

local function playersInRadius(position, radius)
	local found = {}
	for player, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Down" then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = hrp.Position - position
				local flat = math.sqrt(d.X * d.X + d.Z * d.Z)
				if flat <= radius and d.Y < 40 then
					table.insert(found, player)
				end
			end
		end
	end
	return found
end

local function announce(kind, title, sub)
	Remotes.Feedback:FireAllClients({ kind = kind, title = title, sub = sub })
end

local function randomPositionAhead(zMin, zMax)
	local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 14)
	local z = math.clamp(zMin + rng:NextNumber() * (zMax - zMin), 40, Config.Track.FinishZ - 80)
	return Vector3.new(x, 0, z)
end

local function geyser(position, roundId)
	local radius = Config.Events.GeyserRadius
	Fx.ring(position, radius, Color3.fromRGB(90, 200, 255), Config.Events.Telegraph)
	task.delay(Config.Events.Telegraph, function()
		if State.RoundId ~= roundId or State.Phase ~= "Running" then
			return
		end
		Fx.column(position, radius, 70, Color3.fromRGB(120, 220, 255), 0.9)
		for _, player in ipairs(playersInRadius(position, radius)) do
			if player.Parent then
				RideService.Boost(player, Vector3.new(0, 90, 70))
				Remotes.Feedback:FireClient(
					player,
					{ kind = "geyser", title = "GEYSER !", sub = "Super bond ! Lasso une bête en l'air !" }
				)
			end
		end
	end)
end

local function meteor(position, roundId)
	local radius = Config.Events.MeteorRadius
	Fx.ring(position, radius, Color3.fromRGB(255, 70, 40), Config.Events.Telegraph)
	task.delay(Config.Events.Telegraph, function()
		if State.RoundId ~= roundId or State.Phase ~= "Running" then
			return
		end
		Fx.explosion(Vector3.new(position.X, 6, position.Z), radius, Color3.fromRGB(255, 120, 40))
		for _, player in ipairs(playersInRadius(position, radius)) do
			if player.Parent then
				RideService.Knock(player)
			end
		end
	end)
end

function EventService.Reset()
	nextEventAt = Config.Events.FirstDelay
end

-- Appelé à chaque Heartbeat pendant la manche ; `elapsed` = secondes écoulées depuis le départ.
function EventService.Step(elapsed)
	if elapsed < nextEventAt then
		return
	end
	local runs = activeRuns()
	nextEventAt = elapsed + Config.Events.MinGap + rng:NextNumber() * (Config.Events.MaxGap - Config.Events.MinGap)
	if #runs == 0 then
		return
	end

	local leaderZ = -math.huge
	for _, entry in ipairs(runs) do
		leaderZ = math.max(leaderZ, entry.run.z or 0)
	end
	local roundId = State.RoundId

	if rng:NextNumber() < 0.6 then
		announce("event", "GEYSERS !", "Fonce dans les cercles bleus pour un super bond.")
		for _ = 1, 2 do
			geyser(randomPositionAhead(leaderZ + 70, leaderZ + 180), roundId)
		end
	else
		announce("danger", "PLUIE DE MÉTÉORES !", "Évite les cercles rouges !")
		for _ = 1, 3 do
			meteor(randomPositionAhead(leaderZ + 40, leaderZ + 160), roundId)
		end
	end
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Effets visuels ponctuels côté serveur (anneaux d'avertissement, explosions, geysers, particules).

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local State = require(script.Parent.State)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local Fx = {}

local function folder()
	return State.FxFolder or workspace
end

-- Rafale de particules à une position.
function Fx.burst(position, color, count, speed)
	local part = Util.create("Part", {
		Name = "Burst",
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		Size = Vector3.new(1, 1, 1),
		Position = position,
	}, folder())
	local emitter = Util.create("ParticleEmitter", {
		Enabled = false,
		Color = ColorSequence.new(color),
		LightEmission = 0.8,
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(speed or 24, (speed or 24) * 1.6),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Drag = 2,
	}, part)
	emitter:Emit(count or 30)
	Debris:AddItem(part, 2)
end

-- Anneau plat au sol (avertissement), disparaît après `duration`.
function Fx.ring(position, radius, color, duration)
	local ring = Util.create("Part", {
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.45,
		Size = Vector3.new(0.4, radius * 2, radius * 2),
		CFrame = CFrame.new(position.X, 0.3, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
	}, folder())
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Sine), { Transparency = 0.1 }):Play()
	Debris:AddItem(ring, duration)
	return ring
end

-- Boule d'explosion qui grossit puis s'estompe.
function Fx.explosion(position, radius, color)
	local ball = Util.create("Part", {
		Name = "Explosion",
		Shape = Enum.PartType.Ball,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.2,
		Size = Vector3.new(2, 2, 2),
		Position = position,
	}, folder())
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(ball, info, {
		Size = Vector3.new(radius * 2, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, 0.6)
	Fx.burst(position, color, 40, 40)
end

-- Colonne verticale (geyser).
function Fx.column(position, radius, height, color, duration)
	local col = Util.create("Part", {
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.35,
		Size = Vector3.new(1, radius * 1.6, radius * 1.6),
		CFrame = CFrame.new(position.X, 0.5, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
	}, folder())
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(col, info, {
		Size = Vector3.new(height, radius * 1.2, radius * 1.2),
		CFrame = CFrame.new(position.X, height / 2, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(col, duration + 0.1)
	Fx.burst(Vector3.new(position.X, 3, position.Z), color, 50, 50)
end

function Fx.clear()
	if State.FxFolder then
		State.FxFolder:ClearAllChildren()
	end
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Construction procédurale de tout le monde : salon (lobby), piste en 4 biomes, falaises, décors,
-- portiques, ligne d'arrivée, podium et mur de lave. Uniquement des blocs et matériaux Roblox standards.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)

local State = require(script.Parent.State)
local CreatureService = require(script.Parent.CreatureService)
local DataService = require(script.Parent.DataService)

local MapBuilder = {}

local rng = Random.new(20240611)
local built = 0
local statusLabel = nil
local boardRows = {}
local nameCache = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function pace()
	built = built + 1
	if built % 150 == 0 then
		task.wait()
	end
end

-- Crée un bloc ancré. o = { name, shape, collide, trans, shadow, mat }
local function P(parent, size, cf, color, material, o)
	o = o or {}
	local part = Instance.new("Part")
	part.Name = o.name or "Block"
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = o.collide == true
	part.CanTouch = false
	part.CanQuery = o.collide == true
	part.CastShadow = o.shadow == true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if o.trans then
		part.Transparency = o.trans
	end
	if o.shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif o.shape == "Cyl" then
		part.Shape = Enum.PartType.Cylinder
	end
	part.Parent = parent
	pace()
	return part
end

local function mat(name)
	return Enum.Material[name]
end

local function jitter(color, amount)
	local d = (rng:NextNumber() - 0.5) * amount
	return C(
		math.clamp(math.floor(color.R * 255 + d), 0, 255),
		math.clamp(math.floor(color.G * 255 + d), 0, 255),
		math.clamp(math.floor(color.B * 255 + d), 0, 255)
	)
end

local function yaw(deg)
	return CFrame.Angles(0, math.rad(deg), 0)
end

-- ---------------------------------------------------------------------------
-- Éclairage
-- ---------------------------------------------------------------------------

function MapBuilder.SetupLighting()
	Lighting.ClockTime = 15
	Lighting.Brightness = 2.6
	Lighting.GlobalShadows = true
	Lighting.Ambient = C(96, 96, 110)
	Lighting.OutdoorAmbient = C(124, 128, 142)
	Lighting.ColorShift_Top = C(255, 242, 214)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	local function ensure(className, name)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end

	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.Name = "HHSky"
		sky.Parent = Lighting
	end

	local atmosphere = ensure("Atmosphere", "HHAtmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Config.Biomes[1].atmosphere
	atmosphere.Decay = C(255, 222, 180)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2

	local bloom = ensure("BloomEffect", "HHBloom")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1

	local rays = ensure("SunRaysEffect", "HHRays")
	rays.Intensity = 0.12
	rays.Spread = 0.8

	local color = ensure("ColorCorrectionEffect", "HHColor")
	color.Saturation = 0.12
	color.Contrast = 0.06
	color.TintColor = Config.Biomes[1].tint
end

-- ---------------------------------------------------------------------------
-- Panneaux (SurfaceGui)
-- ---------------------------------------------------------------------------

local function makeLabel(parent, text, size, position, textSize, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Text = text
	label.TextColor3 = color or C(255, 255, 255)
	label.Font = font or Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function makeBoard(parent, size, cf, canvas, bg)
	local board =
		P(parent, size, cf, bg or C(34, 40, 56), Enum.Material.SmoothPlastic, { name = "Board", shadow = true })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = canvas
	gui.LightInfluence = 0
	gui.Parent = board
	return board, gui
end

-- ---------------------------------------------------------------------------
-- Salon (lobby)
-- ---------------------------------------------------------------------------

local function buildLobby(map)
	local center = Config.Lobby.Center
	local size = Config.Lobby.Size
	local top = center.Y + size.Y / 2
	State.LobbyCFrame = CFrame.new(center.X, top + 3, center.Z)

	P(
		map,
		size,
		CFrame.new(center),
		C(228, 222, 206),
		Enum.Material.Marble,
		{ name = "LobbyFloor", collide = true, shadow = true }
	)

	-- liserés néon
	local trim = C(255, 200, 70)
	local half = size.X / 2
	P(
		map,
		V(size.X, 0.4, 2),
		CFrame.new(center.X, top + 0.2, center.Z - half + 1),
		trim,
		Enum.Material.Neon,
		{ name = "Trim" }
	)
	P(
		map,
		V(size.X, 0.4, 2),
		CFrame.new(center.X, top + 0.2, center.Z + half - 1),
		trim,
		Enum.Material.Neon,
		{ name = "Trim" }
	)
	P(
		map,
		V(2, 0.4, size.Z),
		CFrame.new(center.X - half + 1, top + 0.2, center.Z),
		trim,
		Enum.Material.Neon,
		{ name = "Trim" }
	)
	P(
		map,
		V(2, 0.4, size.Z),
		CFrame.new(center.X + half - 1, top + 0.2, center.Z),
		trim,
		Enum.Material.Neon,
		{ name = "Trim" }
	)

	-- murs invisibles
	local wallH = 80
	local function barrier(sz, pos)
		P(
			map,
			sz,
			CFrame.new(pos),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "LobbyBarrier", collide = true, trans = 1 }
		)
	end
	barrier(V(size.X + 4, wallH, 2), V(center.X, top + wallH / 2, center.Z - half))
	barrier(V(size.X + 4, wallH, 2), V(center.X, top + wallH / 2, center.Z + half))
	barrier(V(2, wallH, size.Z + 4), V(center.X - half, top + wallH / 2, center.Z))
	barrier(V(2, wallH, size.Z + 4), V(center.X + half, top + wallH / 2, center.Z))

	-- points d'apparition
	local offsets = { V(-12, 0, 12), V(12, 0, 12), V(-12, 0, -4), V(12, 0, -4) }
	for index, off in ipairs(offsets) do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "LobbySpawn" .. index
		spawn.Size = V(8, 1, 8)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.CanCollide = true
		spawn.Color = C(255, 200, 70)
		spawn.Material = Enum.Material.Neon
		spawn.Transparency = 0.2
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.CFrame = CFrame.new(center.X + off.X, top + 0.5, center.Z + off.Z)
		spawn.Parent = map
	end

	-- panneau d'état de la manche
	local _, infoGui =
		makeBoard(map, V(60, 26, 1), CFrame.new(center.X, top + 20, center.Z + half - 6), V(960, 416), C(28, 34, 52))
	makeLabel(infoGui, "SAUTE-TROUPEAU", UDim2.new(1, 0, 0, 120), UDim2.new(0, 0, 0, 20), 96, C(255, 214, 90))
	statusLabel =
		makeLabel(infoGui, "Chargement...", UDim2.new(1, -40, 0, 140), UDim2.new(0, 20, 0, 160), 72, C(255, 255, 255))
	makeLabel(
		infoGui,
		"Bondis de bête en bête. Fuis le mur de lave !",
		UDim2.new(1, -40, 0, 70),
		UDim2.new(0, 20, 0, 320),
		44,
		C(190, 205, 235),
		Enum.Font.GothamMedium
	)

	-- panneau "comment jouer"
	local howPos = Vector3.new(center.X + half - 8, top + 16, center.Z + 10)
	local _, howGui = makeBoard(
		map,
		V(42, 30, 1),
		CFrame.lookAt(howPos, Vector3.new(center.X, top + 16, center.Z + 10)),
		V(672, 480),
		C(40, 46, 66)
	)
	makeLabel(howGui, "COMMENT JOUER", UDim2.new(1, 0, 0, 60), UDim2.new(0, 0, 0, 12), 48, C(255, 214, 90))
	local how = "ESPACE / bouton : sauter de ta bête\n"
		.. "Maintiens en l'air : LASSO auto sur la bête dorée\n"
		.. "A / D ou joystick : diriger ta monture\n"
		.. "Reste dessus pour DOMPTER et marquer\n"
		.. "Enchaîne les lassos pour le COMBO\n"
		.. "Le mur de lave te rattrape : avance !"
	local howLabel = makeLabel(
		howGui,
		how,
		UDim2.new(1, -40, 1, -90),
		UDim2.new(0, 20, 0, 80),
		34,
		C(235, 240, 255),
		Enum.Font.GothamMedium
	)
	howLabel.TextXAlignment = Enum.TextXAlignment.Left
	howLabel.TextYAlignment = Enum.TextYAlignment.Top

	-- classement mondial
	local lbPos = Vector3.new(center.X - half + 8, top + 16, center.Z + 10)
	local _, lbGui = makeBoard(
		map,
		V(42, 30, 1),
		CFrame.lookAt(lbPos, Vector3.new(center.X, top + 16, center.Z + 10)),
		V(672, 480),
		C(40, 46, 66)
	)
	makeLabel(lbGui, "TOP 10 · MEILLEUR SCORE", UDim2.new(1, 0, 0, 56), UDim2.new(0, 0, 0, 8), 40, C(255, 214, 90))
	for i = 1, 10 do
		local row = makeLabel(
			lbGui,
			"",
			UDim2.new(1, -40, 0, 36),
			UDim2.new(0, 20, 0, 64 + (i - 1) * 40),
			28,
			C(235, 240, 255),
			Enum.Font.GothamMedium
		)
		row.TextXAlignment = Enum.TextXAlignment.Left
		boardRows[i] = row
	end
	boardRows[1].Text = "Chargement du classement..."

	-- statues du bestiaire sur piédestaux
	for index, def in ipairs(Species.List) do
		local x = center.X + (index - 4) * 19
		local z = center.Z - half + 14
		P(
			map,
			V(15, 3, 15),
			CFrame.new(x, top + 1.5, z),
			C(70, 76, 98),
			Enum.Material.Slate,
			{ name = "Pedestal", collide = true, shadow = true }
		)
		local model, root = CreatureService.BuildModel(def, 1)
		model.Name = "Statue_" .. def.id
		local y = top + 3 + (def.flying and 9 or def.rootY)
		root.CFrame = CFrame.lookAt(V(x, y, z), V(x, y, z + 1))
		model.Parent = map
		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.new(0, 160, 0, 36)
		tag.StudsOffset = V(0, 14, 0)
		tag.AlwaysOnTop = false
		tag.MaxDistance = 140
		tag.Adornee = root
		tag.Parent = root
		makeLabel(tag, def.name, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), 22, C(255, 255, 255))
	end
end

function MapBuilder.SetStatus(text)
	if statusLabel then
		statusLabel.Text = text
	end
end

local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	name = ok and name or ("Joueur " .. tostring(userId))
	nameCache[userId] = name
	return name
end

function MapBuilder.RefreshBoard()
	local top = DataService.GetTop(10)
	if not top then
		if boardRows[1] then
			boardRows[1].Text = "Classement indisponible"
		end
		return
	end
	for i = 1, 10 do
		local entry = top[i]
		if entry then
			boardRows[i].Text = ("%d. %s — %d"):format(i, nameFor(entry.userId), entry.score)
		else
			boardRows[i].Text = ("%d. —"):format(i)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Piste
-- ---------------------------------------------------------------------------

local function buildFloor(map)
	local finishZ = Config.Track.FinishZ
	for z = -400, finishZ + 400 - 100, 100 do
		local biome = Config.biomeAt(z + 50)
		P(
			map,
			V(200, 8, 100),
			CFrame.new(0, -4, z + 50),
			biome.ground,
			mat(biome.material),
			{ name = "Floor", collide = true }
		)
	end

	-- plaques de terrain pour casser l'uniformité
	for _ = 1, 280 do
		local z = -300 + rng:NextNumber() * (finishZ + 600)
		local biome = Config.biomeAt(z)
		local color = jitter(biome.ground, 34)
		P(
			map,
			V(14 + rng:NextNumber() * 22, 0.16, 14 + rng:NextNumber() * 22),
			CFrame.new((rng:NextNumber() * 2 - 1) * 78, 0.08, z) * yaw(rng:NextNumber() * 180),
			color,
			mat(biome.material),
			{ name = "Patch" }
		)
	end
end

local function buildCliffs(map)
	local finishZ = Config.Track.FinishZ
	for z = -400, finishZ + 420, 26 do
		local biome = Config.biomeAt(z)
		for _, side in ipairs({ -1, 1 }) do
			local w = 26 + rng:NextNumber() * 14
			local h = 30 + rng:NextNumber() * 46
			local x = side * (Config.Track.WallX + 4 + w / 2 + rng:NextNumber() * 6)
			P(
				map,
				V(w, h, 32 + rng:NextNumber() * 10),
				CFrame.new(x, h / 2 - 2, z + rng:NextNumber() * 8) * yaw(rng:NextNumber() * 20 - 10),
				jitter(biome.cliff, 30),
				mat(biome.cliffMaterial),
				{ name = "Cliff", collide = true, shadow = true }
			)
			-- deuxième rangée, plus haute
			local h2 = h + 20 + rng:NextNumber() * 30
			P(
				map,
				V(w + 14, h2, 34),
				CFrame.new(x + side * (w * 0.7), h2 / 2 - 2, z + rng:NextNumber() * 8) * yaw(rng:NextNumber() * 30 - 15),
				jitter(biome.cliff, 40),
				mat(biome.cliffMaterial),
				{ name = "CliffBack", collide = true, shadow = true }
			)
			if rng:NextNumber() < 0.25 then
				local hs = h + 10 + rng:NextNumber() * 20
				P(
					map,
					V(7, hs, 7),
					CFrame.new(side * (Config.Track.WallX + 2 + rng:NextNumber() * 6), hs / 2, z + 13)
						* yaw(rng:NextNumber() * 90),
					jitter(biome.cliff, 30),
					mat(biome.cliffMaterial),
					{ name = "Spire", collide = true, shadow = true }
				)
			end
		end
	end

	-- murs invisibles (la piste est un couloir)
	local length = finishZ + 1000
	local midZ = finishZ / 2 + 100
	for _, side in ipairs({ -1, 1 }) do
		P(
			map,
			V(4, 240, length),
			CFrame.new(side * (Config.Track.WallX + 2), 120, midZ),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "Barrier", collide = true, trans = 1 }
		)
	end
	P(
		map,
		V(200, 240, 4),
		CFrame.new(0, 120, -420),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "BarrierBack", collide = true, trans = 1 }
	)
	P(
		map,
		V(200, 240, 4),
		CFrame.new(0, 120, finishZ + 380),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "BarrierFront", collide = true, trans = 1 }
	)
end

-- ---------------------------------------------------------------------------
-- Décors par biome
-- ---------------------------------------------------------------------------

local emitterBudget = 14
local lightBudget = 8

local function acacia(map, x, z)
	local r = rng:NextNumber() * 360
	P(map, V(2, 10, 2), CFrame.new(x, 5, z) * yaw(r), C(110, 80, 50), Enum.Material.Wood, { name = "Trunk" })
	P(
		map,
		V(16, 3, 16),
		CFrame.new(x, 11.5, z) * yaw(r),
		jitter(C(94, 142, 62), 24),
		Enum.Material.Grass,
		{ name = "Canopy", shadow = true }
	)
	P(
		map,
		V(10, 2.5, 10),
		CFrame.new(x, 14, z) * yaw(r + 20),
		jitter(C(104, 154, 70), 24),
		Enum.Material.Grass,
		{ name = "Canopy" }
	)
end

local function boulder(map, x, z, color, material)
	local s = 4 + rng:NextNumber() * 5
	P(
		map,
		V(s * 1.3, s, s),
		CFrame.new(x, s / 2 - 0.3, z)
			* CFrame.Angles(rng:NextNumber() * 0.4, rng:NextNumber() * 6, rng:NextNumber() * 0.4),
		jitter(color, 26),
		material,
		{ name = "Boulder", shadow = true }
	)
end

local function bones(map, x, z)
	local r = rng:NextNumber() * 360
	local bone = C(238, 232, 214)
	P(map, V(1.4, 1.4, 9), CFrame.new(x, 0.7, z) * yaw(r), bone, Enum.Material.SmoothPlastic, { name = "Bone" })
	for i = -1, 1 do
		P(
			map,
			V(0.9, 5, 0.9),
			CFrame.new(x, 2.4, z) * yaw(r) * CFrame.new(i * 2.4, 0, 0) * CFrame.Angles(0, 0, 0.35 * i),
			bone,
			Enum.Material.SmoothPlastic,
			{ name = "Rib" }
		)
	end
end

local function cactus(map, x, z)
	local green = jitter(C(80, 140, 70), 20)
	local r = rng:NextNumber() * 360
	P(map, V(3, 12, 3), CFrame.new(x, 6, z) * yaw(r), green, Enum.Material.Grass, { name = "Cactus", shadow = true })
	P(
		map,
		V(5, 1.6, 1.6),
		CFrame.new(x, 6, z) * yaw(r) * CFrame.new(3.2, 0, 0),
		green,
		Enum.Material.Grass,
		{ name = "Arm" }
	)
	P(
		map,
		V(1.6, 4, 1.6),
		CFrame.new(x, 8, z) * yaw(r) * CFrame.new(5.2, 0, 0),
		green,
		Enum.Material.Grass,
		{ name = "Arm" }
	)
	if rng:NextNumber() < 0.5 then
		P(
			map,
			V(5, 1.6, 1.6),
			CFrame.new(x, 4.4, z) * yaw(r) * CFrame.new(-3.2, 0, 0),
			green,
			Enum.Material.Grass,
			{ name = "Arm" }
		)
		P(
			map,
			V(1.6, 3.4, 1.6),
			CFrame.new(x, 6.2, z) * yaw(r) * CFrame.new(-5.2, 0, 0),
			green,
			Enum.Material.Grass,
			{ name = "Arm" }
		)
	end
end

local function mesa(map, x, z, color)
	local h = 10 + rng:NextNumber() * 14
	local w = 10 + rng:NextNumber() * 8
	P(
		map,
		V(w, h, w * 0.9),
		CFrame.new(x, h / 2, z) * yaw(rng:NextNumber() * 90),
		jitter(color, 26),
		Enum.Material.Sandstone,
		{ name = "Mesa", shadow = true }
	)
	P(
		map,
		V(w * 0.7, 2.5, w * 0.6),
		CFrame.new(x, h + 1.2, z) * yaw(rng:NextNumber() * 90),
		jitter(color, 30),
		Enum.Material.Sandstone,
		{ name = "MesaTop" }
	)
end

local function pine(map, x, z)
	local r = rng:NextNumber() * 360
	P(map, V(2.4, 12, 2.4), CFrame.new(x, 6, z), C(96, 70, 46), Enum.Material.Wood, { name = "Trunk" })
	P(
		map,
		V(13, 3, 13),
		CFrame.new(x, 10, z) * yaw(r),
		jitter(C(40, 96, 54), 20),
		Enum.Material.Grass,
		{ name = "Leaves", shadow = true }
	)
	P(
		map,
		V(9.5, 3, 9.5),
		CFrame.new(x, 13, z) * yaw(r + 25),
		jitter(C(46, 108, 60), 20),
		Enum.Material.Grass,
		{ name = "Leaves" }
	)
	P(
		map,
		V(6, 3, 6),
		CFrame.new(x, 16, z) * yaw(r + 50),
		jitter(C(54, 120, 66), 20),
		Enum.Material.Grass,
		{ name = "Leaves" }
	)
	P(
		map,
		V(3, 3, 3),
		CFrame.new(x, 18.5, z) * yaw(r),
		jitter(C(60, 130, 70), 20),
		Enum.Material.Grass,
		{ name = "Leaves" }
	)
end

local function mushroom(map, x, z)
	local s = 0.8 + rng:NextNumber() * 0.8
	P(
		map,
		V(3 * s, 5 * s, 3 * s),
		CFrame.new(x, 2.5 * s, z),
		C(240, 232, 214),
		Enum.Material.SmoothPlastic,
		{ name = "Stem" }
	)
	P(
		map,
		V(9 * s, 4.2 * s, 9 * s),
		CFrame.new(x, 6.2 * s, z),
		C(204, 60, 64),
		Enum.Material.SmoothPlastic,
		{ name = "Cap", shape = "Ball", shadow = true }
	)
	P(
		map,
		V(1.6 * s, 0.6, 1.6 * s),
		CFrame.new(x + 1.5 * s, 8.2 * s, z + 0.5 * s),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "Dot" }
	)
end

local function obsidianSpike(map, x, z)
	local h = 10 + rng:NextNumber() * 14
	local w = 4 + rng:NextNumber() * 3
	P(
		map,
		V(w, h, w),
		CFrame.new(x, h / 2 - 0.5, z)
			* CFrame.Angles((rng:NextNumber() - 0.5) * 0.3, rng:NextNumber() * 6, (rng:NextNumber() - 0.5) * 0.3),
		jitter(C(34, 30, 38), 16),
		Enum.Material.Basalt,
		{ name = "Spike", shadow = true }
	)
end

local function lavaPool(map, x, z)
	local w = 8 + rng:NextNumber() * 8
	local pool = P(
		map,
		V(w, 0.3, w * 0.8),
		CFrame.new(x, 0.18, z) * yaw(rng:NextNumber() * 180),
		C(255, 100, 20),
		Enum.Material.Neon,
		{ name = "LavaPool" }
	)
	if emitterBudget > 0 and rng:NextNumber() < 0.25 then
		emitterBudget = emitterBudget - 1
		local att = Instance.new("Attachment")
		att.Parent = pool
		local em = Instance.new("ParticleEmitter")
		em.Rate = 8
		em.Lifetime = NumberRange.new(1.2, 2.2)
		em.Speed = NumberRange.new(6, 12)
		em.SpreadAngle = Vector2.new(20, 20)
		em.LightEmission = 1
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		em.Color = ColorSequence.new(C(255, 140, 40), C(255, 60, 20))
		em.Parent = att
	end
	if lightBudget > 0 and rng:NextNumber() < 0.15 then
		lightBudget = lightBudget - 1
		local light = Instance.new("PointLight")
		light.Color = C(255, 120, 40)
		light.Range = 30
		light.Brightness = 2
		light.Parent = pool
	end
end

local function crystals(map, x, z, color)
	local r = rng:NextNumber() * 360
	for i = 1, 3 + rng:NextInteger(0, 2) do
		local h = 4 + rng:NextNumber() * 9
		local ox, oz = (rng:NextNumber() - 0.5) * 6, (rng:NextNumber() - 0.5) * 6
		P(
			map,
			V(1.6 + rng:NextNumber(), h, 1.6 + rng:NextNumber()),
			CFrame.new(x + ox, h / 2 - 0.3, z + oz)
				* yaw(r + i * 40)
				* CFrame.Angles((rng:NextNumber() - 0.5) * 0.5, 0, (rng:NextNumber() - 0.5) * 0.5),
			jitter(color, 30),
			Enum.Material.Glass,
			{ name = "Crystal", shadow = true }
		)
	end
end

local function decorate(map, z, x)
	local biome = Config.biomeAt(z)
	local roll = rng:NextNumber()
	if biome.name == "SAVANE DORÉE" then
		if roll < 0.45 then
			acacia(map, x, z)
		elseif roll < 0.75 then
			boulder(map, x, z, C(150, 140, 126), Enum.Material.Rock)
		else
			bones(map, x, z)
		end
	elseif biome.name == "DÉSERT ROUGE" then
		if roll < 0.45 then
			cactus(map, x, z)
		elseif roll < 0.75 then
			mesa(map, x, z, C(200, 112, 70))
		elseif roll < 0.88 then
			bones(map, x, z)
		elseif roll < 0.94 then
			crystals(map, x, z, C(255, 150, 110))
		else
			boulder(map, x, z, C(196, 150, 110), Enum.Material.Sandstone)
		end
	elseif biome.name == "FORÊT GÉANTE" then
		if roll < 0.55 then
			pine(map, x, z)
		elseif roll < 0.85 then
			mushroom(map, x, z)
		elseif roll < 0.93 then
			crystals(map, x, z, C(120, 220, 190))
		else
			boulder(map, x, z, C(96, 108, 96), Enum.Material.Slate)
		end
	else
		if roll < 0.5 then
			obsidianSpike(map, x, z)
		elseif roll < 0.8 then
			lavaPool(map, x, z)
		else
			boulder(map, x, z, C(60, 52, 56), Enum.Material.Basalt)
		end
	end
end

local function buildProps(map)
	local finishZ = Config.Track.FinishZ
	for z = -300, finishZ + 260, 17 do
		for _, side in ipairs({ -1, 1 }) do
			if rng:NextNumber() < 0.75 then
				local x = side * (Config.Track.HalfWidth + 4 + rng:NextNumber() * 14)
				decorate(map, z + (rng:NextNumber() - 0.5) * 10, x)
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Portiques, départ, arrivée
-- ---------------------------------------------------------------------------

local function gate(map, z, text, color)
	local height = 46
	for _, side in ipairs({ -1, 1 }) do
		P(
			map,
			V(9, height, 9),
			CFrame.new(side * 72, height / 2, z),
			C(86, 92, 112),
			Enum.Material.Slate,
			{ name = "GatePillar", collide = true, shadow = true }
		)
	end
	local beam, gui = makeBoard(map, V(153, 12, 8), CFrame.new(0, height + 2, z), V(1530, 120), color)
	beam.Name = "GateBeam"
	beam.CanCollide = false
	beam.CanQuery = false
	makeLabel(gui, text, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), 100, C(255, 255, 255))
end

local function buildGates(map)
	local finishZ = Config.Track.FinishZ

	gate(map, 0, "DÉPART", C(46, 120, 70))
	P(map, V(180, 0.3, 4), CFrame.new(0, 0.2, 0), C(255, 255, 255), Enum.Material.SmoothPlastic, { name = "StartLine" })

	for i = 2, #Config.Biomes do
		local biome = Config.Biomes[i]
		gate(map, biome.from, biome.name, C(54, 62, 90))
	end

	gate(map, finishZ, "ARRIVÉE", C(160, 40, 50))
	-- damier d'arrivée
	for col = 0, 29 do
		for row = 0, 1 do
			local dark = (col + row) % 2 == 0
			P(
				map,
				V(6, 0.3, 3),
				CFrame.new(-87 + col * 6 + 3, 0.2, finishZ - 1.5 + row * 3),
				dark and C(20, 20, 20) or C(255, 255, 255),
				Enum.Material.SmoothPlastic,
				{ name = "FinishChecker" }
			)
		end
	end

	-- confettis à l'arrivée
	for _, side in ipairs({ -1, 1 }) do
		local anchor = P(
			map,
			V(1, 1, 1),
			CFrame.new(side * 72, 48, finishZ + 4),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "ConfettiAnchor", trans = 1 }
		)
		local att = Instance.new("Attachment")
		att.Parent = anchor
		local em = Instance.new("ParticleEmitter")
		em.Rate = 20
		em.Lifetime = NumberRange.new(2.5, 4)
		em.Speed = NumberRange.new(14, 26)
		em.SpreadAngle = Vector2.new(40, 40)
		em.Acceleration = V(0, -30, 0)
		em.LightEmission = 0.5
		em.Size = NumberSequence.new(0.9)
		em.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C(255, 90, 120)),
			ColorSequenceKeypoint.new(0.5, C(255, 220, 80)),
			ColorSequenceKeypoint.new(1, C(100, 220, 255)),
		})
		em.Parent = att
	end

	-- podium
	local podiumZ = finishZ + 120
	P(
		map,
		V(18, 12, 18),
		CFrame.new(0, 6, podiumZ),
		C(255, 205, 60),
		Enum.Material.Metal,
		{ name = "Podium1", collide = true, shadow = true }
	)
	P(
		map,
		V(18, 8, 18),
		CFrame.new(-20, 4, podiumZ),
		C(200, 204, 214),
		Enum.Material.Metal,
		{ name = "Podium2", collide = true, shadow = true }
	)
	P(
		map,
		V(18, 5, 18),
		CFrame.new(20, 2.5, podiumZ),
		C(190, 120, 70),
		Enum.Material.Metal,
		{ name = "Podium3", collide = true, shadow = true }
	)
end

-- ---------------------------------------------------------------------------
-- Mur de lave
-- ---------------------------------------------------------------------------

local function buildWall()
	local model = Instance.new("Model")
	model.Name = "LavaWall"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(176, 70, 16)
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.Material = Enum.Material.Neon
	root.Color = C(255, 90, 20)
	root.CFrame = CFrame.new(0, 35, Config.Wall.StartZ - 8)
	root.Parent = model
	model.PrimaryPart = root

	for i = 1, 22 do
		local s = 10 + rng:NextNumber() * 12
		local ball = Instance.new("Part")
		ball.Name = "Boulder"
		ball.Shape = Enum.PartType.Ball
		ball.Size = V(s, s, s)
		ball.Anchored = false
		ball.CanCollide = false
		ball.CanTouch = false
		ball.CanQuery = false
		ball.Massless = true
		ball.CastShadow = false
		local hot = i % 3 == 0
		ball.Material = hot and Enum.Material.Neon or Enum.Material.Basalt
		ball.Color = hot and C(255, 150, 40) or C(46, 34, 34)
		local lx = (rng:NextNumber() * 2 - 1) * 84
		local ly = -28 + rng:NextNumber() * 66
		ball.CFrame = root.CFrame * CFrame.new(lx, ly, -6 - rng:NextNumber() * 4)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = ball
		weld.Parent = ball
		ball.Parent = model
	end

	local top = Instance.new("Attachment")
	top.Position = V(0, 36, -8)
	top.Parent = root
	local fire = Instance.new("ParticleEmitter")
	fire.Name = "Flames"
	fire.Rate = 70
	fire.Lifetime = NumberRange.new(0.8, 1.6)
	fire.Speed = NumberRange.new(18, 30)
	fire.SpreadAngle = Vector2.new(25, 25)
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 0) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	fire.Color = ColorSequence.new(C(255, 170, 50), C(255, 60, 20))
	fire.EmissionDirection = Enum.NormalId.Top
	fire.Parent = top

	local light = Instance.new("PointLight")
	light.Color = C(255, 120, 40)
	light.Range = 70
	light.Brightness = 3
	light.Parent = root

	model.Parent = workspace
	return root
end

-- ---------------------------------------------------------------------------
-- Point d'entrée
-- ---------------------------------------------------------------------------

-- Renvoie la pièce racine du mur de lave.
function MapBuilder.Build()
	MapBuilder.SetupLighting()

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	local creatures = Instance.new("Folder")
	creatures.Name = "Creatures"
	creatures.Parent = workspace
	State.CreaturesFolder = creatures

	local fx = Instance.new("Folder")
	fx.Name = "Fx"
	fx.Parent = workspace
	State.FxFolder = fx

	buildLobby(map)
	task.wait()
	buildFloor(map)
	task.wait()
	buildCliffs(map)
	task.wait()
	buildProps(map)
	task.wait()
	buildGates(map)
	task.wait()
	return buildWall()
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- Achats Robux : pass de jeu (permanents) et produits développeur (paquets de pièces).
-- Aucun achat n'est accordé sans reçu valide ; chaque reçu est enregistré (idempotent) avant d'être validé.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)

local MonetizationService = {}

local M = Config.Monetization

local function passById(id)
	for _, def in ipairs(M.GamePasses) do
		if def.id ~= 0 and def.id == id then
			return def
		end
	end
	return nil
end

local function productById(id)
	for _, def in ipairs(M.Products) do
		if def.id ~= 0 and def.id == id then
			return def
		end
	end
	return nil
end

local function grantPass(player, def)
	if ProgressService.HasPass(player, def.key) then
		return
	end
	player:SetAttribute("Pass_" .. def.key, true)
	ProgressService.RefreshAttributes(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	Remotes.Feedback:FireClient(player, { kind = "tame", title = "MERCI !", sub = def.name .. " activé" })
end

-- Vérifie les pass possédés (appelé à l'arrivée du joueur ; peut patienter sur le réseau).
function MonetizationService.LoadPasses(player)
	for _, def in ipairs(M.GamePasses) do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns and player.Parent then
				player:SetAttribute("Pass_" .. def.key, true)
			end
		end
	end
	ProgressService.RefreshAttributes(player)
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data or not DataService.IsPersistent(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById(info.ProductId)
	if not product then
		warn("[Achats] Produit inconnu : " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.receipts = data.receipts or {}
	local rid = tostring(info.PurchaseId)
	if data.receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	data.coins = data.coins + product.coins
	data.receipts[rid] = os.time()
	-- on ne garde que les 60 reçus les plus récents
	local ids = {}
	for key in pairs(data.receipts) do
		table.insert(ids, key)
	end
	if #ids > 60 then
		table.sort(ids, function(a, b)
			return data.receipts[a] < data.receipts[b]
		end)
		for i = 1, #ids - 60 do
			data.receipts[ids[i]] = nil
		end
	end
	DataService.MarkDirty(player)

	if not DataService.Save(player) then
		-- sauvegarde impossible : on annule et Roblox réessaiera plus tard
		data.coins = data.coins - product.coins
		data.receipts[rid] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	Remotes.Feedback:FireClient(
		player,
		{ kind = "tame", title = "MERCI !", sub = ("+%d pièces"):format(product.coins) }
	)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function loadPrices()
	for _, def in ipairs(M.GamePasses) do
		local entry = { key = def.key, name = def.name, desc = def.desc, available = def.id ~= 0 }
		table.insert(ProgressService.Store.passes, entry)
		if def.id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.GamePass)
				end)
				if ok and info then
					entry.price = info.PriceInRobux
				end
			end)
		end
	end
	for _, def in ipairs(M.Products) do
		local entry = { key = def.key, name = def.name, coins = def.coins, available = def.id ~= 0 }
		table.insert(ProgressService.Store.products, entry)
		if def.id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.Product)
				end)
				if ok and info then
					entry.price = info.PriceInRobux
				end
			end)
		end
	end
end

function MonetizationService.Init()
	loadPrices()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		local def = passById(passId)
		if def and wasPurchased then
			grantPass(player, def)
		end
	end)

	Remotes.Prompt.OnServerEvent:Connect(function(player, kind, key)
		if type(kind) ~= "string" or type(key) ~= "string" or not Util.allow(player, "Prompt", 1) then
			return
		end
		if kind == "pass" then
			for _, def in ipairs(M.GamePasses) do
				if def.key == key and def.id ~= 0 and not ProgressService.HasPass(player, key) then
					MarketplaceService:PromptGamePassPurchase(player, def.id)
				end
			end
		elseif kind == "product" then
			for _, def in ipairs(M.Products) do
				if def.key == key and def.id ~= 0 then
					MarketplaceService:PromptProductPurchase(player, def.id)
				end
			end
		end
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[-- Progression : pièces, boutique, améliorations, bestiaire, quêtes quotidiennes, cadeau du jour.
-- Toutes les décisions sont prises ici (serveur) ; le client ne fait que demander.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Cosmetics = require(script.Parent.Cosmetics)

local ProgressService = {}

-- Informations de la boutique Robux (remplies par MonetizationService : prix lus sur Roblox).
ProgressService.Store = { passes = {}, products = {} }

function ProgressService.HasPass(player, key)
	return player:GetAttribute("Pass_" .. key) == true
end

function ProgressService.CoinMultiplier(player)
	return ProgressService.HasPass(player, "double") and 2 or 1
end

local pushScheduled = {}

local function today()
	return math.floor(os.time() / 86400)
end

local function questDef(id)
	return Config.findById(Config.QuestPool, id)
end

-- ---------------------------------------------------------------------------
-- Snapshot envoyé au client
-- ---------------------------------------------------------------------------

function ProgressService.Snapshot(player)
	local data = DataService.Get(player)
	if not data then
		return { loaded = false }
	end

	local quests = {}
	for index, q in ipairs(data.quests.list) do
		local def = questDef(q.id)
		if def then
			quests[index] = {
				id = q.id,
				label = string.format(def.label, def.target),
				progress = math.min(q.progress, def.target),
				target = def.target,
				reward = def.reward,
				claimed = q.claimed,
			}
		end
	end

	local streak = data.daily.streak
	local claimable = data.daily.last ~= today()
	local nextStreak = streak
	if claimable then
		nextStreak = (data.daily.last == today() - 1) and (streak + 1) or 1
	end
	local rewardStreak = math.min(nextStreak, Config.DailyReward.MaxStreak)

	local hats = {}
	for id in pairs(data.owned.hats) do
		hats[id] = true
	end
	for _, def in ipairs(Config.Hats) do
		if def.pass and ProgressService.HasPass(player, def.pass) then
			hats[def.id] = true
		end
	end
	local passes = {}
	for _, def in ipairs(Config.Monetization.GamePasses) do
		passes[def.key] = ProgressService.HasPass(player, def.key)
	end

	return {
		loaded = true,
		passes = passes,
		store = ProgressService.Store,
		persistent = DataService.IsPersistent(player),
		coins = data.coins,
		bestScore = data.bestScore,
		wins = data.wins,
		rounds = data.rounds,
		hooks = data.hooks,
		tamedTotal = data.tamedTotal,
		distance = math.floor(data.distance),
		tamed = data.tamed,
		completed = data.completed,
		upgrades = data.upgrades,
		owned = { hats = hats, ropes = data.owned.ropes },
		equipped = data.equipped,
		daily = {
			claimable = claimable,
			streak = streak,
			reward = Config.DailyReward.Base + Config.DailyReward.PerStreak * (rewardStreak - 1),
		},
		quests = quests,
	}
end

function ProgressService.Push(player)
	if pushScheduled[player] then
		return
	end
	pushScheduled[player] = true
	task.delay(0.15, function()
		pushScheduled[player] = nil
		if player.Parent then
			Remotes.Data:FireClient(player, ProgressService.Snapshot(player))
		end
	end)
end

function ProgressService.RefreshAttributes(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local range = Config.Ride.HookBaseRange + Config.Ride.HookRangePerLevel * data.upgrades.range
	if ProgressService.HasPass(player, "rope") then
		range = range + Config.Monetization.RopeBonus
	end
	player:SetAttribute("HookRange", range)
	player:SetAttribute("Coins", data.coins)
end

-- ---------------------------------------------------------------------------
-- Quêtes
-- ---------------------------------------------------------------------------

function ProgressService.EnsureDaily(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local day = today()
	if data.quests.day == day and #data.quests.list > 0 then
		return
	end
	local rng = Random.new(day)
	local pool = {}
	for _, def in ipairs(Config.QuestPool) do
		table.insert(pool, def)
	end
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local list = {}
	for i = 1, 3 do
		list[i] = { id = pool[i].id, progress = 0, claimed = false }
	end
	data.quests = { day = day, list = list }
	DataService.MarkDirty(player)
end

function ProgressService.AddQuest(player, id, amount)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local def = questDef(id)
	for _, q in ipairs(data.quests.list) do
		if q.id == id and def and not q.claimed then
			if def.mode == "max" then
				if amount > q.progress then
					q.progress = amount
				end
			else
				q.progress = q.progress + amount
			end
		end
	end
	DataService.MarkDirty(player)
	ProgressService.Push(player)
end

-- ---------------------------------------------------------------------------
-- Pièces et dressage
-- ---------------------------------------------------------------------------

function ProgressService.AddCoins(player, amount)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	data.coins = data.coins + math.floor(amount)
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
end

-- Enregistre un dressage. Renvoie { first = bool, complete = bool, coins = number }.
function ProgressService.RecordTame(player, def, variantIdx)
	local data = DataService.Get(player)
	local result = { first = false, complete = false, coins = 0 }
	if not data then
		return result
	end
	local variant = Config.Variants[variantIdx]
	local key = def.id .. "_" .. variantIdx
	result.first = (data.tamed[key] or 0) == 0
	data.tamed[key] = (data.tamed[key] or 0) + 1
	data.tamedTotal = data.tamedTotal + 1

	local coins = Config.Rewards.TameCoins * def.value * variant.mult
	if result.first then
		coins = coins + Config.Rewards.NewDiscovery
	end

	if not data.completed[def.id] then
		local all = true
		for v = 1, #Config.Variants do
			if (data.tamed[def.id .. "_" .. v] or 0) == 0 then
				all = false
				break
			end
		end
		if all then
			data.completed[def.id] = true
			result.complete = true
			coins = coins + Config.Rewards.SpeciesComplete
		end
	end

	result.coins = math.floor(coins * ProgressService.CoinMultiplier(player))
	data.coins = data.coins + result.coins
	DataService.MarkDirty(player)

	ProgressService.AddQuest(player, "tame", 1)
	if variantIdx > 1 then
		ProgressService.AddQuest(player, "rare", 1)
	end
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return result
end

function ProgressService.GetRopeStyle(player)
	local data = DataService.Get(player)
	local rope = data and Config.findById(Config.Ropes, data.equipped.rope)
	rope = rope or Config.Ropes[1]
	return rope.color, rope.neon
end

function ProgressService.GetUpgradeLevel(player, id)
	local data = DataService.Get(player)
	return data and data.upgrades[id] or 0
end

function ProgressService.ApplyCosmetics(player)
	local data = DataService.Get(player)
	local character = player.Character
	if data and character then
		Cosmetics.applyHat(character, data.equipped.hat)
	end
end

-- ---------------------------------------------------------------------------
-- Actions demandées par le client (RemoteFunctions)
-- ---------------------------------------------------------------------------

local function result(ok, message)
	return { ok = ok, msg = message }
end

local function handleBuy(player, kind, id)
	if not Util.allow(player, "Buy", 0.25) then
		return result(false, "Trop rapide.")
	end
	if type(kind) ~= "string" or type(id) ~= "string" then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end

	if kind == "upgrade" then
		local def = Config.findById(Config.Upgrades, id)
		if not def then
			return result(false, "Amélioration inconnue.")
		end
		local level = data.upgrades[id] or 0
		if level >= def.max then
			return result(false, "Niveau maximum atteint.")
		end
		local price = def.costs[level + 1]
		if data.coins < price then
			return result(false, "Pas assez de pièces.")
		end
		data.coins = data.coins - price
		data.upgrades[id] = level + 1
	elseif kind == "hat" or kind == "rope" then
		local list = kind == "hat" and Config.Hats or Config.Ropes
		local ownedSet = kind == "hat" and data.owned.hats or data.owned.ropes
		local def = Config.findById(list, id)
		if not def then
			return result(false, "Objet inconnu.")
		end
		if def.pass then
			return result(false, "Cet objet est réservé au pass " .. def.pass:upper() .. ".")
		end
		if ownedSet[id] then
			return result(false, "Déjà possédé.")
		end
		if data.coins < def.price then
			return result(false, "Pas assez de pièces.")
		end
		data.coins = data.coins - def.price
		ownedSet[id] = true
		-- équipement automatique à l'achat
		if kind == "hat" then
			data.equipped.hat = id
		else
			data.equipped.rope = id
		end
	else
		return result(false, "Type inconnu.")
	end

	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	return result(true, "Achat réussi !")
end

local function handleEquip(player, kind, id)
	if not Util.allow(player, "Equip", 0.25) then
		return result(false, "Trop rapide.")
	end
	if type(kind) ~= "string" or type(id) ~= "string" then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end
	local hatDef = kind == "hat" and Config.findById(Config.Hats, id) or nil
	if
		kind == "hat"
		and (data.owned.hats[id] or (hatDef and hatDef.pass and ProgressService.HasPass(player, hatDef.pass)))
	then
		data.equipped.hat = id
	elseif kind == "rope" and data.owned.ropes[id] then
		data.equipped.rope = id
	else
		return result(false, "Tu ne possèdes pas cet objet.")
	end
	DataService.MarkDirty(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	return result(true, "Équipé.")
end

local function handleDaily(player)
	if not Util.allow(player, "Daily", 0.5) then
		return result(false, "Trop rapide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end
	local day = today()
	if data.daily.last == day then
		return result(false, "Déjà récupéré aujourd'hui.")
	end
	if data.daily.last == day - 1 then
		data.daily.streak = data.daily.streak + 1
	else
		data.daily.streak = 1
	end
	data.daily.last = day
	local streak = math.min(data.daily.streak, Config.DailyReward.MaxStreak)
	local reward = Config.DailyReward.Base + Config.DailyReward.PerStreak * (streak - 1)
	data.coins = data.coins + reward
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return result(true, ("+%d pièces (série de %d jour(s))"):format(reward, data.daily.streak))
end

local function handleQuest(player, index)
	if not Util.allow(player, "Quest", 0.3) then
		return result(false, "Trop rapide.")
	end
	if type(index) ~= "number" or index % 1 ~= 0 then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	local q = data and data.quests.list[index]
	if not q then
		return result(false, "Quête introuvable.")
	end
	local def = questDef(q.id)
	if not def then
		return result(false, "Quête inconnue.")
	end
	if q.claimed then
		return result(false, "Déjà récupérée.")
	end
	if q.progress < def.target then
		return result(false, "Quête non terminée.")
	end
	q.claimed = true
	data.coins = data.coins + def.reward
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return result(true, ("+%d pièces"):format(def.reward))
end

function ProgressService.Init()
	Remotes.Buy.OnServerInvoke = handleBuy
	Remotes.Equip.OnServerInvoke = handleEquip
	Remotes.ClaimDaily.OnServerInvoke = handleDaily
	Remotes.ClaimQuest.OnServerInvoke = handleQuest

	Players.PlayerRemoving:Connect(function(player)
		pushScheduled[player] = nil
		Util.forget(player)
	end)
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">RideService</string><ProtectedString name="Source"><![CDATA[-- Cœur du gameplay : monter une bête, bondir, lasso, dressage, chute, élimination, arrivée.
-- Le serveur est autoritaire : positions des bêtes, portée du lasso, score et états sont validés ici.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local State = require(script.Parent.State)
local CreatureService = require(script.Parent.CreatureService)
local ProgressService = require(script.Parent.ProgressService)
local Fx = require(script.Parent.Fx)

local RideService = {}

local rng = Random.new()

-- ---------------------------------------------------------------------------
-- Utilitaires
-- ---------------------------------------------------------------------------

local function getParts(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return nil
	end
	return char, hrp, hum
end

local function setStatus(player, run, status)
	run.status = status
	Remotes.Status:FireClient(player, status)
end

local function feedback(player, kind, title, sub)
	Remotes.Feedback:FireClient(player, { kind = kind, title = title, sub = sub })
end

local function comboMult(run)
	return 1 + math.min(run.combo, Config.Ride.ComboMax) * Config.Ride.ComboStep
end

local function comboWindow(player)
	return Config.Ride.ComboWindowBase
		+ Config.Ride.ComboWindowPerLevel * ProgressService.GetUpgradeLevel(player, "combo")
end

local function setDust(creature, enabled)
	local attachment = creature.root:FindFirstChild("DustAttachment")
	local dust = attachment and attachment:FindFirstChild("Dust")
	if dust then
		dust.Enabled = enabled
	end
end

local function addScore(run, amount)
	run.score = run.score + amount
end

function RideService.NewRun()
	return {
		status = "Riding",
		score = 0,
		combo = 0,
		maxCombo = 0,
		lastHookT = 0,
		hooks = 0,
		tames = 0,
		distance = 0,
		bestZ = 0,
		z = 0,
		creature = nil,
		weld = nil,
		mountT = 0,
		tameT = 0,
		airStart = 0,
		lastCreature = nil,
		lastCreatureUntil = 0,
		downUntil = 0,
		pubT = 0,
		finishPlace = 0,
		coins = 0,
		rank = 0,
	}
end

function RideService.ToLobby(player)
	local char = player.Character
	if not char then
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hrp then
		hrp.Anchored = false
		local old = hrp:FindFirstChild("RideWeld")
		if old then
			old:Destroy()
		end
	end
	if hum then
		hum.Sit = false
	end
	local offset = CFrame.new((rng:NextNumber() - 0.5) * 70, 4, (rng:NextNumber() - 0.5) * 70)
	char:PivotTo(State.LobbyCFrame * offset)
end

-- ---------------------------------------------------------------------------
-- Monter / quitter une bête
-- ---------------------------------------------------------------------------

function RideService.Detach(run)
	if run.weld then
		run.weld:Destroy()
		run.weld = nil
	end
	local creature = run.creature
	if creature then
		creature.rider = nil
		creature.steer = 0
		creature.angry = false
		if not creature.removed then
			creature.model:SetAttribute("Ridden", false)
			creature.model:SetAttribute("Angry", false)
			setDust(creature, false)
		end
		run.creature = nil
	end
end

function RideService.Mount(player, run, creature)
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	RideService.Detach(run)

	creature.rider = player
	creature.steer = 0
	creature.angry = false
	run.creature = creature
	run.mountT = 0
	run.tameT = 0

	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	hrp.CFrame = CreatureService.SeatWorldCFrame(creature)

	local weld = Instance.new("WeldConstraint")
	weld.Name = "RideWeld"
	weld.Part0 = creature.root
	weld.Part1 = hrp
	weld.Parent = hrp
	run.weld = weld

	hum.Sit = true
	creature.model:SetAttribute("Ridden", true)
	setDust(creature, true)

	local label = creature.def.name
	if creature.variantIdx > 1 then
		label = label .. " " .. creature.variant.name
	end
	player:SetAttribute("RideName", label)
	player:SetAttribute("TameProgress", 0)

	setStatus(player, run, "Riding")
	return true
end

-- Quitte la monture avec une vitesse donnée (bond, geyser, désarçonnement).
-- Traînée colorée derrière le cavalier pendant le vol (couleur de sa corde).
function RideService.AddTrail(player, hrp)
	local old = hrp:FindFirstChild("FlightTrail")
	if old then
		old:Destroy()
	end
	local color = ProgressService.GetRopeStyle(player)
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA0"
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailA1"
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "FlightTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.Lifetime = 0.45
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = hrp
	Debris:AddItem(trail, 2.2)
	Debris:AddItem(a0, 2.2)
	Debris:AddItem(a1, 2.2)
end

local function launch(player, run, velocity)
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	-- la bête qu'on vient de quitter ne peut pas être relassoée aussitôt (sinon le bond ne sert à rien)
	run.lastCreature = run.creature
	run.lastCreatureUntil = os.clock() + 1.0
	RideService.Detach(run)
	hum.Sit = false
	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = velocity
	pcall(function()
		hrp:SetNetworkOwner(player)
	end)
	run.airStart = os.clock()
	player:SetAttribute("TameProgress", 0)
	RideService.AddTrail(player, hrp)
	setStatus(player, run, "Air")
	Remotes.Launched:FireClient(player, velocity)
	return true
end

function RideService.Boost(player, velocity)
	local run = State.Participants[player]
	if not run then
		return false
	end
	local s = run.status
	if s ~= "Riding" and s ~= "Air" and s ~= "Down" then
		return false
	end
	return launch(player, run, velocity)
end

local function downPlayer(player, run, title, sub)
	run.combo = 0
	run.downUntil = os.clock() + Config.Ride.DownTime
	local _, hrp = getParts(player)
	if hrp then
		hrp.Anchored = false
	end
	player:SetAttribute("TameProgress", 0)
	if hrp then
		Fx.burst(hrp.Position - Vector3.new(0, 2, 0), Color3.fromRGB(214, 190, 150), 18, 18)
	end
	setStatus(player, run, "Down")
	feedback(player, "down", title or "RATÉ !", sub or "Rattrape une bête qui passe !")
end

-- Projette un joueur au sol (météore).
function RideService.Knock(player)
	local run = State.Participants[player]
	if not run then
		return false
	end
	local s = run.status
	if s ~= "Riding" and s ~= "Air" and s ~= "Down" then
		return false
	end
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	RideService.Detach(run)
	hum.Sit = false
	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = Vector3.new((rng:NextNumber() - 0.5) * 40, 45, 0)
	pcall(function()
		hrp:SetNetworkOwner(player)
	end)
	downPlayer(player, run, "TOUCHÉ !", "Un météore t'a éjecté !")
	return true
end

local function rescue(player, run)
	local _, hrp = getParts(player)
	if not hrp then
		return
	end
	local pos = hrp.Position
	local creature = CreatureService.FindRescue(pos.X, pos.Z)
	if not creature then
		local x = math.clamp(pos.X, -Config.Track.HalfWidth + 8, Config.Track.HalfWidth - 8)
		creature = CreatureService.Spawn(x, math.max(pos.Z, State.WallZ + 30) + 14, "boar", 1, 1)
	end
	RideService.Mount(player, run, creature)
end

-- ---------------------------------------------------------------------------
-- Combo, dressage
-- ---------------------------------------------------------------------------

local function onHookSuccess(player, run, creature, distance)
	local now = os.clock()
	if run.combo > 0 and now - run.lastHookT > comboWindow(player) then
		run.combo = 0
	end
	run.combo = run.combo + 1
	run.maxCombo = math.max(run.maxCombo, run.combo)
	run.lastHookT = now
	run.hooks = run.hooks + 1

	local mult = comboMult(run)
	local points = Config.Score.HookBonus * mult
	local title = "LASSO !"
	if distance >= Config.Score.LongHookDistance then
		points = points + Config.Score.LongHookBonus
		title = "LONG LASSO !"
	end
	addScore(run, points)

	local sub = ("+%d"):format(math.floor(points))
	if run.combo >= 2 then
		sub = sub .. (" · COMBO x%.1f"):format(mult)
	end
	feedback(player, "hook", title, sub)
end

local function tameTimeNeeded(player, creature)
	local level = ProgressService.GetUpgradeLevel(player, "taming")
	local factor = 1 - Config.Tame.PerLevel * level
	return math.max(Config.Tame.MinTime, creature.def.tameTime * factor)
end

local function doTame(player, run, creature)
	creature.tamed = true
	run.tames = run.tames + 1
	local points = Config.Score.TameBase * creature.def.value * creature.variant.mult
	addScore(run, points)
	local result = ProgressService.RecordTame(player, creature.def, creature.variantIdx)
	run.coins = run.coins + result.coins

	local name = creature.def.name
	if creature.variantIdx > 1 then
		name = name .. " " .. creature.variant.name
	end
	local sub = ("%s · +%d pts · +%d pièces"):format(name, math.floor(points), result.coins)
	if result.complete then
		sub = sub .. " · ESPÈCE COMPLÈTE !"
	elseif result.first then
		sub = sub .. " · NOUVELLE DÉCOUVERTE"
	end
	feedback(player, "tame", "DOMPTÉ !", sub)
	Fx.burst(creature.root.Position + Vector3.new(0, 4, 0), Color3.fromRGB(255, 220, 90), 40, 30)
end

-- ---------------------------------------------------------------------------
-- Remotes
-- ---------------------------------------------------------------------------

function RideService.HandleLaunch(player)
	if State.Phase ~= "Running" then
		return
	end
	local run = State.Participants[player]
	if not run or run.status ~= "Riding" or not run.creature then
		return
	end
	if not Util.allow(player, "Launch", 0.15) then
		return
	end
	local c = run.creature
	local velocity = Vector3.new(c.vx, Config.Ride.LaunchUp, c.speed + Config.Ride.LaunchBoost)
	launch(player, run, velocity)
end

function RideService.HandleSteer(player, value)
	if not Util.isFiniteNumber(value) or not Util.allow(player, "Steer", 0.04) then
		return
	end
	local run = State.Participants[player]
	if not run or run.status ~= "Riding" or not run.creature then
		return
	end
	run.creature.steer = math.clamp(value, -1, 1)
end

local function spawnRope(player, hrp, creature, duration)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) or hrp
	local color, neon = ProgressService.GetRopeStyle(player)

	local a0 = Instance.new("Attachment")
	a0.Parent = hand
	local a1 = Instance.new("Attachment")
	a1.Position = creature.seat.Position
	a1.Parent = creature.root

	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = 0.4
	beam.Width1 = 0.4
	beam.FaceCamera = true
	beam.Segments = 8
	beam.LightEmission = neon and 1 or 0
	beam.Parent = hand

	local life = duration + 0.25
	Debris:AddItem(beam, life)
	Debris:AddItem(a0, life)
	Debris:AddItem(a1, life)
end

function RideService.HandleHook(player, id)
	if not Util.isFiniteNumber(id) or id % 1 ~= 0 or State.Phase ~= "Running" then
		return
	end
	local run = State.Participants[player]
	if not run or (run.status ~= "Air" and run.status ~= "Down") then
		return
	end
	if not Util.allow(player, "Hook", Config.Ride.HookCooldown) then
		return
	end
	local creature = State.Creatures[id]
	if not creature or creature.removed or creature.rider then
		return
	end
	local _, hrp = getParts(player)
	if not hrp then
		return
	end

	local seatCF = CreatureService.SeatWorldCFrame(creature)
	local delta = seatCF.Position - hrp.Position
	local range = (player:GetAttribute("HookRange") or Config.Ride.HookBaseRange) + Config.Ride.HookTolerance
	if delta.Magnitude > range then
		return
	end
	-- en l'air : la bête doit être devant (marge de latence) ; au sol : elle peut passer à côté
	local minDz = run.status == "Air" and -4 or -25
	if delta.Z < minDz then
		return
	end
	if creature == run.lastCreature and os.clock() < (run.lastCreatureUntil or 0) then
		return
	end

	-- Réserver la bête immédiatement : personne d'autre ne peut la lasso.
	creature.rider = player
	run.status = "Hooking"
	Remotes.Status:FireClient(player, "Hooking")
	hrp.Anchored = true -- le serveur déplace le joueur pendant l'attraction (mouvement fluide, sans conflit)

	local distance = delta.Magnitude
	local duration = math.clamp(distance / 200, 0.08, 0.3)
	spawnRope(player, hrp, creature, duration)

	task.spawn(function()
		local startCF = hrp.CFrame
		local t0 = os.clock()
		local aborted = false
		while true do
			local alpha = (os.clock() - t0) / duration
			if alpha >= 1 then
				break
			end
			if run.status ~= "Hooking" or not hrp.Parent or creature.removed then
				aborted = true
				break
			end
			local target = CreatureService.SeatWorldCFrame(creature)
			local eased = alpha * alpha * (3 - 2 * alpha)
			hrp.CFrame = startCF:Lerp(target, eased)
			RunService.Heartbeat:Wait()
		end

		if not aborted and (run.status ~= "Hooking" or not hrp.Parent or creature.removed) then
			aborted = true
		end

		if aborted then
			if creature.rider == player then
				creature.rider = nil
			end
			if hrp.Parent then
				hrp.Anchored = false
			end
			-- Si le joueur est toujours en jeu (la bête a disparu), il tombe.
			if run.status == "Hooking" and player.Parent then
				downPlayer(player, run)
			end
			return
		end

		if RideService.Mount(player, run, creature) then
			onHookSuccess(player, run, creature, distance)
		else
			creature.rider = nil
			downPlayer(player, run)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- Fin de course d'un joueur
-- ---------------------------------------------------------------------------

function RideService.Eliminate(player, run, reason)
	if run.status == "Out" or run.status == "Finished" then
		return
	end
	RideService.Detach(run)
	run.status = "Out"
	Remotes.Status:FireClient(player, "Out")
	player:SetAttribute("TameProgress", 0)
	feedback(player, "out", "ÉLIMINÉ", reason or "Tu es hors course.")
	RideService.ToLobby(player)
end

local function finish(player, run)
	State.FinishCount = State.FinishCount + 1
	local place = State.FinishCount
	run.finishPlace = place
	local bonus = Config.Score.Finish[place] or Config.Score.FinishOther
	addScore(run, bonus)
	RideService.Detach(run)
	run.status = "Finished"
	Remotes.Status:FireClient(player, "Finished")
	player:SetAttribute("TameProgress", 0)
	feedback(player, "finish", "ARRIVÉE !", ("%de · +%d pts"):format(place, bonus))
	local char, hrp, hum = getParts(player)
	if char then
		hrp.Anchored = false
		hum.Sit = false
		char:PivotTo(State.FinishCFrame * CFrame.new((rng:NextNumber() - 0.5) * 80, 0, (rng:NextNumber() - 0.5) * 40))
	end
end

-- ---------------------------------------------------------------------------
-- Boucle principale (appelée à chaque Heartbeat pendant la manche)
-- ---------------------------------------------------------------------------

local function publish(player, run, now)
	player:SetAttribute("RunScore", math.floor(run.score))
	player:SetAttribute("Combo", run.combo)
	local left = 0
	if run.combo > 0 then
		left = math.clamp(1 - (now - run.lastHookT) / comboWindow(player), 0, 1)
	end
	player:SetAttribute("ComboLeft", math.floor(left * 20) / 20)
	player:SetAttribute("ComboMult", math.floor(comboMult(run) * 10) / 10)
	local c = run.creature
	if c and run.status == "Riding" and not c.tamed then
		local needed = tameTimeNeeded(player, c)
		player:SetAttribute("TameProgress", math.floor(math.clamp(run.tameT / needed, 0, 1) * 20) / 20)
	elseif c and c.tamed then
		player:SetAttribute("TameProgress", 1)
	end
end

local function stepRiding(player, run, hum, hrp, dt, now)
	local c = run.creature
	if not c or c.removed or c.rider ~= player then
		downPlayer(player, run)
		return
	end
	run.mountT = run.mountT + dt

	local rate = Config.Score.RidePerSecond * c.def.value * c.variant.mult * comboMult(run)
	addScore(run, rate * dt)

	if run.combo > 0 and now - run.lastHookT > comboWindow(player) then
		run.combo = 0
	end

	if not c.tamed then
		run.tameT = run.tameT + dt
		if run.tameT >= tameTimeNeeded(player, c) then
			doTame(player, run, c)
		end
	end

	local buckAfter = c.def.buckAfter
	if buckAfter then
		if run.mountT >= buckAfter - Config.Ride.BuckWarning and not c.angry then
			c.angry = true
			c.model:SetAttribute("Angry", true)
			feedback(player, "warn", "ATTENTION !", "La bête s'énerve : bondis avant qu'elle te désarçonne !")
		end
		if run.mountT >= buckAfter then
			local velocity = Vector3.new(c.vx, Config.Ride.LaunchUp * 1.12, c.speed * 1.2 + Config.Ride.LaunchBoost)
			if launch(player, run, velocity) then
				feedback(player, "buck", "DÉSARÇONNÉ !", "Bond bonus : rattrape une autre bête !")
			end
		end
	end
end

local function stepAir(player, run, hrp, now)
	local elapsed = now - run.airStart
	local pos = hrp.Position
	local tooFast = hrp.AssemblyLinearVelocity.Magnitude > 260
	if elapsed > Config.Ride.AirMax or tooFast or pos.Y < -30 then
		downPlayer(player, run)
	elseif elapsed > 0.2 and pos.Y < Config.Track.FloorTop + 5.5 then
		downPlayer(player, run)
	end
end

function RideService.Step(dt)
	local now = os.clock()
	for player, run in pairs(State.Participants) do
		local status = run.status
		if status ~= "Out" and status ~= "Finished" then
			local _, hrp, hum = getParts(player)
			if not hrp then
				RideService.Eliminate(player, run, "Tu as quitté la course.")
			else
				local pos = hrp.Position
				run.z = pos.Z

				if pos.Z > run.bestZ then
					local gain = pos.Z - run.bestZ
					run.bestZ = pos.Z
					run.distance = run.distance + gain
					addScore(run, gain * Config.Score.DistanceFactor)
				end

				if pos.Z < State.WallZ + 2 then
					RideService.Eliminate(player, run, "Le mur de lave t'a rattrapé !")
				elseif pos.Z >= Config.Track.FinishZ and status ~= "Hooking" then
					finish(player, run)
				else
					if status == "Riding" then
						stepRiding(player, run, hum, hrp, dt, now)
					elseif status == "Air" then
						stepAir(player, run, hrp, now)
					elseif status == "Down" then
						if pos.Y < -30 or now >= run.downUntil then
							rescue(player, run)
						end
					end
				end

				run.pubT = run.pubT + dt
				if run.pubT >= 0.1 then
					run.pubT = 0
					publish(player, run, now)
				end
			end
		end
	end
end

function RideService.Init()
	Remotes.Launch.OnServerEvent:Connect(RideService.HandleLaunch)
	Remotes.Steer.OnServerEvent:Connect(RideService.HandleSteer)
	Remotes.Hook.OnServerEvent:Connect(RideService.HandleHook)

	Players.PlayerRemoving:Connect(function(player)
		local run = State.Participants[player]
		if run then
			RideService.Detach(run)
			run.status = "Out"
		end
	end)
end

return RideService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">RoundService</string><ProtectedString name="Source"><![CDATA[-- Boucle de manches : Intermission -> Compte à rebours -> Course -> Résultats.
-- Les manches durent 2 minutes. Les récompenses sont calculées et versées ici.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local CreatureService = require(script.Parent.CreatureService)
local RideService = require(script.Parent.RideService)
local WallService = require(script.Parent.WallService)
local EventService = require(script.Parent.EventService)
local Fx = require(script.Parent.Fx)
local MapBuilder = require(script.Parent.MapBuilder)

local RoundService = {}

local function isReady(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and hrp ~= nil and hum.Health > 0 and DataService.Get(player) ~= nil
end

local function readyPlayers()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if isReady(player) then
			table.insert(list, player)
		end
	end
	return list
end

local function broadcastScores()
	local list = {}
	for player, run in pairs(State.Participants) do
		table.insert(list, { n = player.DisplayName, s = math.floor(run.score), st = run.status, id = player.UserId })
	end
	table.sort(list, function(a, b)
		return a.s > b.s
	end)
	local top = {}
	for i = 1, math.min(#list, 12) do
		top[i] = list[i]
	end
	Remotes.Scores:FireAllClients(top)
end

local function intermission()
	local waiting = true
	workspace:SetAttribute("Waiting", true)
	State.SetPhase("Intermission", 0)
	local endAt = 0
	local lastText = 0

	while true do
		local ready = #readyPlayers()
		if ready >= Config.Round.MinPlayers then
			if waiting then
				waiting = false
				endAt = os.clock() + Config.Round.Intermission
				workspace:SetAttribute("Waiting", false)
				State.SetPhase("Intermission", Config.Round.Intermission)
			end
			if os.clock() >= endAt then
				return
			end
		elseif not waiting then
			waiting = true
			workspace:SetAttribute("Waiting", true)
			State.SetPhase("Intermission", 0)
		end

		if os.clock() - lastText >= 1 then
			lastText = os.clock()
			if waiting then
				MapBuilder.SetStatus("En attente de joueurs...")
			else
				MapBuilder.SetStatus(("Prochaine manche dans %d s"):format(math.max(0, math.ceil(endAt - os.clock()))))
			end
		end
		task.wait(0.25)
	end
end

local function startPositions(index)
	local col = (index - 1) % 6
	local row = math.floor((index - 1) / 6)
	return (col - 2.5) * 16, 8 + row * 16
end

local function computeResults()
	local ranking = {}
	for player, run in pairs(State.Participants) do
		table.insert(ranking, { player = player, run = run })
	end
	table.sort(ranking, function(a, b)
		if a.run.score ~= b.run.score then
			return a.run.score > b.run.score
		end
		return a.run.distance > b.run.distance
	end)

	local competitive = #ranking >= 2
	local payload = {}

	for rank, entry in ipairs(ranking) do
		local player, run = entry.player, entry.run
		run.rank = rank
		local roundCoins = math.floor(run.score * Config.Rewards.ScoreToCoins) + Config.Rewards.Participation
		if competitive then
			roundCoins = roundCoins + (Config.Rewards.Place[rank] or 0)
		end
		if player.Parent then
			roundCoins = math.floor(roundCoins * ProgressService.CoinMultiplier(player))
		end

		if player.Parent and DataService.Get(player) then
			local data = DataService.Get(player)
			data.rounds = data.rounds + 1
			data.hooks = data.hooks + run.hooks
			data.distance = data.distance + run.distance
			if rank == 1 and competitive then
				data.wins = data.wins + 1
			end
			if run.score > data.bestScore then
				data.bestScore = math.floor(run.score)
				DataService.SubmitBest(player, run.score)
			end
			DataService.MarkDirty(player)
			ProgressService.AddQuest(player, "rounds", 1)
			ProgressService.AddQuest(player, "hooks", run.hooks)
			ProgressService.AddQuest(player, "distance", math.floor(run.distance))
			ProgressService.AddQuest(player, "combo", run.maxCombo)
			ProgressService.AddQuest(player, "score", math.floor(run.score))
			ProgressService.AddCoins(player, roundCoins)
		end

		table.insert(payload, {
			id = player.UserId,
			n = player.DisplayName,
			score = math.floor(run.score),
			rank = rank,
			coins = roundCoins + run.coins,
			tames = run.tames,
			hooks = run.hooks,
			dist = math.floor(run.distance),
			finish = run.finishPlace,
			combo = run.maxCombo,
		})
	end
	return payload
end

local function runRound()
	local participants = readyPlayers()
	if #participants < Config.Round.MinPlayers then
		return
	end

	State.RoundId = State.RoundId + 1
	local roundId = State.RoundId

	State.Participants = {}
	State.FinishCount = 0
	State.Frozen = true
	CreatureService.Clear()
	Fx.clear()
	WallService.Reset()
	EventService.Reset()

	for index, player in ipairs(participants) do
		local run = RideService.NewRun()
		State.Participants[player] = run
		local x, z = startPositions(index)
		local starter = CreatureService.Spawn(x, z, "boar", 1, 1)
		run.z = z
		run.bestZ = z
		if not RideService.Mount(player, run, starter) then
			run.status = "Out"
		end
	end
	CreatureService.FillInitial()
	broadcastScores()

	-- Compte à rebours
	State.SetPhase("Countdown", Config.Round.Countdown)
	MapBuilder.SetStatus("Manche en cours...")
	task.wait(Config.Round.Countdown)

	-- Course
	State.Frozen = false
	State.SetPhase("Running", Config.Round.Duration)
	local endsAt = os.clock() + Config.Round.Duration
	local lastBroadcast = 0
	local allDoneSince = nil
	while os.clock() < endsAt and State.RoundId == roundId do
		task.wait(0.1)
		if os.clock() - lastBroadcast >= 0.5 then
			lastBroadcast = os.clock()
			broadcastScores()
		end
		if State.CountActive() == 0 then
			allDoneSince = allDoneSince or os.clock()
			if os.clock() - allDoneSince > 2.5 then
				break
			end
		else
			allDoneSince = nil
		end
	end

	-- Résultats
	State.Frozen = true
	State.SetPhase("Results", Config.Round.Results)
	broadcastScores()
	for player, run in pairs(State.Participants) do
		RideService.Detach(run)
		if run.status ~= "Out" and run.status ~= "Finished" then
			run.status = "Out"
		end
	end
	local payload = computeResults()
	for player in pairs(State.Participants) do
		if player.Parent then
			RideService.ToLobby(player)
			player:SetAttribute("TameProgress", 0)
			player:SetAttribute("RideName", nil)
			Remotes.Status:FireClient(player, "Lobby")
		end
	end
	Remotes.Results:FireAllClients({ list = payload, round = roundId })
	MapBuilder.SetStatus("Résultats de la manche")
	task.wait(Config.Round.Results)

	-- Nettoyage
	State.Participants = {}
	CreatureService.Clear()
	Fx.clear()
	WallService.Reset()
end

function RoundService.Run()
	while true do
		intermission()
		runRound()
	end
end

return RoundService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- État partagé côté serveur (une seule source de vérité pour la manche en cours).

local State = {
	Phase = "Intermission", -- Intermission | Countdown | Running | Results
	RoundId = 0,
	Frozen = true, -- bêtes immobiles (compte à rebours)
	WallZ = -70,
	RunElapsed = 0,
	FinishCount = 0,
	Participants = {}, -- [Player] = run
	Creatures = {}, -- [id] = creature
	NextCreatureId = 1,
	CreaturesFolder = nil,
	FxFolder = nil,
	LobbyCFrame = CFrame.new(0, 330, -560),
	FinishCFrame = CFrame.new(0, 6, 3300),
	MapReady = false,
}

function State.SetPhase(phase, duration)
	State.Phase = phase
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEnd", workspace:GetServerTimeNow() + (duration or 0))
	workspace:SetAttribute("Round", State.RoundId)
end

function State.CountActive()
	local n = 0
	for _, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" then
			n = n + 1
		end
	end
	return n
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">WallService</string><ProtectedString name="Source"><![CDATA[-- Mur de lave : avance de plus en plus vite. Les joueurs rattrapés sont éliminés (voir RideService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local State = require(script.Parent.State)

local WallService = {}

local wall = nil

local function place()
	if wall then
		wall.CFrame = CFrame.new(0, 35, State.WallZ - 8)
	end
end

function WallService.Init(wallPart)
	wall = wallPart
	WallService.Reset()
end

function WallService.Reset()
	State.WallZ = Config.Wall.StartZ
	State.RunElapsed = 0
	place()
end

function WallService.Speed()
	return math.min(Config.Wall.MaxSpeed, Config.Wall.Speed0 + Config.Wall.Accel * State.RunElapsed)
end

function WallService.Step(dt)
	State.RunElapsed = State.RunElapsed + dt
	State.WallZ = State.WallZ + WallService.Speed() * dt
	place()
end

return WallService
]]></ProtectedString></Properties></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX34"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX33"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX32"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Point d'entrée client de Saute-Troupeau.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Modules = script:WaitForChild("Modules")
local ClientState = require(Modules.ClientState)
local CreatureFx = require(Modules.CreatureFx)
local CameraRig = require(Modules.CameraRig)
local Controls = require(Modules.Controls)
local HUD = require(Modules.HUD)
local Menu = require(Modules.Menu)
local Ambience = require(Modules.Ambience)
local Sfx = require(Modules.Sfx)

-- Données serveur -> client
Remotes.Data.OnClientEvent:Connect(function(snapshot)
	if type(snapshot) == "table" then
		ClientState.setData(snapshot)
	end
end)

Remotes.Status.OnClientEvent:Connect(function(status)
	if type(status) == "string" then
		ClientState.setStatus(status)
	end
end)

Remotes.Scores.OnClientEvent:Connect(function(list)
	if type(list) == "table" then
		ClientState.setScores(list)
	end
end)

Remotes.Feedback.OnClientEvent:Connect(function(payload)
	HUD.feedback(payload)
end)

Remotes.Results.OnClientEvent:Connect(function(payload)
	HUD.showResults(payload)
end)

Remotes.Launched.OnClientEvent:Connect(function(velocity)
	if typeof(velocity) == "Vector3" then
		Controls.onLaunched(velocity)
	end
end)

-- Sans personnage vivant on repasse en mode salon.
player.CharacterAdded:Connect(function()
	ClientState.setStatus("Lobby")
end)

-- Modules
Sfx.init()
HUD.init()
Menu.init()
CreatureFx.init()
CameraRig.init()
Controls.init()
Ambience.init()
]]></ProtectedString></Properties><Item class="Folder" referent="RBX31"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- Ambiance : la lumière et la brume changent progressivement selon le biome traversé (effet local au client).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sfx = require(script.Parent.Sfx)

local Ambience = {}

local player = Players.LocalPlayer
local currentBiome = nil

function Ambience.init()
	local atmosphere = Lighting:WaitForChild("HHAtmosphere", 20)
	local color = Lighting:WaitForChild("HHColor", 20)
	if not atmosphere or not color then
		return
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < 0.5 then
			return
		end
		accumulator = 0
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		-- le salon (en hauteur) garde l'ambiance de la savane
		local inLobby = hrp.Position.Y > 150
		local z = inLobby and 0 or hrp.Position.Z
		local biome = Config.biomeAt(z)
		if inLobby then
			Sfx.setMusic(workspace:GetAttribute("Phase") == "Results" and "results" or "lobby")
		else
			Sfx.setMusic(biome.key)
		end
		if biome ~= currentBiome then
			currentBiome = biome
			local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
			TweenService:Create(atmosphere, info, { Color = biome.atmosphere }):Play()
			TweenService:Create(color, info, { TintColor = biome.tint }):Play()
		end
	end)
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[-- Caméra de course : derrière et au-dessus du cavalier, regardant vers +Z (sens de la piste).
-- Actif pendant la course ; en spectateur, suit le leader. Sinon, caméra Roblox par défaut.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local CameraRig = {}

local player = Players.LocalPlayer
local active = false
local pos = Vector3.new(0, 0, 0)
local lastFocus = nil
local speedSmooth = 0
local lateralSmooth = 0
local lastStatus = nil
local shakeUntil = 0
local shakePower = 0

local function hrpOf(plr)
	local char = plr and plr.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function focusPart()
	local s = ClientState.Status
	if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" then
		return hrpOf(player)
	end
	if (s == "Out" or s == "Finished") and workspace:GetAttribute("Phase") == "Running" then
		-- spectateur : suivre le premier du classement encore en course
		for _, entry in ipairs(ClientState.Scores) do
			if
				entry.id ~= player.UserId
				and (entry.st == "Riding" or entry.st == "Air" or entry.st == "Hooking" or entry.st == "Down")
			then
				local other = Players:GetPlayerByUserId(entry.id)
				local part = hrpOf(other)
				if part then
					return part
				end
			end
		end
		return hrpOf(player)
	end
	return nil
end

function CameraRig.shake(power, seconds)
	shakePower = power
	shakeUntil = os.clock() + seconds
end

local function release(camera)
	if active then
		active = false
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end
end

local function update(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local part = focusPart()
	if not part then
		release(camera)
		lastFocus = nil
		return
	end

	local focus = part.Position
	local snap = false
	if not active then
		active = true
		snap = true
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local desired = focus + Vector3.new(0, 14, -30)
	if snap then
		pos = desired
	else
		pos = pos:Lerp(desired, 1 - math.exp(-dt * 9))
	end

	-- légère inclinaison dans les virages et regard décalé vers le côté où l'on va
	local cf = CFrame.lookAt(pos, focus + Vector3.new(-lateralSmooth * 0.35, 3, 36))
		* CFrame.Angles(0, 0, lateralSmooth * 0.004)
	if ClientState.Status ~= lastStatus then
		if ClientState.Status == "Down" then
			CameraRig.shake(1.4, 0.35)
		elseif ClientState.Status == "Riding" and lastStatus == "Hooking" then
			CameraRig.shake(0.5, 0.2)
		end
		lastStatus = ClientState.Status
	end
	if os.clock() < shakeUntil then
		local k = shakePower * (shakeUntil - os.clock())
		cf = cf * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end
	camera.CFrame = cf

	-- champ de vision selon la vitesse
	if lastFocus and dt > 0 then
		local speed = (focus - lastFocus).Magnitude / dt
		speedSmooth = speedSmooth + (math.min(speed, 120) - speedSmooth) * math.min(1, dt * 3)
		local lateral = math.clamp((focus.X - lastFocus.X) / dt, -40, 40)
		lateralSmooth = lateralSmooth + (lateral - lateralSmooth) * math.min(1, dt * 5)
	end
	lastFocus = focus
	camera.FieldOfView = 70 + math.clamp(speedSmooth / 70, 0, 1) * 16
end

function CameraRig.init()
	RunService:BindToRenderStep("HerdHopperCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraRig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- État côté client + mini système d'abonnement.

local ClientState = {
	Data = nil, -- profil envoyé par le serveur
	Status = "Lobby", -- Lobby | Riding | Air | Hooking | Down | Out | Finished
	Scores = {}, -- classement en direct
}

local listeners = {}

function ClientState.connect(key, fn)
	listeners[key] = listeners[key] or {}
	table.insert(listeners[key], fn)
	return function()
		local list = listeners[key]
		local index = table.find(list, fn)
		if index then
			table.remove(list, index)
		end
	end
end

local function fire(key, value)
	local list = listeners[key]
	if not list then
		return
	end
	for _, fn in ipairs(table.clone(list)) do
		task.spawn(fn, value)
	end
end

function ClientState.setData(data)
	ClientState.Data = data
	fire("Data", data)
end

function ClientState.setStatus(status)
	if ClientState.Status == status then
		return
	end
	ClientState.Status = status
	fire("Status", status)
end

function ClientState.setScores(scores)
	ClientState.Scores = scores
	fire("Scores", scores)
end

function ClientState.isPlaying()
	local s = ClientState.Status
	return s == "Riding" or s == "Air" or s == "Hooking" or s == "Down"
end

return ClientState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Contrôles à une seule action, contextuelle (clavier, souris, tactile, manette) :
--   * en selle   : SAUTER (quitte la monture avec un bond vers l'avant)
--   * en l'air   : LASSO (maintenir = lasso automatique dès qu'une bête est à portée)
-- Direction : A/D, flèches, joystick (pilote la monture, ou le vol en l'air).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local CreatureFx = require(script.Parent.CreatureFx)
local Sfx = require(script.Parent.Sfx)

local Controls = {}

local player = Players.LocalPlayer

local pressed = false
local pressedSource = nil
local armedUntil = 0
local lastHookAt = 0
local lastSteer = 0
local lastSteerAt = 0
local controlsObject = nil

local air = { active = false, vx = 0, vz = 0 }

local function getHrp()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

-- Direction latérale demandée, exprimée sur l'axe X du monde (caméra tournée vers +Z : droite écran = -X).
local function getSteer()
	if controlsObject then
		local ok, v = pcall(function()
			return controlsObject:GetMoveVector()
		end)
		if ok and v then
			return -v.X
		end
	end
	local hum = getHum()
	return hum and hum.MoveDirection.X or 0
end

function Controls.press(source)
	if pressed then
		return
	end
	pressed = true
	pressedSource = source
	local status = ClientState.Status
	if status == "Riding" then
		Remotes.Launch:FireServer()
		Sfx.play("launch")
	elseif status == "Air" or status == "Down" then
		armedUntil = os.clock() + 0.45
	end
end

function Controls.release(source)
	if pressed and pressedSource == source then
		pressed = false
		pressedSource = nil
	end
end

-- Branche un bouton d'interface (tactile / souris) sur l'action.
function Controls.bindButton(button)
	button.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			Controls.press("button")
		end
	end)
	button.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			Controls.release("button")
		end
	end)
end

function Controls.onLaunched(velocity)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return
	end
	-- attendre que la soudure de selle ait disparu (réplication)
	local t0 = os.clock()
	while hrp:FindFirstChild("RideWeld") and os.clock() - t0 < 0.5 do
		RunService.Heartbeat:Wait()
	end
	hum.Sit = false
	hum:ChangeState(Enum.HumanoidStateType.Freefall)
	hrp.AssemblyLinearVelocity = velocity
	air.active = true
	air.vx = velocity.X
	air.vz = velocity.Z
end

local function setupCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.JumpHeight = 0
	hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	air.active = false

	-- masquer le bouton de saut tactile par défaut (notre bouton d'action le remplace)
	task.spawn(function()
		local gui = player:WaitForChild("PlayerGui")
		local touchGui = gui:WaitForChild("TouchGui", 5)
		if touchGui then
			local frame = touchGui:FindFirstChild("TouchControlFrame")
			local jump = frame and frame:FindFirstChild("JumpButton")
			if jump then
				jump.Visible = false
			end
		end
	end)
end

function Controls.init()
	-- Module de contrôles Roblox : permet de lire le stick / les touches indépendamment de la caméra.
	task.spawn(function()
		local ok, result = pcall(function()
			local scripts = player:WaitForChild("PlayerScripts")
			local module = scripts:WaitForChild("PlayerModule", 10)
			return require(module):GetControls()
		end)
		if ok then
			controlsObject = result
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local t = input.UserInputType
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
			Controls.press("key")
		elseif t == Enum.UserInputType.MouseButton1 then
			Controls.press("mouse")
		elseif t == Enum.UserInputType.Touch then
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1000, 1000)
			if input.Position.X > viewport.X * 0.5 then
				Controls.press("touch")
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
			Controls.release("key")
		elseif t == Enum.UserInputType.MouseButton1 then
			Controls.release("mouse")
		elseif t == Enum.UserInputType.Touch then
			Controls.release("touch")
		end
	end)

	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end
	player.CharacterAdded:Connect(setupCharacter)

	ClientState.connect("Status", function(status)
		if status ~= "Air" then
			air.active = false
		end
		if status == "Down" then
			Sfx.play("land")
		end
		if status == "Riding" or status == "Lobby" then
			CreatureFx.setTarget(nil)
			-- un nouvel appui est nécessaire pour bondir (évite un état "appuyé" resté coincé)
			pressed = false
			pressedSource = nil
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local status = ClientState.Status
		local now = os.clock()
		local hrp = getHrp()
		if not hrp then
			return
		end

		if status == "Riding" then
			local x = getSteer()
			if math.abs(x) < 0.15 then
				x = 0
			end
			x = math.clamp(x, -1, 1)
			if math.abs(x - lastSteer) > 0.05 or (now - lastSteerAt > 0.5 and x ~= 0) then
				lastSteer = x
				lastSteerAt = now
				Remotes.Steer:FireServer(x)
			end
		elseif lastSteer ~= 0 then
			lastSteer = 0
		end

		if status == "Air" and air.active then
			local v = hrp.AssemblyLinearVelocity
			local target = getSteer() * Config.Ride.AirLateral
			air.vx = air.vx + (target - air.vx) * math.min(1, dt * 4)
			hrp.AssemblyLinearVelocity = Vector3.new(air.vx, v.Y, air.vz)
		end

		if status == "Air" or status == "Down" then
			local range = player:GetAttribute("HookRange") or Config.Ride.HookBaseRange
			local model = CreatureFx.bestTarget(hrp.Position, range, status == "Air" and 5 or -25)
			CreatureFx.setTarget(model)
			if model and (pressed or now < armedUntil) and now - lastHookAt > Config.Ride.HookCooldown then
				lastHookAt = now
				armedUntil = 0
				Remotes.Hook:FireServer(model:GetAttribute("Id"))
				Sfx.play("hook")
			end
		elseif status == "Hooking" then
			CreatureFx.setTarget(nil)
		end
	end)
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">CreatureFx</string><ProtectedString name="Source"><![CDATA[-- Côté client : animation des pattes/ailes, bête ciblée (surbrillance dorée), bêtes énervées (rouge).
-- Les animations ne sont jamais répliquées : le serveur ne déplace que la pièce Root.

local RunService = game:GetService("RunService")

local CreatureFx = {}

local folder = nil
local records = {} -- [model] = { motors = nil | {...}, tries = number, speed = number }
local targetHighlight = nil
local targetModel = nil

local CULL_DISTANCE = 260

local function collectMotors(model)
	local motors = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local name = descendant.Name
			if name:sub(1, 3) == "Leg" then
				table.insert(
					motors,
					{ motor = descendant, kind = "leg", phase = descendant:GetAttribute("Phase") or 0 }
				)
			elseif name:sub(1, 4) == "Wing" then
				table.insert(motors, { motor = descendant, kind = "wing", side = descendant:GetAttribute("Side") or 1 })
			end
		end
	end
	return motors
end

local function updateAngry(model)
	local angry = model:GetAttribute("Angry") == true
	local existing = model:FindFirstChild("AngryHighlight")
	if angry and not existing then
		local h = Instance.new("Highlight")
		h.Name = "AngryHighlight"
		h.FillColor = Color3.fromRGB(255, 60, 40)
		h.FillTransparency = 0.55
		h.OutlineColor = Color3.fromRGB(255, 220, 200)
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = model
	elseif not angry and existing then
		existing:Destroy()
	end
end

local function track(model)
	if not model:IsA("Model") then
		return
	end
	records[model] = { motors = nil, tries = 0, speed = model:GetAttribute("BaseSpeed") or 40 }
	model:GetAttributeChangedSignal("Angry"):Connect(function()
		updateAngry(model)
	end)
end

local function untrack(model)
	records[model] = nil
	if model == targetModel then
		targetModel = nil
	end
end

function CreatureFx.init()
	folder = workspace:WaitForChild("Creatures")
	for _, model in ipairs(folder:GetChildren()) do
		track(model)
	end
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(untrack)

	targetHighlight = Instance.new("Highlight")
	targetHighlight.Name = "TargetHighlight"
	targetHighlight.FillColor = Color3.fromRGB(255, 214, 70)
	targetHighlight.FillTransparency = 0.45
	targetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local t = os.clock()
		for model, rec in pairs(records) do
			local root = model:FindFirstChild("Root")
			if root and (root.Position - camPos).Magnitude < CULL_DISTANCE then
				if rec.motors == nil then
					local found = collectMotors(model)
					if #found > 0 or rec.tries > 40 then
						rec.motors = found
					else
						rec.tries = rec.tries + 1
					end
				end
				if rec.motors then
					local freq = 4 + rec.speed * 0.11
					for _, m in ipairs(rec.motors) do
						if m.kind == "leg" then
							m.motor.Transform = CFrame.Angles(math.sin(t * freq + m.phase) * 0.7, 0, 0)
						else
							m.motor.Transform = CFrame.Angles(0, 0, m.side * math.sin(t * 8) * 0.55)
						end
					end
				end
			end
		end
	end)
end

-- Meilleure bête à lasso depuis `origin` dans la portée `range`. `minDz` = avance minimale requise
-- sur l'axe de course (en l'air : devant soi ; au sol : on accepte les bêtes qui passent à côté).
function CreatureFx.bestTarget(origin, range, minDz)
	if not folder then
		return nil
	end
	local best, bestScore = nil, math.huge
	for _, model in ipairs(folder:GetChildren()) do
		if model:GetAttribute("Ridden") ~= true and model:GetAttribute("Id") then
			local root = model:FindFirstChild("Root")
			if root then
				local delta = root.Position + Vector3.new(0, 3, 0) - origin
				local dist = delta.Magnitude
				if dist <= range and delta.Z >= (minDz or 5) then
					local score = dist - 0.3 * math.max(delta.Z, 0)
					if score < bestScore then
						best, bestScore = model, score
					end
				end
			end
		end
	end
	return best
end

function CreatureFx.hasTarget()
	return targetModel ~= nil
end

function CreatureFx.setTarget(model)
	if model == targetModel then
		return
	end
	targetModel = model
	if model then
		targetHighlight.Parent = model
	else
		targetHighlight.Parent = nil
	end
end

return CreatureFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Interface de jeu : minuteur, score, combo, classement, mur de lave, dressage, bouton d'action,
-- messages (lasso, dressage, événements) et tableau des résultats.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local Controls = require(script.Parent.Controls)
local CameraRig = require(script.Parent.CameraRig)
local CreatureFx = require(script.Parent.CreatureFx)

local HUD = {}

local player = Players.LocalPlayer
local refs = {}
local feedbackToken = 0
local resultsToken = 0
local lastCountdown = -1
local lastWarnTick = 0
local lastCombo = 0

local KIND_STYLE = {
	hook = { color = UI.Colors.Accent },
	tame = { color = UI.Colors.Good, sound = "tame" },
	down = { color = UI.Colors.Bad, sound = "down", shake = 1.2 },
	out = { color = UI.Colors.Bad, sound = "down" },
	finish = { color = UI.Colors.Accent, sound = "win" },
	warn = { color = UI.Colors.Warn, sound = "tick" },
	buck = { color = UI.Colors.Warn, sound = "boom", shake = 1.0 },
	geyser = { color = UI.Colors.Info, sound = "geyser", shake = 0.8 },
	event = { color = UI.Colors.Info, sound = "go" },
	danger = { color = UI.Colors.Bad, sound = "boom", shake = 1.5 },
}

local function build(gui)
	local C = UI.Colors

	-- Bandeau du haut (phase / minuteur)
	local banner = UI.frame(gui, {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(0, 330, 0, 46),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
	})
	UI.corner(banner, 14)
	UI.stroke(banner, C.Dark, 2)
	refs.bannerText =
		UI.text(banner, { Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 4), maxSize = 26 })

	refs.hint = UI.text(gui, {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.new(0, 420, 0, 26),
		maxSize = 18,
		TextColor3 = C.Muted,
		Font = UI.FontBody,
	})

	-- Score + combo (haut gauche)
	local score = UI.frame(gui, {
		Name = "ScoreBox",
		Position = UDim2.new(0, 12, 0, 10),
		Size = UDim2.new(0, 220, 0, 98),
		BackgroundTransparency = 0.15,
	})
	UI.corner(score, 14)
	UI.stroke(score, C.Dark, 2)
	UI.text(
		score,
		{
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.new(0, 8, 0, 4),
			Text = "SCORE",
			maxSize = 14,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
		}
	)
	refs.score = UI.text(
		score,
		{
			Size = UDim2.new(1, -16, 0, 40),
			Position = UDim2.new(0, 8, 0, 20),
			Text = "0",
			maxSize = 38,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		}
	)
	refs.combo = UI.text(
		score,
		{
			Size = UDim2.new(1, -16, 0, 20),
			Position = UDim2.new(0, 8, 0, 62),
			Text = "",
			maxSize = 18,
			TextColor3 = C.Good,
			TextXAlignment = Enum.TextXAlignment.Left,
		}
	)
	local comboBar = UI.frame(
		score,
		{ Position = UDim2.new(0, 8, 1, -12), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = C.Dark }
	)
	UI.corner(comboBar, 3)
	refs.comboFill = UI.frame(comboBar, { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.Good })
	UI.corner(refs.comboFill, 3)
	refs.scoreBox = score
	UI.make(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(52, 62, 96), Color3.fromRGB(26, 31, 50)), Rotation = 90 },
		score
	)
	UI.make(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(52, 62, 96), Color3.fromRGB(26, 31, 50)), Rotation = 90 },
		banner
	)

	-- Classement en direct (haut droite)
	local board = UI.frame(gui, {
		Name = "Board",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 200, 0, 20 + 6 * 22),
		BackgroundTransparency = 0.2,
	})
	UI.corner(board, 14)
	UI.stroke(board, C.Dark, 2)
	UI.text(
		board,
		{
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.new(0, 8, 0, 2),
			Text = "CLASSEMENT",
			maxSize = 14,
			TextColor3 = C.Muted,
		}
	)
	refs.rows = {}
	for i = 1, 6 do
		refs.rows[i] = UI.text(board, {
			Size = UDim2.new(1, -16, 0, 20),
			Position = UDim2.new(0, 8, 0, 20 + (i - 1) * 22),
			maxSize = 16,
			Font = UI.FontBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			outline = false,
		})
	end
	refs.board = board

	-- Mur de lave
	local wallBox = UI.frame(gui, {
		Name = "WallBox",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.new(0, 300, 0, 26),
		BackgroundColor3 = C.Dark,
		BackgroundTransparency = 0.2,
	})
	UI.corner(wallBox, 13)
	UI.stroke(wallBox, C.Dark, 2)
	refs.wallFill = UI.frame(wallBox, { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.Good })
	UI.corner(refs.wallFill, 13)
	refs.wallText =
		UI.text(wallBox, { Size = UDim2.new(1, -10, 1, -4), Position = UDim2.new(0, 5, 0, 2), maxSize = 16 })
	refs.wallBox = wallBox

	-- Danger : bordure rouge pulsante
	refs.danger = UI.frame(
		gui,
		{
			Name = "Danger",
			Position = UDim2.new(0, 8, 0, 8),
			Size = UDim2.new(1, -16, 1, -16),
			BackgroundTransparency = 1,
			Visible = false,
			Active = false,
		}
	)
	refs.dangerStroke =
		UI.make("UIStroke", { Color = Color3.fromRGB(255, 50, 30), Thickness = 16, Transparency = 1 }, refs.danger)

	-- Monture / dressage (bas centre)
	local ride = UI.frame(gui, {
		Name = "RideBox",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(0, 300, 0, 62),
		BackgroundTransparency = 0.15,
	})
	UI.corner(ride, 14)
	UI.stroke(ride, C.Dark, 2)
	refs.rideName = UI.text(ride, { Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 0, 4), maxSize = 22 })
	local tameBar = UI.frame(
		ride,
		{ Position = UDim2.new(0, 10, 0, 36), Size = UDim2.new(1, -20, 0, 16), BackgroundColor3 = C.Dark }
	)
	UI.corner(tameBar, 8)
	refs.tameFill = UI.frame(tameBar, { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.Good })
	UI.corner(refs.tameFill, 8)
	refs.tameText = UI.text(tameBar, { Size = UDim2.new(1, 0, 1, 0), maxSize = 12, Text = "DRESSAGE", outline = true })
	refs.rideBox = ride

	-- Bouton d'action (bas droite)
	local action = UI.button(gui, {
		Name = "Action",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.new(0, 124, 0, 124),
		BackgroundColor3 = C.Accent,
		Text = "SAUTER",
		maxSize = 24,
	})
	local corner = action:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	Controls.bindButton(action)
	refs.action = action

	-- Bouton de son (tout / effets seuls / muet)
	local soundButton = UI.button(gui, {
		Name = "Sound",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -60),
		Size = UDim2.new(0, 150, 0, 34),
		Text = Sfx.modeLabel(),
		BackgroundColor3 = C.PanelLight,
		TextColor3 = C.Text,
		maxSize = 16,
	})
	soundButton.Activated:Connect(function()
		soundButton.Text = Sfx.cycleMode()
		Sfx.play("click")
	end)

	-- Message central (lasso, dressage...)
	local toast = UI.frame(gui, {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.new(0, 560, 0, 96),
		BackgroundTransparency = 1,
		Visible = false,
	})
	refs.toastTitle = UI.text(toast, { Size = UDim2.new(1, 0, 0, 56), maxSize = 52 })
	refs.toastSub = UI.text(
		toast,
		{ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0, 58), maxSize = 24, Font = UI.FontBody }
	)
	refs.toast = toast

	-- Compte à rebours
	refs.countdown = UI.text(gui, {
		Name = "Countdown",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.42, 0),
		Size = UDim2.new(0, 240, 0, 160),
		maxSize = 150,
		TextColor3 = C.Accent,
		Visible = false,
	})

	-- Résultats
	local results = UI.frame(gui, {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.92, 0, 0.8, 0),
		Visible = false,
		ZIndex = 20,
	})
	UI.make("UISizeConstraint", { MaxSize = Vector2.new(560, 440) }, results)
	UI.corner(results, 18)
	UI.stroke(results, C.Accent, 3)
	UI.text(
		results,
		{
			Size = UDim2.new(1, -20, 0, 44),
			Position = UDim2.new(0, 10, 0, 8),
			Text = "RÉSULTATS DE LA MANCHE",
			maxSize = 32,
			TextColor3 = C.Accent,
			ZIndex = 21,
		}
	)
	refs.resultsList = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 0, 58),
		Size = UDim2.new(1, -20, 1, -118),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 21,
	}, results)
	UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, refs.resultsList)
	local close = UI.button(results, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(0, 160, 0, 40),
		Text = "FERMER",
		maxSize = 22,
		ZIndex = 22,
	})
	close.Activated:Connect(function()
		results.Visible = false
		Sfx.play("click")
	end)
	refs.results = results
end

-- ---------------------------------------------------------------------------
-- Mise à jour périodique
-- ---------------------------------------------------------------------------

local function wallDistance()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local wall = workspace:FindFirstChild("LavaWall")
	local root = wall and wall:FindFirstChild("Root")
	if hrp and root then
		return hrp.Position.Z - (root.Position.Z + 8)
	end
	return nil
end

local function updateScores()
	local list = ClientState.Scores
	for i = 1, 6 do
		local row = refs.rows[i]
		local entry = list[i]
		if entry then
			local you = entry.id == player.UserId
			row.Text = ("%d. %s  %s"):format(i, entry.n, Util.formatNumber(entry.s))
			row.TextColor3 = you and UI.Colors.Accent or UI.Colors.Text
			row.Visible = true
		else
			row.Visible = false
		end
	end
end

local function update()
	local phase = workspace:GetAttribute("Phase") or "Intermission"
	local waiting = workspace:GetAttribute("Waiting")
	local remaining = (workspace:GetAttribute("PhaseEnd") or 0) - workspace:GetServerTimeNow()
	local status = ClientState.Status
	local playing = ClientState.isPlaying()
	local running = phase == "Running"

	-- bandeau
	if phase == "Intermission" then
		refs.bannerText.Text = waiting and "En attente de joueurs..."
			or ("Prochaine manche : " .. Util.formatTime(remaining))
	elseif phase == "Countdown" then
		refs.bannerText.Text = "Prépare-toi !"
	elseif phase == "Running" then
		refs.bannerText.Text = "Temps restant : " .. Util.formatTime(remaining)
	else
		refs.bannerText.Text = "Résultats"
	end

	-- compte à rebours géant
	if phase == "Countdown" then
		local n = math.ceil(remaining)
		refs.countdown.Visible = true
		if n >= 1 then
			refs.countdown.Text = tostring(n)
			if n ~= lastCountdown then
				lastCountdown = n
				Sfx.play("tick")
			end
		else
			refs.countdown.Text = "GO !"
			if lastCountdown ~= 0 then
				lastCountdown = 0
				Sfx.play("go")
			end
		end
	else
		refs.countdown.Visible = false
		lastCountdown = -1
	end

	-- indications
	if running and status == "Lobby" then
		refs.hint.Text = "Manche en cours : tu joues à la prochaine !"
	elseif running and (status == "Out" or status == "Finished") then
		refs.hint.Text = status == "Finished" and "Arrivé ! Tu regardes la fin de la manche."
			or "Éliminé : tu regardes la course."
	elseif phase == "Intermission" then
		refs.hint.Text = "Ouvre la boutique ou le bestiaire en attendant."
	else
		refs.hint.Text = ""
	end

	-- blocs de jeu
	local showScore = playing or status == "Out" or status == "Finished"
	refs.scoreBox.Visible = showScore and (running or phase == "Countdown")
	refs.board.Visible = (running or phase == "Countdown") and #ClientState.Scores > 0
	refs.rideBox.Visible = status == "Riding"
	refs.action.Visible = playing
	refs.wallBox.Visible = playing and running

	if refs.scoreBox.Visible then
		refs.score.Text = Util.formatNumber(player:GetAttribute("RunScore") or 0)
		local combo = player:GetAttribute("Combo") or 0
		if combo ~= lastCombo then
			lastCombo = combo
			if combo >= 2 then
				-- petit "pop" à chaque palier de combo
				refs.combo.TextSize = 30
				UI.tween(refs.combo, 0.25, { TextSize = 20 }, Enum.EasingStyle.Back)
			end
		end
		if combo >= 2 then
			refs.combo.Text = ("COMBO x%.1f"):format(player:GetAttribute("ComboMult") or 1)
		else
			refs.combo.Text = ""
		end
		local left = player:GetAttribute("ComboLeft") or 0
		UI.tween(refs.comboFill, 0.1, { Size = UDim2.new(left, 0, 1, 0) })
	end

	if refs.rideBox.Visible then
		refs.rideName.Text = player:GetAttribute("RideName") or ""
		local progress = player:GetAttribute("TameProgress") or 0
		UI.tween(refs.tameFill, 0.1, { Size = UDim2.new(progress, 0, 1, 0) })
		refs.tameText.Text = progress >= 1 and "DOMPTÉ !" or "DRESSAGE"
	end

	-- bouton d'action contextuel
	if refs.action.Visible then
		if status == "Riding" then
			refs.action.Text = "SAUTER"
			refs.action.BackgroundColor3 = UI.Colors.Accent
		elseif status == "Air" or status == "Down" then
			refs.action.Text = "LASSO"
			-- le bouton brille quand une bête est à portée
			local ready = CreatureFx.hasTarget()
			refs.action.BackgroundColor3 = ready and UI.Colors.Accent or UI.Colors.Info
		else
			refs.action.Text = "..."
			refs.action.BackgroundColor3 = UI.Colors.Muted
		end
	end

	-- mur de lave
	local dist = wallDistance()
	if refs.wallBox.Visible and dist then
		local fraction = math.clamp(dist / 160, 0, 1)
		refs.wallFill.Size = UDim2.new(fraction, 0, 1, 0)
		refs.wallFill.BackgroundColor3 = dist < 35 and UI.Colors.Bad or (dist < 80 and UI.Colors.Warn or UI.Colors.Good)
		refs.wallText.Text = ("MUR DE LAVE : %d m"):format(math.max(0, math.floor(dist)))
		refs.danger.Visible = dist < 45
		if dist < 45 then
			if os.clock() - lastWarnTick > 0.9 - 0.5 * (1 - math.clamp(dist / 45, 0, 1)) then
				lastWarnTick = os.clock()
				Sfx.play("tick")
			end
			local pulse = (math.sin(os.clock() * 8) + 1) / 2
			refs.dangerStroke.Transparency = 1 - (1 - math.clamp(dist / 45, 0, 1)) * (0.35 + 0.35 * pulse)
		end
	else
		refs.danger.Visible = false
	end
end

-- ---------------------------------------------------------------------------
-- Messages et résultats
-- ---------------------------------------------------------------------------

function HUD.feedback(payload)
	if type(payload) ~= "table" then
		return
	end
	local style = KIND_STYLE[payload.kind] or KIND_STYLE.hook
	feedbackToken = feedbackToken + 1
	local token = feedbackToken

	refs.toastTitle.Text = tostring(payload.title or "")
	refs.toastTitle.TextColor3 = style.color
	refs.toastSub.Text = tostring(payload.sub or "")
	refs.toast.Position = UDim2.new(0.5, 0, 0.3, 14)
	refs.toast.Visible = true
	UI.tween(refs.toast, 0.18, { Position = UDim2.new(0.5, 0, 0.3, 0) }, Enum.EasingStyle.Back)

	if style.sound then
		Sfx.play(style.sound)
	end
	if style.shake then
		CameraRig.shake(style.shake, 0.4)
	end

	task.delay(payload.kind == "tame" and 2.4 or 1.6, function()
		if token == feedbackToken then
			refs.toast.Visible = false
		end
	end)
end

function HUD.showResults(payload)
	if type(payload) ~= "table" or type(payload.list) ~= "table" then
		return
	end
	for _, child in ipairs(refs.resultsList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local myRank = nil
	for index, entry in ipairs(payload.list) do
		local you = entry.id == player.UserId
		if you then
			myRank = entry.rank
		end
		local row = UI.frame(refs.resultsList, {
			Size = UDim2.new(1, -8, 0, 46),
			BackgroundColor3 = you and UI.Colors.PanelLight or UI.Colors.Panel,
			LayoutOrder = index,
			ZIndex = 21,
		})
		UI.corner(row, 10)
		if you then
			UI.stroke(row, UI.Colors.Accent, 2)
		end
		UI.text(
			row,
			{
				Size = UDim2.new(0, 44, 1, 0),
				Text = "#" .. entry.rank,
				maxSize = 24,
				TextColor3 = entry.rank == 1 and UI.Colors.Accent or UI.Colors.Text,
				ZIndex = 22,
			}
		)
		UI.text(
			row,
			{
				Size = UDim2.new(0.42, 0, 1, -8),
				Position = UDim2.new(0, 48, 0, 4),
				Text = entry.n,
				maxSize = 20,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 22,
			}
		)
		UI.text(row, {
			Size = UDim2.new(0.3, 0, 1, -8),
			Position = UDim2.new(0.5, 0, 0, 4),
			Text = Util.formatNumber(entry.score) .. " pts",
			maxSize = 20,
			TextColor3 = UI.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 22,
		})
		UI.text(row, {
			Size = UDim2.new(0.2, -8, 1, -8),
			Position = UDim2.new(0.8, 0, 0, 4),
			Text = "+" .. entry.coins,
			maxSize = 18,
			TextColor3 = UI.Colors.Good,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 22,
		})
	end

	refs.results.Visible = true
	if myRank == 1 then
		Sfx.play("win")
	else
		Sfx.play("coin")
	end

	resultsToken = resultsToken + 1
	local token = resultsToken
	task.delay(Config.Round.Results + 1, function()
		if token == resultsToken then
			refs.results.Visible = false
		end
	end)
end

function HUD.init()
	local gui = UI.make("ScreenGui", {
		Name = "HerdHopperHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	build(gui)

	ClientState.connect("Scores", updateScores)
	updateScores()

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator >= 0.1 then
			accumulator = 0
			update()
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[-- Menus du salon : Boutique (améliorations, chapeaux, cordes), Bestiaire, Quêtes + cadeau du jour.
-- Le client ne fait que demander : le serveur valide chaque achat / récompense.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Species = require(Shared.Species)
local Util = require(Shared.Util)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)

local Menu = {}

local player = Players.LocalPlayer
local refs = {}
local openName = nil
local shopTab = "upgrade"
local lastMessage = ""

local function clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function variantColor(base, variantIdx)
	if variantIdx == 2 then
		return base:Lerp(Color3.fromRGB(110, 210, 255), 0.55)
	elseif variantIdx == 3 then
		return base:Lerp(Color3.fromRGB(255, 205, 60), 0.65)
	end
	return base
end

local function setMessage(text, good)
	lastMessage = text
	if refs.message then
		refs.message.Text = text
		refs.message.TextColor3 = good and UI.Colors.Good or UI.Colors.Bad
	end
end

local function invoke(remote, ...)
	local args = table.pack(...)
	task.spawn(function()
		local ok, result = pcall(function()
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end)
		if ok and type(result) == "table" then
			setMessage(result.msg or "", result.ok)
			Sfx.play(result.ok and "coin" or "down")
		else
			setMessage("Erreur de communication avec le serveur.", false)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- Lignes génériques
-- ---------------------------------------------------------------------------

local function listFrame(parent, position, size)
	local scroll = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 31,
	}, parent)
	UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	return scroll
end

local function row(parent, order, title, desc, buttonText, buttonColor, onClick, swatch)
	local frame = UI.frame(
		parent,
		{ Size = UDim2.new(1, -8, 0, 62), BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = order, ZIndex = 32 }
	)
	UI.corner(frame, 12)
	local left = 10
	if swatch then
		local dot = UI.frame(
			frame,
			{
				Size = UDim2.new(0, 30, 0, 30),
				Position = UDim2.new(0, 10, 0.5, -15),
				BackgroundColor3 = swatch,
				ZIndex = 33,
			}
		)
		UI.corner(dot, 15)
		UI.stroke(dot, UI.Colors.Dark, 2)
		left = 50
	end
	UI.text(
		frame,
		{
			Size = UDim2.new(1, -left - 150, 0, 26),
			Position = UDim2.new(0, left, 0, 6),
			Text = title,
			maxSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 33,
		}
	)
	UI.text(
		frame,
		{
			Size = UDim2.new(1, -left - 150, 0, 22),
			Position = UDim2.new(0, left, 0, 34),
			Text = desc,
			maxSize = 15,
			Font = UI.FontBody,
			TextColor3 = UI.Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			outline = false,
			ZIndex = 33,
		}
	)
	local button = UI.button(frame, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 132, 0, 42),
		Text = buttonText,
		BackgroundColor3 = buttonColor,
		maxSize = 18,
		ZIndex = 33,
	})
	if onClick then
		button.Activated:Connect(onClick)
	else
		button.AutoButtonColor = false
	end
	return frame
end

-- ---------------------------------------------------------------------------
-- Boutique
-- ---------------------------------------------------------------------------

local function renderShop(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		UI.text(
			content,
			{ Size = UDim2.new(1, 0, 0, 40), Text = "Chargement de ton profil...", maxSize = 24, ZIndex = 32 }
		)
		return
	end

	local tabs = {
		{ id = "upgrade", label = "AMÉLIORATIONS" },
		{ id = "hat", label = "CHAPEAUX" },
		{ id = "rope", label = "CORDES" },
	}
	for index, tab in ipairs(tabs) do
		local selected = shopTab == tab.id
		local b = UI.button(content, {
			Position = UDim2.new((index - 1) / 3, 2, 0, 0),
			Size = UDim2.new(1 / 3, -4, 0, 40),
			Text = tab.label,
			BackgroundColor3 = selected and UI.Colors.Accent or UI.Colors.PanelLight,
			TextColor3 = selected and UI.Colors.Dark or UI.Colors.Text,
			maxSize = 20,
			ZIndex = 32,
		})
		b.Activated:Connect(function()
			shopTab = tab.id
			Sfx.play("click")
			renderShop(content)
		end)
	end

	local list = listFrame(content, UDim2.new(0, 0, 0, 48), UDim2.new(1, 0, 1, -48 - 26))
	refs.message = UI.text(
		content,
		{
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.new(0, 0, 1, -24),
			Text = lastMessage,
			maxSize = 18,
			Font = UI.FontBody,
			ZIndex = 32,
		}
	)

	if shopTab == "upgrade" then
		for index, def in ipairs(Config.Upgrades) do
			local level = data.upgrades[def.id] or 0
			local maxed = level >= def.max
			local price = def.costs[level + 1]
			row(
				list,
				index,
				("%s  (niv. %d/%d)"):format(def.name, level, def.max),
				def.desc,
				maxed and "MAX" or (Util.formatNumber(price) .. " pièces"),
				maxed and UI.Colors.Muted or (data.coins >= price and UI.Colors.Good or UI.Colors.Warn),
				(not maxed) and function()
					invoke(Remotes.Buy, "upgrade", def.id)
				end or nil
			)
		end
	else
		local isHat = shopTab == "hat"
		local items = isHat and Config.Hats or Config.Ropes
		local owned = isHat and data.owned.hats or data.owned.ropes
		local equippedId = isHat and data.equipped.hat or data.equipped.rope
		for index, def in ipairs(items) do
			local text, color, handler
			if equippedId == def.id then
				text, color = "ÉQUIPÉ", UI.Colors.Muted
			elseif owned[def.id] then
				text, color = "ÉQUIPER", UI.Colors.Info
				handler = function()
					invoke(Remotes.Equip, isHat and "hat" or "rope", def.id)
				end
			elseif def.pass then
				text, color = "PASS " .. def.pass:upper(), UI.Colors.Muted
			else
				text = Util.formatNumber(def.price) .. " pièces"
				color = data.coins >= def.price and UI.Colors.Good or UI.Colors.Warn
				handler = function()
					invoke(Remotes.Buy, isHat and "hat" or "rope", def.id)
				end
			end
			row(
				list,
				index,
				def.name,
				isHat and "Un look unique pour ton cavalier." or "Change la couleur de ton lasso.",
				text,
				color,
				handler,
				(not isHat) and def.color or nil
			)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Bestiaire
-- ---------------------------------------------------------------------------

local function renderBestiary(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		UI.text(
			content,
			{ Size = UDim2.new(1, 0, 0, 40), Text = "Chargement de ton profil...", maxSize = 24, ZIndex = 32 }
		)
		return
	end

	local found, total = 0, #Species.List * #Config.Variants
	for _, def in ipairs(Species.List) do
		for v = 1, #Config.Variants do
			if (data.tamed[def.id .. "_" .. v] or 0) > 0 then
				found = found + 1
			end
		end
	end
	UI.text(content, {
		Size = UDim2.new(1, 0, 0, 30),
		Text = ("Découvertes : %d / %d   ·   Dompter les 3 variantes d'une espèce rapporte %d pièces !"):format(
			found,
			total,
			Config.Rewards.SpeciesComplete
		),
		maxSize = 18,
		Font = UI.FontBody,
		ZIndex = 32,
	})

	local grid = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 31,
	}, content)
	UI.make(
		"UIGridLayout",
		{
			CellSize = UDim2.new(0, 178, 0, 168),
			CellPadding = UDim2.new(0, 8, 0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
		grid
	)

	for index, def in ipairs(Species.List) do
		local card = UI.frame(grid, { BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = index, ZIndex = 32 })
		UI.corner(card, 12)
		if data.completed[def.id] then
			UI.stroke(card, UI.Colors.Accent, 3)
		end
		UI.text(
			card,
			{
				Size = UDim2.new(1, -12, 0, 24),
				Position = UDim2.new(0, 6, 0, 4),
				Text = def.name,
				maxSize = 20,
				ZIndex = 33,
			}
		)
		UI.text(
			card,
			{
				Size = UDim2.new(1, -12, 0, 44),
				Position = UDim2.new(0, 6, 0, 28),
				Text = def.desc,
				maxSize = 13,
				Font = UI.FontBody,
				TextColor3 = UI.Colors.Muted,
				outline = false,
				ZIndex = 33,
			}
		)
		for v, variant in ipairs(Config.Variants) do
			local count = data.tamed[def.id .. "_" .. v] or 0
			local swatch = UI.frame(card, {
				Position = UDim2.new(0, 10 + (v - 1) * 54, 0, 78),
				Size = UDim2.new(0, 46, 0, 46),
				BackgroundColor3 = count > 0 and variantColor(def.palette.body, v) or Color3.fromRGB(40, 44, 58),
				ZIndex = 33,
			})
			UI.corner(swatch, 10)
			UI.stroke(swatch, UI.Colors.Dark, 2)
			UI.text(
				swatch,
				{
					Size = UDim2.new(1, 0, 1, 0),
					Text = count > 0 and "" or "?",
					maxSize = 26,
					TextColor3 = UI.Colors.Muted,
					ZIndex = 34,
				}
			)
			UI.text(card, {
				Size = UDim2.new(0, 50, 0, 16),
				Position = UDim2.new(0, 8 + (v - 1) * 54, 0, 128),
				Text = count > 0 and ("x" .. count) or variant.name,
				maxSize = 13,
				Font = UI.FontBody,
				TextColor3 = count > 0 and UI.Colors.Good or UI.Colors.Muted,
				outline = false,
				ZIndex = 33,
			})
		end
		if data.completed[def.id] then
			UI.text(
				card,
				{
					Size = UDim2.new(1, -12, 0, 14),
					Position = UDim2.new(0, 6, 1, -16),
					Text = "ESPÈCE COMPLÈTE",
					maxSize = 12,
					TextColor3 = UI.Colors.Accent,
					outline = false,
					ZIndex = 33,
				}
			)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Quêtes et cadeau du jour
-- ---------------------------------------------------------------------------

local function renderQuests(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		UI.text(
			content,
			{ Size = UDim2.new(1, 0, 0, 40), Text = "Chargement de ton profil...", maxSize = 24, ZIndex = 32 }
		)
		return
	end

	local list = listFrame(content, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, -26))
	refs.message = UI.text(
		content,
		{
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.new(0, 0, 1, -24),
			Text = lastMessage,
			maxSize = 18,
			Font = UI.FontBody,
			ZIndex = 32,
		}
	)

	local daily = data.daily
	row(
		list,
		1,
		"Cadeau du jour",
		daily.claimable and ("+%d pièces · série actuelle : %d jour(s)"):format(daily.reward, daily.streak)
			or "Déjà récupéré. Reviens demain pour prolonger ta série !",
		daily.claimable and "RÉCUPÉRER" or "REVIENS DEMAIN",
		daily.claimable and UI.Colors.Good or UI.Colors.Muted,
		daily.claimable and function()
			invoke(Remotes.ClaimDaily)
		end or nil
	)

	for index, quest in ipairs(data.quests) do
		local done = quest.progress >= quest.target
		local text, color, handler
		if quest.claimed then
			text, color = "FAIT", UI.Colors.Muted
		elseif done then
			text, color = ("+%d pièces"):format(quest.reward), UI.Colors.Good
			handler = function()
				invoke(Remotes.ClaimQuest, index)
			end
		else
			text, color = ("%d/%d"):format(quest.progress, quest.target), UI.Colors.PanelLight
		end
		row(list, 1 + index, quest.label, ("Récompense : %d pièces"):format(quest.reward), text, color, handler)
	end

	local stats = UI.frame(
		list,
		{ Size = UDim2.new(1, -8, 0, 92), BackgroundColor3 = UI.Colors.Panel, LayoutOrder = 10, ZIndex = 32 }
	)
	UI.corner(stats, 12)
	UI.stroke(stats, UI.Colors.PanelLight, 2)
	local lines = {
		("Meilleur score : %s   ·   Victoires : %d   ·   Manches : %d"):format(
			Util.formatNumber(data.bestScore),
			data.wins,
			data.rounds
		),
		("Bêtes dressées : %d   ·   Lassos : %d   ·   Distance : %s m"):format(
			data.tamedTotal,
			data.hooks,
			Util.formatNumber(data.distance)
		),
	}
	if data.persistent == false then
		table.insert(lines, "Sauvegarde indisponible : ta progression ne sera pas enregistrée.")
	end
	UI.text(
		stats,
		{
			Size = UDim2.new(1, -16, 1, -12),
			Position = UDim2.new(0, 8, 0, 6),
			Text = table.concat(lines, "\n"),
			maxSize = 18,
			Font = UI.FontBody,
			outline = false,
			ZIndex = 33,
		}
	)
end

-- ---------------------------------------------------------------------------
-- Boutique Robux
-- ---------------------------------------------------------------------------

local function renderRobux(content)
	clear(content)
	local data = ClientState.Data
	if not data or not data.loaded then
		UI.text(
			content,
			{ Size = UDim2.new(1, 0, 0, 40), Text = "Chargement de ton profil...", maxSize = 24, ZIndex = 32 }
		)
		return
	end
	local list = listFrame(content, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0))
	local store = data.store or { passes = {}, products = {} }
	local order = 0

	local function header(text)
		order = order + 1
		UI.text(
			list,
			{
				Size = UDim2.new(1, -8, 0, 30),
				Text = text,
				maxSize = 22,
				TextColor3 = UI.Colors.Accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = order,
				ZIndex = 32,
			}
		)
	end
	local function priceText(entry)
		if not entry.available then
			return "BIENTÔT"
		end
		return entry.price and ("R$ " .. entry.price) or "ACHETER"
	end

	header("PASS PERMANENTS")
	for _, entry in ipairs(store.passes) do
		order = order + 1
		local owned = data.passes and data.passes[entry.key]
		local handler = nil
		if entry.available and not owned then
			handler = function()
				Sfx.play("click")
				Remotes.Prompt:FireServer("pass", entry.key)
			end
		end
		row(
			list,
			order,
			entry.name,
			entry.desc,
			owned and "POSSÉDÉ" or priceText(entry),
			owned and UI.Colors.Muted or (entry.available and UI.Colors.Good or UI.Colors.PanelLight),
			handler
		)
	end

	header("PAQUETS DE PIÈCES")
	for _, entry in ipairs(store.products) do
		order = order + 1
		local handler = nil
		if entry.available then
			handler = function()
				Sfx.play("click")
				Remotes.Prompt:FireServer("product", entry.key)
			end
		end
		row(
			list,
			order,
			entry.name,
			("+%s pièces, utilisables dans la boutique"):format(Util.formatNumber(entry.coins)),
			priceText(entry),
			entry.available and UI.Colors.Good or UI.Colors.PanelLight,
			handler
		)
	end
end

-- ---------------------------------------------------------------------------
-- Panneau et boutons
-- ---------------------------------------------------------------------------

local RENDERERS = {
	shop = { title = "BOUTIQUE", fn = renderShop },
	bestiary = { title = "BESTIAIRE", fn = renderBestiary },
	quests = { title = "QUÊTES & CADEAU", fn = renderQuests },
	robux = { title = "BOUTIQUE ROBUX", fn = renderRobux },
}

local function render()
	if openName and RENDERERS[openName] then
		refs.title.Text = RENDERERS[openName].title
		RENDERERS[openName].fn(refs.content)
	end
end

local function open(name)
	openName = name
	refs.panel.Visible = true
	Sfx.play("click")
	render()
end

local function close()
	openName = nil
	refs.panel.Visible = false
	Sfx.play("click")
end

local function questBadge()
	local data = ClientState.Data
	if not data or not data.loaded then
		return false
	end
	if data.daily.claimable then
		return true
	end
	for _, quest in ipairs(data.quests) do
		if not quest.claimed and quest.progress >= quest.target then
			return true
		end
	end
	return false
end

local function refreshChrome()
	local data = ClientState.Data
	if data and data.loaded then
		refs.coins.Text = "Pièces : " .. Util.formatNumber(data.coins)
	else
		refs.coins.Text = "Chargement..."
	end
	refs.badge.Visible = questBadge()
end

local function refreshVisibility()
	local visible = not ClientState.isPlaying()
	refs.buttons.Visible = visible
	refs.coinsBox.Visible = visible
	if not visible and openName then
		close()
	end
end

function Menu.init()
	local gui = UI.make("ScreenGui", {
		Name = "HerdHopperMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- colonne de boutons
	refs.buttons = UI.frame(gui, {
		Name = "Buttons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.new(0, 150, 0, 4 * 52),
		BackgroundTransparency = 1,
	})
	UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, refs.buttons)
	local defs = {
		{ id = "shop", label = "BOUTIQUE", color = UI.Colors.Accent },
		{ id = "bestiary", label = "BESTIAIRE", color = UI.Colors.Info },
		{ id = "quests", label = "QUÊTES", color = UI.Colors.Good },
		{ id = "robux", label = "ROBUX", color = Color3.fromRGB(255, 120, 90) },
	}
	for index, def in ipairs(defs) do
		local b = UI.button(
			refs.buttons,
			{
				Size = UDim2.new(1, 0, 0, 46),
				Text = def.label,
				BackgroundColor3 = def.color,
				LayoutOrder = index,
				maxSize = 22,
			}
		)
		b.Activated:Connect(function()
			if openName == def.id then
				close()
			else
				open(def.id)
			end
		end)
		if def.id == "quests" then
			refs.badge = UI.frame(
				b,
				{
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 4, 0, -4),
					Size = UDim2.new(0, 16, 0, 16),
					BackgroundColor3 = UI.Colors.Bad,
					Visible = false,
					ZIndex = 5,
				}
			)
			UI.corner(refs.badge, 8)
			UI.stroke(refs.badge, UI.Colors.Dark, 2)
		end
	end

	-- pièces
	refs.coinsBox = UI.frame(gui, {
		Name = "Coins",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(0, 190, 0, 40),
		BackgroundTransparency = 0.15,
	})
	UI.corner(refs.coinsBox, 12)
	UI.stroke(refs.coinsBox, UI.Colors.Dark, 2)
	refs.coins = UI.text(
		refs.coinsBox,
		{
			Size = UDim2.new(1, -12, 1, -8),
			Position = UDim2.new(0, 6, 0, 4),
			Text = "Chargement...",
			maxSize = 22,
			TextColor3 = UI.Colors.Accent,
		}
	)

	-- panneau modal
	refs.panel = UI.frame(gui, {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.8, 0, 0.84, 0),
		Visible = false,
		ZIndex = 30,
	})
	UI.make("UISizeConstraint", { MaxSize = Vector2.new(780, 520), MinSize = Vector2.new(320, 240) }, refs.panel)
	UI.corner(refs.panel, 18)
	UI.stroke(refs.panel, UI.Colors.Accent, 3)
	refs.title = UI.text(
		refs.panel,
		{
			Size = UDim2.new(1, -120, 0, 44),
			Position = UDim2.new(0, 16, 0, 8),
			Text = "",
			maxSize = 32,
			TextColor3 = UI.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 31,
		}
	)
	local closeButton = UI.button(refs.panel, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 84, 0, 38),
		Text = "FERMER",
		BackgroundColor3 = UI.Colors.Bad,
		TextColor3 = UI.Colors.Text,
		maxSize = 18,
		ZIndex = 31,
	})
	closeButton.Activated:Connect(close)
	refs.content = UI.frame(refs.panel, {
		Position = UDim2.new(0, 14, 0, 58),
		Size = UDim2.new(1, -28, 1, -70),
		BackgroundTransparency = 1,
		ZIndex = 31,
	})

	ClientState.connect("Data", function()
		refreshChrome()
		if openName then
			render()
		end
	end)
	ClientState.connect("Status", refreshVisibility)
	refreshChrome()
	refreshVisibility()
end

return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[-- Audio : effets sonores (fichiers fournis avec le client Roblox) et musique par lieu avec fondu enchaîné.
-- Les musiques se règlent dans Config.Audio.Music ; vides par défaut. Deux SoundGroups (Musique / Effets)
-- permettent le réglage du volume et le mode muet.

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sfx = {}

-- Fichiers du client Roblox. Si l'un manque, le son est simplement muet.
local SOUNDS = {
	launch = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.6, pitch = 1.2 },
	land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.5, pitch = 0.9 },
	hook = { id = "rbxasset://sounds/snap.mp3", volume = 0.7, pitch = 1.1 },
	tame = { id = "rbxasset://sounds/victory.wav", volume = 0.6, pitch = 1.3 },
	down = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.6, pitch = 1 },
	tick = { id = "rbxasset://sounds/button.wav", volume = 0.6, pitch = 1 },
	go = { id = "rbxasset://sounds/switch.wav", volume = 0.8, pitch = 0.9 },
	geyser = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.7, pitch = 1 },
	boom = { id = "rbxasset://sounds/impact_explosion_03.mp3", volume = 0.8, pitch = 1 },
	win = { id = "rbxasset://sounds/victory.wav", volume = 0.8, pitch = 1 },
	coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.2 },
	click = { id = "rbxasset://sounds/button.wav", volume = 0.4, pitch = 1.4 },
}

local MODES = { "all", "sfx", "mute" }
local MODE_LABELS = { all = "SON : TOUT", sfx = "SON : EFFETS", mute = "SON : MUET" }

local mode = "all"
local musicGroup, sfxGroup = nil, nil
local current = nil -- { key, sound }

local function applyVolumes()
	if not musicGroup then
		return
	end
	musicGroup.Volume = mode == "all" and Config.Audio.MusicVolume or 0
	sfxGroup.Volume = mode == "mute" and 0 or Config.Audio.SfxVolume
end

function Sfx.init()
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "HHMusic"
	musicGroup.Parent = SoundService
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "HHSfx"
	sfxGroup.Parent = SoundService
	applyVolumes()
end

function Sfx.play(name)
	local def = SOUNDS[name]
	if not def or mode == "mute" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.id
	sound.Volume = def.volume
	sound.PlaybackSpeed = def.pitch
	sound.SoundGroup = sfxGroup
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

-- Joue la musique d'un lieu (clé de Config.Audio.Music) avec un fondu enchaîné. Sans identifiant : silence.
function Sfx.setMusic(key)
	if current and current.key == key then
		return
	end
	local fade = Config.Audio.FadeSeconds
	if current then
		local old = current.sound
		TweenService:Create(old, TweenInfo.new(fade), { Volume = 0 }):Play()
		Debris:AddItem(old, fade + 0.2)
		current = nil
	end
	local id = Config.Audio.Music[key]
	if type(id) ~= "string" or id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. key
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.SoundGroup = musicGroup
	sound.Parent = SoundService
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(fade), { Volume = 1 }):Play()
	current = { key = key, sound = sound }
end

function Sfx.cycleMode()
	local index = table.find(MODES, mode) or 1
	mode = MODES[index % #MODES + 1]
	applyVolumes()
	return MODE_LABELS[mode]
end

function Sfx.modeLabel()
	return MODE_LABELS[mode]
end

return Sfx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Petite boîte à outils d'interface dans le style Roblox (coins arrondis, police Fredoka).

local TweenService = game:GetService("TweenService")

local UI = {}

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

UI.Colors = {
	Panel = C(30, 36, 56),
	PanelLight = C(46, 54, 84),
	Accent = C(255, 200, 70),
	Good = C(90, 200, 110),
	Bad = C(230, 80, 80),
	Warn = C(255, 150, 60),
	Info = C(110, 200, 255),
	Text = C(255, 255, 255),
	Muted = C(170, 182, 210),
	Dark = C(18, 22, 36),
}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamMedium

function UI.make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props or {}) do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(parent, radius)
	return UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

function UI.stroke(parent, color, thickness, transparency)
	return UI.make("UIStroke", {
		Color = color or UI.Colors.Dark,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function UI.frame(parent, props)
	local p = { BackgroundColor3 = UI.Colors.Panel, BorderSizePixel = 0 }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UI.make("Frame", p, parent)
end

-- Texte avec contour ; textSize = taille maximale (le texte se réduit pour tenir dans le cadre).
function UI.text(parent, props)
	local p = {
		BackgroundTransparency = 1,
		TextColor3 = UI.Colors.Text,
		Font = UI.Font,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
		BorderSizePixel = 0,
	}
	local maxSize = props.maxSize or 28
	local outline = props.outline
	for k, v in pairs(props) do
		if k ~= "maxSize" and k ~= "outline" then
			p[k] = v
		end
	end
	local label = UI.make("TextLabel", p, parent)
	UI.make("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8 }, label)
	if outline ~= false then
		UI.make("UIStroke", {
			Color = UI.Colors.Dark,
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}, label)
	end
	return label
end

function UI.button(parent, props)
	local p = {
		BackgroundColor3 = UI.Colors.Accent,
		TextColor3 = UI.Colors.Dark,
		Font = UI.Font,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
	}
	local maxSize = props.maxSize or 24
	for k, v in pairs(props) do
		if k ~= "maxSize" then
			p[k] = v
		end
	end
	local button = UI.make("TextButton", p, parent)
	UI.corner(button, 12)
	UI.stroke(button, UI.Colors.Dark, 2)
	UI.make("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8 }, button)

	local base = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.1), { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.18) })
			:Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.1), { BackgroundColor3 = base }):Play()
	end)
	return button
end

function UI.tween(inst, seconds, props, style)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item></Item>
</roblox>
