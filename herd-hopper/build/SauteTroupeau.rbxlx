-- Alias conservé : les décors et l'ambiance utilisent « biome » comme « zone ».
Config.Biomes = Config.Zones

function Config.zoneIndex(z)
	for index, zone in ipairs(Config.Zones) do
		if z < zone.to then
			return index
		end
	end
	return #Config.Zones
end

function Config.zoneAt(z)
	return Config.Zones[Config.zoneIndex(z)]
end

Config.biomeAt = Config.zoneAt

function Config.zoneByKey(key)
	for index, zone in ipairs(Config.Zones) do
		if zone.key == key then
			return zone, index
		end
	end
	return nil, nil
end

function Config.findById(list, id)
	for _, item in ipairs(list) do
		if item.id == id then
			return item
		end
	end
	return nil
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Création / récupération des RemoteEvents et RemoteFunctions.
-- Le serveur crée tout au démarrage ; le client attend leur réplication.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Hook", -- C->S : id de la bête visée
	"Launch", -- C->S : quitter la monture
	"Steer", -- C->S : direction latérale [-1, 1]
	"Collect", -- C->S : récupérer l'animal monté (une fois sa confiance gagnée)
	"Lasso", -- C->S : lancer le lasso de capture sur un animal à cœur
	"Ready", -- C->S : partir en expédition (zone choisie, prêt oui/non)
	"Prompt", -- C->S : demande d'achat Robux (kind, key)
	"Data", -- S->C : profil du joueur
	"Status", -- S->C : état du joueur (Lobby, Riding, Air, Hooking, Down, Dead, Finished)
	"Launched", -- S->C : vitesse initiale du bond
	"Feedback", -- S->C : messages / effets
	"Scores", -- S->C : classement en direct
	"Results", -- S->C : résultats de manche
}

local FUNCTIONS = {
	"Buy",
	"Equip",
	"ClaimDaily",
	"ClaimQuest",
	"ZooAction", -- améliorations, caisse, histoire
}

local isServer = RunService:IsServer()
local folder

if isServer then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Remotes = {}

local function fetch(name, className)
	local remote = folder:FindFirstChild(name)
	if remote then
		return remote
	end
	if isServer then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name)
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = fetch(name, "RemoteEvent")
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = fetch(name, "RemoteFunction")
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Species</string><ProtectedString name="Source"><![CDATA[-- Les 7 espèces de bêtes. Chaque bête est construite en blocs Roblox (aucun asset externe).
-- Repère local : l'avant est -Z, le dessus est +Y. Les offsets "o" sont relatifs au centre du corps.
-- Palette : body / dark / light / accent / eye.

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function addEyes(parts, y, z, dx)
	table.insert(parts, { n = "EyeL", s = V(0.45, 0.55, 0.3), o = V(-dx, y, z), c = "eye" })
	table.insert(parts, { n = "EyeR", s = V(0.45, 0.55, 0.3), o = V(dx, y, z), c = "eye" })
end

-- Quatre pattes en trot diagonal.
local function quadLegs(size, hipY, hx, hz)
	return {
		{ n = "LegFL", s = size, hip = V(-hx, hipY, -hz), phase = 0, c = "dark" },
		{ n = "LegFR", s = size, hip = V(hx, hipY, -hz), phase = math.pi, c = "dark" },
		{ n = "LegBL", s = size, hip = V(-hx, hipY, hz), phase = math.pi, c = "dark" },
		{ n = "LegBR", s = size, hip = V(hx, hipY, hz), phase = 0, c = "dark" },
	}
end

local Species = {}

Species.List = {}

local function add(def)
	def.seat = V(0, def.seatY or (def.body.s.Y / 2 + 2.1), def.seatZ or 0.4)
	table.insert(Species.List, def)
end

-- Copie agrandie d'une espèce (pour les boss). Toutes les dimensions sont multipliées par k.
local function scaled(base, k, patch)
	local function sv(v)
		return v * k
	end
	local def = table.clone(base)
	def.body = { s = sv(base.body.s), c = base.body.c }
	def.rootY = base.rootY * k
	def.seat = nil
	def.seatY = (base.seatY or (base.body.s.Y / 2 + 2.1)) * k
	def.parts = {}
	for _, part in ipairs(base.parts) do
		table.insert(def.parts, { n = part.n, s = sv(part.s), o = sv(part.o), c = part.c, rot = part.rot })
	end
	def.legs = {}
	for _, leg in ipairs(base.legs) do
		table.insert(def.legs, { n = leg.n, s = sv(leg.s), hip = sv(leg.hip), phase = leg.phase, c = leg.c })
	end
	def.wings = {}
	for _, wing in ipairs(base.wings) do
		table.insert(def.wings, { n = wing.n, s = sv(wing.s), hip = sv(wing.hip), side = wing.side, c = wing.c })
	end
	for key, value in pairs(patch) do
		def[key] = value
	end
	return def
end

-- 1. Sanglier : petit, zigzag.
