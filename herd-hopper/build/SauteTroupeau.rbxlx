}
boss.dragon = {
	id = "dragon",
	name = "Dragon Ancien",
	desc = "Le maître du volcan. Il crache la braise.",
	speed = 54,
	value = 14,
	palette = {
		body = C(190, 40, 40),
		dark = C(110, 20, 30),
		light = C(255, 220, 160),
		accent = C(255, 150, 30),
		eye = C(255, 240, 80),
	},
}
addBoss("mammoth", 1.5, boss.elephant)
addBoss("crocodile", 1.9, boss.croc_king)
addBoss("lion", 1.8, boss.sphinx)
addBoss("wyvern", 1.9, boss.dragon)

Species.ById = {}
for _, def in ipairs(Species.List) do
	Species.ById[def.id] = def
end
Species.ById_ = nil

function Species.isBoss(def)
	return def.boss == true
end

-- Nombre de variantes obtenables : 3 pour un animal normal, 1 pour un boss.
function Species.variantCount(def, totalVariants)
	return def.boss and 1 or totalVariants
end

return Species
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Petits utilitaires partagés (serveur + client).

local Util = {}

function Util.create(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Anti-spam des RemoteEvents : renvoie false si l'appel est trop rapproché.
local lastCall = {}

function Util.allow(player, key, interval)
	local now = os.clock()
	local bucket = lastCall[player]
	if not bucket then
		bucket = {}
		lastCall[player] = bucket
	end
	local last = bucket[key]
	if last and now - last < interval then
		return false
	end
	bucket[key] = now
	return true
end

function Util.forget(player)
	lastCall[player] = nil
end

function Util.pickWeighted(list, rng)
	local total = 0
	for _, item in ipairs(list) do
		total = total + item.weight
	end
	local roll = rng:NextNumber() * total
	for _, item in ipairs(list) do
		roll = roll - item.weight
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

function Util.formatNumber(n)
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^%s+", ""))
end

function Util.formatTime(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Util.isFiniteNumber(v)
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Zoo</string><ProtectedString name="Source"><![CDATA[-- Formules du zoo (pures, sans API Roblox : testées avec Lune).
-- Un animal du zoo est identifié par "<espèce>_<variante>" (ex. "boar_2" = Phacochère Cristal).

local Config = require(script.Parent.Config)
local Species = require(script.Parent.Species)

local Zoo = {}

function Zoo.key(speciesId, variantIdx)
	return speciesId .. "_" .. variantIdx
end

-- Renvoie def, variantIdx pour une clé de zoo, ou nil.
function Zoo.parseKey(key)
	if type(key) ~= "string" then
		return nil, nil
	end
	local id, v = key:match("^(.+)_(%d+)$")
	local def = id and Species.ById[id]
	local variant = tonumber(v)
	if not def or not variant or not Config.Variants[variant] then
		return nil, nil
	end
	if def.boss and variant ~= 1 then
		return nil, nil
	end
	return def, variant
end

function Zoo.variantMult(def, variantIdx)
	if def.boss then
		return 1
	end
	return Config.Variants[variantIdx].mult
end

-- Revenu d'un animal par minute (avant visiteurs et boost).
function Zoo.animalIncome(def, variantIdx, level)
	local z = Config.Zoo
	return z.IncomePerMinute * def.value * Zoo.variantMult(def, variantIdx) * (1 + z.LevelBonus * (level - 1))
end

-- Coût en os pour passer de `level` à `level + 1` ; nil si niveau maximum.
function Zoo.upgradeCost(def, variantIdx, level)
	local z = Config.Zoo
	if level >= z.MaxAnimalLevel then
		return nil
	end
	local factor = def.boss and 3 or z.BoneCostByVariant[variantIdx]
	return math.ceil(z.BoneCostBase * z.BoneCostGrowth ^ (level - 1) * factor)
end

-- Os gagnés quand on récupère un animal déjà possédé.
function Zoo.duplicateBones(def, variantIdx)
	if def.boss then
		return Config.Zoo.BossBones
	end
	return Config.Zoo.DuplicateBones * Config.Variants[variantIdx].mult
end

-- animals = { [key] = { level = n } } ; renvoie le revenu total par minute avant visiteurs.
function Zoo.baseIncome(animals)
	local total = 0
	for key, entry in pairs(animals) do
		local def, variant = Zoo.parseKey(key)
		if def then
			total = total + Zoo.animalIncome(def, variant, entry.level or 1)
		end
	end
	return total
end

function Zoo.visitorFactor(visitorLevel, hasZooPass)
	local factor = 1 + Config.Zoo.VisitorBonus * visitorLevel
	if hasZooPass then
		factor = factor * Config.Zoo.PassVisitorFactor
	end
	return factor
end

function Zoo.slots(slotLevel, hasZooPass)
	local n = Config.Zoo.BaseSlots + Config.Zoo.SlotsPerLevel * slotLevel
	if hasZooPass then
		n = n + Config.Zoo.PassSlots
	end
	return math.min(n, Config.Zoo.MaxSlots)
end

function Zoo.storageMinutes(storageLevel)
	return Config.Zoo.StorageBaseMinutes + Config.Zoo.StoragePerLevel * storageLevel
end

-- Or en attente dans la caisse : revenu par seconde × temps écoulé, plafonné par la capacité.
-- `boostUntil` : instant (os.time) de fin du boost ; le boost ne compte que pendant sa durée.
function Zoo.pendingGold(ratePerMinute, lastCollect, now, storageLevel, boostUntil)
	local capSeconds = Zoo.storageMinutes(storageLevel) * 60
	local elapsed = math.clamp(now - lastCollect, 0, math.min(capSeconds, Config.Zoo.MaxOfflineMinutes * 60))
	local boosted = 0
	if boostUntil and boostUntil > lastCollect then
		boosted = math.clamp(math.min(boostUntil, now) - lastCollect, 0, elapsed)
	end
	local seconds = elapsed + boosted * (Config.Zoo.BoostFactor - 1)
	return math.floor(ratePerMinute / 60 * seconds)
end

-- Or d'une expédition : points × coefficient, bonus boutique de souvenirs et pass.
function Zoo.runGold(score, giftLevel, hasGoldPass)
	local gold = score * Config.Rewards.ScoreToCoins * (1 + Config.Zoo.GiftBonus * giftLevel)
	if hasGoldPass then
		gold = gold * Config.Monetization.GoldPassFactor
	end
	return math.floor(gold)
end

-- Nombre d'animaux différents possédés (clés valides).
function Zoo.countOwned(animals)
	local n = 0
	for key in pairs(animals) do
		if Zoo.parseKey(key) then
			n = n + 1
		end
	end
	return n
end

function Zoo.zoneUnlocked(zone, animals)
	return Zoo.countOwned(animals) >= zone.unlock
end

return Zoo
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX22"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX21"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Point d'entrée serveur de Saute-Troupeau.
-- Ordre : remotes -> services -> construction de la carte -> apparition des joueurs -> boucle de manches.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

-- Les joueurs n'apparaissent qu'une fois la carte construite.
Players.CharacterAutoLoads = false
Players.RespawnTime = 3
Workspace.Gravity = Config.Gravity

local Modules = script:WaitForChild("Modules")
local State = require(Modules.State)
local DataService = require(Modules.DataService)
local ProgressService = require(Modules.ProgressService)
local CreatureService = require(Modules.CreatureService)
local RideService = require(Modules.RideService)
local ZooService = require(Modules.ZooService)
local EventService = require(Modules.EventService)
local MapBuilder = require(Modules.MapBuilder)
local RoundService = require(Modules.RoundService)
local MonetizationService = require(Modules.MonetizationService)

-- Les joueurs ne se bousculent pas (sinon les cavaliers se percutent en l'air).
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
end)
pcall(function()
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

local function setCollisionGroup(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end)
end

-- Ramène le joueur devant son zoo (sauf s'il est en expédition).
local function goHome(player, character)
	local home = State.PlotCFrames[player]
	if not home or State.Participants[player] then
		return
	end
	local hrp = character:WaitForChild("HumanoidRootPart", 5)
	if hrp and character.Parent then
		character:PivotTo(home)
	end
end

local function onCharacterAdded(player, character)
	setCollisionGroup(character)
	task.spawn(function()
		character:WaitForChild("Humanoid", 10)
		character:WaitForChild("Head", 10)
		ProgressService.ApplyCosmetics(player)
		goHome(player, character)
	end)
	Remotes.Status:FireClient(player, "Lobby")
end

local handled = {}

local function onPlayerAdded(player)
	if handled[player] then
		return
	end
	handled[player] = true
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	task.spawn(function()
		DataService.Load(player)
		MonetizationService.LoadPasses(player)
		if not player.Parent then
			DataService.Release(player)
			return
		end
		ProgressService.EnsureDaily(player)
		ProgressService.RefreshAttributes(player)
		ZooService.OnPlayerReady(player)
		if player.Character then
			goHome(player, player.Character)
		end
		Remotes.Data:FireClient(player, ProgressService.Snapshot(player))
		ProgressService.ApplyCosmetics(player)
		if not DataService.IsPersistent(player) then
			Remotes.Feedback:FireClient(player, {
				kind = "warn",
				title = "SAUVEGARDE INDISPONIBLE",
				sub = "Ta progression ne sera pas enregistrée pendant cette session.",
			})
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	handled[player] = nil
	DataService.Release(player)
end)

DataService.Init()
ProgressService.Init()
RideService.Init()
ZooService.Init()
MonetizationService.Init()

-- Carte (peut durer quelques secondes ; les joueurs attendent sans apparaître)
MapBuilder.Build()
State.MapReady = true
Players.CharacterAutoLoads = true

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
	task.spawn(function()
		player:LoadCharacter()
	end)
end

-- Simulation
RunService.Heartbeat:Connect(function(dt)
	if State.Phase ~= "Running" then
		return
	end
	dt = math.min(dt, 0.1)
	State.RunElapsed = State.RunElapsed + dt
	CreatureService.Step(dt)
	RideService.Step(dt)
	EventService.Step(State.RunElapsed)
end)

-- Classement mondial du salon
task.spawn(function()
	task.wait(4)
	while true do
		MapBuilder.RefreshBoard()
		task.wait(90)
	end
end)

task.spawn(RoundService.Run)
]]></ProtectedString></Properties><Item class="Folder" referent="RBX20"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[-- Chapeaux : construits en blocs et soudés à la tête du personnage.

local Cosmetics = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Décalages relatifs au centre de la tête (le dessus de la tête est à y = +0.5).
-- shape : "Block" (défaut), "Ball" ou "Cyl" ; rot en degrés.
local HATS = {
	beanie = {
		{ s = V(2.3, 1.6, 2.3), o = V(0, 0.55, 0), c = C(214, 60, 60), shape = "Ball" },
		{ s = V(2.2, 0.35, 2.2), o = V(0, 0.15, 0), c = C(255, 255, 255) },
		{ s = V(0.9, 0.9, 0.9), o = V(0, 1.5, 0), c = C(255, 255, 255), shape = "Ball" },
	},
	cowboy = {
		{ s = V(0.2, 4.4, 4.4), o = V(0, 0.6, 0), c = C(150, 96, 56), shape = "Cyl", rot = V(0, 0, 90) },
		{ s = V(2.2, 1.3, 2.2), o = V(0, 1.2, 0), c = C(150, 96, 56) },
		{ s = V(2.3, 0.3, 2.3), o = V(0, 0.85, 0), c = C(80, 50, 30) },
	},
	viking = {
		{ s = V(2.4, 2.0, 2.4), o = V(0, 0.5, 0), c = C(150, 152, 160), mat = Enum.Material.Metal, shape = "Ball" },
		{ s = V(0.5, 1.4, 0.5), o = V(-1.3, 1.0, 0), c = C(240, 232, 205), rot = V(0, 0, 20) },
		{ s = V(0.5, 1.4, 0.5), o = V(1.3, 1.0, 0), c = C(240, 232, 205), rot = V(0, 0, -20) },
		{ s = V(0.5, 0.8, 0.5), o = V(-1.75, 1.9, 0), c = C(240, 232, 205), rot = V(0, 0, 40) },
		{ s = V(0.5, 0.8, 0.5), o = V(1.75, 1.9, 0), c = C(240, 232, 205), rot = V(0, 0, -40) },
	},
	wizard = {
		{ s = V(3.2, 0.2, 3.2), o = V(0, 0.6, 0), c = C(90, 50, 150) },
		{ s = V(2.2, 1.2, 2.2), o = V(0, 1.2, 0), c = C(90, 50, 150) },
		{ s = V(1.6, 1.2, 1.6), o = V(0, 2.4, 0), c = C(90, 50, 150) },
		{ s = V(1.0, 1.2, 1.0), o = V(0, 3.6, 0), c = C(90, 50, 150) },
		{ s = V(0.5, 0.8, 0.5), o = V(0, 4.5, 0), c = C(90, 50, 150) },
		{ s = V(0.7, 0.7, 0.7), o = V(0, 5.1, 0), c = C(255, 225, 80), mat = Enum.Material.Neon, shape = "Ball" },
	},
	dino = {
		{ s = V(2.3, 1.2, 2.3), o = V(0, 0.7, 0), c = C(96, 166, 98) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, 0.6), c = C(230, 120, 60) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, 0), c = C(230, 120, 60) },
		{ s = V(0.4, 0.8, 0.8), o = V(0, 1.6, -0.6), c = C(230, 120, 60) },
		{ s = V(0.6, 0.6, 0.6), o = V(-0.6, 1.3, -0.9), c = C(255, 255, 255), shape = "Ball" },
		{ s = V(0.6, 0.6, 0.6), o = V(0.6, 1.3, -0.9), c = C(255, 255, 255), shape = "Ball" },
	},
	vip = {
		{ s = V(2.2, 0.5, 2.2), o = V(0, 0.75, 0), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{
			s = V(0.6, 1.8, 0.6),
			o = V(-1.3, 1.5, 0),
			c = C(255, 214, 90),
			mat = Enum.Material.Metal,
			rot = V(0, 0, 25),
		},
		{
			s = V(0.6, 1.8, 0.6),
			o = V(1.3, 1.5, 0),
			c = C(255, 214, 90),
			mat = Enum.Material.Metal,
			rot = V(0, 0, -25),
		},
		{
			s = V(0.5, 1.0, 0.5),
			o = V(-1.9, 2.5, 0),
			c = C(255, 245, 180),
			mat = Enum.Material.Neon,
			rot = V(0, 0, 45),
		},
		{
			s = V(0.5, 1.0, 0.5),
			o = V(1.9, 2.5, 0),
			c = C(255, 245, 180),
			mat = Enum.Material.Neon,
			rot = V(0, 0, -45),
		},
	},
	crown = {
		{ s = V(2.2, 0.8, 2.2), o = V(0, 0.9, 0), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(-0.8, 1.7, -0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(0.8, 1.7, -0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(-0.8, 1.7, 0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.9, 0.5), o = V(0.8, 1.7, 0.8), c = C(255, 205, 60), mat = Enum.Material.Metal },
		{ s = V(0.5, 0.5, 0.3), o = V(0, 0.9, -1.15), c = C(255, 60, 90), mat = Enum.Material.Neon },
	},
}

function Cosmetics.remove(character)
	local old = character:FindFirstChild("HHHat")
	if old then
		old:Destroy()
	end
end

function Cosmetics.applyHat(character, hatId)
	Cosmetics.remove(character)
	local spec = HATS[hatId]
	if not spec then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end

	local model = Instance.new("Model")
	model.Name = "HHHat"
	for index, def in ipairs(spec) do
		local part = Instance.new("Part")
		part.Name = "HatPart" .. index
		part.Size = def.s
		part.Color = def.c
		part.Material = def.mat or Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.CastShadow = false
		if def.shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif def.shape == "Cyl" then
			part.Shape = Enum.PartType.Cylinder
		end
		local rot = def.rot or Vector3.new(0, 0, 0)
		part.CFrame = head.CFrame * CFrame.new(def.o) * CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end
	model.Parent = character
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">CreatureService</string><ProtectedString name="Source"><![CDATA[-- Troupeau : construction des bêtes, déplacement, apparition / disparition.
-- Chaque bête = un Model dont seule la pièce "Root" est ancrée ; les autres pièces sont soudées.
-- Déplacer Root (CFrame) déplace tout le monde et ne réplique qu'une pièce.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Util = require(Shared.Util)

local State = require(script.Parent.State)

local CreatureService = {}

local rng = Random.new()

local function variantColor(color, variantIdx)
	if variantIdx == 2 then
		return color:Lerp(Color3.fromRGB(110, 210, 255), 0.55)
	elseif variantIdx == 3 then
		return color:Lerp(Color3.fromRGB(255, 205, 60), 0.65)
	end
	return color
end

local function variantMaterial(variantIdx, override)
	if variantIdx == 2 then
		return Enum.Material.Ice
	elseif variantIdx == 3 then
		return Enum.Material.Metal
	end
	return override or Enum.Material.Plastic
end

local function newPart(name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	return part
end

-- Construit le modèle d'une bête (sans le parenter). Renvoie model, root.
function CreatureService.BuildModel(def, variantIdx)
	local palette = def.palette
	local model = Instance.new("Model")
	model.Name = "Beast"

	local function color(key)
		if key == "eye" then
			return palette.eye
		end
		return variantColor(palette[key], variantIdx)
	end

	local root = newPart("Root", def.body.s, color(def.body.c), variantMaterial(variantIdx))
	root.Anchored = true
	root.CFrame = CFrame.new(0, 0, 0)
	root.CastShadow = true
	root.Parent = model
	model.PrimaryPart = root

	for _, spec in ipairs(def.parts) do
		local part = newPart(
			spec.n,
			spec.s,
			color(spec.c),
			spec.c == "eye" and Enum.Material.SmoothPlastic or variantMaterial(variantIdx)
		)
		local rot = spec.rot or Vector3.new(0, 0, 0)
		part.CFrame = root.CFrame
			* CFrame.new(spec.o)
			* CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		part.CastShadow = spec.s.Magnitude > 3
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end

	for _, spec in ipairs(def.legs) do
		local pivot = Vector3.new(0, spec.s.Y / 2, 0)
		local part = newPart(spec.n, spec.s, color(spec.c), variantMaterial(variantIdx))
		part.CFrame = root.CFrame * CFrame.new(spec.hip) * CFrame.new(-pivot)
		part.CastShadow = false
		local motor = Instance.new("Motor6D")
		motor.Name = spec.n
		motor.Part0 = root
		motor.Part1 = part
		motor.C0 = CFrame.new(spec.hip)
		motor.C1 = CFrame.new(pivot)
		motor:SetAttribute("Phase", spec.phase)
		motor.Parent = part
		part.Parent = model
	end

	for _, spec in ipairs(def.wings) do
		local pivot = Vector3.new(-spec.side * spec.s.X / 2, 0, 0)
		local part = newPart(spec.n, spec.s, color(spec.c), variantMaterial(variantIdx))
		part.CFrame = root.CFrame * CFrame.new(spec.hip) * CFrame.new(-pivot)
		part.CastShadow = false
		local motor = Instance.new("Motor6D")
		motor.Name = spec.n
		motor.Part0 = root
		motor.Part1 = part
		motor.C0 = CFrame.new(spec.hip)
		motor.C1 = CFrame.new(pivot)
		motor:SetAttribute("Side", spec.side)
		motor.Parent = part
		part.Parent = model
	end

	return model, root
end

local function addEmitters(def, variantIdx, root)
	-- Poussière : activée uniquement quand la bête est montée.
	local dustAttachment = Instance.new("Attachment")
	dustAttachment.Name = "DustAttachment"
	if def.flying then
		dustAttachment.Position = Vector3.new(0, 0, 3)
	else
		dustAttachment.Position = Vector3.new(0, -def.rootY + 0.5, 2)
	end
	dustAttachment.Parent = root

	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"
	dust.Enabled = false
	dust.Rate = 26
	dust.Lifetime = NumberRange.new(0.5, 1.0)
	dust.Speed = NumberRange.new(4, 9)
	dust.SpreadAngle = Vector2.new(25, 25)
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0.2) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	dust.Color = ColorSequence.new(def.flying and Color3.fromRGB(200, 170, 255) or Color3.fromRGB(214, 190, 150))
	dust.EmissionDirection = Enum.NormalId.Back
	dust.Parent = dustAttachment

	if variantIdx > 1 then
		local spark = Instance.new("ParticleEmitter")
		spark.Name = "Sparkle"
		spark.Rate = 5
		spark.Lifetime = NumberRange.new(0.8, 1.4)
		spark.Speed = NumberRange.new(1, 3)
		spark.SpreadAngle = Vector2.new(180, 180)
		spark.LightEmission = 1
		spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
		spark.Color =
			ColorSequence.new(variantIdx == 3 and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(150, 230, 255))
		spark.Parent = root
	end
end

-- Animal tiré dans la liste de la zone où se trouve `z`.
local function pickSpecies(z)
	local zone = Config.zoneAt(z or 0)
	local list = {}
	for _, id in ipairs(zone.animals) do
		table.insert(list, Species.ById[id])
	end
	return Util.pickWeighted(list, rng)
end

local function pickVariant()
	return Util.pickWeighted(Config.Variants, rng).id
end

-- Crée une bête et l'ajoute au monde. Renvoie le record `creature`.
-- Un animal peut porter un cœur rose (récupérable) ; un boss en porte toujours un.
function CreatureService.Spawn(x, z, speciesId, variantIdx, speedFactor)
	local def = speciesId and Species.ById[speciesId] or pickSpecies(z)
	if def.boss then
		variantIdx = 1
	else
		variantIdx = variantIdx or pickVariant()
	end
	local variant = Config.Variants[variantIdx]
	local zone = Config.zoneAt(z)
	local hearted = def.boss == true or rng:NextNumber() < zone.heartChance + State.HeartBonus

	local id = State.NextCreatureId
	State.NextCreatureId = id + 1

	local model, root = CreatureService.BuildModel(def, variantIdx)
	model.Name = "Beast" .. id
	model:SetAttribute("Id", id)
	model:SetAttribute("Species", def.id)
	model:SetAttribute("Variant", variantIdx)
	model:SetAttribute("BaseSpeed", def.speed)
	model:SetAttribute("Ridden", false)
	model:SetAttribute("Angry", false)
	model:SetAttribute("Heart", hearted)
	model:SetAttribute("Ready", false)
	model:SetAttribute("Boss", def.boss == true)
	addEmitters(def, variantIdx, root)

	local baseSpeed = def.speed * (0.9 + rng:NextNumber() * 0.2) * (speedFactor or 1)
	if variantIdx == 3 then
		baseSpeed = baseSpeed * 1.1
	end

	local creature = {
		id = id,
		def = def,
		variantIdx = variantIdx,
		variant = variant,
		model = model,
		root = root,
		x = x,
		z = z,
		baseSpeed = baseSpeed,
		speed = baseSpeed,
		phase = rng:NextNumber() * 10,
		age = 0,
		steer = 0,
		vx = 0,
		rider = nil,
		hearted = hearted,
		boss = def.boss == true,
		progress = {}, -- [Player] = secondes passées en selle (boss)
		tamed = false,
		tamedBy = nil,
		collectUntil = 0,
		angry = false,
		removed = false,
		seat = CFrame.new(def.seat),
	}

	local y = def.rootY
	root.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(x, y, z + 1))
	model.Parent = State.CreaturesFolder
	State.Creatures[id] = creature
	return creature
end

function CreatureService.Remove(creature)
	if creature.removed then
		return
	end
	creature.removed = true
	State.Creatures[creature.id] = nil
	creature.model:Destroy()
end

function CreatureService.Clear()
	for _, creature in pairs(State.Creatures) do
		creature.removed = true
		creature.model:Destroy()
	end
	State.Creatures = {}
end

function CreatureService.SeatWorldCFrame(creature)
	return creature.root.CFrame * creature.seat
end

-- Bête libre la plus proche (pour remonter un joueur tombé). Renvoie nil si aucune.
function CreatureService.FindRescue(x, z)
	local best, bestScore = nil, math.huge
	for _, creature in pairs(State.Creatures) do
		if not creature.rider and not creature.removed then
			local dz = creature.z - z
			if dz > -25 and dz < 150 then
				local score = math.abs(dz - 20) + math.abs(creature.x - x) * 0.5
				if score < bestScore then
					best, bestScore = creature, score
				end
			end
		end
	end
	return best
end

local function activeBounds()
	local minZ, maxZ = math.huge, -math.huge
	local positions = {}
	for _, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" then
			local z = run.z or 0
			minZ = math.min(minZ, z)
			maxZ = math.max(maxZ, z)
			table.insert(positions, z)
		end
	end
	if #positions == 0 then
		return nil, nil, positions
	end
	return minZ, maxZ, positions
end

local function tooClose(x, z)
	for _, creature in pairs(State.Creatures) do
		if math.abs(creature.z - z) < 9 and math.abs(creature.x - x) < 9 then
			return true
		end
	end
	return false
end

local function trySpawnNear(z0, ahead)
	for _ = 1, 6 do
		local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 8)
		local z = z0 + ahead[1] + rng:NextNumber() * (ahead[2] - ahead[1])
		if z < Config.Track.FinishZ - 40 and not tooClose(x, z) then
			-- Les bêtes de devant sont un peu plus lentes pour rester rattrapables.
			return CreatureService.Spawn(x, z, nil, nil, 0.85 + rng:NextNumber() * 0.15)
		end
	end
	return nil
end

-- Remplit la zone de départ au début de l'expédition (autour de `startZ`).
function CreatureService.FillInitial(startZ)
	for _ = 1, 40 do
		local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 8)
		local z = startZ + 40 + rng:NextNumber() * 260
		if not tooClose(x, z) then
			CreatureService.Spawn(x, z)
		end
	end
end

function CreatureService.Step(dt)
	if State.Frozen then
		return
	end

	local half = Config.Track.HalfWidth
	local finishZ = Config.Track.FinishZ

	for _, creature in pairs(State.Creatures) do
		local def = creature.def
		creature.age = creature.age + dt

		local target = creature.baseSpeed
		if def.trait == "charge" then
			if (creature.age + creature.phase) % 6 < 1.2 then
				target = target * 1.5
			end
		end
		creature.speed = creature.speed + (target - creature.speed) * math.min(1, dt * 4)

		local vx
		if creature.rider then
			vx = creature.steer * Config.Ride.SteerSpeed
		else
			vx = math.sin(creature.age * def.weaveFreq + creature.phase) * def.weaveAmp
		end
		creature.vx = vx
		creature.x = math.clamp(creature.x + vx * dt, -half, half)
		creature.z = creature.z + creature.speed * dt

		local y = def.rootY
		if def.trait == "hop" then
			y = y + math.abs(math.sin((creature.age + creature.phase) * 3.2)) * 2.2
		elseif def.flying then
			y = y + math.sin((creature.age + creature.phase) * 2) * 1.2
		end
		creature.y = y

		local pos = Vector3.new(creature.x, y, creature.z)
		creature.root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(vx * 0.12, 0, 1)) * CFrame.Angles(0, 0, -vx * 0.004)
	end

	-- Disparition : trop loin derrière / devant les joueurs actifs, ou après l'arrivée.
	local minZ, maxZ, positions = activeBounds()
	local toRemove = nil
	for _, creature in pairs(State.Creatures) do
		local gone = creature.z > finishZ + 30
		if minZ and not creature.rider then
			if creature.z < minZ - 90 or creature.z > maxZ + 320 then
				gone = true
			end
		end
		if gone and not creature.rider then
			toRemove = toRemove or {}
			table.insert(toRemove, creature)
		end
	end
	if toRemove then
		for _, creature in ipairs(toRemove) do
			CreatureService.Remove(creature)
		end
	end

	-- Apparition : garantir de la densité devant chaque joueur actif.
	if not minZ then
		return
	end
	local total = 0
	for _ in pairs(State.Creatures) do
		total = total + 1
	end
	local desired = math.clamp(10 + 9 * #positions, 28, 64)
	local spawned = 0
	for _, pz in ipairs(positions) do
		if total >= 80 or spawned >= 3 then
			break
		end
		local ahead = 0
		for _, creature in pairs(State.Creatures) do
			if creature.z > pz and creature.z < pz + 170 then
				ahead = ahead + 1
			end
		end
		if ahead < 7 then
			if trySpawnNear(pz, { 60, 170 }) then
				spawned = spawned + 1
				total = total + 1
			end
		end
	end
	if total < desired and spawned < 3 then
		local pz = positions[rng:NextInteger(1, #positions)]
		if trySpawnNear(pz, { 40, 190 }) then
			total = total + 1
		end
	end
end

return CreatureService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Sauvegarde des joueurs (DataStore) + classement mondial (OrderedDataStore).
-- Règles de sécurité :
--  * si le chargement échoue, la sauvegarde est DÉSACTIVÉE pour ce joueur (on n'écrase jamais un vrai profil par un profil vide) ;
--  * sauvegarde automatique toutes les 60 s, à la sortie du joueur et à l'arrêt du serveur.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local STORE_NAME = "SauteZoo_Profiles_v1"
local BOARD_NAME = "SauteZoo_BestScore_v1"
local AUTOSAVE_INTERVAL = 60

local DataService = {}

local store = DataStoreService:GetDataStore(STORE_NAME)
local board = DataStoreService:GetOrderedDataStore(BOARD_NAME)

local profiles = {} -- [Player] = { data, canSave, dirty, version }

local function defaultData()
	return {
		coins = 0, -- or
		bones = 0,
		bestScore = 0,
		wins = 0,
		rounds = 0,
		hooks = 0,
		captures = 0,
		distance = 0,
		bestZone = 1,
		animals = {}, -- ["boar_1"] = { level = 1, copies = 1 }
		completed = {},
		bossCaptured = {},
		zooUp = { slots = 0, visitors = 0, storage = 0, gift = 0, lasso = 0, hearts = 0 },
		lastCollect = 0, -- instant (os.time) du dernier calcul de la caisse
		pot = 0, -- or déjà en caisse (hors temps écoulé depuis lastCollect)
		boostUntil = 0,
		revives = 0,
		zone = "savane",
		story = { index = 1, claimed = {} },
		upgrades = { range = 0, taming = 0, combo = 0 },
		owned = { hats = { none = true }, ropes = { classic = true } },
		equipped = { hat = "none", rope = "classic" },
		daily = { last = 0, streak = 0 },
		quests = { day = 0, list = {} },
		receipts = {},
		riddle = { day = 0, solved = false, claimed = false },
	}
end

local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = reconcile({}, value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

function DataService.Load(player)
	local key = "P_" .. player.UserId
	local data = nil
	local ok = false
	for attempt = 1, 3 do
		local success, result = pcall(function()
			return store:GetAsync(key)
		end)
		if success then
			data = result
			ok = true
			break
		end
		warn(("[Data] Chargement impossible (essai %d/3) : %s"):format(attempt, tostring(result)))
		task.wait(1.5)
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		data = reconcile(data, defaultData())
	end

	if (data.lastCollect or 0) == 0 then
		data.lastCollect = os.time()
	end
	local profile = { data = data, canSave = ok, dirty = false, version = 0 }
	profiles[player] = profile
	return profile
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

function DataService.IsPersistent(player)
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

function DataService.MarkDirty(player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
		profile.version = profile.version + 1
	end
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not profile.dirty then
		return true
	end
	local version = profile.version
	local snapshot = deepCopy(profile.data)
	local err
	for attempt = 1, 3 do
		local ok
		ok, err = pcall(function()
			store:UpdateAsync("P_" .. player.UserId, function()
				return snapshot
			end)
		end)
		if ok then
			if profile.version == version then
				profile.dirty = false
			end
			return true
		end
		if attempt < 3 then
			task.wait(attempt * 1.5)
		end
	end
	warn("[Data] Sauvegarde échouée après 3 essais : " .. tostring(err))
	return false
end

function DataService.Release(player)
	DataService.Save(player)
	profiles[player] = nil
end

function DataService.SubmitBest(player, score)
	local value = math.floor(score)
	local userId = tostring(player.UserId)
	task.spawn(function()
		local err
		for attempt = 1, 3 do
			local ok
			ok, err = pcall(function()
				board:SetAsync(userId, value)
			end)
			if ok then
				return
			end
			task.wait(attempt * 2)
		end
		warn("[Data] Classement mondial indisponible : " .. tostring(err))
	end)
end

-- Renvoie { {userId=, score=}, ... } ou nil si indisponible.
function DataService.GetTop(count)
	local ok, result = pcall(function()
		local pages = board:GetSortedAsync(false, count)
		return pages:GetCurrentPage()
	end)
	if not ok then
		return nil
	end
	local list = {}
	for _, entry in ipairs(result) do
		table.insert(list, { userId = tonumber(entry.key), score = entry.value })
	end
	return list
end

function DataService.Init()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, player)
				task.wait(0.2)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player)
				pending = pending - 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 20 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- Événements de manche : Geysers (gros bonds gratuits) et Pluie de météores (éjecte les cavaliers).
-- Chaque événement est annoncé par un anneau au sol ("télégraphie") avant d'agir.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Fx = require(script.Parent.Fx)
local RideService = require(script.Parent.RideService)

local EventService = {}

local rng = Random.new()
local nextEventAt = 0

local function activeRuns()
	local list = {}
	for player, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Down" then
			table.insert(list, { player = player, run = run })
		end
	end
	return list
end

local function playersInRadius(position, radius)
	local found = {}
	for player, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Down" then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = hrp.Position - position
				local flat = math.sqrt(d.X * d.X + d.Z * d.Z)
				if flat <= radius and d.Y < 40 then
					table.insert(found, player)
				end
			end
		end
	end
	return found
end

local function announce(kind, title, sub)
	Remotes.Feedback:FireAllClients({ kind = kind, title = title, sub = sub })
end

local function randomPositionAhead(zMin, zMax)
	local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 14)
	local z = math.clamp(zMin + rng:NextNumber() * (zMax - zMin), 40, Config.Track.FinishZ - 80)
	return Vector3.new(x, 0, z)
end

-- Tourbillon : un cercle de couleur, puis une colonne qui propulse tout cavalier dedans (bonus de saut).
local function geyser(position, roundId, color)
	local radius = Config.Events.GeyserRadius
	Fx.ring(position, radius, color, Config.Events.Telegraph)
	task.delay(Config.Events.Telegraph, function()
		if State.RoundId ~= roundId or State.Phase ~= "Running" then
			return
		end
		Fx.column(position, radius, 70, color, 0.9)
		for _, player in ipairs(playersInRadius(position, radius)) do
			if player.Parent then
				RideService.Boost(player, Vector3.new(0, 90, 70))
				Remotes.Feedback:FireClient(
					player,
					{ kind = "geyser", title = "SUPER BOND !", sub = "Rattrape un animal en l'air !" }
				)
			end
		end
	end)
end

-- Surgissement / météore : un cercle rouge, puis une explosion qui éjecte les cavaliers.
local function strike(position, roundId, color)
	local radius = Config.Events.StrikeRadius
	Fx.ring(position, radius, Color3.fromRGB(255, 70, 40), Config.Events.Telegraph)
	task.delay(Config.Events.Telegraph, function()
		if State.RoundId ~= roundId or State.Phase ~= "Running" then
			return
		end
		Fx.explosion(Vector3.new(position.X, 6, position.Z), radius, color)
		for _, player in ipairs(playersInRadius(position, radius)) do
			if player.Parent then
				RideService.Knock(player)
			end
		end
	end)
end

function EventService.Reset()
	nextEventAt = Config.Events.FirstDelay
end

-- Appelé à chaque Heartbeat pendant la manche ; `elapsed` = secondes écoulées depuis le départ.
-- Chaque zone a son événement : tourbillons (bonus) dans la savane et le désert, surgissements dans le marais
-- et météores dans le volcan (éjectent les cavaliers).
function EventService.Step(elapsed)
	if elapsed < nextEventAt then
		return
	end
	local runs = activeRuns()
	nextEventAt = elapsed + Config.Events.MinGap + rng:NextNumber() * (Config.Events.MaxGap - Config.Events.MinGap)
	if #runs == 0 then
		return
	end

	local leaderZ = -math.huge
	for _, entry in ipairs(runs) do
		leaderZ = math.max(leaderZ, entry.run.z or 0)
	end
	local roundId = State.RoundId
	local event = Config.zoneAt(leaderZ).event

	if event.kind == "geyser" then
		announce("event", event.name .. " !", "Fonce dans les cercles pour un super bond.")
		for _ = 1, 2 do
			geyser(randomPositionAhead(leaderZ + 70, leaderZ + 180), roundId, event.color)
		end
	else
		announce("danger", event.name .. " !", "Évite les cercles rouges !")
		for _ = 1, 3 do
			strike(randomPositionAhead(leaderZ + 40, leaderZ + 160), roundId, event.color)
		end
	end
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Effets visuels ponctuels côté serveur (anneaux d'avertissement, explosions, geysers, particules).

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local State = require(script.Parent.State)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local Fx = {}

local function folder()
	return State.FxFolder or workspace
end

-- Rafale de particules à une position.
function Fx.burst(position, color, count, speed)
	local part = Util.create("Part", {
		Name = "Burst",
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		Size = Vector3.new(1, 1, 1),
		Position = position,
	}, folder())
	local emitter = Util.create("ParticleEmitter", {
		Enabled = false,
		Color = ColorSequence.new(color),
		LightEmission = 0.8,
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(speed or 24, (speed or 24) * 1.6),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Drag = 2,
	}, part)
	emitter:Emit(count or 30)
	Debris:AddItem(part, 2)
end

-- Anneau plat au sol (avertissement), disparaît après `duration`.
function Fx.ring(position, radius, color, duration)
	local ring = Util.create("Part", {
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.45,
		Size = Vector3.new(0.4, radius * 2, radius * 2),
		CFrame = CFrame.new(position.X, 0.3, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
	}, folder())
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Sine), { Transparency = 0.1 }):Play()
	Debris:AddItem(ring, duration)
	return ring
end

-- Boule d'explosion qui grossit puis s'estompe.
function Fx.explosion(position, radius, color)
	local ball = Util.create("Part", {
		Name = "Explosion",
		Shape = Enum.PartType.Ball,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.2,
		Size = Vector3.new(2, 2, 2),
		Position = position,
	}, folder())
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(ball, info, {
		Size = Vector3.new(radius * 2, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, 0.6)
	Fx.burst(position, color, 40, 40)
end

-- Colonne verticale (geyser).
function Fx.column(position, radius, height, color, duration)
	local col = Util.create("Part", {
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.35,
		Size = Vector3.new(1, radius * 1.6, radius * 1.6),
		CFrame = CFrame.new(position.X, 0.5, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
	}, folder())
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(col, info, {
		Size = Vector3.new(height, radius * 1.2, radius * 1.2),
		CFrame = CFrame.new(position.X, height / 2, position.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(col, duration + 0.1)
	Fx.burst(Vector3.new(position.X, 3, position.Z), color, 50, 50)
end

function Fx.clear()
	if State.FxFolder then
		State.FxFolder:ClearAllChildren()
	end
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Construction procédurale de tout le monde : salon (lobby), piste en 4 biomes, falaises, décors,
-- portiques, ligne d'arrivée, podium et mur de lave. Uniquement des blocs et matériaux Roblox standards.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local State = require(script.Parent.State)
local DataService = require(script.Parent.DataService)

local MapBuilder = {}

local rng = Random.new(20240611)
local built = 0
local statusLabel = nil
local boardRows = {}
local nameCache = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function pace()
	built = built + 1
	if built % 150 == 0 then
		task.wait()
	end
end

-- Crée un bloc ancré. o = { name, shape, collide, trans, shadow, mat }
local function P(parent, size, cf, color, material, o)
	o = o or {}
	local part = Instance.new("Part")
	part.Name = o.name or "Block"
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = o.collide == true
	part.CanTouch = false
	part.CanQuery = o.collide == true
	part.CastShadow = o.shadow == true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if o.trans then
		part.Transparency = o.trans
	end
	if o.shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif o.shape == "Cyl" then
		part.Shape = Enum.PartType.Cylinder
	end
	part.Parent = parent
	pace()
	return part
end

local function mat(name)
	return Enum.Material[name]
end

local function jitter(color, amount)
	local d = (rng:NextNumber() - 0.5) * amount
	return C(
		math.clamp(math.floor(color.R * 255 + d), 0, 255),
		math.clamp(math.floor(color.G * 255 + d), 0, 255),
		math.clamp(math.floor(color.B * 255 + d), 0, 255)
	)
end

local function yaw(deg)
	return CFrame.Angles(0, math.rad(deg), 0)
end

-- ---------------------------------------------------------------------------
-- Éclairage
-- ---------------------------------------------------------------------------

function MapBuilder.SetupLighting()
	Lighting.ClockTime = 15
	Lighting.Brightness = 2.6
	Lighting.GlobalShadows = true
	Lighting.Ambient = C(96, 96, 110)
	Lighting.OutdoorAmbient = C(124, 128, 142)
	Lighting.ColorShift_Top = C(255, 242, 214)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	local function ensure(className, name)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end

	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.Name = "HHSky"
		sky.Parent = Lighting
	end

	local atmosphere = ensure("Atmosphere", "HHAtmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Config.Biomes[1].atmosphere
	atmosphere.Decay = C(255, 222, 180)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2

	local bloom = ensure("BloomEffect", "HHBloom")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1

	local rays = ensure("SunRaysEffect", "HHRays")
	rays.Intensity = 0.12
	rays.Spread = 0.8

	local color = ensure("ColorCorrectionEffect", "HHColor")
	color.Saturation = 0.12
	color.Contrast = 0.06
	color.TintColor = Config.Biomes[1].tint
end

-- ---------------------------------------------------------------------------
-- Panneaux (SurfaceGui)
-- ---------------------------------------------------------------------------

local function makeLabel(parent, text, size, position, textSize, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Text = text
	label.TextColor3 = color or C(255, 255, 255)
	label.Font = font or Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function makeBoard(parent, size, cf, canvas, bg)
	local board =
		P(parent, size, cf, bg or C(34, 40, 56), Enum.Material.SmoothPlastic, { name = "Board", shadow = true })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = canvas
	gui.LightInfluence = 0
	gui.Parent = board
	return board, gui
end

-- ---------------------------------------------------------------------------
-- Salon (lobby)
-- ---------------------------------------------------------------------------

-- Le parc central : une grande esplanade en hauteur ; chaque joueur y reçoit une parcelle (voir ZooService).
local function buildLobby(map)
	local hub = Config.Hub
	local center = hub.Center
	local width = hub.Columns * hub.PlotSpacing + 60
	local depth = hub.Rows * hub.PlotSpacing + 60
	local top = center.Y + 3
	State.LobbyCFrame = CFrame.new(center.X, top + 4, center.Z - depth / 2 + 20)

	P(
		map,
		V(width, 6, depth),
		CFrame.new(center),
		C(196, 190, 176),
		Enum.Material.Cobblestone,
		{ name = "HubFloor", collide = true, shadow = true }
	)
	P(
		map,
		V(width, 0.4, 3),
		CFrame.new(center.X, top + 0.2, center.Z - depth / 2 + 1.5),
		C(255, 200, 70),
		Enum.Material.Neon,
		{ name = "Trim" }
	)
	P(
		map,
		V(width, 0.4, 3),
		CFrame.new(center.X, top + 0.2, center.Z + depth / 2 - 1.5),
		C(255, 200, 70),
		Enum.Material.Neon,
		{ name = "Trim" }
	)

	local wallH = 80
	local function barrier(sz, pos)
		P(
			map,
			sz,
			CFrame.new(pos),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "HubBarrier", collide = true, trans = 1 }
		)
	end
	barrier(V(width + 4, wallH, 2), V(center.X, top + wallH / 2, center.Z - depth / 2))
	barrier(V(width + 4, wallH, 2), V(center.X, top + wallH / 2, center.Z + depth / 2))
	barrier(V(2, wallH, depth + 4), V(center.X - width / 2, top + wallH / 2, center.Z))
	barrier(V(2, wallH, depth + 4), V(center.X + width / 2, top + wallH / 2, center.Z))

	-- points d'apparition à l'entrée du parc
	for index = 1, 4 do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "HubSpawn" .. index
		spawn.Size = V(8, 1, 8)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.CanCollide = true
		spawn.Color = C(255, 200, 70)
		spawn.Material = Enum.Material.Neon
		spawn.Transparency = 0.2
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.CFrame = CFrame.new(center.X + (index - 2.5) * 14, top + 0.5, center.Z - depth / 2 + 14)
		spawn.Parent = map
	end

	-- panneau d'état de l'expédition
	local _, infoGui = makeBoard(
		map,
		V(60, 26, 1),
		CFrame.new(center.X, top + 22, center.Z - depth / 2 + 8),
		V(960, 416),
		C(28, 34, 52)
	)
	makeLabel(infoGui, "SAUTE-ZOO", UDim2.new(1, 0, 0, 120), UDim2.new(0, 0, 0, 20), 96, C(255, 214, 90))
	statusLabel =
		makeLabel(infoGui, "Chargement...", UDim2.new(1, -40, 0, 140), UDim2.new(0, 20, 0, 160), 60, C(255, 255, 255))
	makeLabel(
		infoGui,
		"Saute d'animal en animal, rapporte-les à ton zoo !",
		UDim2.new(1, -40, 0, 70),
		UDim2.new(0, 20, 0, 320),
		40,
		C(190, 205, 235),
		Enum.Font.GothamMedium
	)

	-- classement mondial
	local lbPos = Vector3.new(center.X - width / 2 + 8, top + 18, center.Z - depth / 2 + 40)
	local _, lbGui = makeBoard(
		map,
		V(42, 30, 1),
		CFrame.lookAt(lbPos, Vector3.new(center.X, top + 18, center.Z - depth / 2 + 40)),
		V(672, 480),
		C(40, 46, 66)
	)
	makeLabel(lbGui, "TOP 10 · MEILLEUR SCORE", UDim2.new(1, 0, 0, 56), UDim2.new(0, 0, 0, 8), 40, C(255, 214, 90))
	for i = 1, 10 do
		local row = makeLabel(
			lbGui,
			"",
			UDim2.new(1, -40, 0, 36),
			UDim2.new(0, 20, 0, 64 + (i - 1) * 40),
			28,
			C(235, 240, 255),
			Enum.Font.GothamMedium
		)
		row.TextXAlignment = Enum.TextXAlignment.Left
		boardRows[i] = row
	end
	boardRows[1].Text = "Chargement du classement..."

	-- panneau « comment jouer »
	local howPos = Vector3.new(center.X + width / 2 - 8, top + 18, center.Z - depth / 2 + 40)
	local _, howGui = makeBoard(
		map,
		V(42, 30, 1),
		CFrame.lookAt(howPos, Vector3.new(center.X, top + 18, center.Z - depth / 2 + 40)),
		V(672, 480),
		C(40, 46, 66)
	)
	makeLabel(howGui, "COMMENT JOUER", UDim2.new(1, 0, 0, 60), UDim2.new(0, 0, 0, 12), 48, C(255, 214, 90))
	local how = "Ouvre EXPÉDITION et pars avec les autres\n"
		.. "Le sol est mortel : saute d'un animal à l'autre\n"
		.. "Un cœur rose = tu peux le récupérer\n"
		.. "Monte-le quelques secondes puis RÉCUPÉRER\n"
		.. "Le lasso attrape les animaux à distance\n"
		.. "Plus ton zoo est grand, plus il rapporte"
	local howLabel = makeLabel(
		howGui,
		how,
		UDim2.new(1, -40, 1, -90),
		UDim2.new(0, 20, 0, 80),
		32,
		C(235, 240, 255),
		Enum.Font.GothamMedium
	)
	howLabel.TextXAlignment = Enum.TextXAlignment.Left
	howLabel.TextYAlignment = Enum.TextYAlignment.Top
end

function MapBuilder.SetStatus(text)
	if statusLabel then
		statusLabel.Text = text
	end
end

local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	name = ok and name or ("Joueur " .. tostring(userId))
	nameCache[userId] = name
	return name
end

function MapBuilder.RefreshBoard()
	local top = DataService.GetTop(10)
	if not top then
		if boardRows[1] then
			boardRows[1].Text = "Classement indisponible"
		end
		return
	end
	for i = 1, 10 do
		local entry = top[i]
		if entry then
			boardRows[i].Text = ("%d. %s — %d"):format(i, nameFor(entry.userId), entry.score)
		else
			boardRows[i].Text = ("%d. —"):format(i)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Piste
-- ---------------------------------------------------------------------------

local function buildFloor(map)
	local finishZ = Config.Track.FinishZ
	for z = -400, finishZ + 400 - 100, 100 do
		local biome = Config.biomeAt(z + 50)
		P(
			map,
			V(200, 8, 100),
			CFrame.new(0, -4, z + 50),
			biome.ground,
			mat(biome.material),
			{ name = "Floor", collide = true }
		)
	end

	-- plaques de terrain pour casser l'uniformité
	for _ = 1, 280 do
		local z = -300 + rng:NextNumber() * (finishZ + 600)
		local biome = Config.biomeAt(z)
		local color = jitter(biome.ground, 34)
		P(
			map,
			V(14 + rng:NextNumber() * 22, 0.16, 14 + rng:NextNumber() * 22),
			CFrame.new((rng:NextNumber() * 2 - 1) * 78, 0.08, z) * yaw(rng:NextNumber() * 180),
			color,
			mat(biome.material),
			{ name = "Patch" }
		)
	end
end

local function buildCliffs(map)
	local finishZ = Config.Track.FinishZ
	for z = -400, finishZ + 420, 26 do
		local biome = Config.biomeAt(z)
		for _, side in ipairs({ -1, 1 }) do
			local w = 26 + rng:NextNumber() * 14
			local h = 30 + rng:NextNumber() * 46
			local x = side * (Config.Track.WallX + 4 + w / 2 + rng:NextNumber() * 6)
			P(
				map,
				V(w, h, 32 + rng:NextNumber() * 10),
				CFrame.new(x, h / 2 - 2, z + rng:NextNumber() * 8) * yaw(rng:NextNumber() * 20 - 10),
				jitter(biome.cliff, 30),
				mat(biome.cliffMaterial),
				{ name = "Cliff", collide = true, shadow = true }
			)
			-- deuxième rangée, plus haute
			local h2 = h + 20 + rng:NextNumber() * 30
			P(
				map,
				V(w + 14, h2, 34),
				CFrame.new(x + side * (w * 0.7), h2 / 2 - 2, z + rng:NextNumber() * 8) * yaw(rng:NextNumber() * 30 - 15),
				jitter(biome.cliff, 40),
				mat(biome.cliffMaterial),
				{ name = "CliffBack", collide = true, shadow = true }
			)
			if rng:NextNumber() < 0.25 then
				local hs = h + 10 + rng:NextNumber() * 20
				P(
					map,
					V(7, hs, 7),
					CFrame.new(side * (Config.Track.WallX + 2 + rng:NextNumber() * 6), hs / 2, z + 13)
						* yaw(rng:NextNumber() * 90),
					jitter(biome.cliff, 30),
					mat(biome.cliffMaterial),
					{ name = "Spire", collide = true, shadow = true }
				)
			end
		end
	end

	-- murs invisibles (la piste est un couloir)
	local length = finishZ + 1000
	local midZ = finishZ / 2 + 100
	for _, side in ipairs({ -1, 1 }) do
		P(
			map,
			V(4, 240, length),
			CFrame.new(side * (Config.Track.WallX + 2), 120, midZ),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "Barrier", collide = true, trans = 1 }
		)
	end
	P(
		map,
		V(200, 240, 4),
		CFrame.new(0, 120, -420),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "BarrierBack", collide = true, trans = 1 }
	)
	P(
		map,
		V(200, 240, 4),
		CFrame.new(0, 120, finishZ + 380),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "BarrierFront", collide = true, trans = 1 }
	)
end

-- ---------------------------------------------------------------------------
-- Décors par biome
-- ---------------------------------------------------------------------------

local emitterBudget = 14
local lightBudget = 8

local function acacia(map, x, z)
	local r = rng:NextNumber() * 360
	P(map, V(2, 10, 2), CFrame.new(x, 5, z) * yaw(r), C(110, 80, 50), Enum.Material.Wood, { name = "Trunk" })
	P(
		map,
		V(16, 3, 16),
		CFrame.new(x, 11.5, z) * yaw(r),
		jitter(C(94, 142, 62), 24),
		Enum.Material.Grass,
		{ name = "Canopy", shadow = true }
	)
	P(
		map,
		V(10, 2.5, 10),
		CFrame.new(x, 14, z) * yaw(r + 20),
		jitter(C(104, 154, 70), 24),
		Enum.Material.Grass,
		{ name = "Canopy" }
	)
end

local function boulder(map, x, z, color, material)
	local s = 4 + rng:NextNumber() * 5
	P(
		map,
		V(s * 1.3, s, s),
		CFrame.new(x, s / 2 - 0.3, z)
			* CFrame.Angles(rng:NextNumber() * 0.4, rng:NextNumber() * 6, rng:NextNumber() * 0.4),
		jitter(color, 26),
		material,
		{ name = "Boulder", shadow = true }
	)
end

local function bones(map, x, z)
	local r = rng:NextNumber() * 360
	local bone = C(238, 232, 214)
	P(map, V(1.4, 1.4, 9), CFrame.new(x, 0.7, z) * yaw(r), bone, Enum.Material.SmoothPlastic, { name = "Bone" })
	for i = -1, 1 do
		P(
			map,
			V(0.9, 5, 0.9),
			CFrame.new(x, 2.4, z) * yaw(r) * CFrame.new(i * 2.4, 0, 0) * CFrame.Angles(0, 0, 0.35 * i),
			bone,
			Enum.Material.SmoothPlastic,
			{ name = "Rib" }
		)
	end
end

local function cactus(map, x, z)
	local green = jitter(C(80, 140, 70), 20)
	local r = rng:NextNumber() * 360
	P(map, V(3, 12, 3), CFrame.new(x, 6, z) * yaw(r), green, Enum.Material.Grass, { name = "Cactus", shadow = true })
	P(
		map,
		V(5, 1.6, 1.6),
		CFrame.new(x, 6, z) * yaw(r) * CFrame.new(3.2, 0, 0),
		green,
		Enum.Material.Grass,
		{ name = "Arm" }
	)
	P(
		map,
		V(1.6, 4, 1.6),
		CFrame.new(x, 8, z) * yaw(r) * CFrame.new(5.2, 0, 0),
		green,
		Enum.Material.Grass,
		{ name = "Arm" }
	)
	if rng:NextNumber() < 0.5 then
		P(
			map,
			V(5, 1.6, 1.6),
			CFrame.new(x, 4.4, z) * yaw(r) * CFrame.new(-3.2, 0, 0),
			green,
			Enum.Material.Grass,
			{ name = "Arm" }
		)
		P(
			map,
			V(1.6, 3.4, 1.6),
			CFrame.new(x, 6.2, z) * yaw(r) * CFrame.new(-5.2, 0, 0),
			green,
			Enum.Material.Grass,
			{ name = "Arm" }
		)
	end
end

local function mesa(map, x, z, color)
	local h = 10 + rng:NextNumber() * 14
	local w = 10 + rng:NextNumber() * 8
	P(
		map,
		V(w, h, w * 0.9),
		CFrame.new(x, h / 2, z) * yaw(rng:NextNumber() * 90),
		jitter(color, 26),
		Enum.Material.Sandstone,
		{ name = "Mesa", shadow = true }
	)
	P(
		map,
		V(w * 0.7, 2.5, w * 0.6),
		CFrame.new(x, h + 1.2, z) * yaw(rng:NextNumber() * 90),
		jitter(color, 30),
		Enum.Material.Sandstone,
		{ name = "MesaTop" }
	)
end

local function mushroom(map, x, z)
	local s = 0.8 + rng:NextNumber() * 0.8
	P(
		map,
		V(3 * s, 5 * s, 3 * s),
		CFrame.new(x, 2.5 * s, z),
		C(240, 232, 214),
		Enum.Material.SmoothPlastic,
		{ name = "Stem" }
	)
	P(
		map,
		V(9 * s, 4.2 * s, 9 * s),
		CFrame.new(x, 6.2 * s, z),
		C(204, 60, 64),
		Enum.Material.SmoothPlastic,
		{ name = "Cap", shape = "Ball", shadow = true }
	)
	P(
		map,
		V(1.6 * s, 0.6, 1.6 * s),
		CFrame.new(x + 1.5 * s, 8.2 * s, z + 0.5 * s),
		C(255, 255, 255),
		Enum.Material.SmoothPlastic,
		{ name = "Dot" }
	)
end

local function obsidianSpike(map, x, z)
	local h = 10 + rng:NextNumber() * 14
	local w = 4 + rng:NextNumber() * 3
	P(
		map,
		V(w, h, w),
		CFrame.new(x, h / 2 - 0.5, z)
			* CFrame.Angles((rng:NextNumber() - 0.5) * 0.3, rng:NextNumber() * 6, (rng:NextNumber() - 0.5) * 0.3),
		jitter(C(34, 30, 38), 16),
		Enum.Material.Basalt,
		{ name = "Spike", shadow = true }
	)
end

local function lavaPool(map, x, z)
	local w = 8 + rng:NextNumber() * 8
	local pool = P(
		map,
		V(w, 0.3, w * 0.8),
		CFrame.new(x, 0.18, z) * yaw(rng:NextNumber() * 180),
		C(255, 100, 20),
		Enum.Material.Neon,
		{ name = "LavaPool" }
	)
	if emitterBudget > 0 and rng:NextNumber() < 0.25 then
		emitterBudget = emitterBudget - 1
		local att = Instance.new("Attachment")
		att.Parent = pool
		local em = Instance.new("ParticleEmitter")
		em.Rate = 8
		em.Lifetime = NumberRange.new(1.2, 2.2)
		em.Speed = NumberRange.new(6, 12)
		em.SpreadAngle = Vector2.new(20, 20)
		em.LightEmission = 1
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		em.Color = ColorSequence.new(C(255, 140, 40), C(255, 60, 20))
		em.Parent = att
	end
	if lightBudget > 0 and rng:NextNumber() < 0.15 then
		lightBudget = lightBudget - 1
		local light = Instance.new("PointLight")
		light.Color = C(255, 120, 40)
		light.Range = 30
		light.Brightness = 2
		light.Parent = pool
	end
end

local function crystals(map, x, z, color)
	local r = rng:NextNumber() * 360
	for i = 1, 3 + rng:NextInteger(0, 2) do
		local h = 4 + rng:NextNumber() * 9
		local ox, oz = (rng:NextNumber() - 0.5) * 6, (rng:NextNumber() - 0.5) * 6
		P(
			map,
			V(1.6 + rng:NextNumber(), h, 1.6 + rng:NextNumber()),
			CFrame.new(x + ox, h / 2 - 0.3, z + oz)
				* yaw(r + i * 40)
				* CFrame.Angles((rng:NextNumber() - 0.5) * 0.5, 0, (rng:NextNumber() - 0.5) * 0.5),
			jitter(color, 30),
			Enum.Material.Glass,
			{ name = "Crystal", shadow = true }
		)
	end
end

local function mangrove(map, x, z)
	local r = rng:NextNumber() * 360
	for i = -1, 1 do
		P(
			map,
			V(0.9, 5, 0.9),
			CFrame.new(x + i * 2.2, 2.2, z) * CFrame.Angles(0, 0, i * 0.25),
			C(88, 64, 44),
			Enum.Material.Wood,
			{ name = "Root" }
		)
	end
	P(map, V(2.4, 9, 2.4), CFrame.new(x, 8, z) * yaw(r), C(96, 70, 48), Enum.Material.Wood, { name = "Trunk" })
	P(
		map,
		V(15, 3.2, 15),
		CFrame.new(x, 13.5, z) * yaw(r),
		jitter(C(60, 120, 70), 24),
		Enum.Material.Grass,
		{ name = "Canopy", shadow = true }
	)
	P(
		map,
		V(9, 2.4, 9),
		CFrame.new(x, 15.8, z) * yaw(r + 30),
		jitter(C(72, 136, 78), 24),
		Enum.Material.Grass,
		{ name = "Canopy" }
	)
end

local function reeds(map, x, z)
	for _ = 1, 5 do
		local h = 5 + rng:NextNumber() * 4
		P(
			map,
			V(0.5, h, 0.5),
			CFrame.new(x + (rng:NextNumber() - 0.5) * 5, h / 2, z + (rng:NextNumber() - 0.5) * 5)
				* CFrame.Angles(0, 0, (rng:NextNumber() - 0.5) * 0.3),
			C(104, 150, 70),
			Enum.Material.Grass,
			{ name = "Reed" }
		)
	end
end

local function decorate(map, z, x)
	local zone = Config.zoneAt(z)
	local roll = rng:NextNumber()
	if zone.key == "savane" then
		if roll < 0.45 then
			acacia(map, x, z)
		elseif roll < 0.75 then
			boulder(map, x, z, C(150, 140, 126), Enum.Material.Rock)
		else
			bones(map, x, z)
		end
	elseif zone.key == "marais" then
		if roll < 0.4 then
			mangrove(map, x, z)
		elseif roll < 0.7 then
			reeds(map, x, z)
		elseif roll < 0.85 then
			mushroom(map, x, z)
		else
			crystals(map, x, z, C(120, 220, 190))
		end
	elseif zone.key == "desert" then
		if roll < 0.45 then
			cactus(map, x, z)
		elseif roll < 0.75 then
			mesa(map, x, z, C(200, 112, 70))
		elseif roll < 0.88 then
			bones(map, x, z)
		elseif roll < 0.94 then
			crystals(map, x, z, C(255, 150, 110))
		else
			boulder(map, x, z, C(196, 150, 110), Enum.Material.Sandstone)
		end
	else
		if roll < 0.5 then
			obsidianSpike(map, x, z)
		elseif roll < 0.8 then
			lavaPool(map, x, z)
		else
			boulder(map, x, z, C(60, 52, 56), Enum.Material.Basalt)
		end
	end
end

local function buildProps(map)
	local finishZ = Config.Track.FinishZ
	for z = -300, finishZ + 260, 17 do
		for _, side in ipairs({ -1, 1 }) do
			if rng:NextNumber() < 0.75 then
				local x = side * (Config.Track.HalfWidth + 4 + rng:NextNumber() * 14)
				decorate(map, z + (rng:NextNumber() - 0.5) * 10, x)
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Portiques, départ, arrivée
-- ---------------------------------------------------------------------------

local function gate(map, z, text, color)
	local height = 46
	for _, side in ipairs({ -1, 1 }) do
		P(
			map,
			V(9, height, 9),
			CFrame.new(side * 72, height / 2, z),
			C(86, 92, 112),
			Enum.Material.Slate,
			{ name = "GatePillar", collide = true, shadow = true }
		)
	end
	local beam, gui = makeBoard(map, V(153, 12, 8), CFrame.new(0, height + 2, z), V(1530, 120), color)
	beam.Name = "GateBeam"
	beam.CanCollide = false
	beam.CanQuery = false
	makeLabel(gui, text, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), 100, C(255, 255, 255))
end

local function buildGates(map)
	local finishZ = Config.Track.FinishZ

	gate(map, 0, "DÉPART", C(46, 120, 70))
	P(map, V(180, 0.3, 4), CFrame.new(0, 0.2, 0), C(255, 255, 255), Enum.Material.SmoothPlastic, { name = "StartLine" })

	for i = 2, #Config.Biomes do
		local biome = Config.Biomes[i]
		gate(map, biome.from, biome.name, C(54, 62, 90))
	end

	gate(map, finishZ, "ARRIVÉE", C(160, 40, 50))
	-- damier d'arrivée
	for col = 0, 29 do
		for row = 0, 1 do
			local dark = (col + row) % 2 == 0
			P(
				map,
				V(6, 0.3, 3),
				CFrame.new(-87 + col * 6 + 3, 0.2, finishZ - 1.5 + row * 3),
				dark and C(20, 20, 20) or C(255, 255, 255),
				Enum.Material.SmoothPlastic,
				{ name = "FinishChecker" }
			)
		end
	end

	-- confettis à l'arrivée
	for _, side in ipairs({ -1, 1 }) do
		local anchor = P(
			map,
			V(1, 1, 1),
			CFrame.new(side * 72, 48, finishZ + 4),
			C(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{ name = "ConfettiAnchor", trans = 1 }
		)
		local att = Instance.new("Attachment")
		att.Parent = anchor
		local em = Instance.new("ParticleEmitter")
		em.Rate = 20
		em.Lifetime = NumberRange.new(2.5, 4)
		em.Speed = NumberRange.new(14, 26)
		em.SpreadAngle = Vector2.new(40, 40)
		em.Acceleration = V(0, -30, 0)
		em.LightEmission = 0.5
		em.Size = NumberSequence.new(0.9)
		em.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C(255, 90, 120)),
			ColorSequenceKeypoint.new(0.5, C(255, 220, 80)),
			ColorSequenceKeypoint.new(1, C(100, 220, 255)),
		})
		em.Parent = att
	end

	-- podium
	local podiumZ = finishZ + 120
	P(
		map,
		V(18, 12, 18),
		CFrame.new(0, 6, podiumZ),
		C(255, 205, 60),
		Enum.Material.Metal,
		{ name = "Podium1", collide = true, shadow = true }
	)
	P(
		map,
		V(18, 8, 18),
		CFrame.new(-20, 4, podiumZ),
		C(200, 204, 214),
		Enum.Material.Metal,
		{ name = "Podium2", collide = true, shadow = true }
	)
	P(
		map,
		V(18, 5, 18),
		CFrame.new(20, 2.5, podiumZ),
		C(190, 120, 70),
		Enum.Material.Metal,
		{ name = "Podium3", collide = true, shadow = true }
	)
end

-- ---------------------------------------------------------------------------
-- Point d'entrée
-- ---------------------------------------------------------------------------

function MapBuilder.Build()
	MapBuilder.SetupLighting()

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	local creatures = Instance.new("Folder")
	creatures.Name = "Creatures"
	creatures.Parent = workspace
	State.CreaturesFolder = creatures

	local fx = Instance.new("Folder")
	fx.Name = "Fx"
	fx.Parent = workspace
	State.FxFolder = fx

	buildLobby(map)
	task.wait()
	buildFloor(map)
	task.wait()
	buildCliffs(map)
	task.wait()
	buildProps(map)
	task.wait()
	buildGates(map)
	task.wait()
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- Achats Robux : pass de jeu (permanents) et produits développeur (paquets de pièces).
-- Aucun achat n'est accordé sans reçu valide ; chaque reçu est enregistré (idempotent) avant d'être validé.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local RideService = require(script.Parent.RideService)

local MonetizationService = {}

local M = Config.Monetization

local function passById(id)
	for _, def in ipairs(M.GamePasses) do
		if def.id ~= 0 and def.id == id then
			return def
		end
	end
	return nil
end

local function productById(id)
	for _, def in ipairs(M.Products) do
		if def.id ~= 0 and def.id == id then
			return def
		end
	end
	return nil
end

local function grantPass(player, def)
	if ProgressService.HasPass(player, def.key) then
		return
	end
	player:SetAttribute("Pass_" .. def.key, true)
	ProgressService.RefreshAttributes(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	Remotes.Feedback:FireClient(player, { kind = "tame", title = "MERCI !", sub = def.name .. " activé" })
end

-- Vérifie les pass possédés (appelé à l'arrivée du joueur ; peut patienter sur le réseau).
function MonetizationService.LoadPasses(player)
	for _, def in ipairs(M.GamePasses) do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns and player.Parent then
				player:SetAttribute("Pass_" .. def.key, true)
			end
		end
	end
	ProgressService.RefreshAttributes(player)
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data or not DataService.IsPersistent(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById(info.ProductId)
	if not product then
		warn("[Achats] Produit inconnu : " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.receipts = data.receipts or {}
	local rid = tostring(info.PurchaseId)
	if data.receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	-- état avant l'octroi, pour annuler si l'écriture échoue
	local backup = {
		coins = data.coins,
		bones = data.bones,
		boostUntil = data.boostUntil,
		revives = data.revives,
		pot = data.pot,
		lastCollect = data.lastCollect,
	}
	if not ProgressService.GrantProduct(player, product) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	data.receipts[rid] = os.time()
	-- on ne garde que les 60 reçus les plus récents
	local ids = {}
	for key in pairs(data.receipts) do
		table.insert(ids, key)
	end
	if #ids > 60 then
		table.sort(ids, function(a, b)
			return data.receipts[a] < data.receipts[b]
		end)
		for i = 1, #ids - 60 do
			data.receipts[ids[i]] = nil
		end
	end
	DataService.MarkDirty(player)

	if not DataService.Save(player) then
		-- sauvegarde impossible : on annule et Roblox réessaiera plus tard
		for key, value in pairs(backup) do
			data[key] = value
		end
		data.receipts[rid] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- « Continuer » : si le joueur est mort en expédition, on l'utilise tout de suite
	if product.kind == "revive" and RideService.Revive(player) then
		data.revives = math.max(0, data.revives - 1)
		DataService.MarkDirty(player)
	end

	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	Remotes.Feedback:FireClient(player, { kind = "tame", title = "MERCI !", sub = product.name })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function loadPrices()
	for _, def in ipairs(M.GamePasses) do
		local entry = { key = def.key, name = def.name, desc = def.desc, available = def.id ~= 0 }
		table.insert(ProgressService.Store.passes, entry)
		if def.id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.GamePass)
				end)
				if ok and info then
					entry.price = info.PriceInRobux
				end
			end)
		end
	end
	for _, def in ipairs(M.Products) do
		local entry = { key = def.key, name = def.name, kind = def.kind, amount = def.amount, available = def.id ~= 0 }
		table.insert(ProgressService.Store.products, entry)
		if def.id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.Product)
				end)
				if ok and info then
					entry.price = info.PriceInRobux
				end
			end)
		end
	end
end

function MonetizationService.Init()
	loadPrices()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		local def = passById(passId)
		if def and wasPurchased then
			grantPass(player, def)
		end
	end)

	Remotes.Prompt.OnServerEvent:Connect(function(player, kind, key)
		if type(kind) ~= "string" or type(key) ~= "string" or not Util.allow(player, "Prompt", 1) then
			return
		end
		if kind == "pass" then
			for _, def in ipairs(M.GamePasses) do
				if def.key == key and def.id ~= 0 and not ProgressService.HasPass(player, key) then
					MarketplaceService:PromptGamePassPurchase(player, def.id)
				end
			end
		elseif kind == "product" then
			for _, def in ipairs(M.Products) do
				if def.key == key and def.id ~= 0 then
					MarketplaceService:PromptProductPurchase(player, def.id)
				end
			end
		end
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[-- Progression : or, os, zoo (animaux, niveaux, caisse), améliorations, histoire, quêtes, boutique.
-- Toutes les décisions sont prises ici (serveur) ; le client ne fait que demander.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Zoo = require(Shared.Zoo)

local DataService = require(script.Parent.DataService)
local Cosmetics = require(script.Parent.Cosmetics)

local ProgressService = {}

-- Informations de la boutique Robux (remplies par MonetizationService : prix lus sur Roblox).
ProgressService.Store = { passes = {}, products = {} }

-- Rappel appelé quand le contenu du zoo d'un joueur change (branché par ZooService).
ProgressService.OnZooChanged = function() end

local pushScheduled = {}

local function today()
	return math.floor(os.time() / 86400)
end

-- Énigme du jour (la même pour tous les joueurs ce jour-là) ; remise à zéro quand le jour change.
local function dailyRiddle(data)
	local day = today()
	if data.riddle.day ~= day then
		data.riddle = { day = day, solved = false, claimed = false }
	end
	return Config.Riddles[day % #Config.Riddles + 1]
end

local function questDef(id)
	return Config.findById(Config.QuestPool, id)
end

function ProgressService.HasPass(player, key)
	return player:GetAttribute("Pass_" .. key) == true
end

-- ---------------------------------------------------------------------------
-- Valeurs dérivées (vies, lassos, cœurs, revenus)
-- ---------------------------------------------------------------------------

function ProgressService.Lives(player)
	local lives = Config.Run.BaseLives
	if ProgressService.HasPass(player, "life") then
		lives = lives + Config.Monetization.LifePassBonus
	end
	local data = DataService.Get(player)
	if data and data.revives > 0 then
		lives = lives + 1 -- une pièce « Continuer » achetée et non utilisée devient une vie d'avance
	end
	return lives
end

-- Consomme un « Continuer » stocké au départ d'une expédition (voir RoundService).
function ProgressService.ConsumeStoredRevive(player)
	local data = DataService.Get(player)
	if data and data.revives > 0 then
		data.revives = data.revives - 1
		DataService.MarkDirty(player)
		return true
	end
	return false
end

function ProgressService.LassoCharges(player)
	local data = DataService.Get(player)
	local n = Config.Run.BaseLasso + (data and data.zooUp.lasso or 0)
	if ProgressService.HasPass(player, "lasso") then
		n = n + Config.Monetization.LassoPassBonus
	end
	return n
end

function ProgressService.LassoRange(player)
	local range = Config.Run.LassoRange
	if ProgressService.HasPass(player, "lasso") then
		range = range + Config.Monetization.LassoPassRange
	end
	return range
end

function ProgressService.HeartChance(player, zone)
	local data = DataService.Get(player)
	return zone.heartChance + Config.Zoo.HeartBonus * (data and data.zooUp.hearts or 0)
end

function ProgressService.ZooRate(player)
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local factor = Zoo.visitorFactor(data.zooUp.visitors, ProgressService.HasPass(player, "zoo"))
	return Zoo.baseIncome(data.animals) * factor
end

-- Or accumulé depuis le dernier calcul (au taux actuel du zoo).
local function accrued(player, data)
	return Zoo.pendingGold(
		ProgressService.ZooRate(player),
		data.lastCollect,
		os.time(),
		data.zooUp.storage,
		data.boostUntil
	)
end

function ProgressService.PendingGold(player)
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	return math.floor(data.pot + accrued(player, data))
end

-- À appeler AVANT tout changement du taux (capture, amélioration) : fige l'or déjà gagné dans la caisse.
local function settle(player, data)
	data.pot = data.pot + accrued(player, data)
	data.lastCollect = os.time()
end

function ProgressService.GoldForRun(player, score)
	local data = DataService.Get(player)
	return Zoo.runGold(score, data and data.zooUp.gift or 0, ProgressService.HasPass(player, "gold"))
end

-- ---------------------------------------------------------------------------
-- Histoire
-- ---------------------------------------------------------------------------

local function totalZooLevels(data)
	local n = 0
	for _, level in pairs(data.zooUp) do
		n = n + level
	end
	return n
end

local function bossCount(data)
	local n = 0
	for _ in pairs(data.bossCaptured) do
		n = n + 1
	end
	return n
end

local function maxAnimalLevel(data)
	local best = 1
	for _, entry in pairs(data.animals) do
		best = math.max(best, entry.level or 1)
	end
	return best
end

-- Renvoie progression actuelle d'un objectif.
local function goalProgress(data, goal)
	if goal.type == "animals" then
		return Zoo.countOwned(data.animals)
	elseif goal.type == "captures" then
		return data.captures
	elseif goal.type == "zooUpgrades" then
		return totalZooLevels(data)
	elseif goal.type == "boss" then
		return bossCount(data)
	elseif goal.type == "zone" then
		return data.bestZone
	elseif goal.type == "level" then
		return maxAnimalLevel(data)
	end
	return 0
end

local function currentChapter(data)
	return Config.Story[data.story.index]
end

-- ---------------------------------------------------------------------------
-- Snapshot envoyé au client
-- ---------------------------------------------------------------------------

function ProgressService.Snapshot(player)
	local data = DataService.Get(player)
	if not data then
		return { loaded = false }
	end

	local quests = {}
	for index, q in ipairs(data.quests.list) do
		local def = questDef(q.id)
		if def then
			quests[index] = {
				id = q.id,
				label = string.format(def.label, def.target),
				progress = math.min(q.progress, def.target),
				target = def.target,
				reward = def.reward,
				claimed = q.claimed,
			}
		end
	end

	local streak = data.daily.streak
	local claimable = data.daily.last ~= today()
	local nextStreak = streak
	if claimable then
		nextStreak = (data.daily.last == today() - 1) and (streak + 1) or 1
	end
	local rewardStreak = math.min(nextStreak, Config.DailyReward.MaxStreak)

	local hats = {}
	for id in pairs(data.owned.hats) do
		hats[id] = true
	end
	for _, def in ipairs(Config.Hats) do
		if def.pass and ProgressService.HasPass(player, def.pass) then
			hats[def.id] = true
		end
	end
	local passes = {}
	for _, def in ipairs(Config.Monetization.GamePasses) do
		passes[def.key] = ProgressService.HasPass(player, def.key)
	end

	-- animaux du zoo avec revenu et coût d'amélioration
	local animals = {}
	for key, entry in pairs(data.animals) do
		local def, variant = Zoo.parseKey(key)
		if def then
			animals[key] = {
				level = entry.level or 1,
				copies = entry.copies or 1,
				income = Zoo.animalIncome(def, variant, entry.level or 1),
				cost = Zoo.upgradeCost(def, variant, entry.level or 1),
			}
		end
	end

	local zones = {}
	for _, zone in ipairs(Config.Zones) do
		zones[zone.key] = Zoo.zoneUnlocked(zone, data.animals)
	end

	-- chapitre d'histoire en cours
	local story = nil
	local chapter = currentChapter(data)
	if chapter then
		local progress = goalProgress(data, chapter.goal)
		story = {
			index = data.story.index,
			total = #Config.Story,
			title = chapter.title,
			text = chapter.text,
			progress = math.min(progress, chapter.goal.n),
			target = chapter.goal.n,
			ready = progress >= chapter.goal.n,
			gold = chapter.reward.gold,
			bones = chapter.reward.bones,
		}
	end

	local riddle = dailyRiddle(data)
	local hasZoo = ProgressService.HasPass(player, "zoo")
	return {
		loaded = true,
		riddle = {
			text = riddle.text,
			solved = data.riddle.solved,
			claimed = data.riddle.claimed,
			gold = Config.RiddleReward.gold,
			bones = Config.RiddleReward.bones,
		},
		passes = passes,
		store = ProgressService.Store,
		persistent = DataService.IsPersistent(player),
		coins = data.coins,
		bones = data.bones,
		bestScore = data.bestScore,
		wins = data.wins,
		rounds = data.rounds,
		hooks = data.hooks,
		captures = data.captures,
		distance = math.floor(data.distance),
		animals = animals,
		completed = data.completed,
		zooUp = data.zooUp,
		zoo = {
			slots = Zoo.slots(data.zooUp.slots, hasZoo),
			rate = ProgressService.ZooRate(player),
			pending = ProgressService.PendingGold(player),
			capMinutes = Zoo.storageMinutes(data.zooUp.storage),
			boostLeft = math.max(0, data.boostUntil - os.time()),
			serverTime = os.time(),
			owned = Zoo.countOwned(data.animals),
		},
		zones = zones,
		zone = data.zone,
		upgrades = data.upgrades,
		owned = { hats = hats, ropes = data.owned.ropes },
		equipped = data.equipped,
		revives = data.revives,
		daily = {
			claimable = claimable,
			streak = streak,
			reward = Config.DailyReward.Base + Config.DailyReward.PerStreak * (rewardStreak - 1),
		},
		quests = quests,
		story = story,
	}
end

function ProgressService.Push(player)
	if pushScheduled[player] then
		return
	end
	pushScheduled[player] = true
	task.delay(0.15, function()
		pushScheduled[player] = nil
		if player.Parent then
			Remotes.Data:FireClient(player, ProgressService.Snapshot(player))
		end
	end)
end

function ProgressService.RefreshAttributes(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("HookRange", Config.Ride.HookBaseRange + Config.Ride.HookRangePerLevel * data.upgrades.range)
	player:SetAttribute("LassoRange", ProgressService.LassoRange(player))
	player:SetAttribute("Coins", data.coins)
	player:SetAttribute("ZooOwned", Zoo.countOwned(data.animals))
	player:SetAttribute(
		"ZooVisitors",
		math.min(
			30,
			2
				+ math.floor(
					Zoo.countOwned(data.animals)
						* Zoo.visitorFactor(data.zooUp.visitors, ProgressService.HasPass(player, "zoo"))
				)
		)
	)
end

-- ---------------------------------------------------------------------------
-- Quêtes
-- ---------------------------------------------------------------------------

function ProgressService.EnsureDaily(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local day = today()
	if data.quests.day == day and #data.quests.list > 0 then
		return
	end
	local rng = Random.new(day)
	local pool = {}
	for _, def in ipairs(Config.QuestPool) do
		table.insert(pool, def)
	end
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local list = {}
	for i = 1, 3 do
		list[i] = { id = pool[i].id, progress = 0, claimed = false }
	end
	data.quests = { day = day, list = list }
	DataService.MarkDirty(player)
end

function ProgressService.AddQuest(player, id, amount)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local def = questDef(id)
	for _, q in ipairs(data.quests.list) do
		if q.id == id and def and not q.claimed then
			if def.mode == "max" then
				if amount > q.progress then
					q.progress = amount
				end
			else
				q.progress = q.progress + amount
			end
		end
	end
	DataService.MarkDirty(player)
	ProgressService.Push(player)
end

-- ---------------------------------------------------------------------------
-- Or, os, zoo
-- ---------------------------------------------------------------------------

function ProgressService.AddCoins(player, amount)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	data.coins = data.coins + math.floor(amount)
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
end

function ProgressService.AddBones(player, amount)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	data.bones = data.bones + math.floor(amount)
	DataService.MarkDirty(player)
	ProgressService.Push(player)
end

-- Enregistre un animal récupéré. Renvoie { new, bones, gold, complete }.
function ProgressService.RecordCapture(player, def, variantIdx)
	local data = DataService.Get(player)
	local result = { new = false, bones = 0, gold = 0, complete = false }
	if not data then
		return result
	end
	local key = Zoo.key(def.id, variantIdx)
	local entry = data.animals[key]
	local variantMult = Zoo.variantMult(def, variantIdx)
	local gold = Config.Rewards.CaptureGold * def.value * variantMult

	settle(player, data)
	if entry then
		entry.copies = (entry.copies or 1) + 1
		result.bones = Zoo.duplicateBones(def, variantIdx)
		data.bones = data.bones + result.bones
	else
		result.new = true
		data.animals[key] = { level = 1, copies = 1 }
		gold = gold + Config.Rewards.NewDiscovery
	end

	if def.boss then
		data.bossCaptured[def.id] = true
	end
	if dailyRiddle(data).answer == def.id then
		data.riddle.solved = true
	end

	if result.new and not data.completed[def.id] and not def.boss then
		local all = true
		for v = 1, #Config.Variants do
			if not data.animals[Zoo.key(def.id, v)] then
				all = false
				break
			end
		end
		if all then
			data.completed[def.id] = true
			result.complete = true
			gold = gold + Config.Rewards.SpeciesComplete
		end
	end

	result.gold = math.floor(gold)
	data.coins = data.coins + result.gold
	data.captures = data.captures + 1
	DataService.MarkDirty(player)

	ProgressService.AddQuest(player, "capture", 1)
	if variantIdx > 1 then
		ProgressService.AddQuest(player, "rare", 1)
	end
	ProgressService.RefreshAttributes(player)
	ProgressService.OnZooChanged(player)
	ProgressService.Push(player)
	return result
end

-- Zone la plus lointaine atteinte (appelé pendant l'expédition).
function ProgressService.NoteZone(player, zoneIndex)
	local data = DataService.Get(player)
	if data and zoneIndex > data.bestZone then
		data.bestZone = zoneIndex
		DataService.MarkDirty(player)
		ProgressService.Push(player)
	end
	ProgressService.AddQuest(player, "zone", zoneIndex)
end

function ProgressService.SetZone(player, key)
	local data = DataService.Get(player)
	local zone = Config.zoneByKey(key)
	if data and zone and Zoo.zoneUnlocked(zone, data.animals) then
		data.zone = key
		DataService.MarkDirty(player)
		return true
	end
	return false
end

function ProgressService.GetRopeStyle(player)
	local data = DataService.Get(player)
	local rope = data and Config.findById(Config.Ropes, data.equipped.rope)
	rope = rope or Config.Ropes[1]
	return rope.color, rope.neon
end

function ProgressService.GetUpgradeLevel(player, id)
	local data = DataService.Get(player)
	return data and data.upgrades[id] or 0
end

function ProgressService.ApplyCosmetics(player)
	local data = DataService.Get(player)
	local character = player.Character
	if data and character then
		Cosmetics.applyHat(character, data.equipped.hat)
	end
end

-- Achats Robux : renvoie true si le produit a été accordé.
function ProgressService.GrantProduct(player, product)
	local data = DataService.Get(player)
	if not data then
		return false
	end
	if product.kind == "gold" then
		data.coins = data.coins + product.amount
	elseif product.kind == "bones" then
		data.bones = data.bones + product.amount
	elseif product.kind == "boost" then
		settle(player, data) -- le boost ne s'applique qu'à partir de maintenant
		local now = os.time()
		data.boostUntil = math.max(data.boostUntil, now) + product.amount * 60
	elseif product.kind == "revive" then
		data.revives = data.revives + product.amount
	else
		return false
	end
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return true
end

-- ---------------------------------------------------------------------------
-- Actions demandées par le client (RemoteFunctions)
-- ---------------------------------------------------------------------------

local function result(ok, message)
	return { ok = ok, msg = message }
end

local function handleBuy(player, kind, id)
	if not Util.allow(player, "Buy", 0.25) then
		return result(false, "Trop rapide.")
	end
	if type(kind) ~= "string" or type(id) ~= "string" then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end

	if kind == "upgrade" then
		local def = Config.findById(Config.Upgrades, id)
		if not def then
			return result(false, "Amélioration inconnue.")
		end
		local level = data.upgrades[id] or 0
		if level >= def.max then
			return result(false, "Niveau maximum atteint.")
		end
		local price = def.costs[level + 1]
		if data.coins < price then
			return result(false, "Pas assez d'or.")
		end
		data.coins = data.coins - price
		data.upgrades[id] = level + 1
	elseif kind == "hat" or kind == "rope" then
		local list = kind == "hat" and Config.Hats or Config.Ropes
		local ownedSet = kind == "hat" and data.owned.hats or data.owned.ropes
		local def = Config.findById(list, id)
		if not def then
			return result(false, "Objet inconnu.")
		end
		if def.pass then
			return result(false, "Cet objet est réservé au pass " .. def.pass:upper() .. ".")
		end
		if ownedSet[id] then
			return result(false, "Déjà possédé.")
		end
		if data.coins < def.price then
			return result(false, "Pas assez d'or.")
		end
		data.coins = data.coins - def.price
		ownedSet[id] = true
		if kind == "hat" then
			data.equipped.hat = id
		else
			data.equipped.rope = id
		end
	else
		return result(false, "Type inconnu.")
	end

	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	return result(true, "Achat réussi !")
end

local function handleEquip(player, kind, id)
	if not Util.allow(player, "Equip", 0.25) then
		return result(false, "Trop rapide.")
	end
	if type(kind) ~= "string" or type(id) ~= "string" then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end
	local hatDef = kind == "hat" and Config.findById(Config.Hats, id) or nil
	if
		kind == "hat"
		and (data.owned.hats[id] or (hatDef and hatDef.pass and ProgressService.HasPass(player, hatDef.pass)))
	then
		data.equipped.hat = id
	elseif kind == "rope" and data.owned.ropes[id] then
		data.equipped.rope = id
	else
		return result(false, "Tu ne possèdes pas cet objet.")
	end
	DataService.MarkDirty(player)
	ProgressService.ApplyCosmetics(player)
	ProgressService.Push(player)
	return result(true, "Équipé.")
end

local function handleDaily(player)
	if not Util.allow(player, "Daily", 0.5) then
		return result(false, "Trop rapide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end
	local day = today()
	if data.daily.last == day then
		return result(false, "Déjà récupéré aujourd'hui.")
	end
	if data.daily.last == day - 1 then
		data.daily.streak = data.daily.streak + 1
	else
		data.daily.streak = 1
	end
	data.daily.last = day
	local streak = math.min(data.daily.streak, Config.DailyReward.MaxStreak)
	local reward = Config.DailyReward.Base + Config.DailyReward.PerStreak * (streak - 1)
	data.coins = data.coins + reward
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return result(true, ("+%d or (série de %d jour(s))"):format(reward, data.daily.streak))
end

local function handleQuest(player, index)
	if not Util.allow(player, "Quest", 0.3) then
		return result(false, "Trop rapide.")
	end
	if type(index) ~= "number" or index % 1 ~= 0 then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	local q = data and data.quests.list[index]
	if not q then
		return result(false, "Quête introuvable.")
	end
	local def = questDef(q.id)
	if not def then
		return result(false, "Quête inconnue.")
	end
	if q.claimed then
		return result(false, "Déjà récupérée.")
	end
	if q.progress < def.target then
		return result(false, "Quête non terminée.")
	end
	q.claimed = true
	data.coins = data.coins + def.reward
	DataService.MarkDirty(player)
	ProgressService.RefreshAttributes(player)
	ProgressService.Push(player)
	return result(true, ("+%d or"):format(def.reward))
end

-- Actions du zoo : "collect" (caisse), "animal" (monter un animal avec des os), "zoo" (amélioration d'or),
-- "story" (récompense du chapitre), "zone" (zone de départ préférée).
local function handleZoo(player, action, key)
	if not Util.allow(player, "Zoo", 0.25) then
		return result(false, "Trop rapide.")
	end
	if type(action) ~= "string" then
		return result(false, "Requête invalide.")
	end
	local data = DataService.Get(player)
	if not data then
		return result(false, "Profil en cours de chargement.")
	end

	if action == "collect" then
		local gold = ProgressService.PendingGold(player)
		if gold <= 0 then
			return result(false, "La caisse est vide.")
		end
		data.coins = data.coins + gold
		data.pot = 0
		data.lastCollect = os.time()
		DataService.MarkDirty(player)
		ProgressService.RefreshAttributes(player)
		ProgressService.Push(player)
		return result(true, ("+%s or collectés"):format(Util.formatNumber(gold)))
	elseif action == "animal" then
		local def, variant = Zoo.parseKey(key)
		local entry = def and data.animals[key]
		if not entry then
			return result(false, "Animal introuvable dans ton zoo.")
		end
		local cost = Zoo.upgradeCost(def, variant, entry.level or 1)
		if not cost then
			return result(false, "Niveau maximum atteint.")
		end
		if data.bones < cost then
			return result(false, "Pas assez d'os.")
		end
		settle(player, data)
		data.bones = data.bones - cost
		entry.level = (entry.level or 1) + 1
		DataService.MarkDirty(player)
		ProgressService.OnZooChanged(player)
		ProgressService.Push(player)
		return result(true, ("%s niveau %d !"):format(def.name, entry.level))
	elseif action == "zoo" then
		local def = type(key) == "string" and Config.findById(Config.ZooUpgrades, key) or nil
		if not def then
			return result(false, "Amélioration inconnue.")
		end
		local level = data.zooUp[def.id] or 0
		if level >= def.max then
			return result(false, "Niveau maximum atteint.")
		end
		local price = def.costs[level + 1]
		if data.coins < price then
			return result(false, "Pas assez d'or.")
		end
		settle(player, data)
		data.coins = data.coins - price
		data.zooUp[def.id] = level + 1
		DataService.MarkDirty(player)
		ProgressService.RefreshAttributes(player)
		ProgressService.OnZooChanged(player)
		ProgressService.Push(player)
		return result(true, ("%s niveau %d !"):format(def.name, level + 1))
	elseif action == "story" then
		local chapter = currentChapter(data)
		if not chapter then
			return result(false, "Histoire terminée. Bravo !")
		end
		if goalProgress(data, chapter.goal) < chapter.goal.n then
			return result(false, "Objectif pas encore atteint.")
		end
		data.coins = data.coins + chapter.reward.gold
		data.bones = data.bones + chapter.reward.bones
		data.story.index = data.story.index + 1
		DataService.MarkDirty(player)
		ProgressService.RefreshAttributes(player)
		ProgressService.Push(player)
		return result(true, ("Chapitre terminé : +%d or, +%d os"):format(chapter.reward.gold, chapter.reward.bones))
	elseif action == "riddle" then
		dailyRiddle(data)
		if not data.riddle.solved then
			return result(false, "Récupère d'abord l'animal de l'énigme.")
		end
		if data.riddle.claimed then
			return result(false, "Déjà récupérée aujourd'hui.")
		end
		data.riddle.claimed = true
		data.coins = data.coins + Config.RiddleReward.gold
		data.bones = data.bones + Config.RiddleReward.bones
		DataService.MarkDirty(player)
		ProgressService.RefreshAttributes(player)
		ProgressService.Push(player)
		return result(true, ("Bravo ! +%d or, +%d os"):format(Config.RiddleReward.gold, Config.RiddleReward.bones))
	elseif action == "zone" then
		if ProgressService.SetZone(player, key) then
			ProgressService.Push(player)
			return result(true, "Zone de départ choisie.")
		end
		return result(false, "Zone verrouillée.")
	end
	return result(false, "Action inconnue.")
end

function ProgressService.Init()
	Remotes.Buy.OnServerInvoke = handleBuy
	Remotes.Equip.OnServerInvoke = handleEquip
	Remotes.ClaimDaily.OnServerInvoke = handleDaily
	Remotes.ClaimQuest.OnServerInvoke = handleQuest
	Remotes.ZooAction.OnServerInvoke = handleZoo

	Players.PlayerRemoving:Connect(function(player)
		pushScheduled[player] = nil
		Util.forget(player)
	end)
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">RideService</string><ProtectedString name="Source"><![CDATA[-- Cœur du gameplay : monter un animal, bondir, lasso, cœurs et captures, vies, boss, zones, arrivée.
-- Le serveur est autoritaire : positions des bêtes, portée du lasso, score et états sont validés ici.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local Zoo = require(Shared.Zoo)

local State = require(script.Parent.State)
local CreatureService = require(script.Parent.CreatureService)
local ProgressService = require(script.Parent.ProgressService)
local Fx = require(script.Parent.Fx)

local RideService = {}

local rng = Random.new()

-- ---------------------------------------------------------------------------
-- Utilitaires
-- ---------------------------------------------------------------------------

local function getParts(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return nil
	end
	return char, hrp, hum
end

local function setStatus(player, run, status)
	run.status = status
	Remotes.Status:FireClient(player, status)
end

local function feedback(player, kind, title, sub)
	Remotes.Feedback:FireClient(player, { kind = kind, title = title, sub = sub })
end

local function comboMult(run)
	return 1 + math.min(run.combo, Config.Ride.ComboMax) * Config.Ride.ComboStep
end

local function comboWindow(player)
	return Config.Ride.ComboWindowBase
		+ Config.Ride.ComboWindowPerLevel * ProgressService.GetUpgradeLevel(player, "combo")
end

local function setDust(creature, enabled)
	local attachment = creature.root:FindFirstChild("DustAttachment")
	local dust = attachment and attachment:FindFirstChild("Dust")
	if dust then
		dust.Enabled = enabled
	end
end

local function addScore(run, amount)
	run.score = run.score + amount
end

function RideService.NewRun(lives, lassoCharges)
	return {
		lives = lives or Config.Run.BaseLives,
		maxLives = lives or Config.Run.BaseLives,
		lasso = lassoCharges or Config.Run.BaseLasso,
		lassoAt = 0,
		captures = 0,
		gold = 0,
		bones = 0,
		names = {},
		zoneIdx = 1,
		deadAt = 0,
		revived = false,
		status = "Riding",
		score = 0,
		combo = 0,
		maxCombo = 0,
		lastHookT = 0,
		hooks = 0,
		tames = 0,
		distance = 0,
		bestZ = 0,
		z = 0,
		creature = nil,
		weld = nil,
		mountT = 0,
		tameT = 0,
		airStart = 0,
		lastCreature = nil,
		lastCreatureUntil = 0,
		downUntil = 0,
		pubT = 0,
		finishPlace = 0,
		coins = 0,
		rank = 0,
	}
end

function RideService.ToLobby(player)
	local char = player.Character
	if not char then
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hrp then
		hrp.Anchored = false
		local old = hrp:FindFirstChild("RideWeld")
		if old then
			old:Destroy()
		end
	end
	if hum then
		hum.Sit = false
	end
	local home = State.PlotCFrames[player] or State.LobbyCFrame
	char:PivotTo(home * CFrame.new((rng:NextNumber() - 0.5) * 6, 0, (rng:NextNumber() - 0.5) * 6))
end

-- ---------------------------------------------------------------------------
-- Monter / quitter une bête
-- ---------------------------------------------------------------------------

function RideService.Detach(run)
	if run.weld then
		run.weld:Destroy()
		run.weld = nil
	end
	local creature = run.creature
	if creature then
		creature.rider = nil
		creature.steer = 0
		creature.angry = false
		if not creature.removed then
			creature.model:SetAttribute("Ridden", false)
			creature.model:SetAttribute("Angry", false)
			setDust(creature, false)
		end
		run.creature = nil
	end
end

function RideService.Mount(player, run, creature)
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	RideService.Detach(run)

	creature.rider = player
	creature.steer = 0
	creature.angry = false
	run.creature = creature
	run.mountT = 0
	run.tameT = 0

	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	hrp.CFrame = CreatureService.SeatWorldCFrame(creature)

	local weld = Instance.new("WeldConstraint")
	weld.Name = "RideWeld"
	weld.Part0 = creature.root
	weld.Part1 = hrp
	weld.Parent = hrp
	run.weld = weld

	hum.Sit = true
	creature.model:SetAttribute("Ridden", true)
	setDust(creature, true)

	local label = creature.def.name
	if creature.variantIdx > 1 then
		label = label .. " " .. creature.variant.name
	end
	player:SetAttribute("RideName", label)
	player:SetAttribute("TameProgress", 0)

	setStatus(player, run, "Riding")
	return true
end

-- Quitte la monture avec une vitesse donnée (bond, geyser, désarçonnement).
-- Traînée colorée derrière le cavalier pendant le vol (couleur de sa corde).
function RideService.AddTrail(player, hrp)
	local old = hrp:FindFirstChild("FlightTrail")
	if old then
		old:Destroy()
	end
	local color = ProgressService.GetRopeStyle(player)
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA0"
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailA1"
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "FlightTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.Lifetime = 0.45
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = hrp
	Debris:AddItem(trail, 2.2)
	Debris:AddItem(a0, 2.2)
	Debris:AddItem(a1, 2.2)
end

local function launch(player, run, velocity)
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	-- la bête qu'on vient de quitter ne peut pas être relassoée aussitôt (sinon le bond ne sert à rien)
	run.lastCreature = run.creature
	run.lastCreatureUntil = os.clock() + (run.creature and run.creature.boss and 0.4 or 1.0)
	RideService.Detach(run)
	hum.Sit = false
	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = velocity
	pcall(function()
		hrp:SetNetworkOwner(player)
	end)
	run.airStart = os.clock()
	player:SetAttribute("TameProgress", 0)
	RideService.AddTrail(player, hrp)
	setStatus(player, run, "Air")
	Remotes.Launched:FireClient(player, velocity)
	return true
end

function RideService.Boost(player, velocity)
	local run = State.Participants[player]
	if not run then
		return false
	end
	local s = run.status
	if s ~= "Riding" and s ~= "Air" and s ~= "Down" then
		return false
	end
	return launch(player, run, velocity)
end

-- Le joueur titube sans perdre de vie (animal disparu, accroche avortée) ; il est remonté sur un animal.
local function stumble(player, run)
	run.combo = 0
	run.downUntil = os.clock() + Config.Ride.DownTime
	local _, hrp = getParts(player)
	if hrp then
		hrp.Anchored = false
	end
	player:SetAttribute("TameProgress", 0)
	setStatus(player, run, "Down")
end

-- Mort : plus de vie. Une fenêtre permet d'acheter « Continuer » avant le retour au zoo.
local function die(player, run)
	RideService.Detach(run)
	local zone = Config.zoneAt(run.z)
	run.deadAt = os.clock()
	local _, hrp = getParts(player)
	if hrp then
		hrp.Anchored = true
		Fx.burst(hrp.Position, zone.hazard.color, 40, 40)
	end
	player:SetAttribute("TameProgress", 0)
	setStatus(player, run, "Dead")
	feedback(player, "out", "TOMBÉ !", zone.hazard.death)
end

-- Le joueur touche le sol mortel : il perd une vie, ou meurt s'il n'en a plus.
local function downPlayer(player, run, title)
	run.combo = 0
	run.lives = run.lives - 1
	local _, hrp = getParts(player)
	if hrp then
		Fx.burst(hrp.Position - Vector3.new(0, 2, 0), Config.zoneAt(run.z).hazard.color, 24, 22)
	end
	if run.lives <= 0 then
		die(player, run)
		return
	end
	stumble(player, run)
	feedback(player, "down", title or "VIE PERDUE !", ("Il te reste %d vie(s). Rattrape un animal !"):format(run.lives))
end

-- « Continuer » acheté pendant la fenêtre de mort : une vie de plus, retour sur un animal.
function RideService.Revive(player)
	local run = State.Participants[player]
	if not run or run.status ~= "Dead" or State.Phase ~= "Running" then
		return false
	end
	if os.clock() - run.deadAt > Config.Run.ReviveWindow then
		return false
	end
	run.lives = 1
	run.revived = true
	local _, hrp = getParts(player)
	if hrp then
		hrp.Anchored = false
	end
	feedback(player, "tame", "ON REPART !", "Tu as une vie de plus.")
	stumble(player, run)
	return true
end

-- Projette un joueur au sol (météore).
function RideService.Knock(player)
	local run = State.Participants[player]
	if not run then
		return false
	end
	local s = run.status
	if s ~= "Riding" and s ~= "Air" and s ~= "Down" then
		return false
	end
	local _, hrp, hum = getParts(player)
	if not hrp then
		return false
	end
	RideService.Detach(run)
	hum.Sit = false
	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = Vector3.new((rng:NextNumber() - 0.5) * 40, 45, 0)
	pcall(function()
		hrp:SetNetworkOwner(player)
	end)
	run.combo = 0
	run.airStart = os.clock()
	setStatus(player, run, "Air")
	Remotes.Launched:FireClient(player, Vector3.new(0, 45, 20))
	feedback(player, "down", "TOUCHÉ !", "Rattrape un animal avant de tomber !")
	return true
end

local function rescue(player, run)
	local _, hrp = getParts(player)
	if not hrp then
		return
	end
	local pos = hrp.Position
	local creature = CreatureService.FindRescue(pos.X, pos.Z)
	if not creature then
		local x = math.clamp(pos.X, -Config.Track.HalfWidth + 8, Config.Track.HalfWidth - 8)
		creature = CreatureService.Spawn(x, pos.Z + 14, nil, 1, 1)
	end
	RideService.Mount(player, run, creature)
end

-- ---------------------------------------------------------------------------
-- Combo, dressage
-- ---------------------------------------------------------------------------

local function onHookSuccess(player, run, distance)
	local now = os.clock()
	if run.combo > 0 and now - run.lastHookT > comboWindow(player) then
		run.combo = 0
	end
	run.combo = run.combo + 1
	run.maxCombo = math.max(run.maxCombo, run.combo)
	run.lastHookT = now
	run.hooks = run.hooks + 1

	local mult = comboMult(run)
	local points = Config.Score.HookBonus * mult
	local title = "LASSO !"
	if distance >= Config.Score.LongHookDistance then
		points = points + Config.Score.LongHookBonus
		title = "LONG LASSO !"
	end
	addScore(run, points)

	local sub = ("+%d"):format(math.floor(points))
	if run.combo >= 2 then
		sub = sub .. (" · COMBO x%.1f"):format(mult)
	end
	feedback(player, "hook", title, sub)
end

-- Secondes en selle pour gagner la confiance d'un animal à cœur.
local function tameTimeNeeded(player, creature)
	if creature.boss then
		return creature.def.bossRide
	end
	local level = ProgressService.GetUpgradeLevel(player, "taming")
	local factor = 1 - Config.Tame.PerLevel * level
	return math.max(Config.Tame.MinTime, creature.def.tameTime * factor)
end

local function creatureLabel(creature)
	local name = creature.def.name
	if creature.variantIdx > 1 and not creature.boss then
		name = name .. " " .. creature.variant.name
	end
	return name
end

-- La confiance est gagnée : le cœur bat, le joueur a quelques secondes pour récupérer l'animal.
local function markReady(player, creature)
	creature.tamed = true
	creature.tamedBy = player
	creature.collectUntil = os.clock() + Config.Run.CollectWindow
	creature.model:SetAttribute("Ready", true)
	feedback(player, "tame", "CŒUR PRÊT !", "Appuie sur RÉCUPÉRER avant qu'il ne t'échappe.")
	Fx.burst(creature.root.Position + Vector3.new(0, 5, 0), Color3.fromRGB(255, 120, 170), 30, 26)
end

-- Le cœur disparaît : l'animal a repris sa liberté (désarçonnement avant la récupération).
local function loseHeart(creature)
	creature.hearted = false
	creature.tamed = false
	creature.tamedBy = nil
	if not creature.removed then
		creature.model:SetAttribute("Heart", false)
		creature.model:SetAttribute("Ready", false)
	end
end

-- L'animal rejoint le zoo : or, os, points, effets. `how` = "ride" ou "lasso".
local function captureCreature(player, run, creature, how)
	local result = ProgressService.RecordCapture(player, creature.def, creature.variantIdx)
	run.captures = run.captures + 1
	run.gold = run.gold + result.gold
	run.bones = run.bones + result.bones
	table.insert(run.names, creatureLabel(creature))
	local points = Config.Score.CapturePoints * creature.def.value * Zoo.variantMult(creature.def, creature.variantIdx)
	addScore(run, points)

	local name = creatureLabel(creature)
	local title = result.new and "NOUVEAU PENSIONNAIRE !" or "DÉJÀ AU ZOO !"
	local sub = ("%s · +%d or"):format(name, result.gold)
	if result.bones > 0 then
		sub = sub .. (" · +%d os"):format(result.bones)
	end
	if result.complete then
		sub = sub .. " · ESPÈCE COMPLÈTE !"
	end
	Fx.burst(creature.root.Position + Vector3.new(0, 5, 0), Color3.fromRGB(255, 120, 170), 50, 34)
	if creature.boss then
		Remotes.Feedback:FireAllClients({
			kind = "event",
			title = "BOSS CAPTURÉ !",
			sub = player.DisplayName .. " a gagné " .. name,
		})
	else
		feedback(player, "tame", title, sub)
	end
	if how == "ride" then
		-- l'animal part au zoo en bondissant : le joueur est propulsé en avant
		launch(
			player,
			run,
			Vector3.new(creature.vx, Config.Ride.LaunchUp * 1.1, creature.speed + Config.Ride.LaunchBoost * 1.5)
		)
	end
	CreatureService.Remove(creature)
	return result
end

-- ---------------------------------------------------------------------------
-- Remotes
-- ---------------------------------------------------------------------------

function RideService.HandleLaunch(player)
	if State.Phase ~= "Running" then
		return
	end
	local run = State.Participants[player]
	if not run or run.status ~= "Riding" or not run.creature then
		return
	end
	if not Util.allow(player, "Launch", 0.15) then
		return
	end
	local c = run.creature
	local velocity = Vector3.new(c.vx, Config.Ride.LaunchUp, c.speed + Config.Ride.LaunchBoost)
	launch(player, run, velocity)
end

function RideService.HandleSteer(player, value)
	if not Util.isFiniteNumber(value) or not Util.allow(player, "Steer", 0.04) then
		return
	end
	local run = State.Participants[player]
	if not run or run.status ~= "Riding" or not run.creature then
		return
	end
	run.creature.steer = math.clamp(value, -1, 1)
end

local function spawnRope(player, hrp, creature, duration)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) or hrp
	local color, neon = ProgressService.GetRopeStyle(player)

	local a0 = Instance.new("Attachment")
	a0.Parent = hand
	local a1 = Instance.new("Attachment")
	a1.Position = creature.seat.Position
	a1.Parent = creature.root

	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = 0.4
	beam.Width1 = 0.4
	beam.FaceCamera = true
	beam.Segments = 8
	beam.LightEmission = neon and 1 or 0
	beam.Parent = hand

	local life = duration + 0.25
	Debris:AddItem(beam, life)
	Debris:AddItem(a0, life)
	Debris:AddItem(a1, life)
end

function RideService.HandleHook(player, id)
	if not Util.isFiniteNumber(id) or id % 1 ~= 0 or State.Phase ~= "Running" then
		return
	end
	local run = State.Participants[player]
	if not run or (run.status ~= "Air" and run.status ~= "Down") then
		return
	end
	if not Util.allow(player, "Hook", Config.Ride.HookCooldown) then
		return
	end
	local creature = State.Creatures[id]
	if not creature or creature.removed or creature.rider then
		return
	end
	local _, hrp = getParts(player)
	if not hrp then
		return
	end

	local seatCF = CreatureService.SeatWorldCFrame(creature)
	local delta = seatCF.Position - hrp.Position
	local range = (player:GetAttribute("HookRange") or Config.Ride.HookBaseRange) + Config.Ride.HookTolerance
	if delta.Magnitude > range then
		return
	end
	-- en l'air : la bête doit être devant (marge de latence) ; au sol : elle peut passer à côté
	local minDz = run.status == "Air" and -4 or -25
	if delta.Z < minDz then
		return
	end
	if creature == run.lastCreature and os.clock() < (run.lastCreatureUntil or 0) then
		return
	end

	-- Réserver la bête immédiatement : personne d'autre ne peut la lasso.
	creature.rider = player
	run.status = "Hooking"
	Remotes.Status:FireClient(player, "Hooking")
	hrp.Anchored = true -- le serveur déplace le joueur pendant l'attraction (mouvement fluide, sans conflit)

	local distance = delta.Magnitude
	local duration = math.clamp(distance / 200, 0.08, 0.3)
	spawnRope(player, hrp, creature, duration)

	task.spawn(function()
		local startCF = hrp.CFrame
		local t0 = os.clock()
		local aborted = false
		while true do
			local alpha = (os.clock() - t0) / duration
			if alpha >= 1 then
				break
			end
			if run.status ~= "Hooking" or not hrp.Parent or creature.removed then
				aborted = true
				break
			end
			local target = CreatureService.SeatWorldCFrame(creature)
			local eased = alpha * alpha * (3 - 2 * alpha)
			hrp.CFrame = startCF:Lerp(target, eased)
			RunService.Heartbeat:Wait()
		end

		if not aborted and (run.status ~= "Hooking" or not hrp.Parent or creature.removed) then
			aborted = true
		end

		if aborted then
			if creature.rider == player then
				creature.rider = nil
			end
			if hrp.Parent then
				hrp.Anchored = false
			end
			-- Si le joueur est toujours en jeu (l'animal a disparu), il titube puis est remonté.
			if run.status == "Hooking" and player.Parent then
				stumble(player, run)
			end
			return
		end

		if RideService.Mount(player, run, creature) then
			onHookSuccess(player, run, distance)
		else
			creature.rider = nil
			stumble(player, run)
		end
	end)
end

-- Récupérer l'animal qu'on monte (confiance gagnée, cœur prêt).
function RideService.HandleCollect(player)
	if State.Phase ~= "Running" or not Util.allow(player, "Collect", 0.3) then
		return
	end
	local run = State.Participants[player]
	local c = run and run.creature
	if not run or run.status ~= "Riding" or not c or c.removed or c.rider ~= player then
		return
	end
	if not c.tamed or c.tamedBy ~= player or os.clock() > c.collectUntil then
		return
	end
	captureCreature(player, run, c, "ride")
end

-- Lasso de capture : vise un animal à cœur à distance (visée assistée côté client, tout est revalidé ici).
function RideService.HandleLasso(player, id)
	if not Util.isFiniteNumber(id) or id % 1 ~= 0 or State.Phase ~= "Running" then
		return
	end
	local run = State.Participants[player]
	if not run or (run.status ~= "Riding" and run.status ~= "Air" and run.status ~= "Down") then
		return
	end
	if run.lasso <= 0 or os.clock() - run.lassoAt < Config.Run.LassoCooldown then
		return
	end
	if not Util.allow(player, "Lasso", 0.5) then
		return
	end
	local creature = State.Creatures[id]
	if not creature or creature.removed or creature.rider or not creature.hearted or creature.boss then
		return
	end
	local _, hrp = getParts(player)
	if not hrp then
		return
	end
	local range = (player:GetAttribute("LassoRange") or Config.Run.LassoRange) + Config.Ride.HookTolerance
	local distance = (creature.root.Position - hrp.Position).Magnitude
	if distance > range then
		return
	end

	run.lasso = run.lasso - 1
	run.lassoAt = os.clock()
	spawnRope(player, hrp, creature, 0.35)
	local chance = Config.Run.LassoBaseChance - Config.Run.LassoVariantPenalty * (creature.variantIdx - 1)
	if rng:NextNumber() <= chance then
		task.delay(0.3, function()
			if
				not creature.removed
				and creature.hearted
				and not creature.rider
				and State.Participants[player] == run
			then
				captureCreature(player, run, creature, "lasso")
			end
		end)
	else
		feedback(player, "warn", "RATÉ !", ("L'animal s'est débattu. Il te reste %d lasso(s)."):format(run.lasso))
	end
end

-- ---------------------------------------------------------------------------
-- Fin de course d'un joueur
-- ---------------------------------------------------------------------------

function RideService.Eliminate(player, run, reason)
	if run.status == "Out" or run.status == "Finished" then
		return
	end
	RideService.Detach(run)
	run.status = "Out"
	Remotes.Status:FireClient(player, "Out")
	player:SetAttribute("TameProgress", 0)
	feedback(player, "out", "FIN D'EXPÉDITION", reason or "Tu es hors course.")
	RideService.ToLobby(player)
end

local function finish(player, run)
	State.FinishCount = State.FinishCount + 1
	local place = State.FinishCount
	run.finishPlace = place
	local bonus = Config.Score.Finish[place] or Config.Score.FinishOther
	addScore(run, bonus)
	RideService.Detach(run)
	run.status = "Finished"
	Remotes.Status:FireClient(player, "Finished")
	player:SetAttribute("TameProgress", 0)
	feedback(player, "finish", "EXPÉDITION COMPLÈTE !", ("%de · +%d pts"):format(place, bonus))
	local char, hrp, hum = getParts(player)
	if char then
		hrp.Anchored = false
		hum.Sit = false
		char:PivotTo(State.FinishCFrame * CFrame.new((rng:NextNumber() - 0.5) * 80, 0, (rng:NextNumber() - 0.5) * 40))
	end
end

-- ---------------------------------------------------------------------------
-- Boucle principale (appelée à chaque Heartbeat pendant la manche)
-- ---------------------------------------------------------------------------

local function publish(player, run, now)
	player:SetAttribute("RunScore", math.floor(run.score))
	player:SetAttribute("Combo", run.combo)
	local left = 0
	if run.combo > 0 then
		left = math.clamp(1 - (now - run.lastHookT) / comboWindow(player), 0, 1)
	end
	player:SetAttribute("ComboLeft", math.floor(left * 20) / 20)
	player:SetAttribute("ComboMult", math.floor(comboMult(run) * 10) / 10)
	player:SetAttribute("Lives", run.lives)
	player:SetAttribute("MaxLives", run.maxLives)
	player:SetAttribute("Lasso", run.lasso)
	player:SetAttribute("Captures", run.captures)
	player:SetAttribute("RunGold", run.gold)
	player:SetAttribute("ZoneIdx", run.zoneIdx)
	local c = run.creature
	local hearted = c ~= nil and run.status == "Riding" and c.hearted
	player:SetAttribute("RideHeart", hearted)
	player:SetAttribute("CanCollect", hearted and c.tamed and c.tamedBy == player or false)
	player:SetAttribute("RideBoss", c ~= nil and c.boss or false)
	if hearted and not c.tamed then
		local needed = tameTimeNeeded(player, c)
		local got = c.boss and (c.progress[player] or 0) or run.tameT
		player:SetAttribute("TameProgress", math.floor(math.clamp(got / needed, 0, 1) * 20) / 20)
	elseif hearted then
		player:SetAttribute("TameProgress", 1)
	else
		player:SetAttribute("TameProgress", 0)
	end
	if run.status == "Dead" then
		player:SetAttribute("ReviveLeft", math.max(0, math.ceil(Config.Run.ReviveWindow - (now - run.deadAt))))
	else
		player:SetAttribute("ReviveLeft", 0)
	end
end

local function stepRiding(player, run, hrp, dt, now)
	local c = run.creature
	if not c or c.removed or c.rider ~= player then
		stumble(player, run)
		return
	end
	run.mountT = run.mountT + dt

	-- filet de sécurité : si la soudure ne suit pas l'animal (physique inattendue), on recale le cavalier
	local seat = CreatureService.SeatWorldCFrame(c)
	if (hrp.Position - seat.Position).Magnitude > 4 then
		hrp.CFrame = seat
	end

	local rate = Config.Score.RidePerSecond * c.def.value * Zoo.variantMult(c.def, c.variantIdx) * comboMult(run)
	addScore(run, rate * dt)

	if run.combo > 0 and now - run.lastHookT > comboWindow(player) then
		run.combo = 0
	end

	-- confiance : seulement sur un animal à cœur
	if c.hearted and not c.tamed then
		if c.boss then
			c.progress[player] = (c.progress[player] or 0) + dt
			if c.progress[player] >= tameTimeNeeded(player, c) then
				markReady(player, c)
			end
		else
			run.tameT = run.tameT + dt
			if run.tameT >= tameTimeNeeded(player, c) then
				markReady(player, c)
			end
		end
	end

	-- l'animal prêt s'échappe si on ne le récupère pas à temps
	if c.tamed and now > c.collectUntil then
		loseHeart(c)
		feedback(player, "down", "IL T'A ÉCHAPPÉ !", "Le cœur a disparu. Rattrape un autre animal !")
		launch(player, run, Vector3.new(c.vx, Config.Ride.LaunchUp * 1.12, c.speed * 1.2 + Config.Ride.LaunchBoost))
		return
	end

	local buckAfter = c.boss and Config.Run.BossBuckAfter or c.def.buckAfter
	if buckAfter then
		if run.mountT >= buckAfter - Config.Ride.BuckWarning and not c.angry then
			c.angry = true
			c.model:SetAttribute("Angry", true)
			feedback(player, "warn", "ATTENTION !", "L'animal s'énerve : bondis avant qu'il te désarçonne !")
		end
		if run.mountT >= buckAfter then
			if c.tamed then
				loseHeart(c)
			end
			-- un boss te projette en arrière : il file devant et tu peux le relasser pour continuer
			local forward = c.boss and c.speed * 0.55 or c.speed * 1.2 + Config.Ride.LaunchBoost
			local velocity = Vector3.new(c.vx, Config.Ride.LaunchUp * 1.12, forward)
			if launch(player, run, velocity) then
				if c.boss then
					feedback(player, "buck", "IL T'A PROJETÉ !", "Relance-toi sur le boss : ta confiance est gardée.")
				else
					feedback(player, "buck", "DÉSARÇONNÉ !", "Bond bonus : rattrape un autre animal !")
				end
			end
		end
	end
end

local function stepAir(player, run, hrp, now)
	local elapsed = now - run.airStart
	local pos = hrp.Position
	local tooFast = hrp.AssemblyLinearVelocity.Magnitude > 260
	local touchedGround = elapsed > 0.2 and pos.Y < Config.Track.FloorTop + 5.5
	if elapsed > Config.Ride.AirMax or tooFast or pos.Y < -30 or touchedGround then
		downPlayer(player, run)
	end
end

-- Zone atteinte : bannière, quête, boss de la zone.
local function trackZones(player, run, pos)
	local idx = Config.zoneIndex(pos.Z)
	if idx > run.zoneIdx then
		run.zoneIdx = idx
		local zone = Config.Zones[idx]
		ProgressService.NoteZone(player, idx)
		feedback(player, "event", "ZONE " .. idx .. " : " .. zone.name, "Danger : " .. zone.hazard.name .. " !")
	end
	-- le boss d'une zone apparaît quand le premier joueur approche de sa fin
	for index, zone in ipairs(Config.Zones) do
		local limit = math.min(zone.to, Config.Track.FinishZ)
		if not State.BossesSpawned[index] and index == idx and pos.Z >= limit - 330 then
			State.BossesSpawned[index] = true
			local x = (rng:NextNumber() * 2 - 1) * (Config.Track.HalfWidth - 14)
			local boss = CreatureService.Spawn(x, pos.Z + 160, zone.boss, 1, 1)
			Remotes.Feedback:FireAllClients({
				kind = "danger",
				title = "BOSS : " .. boss.def.name:upper(),
				sub = "Monte-le 9 s pour le récupérer. Il se débat !",
			})
			workspace:SetAttribute("BossActive", true)
		end
	end
end

function RideService.Step(dt)
	local now = os.clock()
	for player, run in pairs(State.Participants) do
		local status = run.status
		if status == "Dead" then
			if now - run.deadAt > Config.Run.ReviveWindow then
				RideService.Eliminate(player, run, "Ton expédition s'arrête ici.")
			end
			run.pubT = run.pubT + dt
			if run.pubT >= 0.1 then
				run.pubT = 0
				publish(player, run, now)
			end
		elseif status ~= "Out" and status ~= "Finished" then
			local _, hrp = getParts(player)
			if not hrp then
				RideService.Eliminate(player, run, "Tu as quitté l'expédition.")
			else
				local pos = hrp.Position
				run.z = pos.Z

				if pos.Z > run.bestZ then
					local gain = pos.Z - run.bestZ
					run.bestZ = pos.Z
					run.distance = run.distance + gain
					addScore(run, gain * Config.Score.DistanceFactor)
				end
				trackZones(player, run, pos)

				if pos.Z >= Config.Track.FinishZ and status ~= "Hooking" then
					finish(player, run)
				else
					if status == "Riding" then
						stepRiding(player, run, hrp, dt, now)
					elseif status == "Air" then
						stepAir(player, run, hrp, now)
					elseif status == "Down" then
						if pos.Y < -30 or now >= run.downUntil then
							rescue(player, run)
						end
					end
				end

				run.pubT = run.pubT + dt
				if run.pubT >= 0.1 then
					run.pubT = 0
					publish(player, run, now)
				end
			end
		end
	end
end

function RideService.Init()
	Remotes.Launch.OnServerEvent:Connect(RideService.HandleLaunch)
	Remotes.Steer.OnServerEvent:Connect(RideService.HandleSteer)
	Remotes.Hook.OnServerEvent:Connect(RideService.HandleHook)
	Remotes.Collect.OnServerEvent:Connect(RideService.HandleCollect)
	Remotes.Lasso.OnServerEvent:Connect(RideService.HandleLasso)

	Players.PlayerRemoving:Connect(function(player)
		local run = State.Participants[player]
		if run then
			RideService.Detach(run)
			run.status = "Out"
		end
	end)
end

return RideService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">RoundService</string><ProtectedString name="Source"><![CDATA[-- Boucle d'expéditions : attente des joueurs prêts -> compte à rebours -> expédition -> résultats.
-- Les joueurs prêts partent ensemble dans la zone choisie par la majorité. Les récompenses sont versées ici.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local CreatureService = require(script.Parent.CreatureService)
local RideService = require(script.Parent.RideService)
local EventService = require(script.Parent.EventService)
local Fx = require(script.Parent.Fx)
local MapBuilder = require(script.Parent.MapBuilder)

local RoundService = {}

local function isReady(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and hrp ~= nil and hum.Health > 0 and DataService.Get(player) ~= nil
end

-- Joueurs qui ont choisi de partir (bouton « Partir en expédition »).
local function readyPlayers()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if State.Ready[player] and isReady(player) then
			table.insert(list, player)
		end
	end
	return list
end

local function broadcastScores()
	local list = {}
	for player, run in pairs(State.Participants) do
		table.insert(list, { n = player.DisplayName, s = math.floor(run.score), st = run.status, id = player.UserId })
	end
	table.sort(list, function(a, b)
		return a.s > b.s
	end)
	local top = {}
	for i = 1, math.min(#list, 12) do
		top[i] = list[i]
	end
	Remotes.Scores:FireAllClients(top)
end

local function intermission()
	local waiting = true
	workspace:SetAttribute("Waiting", true)
	State.SetPhase("Intermission", 0)
	local endAt = 0
	local lastText = 0

	while true do
		local ready = #readyPlayers()
		workspace:SetAttribute("ReadyCount", ready)
		if ready >= Config.Round.MinPlayers then
			if waiting then
				waiting = false
				endAt = os.clock() + Config.Round.Intermission
				workspace:SetAttribute("Waiting", false)
				State.SetPhase("Intermission", Config.Round.Intermission)
			end
			if os.clock() >= endAt then
				return
			end
		elseif not waiting then
			waiting = true
			workspace:SetAttribute("Waiting", true)
			State.SetPhase("Intermission", 0)
		end

		if os.clock() - lastText >= 1 then
			lastText = os.clock()
			if waiting then
				MapBuilder.SetStatus("Choisis ta zone et pars en expédition !")
			else
				MapBuilder.SetStatus(
					("Départ dans %d s (%d prêt(s))"):format(math.max(0, math.ceil(endAt - os.clock())), ready)
				)
			end
		end
		task.wait(0.25)
	end
end

local function startPositions(index)
	local col = (index - 1) % 6
	local row = math.floor((index - 1) / 6)
	return (col - 2.5) * 16, 8 + row * 16
end

-- Zone de départ : celle que choisit la majorité des joueurs prêts (égalité : la moins avancée).
local function chooseZone(participants)
	local votes = {}
	for _, player in ipairs(participants) do
		local data = DataService.Get(player)
		local _, index = Config.zoneByKey(data and data.zone or "savane")
		index = index or 1
		votes[index] = (votes[index] or 0) + 1
	end
	local best, bestVotes = 1, -1
	for index = 1, #Config.Zones do
		if (votes[index] or 0) > bestVotes then
			best, bestVotes = index, votes[index] or 0
		end
	end
	return best
end

local function computeResults(zoneIdx)
	local ranking = {}
	for player, run in pairs(State.Participants) do
		table.insert(ranking, { player = player, run = run })
	end
	table.sort(ranking, function(a, b)
		if a.run.score ~= b.run.score then
			return a.run.score > b.run.score
		end
		return a.run.distance > b.run.distance
	end)

	local competitive = #ranking >= 2
	local payload = {}

	for rank, entry in ipairs(ranking) do
		local player, run = entry.player, entry.run
		run.rank = rank
		local roundGold = Config.Rewards.Participation
		if player.Parent then
			roundGold = roundGold + ProgressService.GoldForRun(player, run.score)
		end
		if competitive then
			roundGold = roundGold + (Config.Rewards.Place[rank] or 0)
		end

		if player.Parent and DataService.Get(player) then
			local data = DataService.Get(player)
			data.rounds = data.rounds + 1
			data.hooks = data.hooks + run.hooks
			data.distance = data.distance + run.distance
			if rank == 1 and competitive then
				data.wins = data.wins + 1
			end
			if run.score > data.bestScore then
				data.bestScore = math.floor(run.score)
				DataService.SubmitBest(player, run.score)
			end
			DataService.MarkDirty(player)
			ProgressService.AddQuest(player, "rounds", 1)
			ProgressService.AddQuest(player, "hooks", run.hooks)
			ProgressService.AddQuest(player, "distance", math.floor(run.distance))
			ProgressService.AddQuest(player, "combo", run.maxCombo)
			ProgressService.AddQuest(player, "score", math.floor(run.score))
			ProgressService.AddCoins(player, roundGold)
		end

		table.insert(payload, {
			id = player.UserId,
			n = player.DisplayName,
			score = math.floor(run.score),
			rank = rank,
			gold = roundGold + run.gold,
			bones = run.bones,
			captures = run.captures,
			names = run.names,
			hooks = run.hooks,
			dist = math.floor(run.distance),
			finish = run.finishPlace,
			combo = run.maxCombo,
			zone = math.max(zoneIdx, run.zoneIdx),
		})
	end
	return payload
end

local function runRound()
	local participants = readyPlayers()
	if #participants < Config.Round.MinPlayers then
		return
	end

	State.RoundId = State.RoundId + 1
	local roundId = State.RoundId
	local zoneIdx = chooseZone(participants)
	local zone = Config.Zones[zoneIdx]
	local startZ = zone.start

	State.Participants = {}
	State.FinishCount = 0
	State.Frozen = true
	State.RunElapsed = 0
	State.StartZone = zoneIdx
	State.BossesSpawned = {}
	workspace:SetAttribute("BossActive", false)
	workspace:SetAttribute("StartZone", zoneIdx)
	CreatureService.Clear()
	Fx.clear()
	EventService.Reset()

	local heartBonus = 0
	for _, player in ipairs(participants) do
		local data = DataService.Get(player)
		heartBonus = math.max(heartBonus, Config.Zoo.HeartBonus * (data and data.zooUp.hearts or 0))
	end
	State.HeartBonus = heartBonus

	for index, player in ipairs(participants) do
		State.Ready[player] = nil
		local lives = ProgressService.Lives(player)
		ProgressService.ConsumeStoredRevive(player)
		local run = RideService.NewRun(lives, ProgressService.LassoCharges(player))
		State.Participants[player] = run
		local x, z = startPositions(index)
		z = startZ + z
		local starter = CreatureService.Spawn(x, z, zone.animals[1], 1, 1)
		run.z = z
		run.bestZ = z
		run.zoneIdx = zoneIdx
		ProgressService.NoteZone(player, zoneIdx)
		if not RideService.Mount(player, run, starter) then
			run.status = "Out"
		end
	end
	CreatureService.FillInitial(startZ)
	broadcastScores()

	-- Compte à rebours
	State.SetPhase("Countdown", Config.Round.Countdown)
	MapBuilder.SetStatus("Expédition en cours : " .. zone.name)
	task.wait(Config.Round.Countdown)

	-- Expédition
	State.Frozen = false
	State.SetPhase("Running", Config.Round.Duration)
	local endsAt = os.clock() + Config.Round.Duration
	local lastBroadcast = 0
	local allDoneSince = nil
	while os.clock() < endsAt and State.RoundId == roundId do
		task.wait(0.1)
		if os.clock() - lastBroadcast >= 0.5 then
			lastBroadcast = os.clock()
			broadcastScores()
		end
		if State.CountActive() == 0 then
			allDoneSince = allDoneSince or os.clock()
			if os.clock() - allDoneSince > 2.5 then
				break
			end
		else
			allDoneSince = nil
		end
	end

	-- Résultats
	State.Frozen = true
	State.SetPhase("Results", Config.Round.Results)
	workspace:SetAttribute("BossActive", false)
	broadcastScores()
	for _, run in pairs(State.Participants) do
		RideService.Detach(run)
		if run.status ~= "Out" and run.status ~= "Finished" then
			run.status = "Out"
		end
	end
	local payload = computeResults(zoneIdx)
	for player in pairs(State.Participants) do
		if player.Parent then
			RideService.ToLobby(player)
			ProgressService.OnZooChanged(player)
			for _, name in ipairs({ "TameProgress", "RideHeart", "CanCollect", "RideBoss", "ReviveLeft" }) do
				player:SetAttribute(name, nil)
			end
			player:SetAttribute("RideName", nil)
			Remotes.Status:FireClient(player, "Lobby")
		end
	end
	Remotes.Results:FireAllClients({ list = payload, round = roundId })
	MapBuilder.SetStatus("Résultats de l'expédition")
	task.wait(Config.Round.Results)

	-- Nettoyage
	State.Participants = {}
	CreatureService.Clear()
	Fx.clear()
end

function RoundService.Run()
	while true do
		intermission()
		runRound()
	end
end

return RoundService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- État partagé côté serveur (une seule source de vérité pour la manche en cours).

local State = {
	Phase = "Intermission", -- Intermission | Countdown | Running | Results
	RoundId = 0,
	Frozen = true, -- bêtes immobiles (compte à rebours)
	RunElapsed = 0,
	StartZone = 1,
	HeartBonus = 0,
	BossesSpawned = {}, -- [index de zone] = true
	FinishCount = 0,
	Participants = {}, -- [Player] = run
	Creatures = {}, -- [id] = creature
	NextCreatureId = 1,
	CreaturesFolder = nil,
	FxFolder = nil,
	LobbyCFrame = CFrame.new(0, 330, -720),
	PlotCFrames = {}, -- [Player] = point d'arrivée devant le zoo du joueur
	Ready = {}, -- [Player] = true : le joueur part à la prochaine expédition
	FinishCFrame = CFrame.new(0, 6, 3300),
	MapReady = false,
}

function State.SetPhase(phase, duration)
	State.Phase = phase
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEnd", workspace:GetServerTimeNow() + (duration or 0))
	workspace:SetAttribute("Round", State.RoundId)
end

function State.CountActive()
	local n = 0
	for _, run in pairs(State.Participants) do
		local s = run.status
		if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" or s == "Dead" then
			n = n + 1
		end
	end
	return n
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">ZooService</string><ProtectedString name="Source"><![CDATA[-- Le zoo de chaque joueur : une parcelle dans le parc central, des enclos qui se remplissent d'animaux,
-- une caisse qui accumule de l'or, des visiteurs (affichés côté client). Reconstruite quand le zoo change.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Zoo = require(Shared.Zoo)

local State = require(script.Parent.State)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local CreatureService = require(script.Parent.CreatureService)

local ZooService = {}

local H = Config.Hub
local plots = {} -- [Player] = { index, center, folder }
local usedIndex = {}
local zooFolder = nil

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function plotCenter(index)
	local col = (index - 1) % H.Columns
	local row = math.floor((index - 1) / H.Columns)
	return V(
		H.Center.X + (col - (H.Columns - 1) / 2) * H.PlotSpacing,
		H.Center.Y + 4,
		H.Center.Z + (row - (H.Rows - 1) / 2) * H.PlotSpacing
	)
end

local function slotCenter(center, slotIndex)
	local col = (slotIndex - 1) % H.SlotColumns
	local row = math.floor((slotIndex - 1) / H.SlotColumns)
	local rows = math.ceil(Config.Zoo.MaxSlots / H.SlotColumns)
	return center + V((col - (H.SlotColumns - 1) / 2) * H.SlotSpacing, 0, (row - (rows - 1) / 2) * H.SlotSpacing - 4)
end

local function part(parent, name, size, position, color, material, opts)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.Position = position
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = opts and opts.collide == true or false
	p.CanTouch = false
	p.CanQuery = p.CanCollide
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	if opts and opts.trans then
		p.Transparency = opts.trans
	end
	p.Parent = parent
	return p
end

local function label(parent, adornee, text, offset, width)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, width or 150, 0, 34)
	gui.StudsOffset = offset
	gui.MaxDistance = 90
	gui.AlwaysOnTop = false
	gui.Adornee = adornee
	gui.Parent = parent
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, 0, 1, 0)
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = C(255, 255, 255)
	t.TextStrokeTransparency = 0.3
	t.Parent = gui
	return gui
end

-- Dispose les animaux possédés, les meilleurs d'abord, dans les enclos débloqués.
local function sortedAnimals(data)
	local list = {}
	for key, entry in pairs(data.animals) do
		local def, variant = Zoo.parseKey(key)
		if def then
			table.insert(list, {
				key = key,
				def = def,
				variant = variant,
				level = entry.level or 1,
				income = Zoo.animalIncome(def, variant, entry.level or 1),
			})
		end
	end
	table.sort(list, function(a, b)
		if a.income ~= b.income then
			return a.income > b.income
		end
		return a.key < b.key
	end)
	return list
end

local function buildPlotContent(player, plot)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if plot.folder then
		plot.folder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Zoo_" .. player.UserId
	folder.Parent = zooFolder
	plot.folder = folder

	local center = plot.center
	local size = H.PlotSize
	part(
		folder,
		"PlotGround",
		V(size, 1, size),
		center - V(0, 0.5, 0),
		C(112, 170, 92),
		Enum.Material.Grass,
		{ collide = true }
	)
	part(folder, "PlotPath", V(6, 0.2, size), center + V(0, 0.05, 0), C(214, 196, 150), Enum.Material.Sand)

	-- panneau à l'entrée
	local postPos = center + V(0, 4, size / 2 - 4)
	local sign = part(folder, "Sign", V(30, 7, 1), postPos, C(60, 44, 30), Enum.Material.Wood)
	label(sign, sign, player.DisplayName .. " · ZOO", V(0, 0, 0), 280)
	for _, side in ipairs({ -1, 1 }) do
		part(folder, "Post", V(1.5, 8, 1.5), postPos + V(side * 16, 0, 0), C(90, 62, 40), Enum.Material.Wood)
	end

	local slots = Zoo.slots(data.zooUp.slots, ProgressService.HasPass(player, "zoo"))
	local animals = sortedAnimals(data)
	for slot = 1, Config.Zoo.MaxSlots do
		local sc = slotCenter(center, slot)
		local unlocked = slot <= slots
		part(
			folder,
			"Pad" .. slot,
			V(10, 0.3, 10),
			sc + V(0, 0.1, 0),
			unlocked and C(150, 120, 80) or C(70, 74, 82),
			Enum.Material.Slate
		)
		if unlocked then
			for _, d in ipairs({
				{ V(10, 1.4, 0.4), V(0, 0.9, 5) },
				{ V(10, 1.4, 0.4), V(0, 0.9, -5) },
				{ V(0.4, 1.4, 10), V(5, 0.9, 0) },
				{ V(0.4, 1.4, 10), V(-5, 0.9, 0) },
			}) do
				part(folder, "Rail", d[1], sc + d[2], C(120, 84, 52), Enum.Material.Wood)
			end
			local entry = animals[slot]
			if entry then
				local model, root = CreatureService.BuildModel(entry.def, entry.variant)
				model.Name = "Zoo_" .. entry.key
				local extent = math.max(entry.def.body.s.Z * 1.6, entry.def.body.s.X * 1.6)
				local scale = math.clamp(7.5 / extent, 0.22, 0.85)
				model:ScaleTo(scale)
				local y = entry.def.rootY * scale + 0.3
				model:PivotTo(CFrame.new(sc + V(0, y, 0)) * CFrame.Angles(0, math.rad((slot * 67) % 360), 0))
				model:SetAttribute("Static", true)
				model:SetAttribute("BaseSpeed", 10)
				model.Parent = folder
				label(root, root, ("%s · niv %d"):format(entry.def.name, entry.level), V(0, 5 + y, 0), 170)
			else
				part(
					folder,
					"Empty" .. slot,
					V(2, 2, 2),
					sc + V(0, 1.2, 0),
					C(255, 255, 255),
					Enum.Material.Neon,
					{ trans = 0.9 }
				)
			end
		else
			local lock = part(folder, "Lock" .. slot, V(3, 3, 0.4), sc + V(0, 2, 0), C(40, 44, 52), Enum.Material.Metal)
			label(lock, lock, "Verrouillé", V(0, 2, 0), 100)
		end
	end
end

function ZooService.Refresh(player)
	local plot = plots[player]
	if not plot or not player.Parent then
		return
	end
	-- pendant une expédition le joueur est loin de son zoo : on reconstruit à son retour
	if State.Participants[player] and State.Phase ~= "Results" and State.Phase ~= "Intermission" then
		plot.dirty = true
		return
	end
	plot.dirty = false
	buildPlotContent(player, plot)
end

local function assign(player)
	for index = 1, H.Columns * H.Rows do
		if not usedIndex[index] then
			usedIndex[index] = player
			local center = plotCenter(index)
			plots[player] = { index = index, center = center }
			State.PlotCFrames[player] = CFrame.new(center + V(0, 4, H.PlotSize / 2 - 8))
			player:SetAttribute("PlotCenter", center)
			return true
		end
	end
	return false
end

function ZooService.OnPlayerReady(player)
	if not plots[player] then
		if not assign(player) then
			return
		end
	end
	ZooService.Refresh(player)
end

local function release(player)
	local plot = plots[player]
	if plot then
		usedIndex[plot.index] = nil
		if plot.folder then
			plot.folder:Destroy()
		end
		plots[player] = nil
	end
	State.PlotCFrames[player] = nil
	State.Ready[player] = nil
end

local function handleReady(player, zoneKey, wants)
	if type(wants) ~= "boolean" then
		return
	end
	if type(zoneKey) == "string" then
		ProgressService.SetZone(player, zoneKey)
		ProgressService.Push(player)
	end
	local run = State.Participants[player]
	local busy = run ~= nil and State.Phase ~= "Intermission" and run.status ~= "Out" and run.status ~= "Finished"
	if busy then
		return
	end
	State.Ready[player] = wants and DataService.Get(player) ~= nil or nil
end

function ZooService.Init()
	zooFolder = Instance.new("Folder")
	zooFolder.Name = "ZooAnimals"
	zooFolder.Parent = workspace
	ProgressService.OnZooChanged = ZooService.Refresh
	Remotes.Ready.OnServerEvent:Connect(handleReady)
	Players.PlayerRemoving:Connect(release)
end

return ZooService
]]></ProtectedString></Properties></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX37"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX36"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX35"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Point d'entrée client de Saute-Troupeau.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Modules = script:WaitForChild("Modules")
local ClientState = require(Modules.ClientState)
local CreatureFx = require(Modules.CreatureFx)
local CameraRig = require(Modules.CameraRig)
local Controls = require(Modules.Controls)
local HUD = require(Modules.HUD)
local Menu = require(Modules.Menu)
local Ambience = require(Modules.Ambience)
local Sfx = require(Modules.Sfx)
local Intro = require(Modules.Intro)
local Visitors = require(Modules.Visitors)

-- Données serveur -> client
Remotes.Data.OnClientEvent:Connect(function(snapshot)
	if type(snapshot) == "table" then
		ClientState.setData(snapshot)
	end
end)

Remotes.Status.OnClientEvent:Connect(function(status)
	if type(status) == "string" then
		ClientState.setStatus(status)
	end
end)

Remotes.Scores.OnClientEvent:Connect(function(list)
	if type(list) == "table" then
		ClientState.setScores(list)
	end
end)

Remotes.Feedback.OnClientEvent:Connect(function(payload)
	HUD.feedback(payload)
end)

Remotes.Results.OnClientEvent:Connect(function(payload)
	HUD.showResults(payload)
end)

Remotes.Launched.OnClientEvent:Connect(function(velocity)
	if typeof(velocity) == "Vector3" then
		Controls.onLaunched(velocity)
	end
end)

-- Sans personnage vivant on repasse en mode salon.
player.CharacterAdded:Connect(function()
	ClientState.setStatus("Lobby")
end)

-- Modules
Sfx.init()
HUD.init()
Menu.init()
CreatureFx.init()
CameraRig.init()
Controls.init()
Ambience.init()
Visitors.init()
Intro.init()
]]></ProtectedString></Properties><Item class="Folder" referent="RBX34"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- Ambiance : la lumière et la brume changent progressivement selon le biome traversé (effet local au client).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sfx = require(script.Parent.Sfx)

local Ambience = {}

local player = Players.LocalPlayer
local currentBiome = nil

function Ambience.init()
	local atmosphere = Lighting:WaitForChild("HHAtmosphere", 20)
	local color = Lighting:WaitForChild("HHColor", 20)
	if not atmosphere or not color then
		return
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < 0.5 then
			return
		end
		accumulator = 0
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		-- le salon (en hauteur) garde l'ambiance de la savane
		local inLobby = hrp.Position.Y > 150
		local z = inLobby and 0 or hrp.Position.Z
		local biome = Config.zoneAt(z)
		if inLobby then
			Sfx.setMusic(workspace:GetAttribute("Phase") == "Results" and "results" or "lobby")
		elseif workspace:GetAttribute("BossActive") == true then
			Sfx.setMusic("boss")
		else
			Sfx.setMusic(biome.key)
		end
		if biome ~= currentBiome then
			currentBiome = biome
			local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
			TweenService:Create(atmosphere, info, { Color = biome.atmosphere }):Play()
			TweenService:Create(color, info, { TintColor = biome.tint }):Play()
		end
	end)
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[-- Caméra de course : derrière et au-dessus du cavalier, regardant vers +Z (sens de la piste).
-- Actif pendant la course ; en spectateur, suit le leader. Sinon, caméra Roblox par défaut.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local CameraRig = {}

local player = Players.LocalPlayer
local active = false
local pos = Vector3.new(0, 0, 0)
local lastFocus = nil
local speedSmooth = 0
local lateralSmooth = 0
local lastStatus = nil
local shakeUntil = 0
local shakePower = 0
local cinematic = nil -- { fn, duration, t0, onDone }

local function hrpOf(plr)
	local char = plr and plr.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function focusPart()
	local s = ClientState.Status
	if s == "Riding" or s == "Air" or s == "Hooking" or s == "Down" then
		return hrpOf(player)
	end
	if (s == "Out" or s == "Finished") and workspace:GetAttribute("Phase") == "Running" then
		-- spectateur : suivre le premier du classement encore en course
		for _, entry in ipairs(ClientState.Scores) do
			if
				entry.id ~= player.UserId
				and (entry.st == "Riding" or entry.st == "Air" or entry.st == "Hooking" or entry.st == "Down")
			then
				local other = Players:GetPlayerByUserId(entry.id)
				local part = hrpOf(other)
				if part then
					return part
				end
			end
		end
		return hrpOf(player)
	end
	return nil
end

function CameraRig.shake(power, seconds)
	shakePower = power
	shakeUntil = os.clock() + seconds
end

local function release(camera)
	if active then
		active = false
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end
end

-- Plan de caméra scénarisé : fn(t) renvoie le CFrame de la caméra à t secondes.
function CameraRig.cinematic(fn, duration, onDone)
	cinematic = { fn = fn, duration = duration, t0 = os.clock(), onDone = onDone }
end

function CameraRig.stopCinematic()
	local current = cinematic
	cinematic = nil
	if current and current.onDone then
		current.onDone()
	end
end

function CameraRig.isCinematic()
	return cinematic ~= nil
end

local function update(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if cinematic then
		local t = os.clock() - cinematic.t0
		if t >= cinematic.duration then
			CameraRig.stopCinematic()
			release(camera)
		else
			if not active then
				active = true
				camera.CameraType = Enum.CameraType.Scriptable
			end
			camera.CFrame = cinematic.fn(t)
			camera.FieldOfView = 62
			lastFocus = nil
			return
		end
	end
	local part = focusPart()
	if not part then
		release(camera)
		lastFocus = nil
		return
	end

	local focus = part.Position
	local snap = false
	if not active then
		active = true
		snap = true
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local desired = focus + Vector3.new(0, 14, -30)
	if snap then
		pos = desired
	else
		pos = pos:Lerp(desired, 1 - math.exp(-dt * 9))
	end

	-- légère inclinaison dans les virages et regard décalé vers le côté où l'on va
	local cf = CFrame.lookAt(pos, focus + Vector3.new(-lateralSmooth * 0.35, 3, 36))
		* CFrame.Angles(0, 0, lateralSmooth * 0.004)
	if ClientState.Status ~= lastStatus then
		if ClientState.Status == "Down" then
			CameraRig.shake(1.4, 0.35)
		elseif ClientState.Status == "Riding" and lastStatus == "Hooking" then
			CameraRig.shake(0.5, 0.2)
		end
		lastStatus = ClientState.Status
	end
	if os.clock() < shakeUntil then
		local k = shakePower * (shakeUntil - os.clock())
		cf = cf * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end
	camera.CFrame = cf

	-- champ de vision selon la vitesse
	if lastFocus and dt > 0 then
		local speed = (focus - lastFocus).Magnitude / dt
		speedSmooth = speedSmooth + (math.min(speed, 120) - speedSmooth) * math.min(1, dt * 3)
		local lateral = math.clamp((focus.X - lastFocus.X) / dt, -40, 40)
		lateralSmooth = lateralSmooth + (lateral - lateralSmooth) * math.min(1, dt * 5)
	end
	lastFocus = focus
	camera.FieldOfView = 70 + math.clamp(speedSmooth / 70, 0, 1) * 16
end

function CameraRig.init()
	RunService:BindToRenderStep("HerdHopperCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraRig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- État côté client + mini système d'abonnement.

local ClientState = {
	Data = nil, -- profil envoyé par le serveur
	Status = "Lobby", -- Lobby | Riding | Air | Hooking | Down | Out | Finished
	Scores = {}, -- classement en direct
}

local listeners = {}

function ClientState.connect(key, fn)
	listeners[key] = listeners[key] or {}
	table.insert(listeners[key], fn)
	return function()
		local list = listeners[key]
		local index = table.find(list, fn)
		if index then
			table.remove(list, index)
		end
	end
end

local function fire(key, value)
	local list = listeners[key]
	if not list then
		return
	end
	for _, fn in ipairs(table.clone(list)) do
		task.spawn(fn, value)
	end
end

function ClientState.setData(data)
	ClientState.Data = data
	fire("Data", data)
end

function ClientState.setStatus(status)
	if ClientState.Status == status then
		return
	end
	ClientState.Status = status
	fire("Status", status)
end

function ClientState.setScores(scores)
	ClientState.Scores = scores
	fire("Scores", scores)
end

function ClientState.isPlaying()
	local s = ClientState.Status
	return s == "Riding" or s == "Air" or s == "Hooking" or s == "Down"
end

-- Présent dans une expédition (y compris mort, en attente de « Continuer »).
function ClientState.inRun()
	return ClientState.isPlaying() or ClientState.Status == "Dead"
end

return ClientState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Contrôles à une seule action, contextuelle (clavier, souris, tactile, manette) :
--   * en selle   : SAUTER (quitte la monture avec un bond vers l'avant)
--   * en l'air   : LASSO (maintenir = lasso automatique dès qu'une bête est à portée)
-- Direction : A/D, flèches, joystick (pilote la monture, ou le vol en l'air).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local CreatureFx = require(script.Parent.CreatureFx)
local Sfx = require(script.Parent.Sfx)

local Controls = {}

local player = Players.LocalPlayer

local pressed = false
local pressedSource = nil
local armedUntil = 0
local lastHookAt = 0
local lastSteer = 0
local lastSteerAt = 0
local controlsObject = nil

local air = { active = false, vx = 0, vz = 0 }

local function getHrp()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

-- Direction latérale demandée, exprimée sur l'axe X du monde (caméra tournée vers +Z : droite écran = -X).
local function getSteer()
	if controlsObject then
		local ok, v = pcall(function()
			return controlsObject:GetMoveVector()
		end)
		if ok and v then
			return -v.X
		end
	end
	local hum = getHum()
	return hum and hum.MoveDirection.X or 0
end

function Controls.press(source)
	if pressed then
		return
	end
	pressed = true
	pressedSource = source
	local status = ClientState.Status
	if status == "Riding" then
		Remotes.Launch:FireServer()
		Sfx.play("launch")
	elseif status == "Air" or status == "Down" then
		armedUntil = os.clock() + 0.45
	end
end

-- Récupérer l'animal monté quand son cœur bat (bouton RÉCUPÉRER ou touche E).
function Controls.collect()
	if player:GetAttribute("CanCollect") == true then
		Remotes.Collect:FireServer()
		Sfx.play("collect")
	end
end

-- Lasso de capture : vise l'animal à cœur choisi par la visée assistée (touche Q ou bouton LASSO).
function Controls.lasso()
	local model = CreatureFx.lassoTarget()
	local charges = player:GetAttribute("Lasso") or 0
	if model and charges > 0 and ClientState.isPlaying() then
		Remotes.Lasso:FireServer(model:GetAttribute("Id"))
		Sfx.play("lasso")
	end
end

function Controls.release(source)
	if pressed and pressedSource == source then
		pressed = false
		pressedSource = nil
	end
end

-- Branche un bouton d'interface (tactile / souris) sur l'action.
function Controls.bindButton(button)
	button.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			Controls.press("button")
		end
	end)
	button.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			Controls.release("button")
		end
	end)
end

function Controls.onLaunched(velocity)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return
	end
	-- attendre que la soudure de selle ait disparu (réplication)
	local t0 = os.clock()
	while hrp:FindFirstChild("RideWeld") and os.clock() - t0 < 0.5 do
		RunService.Heartbeat:Wait()
	end
	hum.Sit = false
	hum:ChangeState(Enum.HumanoidStateType.Freefall)
	hrp.AssemblyLinearVelocity = velocity
	air.active = true
	air.vx = velocity.X
	air.vz = velocity.Z
end

local function setupCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.JumpHeight = 0
	hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	air.active = false

	-- masquer le bouton de saut tactile par défaut (notre bouton d'action le remplace)
	task.spawn(function()
		local gui = player:WaitForChild("PlayerGui")
		local touchGui = gui:WaitForChild("TouchGui", 5)
		if touchGui then
			local frame = touchGui:FindFirstChild("TouchControlFrame")
			local jump = frame and frame:FindFirstChild("JumpButton")
			if jump then
				jump.Visible = false
			end
		end
	end)
end

function Controls.init()
	-- Module de contrôles Roblox : permet de lire le stick / les touches indépendamment de la caméra.
	task.spawn(function()
		local ok, result = pcall(function()
			local scripts = player:WaitForChild("PlayerScripts")
			local module = scripts:WaitForChild("PlayerModule", 10)
			return require(module):GetControls()
		end)
		if ok then
			controlsObject = result
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local t = input.UserInputType
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
			Controls.press("key")
		elseif input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonY then
			Controls.collect()
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonX then
			Controls.lasso()
		elseif t == Enum.UserInputType.MouseButton1 then
			Controls.press("mouse")
		elseif t == Enum.UserInputType.Touch then
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1000, 1000)
			if input.Position.X > viewport.X * 0.5 then
				Controls.press("touch")
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
			Controls.release("key")
		elseif t == Enum.UserInputType.MouseButton1 then
			Controls.release("mouse")
		elseif t == Enum.UserInputType.Touch then
			Controls.release("touch")
		end
	end)

	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end
	player.CharacterAdded:Connect(setupCharacter)

	ClientState.connect("Status", function(status)
		if status ~= "Air" then
			air.active = false
		end
		if status == "Down" then
			Sfx.play("land")
		end
		if status == "Riding" or status == "Lobby" then
			CreatureFx.setTarget(nil)
			-- un nouvel appui est nécessaire pour bondir (évite un état "appuyé" resté coincé)
			pressed = false
			pressedSource = nil
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local status = ClientState.Status
		local now = os.clock()
		local hrp = getHrp()
		if not hrp then
			return
		end

		if status == "Riding" then
			local x = getSteer()
			if math.abs(x) < 0.15 then
				x = 0
			end
			x = math.clamp(x, -1, 1)
			if math.abs(x - lastSteer) > 0.05 or (now - lastSteerAt > 0.5 and x ~= 0) then
				lastSteer = x
				lastSteerAt = now
				Remotes.Steer:FireServer(x)
			end
		elseif lastSteer ~= 0 then
			lastSteer = 0
		end

		if status == "Air" and air.active then
			local v = hrp.AssemblyLinearVelocity
			local target = getSteer() * Config.Ride.AirLateral
			air.vx = air.vx + (target - air.vx) * math.min(1, dt * 4)
			hrp.AssemblyLinearVelocity = Vector3.new(air.vx, v.Y, air.vz)
		end

		if status == "Air" or status == "Down" then
			local range = player:GetAttribute("HookRange") or Config.Ride.HookBaseRange
			local model = CreatureFx.bestTarget(hrp.Position, range, status == "Air" and 5 or -25)
			CreatureFx.setTarget(model)
			if model and (pressed or now < armedUntil) and now - lastHookAt > Config.Ride.HookCooldown then
				lastHookAt = now
				armedUntil = 0
				Remotes.Hook:FireServer(model:GetAttribute("Id"))
				Sfx.play("hook")
			end
		elseif status == "Hooking" then
			CreatureFx.setTarget(nil)
		end

		-- visée assistée du lasso de capture
		if status == "Riding" or status == "Air" or status == "Down" then
			local range = player:GetAttribute("LassoRange") or Config.Run.LassoRange
			CreatureFx.setLassoTarget(CreatureFx.bestLassoTarget(hrp.Position, range))
		else
			CreatureFx.setLassoTarget(nil)
		end
	end)
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">CreatureFx</string><ProtectedString name="Source"><![CDATA[-- Côté client : animation des pattes/ailes, cœurs roses sur les animaux récupérables, cibles du saut et du lasso.
-- Les animations ne sont jamais répliquées : le serveur ne déplace que la pièce Root.

local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)

local CreatureFx = {}

local folders = {}
local records = {} -- [model] = { motors = nil | {...}, tries = number, speed = number, heart = nil | { gui, scale } }
local targetHighlight = nil
local targetModel = nil
local lassoHighlight = nil
local lassoModel = nil

local CULL_DISTANCE = 260
local PINK = Color3.fromRGB(255, 96, 160)
local GOLD = Color3.fromRGB(255, 205, 60)

local function collectMotors(model)
	local motors = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local name = descendant.Name
			if name:sub(1, 3) == "Leg" then
				table.insert(
					motors,
					{ motor = descendant, kind = "leg", phase = descendant:GetAttribute("Phase") or 0 }
				)
			elseif name:sub(1, 4) == "Wing" then
				table.insert(motors, { motor = descendant, kind = "wing", side = descendant:GetAttribute("Side") or 1 })
			end
		end
	end
	return motors
end

local function updateAngry(model)
	local angry = model:GetAttribute("Angry") == true
	local existing = model:FindFirstChild("AngryHighlight")
	if angry and not existing then
		local h = Instance.new("Highlight")
		h.Name = "AngryHighlight"
		h.FillColor = Color3.fromRGB(255, 60, 40)
		h.FillTransparency = 0.55
		h.OutlineColor = Color3.fromRGB(255, 220, 200)
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = model
	elseif not angry and existing then
		existing:Destroy()
	end
end

-- Cœur rose au-dessus d'un animal récupérable ; pulse quand la confiance est gagnée ; couronne pour les boss.
local function updateHeart(model)
	local rec = records[model]
	local root = model:FindFirstChild("Root")
	if not rec or not root then
		return
	end
	local wants = model:GetAttribute("Heart") == true
	if wants and not rec.heart then
		local gui = Instance.new("BillboardGui")
		gui.Name = "HeartGui"
		gui.Size = UDim2.new(0, 64, 0, 80)
		gui.StudsOffset = Vector3.new(0, root.Size.Y / 2 + 7, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 190
		gui.Adornee = root
		gui.Parent = root
		local scale = UI.make("UIScale", { Scale = 1 }, gui)
		local holder = UI.make("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.new(0, 46, 0, 46),
		}, gui)
		UI.heart(holder, 46, PINK)
		if model:GetAttribute("Boss") == true then
			UI.text(gui, {
				Size = UDim2.new(1, 0, 0, 24),
				Text = "BOSS",
				maxSize = 22,
				TextColor3 = GOLD,
			})
		end
		rec.heart = { gui = gui, scale = scale }
	elseif not wants and rec.heart then
		rec.heart.gui:Destroy()
		rec.heart = nil
	end
end

local function track(model)
	if not model:IsA("Model") then
		return
	end
	records[model] = { motors = nil, tries = 0, speed = model:GetAttribute("BaseSpeed") or 40, heart = nil }
	model:GetAttributeChangedSignal("Angry"):Connect(function()
		updateAngry(model)
	end)
	model:GetAttributeChangedSignal("Heart"):Connect(function()
		updateHeart(model)
	end)
	task.defer(updateHeart, model)
end

local function untrack(model)
	records[model] = nil
	if model == targetModel then
		targetModel = nil
	end
	if model == lassoModel then
		lassoModel = nil
	end
end

local function watch(folder)
	table.insert(folders, folder)
	for _, model in ipairs(folder:GetChildren()) do
		track(model)
	end
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(untrack)
end

local function makeHighlight(name, fill)
	local h = Instance.new("Highlight")
	h.Name = name
	h.FillColor = fill
	h.FillTransparency = 0.45
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	return h
end

function CreatureFx.init()
	watch(workspace:WaitForChild("Creatures"))
	task.spawn(function()
		watch(workspace:WaitForChild("ZooAnimals"))
	end)

	targetHighlight = makeHighlight("TargetHighlight", GOLD)
	lassoHighlight = makeHighlight("LassoHighlight", PINK)

	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local t = os.clock()
		for model, rec in pairs(records) do
			local root = model:FindFirstChild("Root")
			if root and (root.Position - camPos).Magnitude < CULL_DISTANCE then
				if rec.motors == nil then
					local found = collectMotors(model)
					if #found > 0 or rec.tries > 40 then
						rec.motors = found
					else
						rec.tries = rec.tries + 1
					end
				end
				if rec.motors then
					local freq = 4 + rec.speed * 0.11
					for _, m in ipairs(rec.motors) do
						if m.kind == "leg" then
							m.motor.Transform = CFrame.Angles(math.sin(t * freq + m.phase) * 0.7, 0, 0)
						else
							m.motor.Transform = CFrame.Angles(0, 0, m.side * math.sin(t * 8) * 0.55)
						end
					end
				end
				if rec.heart then
					local ready = model:GetAttribute("Ready") == true
					local pulse = ready and (1.25 + math.sin(t * 9) * 0.25) or (1 + math.sin(t * 3) * 0.08)
					rec.heart.scale.Scale = pulse
				end
			end
		end
	end)
end

-- Meilleure bête à lasso (saut) depuis `origin` dans la portée `range`. `minDz` = avance minimale requise
-- sur l'axe de course (en l'air : devant soi ; au sol : on accepte les bêtes qui passent à côté).
function CreatureFx.bestTarget(origin, range, minDz)
	local best, bestScore = nil, math.huge
	for _, folder in ipairs(folders) do
		if folder.Name == "Creatures" then
			for _, model in ipairs(folder:GetChildren()) do
				if model:GetAttribute("Ridden") ~= true and model:GetAttribute("Id") then
					local root = model:FindFirstChild("Root")
					if root then
						local delta = root.Position + Vector3.new(0, 3, 0) - origin
						local dist = delta.Magnitude
						if dist <= range and delta.Z >= (minDz or 5) then
							local score = dist - 0.3 * math.max(delta.Z, 0)
							if model:GetAttribute("Heart") == true then
								score = score - 12 -- à portée égale, on préfère l'animal au cœur rose
							end
							if score < bestScore then
								best, bestScore = model, score
							end
						end
					end
				end
			end
		end
	end
	return best
end

-- Animal à cœur le plus proche pour le lasso de capture (visée assistée). Les boss ne se lassent pas.
function CreatureFx.bestLassoTarget(origin, range)
	local best, bestScore = nil, math.huge
	for _, folder in ipairs(folders) do
		if folder.Name == "Creatures" then
			for _, model in ipairs(folder:GetChildren()) do
				if
					model:GetAttribute("Heart") == true
					and model:GetAttribute("Boss") ~= true
					and model:GetAttribute("Ridden") ~= true
					and model:GetAttribute("Id")
				then
					local root = model:FindFirstChild("Root")
					if root then
						local delta = root.Position - origin
						local dist = delta.Magnitude
						if dist <= range and delta.Z >= -12 then
							local score = dist - 0.25 * math.max(delta.Z, 0)
							if score < bestScore then
								best, bestScore = model, score
							end
						end
					end
				end
			end
		end
	end
	return best
end

function CreatureFx.hasTarget()
	return targetModel ~= nil
end

function CreatureFx.setTarget(model)
	if model == targetModel then
		return
	end
	targetModel = model
	targetHighlight.Parent = model
end

function CreatureFx.setLassoTarget(model)
	if model == lassoModel then
		return
	end
	lassoModel = model
	lassoHighlight.Parent = model
end

function CreatureFx.lassoTarget()
	return lassoModel
end

return CreatureFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Interface d'expédition : minuteur, score, vies, lassos, combo, classement, confiance de l'animal monté,
-- boutons (sauter / lasso, récupérer, lasso de capture), messages, écran « Continuer ? » et résultats.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local Controls = require(script.Parent.Controls)
local CameraRig = require(script.Parent.CameraRig)
local CreatureFx = require(script.Parent.CreatureFx)

local HUD = {}

local player = Players.LocalPlayer
local refs = {}
local feedbackToken = 0
local resultsToken = 0
local lastCountdown = -1
local lastWarnTick = 0
local lastCombo = 0
local lastRound = -1
local builtLives = 0
local PINK = Color3.fromRGB(255, 96, 160)

local TIPS = {
	"Ouvre EXPÉDITION pour partir. Le zoo travaille pendant ce temps.",
	"Astuce : un cœur rose au-dessus d'un animal = tu peux le récupérer.",
	"Astuce : monte l'animal quelques secondes, puis appuie sur RÉCUPÉRER.",
	"Astuce : le lasso de capture attrape un animal à cœur à distance.",
	"Astuce : maintiens ESPACE en l'air pour lasser le prochain animal.",
	"Astuce : un doublon rapporte des os pour améliorer tes animaux.",
	"Astuce : le sol est mortel. Ne rate pas ton saut !",
}

local KIND_STYLE = {
	hook = { color = UI.Colors.Accent },
	tame = { color = PINK, sound = "heart" },
	down = { color = UI.Colors.Bad, sound = "down", shake = 1.2 },
	out = { color = UI.Colors.Bad, sound = "down" },
	finish = { color = UI.Colors.Accent, sound = "win" },
	warn = { color = UI.Colors.Warn, sound = "tick" },
	buck = { color = UI.Colors.Warn, sound = "boom", shake = 1.0 },
	geyser = { color = UI.Colors.Info, sound = "geyser", shake = 0.8 },
	event = { color = UI.Colors.Info, sound = "go" },
	danger = { color = UI.Colors.Bad, sound = "boss", shake = 1.5 },
}

local function roundButton(gui, props)
	local b = UI.button(gui, props)
	local corner = b:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	return b
end

local function build(gui)
	local C = UI.Colors
	local panelGradient = ColorSequence.new(Color3.fromRGB(52, 62, 96), Color3.fromRGB(26, 31, 50))

	-- Bandeau du haut (phase / minuteur)
	local banner = UI.frame(gui, {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(0, 330, 0, 46),
		BackgroundTransparency = 0.15,
	})
	UI.corner(banner, 14)
	UI.stroke(banner, C.Dark, 2)
	UI.make("UIGradient", { Color = panelGradient, Rotation = 90 }, banner)
	refs.bannerText =
		UI.text(banner, { Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 4), maxSize = 26 })

	refs.hint = UI.text(gui, {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.new(0, 480, 0, 26),
		maxSize = 18,
		TextColor3 = C.Muted,
		Font = UI.FontBody,
	})

	refs.zone = UI.text(gui, {
		Name = "Zone",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.new(0, 360, 0, 24),
		maxSize = 20,
		TextColor3 = C.Info,
	})

	-- Score, or, vies et lassos (haut gauche)
	local score = UI.frame(gui, {
		Name = "ScoreBox",
		Position = UDim2.new(0, 12, 0, 10),
		Size = UDim2.new(0, 230, 0, 150),
		BackgroundTransparency = 0.15,
	})
	UI.corner(score, 14)
	UI.stroke(score, C.Dark, 2)
	UI.make("UIGradient", { Color = panelGradient, Rotation = 90 }, score)
	UI.text(score, {
		Size = UDim2.new(1, -16, 0, 16),
		Position = UDim2.new(0, 8, 0, 4),
		Text = "SCORE",
		maxSize = 13,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	refs.score = UI.text(score, {
		Size = UDim2.new(1, -16, 0, 36),
		Position = UDim2.new(0, 8, 0, 18),
		Text = "0",
		maxSize = 34,
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	refs.combo = UI.text(score, {
		Size = UDim2.new(1, -16, 0, 18),
		Position = UDim2.new(0, 8, 0, 56),
		Text = "",
		maxSize = 16,
		TextColor3 = C.Good,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
