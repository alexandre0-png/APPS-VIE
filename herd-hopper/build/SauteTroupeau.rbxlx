<Item class="ReplicatedStorage" referent="RBX7"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX6"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Configuration centrale de Saute-Troupeau (Herd Hopper).
-- Toutes les valeurs d'équilibrage sont ici : on peut régler le jeu sans toucher aux systèmes.

local Config = {}

Config.Gravity = 90

-- Piste : axe +Z = sens de la course. Le sol est à Y = 0.
Config.Track = {
	HalfWidth = 62, -- limite latérale des bêtes (studs)
	WallX = 82, -- murs invisibles
	FinishZ = 3200, -- ligne d'arrivée
	FloorTop = 0,
	StartZ = 0,
}

-- Le salon est un grand parc : chaque joueur y a une parcelle (son zoo).
Config.Hub = {
	Center = Vector3.new(0, 320, -720),
	PlotSize = 84,
	PlotSpacing = 96,
	Columns = 4,
	Rows = 4,
	SlotColumns = 6,
	SlotSpacing = 12,
}

-- Une expédition dure 4 minutes au maximum. Les joueurs prêts partent ensemble.
Config.Round = {
	Intermission = 20,
	Countdown = 5,
	Duration = 240,
	Results = 12,
	MinPlayers = 1,
}

Config.Ride = {
	LaunchUp = 58, -- vitesse verticale du bond
	LaunchBoost = 18, -- vitesse avant ajoutée à celle de la bête
	AirLateral = 26, -- contrôle latéral en l'air
	AirMax = 2.4, -- durée max d'un vol avant chute forcée (s)
	SteerSpeed = 30, -- vitesse latérale d'une monture pilotée
	HookBaseRange = 58,
	HookRangePerLevel = 5,
	HookCooldown = 0.3,
	HookTolerance = 14, -- marge serveur pour la latence
	ComboWindowBase = 6,
	ComboWindowPerLevel = 0.6,
	ComboStep = 0.2,
	ComboMax = 10,
	DownTime = 1.0,
	BuckWarning = 1.2,
}

-- Vies, cœurs et lasso de capture.
Config.Run = {
	BaseLives = 1,
	ReviveWindow = 12, -- secondes pour acheter « Continuer » après une mort
	CollectWindow = 4, -- secondes pour récupérer un animal dompté avant qu'il ne s'enfuie
	BaseLasso = 3,
	LassoRange = 70,
	LassoCooldown = 2,
	LassoBaseChance = 0.9,
	LassoVariantPenalty = 0.15,
	BossRideTime = 9,
	BossBuckAfter = 3,
}

Config.Score = {
	RidePerSecond = 4,
	HookBonus = 15,
	LongHookDistance = 40,
	LongHookBonus = 25,
	DistanceFactor = 0.1,
	TameBase = 100,
	Finish = { 500, 300, 200 },
	FinishOther = 100,
	CapturePoints = 150,
}

Config.Tame = {
	PerLevel = 0.08, -- réduction du temps de dressage par niveau
