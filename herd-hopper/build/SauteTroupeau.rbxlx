}
boss.sphinx = {
	id = "sphinx",
	name = "Sphinx des sables",
	desc = "Un lion de légende au pelage d'or. Il garde le désert.",
	speed = 46,
	value = 11,
	palette = {
		body = C(236, 196, 96),
		dark = C(190, 140, 50),
		light = C(255, 240, 190),
