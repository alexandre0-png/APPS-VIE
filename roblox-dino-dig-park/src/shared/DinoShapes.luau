-- Résout les "extends" et retourne la liste de pièces
function S.get(name)
	local shape = S[name]
	if shape == nil then
		return {}
	end
	if shape.extends then
		local out = {}
		for _, p in ipairs(S[shape.extends]) do
			table.insert(out, p)
		end
		for _, p in ipairs(shape.parts) do
			table.insert(out, p)
		end
		return out
	end
	return shape
end

return S
