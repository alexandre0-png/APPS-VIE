        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- Panels.luau : fenêtres du jeu (améliorations, collection, quêtes, cadeau quotidien, renaissance, boutique, choix d'œuf).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Economy = require(Shared.Economy)

local Ui = require(script.Parent.Ui)
local Store = require(script.Parent.StateStore)

local Panels = {}
local C = Ui.colors

local function row(parent, order, height)
	local r = Ui.new("Frame", { Size = UDim2.new(1, -8, 0, height or 80), BackgroundColor3 = C.row, LayoutOrder = order, Parent = parent })
	Ui.corner(r, 12)
	return r
end

local function listLayout(parent, pad)
	Ui.new("UIListLayout", { Padding = UDim.new(0, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = parent })
	Ui.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = parent })
end

local function hex(color)
	return "#" .. color:ToHex()
end

----------------------------------------------------------------------
-- Améliorations
----------------------------------------------------------------------
local function buildUpgrades()
	local p = Ui.createPanel("upgrades", "⛏ Améliorations", UDim2.fromOffset(560, 480), { color = C.orange })
	listLayout(p.body)
	local rows = {}
	for i, id in ipairs(Config.UpgradeOrder) do
		local def = Config.Upgrades[id]
		local r = row(p.body, i, 84)
		Ui.label(r, { text = def.icon, size = 34, sizeUdim = UDim2.fromOffset(56, 84) })
		Ui.label(r, {
			text = def.name,
			size = 22,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -240, 0, 30),
			pos = UDim2.fromOffset(60, 8),
			stroke = true,
			name = "Name",
		})
		Ui.label(r, {
			text = def.desc,
			size = 14,
			color = C.muted,
			align = Enum.TextXAlignment.Left,
			valign = Enum.TextYAlignment.Top,
			wrap = true,
			sizeUdim = UDim2.new(1, -240, 0, 40),
			pos = UDim2.fromOffset(60, 38),
			name = "Desc",
		})
		local btn = Ui.button(r, {
			text = "",
			size = UDim2.fromOffset(150, 60),
			pos = UDim2.new(1, -8, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = C.green,
			onClick = function()
				Store.act("Upgrade", { id = id })
			end,
		})
		local lvl = Ui.label(btn, { text = "", size = 14, sizeUdim = UDim2.fromScale(1, 0.4), name = "Level" })
		local cost = Ui.label(
			btn,
			{ text = "", size = 20, sizeUdim = UDim2.fromScale(1, 0.6), pos = UDim2.fromScale(0, 0.4), stroke = true, name = "Cost" }
		)
		rows[id] = { button = btn, level = lvl, cost = cost }
	end
	local info = Ui.label(p.body, {
		text = "",
		size = 16,
		color = C.muted,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		wrap = true,
		rich = true,
		sizeUdim = UDim2.new(1, -8, 0, 120),
		name = "Info",
	})
	info.LayoutOrder = 10
	Store.connect(function(st)
		for id, rr in pairs(rows) do
			local def = Config.Upgrades[id]
			local lv = st.upgrades[id]
			if lv >= def.max then
				rr.level.Text = "NIV. MAX"
				rr.cost.Text = "✓"
				Ui.setEnabled(rr.button, false)
			else
				local c = Economy.upgradeCost(id, lv)
				local have = st[def.currency]
				rr.level.Text = "Niv. " .. lv .. "/" .. def.max
				rr.cost.Text = (def.currency == "cash" and "💰 " or "🦴 ") .. Util.formatNumber(c)
				Ui.setEnabled(rr.button, have >= c)
			end
		end
		local m = st.mult
		info.Text = string.format(
			"<b>Revenus du parc</b> : %s/s\nBase dinos : %s  ×  collection %.2f  ×  renaissance %.2f  ×  billet %.2f  ×  bâtiments %.2f  ×  pass %.0f  ×  boost %.0f\nPelle : %d 🦴/coup (critique %.0f%% ×%d)  •  ouvriers : %.1f 🦴/s",
			Util.formatNumber(st.income),
			Util.formatNumber(st.baseIncome),
			m.collection,
			m.rebirth,
			m.ticket,
			m.buildings,
			m.pass,
			m.boost,
			st.digAmount,
			st.critChance * 100,
			Config.CritMultiplier,
			st.autoDigRate
		)
	end)
end

----------------------------------------------------------------------
-- Collection
----------------------------------------------------------------------
local function buildCollection()
	local p = Ui.createPanel("collection", "🦖 Collection de dinos", UDim2.fromOffset(700, 520), { color = C.green })
	local header =
		Ui.label(p.body, { text = "", size = 18, color = C.gold, rich = false, sizeUdim = UDim2.new(1, -8, 0, 28), name = "Header" })
	local grid = Ui.new("Frame", {
		Name = "Grid",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = p.body,
	})
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 190),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = grid,
	})
	local sellBtn = Ui.button(p.frame, {
		text = "",
		size = UDim2.fromOffset(300, 44),
		pos = UDim2.new(0.5, 0, 1, -8),
		anchor = Vector2.new(0.5, 1),
		color = C.red,
		z = 30,
		onClick = function()
			Store.act("SellReserve")
		end,
	})
	p.body.Size = UDim2.new(1, -20, 1, -132)

	local cards = {}
	local ordered = {}
	for _, d in ipairs(Config.Dinos) do
		table.insert(ordered, d)
	end
	table.sort(ordered, function(a, b)
		local sa, sb = a.secret and 1 or 0, b.secret and 1 or 0
		if sa ~= sb then
			return sa < sb
		end
		local ra, rb = Config.RarityById[a.rarity].order, Config.RarityById[b.rarity].order
		if ra ~= rb then
			return ra < rb
		end
		return a.id < b.id
	end)
	for i, d in ipairs(ordered) do
		local rar = Config.RarityById[d.rarity]
		local f = Ui.new("Frame", { LayoutOrder = i, BackgroundColor3 = C.row, Parent = grid })
		Ui.corner(f, 12)
		Ui.stroke(f, rar.color, 3)
		local vpHolder = Ui.new("Frame", { Name = "VP", Size = UDim2.new(1, 0, 0, 112), BackgroundTransparency = 1, Parent = f })
		local name = Ui.label(
			f,
			{ text = "???", size = 18, sizeUdim = UDim2.new(1, -6, 0, 24), pos = UDim2.fromOffset(3, 114), stroke = true, name = "Name" }
		)
		Ui.label(f, {
			text = rar.name,
			size = 14,
			color = rar.color,
			sizeUdim = UDim2.new(1, 0, 0, 18),
			pos = UDim2.fromOffset(0, 136),
			stroke = true,
			name = "Rarity",
		})
		local inc = Ui.label(
			f,
			{ text = "", size = 14, color = C.gold, sizeUdim = UDim2.new(1, 0, 0, 18), pos = UDim2.fromOffset(0, 154), name = "Income" }
		)
		local cnt =
			Ui.label(f, { text = "", size = 15, sizeUdim = UDim2.new(1, -6, 0, 18), pos = UDim2.fromOffset(0, 170), name = "Count" })
		cards[d.id] = { def = d, frame = f, holder = vpHolder, name = name, inc = inc, cnt = cnt, shown = nil }
	end

	local function render(st)
		local discovered = Economy.discoveredCount({ discovered = st.discovered })
		local total = #Config.Dinos
		header.Text = string.format(
			"Découverts : %d/%d   •   bonus de collection : +%d%% revenus",
			discovered,
			total,
			math.floor(discovered * Config.CollectionBonus * 100 + 0.5)
		)
		for id, card in pairs(cards) do
			local known = st.discovered[id] == true
			local normal = st.dinos[id] or 0
			local gold = st.dinos[id .. ":g"] or 0
			if card.shown ~= known then
				card.shown = known
				for _, c in ipairs(card.holder:GetChildren()) do
					c:Destroy()
				end
				if known or not card.def.secret then
					Ui.dinoViewport(card.holder, id, { silhouette = not known })
				else
					Ui.label(card.holder, { text = "🌌", size = 48 })
				end
			end
			if known then
				card.name.Text = card.def.name
				card.inc.Text = "💰 " .. Util.formatNumber(Economy.dinoIncome(id)) .. "/s"
				local t = "x" .. normal
				if gold > 0 then
					t = t .. "  ★" .. gold
				end
				card.cnt.Text = t
			else
				card.name.Text = "???"
				card.inc.Text = card.def.secret and ("Os dorés " .. st.bones .. "/" .. Config.GoldBoneCount) or ""
				card.cnt.Text = ""
			end
		end
		local n = 0
		for _, v in pairs(st.reserve) do
			n = n + v
		end
		sellBtn.Text = n > 0 and ("Vendre la réserve (" .. n .. ") : +" .. Util.formatNumber(st.reserveValue) .. " 💰")
			or "Réserve vide (" .. st.displayedCount .. "/" .. st.slots .. " exposés)"
		Ui.setEnabled(sellBtn, n > 0, C.red)
	end
	-- les viewports ne sont construits qu'à l'ouverture (économie de ressources)
	p.onOpen = function()
		if Store.state then
			render(Store.state)
		end
	end
	Store.connect(function(st)
		if Ui.openName == "collection" then
			render(st)
		end
	end)
end

----------------------------------------------------------------------
-- Quêtes
----------------------------------------------------------------------
local function questText(q)
	for _, t in ipairs(Config.QuestTypes) do
		if t.id == q.id then
			return string.format(t.text, q.target), t
		end
	end
	return q.id
end

local function buildQuests()
	local p = Ui.createPanel("quests", "📜 Quêtes du jour", UDim2.fromOffset(560, 400), { color = C.blue })
	listLayout(p.body)
	local rows = {}
	for i = 1, Config.QuestCount do
		local r = row(p.body, i, 92)
		local text = Ui.label(r, {
			text = "",
			size = 20,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -190, 0, 28),
			pos = UDim2.fromOffset(12, 8),
			stroke = true,
			name = "Text",
		})
		local reward = Ui.label(r, {
			text = "",
			size = 14,
			color = C.gold,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -190, 0, 18),
			pos = UDim2.fromOffset(12, 38),
			name = "Reward",
		})
		local barBg =
			Ui.new("Frame", { Size = UDim2.new(1, -190, 0, 16), Position = UDim2.fromOffset(12, 62), BackgroundColor3 = C.bg, Parent = r })
		Ui.corner(barBg, 8)
		local fill = Ui.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, Parent = barBg })
		Ui.corner(fill, 8)
		local prog = Ui.label(barBg, { text = "", size = 12, stroke = true, z = 3 })
		local btn = Ui.button(r, {
			text = "Récupérer",
			size = UDim2.fromOffset(150, 52),
			pos = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = C.green,
			onClick = function()
				Store.act("ClaimQuest", { index = i })
			end,
		})
		rows[i] = { row = r, text = text, reward = reward, fill = fill, prog = prog, btn = btn }
	end
	local foot = Ui.label(
		p.body,
		{ text = "Les quêtes se renouvellent chaque jour (minuit UTC).", size = 14, color = C.muted, sizeUdim = UDim2.new(1, -8, 0, 24) }
	)
	foot.LayoutOrder = 10
	Store.connect(function(st)
		for i, rr in ipairs(rows) do
			local q = st.quests[i]
			rr.row.Visible = q ~= nil
			if q then
				local txt, qt = questText(q)
				rr.text.Text = txt
				if qt.reward.fossils then
					local f = math.floor(
						qt.reward.fossils * q.tier * (1 + st.upgrades.shovel * 0.5) * Economy.fossilMultiplier({ rebirths = st.rebirths })
					)
					rr.reward.Text = "Récompense : " .. Util.formatNumber(f) .. " 🦴"
				else
					local c = math.max(300 * q.tier, math.floor(st.income * 60 * qt.reward.minutes * q.tier / 2))
					rr.reward.Text = "Récompense : ≈ " .. Util.formatNumber(c) .. " 💰"
				end
				local ratio = math.clamp(q.progress / q.target, 0, 1)
				rr.fill.Size = UDim2.fromScale(ratio, 1)
				rr.prog.Text = Util.formatNumber(q.progress) .. " / " .. Util.formatNumber(q.target)
				if q.claimed then
					rr.btn.Text = "✓ Terminé"
					Ui.setEnabled(rr.btn, false)
				else
					rr.btn.Text = "Récupérer"
					Ui.setEnabled(rr.btn, q.progress >= q.target, C.green)
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Cadeau quotidien
----------------------------------------------------------------------
local function buildDaily()
	local p = Ui.createPanel("daily", "🎁 Cadeau quotidien", UDim2.fromOffset(640, 340), { color = C.purple })
	local grid = Ui.new("Frame", { Size = UDim2.new(1, -8, 0, 150), BackgroundTransparency = 1, Parent = p.body })
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(80, 140),
		CellPadding = UDim2.fromOffset(6, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local tiles = {}
	for i, r in ipairs(Config.DailyRewards) do
		local f = Ui.new("Frame", { LayoutOrder = i, BackgroundColor3 = C.row, Parent = grid })
		Ui.corner(f, 12)
		local st = Ui.stroke(f, C.bg, 3)
		Ui.label(f, { text = "Jour " .. i, size = 15, sizeUdim = UDim2.new(1, 0, 0, 24), pos = UDim2.fromOffset(0, 4), stroke = true })
		local icon = r.kind == "egg" and "🥚" or (r.kind == "fossils" and "🦴" or "💰")
		Ui.label(f, { text = icon, size = 36, sizeUdim = UDim2.new(1, 0, 0, 50), pos = UDim2.fromOffset(0, 30) })
		Ui.label(
			f,
			{ text = r.label, size = 13, wrap = true, sizeUdim = UDim2.new(1, -4, 0, 50), pos = UDim2.fromOffset(2, 84), color = C.muted }
		)
		tiles[i] = { frame = f, stroke = st }
	end
	local msg = Ui.label(
		p.body,
		{ text = "", size = 16, color = C.muted, sizeUdim = UDim2.new(1, -8, 0, 24), pos = UDim2.fromOffset(0, 156), name = "Msg" }
	)
	local btn = Ui.button(p.body, {
		text = "Récupérer",
		size = UDim2.fromOffset(260, 50),
		pos = UDim2.new(0.5, 0, 0, 186),
		anchor = Vector2.new(0.5, 0),
		color = C.purple,
		onClick = function()
			Store.act("ClaimDaily")
		end,
	})
	Store.connect(function(st)
		local today = Util.dayNumber(Store.serverNow())
		local nextStreak = st.daily.streak
		if st.daily.canClaim then
			nextStreak = (st.daily.last == today - 1) and (st.daily.streak + 1) or 1
		end
		local idx = ((math.max(nextStreak, 1) - 1) % #Config.DailyRewards) + 1
		for i, t in ipairs(tiles) do
			local done = (not st.daily.canClaim and i <= idx) or (st.daily.canClaim and i < idx)
			t.stroke.Color = (i == idx and st.daily.canClaim) and C.gold or (done and C.green or C.bg)
			t.frame.BackgroundColor3 = done and Color3.fromRGB(50, 90, 70) or C.row
		end
		Ui.setEnabled(btn, st.daily.canClaim, C.purple)
		if st.daily.canClaim then
			msg.Text = "Série en cours : " .. st.daily.streak .. " jour(s). Récupère ton cadeau !"
		else
			local left = (today + 1) * 86400 - Store.serverNow()
			msg.Text = "Prochain cadeau dans " .. Util.formatTime(left) .. " (série : " .. st.daily.streak .. ")"
		end
	end)
	-- compte à rebours vivant
	task.spawn(function()
		while true do
			task.wait(1)
			if Ui.openName == "daily" and Store.state and not Store.state.daily.canClaim then
				local today = Util.dayNumber(Store.serverNow())
				msg.Text = "Prochain cadeau dans "
					.. Util.formatTime((today + 1) * 86400 - Store.serverNow())
					.. " (série : "
					.. Store.state.daily.streak
					.. ")"
			end
		end
	end)
end

----------------------------------------------------------------------
-- Renaissance
----------------------------------------------------------------------
local function buildRebirth()
	local p = Ui.createPanel("rebirth", "🌟 Nouvelle ère", UDim2.fromOffset(560, 420), { color = C.gold })
	local text = Ui.label(p.body, {
		text = "",
		size = 19,
		wrap = true,
		rich = true,
		valign = Enum.TextYAlignment.Top,
		sizeUdim = UDim2.new(1, -16, 0, 230),
		pos = UDim2.fromOffset(8, 4),
		name = "Text",
	})
	local btn = Ui.button(p.body, {
		text = "Renaître",
		size = UDim2.fromOffset(300, 56),
		pos = UDim2.new(0.5, 0, 0, 250),
		anchor = Vector2.new(0.5, 0),
		color = C.gold,
		textSize = 26,
	})
	local armedAt = 0
	btn.Activated:Connect(function()
		if btn:GetAttribute("Disabled") then
			return
		end
		if os.clock() - armedAt < 5 then
			armedAt = 0
			Store.act("Rebirth")
			Ui.closePanels()
		else
			armedAt = os.clock()
			btn.Text = "Confirmer ? (reset du parc)"
			task.delay(5, function()
				if armedAt ~= 0 and os.clock() - armedAt >= 5 then
					armedAt = 0
					if Store.state then
						btn.Text = "Renaître"
					end
				end
			end)
		end
	end)
	Store.connect(function(st)
		local maxed = st.rebirths >= Config.RebirthMax
		local can = st.cash >= st.rebirthCost and not maxed
		text.Text = string.format(
			'<b>Ère actuelle : %d</b>\n\nRenaître remet à zéro tes pièces, fossiles, bâtiments, améliorations et œufs en cours.\n<b>Tu gardes</b> tous tes dinos, ta collection et tes quêtes.\n\n<b>Bonus par ère</b> : +%d%% de revenus et +%d%% de fossiles, définitivement. Tu reçois aussi un <b>Œuf Cosmique</b> gratuit.\n\nCoût : <font color="%s">%s 💰</font> (tu as %s)',
			st.rebirths,
			Config.RebirthIncomeBonus * 100,
			Config.RebirthFossilBonus * 100,
			can and "#6ee87c" or "#ff7a70",
			Util.formatNumber(st.rebirthCost),
			Util.formatNumber(st.cash)
		)
		Ui.setEnabled(btn, can, C.gold)
		if not can then
			btn.Text = maxed and "Ère maximale" or "Pas assez de pièces"
		elseif btn.Text == "Pas assez de pièces" or btn.Text == "Ère maximale" then
			btn.Text = "Renaître"
		end
	end)
end

----------------------------------------------------------------------
-- Boutique Robux (uniquement si des IDs sont configurés)
----------------------------------------------------------------------
local function buildShop()
	local p = Ui.createPanel("shop", "🛒 Boutique", UDim2.fromOffset(560, 440), { color = C.red })
	listLayout(p.body)
	local order = 0
	local rows = {}
	local function add(kind, key, def)
		order = order + 1
		local r = row(p.body, order, 84)
		Ui.label(r, {
			text = def.name,
			size = 22,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -190, 0, 30),
			pos = UDim2.fromOffset(12, 8),
			stroke = true,
		})
		Ui.label(r, {
			text = def.desc,
			size = 14,
			color = C.muted,
			align = Enum.TextXAlignment.Left,
			valign = Enum.TextYAlignment.Top,
			wrap = true,
			sizeUdim = UDim2.new(1, -190, 0, 40),
			pos = UDim2.fromOffset(12, 38),
		})
		local btn = Ui.button(r, {
			text = "R$ " .. def.price,
			size = UDim2.fromOffset(150, 52),
			pos = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = C.green,
			onClick = function()
				Store.act("BuyPass", { kind = kind, key = key })
			end,
		})
		r.Visible = def.id > 0
		rows[#rows + 1] = { kind = kind, key = key, btn = btn, def = def }
	end
	for key, def in pairs(Config.Passes) do
		add("pass", key, def)
	end
	for key, def in pairs(Config.Products) do
		add("product", key, def)
	end
	Store.connect(function(st)
		for _, r in ipairs(rows) do
			if r.kind == "pass" then
				local owned = st.passes[r.key] and st.passes[r.key].owned
				r.btn.Text = owned and "✓ Possédé" or ("R$ " .. r.def.price)
				Ui.setEnabled(r.btn, not owned, C.green)
			end
		end
	end)
end

----------------------------------------------------------------------
-- Choix d'œuf (ouvert depuis un incubateur)
----------------------------------------------------------------------
local eggSlot = 1
local function buildEggs()
	local p = Ui.createPanel("eggs", "🥚 Choisis un œuf", UDim2.fromOffset(620, 470), { color = C.blue })
	listLayout(p.body)
	local rows = {}
	for i, id in ipairs(Config.EggOrder) do
		local def = Config.Eggs[id]
		local r = row(p.body, i, 92)
		local icon = Ui.new(
			"Frame",
			{ Size = UDim2.fromOffset(48, 62), Position = UDim2.fromOffset(12, 15), BackgroundColor3 = def.color, Parent = r }
		)
		Ui.corner(icon, 24)
		Ui.stroke(icon, def.spot, 3)
		Ui.label(r, {
			text = def.name,
			size = 22,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -250, 0, 28),
			pos = UDim2.fromOffset(74, 6),
			stroke = true,
		})
		local chances = {}
		local total = 0
		for _, w in pairs(def.weights) do
			total = total + w
		end
		for _, rid in ipairs(Config.RarityOrder) do
			local w = def.weights[rid]
			if w then
				local rar = Config.RarityById[rid]
				table.insert(
					chances,
					string.format('<font color="%s">%s %d%%</font>', hex(rar.color), rar.name, math.floor(w / total * 100 + 0.5))
				)
			end
		end
		Ui.label(r, {
			text = table.concat(chances, "  "),
			size = 13,
			rich = true,
			align = Enum.TextXAlignment.Left,
			valign = Enum.TextYAlignment.Top,
			wrap = true,
			sizeUdim = UDim2.new(1, -250, 0, 40),
			pos = UDim2.fromOffset(74, 36),
		})
		local timeLbl = Ui.label(r, {
			text = "",
			size = 13,
			color = C.muted,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -250, 0, 16),
			pos = UDim2.fromOffset(74, 72),
		})
		local btn = Ui.button(r, {
			text = "",
			size = UDim2.fromOffset(150, 56),
			pos = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = C.green,
			onClick = function()
				Store.act("StartHatch", { slot = eggSlot, egg = id })
				Ui.closePanels()
			end,
		})
		rows[id] = { btn = btn, time = timeLbl }
	end
	local function render(st)
		for id, rr in pairs(rows) do
			local def = Config.Eggs[id]
			if st.level < def.level then
				rr.btn.Text = "🔒 Niveau " .. def.level
				Ui.setEnabled(rr.btn, false)
			else
				rr.btn.Text = "🦴 " .. Util.formatNumber(def.cost)
				Ui.setEnabled(rr.btn, st.fossils >= def.cost, C.green)
			end
			local t = Economy.hatchTime(id, { upgrades = st.upgrades }, st.flags)
			rr.time.Text = "Éclosion : " .. Util.formatTime(t)
		end
	end
	Store.connect(render)
end

----------------------------------------------------------------------
-- Aventure : l'histoire du Professeur Rex
----------------------------------------------------------------------
local function buildStory()
	local p = Ui.createPanel("story", "📖 L'aventure du Professeur Rex", UDim2.fromOffset(620, 480), { color = C.blue })
	listLayout(p.body)
	local rows = {}
	for i, ch in ipairs(Config.Story) do
		local r = row(p.body, i, 96)
		local title = Ui.label(r, {
			text = ch.title,
			size = 20,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -190, 0, 26),
			pos = UDim2.fromOffset(12, 6),
			stroke = true,
		})
		local text = Ui.label(r, {
			text = ch.text,
			size = 14,
			color = C.muted,
			wrap = true,
			align = Enum.TextXAlignment.Left,
			valign = Enum.TextYAlignment.Top,
			sizeUdim = UDim2.new(1, -190, 0, 40),
			pos = UDim2.fromOffset(12, 34),
		})
		local prog = Ui.label(r, {
			text = "",
			size = 13,
			color = C.gold,
			align = Enum.TextXAlignment.Left,
			sizeUdim = UDim2.new(1, -190, 0, 18),
			pos = UDim2.fromOffset(12, 74),
		})
		local btn = Ui.button(r, {
			text = "Récupérer",
			size = UDim2.fromOffset(150, 52),
			pos = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = C.green,
			onClick = function()
				Store.act("ClaimStory")
			end,
		})
		rows[i] = { row = r, title = title, text = text, prog = prog, btn = btn }
	end
	local function rewardText(r)
		if r.fossils then
			return r.fossils .. " 🦴"
		elseif r.cashMinutes then
			return r.cashMinutes .. " min de revenus"
		end
		return "un œuf " .. (Config.Eggs[r.egg] and Config.Eggs[r.egg].name or "")
	end
	Store.connect(function(st)
		for i, rr in ipairs(rows) do
			local ch = Config.Story[i]
			if i <= st.storyClaimed then
				rr.row.BackgroundColor3 = Color3.fromRGB(46, 84, 66)
				rr.prog.Text = "✓ Terminé"
				rr.btn.Text = "✓"
				Ui.setEnabled(rr.btn, false)
			elseif i == st.storyClaimed + 1 then
				rr.row.BackgroundColor3 = C.row
				local target = st.storyTarget or 1
				rr.prog.Text = string.format(
					"%s / %s   •   Récompense : %s",
					Util.formatNumber(math.min(st.storyValue, target)),
					Util.formatNumber(target),
					rewardText(ch.reward)
				)
				rr.btn.Text = "Récupérer"
				Ui.setEnabled(rr.btn, st.storyValue >= target, C.green)
			else
				rr.row.BackgroundColor3 = Color3.fromRGB(44, 50, 68)
				rr.prog.Text = "🔒 Chapitre suivant"
				rr.btn.Text = "…"
				Ui.setEnabled(rr.btn, false)
			end
		end
	end)
end

local function buildWelcome()
	local p = Ui.createPanel("welcome", "🦖 Bienvenue au Dino Dig Park !", UDim2.fromOffset(560, 400), { color = C.green })
	local text = Ui.label(p.body, {
		text = "<b>1.</b> Va dans la zone de fouille et appuie sur ⛏ CREUSER pour trouver des fossiles.\n<b>2.</b> Au laboratoire, place un œuf dans un incubateur (E ou toucher).\n<b>3.</b> Les dinos exposés dans tes enclos rapportent des 💰 : marche sur le pad vert du kiosque pour les collecter.\n<b>4.</b> Marche sur les boutons colorés pour agrandir ton parc.\n\nSuis le rayon jaune : il montre toujours le prochain objectif.",
		size = 19,
		wrap = true,
		rich = true,
		valign = Enum.TextYAlignment.Top,
		align = Enum.TextXAlignment.Left,
		sizeUdim = UDim2.new(1, -16, 0, 240),
		pos = UDim2.fromOffset(8, 4),
	})
	text.Name = "Steps"
	Ui.button(p.body, {
		text = "C'est parti !",
		size = UDim2.fromOffset(260, 54),
		pos = UDim2.new(0.5, 0, 0, 260),
		anchor = Vector2.new(0.5, 0),
		color = C.green,
		textSize = 24,
		onClick = Ui.closePanels,
	})
	local shown = false
	Store.connect(function(st)
		if not shown and st.stats.digs == 0 and st.stats.hatched == 0 and next(st.dinos) == nil then
			shown = true
			task.delay(1.5, function()
				if Ui.openName == nil then
					Ui.openPanel("welcome")
				end
			end)
		else
			shown = true
		end
	end)
end

function Panels.openEggs(slot)
	eggSlot = slot
	Ui.openPanel("eggs")
end

function Panels.build()
	buildUpgrades()
	buildCollection()
	buildQuests()
	buildDaily()
	buildRebirth()
	buildShop()
	buildEggs()
	buildStory()
	buildWelcome()
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Reveal</string>
            <string name="Source"><![CDATA[-- Reveal.luau : animation d'éclosion (œuf qui tremble -> flash -> dino en rotation avec sa rareté).

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Economy = require(Shared.Economy)

local Ui = require(script.Parent.Ui)

local Reveal = {}
local C = Ui.colors

local queue = {}
local playing = false
local overlay

local function build()
	overlay = Ui.new("Frame", {
		Name = "RevealOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 50,
		Active = true,
		Parent = Ui.root,
	})
end

local function play(item)
	playing = true
	for _, c in ipairs(overlay:GetChildren()) do
		c:Destroy()
	end
	overlay.Visible = true
	Ui.closePanels()

	local id, golden = Economy.parseKey(item.key)
	local def = Config.DinoById[id]
	local rar = Config.RarityById[def.rarity]
	local egg = Config.Eggs[item.egg] or Config.Eggs.basic

	-- 1. œuf qui tremble
	local eggFrame = Ui.new("Frame", {
		Size = UDim2.fromOffset(150, 200),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = egg.color,
		ZIndex = 51,
		Parent = overlay,
	})
	Ui.corner(eggFrame, 75)
	Ui.stroke(eggFrame, egg.spot, 5)
	for i = 1, 5 do
		local s = Ui.new("Frame", {
			Size = UDim2.fromOffset(22 + i * 3, 22 + i * 3),
			Position = UDim2.fromScale(0.15 + (i * 0.37) % 0.6, 0.15 + (i * 0.23) % 0.65),
			BackgroundColor3 = egg.spot,
			ZIndex = 52,
			Parent = eggFrame,
		})
		Ui.corner(s, 20)
	end
	Ui.playSound("click", 0.5)
	local t0 = os.clock()
	local dur = 1.5
	while os.clock() - t0 < dur do
		local a = (os.clock() - t0) / dur
		eggFrame.Rotation = math.sin(os.clock() * (10 + a * 30)) * (6 + a * 14)
		eggFrame.Size = UDim2.fromOffset(150 + a * 40, 200 + a * 50)
		RunService.RenderStepped:Wait()
	end
	eggFrame:Destroy()

	-- 2. flash
	local flash = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 60, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	local order = rar.order
	Ui.playSound("hatch", 0.5 + order * 0.07, 0.8 + order * 0.07)
	if order >= 5 then
		task.delay(0.35, function()
			Ui.playSound("buy", 0.8, 1.4)
		end)
	end

	-- 3. révélation
	local rays = {}
	for i = 1, 2 do
		local r = Ui.new("Frame", {
			Size = UDim2.fromOffset(380, 380),
			Position = UDim2.fromScale(0.5, 0.44),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = i * 45,
			BackgroundColor3 = rar.color,
			BackgroundTransparency = 0.6,
			ZIndex = 51,
			Parent = overlay,
		})
		Ui.corner(r, 30)
		rays[i] = r
	end
	local vp, model = Ui.dinoViewport(overlay, item.key, { size = UDim2.fromOffset(440, 330), pos = UDim2.fromScale(0.5, 0.44), z = 53 })
	vp.AnchorPoint = Vector2.new(0.5, 0.5)
	local nameText = def.name
	if golden then
		nameText = "✨ " .. nameText .. " DORÉ ✨"
	end
	Ui.label(overlay, {
		text = nameText,
		size = 44,
		color = rar.color,
		sizeUdim = UDim2.fromOffset(640, 56),
		pos = UDim2.fromScale(0.5, 0.72),
		anchor = Vector2.new(0.5, 0.5),
		stroke = true,
		z = 55,
		name = "Name",
	})
	Ui.label(overlay, {
		text = rar.name:upper() .. "   •   💰 " .. Util.formatNumber(Economy.dinoIncome(item.key)) .. "/s",
		size = 24,
		sizeUdim = UDim2.fromOffset(640, 34),
		pos = UDim2.fromScale(0.5, 0.78),
		anchor = Vector2.new(0.5, 0.5),
		stroke = true,
		z = 55,
	})
	if item.new then
		Ui.label(overlay, {
			text = "NOUVEAU DINO !",
			size = 28,
			color = C.gold,
			sizeUdim = UDim2.fromOffset(400, 40),
			pos = UDim2.fromScale(0.5, 0.2),
			anchor = Vector2.new(0.5, 0.5),
			stroke = true,
			z = 55,
		})
	end
	local done = false
	Ui.button(overlay, {
		text = "Super !",
		size = UDim2.fromOffset(220, 56),
		pos = UDim2.fromScale(0.5, 0.88),
		anchor = Vector2.new(0.5, 0.5),
		color = C.green,
		z = 56,
		textSize = 26,
		onClick = function()
			done = true
		end,
	})

	-- apparition + rotation
	vp.Size = UDim2.fromOffset(10, 8)
	TweenService:Create(vp, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(440, 330) })
		:Play()
	local conn = RunService.RenderStepped:Connect(function(dt)
		for i, r in ipairs(rays) do
			r.Rotation = r.Rotation + dt * (i == 1 and 25 or -18)
		end
		if model then
			local center = vp:GetAttribute("Center")
			if center then
				model:PivotTo(CFrame.new(center) * CFrame.Angles(0, os.clock() * 1.1, 0) * CFrame.new(-center))
			end
		end
	end)
	while not done and overlay.Visible do
		RunService.RenderStepped:Wait()
	end
	conn:Disconnect()
	overlay.Visible = false
	playing = false
end

function Reveal.show(key, isNew, eggId)
	table.insert(queue, { key = key, new = isNew, egg = eggId })
	if playing then
		return
	end
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			play(item)
		end
	end)
end

function Reveal.build()
	build()
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">StateStore</string>
            <string name="Source"><![CDATA[-- StateStore.luau : copie locale de l'état envoyé par le serveur + signaux de changement.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Store = {}
Store.state = nil
Store.skew = 0
local listeners = {}

function Store.serverNow()
	return os.time() + Store.skew
end

-- fn(state) est appelé à chaque mise à jour (et immédiatement si un état existe déjà)
function Store.connect(fn)
	table.insert(listeners, fn)
	if Store.state then
		fn(Store.state)
	end
end

function Store.act(name, payload)
	Remotes.Action:FireServer(name, payload)
end

Remotes.State.OnClientEvent:Connect(function(state)
	Store.state = state
	Store.skew = state.now - os.time()
	for _, fn in ipairs(listeners) do
		local ok, err = pcall(fn, state)
		if not ok then
			warn("[StateStore] listener:", err)
		end
	end
end)

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Ui.luau : thème et petits composants d'interface (tout est construit par code, sans asset externe).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local DinoFactory = require(Shared.DinoFactory)

local Ui = {}

Ui.font = Enum.Font.FredokaOne
Ui.colors = {
	bg = Color3.fromRGB(34, 40, 56),
	panel = Color3.fromRGB(48, 56, 78),
	row = Color3.fromRGB(62, 72, 98),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(175, 185, 210),
	gold = Color3.fromRGB(255, 214, 80),
	green = Color3.fromRGB(80, 200, 110),
	red = Color3.fromRGB(235, 90, 85),
	blue = Color3.fromRGB(80, 160, 255),
	purple = Color3.fromRGB(170, 100, 255),
	orange = Color3.fromRGB(255, 160, 60),
	disabled = Color3.fromRGB(95, 100, 115),
}

Ui.settings = { sfx = true }

local player = Players.LocalPlayer

----------------------------------------------------------------------
-- Sons
----------------------------------------------------------------------
local soundCache = {}
function Ui.playSound(name, volume, pitch)
	if not Ui.settings.sfx then
		return
	end
	local id = Config.Sounds[name]
	if not id then
		return
	end
	local snd = soundCache[name]
	if not snd then
		snd = Instance.new("Sound")
		snd.Name = "Sfx_" .. name
		snd.SoundId = id
		snd.Volume = volume or 0.5
		snd.Parent = SoundService
		soundCache[name] = snd
	end
	snd.TimePosition = 0
	snd.PlaybackSpeed = pitch or 1
	snd:Play()
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------
function Ui.new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Ui.corner(parent, radius)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

function Ui.stroke(parent, color, thickness)
	return Ui.new(
		"UIStroke",
		{ Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent }
	)
end

function Ui.label(parent, props)
	local l = Ui.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Ui.font,
		TextColor3 = props.color or Ui.colors.text,
		TextSize = props.size or 18,
		Text = props.text or "",
		TextXAlignment = props.align or Enum.TextXAlignment.Center,
		TextYAlignment = props.valign or Enum.TextYAlignment.Center,
		TextWrapped = props.wrap or false,
		TextScaled = props.scaled or false,
		RichText = props.rich or false,
		Size = props.sizeUdim or UDim2.fromScale(1, 1),
		Position = props.pos or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.new(0, 0),
		ZIndex = props.z or 1,
		Name = props.name or "Label",
		Parent = parent,
	})
	if props.stroke then
		l.TextStrokeTransparency = 0.3
		l.TextStrokeColor3 = Color3.fromRGB(10, 10, 20)
	end
	return l
end

-- Bouton avec effet d'appui. props : text, size(UDim2), pos, color, onClick, textSize
function Ui.button(parent, props)
	local b = Ui.new("TextButton", {
		Name = props.name or "Button",
		Text = props.text or "",
		Font = Ui.font,
		TextSize = props.textSize or 20,
		TextColor3 = Ui.colors.text,
		BackgroundColor3 = props.color or Ui.colors.green,
		AutoButtonColor = false,
		Size = props.size or UDim2.fromOffset(120, 44),
		Position = props.pos or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.new(0, 0),
		ZIndex = props.z or 1,
		RichText = props.rich or false,
		Parent = parent,
	})
	Ui.corner(b, props.radius or 12)
	Ui.stroke(b, Color3.fromRGB(15, 18, 30), 2)
	-- léger dégradé vertical : relief "bouton Roblox"
	Ui.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
		Parent = b,
	})
	local base = b.BackgroundColor3
	b:SetAttribute("BaseColor", base)
	local scale = Ui.new("UIScale", { Scale = 1, Parent = b })
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 0.93 }):Play()
	end)
	local function release()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	if props.onClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then
				Ui.playSound("error", 0.25)
				return
			end
			Ui.playSound("click", 0.35)
			props.onClick()
		end)
	end
	return b
end

function Ui.setEnabled(button, enabled, color)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = enabled and (color or button:GetAttribute("BaseColor")) or Ui.colors.disabled
end

----------------------------------------------------------------------
-- Racine
----------------------------------------------------------------------
function Ui.createRoot()
	local gui = Ui.new("ScreenGui", {
		Name = "DinoUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = Ui.new("UIScale", { Parent = gui })
	local function update()
		local cam = Workspace.CurrentCamera
		local size = cam and cam.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(size.Y / 620, size.X / 900), 0.62, 1.35)
	end
	update()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	Ui.root = gui
	return gui
end

----------------------------------------------------------------------
-- Panneaux modaux (un seul ouvert à la fois)
----------------------------------------------------------------------
Ui.panels = {}
Ui.openName = nil

function Ui.closePanels()
	for _, p in pairs(Ui.panels) do
		p.frame.Visible = false
		p.dim.Visible = false
	end
	Ui.openName = nil
end

function Ui.openPanel(name)
	local p = Ui.panels[name]
	if not p then
		return
	end
	Ui.closePanels()
	p.dim.Visible = true
	p.frame.Visible = true
	Ui.openName = name
	if p.onOpen then
		p.onOpen()
	end
	local sc = p.frame:FindFirstChild("PopScale")
	if sc then
		sc.Scale = 0.85
		TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	Ui.playSound("click", 0.3)
end

function Ui.togglePanel(name)
	if Ui.openName == name then
		Ui.closePanels()
	else
		Ui.openPanel(name)
	end
end

-- Crée un panneau : retourne { frame, body (ScrollingFrame) }
function Ui.createPanel(name, title, size, opts)
	opts = opts or {}
	local dim = Ui.new("TextButton", {
		Name = name .. "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 20,
		Parent = Ui.root,
	})
	dim.Activated:Connect(Ui.closePanels)

	local frame = Ui.new("Frame", {
		Name = name,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Ui.colors.bg,
		Visible = false,
		ZIndex = 21,
		Parent = Ui.root,
	})
	Ui.corner(frame, 18)
	Ui.stroke(frame, Color3.fromRGB(12, 14, 24), 3)
	Ui.new(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 210, 225)), Rotation = 90, Parent = frame }
	)
	Ui.new("UIScale", { Name = "PopScale", Parent = frame })

	local header = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = opts.color or Ui.colors.blue,
		ZIndex = 22,
		Parent = frame,
	})
	Ui.corner(header, 18)
	-- masque l'arrondi du bas de l'en-tête
	Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.new(0, 0, 1, -14),
		BackgroundColor3 = header.BackgroundColor3,
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = header,
	})
	Ui.label(header, { text = title, size = 28, stroke = true, z = 23, name = "Title" })
	local close = Ui.button(header, {
		text = "✕",
		size = UDim2.fromOffset(40, 40),
		pos = UDim2.new(1, -8, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = Ui.colors.red,
		z = 24,
		textSize = 22,
		onClick = Ui.closePanels,
	})

	local body = Ui.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(10, 62),
		Size = UDim2.new(1, -20, 1, -72),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 22,
		Parent = frame,
	})
	local panel = { frame = frame, dim = dim, body = body, header = header, close = close }
	Ui.panels[name] = panel
	return panel
end

----------------------------------------------------------------------
-- ViewportFrame de dinosaure
----------------------------------------------------------------------
-- options : silhouette (bool), rotate (bool, retourne un connecteur à déconnecter)
function Ui.dinoViewport(parent, key, options)
	options = options or {}
	local vp = Ui.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = options.size or UDim2.fromScale(1, 1),
		Position = options.pos or UDim2.new(),
		Ambient = options.silhouette and Color3.new(0, 0, 0) or Color3.fromRGB(190, 190, 200),
		LightColor = options.silhouette and Color3.new(0, 0, 0) or Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, 1),
		ZIndex = options.z or 1,
		Parent = parent,
	})
	local model = DinoFactory.build(key, { sparkle = true })
	if not model then
		return vp
	end
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local center = cf.Position
	local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * 0.9
	cam.CFrame = CFrame.lookAt(center + Vector3.new(0.7, 0.45, -1.0).Unit * dist, center)
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp:SetAttribute("Center", center)
	return vp, model
end

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- World.luau : animations locales (dinos qui se promènent, visiteurs, ouvriers, œufs), effets et rayon-guide.
-- Tout est cosmétique et exécuté uniquement chez le joueur : aucun coût serveur.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local HumanFactory = require(Shared.HumanFactory)

local Ui = require(script.Parent.Ui)
local Store = require(script.Parent.StateStore)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Panels)
local Reveal = require(script.Parent.Reveal)

local World = {}
local player = Players.LocalPlayer
local rng = Random.new()

local plotModel, plotCF = nil, nil
local dinoState = setmetatable({}, { __mode = "k" })
local eggBase = setmetatable({}, { __mode = "k" })
local visitors = {}
local visitorFolder

----------------------------------------------------------------------
-- Localisation de la parcelle
----------------------------------------------------------------------
local function refreshPlot()
	local idx = player:GetAttribute("PlotIndex")
	if not idx then
		return false
	end
	local plots = Workspace:FindFirstChild("Plots")
	local m = plots and plots:FindFirstChild("Plot" .. idx)
	if not m then
		return false
	end
	if m ~= plotModel then
		plotModel = m
		local static = m:WaitForChild("Static")
		local terrain = static:WaitForChild("Terrain")
		plotCF = terrain.CFrame * CFrame.new(0, -0.05, 0)
	end
	return true
end

local function rootPart()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

----------------------------------------------------------------------
-- Effets
----------------------------------------------------------------------
local digEmitter
local function ensureEmitter(hrp)
	if digEmitter and digEmitter.Parent then
		return digEmitter
	end
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, -2.5, -1)
	att.Parent = hrp
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(150, 105, 65))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(0.5, 0.9)
	pe.Speed = NumberRange.new(6, 12)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Rate = 0
	pe.Acceleration = Vector3.new(0, -20, 0)
	pe.Parent = att
	digEmitter = pe
	return pe
end

function World.floatText(text, color, big)
	local hrp = rootPart()
	if not hrp then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Adornee = hrp
	bb.Size = UDim2.fromOffset(big and 260 or 180, big and 54 or 40)
	bb.StudsOffset = Vector3.new(rng:NextNumber(-1.5, 1.5), 3.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = player:WaitForChild("PlayerGui")
	local l = Ui.label(bb, { text = text, size = big and 30 or 22, color = color or Color3.new(1, 1, 1), stroke = true })
	TweenService:Create(
		bb,
		TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffset = bb.StudsOffset + Vector3.new(0, 4, 0) }
	):Play()
	local tw = TweenService:Create(l, TweenInfo.new(0.9), { TextTransparency = 1, TextStrokeTransparency = 1 })
	tw:Play()
	tw.Completed:Connect(function()
		bb:Destroy()
	end)
end

local burst
local function emitBurst(color, count)
	local hrp = rootPart()
	if not hrp then
		return
	end
	if not burst or not burst.Parent then
		local att = Instance.new("Attachment")
		att.Name = "BurstAtt"
		att.Position = Vector3.new(0, 1, 0)
		att.Parent = hrp
		burst = Instance.new("ParticleEmitter")
		burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		burst.Lifetime = NumberRange.new(0.6, 1.1)
		burst.Speed = NumberRange.new(10, 20)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		burst.LightEmission = 1
		burst.Rate = 0
		burst.Parent = att
	end
	burst.Color = ColorSequence.new(color)
	burst:Emit(count)
end

local function onFx(fx)
	if type(fx) ~= "table" then
		return
	end
	local t = fx.t
	if t == "dig" then
		local text = "+" .. Util.formatNumber(fx.amount) .. " 🦴"
		if fx.crit then
			World.floatText("TROUVAILLE ! " .. text, Ui.colors.gold, true)
		else
			World.floatText(text, Color3.fromRGB(250, 240, 210), false)
		end
		Ui.playSound("dig", fx.crit and 0.7 or 0.4)
		local hrp = rootPart()
		if hrp then
			ensureEmitter(hrp):Emit(fx.crit and 14 or 6)
		end
	elseif t == "collect" then
		World.floatText("+" .. Util.formatNumber(fx.amount) .. " 💰", Ui.colors.green, true)
		Ui.playSound("buy", 0.5)
		emitBurst(Color3.fromRGB(255, 225, 90), 10)
	elseif t == "buy" or t == "upgrade" then
		Ui.playSound("buy", 0.6)
		emitBurst(t == "buy" and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 170, 60), 18)
	elseif t == "hatch" then
		Reveal.show(fx.key, fx.new, fx.egg)
	elseif t == "openEggs" then
		Panels.openEggs(fx.slot)
	elseif t == "meteor" then
		World.floatText("☄ +" .. Util.formatNumber(fx.amount) .. " 🦴", Ui.colors.orange, true)
		Ui.playSound("buy", 0.6)
	elseif t == "levelup" then
		World.floatText("⭐ NIVEAU " .. fx.level .. " !", Ui.colors.gold, true)
		Ui.playSound("hatch", 0.8, 1.2)
		emitBurst(Color3.fromRGB(255, 220, 90), 40)
	elseif t == "story" then
		Ui.playSound("buy", 0.7, 1.3)
		emitBurst(Color3.fromRGB(120, 180, 255), 24)
	elseif t == "rebirth" then
		Ui.playSound("hatch", 0.7)
	end
end

----------------------------------------------------------------------
-- Animations : dinos, ouvriers, œufs
----------------------------------------------------------------------
local function updateDinos(dt, t, camPos)
	local dyn = plotModel:FindFirstChild("Dynamic")
	local folder = dyn and dyn:FindFirstChild("Dinos")
	if not folder then
		return
	end
	for _, m in ipairs(folder:GetChildren()) do
		local home = m:GetAttribute("Home")
		if home then
			local st = dinoState[m]
			if not st then
				st = {
					pos = home,
					yaw = rng:NextNumber(0, 6.28),
					target = home,
					wait = rng:NextNumber(0, 3),
					phase = rng:NextNumber(0, 6.28),
				}
				dinoState[m] = st
			end
			if (home - camPos).Magnitude < 220 then
				local moving = false
				if st.wait > 0 then
					st.wait = st.wait - dt
				else
					local delta = Vector3.new(st.target.X - st.pos.X, 0, st.target.Z - st.pos.Z)
					local dist = delta.Magnitude
					if dist < 0.3 then
						st.target = home + Vector3.new(rng:NextNumber(-2.5, 2.5), 0, rng:NextNumber(-2, 2))
						st.wait = rng:NextNumber(1, 4)
					else
						moving = true
						local dir = delta / dist
						st.pos = st.pos + dir * math.min(dist, 2.6 * dt)
						local want = math.atan2(-dir.X, -dir.Z)
						local diff = math.atan2(math.sin(want - st.yaw), math.cos(want - st.yaw))
						st.yaw = st.yaw + math.clamp(diff, -3 * dt, 3 * dt)
					end
				end
				local bob = moving and math.abs(math.sin(t * 7 + st.phase)) * 0.22 or math.sin(t * 1.5 + st.phase) * 0.05
				m:PivotTo(CFrame.new(st.pos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, st.yaw, 0))
			end
		end
	end
end

local function updateWorkers(t)
	local dyn = plotModel:FindFirstChild("Dynamic")
	if not dyn then
		return
	end
	for _, folder in ipairs(dyn:GetChildren()) do
		if string.sub(folder.Name, 1, 7) == "Ouvrier" then
			local model = folder:FindFirstChild("Ouvrier")
			local base = model and model:GetAttribute("BaseCF")
			if base then
				local phase = tonumber(string.sub(folder.Name, 8)) or 0
				local lift = 0.5 + math.sin(t * 5 + phase * 1.7) * 0.9
				HumanFactory.pose(model, base, 0, lift)
			end
		end
	end
end

-- boutons d'achat : pulsation douce (cosmétique)
local function updatePads(t)
	local pads = plotModel:FindFirstChild("Pads")
	if not pads then
		return
	end
	for _, pad in ipairs(pads:GetChildren()) do
		pad.Transparency = 0.15 + (math.sin(t * 3 + pad.Position.X) + 1) * 0.12
	end
	local booth = plotModel.Static:FindFirstChild("PadCollecte")
	if booth then
		booth.Transparency = 0.1 + (math.sin(t * 4) + 1) * 0.1
	end
end

-- grande roue : rotation des rayons et des nacelles (les nacelles restent à l'endroit)
local wheelState = setmetatable({}, { __mode = "k" })
local function updateWheel(t)
	local dyn = plotModel:FindFirstChild("Dynamic")
	local ride = dyn and dyn:FindFirstChild("ride")
	local axle = ride and ride:FindFirstChild("Axe")
	if not axle then
		return
	end
	local inv = plotCF:Inverse()
	local hub = (inv * axle.CFrame).Position
	local angle = t * 0.25
	local rot = CFrame.new(hub) * CFrame.Angles(angle, 0, 0) * CFrame.new(-hub.X, -hub.Y, -hub.Z)
	for _, part in ipairs(ride:GetChildren()) do
		local isSpoke = string.sub(part.Name, 1, 5) == "Rayon"
		local isGondola = string.sub(part.Name, 1, 7) == "Nacelle"
		if isSpoke or isGondola then
			local base = wheelState[part]
			if not base then
				base = inv * part.CFrame
				wheelState[part] = base
			end
			local moved = rot * base
			if isGondola then
				part.CFrame = plotCF * CFrame.new(moved.Position)
			else
				part.CFrame = plotCF * moved
			end
		end
	end
end

local function updateEggs(t)
	local dyn = plotModel:FindFirstChild("Dynamic")
	if not dyn then
		return
	end
	for _, folder in ipairs(dyn:GetChildren()) do
		if string.sub(folder.Name, 1, 5) == "Stand" then
			local egg = folder:FindFirstChild("Oeuf")
			if egg then
				local base = eggBase[egg]
				if not base then
					base = egg.CFrame
					eggBase[egg] = base
				end
				local state = egg:GetAttribute("State")
				if state == "ready" then
					egg.CFrame = base * CFrame.Angles(0, 0, math.sin(t * 20) * 0.14)
				elseif state == "hatching" then
					egg.CFrame = base * CFrame.new(0, math.sin(t * 2.2) * 0.25, 0) * CFrame.Angles(0, t * 0.8, 0)
				else
					egg.CFrame = base
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Visiteurs (cosmétiques, uniquement dans ta parcelle)
----------------------------------------------------------------------
local function buildRoute(st)
	local route = {}
	local function add(x, z, wait, face)
		table.insert(route, { pos = Vector3.new(x, 0, z), wait = wait, face = face })
	end
	add(rng:NextNumber(-3, 3), -105)
	add(0, -84)
	-- arrêts : enclos possédés
	local stops = {}
	for i, pen in ipairs(Config.Pens) do
		if i == 1 or st.buildables["pen" .. i] then
			local side = pen.center.X < 0 and -1 or 1
			table.insert(stops, { x = side * 8.5, z = pen.center.Z, face = Vector3.new(side, 0, 0) })
		end
	end
	for _, def in ipairs(Config.Buildables) do
		if def.kind == "shop" and st.buildables[def.id] then
			table.insert(stops, { x = def.center.X, z = def.center.Z - 10, face = Vector3.new(0, 0, 1) })
		end
	end
	-- 1 à 3 arrêts, triés du plus proche de l'entrée au plus loin
	local chosen = {}
	local n = rng:NextInteger(1, math.min(3, #stops))
	for _ = 1, n do
		local idx = rng:NextInteger(1, #stops)
		table.insert(chosen, table.remove(stops, idx))
		if #stops == 0 then
			break
		end
	end
	table.sort(chosen, function(a, b)
		return a.z < b.z
	end)
	for _, s in ipairs(chosen) do
		if math.abs(s.x) > 9 then
			add(0, s.z, 0)
		end
		add(s.x, s.z, rng:NextNumber(3, 6), s.face)
		if math.abs(s.x) > 9 then
			add(0, s.z, 0)
		end
	end
	add(0, 18, rng:NextNumber(1, 2), Vector3.new(0, 0, 1))
	add(0, -84, 0)
	add(0, -105, 0)
	return route
end

local function spawnVisitor(st)
	local model = HumanFactory.build({ name = "Visiteur" })
	model.Parent = visitorFolder
	local route = buildRoute(st)
	table.insert(visitors, {
		model = model,
		route = route,
		idx = 2,
		pos = route[1].pos,
		yaw = math.pi,
		wait = 0,
		speed = rng:NextNumber(8, 11),
		phase = rng:NextNumber(0, 6),
	})
end

local function updateVisitors(dt, t, st)
	local target = math.clamp(math.floor(st.displayedCount * 0.9) + 1, 1, 14)
	if #visitors < target and rng:NextNumber() < dt * 0.6 then
		spawnVisitor(st)
	end
	for i = #visitors, 1, -1 do
		local v = visitors[i]
		local swing = 0
		if v.wait > 0 then
			v.wait = v.wait - dt
			if v.face then
				local want = math.atan2(-v.face.X, -v.face.Z)
				local diff = math.atan2(math.sin(want - v.yaw), math.cos(want - v.yaw))
				v.yaw = v.yaw + math.clamp(diff, -6 * dt, 6 * dt)
			end
		else
			local wp = v.route[v.idx]
			if not wp then
				v.model:Destroy()
				table.remove(visitors, i)
				v = nil
			else
				local delta = Vector3.new(wp.pos.X - v.pos.X, 0, wp.pos.Z - v.pos.Z)
				local dist = delta.Magnitude
				if dist < 0.6 then
					v.idx = v.idx + 1
					v.wait = wp.wait or 0
					v.face = wp.face
				else
					local dir = delta / dist
					v.pos = v.pos + dir * math.min(dist, v.speed * dt)
					local want = math.atan2(-dir.X, -dir.Z)
					local diff = math.atan2(math.sin(want - v.yaw), math.cos(want - v.yaw))
					v.yaw = v.yaw + math.clamp(diff, -8 * dt, 8 * dt)
					swing = math.sin(t * 11 + v.phase) * 0.7
				end
			end
		end
		if v then
			local cf = plotCF * CFrame.new(v.pos) * CFrame.Angles(0, v.yaw, 0)
			HumanFactory.pose(v.model, cf, swing, 0)
		end
	end
end

----------------------------------------------------------------------
-- Rayon guide vers l'objectif
----------------------------------------------------------------------
local beam, beamAtt0
local currentGuideTarget

local function resolveTarget(t)
	if not t or not plotModel then
		return nil
	end
	local static = plotModel:FindFirstChild("Static")
	local dyn = plotModel:FindFirstChild("Dynamic")
	if t.kind == "dig" then
		return static and static:FindFirstChild("RepereFouille")
	elseif t.kind == "booth" then
		return static and static:FindFirstChild("PadCollecte")
	elseif t.kind == "stand" then
		local s = dyn and dyn:FindFirstChild("Stand" .. t.slot)
		return s and s:FindFirstChild("Socle")
	elseif t.kind == "pad" then
		local pads = plotModel:FindFirstChild("Pads")
		return pads and pads:FindFirstChild("Pad_" .. t.id)
	end
	return nil
end

local function updateGuide()
	local hrp = rootPart()
	if not hrp then
		return
	end
	-- après une réapparition, l'ancien personnage (et le rayon) est détruit : on recrée tout
	if not beam or not beam.Parent or not beamAtt0 or not beamAtt0.Parent or beamAtt0.Parent ~= hrp then
		if beam then
			beam:Destroy()
		end
		if beamAtt0 then
			beamAtt0:Destroy()
		end
		beamAtt0 = Instance.new("Attachment")
		beamAtt0.Name = "GuideStart"
		beamAtt0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Name = "Guide"
		beam.Width0 = 0.7
		beam.Width1 = 0.7
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Transparency = NumberSequence.new(0.35)
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 225, 90))
		beam.Segments = 1
		beam.Attachment0 = beamAtt0
		beam.Parent = hrp
		currentGuideTarget = nil
	end
	local part = resolveTarget(Hud.objectiveTarget)
	if part and (part.Position - hrp.Position).Magnitude > 16 and Ui.openName == nil then
		if currentGuideTarget ~= part or not beam.Attachment1 or not beam.Attachment1.Parent then
			local att = part:FindFirstChild("GuideEnd")
			if not att then
				att = Instance.new("Attachment")
				att.Name = "GuideEnd"
				att.Position = Vector3.new(0, 1, 0)
				att.Parent = part
			end
			beam.Attachment1 = att
			currentGuideTarget = part
		end
		beam.Enabled = true
	else
		beam.Enabled = false
	end
end

----------------------------------------------------------------------
-- Démarrage
----------------------------------------------------------------------
function World.start()
	visitorFolder = Instance.new("Folder")
	visitorFolder.Name = "LocalVisitors"
	visitorFolder.Parent = Workspace

	Remotes.Fx.OnClientEvent:Connect(onFx)

	-- contexte (zone de fouille / kiosque) + guide, 4 Hz
	task.spawn(function()
		while true do
			task.wait(0.25)
			if refreshPlot() then
				local hrp = rootPart()
				if hrp then
					local dig = plotModel.Static:FindFirstChild("RepereFouille")
					local pad = plotModel.Static:FindFirstChild("PadCollecte")
					if dig then
						local d = Vector3.new(hrp.Position.X - dig.Position.X, 0, hrp.Position.Z - dig.Position.Z).Magnitude
						Hud.context.inDigZone = d <= Config.DigRadius
					end
					if pad then
						Hud.context.nearBooth = (pad.Position - hrp.Position).Magnitude <= 20
					end
					pcall(updateGuide)
				end
			end
		end
	end)

	-- animations
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		if not plotModel or not plotModel.Parent then
			return
		end
		acc = acc + dt
		if acc < 1 / 30 then
			return
		end
		local step = acc
		acc = 0
		local t = os.clock()
		local cam = Workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		updateDinos(step, t, camPos)
		updateWorkers(t)
		updateEggs(t)
		updatePads(t)
		updateWheel(t)
		if Store.state and plotCF then
			updateVisitors(step, t, Store.state)
		end
	end)
end

return World
