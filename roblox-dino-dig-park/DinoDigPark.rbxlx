      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">DinoFactory</string>
          <string name="Source"><![CDATA[-- DinoFactory.luau : construit un modèle de dinosaure à partir de blocs (serveur + client/Viewport).

local Config = require(script.Parent.Config)
local DinoShapes = require(script.Parent.DinoShapes)
local Economy = require(script.Parent.Economy)

local DinoFactory = {}

local function lighten(c, a)
	return Color3.new(math.min(1, c.R + a), math.min(1, c.G + a), math.min(1, c.B + a))
end
local function darken(c, f)
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local GOLD_BODY = Color3.fromRGB(255, 200, 40)
local GOLD_ACCENT = Color3.fromRGB(255, 140, 30)

function DinoFactory.roleColors(def, golden)
	local body, accent = def.body, def.accent
	if golden then
		body, accent = GOLD_BODY, GOLD_ACCENT
	end
	return {
		body = body,
		belly = lighten(body, 0.25),
		dark = darken(body, 0.65),
		accent = accent,
		eye = Color3.fromRGB(15, 15, 15),
		tooth = Color3.fromRGB(250, 250, 245),
	}
end

-- key : "rex" ou "rex:g". Retourne un Model dont le pivot est au sol, centre de l'origine.
function DinoFactory.build(key, options)
	options = options or {}
	local id, golden = Economy.parseKey(key)
	local def = Config.DinoById[id]
	if not def then
		return nil
	end
	local colors = DinoFactory.roleColors(def, golden)
	local scale = def.scale * (options.scaleMul or 1)
	local material = Enum.Material.SmoothPlastic
	if golden then
		material = Enum.Material.Metal
	elseif def.material and Enum.Material[def.material] then
		material = Enum.Material[def.material]
	end

	local model = Instance.new("Model")
	model.Name = def.name
	model:SetAttribute("DinoKey", key)
	model.WorldPivot = CFrame.new(0, 0, 0)

	local function addPart(spec, sign)
		local part = Instance.new("Part")
		part.Name = spec.role
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Color = colors[spec.role] or colors.body
		if spec.role == "eye" or spec.role == "tooth" then
			part.Material = Enum.Material.SmoothPlastic
		else
			part.Material = material
		end
		if golden and spec.role ~= "eye" and spec.role ~= "tooth" then
			part.Reflectance = 0.15
		end
		part.Size = Vector3.new(spec.size[1] * scale, spec.size[2] * scale, spec.size[3] * scale)
		local pos = Vector3.new(spec.pos[1] * sign * scale, spec.pos[2] * scale, spec.pos[3] * scale)
		local cf = CFrame.new(pos)
		if spec.rot then
			cf = cf * CFrame.Angles(math.rad(spec.rot[1]), math.rad(spec.rot[2] * sign), math.rad(spec.rot[3] * sign))
		end
		part.CFrame = cf
		part.Parent = model
		return part
	end

	for _, spec in ipairs(DinoShapes.get(def.archetype)) do
		addPart(spec, 1)
		if spec.mirror then
			addPart(spec, -1)
		end
	end

	if def.neon or (golden and options.sparkle) then
		local first = model:FindFirstChildWhichIsA("BasePart")
		if first then
			local att = Instance.new("Attachment")
			att.Position = Vector3.new(0, 3 * scale, 0)
			att.Parent = first
			local pe = Instance.new("ParticleEmitter")
			pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			pe.Rate = 4
			pe.Lifetime = NumberRange.new(1, 2)
			pe.Speed = NumberRange.new(1, 3)
			pe.Size = NumberSequence.new(0.6, 0)
			pe.LightEmission = 1
			pe.Color = ColorSequence.new(def.accent)
			pe.Parent = att
		end
	end
	return model
end

return DinoFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">DinoShapes</string>
          <string name="Source"><![CDATA[-- DinoShapes.luau : formes de blocs des dinosaures (données pures, sans API Roblox).
-- Convention : le dino regarde vers -Z (queue vers +Z), pieds à y = 0.
-- Une pièce : { role, {sx,sy,sz}, {px,py,pz}, {rx,ry,rz} | nil, mirror = bool }
-- roles : body, belly, accent, dark, eye, tooth

local S = {}

local function P(role, size, pos, rot, mirror)
	return { role = role, size = size, pos = pos, rot = rot, mirror = mirror or false }
end

S.raptor = {
	P("body", { 1.4, 1.6, 3.0 }, { 0, 2.4, 0 }),
	P("belly", { 1.0, 0.7, 2.6 }, { 0, 1.75, -0.1 }),
	P("body", { 0.9, 1.5, 0.9 }, { 0, 3.5, -1.5 }, { -25, 0, 0 }),
	P("body", { 1.2, 1.1, 1.5 }, { 0, 4.3, -2.2 }),
	P("body", { 0.9, 0.7, 1.2 }, { 0, 4.05, -3.1 }),
	P("tooth", { 0.8, 0.15, 0.9 }, { 0, 3.65, -3.1 }),
	P("eye", { 0.25, 0.25, 0.25 }, { 0.62, 4.6, -2.45 }, nil, true),
	P("accent", { 0.3, 0.7, 1.3 }, { 0, 4.95, -2.1 }),
	P("dark", { 0.6, 1.8, 0.8 }, { 0.6, 0.95, 0.6 }, nil, true),
	P("dark", { 0.7, 0.3, 1.1 }, { 0.6, 0.15, 0.2 }, nil, true),
	P("body", { 0.3, 0.3, 1.0 }, { 0.85, 2.3, -1.5 }, nil, true),
	P("body", { 0.9, 0.9, 1.8 }, { 0, 2.6, 2.3 }),
	P("body", { 0.6, 0.6, 1.8 }, { 0, 2.6, 4.0 }),
	P("accent", { 0.25, 0.5, 0.6 }, { 0, 3.4, 0.4 }),
	P("accent", { 0.25, 0.5, 0.6 }, { 0, 3.4, -0.8 }),
}

S.trex = {
	P("body", { 2.4, 2.6, 4.2 }, { 0, 4.3, 0 }),
	P("belly", { 1.8, 1.0, 3.6 }, { 0, 3.2, -0.1 }),
	P("body", { 1.6, 1.8, 1.4 }, { 0, 5.4, -2.5 }, { -20, 0, 0 }),
	P("body", { 2.0, 1.8, 2.2 }, { 0, 6.3, -3.9 }),
	P("body", { 1.6, 0.9, 1.8 }, { 0, 5.9, -5.3 }),
	P("tooth", { 1.5, 0.25, 1.6 }, { 0, 5.4, -5.3 }),
	P("eye", { 0.3, 0.3, 0.3 }, { 1.03, 6.8, -4.4 }, nil, true),
	P("dark", { 1.0, 3.2, 1.4 }, { 1.2, 1.7, 0.7 }, nil, true),
	P("body", { 1.2, 2.0, 2.0 }, { 1.35, 3.2, 0.6 }, nil, true),
	P("dark", { 1.1, 0.4, 1.8 }, { 1.2, 0.2, 0.1 }, nil, true),
	P("body", { 0.4, 0.4, 1.0 }, { 1.3, 4.2, -2.4 }, nil, true),
	P("body", { 1.7, 1.6, 2.4 }, { 0, 4.2, 3.2 }),
	P("body", { 1.2, 1.1, 2.4 }, { 0, 4.0, 5.4 }),
	P("body", { 0.7, 0.7, 1.8 }, { 0, 3.9, 7.2 }),
	P("accent", { 2.5, 0.3, 0.6 }, { 0, 5.65, 0.6 }),
	P("accent", { 2.5, 0.3, 0.6 }, { 0, 5.65, -0.9 }),
	P("accent", { 1.8, 0.3, 0.6 }, { 0, 5.35, 3.4 }),
}

S.tricera = {
	P("body", { 2.0, 2.2, 4.4 }, { 0, 2.9, 0 }),
	P("belly", { 1.6, 0.8, 3.8 }, { 0, 2.0, 0 }),
	P("dark", { 0.8, 1.8, 0.9 }, { 0.8, 0.9, -1.6 }, nil, true),
	P("dark", { 0.8, 1.8, 0.9 }, { 0.8, 0.9, 1.6 }, nil, true),
	P("body", { 1.6, 1.6, 1.8 }, { 0, 3.2, -3.0 }),
	P("accent", { 0.8, 0.6, 0.8 }, { 0, 2.8, -4.2 }),
	P("accent", { 3.4, 3.0, 0.4 }, { 0, 4.0, -2.0 }, { -15, 0, 0 }),
	P("body", { 2.6, 2.2, 0.25 }, { 0, 4.0, -2.2 }, { -15, 0, 0 }),
	P("tooth", { 0.3, 0.3, 1.4 }, { 0.55, 3.8, -4.1 }, { -20, 0, 0 }, true),
	P("tooth", { 0.3, 0.3, 0.9 }, { 0, 3.3, -4.4 }),
	P("eye", { 0.25, 0.25, 0.25 }, { 0.82, 3.45, -3.5 }, nil, true),
	P("body", { 0.8, 0.8, 1.8 }, { 0, 2.6, 2.9 }),
	P("body", { 0.5, 0.5, 1.2 }, { 0, 2.5, 4.2 }),
}

S.stego = {
	P("body", { 1.8, 2.0, 4.6 }, { 0, 3.0, 0 }),
	P("belly", { 1.5, 0.7, 4.0 }, { 0, 2.1, 0 }),
	P("dark", { 0.7, 1.6, 0.8 }, { 0.7, 0.8, -1.5 }, nil, true),
	P("dark", { 0.8, 2.0, 1.0 }, { 0.7, 1.0, 1.8 }, nil, true),
	P("body", { 0.9, 0.9, 1.0 }, { 0, 2.6, -2.8 }),
	P("body", { 0.9, 0.8, 1.4 }, { 0, 2.3, -3.6 }),
	P("eye", { 0.2, 0.2, 0.2 }, { 0.47, 2.5, -3.9 }, nil, true),
	P("accent", { 0.3, 1.6, 1.0 }, { 0, 4.6, -1.2 }),
	P("accent", { 0.3, 2.0, 1.1 }, { 0, 4.8, 0 }),
	P("accent", { 0.3, 2.0, 1.1 }, { 0, 4.7, 1.2 }),
	P("accent", { 0.3, 1.5, 1.0 }, { 0, 4.3, 2.4 }),
	P("body", { 0.9, 0.9, 2.0 }, { 0, 2.7, 3.5 }),
	P("body", { 0.6, 0.6, 1.8 }, { 0, 2.5, 5.0 }),
	P("tooth", { 0.2, 0.8, 0.2 }, { 0.3, 3.0, 5.9 }, nil, true),
}

S.bronto = {
	P("body", { 2.4, 2.4, 4.6 }, { 0, 4.2, 0 }),
	P("belly", { 2.0, 0.8, 4.0 }, { 0, 3.2, 0 }),
	P("dark", { 1.0, 3.0, 1.1 }, { 1.0, 1.5, -1.6 }, nil, true),
	P("dark", { 1.0, 3.0, 1.1 }, { 1.0, 1.5, 1.6 }, nil, true),
	P("body", { 1.2, 1.6, 1.4 }, { 0, 5.7, -2.4 }, { -20, 0, 0 }),
	P("body", { 1.0, 1.6, 1.1 }, { 0, 7.2, -3.0 }, { -10, 0, 0 }),
	P("body", { 0.9, 1.6, 1.0 }, { 0, 8.8, -3.4 }),
	P("body", { 1.1, 1.0, 1.6 }, { 0, 10.0, -3.9 }),
	P("eye", { 0.22, 0.22, 0.22 }, { 0.58, 10.25, -4.3 }, nil, true),
	P("tooth", { 0.7, 0.1, 0.8 }, { 0, 9.55, -4.2 }),
	P("body", { 1.4, 1.2, 2.6 }, { 0, 3.9, 3.6 }),
	P("body", { 0.9, 0.8, 2.4 }, { 0, 3.5, 5.8 }),
	P("body", { 0.5, 0.5, 2.0 }, { 0, 3.2, 7.6 }),
	P("accent", { 2.5, 0.3, 0.7 }, { 0, 5.55, 0.5 }),
	P("accent", { 2.5, 0.3, 0.7 }, { 0, 5.55, -1.0 }),
}

S.ptero = {
	P("body", { 1.2, 1.2, 3.0 }, { 0, 5, 0 }),
	P("belly", { 0.9, 0.5, 2.4 }, { 0, 4.4, 0 }),
	P("body", { 0.9, 0.9, 1.2 }, { 0, 5.4, -2.2 }),
	P("accent", { 0.35, 0.35, 2.4 }, { 0, 5.2, -3.9 }),
	P("accent", { 0.25, 1.4, 1.6 }, { 0, 6.0, -1.5 }),
	P("eye", { 0.2, 0.2, 0.2 }, { 0.47, 5.6, -2.5 }, nil, true),
	P("body", { 5.0, 0.2, 2.2 }, { 3.6, 5.2, 0.3 }, { 0, 0, 12 }, true),
	P("accent", { 3.0, 0.15, 1.4 }, { 7.0, 5.7, 0.6 }, { 0, 0, 18 }, true),
	P("body", { 0.5, 0.5, 1.6 }, { 0, 4.9, 2.2 }),
	P("dark", { 0.2, 0.9, 0.2 }, { 0.4, 4.0, 0.4 }, nil, true),
}

S.ankylo = {
	P("body", { 2.8, 1.8, 4.4 }, { 0, 2.2, 0 }),
	P("belly", { 2.4, 0.7, 3.8 }, { 0, 1.4, 0 }),
	P("dark", { 0.9, 1.2, 1.0 }, { 1.1, 0.6, -1.5 }, nil, true),
	P("dark", { 0.9, 1.2, 1.0 }, { 1.1, 0.6, 1.5 }, nil, true),
	P("body", { 1.6, 1.2, 1.6 }, { 0, 2.3, -3.0 }),
	P("accent", { 1.1, 0.7, 0.9 }, { 0, 2.0, -4.0 }),
	P("eye", { 0.25, 0.25, 0.25 }, { 0.82, 2.6, -3.4 }, nil, true),
	P("accent", { 0.9, 0.5, 0.9 }, { 0.8, 3.3, -1.2 }, nil, true),
	P("accent", { 0.9, 0.5, 0.9 }, { 0.8, 3.3, 0.2 }, nil, true),
	P("accent", { 0.9, 0.5, 0.9 }, { 0.8, 3.3, 1.5 }, nil, true),
	P("accent", { 0.9, 0.5, 0.9 }, { 0, 3.3, -0.5 }),
	P("accent", { 0.9, 0.5, 0.9 }, { 0, 3.3, 0.9 }),
	P("tooth", { 0.4, 0.4, 0.9 }, { 1.6, 2.6, -1.0 }, nil, true),
	P("body", { 1.0, 1.0, 2.4 }, { 0, 1.8, 3.4 }),
	P("accent", { 1.8, 1.2, 1.4 }, { 0, 1.8, 5.3 }),
}

-- Variantes qui étendent une forme de base : { extends = "...", parts = {...} }
S.spino = {
	extends = "trex",
	parts = {
		P("accent", { 0.3, 2.2, 3.0 }, { 0, 6.6, 0.2 }),
		P("accent", { 0.3, 1.6, 1.4 }, { 0, 6.3, 2.5 }),
		P("body", { 1.0, 0.9, 1.8 }, { 0, 5.9, -6.7 }),
	},
}
S.dilopho = {
	extends = "raptor",
	parts = {
		P("accent", { 2.2, 1.6, 0.25 }, { 0, 4.7, -2.0 }, { -10, 0, 0 }),
		P("accent", { 0.3, 0.8, 1.2 }, { 0.35, 5.2, -2.4 }, nil, true),
	},
}
S.carno = {
	extends = "trex",
	parts = {
		P("tooth", { 0.3, 0.9, 0.3 }, { 0.7, 7.5, -3.9 }, nil, true),
		P("accent", { 2.0, 0.3, 0.5 }, { 0, 7.1, -4.4 }),
	},
}

-- Résout les "extends" et retourne la liste de pièces
function S.get(name)
	local shape = S[name]
	if shape == nil then
		return {}
	end
	if shape.extends then
		local out = {}
		for _, p in ipairs(S[shape.extends]) do
			table.insert(out, p)
		end
		for _, p in ipairs(shape.parts) do
			table.insert(out, p)
		end
		return out
	end
	return shape
end

return S
]]></string>
