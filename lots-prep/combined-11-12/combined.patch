+--!nocheck
+-- Tests du LOT 12 PARTIE A (moteur de combat PvE refait : Battle.lua, 9 types, charge/spécial, STATS, niveaux, tour de 45 étages).
+-- Forme : `return function(env) ... end`, env = { check, suite, luau, fs } fournis par tests/run_lot12a.py (lupa) ou par tests/run.luau (Lune).
+-- Aucune dépendance Roblox. Style : pas de `+=`, pas de `continue` (compatibilité lupa).
+local function loadBattle(luau, fs)
+	local color = { fromRGB = function(r, g, b) return { R = r / 255, G = g / 255, B = b / 255 } end }
+	local function mod(path, name, environment)
+		return luau.load(fs.readFile("roblox/src/ReplicatedStorage/" .. path), { debugName = name, environment = environment })()
+	end
+	local mods = { Bestiary = mod("Bestiary.lua", "Bestiary", { Color3 = color }), PetXp = mod("PetXp.lua", "PetXp") }
+	return mod("Battle.lua", "Battle", { script = { Parent = { WaitForChild = function(_, n) return n end } }, require = function(n) return mods[n] end }), mods.PetXp, mods.Bestiary
+end
+return function(env)
+	local check, suite, luau, fs = env.check, env.suite, env.luau, env.fs
+	local B, PetXp, Bestiary = loadBattle(luau, fs)
+	local TypeFx = luau.load(fs.readFile("roblox/src/ReplicatedStorage/TypeFx.lua"), { debugName = "TypeFx" })()
+	local Config = luau.load(fs.readFile("roblox/src/ReplicatedStorage/Config.lua"), {
+		debugName = "Config",
+		-- FUSION 11+12 : Config complet (78 espèces via Bestiary), comme dans le jeu
+		environment = { Color3 = { fromRGB = function(r, g, b) return { R = r / 255, G = g / 255, B = b / 255 } end }, script = { Parent = { WaitForChild = function(_, n) return n end } }, require = function() return Bestiary end },
+	})()
+	local SKILL_KEYS = { "strike", "drain", "heal", "guard", "stun", "focus", "freeze", "chain", "bulwark" }
+
+	-- générateur de test indépendant du moteur (même Park-Miller 48271)
+	local function mkRng(seed)
+		local s = seed
+		return function()
+			s = (s * 48271) % 2147483647
+			return s / 2147483647
+		end
+	end
+
+	local function unit(ty, skill, o)
+		o = o or {}
+		return B.rawUnit({ type = ty, skill = skill, tier = o.tier or 3, level = o.level, scale = o.scale, size = o.size, mut = o.mut, p = o.p })
+	end
+	local function same(a, b)
+		if type(a) ~= type(b) then
+			return false
+		end
+		if type(a) ~= "table" then
+			return a == b
+		end
+		for k, v in pairs(a) do
+			if not same(v, b[k]) then
+				return false
+			end
+		end
+		for k in pairs(b) do
+			if a[k] == nil then
+				return false
+			end
+		end
+		return true
+	end
