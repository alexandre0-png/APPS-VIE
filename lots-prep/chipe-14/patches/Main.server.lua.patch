+		notify(s.player, "⚔️ Compose d'abord une équipe de pets.", "refuse")
+	elseif why == "busy" then
+		notify(s.player, "⚔️ Termine d'abord ce que tu fais (combat, œuf porté, château).", "refuse")
+	end
+end
