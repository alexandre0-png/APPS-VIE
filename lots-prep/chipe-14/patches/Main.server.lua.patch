+function actions.liveQueue(s)
+	local ok, why = Lot7.Live.enqueue(s, { busy = s.battle ~= nil or s.castle ~= nil or s.pvpPending == true or #s.carry > 0, serverMode = serverMode, party = serverPartyId })
+	if ok then
