	{ title = "Le murmure des runes", text = "Les runes du Grand Nid s'éveillent chaque jour. Lis l'énigme de Mère Poule (Missions > Énigme), tourne les 4 runes autour du Nid, puis touche le Nid pour valider.", type = "puzzle", goal = 1, coins = 15000, mins = 12 },
	{ title = "Chipeur confirmé", text = "Ta réputation grandit. Chipe 15 œufs au total, chez les rivaux ou chez d'autres Chipeurs.", type = "steal", goal = 15, coins = 25000, mins = 15 },
	{ title = "Le Roi Zed", text = "Zed garde les meilleurs œufs, dont les Cosmiques. Son ours ne rigole pas. Chipe 8 œufs dans sa citadelle.", type = "steal", goal = 8, rival = 3, coins = 60000, mins = 20 },
	{ title = "Légende vivante", text = "Fais éclore un pet Mythique : l'œuf du Dragon n'est plus loin.", type = "tier", goal = 1, tier = 5, coins = 150000, mins = 30 },
	{ title = "Le Grand Nid s'éveille", text = "Le Nid est prêt à renaître. Renais une fois pour le reconstruire, plus fort, et deviens Roi des Couvées !", type = "rebirth", goal = 1, coins = 300000, mins = 45 },
}

Config.COLLECTION_STEP = 3 -- tous les 3 espèces découvertes...
Config.COLLECTION_BONUS = 0.05 -- ...+5% de revenus permanents (max +30% avec les 18 espèces)
Config.PITY_ENABLED = false -- la pitié (amélioration garantie) est coupée : l'œuf annoncé fixe la rareté, avec UNE seule exception affichée (Config.UPGRADE)
Config.PITY_EVERY = 12 -- (si la pitié est activée) toutes les 12 éclosions sans amélioration, la suivante l'est garantie
-- Amélioration d'un cran de rareté (seule exception à « l'œuf annoncé = la rareté du pet ») : 5 % de base, +1 point par niveau de Trèfle, +10 avec le pass Chance,
-- +5 en événement chance, +25 avec la potion ; signalée « AMÉLIORÉ ! » à la révélation. Plafond : Rules.MAX_UP.
Config.UPGRADE = { base = 5, event = 5, pass = 10 }

function Config.rankFor(chaptersDone)
	local best = Config.RANKS[1]
	for _, r in ipairs(Config.RANKS) do
		if chaptersDone >= r.chapter then
			best = r
		end
	end
	return best
end

function Config.collectionBonus(speciesCount)
	return 1 + Config.COLLECTION_BONUS * math.floor(speciesCount / Config.COLLECTION_STEP)
end

function Config.zoneUnlocked(chaptersDone, rival)
	local z = Config.ZONES[rival]
	return z ~= nil and chaptersDone >= z.chapter
end

-- Texte de l'objectif d'un chapitre.
function Config.storyGoalText(c)
	local rival = c.rival and (" chez " .. Config.RIVALS[c.rival].name) or ""
	if c.type == "hatch" then
		return "Faire éclore " .. c.goal .. " œuf(s)"
	elseif c.type == "steal" then
		return "Chiper " .. c.goal .. " œuf(s)" .. rival
	elseif c.type == "train" then
		return "Courir " .. c.goal .. " secondes sur le tapis roulant"
	elseif c.type == "species" then
		return "Découvrir " .. c.goal .. " espèces différentes"
	elseif c.type == "tier" then
		return "Obtenir un pet " .. Config.TIERS[c.tier].name .. " ou mieux"
	elseif c.type == "mut" then
		return "Obtenir un pet muté"
	elseif c.type == "puzzle" then
		return "Résoudre l'énigme des runes"
	elseif c.type == "rebirth" then
		return "Renaître " .. c.goal .. " fois"
	end
	return c.type
end

-- Réglages d'interface (chaque ajout se coupe ici).
-- Effets 3D : qualité imposée (« high », « medium », « low ») ou nil = automatique (Bas sur tactile, Élevé sinon).
Config.VFX = { quality = nil }

-- Masquage des zones éloignées (client, sans StreamingEnabled) : masquées au-delà de cullAt studs du bord d'un domaine, réaffichées sous showAt.
Config.Culling = { enabled = true, cullAt = 170, showAt = 140, interval = 1, batch = 150, refresh = 20 }

-- Diagnostic des modèles Blender : petit « Blender N/M » en bas à gauche (hub et partie) et rapport complet par F3. À repasser à false après le test.
Config.Debug = { AssetReport = true }

Config.HUD = {
	debugStats = false, -- compteur FPS / ping / Parts affiché en haut (F3 l'affiche ou le masque en jeu)
	objective = true, -- carte « objectif en cours » (chapitre de l'histoire) sous les compteurs
	shortcuts = true, -- manette (X boutique, Y missions, Select Plus, B fermer) et clavier (B, Q, O) pour les menus
}

-- Objectif affiché en permanence : chapitre en cours de l'histoire (nil si l'histoire est terminée).
-- st = { ch = chapitres réussis, prog = progression du chapitre en cours }.
function Config.objective(st)
	local c = Config.STORY[(st.ch or 0) + 1]
	if not c then
		return nil
	end
	local prog = math.min(math.max(st.prog or 0, 0), c.goal)
	return { index = (st.ch or 0) + 1, total = #Config.STORY, title = c.title, text = Config.storyGoalText(c), prog = prog, goal = c.goal, done = prog >= c.goal }
end

-- Récompense de pièces d'un chapitre pour un revenu donné (par seconde).
function Config.storyReward(chapter, income)
	return math.floor(math.max(chapter.coins, income * chapter.mins * 60))
end

---------------------------------------------------------------- Énigmes des runes (Grand Nid)
-- Quatre runes autour du monument (Nord, Est, Sud, Ouest). Chaque jour, Mère Poule énonce un indice par direction ; le joueur doit
-- régler chaque rune sur le bon symbole puis valider en touchant le Grand Nid. L'énigme est la même pour tous les joueurs un jour donné.
Config.RUNES = { "🔥", "🌊", "🌿", "⭐" }
Config.RUNE_DIRECTIONS = { "Nord", "Est", "Sud", "Ouest" }
Config.RUNE_LOCK_SECONDS = 6 -- pause après une mauvaise combinaison (empêche d'essayer au hasard en boucle)
Config.PUZZLE_EGG_TIER = 3 -- récompense : un œuf Épique (ou son prix en pièces si la base est pleine)
Config.PUZZLE_MINS = 10 -- + pièces : max(2000, 10 minutes de revenus)

local RUNE_CLUES = {
	{ "ce qui danse et brûle", "la flamme qui crépite", "ce qui réchauffe et consume" },
	{ "ce qui coule et berce", "la vague qui murmure", "ce qui désaltère les rivières" },
	{ "ce qui pousse vers la lumière", "la feuille qui respire", "ce qui plonge ses racines" },
	{ "ce qui brille quand tout dort", "la lumière lointaine", "ce qui guide les voyageurs" },
}
local DIR_PREFIX = { "Au Nord", "À l'Est", "Au Sud", "À l'Ouest" }

-- Générateur pseudo-aléatoire déterministe (Park-Miller : les produits restent exacts en double précision).
local function dayRng(seed)
	local x = (seed * 7919 + 104729) % 2147483646 + 1
	local function raw()
		x = (x * 16807) % 2147483647
		return x
	end
	raw()
	raw()
	raw()
	return function(n)
		return raw() % n + 1
	end
end

-- Énigme d'un jour (day = os.time() // 86400). Retourne { answer = {symbole du Nord, de l'Est, du Sud, de l'Ouest}, text = énoncé }.
function Config.riddleFor(day)
	local r = dayRng(day)
	local order = { 1, 2, 3, 4 }
	for i = 4, 2, -1 do
		local j = r(i)
		order[i], order[j] = order[j], order[i]
	end
	local parts = {}
	for dir = 1, 4 do
		local clues = RUNE_CLUES[order[dir]]
		parts[dir] = DIR_PREFIX[dir] .. " : " .. clues[r(#clues)] .. "."
	end
	return { answer = order, text = table.concat(parts, " ") }
end

function Config.puzzleCoins(income)
	return math.floor(math.max(2000, income * Config.PUZZLE_MINS * 60))
end

---------------------------------------------------------------- Succès à paliers (récompenses permanentes de progression)
-- stat : hatched | stolen | species | rb | puzzles. goals : seuils des paliers successifs.
Config.ACHIEVEMENTS = {
	{ id = "hatched", name = "Éleveur", emoji = "🐣", stat = "hatched", unit = "œufs éclos", goals = { 10, 50, 250, 1000 } },
	{ id = "stolen", name = "Chipeur", emoji = "🧤", stat = "stolen", unit = "œufs chipés", goals = { 10, 50, 200, 800 } },
	{ id = "species", name = "Collectionneur", emoji = "📚", stat = "species", unit = "espèces découvertes", goals = { 3, 6, 12, 18 } },
	{ id = "rebirth", name = "Renaissant", emoji = "🌅", stat = "rb", unit = "renaissances", goals = { 1, 2, 4, 8 } },
	{ id = "puzzle", name = "Déchiffreur", emoji = "🔮", stat = "puzzles", unit = "énigmes résolues", goals = { 1, 5, 15, 40 } },
}
Config.ACH_REWARD = { coins = { 500, 5000, 50000, 500000 }, mins = { 1, 5, 20, 60 } }

function Config.achievement(id)
	for _, a in ipairs(Config.ACHIEVEMENTS) do
		if a.id == id then
			return a
		end
	end
	return nil
end

-- Récompense du palier `tier` (1..4) : max(pièces fixes, revenus de `mins` minutes).
function Config.achReward(tier, income)
	return math.floor(math.max(Config.ACH_REWARD.coins[tier], income * Config.ACH_REWARD.mins[tier] * 60))
end

-- Probabilités affichées dans le jeu (transparence sur les tirages aléatoires, exigée par Roblox pour les achats Robux liés au hasard)
-- Probabilités de base par œuf : « Épique : 95 % Épique, 5 % Légendaire ».
function Config.eggOddsText()
	local out = {}
	for i, t in ipairs(Config.TIERS) do
		if i < #Config.TIERS then
			out[#out + 1] = string.format("%s : %d%% %s, %d%% %s", t.name, 100 - Config.UPGRADE.base, t.name, Config.UPGRADE.base, Config.TIERS[i + 1].name)
		else
			out[#out + 1] = string.format("%s : 100%% %s", t.name, t.name)
		end
	end
	return table.concat(out, " · ") .. "."
end

function Config.oddsText()
	local function pct(list, none)
		local total = 0
		for _, x in ipairs(list) do
			total += x.weight
		end
		local out = {}
		for _, x in ipairs(list) do
			out[#out + 1] = string.format("%s %.1f%%", x.name == "" and none or x.name, x.weight / total * 100)
		end
		return table.concat(out, " · ")
	end
	return "🎲 Probabilités de base. L'œuf annoncé fixe la rareté du pet. Seule exception : " .. Config.UPGRADE.base .. "% de chances d'une amélioration d'un cran, signalée « AMÉLIORÉ ! » (Trèfle, événements, Pass Chance et Potion augmentent cette part, plafonnée à 70%). Jamais de rareté inférieure. Par œuf : " .. Config.eggOddsText() .. " Mutations : "
		.. pct(Config.MUTS, "Aucune") .. " (le Biome Alien multiplie la mutation Alien par 5). Tailles : " .. pct(Config.SIZES, "Normal") .. "."
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Easing</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Easing
-- Fonctions d'animation PURES (aucun service Roblox, aucun Instance) : courbes, squash & stretch, rebonds, clignements, regards,
-- paramètres de confettis et garde-fou d'exécution. Testées hors de Roblox (tests/run.luau). Le client (Animations.client.lua)
-- ne fait qu'appliquer ces valeurs aux objets.
local Easing = {}

local pi, sin, cos, exp, abs, floor, sqrt = math.pi, math.sin, math.cos, math.exp, math.abs, math.floor, math.sqrt

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end
Easing.clamp01 = clamp01

local function frac(x)
	return x - floor(x)
end

-- Direction de déplacement unitaire (dx, dz) d'un objet qui a parcouru (dx, dz) en dt secondes, ou nil s'il va plus lentement que minSpeed (studs/s) : il garde
-- alors son orientation. Sert à tourner les pets suiveurs vers leur direction de marche.
function Easing.travelDir(dx, dz, dt, minSpeed)
	if type(dx) ~= "number" or type(dz) ~= "number" or type(dt) ~= "number" or dt <= 0 or dx ~= dx or dz ~= dz then
		return nil
	end
	local d = sqrt(dx * dx + dz * dz)
	if d / dt < (minSpeed or 1.5) or d < 1e-9 then
		return nil
	end
	return dx / d, dz / d
end

function Easing.lerp(a, b, t)
	return a + (b - a) * t
end

-- Animations d'interface -------------------------------------------------------------------------------------------------------
-- Compteur qui défile : rapproche `shown` de `target` (approche exponentielle, jamais de dépassement, arrêt exact). dt en secondes.
function Easing.rollTo(shown, target, dt)
	if type(shown) ~= "number" or shown ~= shown then
		return type(target) == "number" and target == target and target or 0
	end
	if type(target) ~= "number" or target ~= target then
		return shown
	end
	local diff = target - shown
	if math.abs(diff) <= math.max(1, math.abs(target) * 0.0005) then
		return target
	end
	local k = 1 - exp(-(dt or 1 / 30) * 9)
	local nextValue = shown + diff * k
	if (diff > 0 and nextValue > target) or (diff < 0 and nextValue < target) then
		return target
	end
	return nextValue
end

-- Balayage de brillance : position horizontale (fraction de la largeur, de -0,25 à 1,25) à la progression p.
function Easing.shineX(p)
	p = clamp01(p)
	return -0.25 + 1.5 * (1 - (1 - p) * (1 - p))
end

-- Pulsation unique (montée rapide, descente douce) : 0 -> 1 -> 0 sur p dans [0, 1].
function Easing.pulse(p)
	p = clamp01(p)
	if p < 0.2 then
		return 1 - (1 - p / 0.2) ^ 2
	end
	local e = (p - 0.2) / 0.8
	return (1 - e) ^ 2
end

-- Courbes classiques (entrée et sortie dans [0, 1]) ---------------------------------------------------------------
function Easing.inOutSine(x)
	x = clamp01(x)
	return -(cos(pi * x) - 1) / 2
end

function Easing.outQuad(x)
	x = clamp01(x)
	return 1 - (1 - x) * (1 - x)
end

function Easing.outBack(x)
	x = clamp01(x)
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

function Easing.outElastic(x)
	x = clamp01(x)
	if x == 0 or x == 1 then
		return x
	end
	return 2 ^ (-10 * x) * sin((x * 10 - 0.75) * (2 * pi) / 3) + 1
end

function Easing.outBounce(x)
	x = clamp01(x)
	local n1, d1 = 7.5625, 2.75
	if x < 1 / d1 then
		return n1 * x * x
	elseif x < 2 / d1 then
		x = x - 1.5 / d1
		return n1 * x * x + 0.75
	elseif x < 2.5 / d1 then
		x = x - 2.25 / d1
		return n1 * x * x + 0.9375
	end
	x = x - 2.625 / d1
	return n1 * x * x + 0.984375
end

-- Squash & stretch : au temps t (0 -> 1), retourne (sx, sy) à appliquer en largeur et en hauteur.
-- Part écrasé (sy < 1, sx > 1), puis s'étire, puis oscille de moins en moins jusqu'à (1, 1). Toujours strictement positif.
function Easing.squashStretch(t, strength)
	if t >= 1 then
		return 1, 1
	end
	if t < 0 then
		t = 0
	end
	local amp = (strength or 0.4) * exp(-5 * t) * cos(14 * t)
	return math.max(0.2, 1 + amp * 0.6), math.max(0.2, 1 - amp)
end

-- Petit saut d'un œuf toutes les `period` secondes. Retourne (décalage vertical >= 0, sx, sy).
-- Étirement en l'air, écrasement à l'atterrissage ; hors du saut : (0, 1, 1).
function Easing.eggHop(time, phase, height, period)
	period = period or 3.2
	height = height or 0.6
	local u = ((time + (phase or 0)) % period) / 0.6 -- le saut dure 0,6 s
	if u >= 1 then
		return 0, 1, 1
	end
	local y = height * sin(u * pi)
	local sy = 1 + 0.15 * sin(u * pi)
	if u > 0.85 then
		sy = 1 - 0.12 * sin((u - 0.85) / 0.15 * pi)
	end
	return y, 1 / sqrt(sy), sy
end

-- Balancement d'un œuf porté pendant la course (décalage vertical >= 0).
function Easing.runBounce(time, moving)
	if not moving then
		return 0
	end
	return 0.25 * abs(sin(time * 8))
end

-- Clignement : 1 = œil ouvert, 0 = fermé. Bref (0,16 s) à intervalle irrégulier propre à chaque `seed`.
function Easing.blinkOpenness(time, seed)
	seed = seed or 0
	local period = 2.6 + (seed % 7) * 0.37
	local ph = (time + seed * 0.53) % period
	local d = 0.16
	if ph < d then
		return clamp01(1 - sin(ph / d * pi)) -- bornée : sin(pi) vaut ±1e-16 selon le moteur
	end
	return 1
end

-- Regard : décalage (dx, dy) des yeux, dx dans [-0.85, 0.85], dy dans [-0.3, 0.3].
function Easing.look(time, seed)
	seed = seed or 0
	local dx = sin(time * 0.7 + seed) * 0.6 + sin(time * 1.9 + seed * 2) * 0.25
	local dy = sin(time * 0.5 + seed * 3) * 0.3
	return dx, dy
end

-- Bouche : ouverture dans [0, 1] ; elle « mâche » brièvement de temps en temps.
function Easing.mouthOpen(time, seed)
	seed = seed or 0
	local period = 4 + (seed % 5) * 0.6
	local ph = (time + seed * 0.9) % period
	if ph < 0.7 then
		return sin(ph / 0.7 * pi)
	end
	return 0
end

-- Poule : coups de bec doubles à intervalle irrégulier. Retourne l'enfoncement de la tête dans [0, 1].
function Easing.peck(time, seed)
	seed = seed or 0
	local period = 3.4 + (seed % 5) * 0.5
	local ph = (time + seed * 0.7) % period
	if ph < 0.25 then
		return clamp01(sin(ph / 0.25 * pi))
	elseif ph < 0.5 then
		return clamp01(sin((ph - 0.25) / 0.25 * pi))
	end
	return 0
end

-- Pulsation d'une barrière de zone, dans [0, 1].
-- Échelle du pet qui apparaît à l'éclosion (a = progression 0..1) : part de 25 %, ne dépasse jamais `cap` et vaut exactement 1 à la fin.
function Easing.popScale(a, squash, cap)
	cap = cap or 1.15
	if a >= 1 then
		return 1
	end
	local scale
	if squash then
		local _, sy = Easing.squashStretch(a, 0.45)
		scale = (0.25 + 0.75 * Easing.outQuad(math.min(1, a * 1.8))) * sy
	else
		scale = 0.25 + 0.75 * Easing.outBack(a)
	end
	return math.min(cap, math.max(0.05, scale))
end

-- États des pets : idle (respiration), move (bonds penchés vers l'avant), ability (saut en vrille). Retourne { y, pitch, yaw, scale } ;
-- state "ability" attend p = progression 0..1 de la capacité (Easing.abilityProgress). Toutes les valeurs sont bornées.
function Easing.petPose(state, t, seed, p)
	seed = seed or 0
	if state == "move" then
		return { y = abs(sin(t * 9 + seed)) * 0.7, pitch = -0.18, yaw = sin(t * 9 + seed) * 0.08, scale = 1 }
	elseif state == "ability" then
		local q = clamp01(p or 0)
		return { y = sin(q * pi) * 1.8, pitch = 0, yaw = q * 2 * pi, scale = 1 + 0.25 * sin(q * pi) }
	end
	return { y = sin(t * 3 + seed) * 0.25, pitch = 0, yaw = sin(t * 0.8 + seed) * 0.12, scale = 1 }
end

-- Progression 0..1 de la capacité d'un pet (durée `window` s toutes les `interval` s environ, décalée par seed), nil hors capacité.
function Easing.abilityProgress(t, seed, interval, window)
	window = window or 1.1
	local period = (interval or 9) + ((seed or 0) % 5)
	if period <= window then
		return nil
	end
	local phase = (t + (seed or 0) * 1.3) % period
	if phase < window then
		return phase / window
	end
	return nil
end

function Easing.gatePulse(time, speed)
	return 0.5 + 0.5 * sin(time * (speed or 2))
end

-- Récompenses : effets de confettis selon la clé de son envoyée avec la notification serveur. nil = pas de confettis.
Easing.REWARD = {
	claim = { count = 24, minSpeed = 160, maxSpeed = 340, life = 1.3 },
	event = { count = 40, minSpeed = 180, maxSpeed = 380, life = 1.5 },
	rare = { count = 70, minSpeed = 200, maxSpeed = 440, life = 1.7 },
}
function Easing.rewardBurst(sfx)
	return Easing.REWARD[sfx]
end

-- Secousse de caméra (champ de vision) selon la clé de son : delta en degrés, durée d'un aller en secondes.
Easing.FOV_KICK = {
	steal = { delta = 5, time = 0.14 },
	caught = { delta = -8, time = 0.2 },
}

-- Particule `i` d'une salve de `count` confettis : éventail vers le haut, déterministe (suite de la section d'or).
-- Retourne { angle (radians, 0 = droite, -pi/2 = haut), speed, spin (degrés/s), hue [0,1), w, h (pixels) }.
function Easing.confettiParticle(i, count, burst)
	local minSpeed, maxSpeed = burst.minSpeed, burst.maxSpeed
	return {
		angle = -pi / 2 + (frac(i * 0.6180339887) - 0.5) * 1.8,
		speed = minSpeed + frac(i * 0.7548776662) * (maxSpeed - minSpeed),
		spin = (frac(i * 0.5698402910) - 0.5) * 720,
		hue = frac(i * 0.3819660113 + count * 0.01),
		w = 6 + floor(frac(i * 0.2599) * 7),
		h = 10 + floor(frac(i * 0.4143) * 9),
	}
end

-- Garde-fou d'une animation. isEnabled(name) -> bool ; failed : table partagée name -> true ; fn : l'animation (appelée sous pcall).
-- Une animation désactivée n'est pas exécutée. Une animation qui lève une erreur est désactivée pour le reste de la session
-- (onError(name, err) est appelé une seule fois). Retourne true si fn s'est exécutée sans erreur.
function Easing.guard(isEnabled, failed, name, fn, onError)
	if failed[name] or not isEnabled(name) then
		return false
	end
	local ok, err = pcall(fn)
	if not ok then
		failed[name] = true
		if onError then
			onError(name, err)
		end
	end
	return ok
end

return Easing
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Cinema</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Cinema
-- Logique PURE des cinématiques (aucun service Roblox, aucune Instance) : séquences de plans, lecteur à états (lecture, skip, abandon,
-- reprise), interpolation de caméra, directeur qui enchaîne une file. Easing est injecté : require(Cinema).new(Easing).
-- Le client (Cinematics.client.lua) ne fait qu'appliquer ces valeurs à la caméra.
local Cinema = {}

function Cinema.new(Easing)
	local C = {}

	-- Construit une séquence à partir de { id, shots = { { dur = secondes, ... }, ... } }.
	-- Retourne nil et un message si la définition est invalide (aucun plan, durée <= 0).
	function C.sequence(def)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucun plan"
		end
		local starts, t = {}, 0
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur <= 0 then
				return nil, "durée invalide (plan " .. i .. ")"
			end
			starts[i] = t
			t = t + shot.dur
		end
		return { id = def.id, shots = def.shots, starts = starts, total = t }
	end

	-- Plan actif à l'instant t (secondes depuis le début) : (index, progression dans [0, 1[), ou nil si la séquence est terminée.
	-- Un temps négatif est ramené à 0.
	function C.shotAt(seq, t)
		if t < 0 then
			t = 0
		end
		if t >= seq.total then
			return nil
		end
		for i = #seq.shots, 1, -1 do
			if t >= seq.starts[i] then
				return i, (t - seq.starts[i]) / seq.shots[i].dur
			end
		end
		return 1, 0
	end

	local function lerp3(a, b, e)
		return { a[1] + (b[1] - a[1]) * e, a[2] + (b[2] - a[2]) * e, a[3] + (b[3] - a[3]) * e }
	end

	-- Position et point visé de la caméra pour la progression p du plan (repère de l'ancre), avec adoucissement.
	function C.cameraAt(shot, p)
		local e = Easing.inOutSine(Easing.clamp01(p))
		return lerp3(shot.pos, shot.toPos or shot.pos, e), lerp3(shot.look, shot.toLook or shot.look, e)
	end

	-- Lecteur d'une séquence. États : idle -> playing -> done (raison : completed | skipped | aborted). play() redémarre à zéro (reprise).
	function C.player(seq)
		local P = { state = "idle", reason = nil, startedAt = 0, lastShot = 0 }
		function P.play(now)
			P.state, P.reason, P.startedAt, P.lastShot = "playing", nil, now, 0
		end
		function P.isPlaying()
			return P.state == "playing"
		end
		-- À appeler à chaque image. nil si rien ne joue ; sinon { shot, progress, shotChanged, finished, reason }.
		-- L'événement `finished` n'est renvoyé qu'une seule fois.
		function P.update(now)
			if P.state ~= "playing" then
				return nil
			end
			local i, p = C.shotAt(seq, now - P.startedAt)
			if not i then
				P.state, P.reason = "done", "completed"
				return { finished = true, reason = "completed" }
			end
			local changed = i ~= P.lastShot
			P.lastShot = i
			return { shot = i, progress = p, shotChanged = changed, finished = false }
		end
		function P.skip()
			if P.state == "playing" then
				P.state, P.reason = "done", "skipped"
				return true
			end
			return false
		end
		function P.abort()
			if P.state == "playing" then
				P.state, P.reason = "done", "aborted"
				return true
			end
			return false
		end
		return P
	end

	-- Directeur : une seule cinématique à la fois. Une demande « chain » pendant une lecture est mise en file (intro puis tutoriel) ;
	-- une autre demande est refusée (jamais de cinématique superposée). Une cinématique ne démarre jamais seule en plein jeu.
	function C.director()
		local D = { current = nil, queue = {} }

		local function startNext(now)
			local nxt = table.remove(D.queue, 1)
			if nxt then
				D.current = { id = nxt.id, seq = nxt.seq, player = C.player(nxt.seq) }
				D.current.player.play(now)
			end
		end

		-- Retourne "playing", "queued" ou "refused".
		function D.request(id, seq, now, chain)
			if D.current and D.current.player.isPlaying() then
				if chain then
					D.queue[#D.queue + 1] = { id = id, seq = seq }
					return "queued"
				end
				return "refused"
			end
			D.current = { id = id, seq = seq, player = C.player(seq) }
			D.current.player.play(now)
			return "playing"
		end

		-- Retourne (id, événement). À la fin d'une séquence, la suivante de la file démarre ; l'événement `finished` est renvoyé une fois.
		function D.update(now)
			local cur = D.current
			if not cur then
				return nil
			end
			local ev = cur.player.update(now)
			if ev and ev.finished then
				D.current = nil
				startNext(now)
			end
			return cur.id, ev
		end

		-- Passe la séquence en cours (la file continue). Retourne l'id passé, ou nil si rien ne jouait.
		function D.skip(now)
			local cur = D.current
			if cur and cur.player.skip() then
				D.current = nil
				startNext(now)
				return cur.id
			end
			return nil
		end

		-- Passe tout : la séquence en cours et la file. Retourne la liste des identifiants passés.
		function D.skipAll()
			local ids = {}
			local cur = D.current
			if cur and cur.player.skip() then
				ids[#ids + 1] = cur.id
			end
			for _, q in ipairs(D.queue) do
				ids[#ids + 1] = q.id
			end
			D.current, D.queue = nil, {}
			return ids
		end

		-- Abandon (mort, attaque, erreur) : tout s'arrête, la file est vidée, rien n'est considéré comme vu.
		function D.abort()
			local cur = D.current
			if cur then
				cur.player.abort()
			end
			D.current, D.queue = nil, {}
		end

		function D.isActive()
			return D.current ~= nil
		end

		return D
	end

	return C
end

return Cinema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">VfxKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/VfxKit
-- Effets visuels 3D : DONNÉES PURES (préréglages nommés = séquences de pièces Blender, émetteurs de particules, faisceau, surbrillance) et
-- fonctions de planification testées hors de Roblox (qualité Élevé / Moyen / Bas, plafonds mobiles, effets par rareté), puis EXÉCUTION côté
-- client (VfxKit.play) : chaque pièce est un modèle Blender blanc (`Nom__FFFFFF`, Neon) cloné depuis ReplicatedStorage.VfxTemplates, recoloré
-- par code, ancré, sans collision, dont la transparence, l'échelle, la rotation et la hauteur sont animées par TweenService ; tout est nettoyé
-- (Debris) et protégé par pcall : un effet qui échoue ne casse jamais le jeu.
-- Utilisation : local Vfx = require(Shared.VfxKit).new(Config, Easing)
local VfxKit = {}

-- Modèles Blender d'effets (clé = nom du fichier Blender, voir Config.Assets.models.vfx).
VfxKit.MODELS = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Préréglages. Pièce : { model, at (retard s), dur (s), s0/s1 (échelle de départ/arrivée, 1 = taille Blender), t0/t1 (transparence), spin (rad/s),
-- rise (studs montés pendant l'effet), style (Back, Elastic, Quint, Quad, Sine), dir (Out, In, InOut), color ("rarity" | "white" | {r,g,b} 0-255) }.
-- L'ordre des pièces est leur priorité : la qualité Basse n'en garde que les premières. Particules : { count, life, speed, size, color }.
VfxKit.PRESETS = {
	aura_runique = {
		pieces = {
			{ model = "cercle_runique", at = 0, dur = 1.8, s0 = 0.3, s1 = 1.15, t0 = 0.9, t1 = 1, spin = 1.4, style = "Back", dir = "Out", color = "rarity", peak = 0.35 },
			{ model = "halo", at = 0.1, dur = 1.6, s0 = 0.5, s1 = 1.0, t0 = 0.85, t1 = 1, spin = -0.8, style = "Quint", dir = "Out", color = "rarity", peak = 0.4 },
		},
		particles = { count = 24, life = 1.4, speed = 5, size = 0.35, color = "rarity" },
		minQuality = "low",
	},
	aura_ailes = {
		pieces = { { model = "ailes", at = 0.2, dur = 2.2, s0 = 0.2, s1 = 1.2, t0 = 0.8, t1 = 1, rise = 1.5, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 } },
		particles = { count = 18, life = 1.8, speed = 3, size = 0.3, color = "rarity" },
		highlight = true,
		minQuality = "medium",
	},
	onde_de_choc = {
		pieces = { { model = "onde", at = 0, dur = 0.9, s0 = 0.2, s1 = 3.2, t0 = 0.2, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 } },
		particles = { count = 14, life = 0.8, speed = 14, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	pilier_revelation = {
		pieces = {
			{ model = "pilier_lumiere", at = 0.15, dur = 1.8, s0 = 0.1, s1 = 1.1, t0 = 0.7, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.25 },
			{ model = "rayons", at = 0.2, dur = 1.6, s0 = 0.4, s1 = 1.3, t0 = 0.75, t1 = 1, spin = 0.9, style = "Quint", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cone_lumiere", at = 0.3, dur = 1.5, s0 = 0.6, s1 = 1.0, t0 = 0.8, t1 = 1, style = "Sine", dir = "InOut", color = "white", peak = 0.45 },
		},
		particles = { count = 30, life = 2, speed = 8, size = 0.4, color = "white" },
		beam = true,
		minQuality = "low",
	},
	bouclier = {
		pieces = { { model = "bouclier", at = 0, dur = 1.4, s0 = 0.5, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.6, style = "Back", dir = "Out", color = { 90, 200, 255 }, peak = 0.45 } },
		highlight = true,
		minQuality = "low",
	},
	etincelles = {
		pieces = { { model = "etincelles", at = 0, dur = 1.6, s0 = 0.5, s1 = 1.2, t0 = 0.3, t1 = 1, rise = 3, style = "Quad", dir = "Out", color = "rarity", peak = 0.1 } },
		particles = { count = 30, life = 1.5, speed = 9, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	spirale_montee = {
		pieces = {
			{ model = "spirale", at = 0, dur = 2.4, s0 = 0.4, s1 = 1.2, t0 = 0.6, t1 = 1, spin = 3, rise = 8, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 },
			{ model = "etoile", at = 1.0, dur = 1.2, s0 = 0.2, s1 = 1.4, t0 = 0.5, t1 = 1, spin = 1, rise = 10, style = "Back", dir = "Out", color = "white", peak = 0.2 },
		},
		particles = { count = 26, life = 2.2, speed = 6, size = 0.35, color = "rarity" },
		minQuality = "medium",
	},
	portail_torii = {
		pieces = {
			{ model = "torii", at = 0.3, dur = 2.6, s0 = 0.3, s1 = 1.0, t0 = 0.85, t1 = 1, style = "Back", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cristaux", at = 0.5, dur = 2.2, s0 = 0.2, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.4, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 },
		},
		particles = { count = 22, life = 2, speed = 4, size = 0.4, color = "rarity" },
		minQuality = "medium",
	},
}

-- Qualités. Mobile = Bas : au plus 3 effets simultanés, 40 particules par émetteur, jamais de faisceau (Beam).
VfxKit.QUALITY = {
	high = { rank = 3, maxConcurrent = 8, particleCap = 120, beams = true, maxPieces = 3, highlight = true },
	medium = { rank = 2, maxConcurrent = 5, particleCap = 70, beams = false, maxPieces = 2, highlight = true },
	low = { rank = 1, maxConcurrent = 3, particleCap = 40, beams = false, maxPieces = 1, highlight = false },
}

-- Effets (préréglages) joués pour une éclosion : ampleur croissante avec la rareté (1 Commun discret .. 5 Mythique) ; Cosmique et secret sont
-- spectaculaires. Retourne la liste ordonnée des préréglages et un facteur d'ampleur (échelle).
function VfxKit.hatchEffects(tier, secret)
	tier = math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), 6)
	local amp = ({ 0.55, 0.75, 0.95, 1.2, 1.45, 1.8 })[tier]
	if secret then
		return { "pilier_revelation", "spirale_montee", "portail_torii", "aura_runique", "onde_de_choc", "etincelles" }, 2
	elseif tier == 1 then
		return { "etincelles" }, amp
	elseif tier == 2 then
		return { "etincelles", "onde_de_choc" }, amp
	elseif tier == 3 then
		return { "aura_runique", "onde_de_choc" }, amp
	elseif tier == 4 then
		return { "pilier_revelation", "aura_runique", "aura_ailes", "onde_de_choc" }, amp
	elseif tier == 5 then
		return { "pilier_revelation", "aura_runique", "aura_ailes", "spirale_montee", "onde_de_choc" }, amp
	end
	return { "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" }, amp
end

-- Qualité : tactile = Bas, sinon Élevé ; `override` (« high », « medium », « low ») la remplace.
function VfxKit.quality(isTouch, override)
	if override and VfxKit.QUALITY[override] then
		return override
	end
	return isTouch and "low" or "high"
end

function VfxKit.new(Config, Easing)
	local K = { active = 0 }

	-- Couleur (r, g, b en 0-255) d'une rareté ; blanc si inconnue.
	function K.rarityColor(tier)
		local t = Config.TIERS[tier]
		local c = t and t.color
		if c then
			return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
		end
		return { 255, 255, 255 }
	end

	local function resolveColor(spec, tier)
		if spec == "white" then
			return { 255, 255, 255 }
		elseif type(spec) == "table" then
			return spec
		end
		return K.rarityColor(tier)
	end

	-- Courbe nommée (style de TweenService) sur [0, 1] : Back, Elastic, Quint, Quad, Sine (sortie ou entrée-sortie).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	-- Plan concret d'un préréglage pour une rareté et une qualité : pièces (priorité, nombre limité par la qualité), particules plafonnées,
	-- faisceau seulement en Élevé, surbrillance selon la qualité, durée totale. nil si préréglage inconnu ou trop exigeant pour la qualité.
	-- amp multiplie l'échelle (ampleur selon la rareté).
	function K.plan(name, tier, quality, amp)
		local preset = VfxKit.PRESETS[name]
		local q = VfxKit.QUALITY[quality]
		if not preset or not q then
			return nil
		end
		local need = VfxKit.QUALITY[preset.minQuality or "low"]
		if q.rank < need.rank then
			return nil
		end
		amp = (type(amp) == "number" and amp == amp and amp > 0) and math.min(amp, 3) or 1
		local pieces, duration = {}, 0
		for i, p in ipairs(preset.pieces) do
			if i > q.maxPieces then
				break
			end
			pieces[#pieces + 1] = {
				model = p.model, at = p.at, dur = p.dur, s0 = p.s0 * amp, s1 = p.s1 * amp, t0 = p.t0, t1 = p.t1, spin = p.spin or 0, rise = (p.rise or 0) * amp,
				style = p.style, dir = p.dir, color = resolveColor(p.color, tier), peak = p.peak,
			}
			duration = math.max(duration, p.at + p.dur)
		end
		local particles = nil
		if preset.particles then
			particles = {
				count = math.min(preset.particles.count, q.particleCap), life = preset.particles.life, speed = preset.particles.speed,
				size = preset.particles.size, color = resolveColor(preset.particles.color, tier),
			}
		end
		return {
			name = name, pieces = pieces, particles = particles, beam = preset.beam == true and q.beams, highlight = preset.highlight == true and q.highlight,
			duration = duration,
		}
	end

	-- Admission : combien d'effets peuvent encore démarrer (limite de simultanéité de la qualité).
	function K.admit(active, quality)
		local q = VfxKit.QUALITY[quality]
		return q ~= nil and type(active) == "number" and active < q.maxConcurrent
	end

	-- Liste ordonnée des plans d'une éclosion, tronquée à la simultanéité de la qualité (rien de plus que ce que le téléphone peut jouer).
	function K.hatchPlans(tier, secret, quality, activeNow)
		local names, amp = VfxKit.hatchEffects(tier, secret)
		local out = {}
		local active = activeNow or 0
		for _, name in ipairs(names) do
			if not K.admit(active + #out, quality) then
				break
			end
			local plan = K.plan(name, tier, quality, amp)
			if plan then
				out[#out + 1] = plan
			end
		end
		return out
	end

	-- Transparence d'une pièce à la progression p (0..1) : monte en fondu vers `peak` (visibilité maximale) puis disparaît ; valeur dans [0, 1].
	function K.transparencyAt(piece, p)
		p = Easing.clamp01(p)
		local appear = 0.25
		if p < appear then
			return piece.t0 + (piece.peak - piece.t0) * K.curve("Quad", p / appear)
		end
		local e = (p - appear) / (1 - appear)
		return math.min(math.max(piece.peak + (piece.t1 - piece.peak) * K.curve("Sine", e), 0), 1)
	end

	-- Échelle d'une pièce à la progression p.
	function K.scaleAt(piece, p)
		return piece.s0 + (piece.s1 - piece.s0) * K.curve(piece.style, p)
	end

	---------------------------------------------------------------- Exécution (client)
	-- env = { clone(model) -> Model|nil, tween = TweenService, debris = Debris, parent = Instance, spawn = task.spawn, delay = task.delay, color = Color3.fromRGB }
	-- Retourne true si l'effet a démarré. Tout est sous pcall ; l'effet est détruit à la fin (Debris) quoi qu'il arrive.
	function K.play(env, plan, cframe, opts)
		if not plan or K.active >= 99 then
			return false
		end
		local started = false
		local ok = pcall(function()
			local folder = Instance.new("Folder")
			folder.Name = "Vfx_" .. plan.name
			folder.Parent = env.parent
			env.debris:AddItem(folder, plan.duration + 1.5)
			K.active += 1
			env.delay(plan.duration + 1.4, function()
				K.active = math.max(0, K.active - 1)
			end)
			for _, piece in ipairs(plan.pieces) do
				env.delay(piece.at, function()
					pcall(function()
						local model = env.clone(piece.model)
						if not model then
							return
						end
						model.Parent = folder
						local color = env.color(piece.color[1], piece.color[2], piece.color[3])
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false
								d.CanQuery = false
								d.CanTouch = false
								d.CastShadow = false
								d.Color = color
								d.Transparency = piece.t0
							end
						end
						local base = model:GetScale()
						local pivot = cframe
						local value = Instance.new("NumberValue")
						value.Parent = folder
						local function apply(p)
							if not model.Parent then
								return
							end
							pcall(function()
								model:ScaleTo(math.max(0.01, base * K.scaleAt(piece, p)))
								model:PivotTo(pivot * CFrame.new(0, piece.rise * p, 0) * CFrame.Angles(0, piece.spin * p * piece.dur, 0))
								local tr = K.transparencyAt(piece, p)
								for _, d in ipairs(model:GetDescendants()) do
									if d:IsA("BasePart") then
										d.Transparency = tr
									end
								end
							end)
						end
						apply(0)
						value.Changed:Connect(apply)
						env.tween:Create(value, TweenInfo.new(piece.dur, Enum.EasingStyle.Linear), { Value = 1 }):Play() -- les courbes sont appliquées par apply (Back, Elastic, Quint...)
					end)
				end)
			end
			if plan.particles then
				local anchor = Instance.new("Part")
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanQuery = false
				anchor.Transparency = 1
				anchor.Size = Vector3.new(1, 1, 1)
				anchor.CFrame = cframe
				anchor.Parent = folder
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(env.color(plan.particles.color[1], plan.particles.color[2], plan.particles.color[3]))
				e.Rate = 0
				e.Lifetime = NumberRange.new(plan.particles.life * 0.6, plan.particles.life)
				e.Speed = NumberRange.new(plan.particles.speed * 0.5, plan.particles.speed)
				e.SpreadAngle = Vector2.new(180, 180)
				e.LightEmission = 1
				e.Size = NumberSequence.new(plan.particles.size)
				e.Parent = anchor
				e:Emit(plan.particles.count) -- plafonné par la qualité (40 sur téléphone)
			end
			if plan.beam then -- faisceau vertical (qualité Élevée seulement)
				local top = Instance.new("Part")
				top.Anchored = true
				top.CanCollide = false
				top.CanQuery = false
				top.Transparency = 1
				top.Size = Vector3.new(1, 1, 1)
				top.CFrame = cframe * CFrame.new(0, 14, 0)
				top.Parent = folder
				local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
				a0.Parent = top
				a1.Parent = folder:FindFirstChildOfClass("Part") or top
				local beam = Instance.new("Beam")
				beam.Attachment0, beam.Attachment1 = a0, a1
				beam.Width0, beam.Width1 = 0.6, 2.2
				beam.LightEmission = 1
				beam.Transparency = NumberSequence.new(0.35, 1)
				beam.Color = ColorSequence.new(env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255))
				beam.Parent = top
			end
			if plan.highlight and opts and opts.target then
				local hl = Instance.new("Highlight")
				hl.FillTransparency = 0.8
				hl.OutlineTransparency = 0.2
				hl.FillColor = env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255)
				hl.Parent = opts.target
				env.debris:AddItem(hl, plan.duration)
			end
			started = true
		end)
		return ok and started
	end

	return K
end

return VfxKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">CinematicKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/CinematicKit
-- Caméras de cinématique : LOGIQUE PURE (aucun service Roblox) testée hors de Roblox. Un « plan » est une liste de prises { dur, pos, look, toPos, toLook,
-- fov, toFov, path, ease, shake, slow, text, title, fx, anchor } dans le repère de son ancre ; trajectoires : travelling (linéaire), orbite autour du
-- point visé, plongée (de haut en bas), zoom dolly (la caméra avance et le champ de vision se resserre). Bandes noires, cartons de titre, tremblement,
-- ralenti et bouton Passer sont appliqués par le client (Cinematics.client.lua) à partir de ces valeurs.
-- Garanties : jamais plus de 8 secondes réelles (MAX_SECONDS) ; aucune cinématique si le joueur est en danger (`canPlay`) ; la caméra et le contrôle
-- sont restitués par le client quoi qu'il arrive (fin, passage, erreur, départ). Utilisation : require(CinematicKit).new(Easing, Cinema).
local CinematicKit = {}

CinematicKit.MAX_SECONDS = 8

-- Plans nommés. Les positions sont { x, y, z } dans le repère de l'ancre (arena, base, pad, rival1..3, castle, world, hubfountain, hubportals).
-- `slow = { at, to, scale }` : entre ces progressions de la prise (0..1), le temps s'écoule à `scale` (0.35 = ralenti), ce qui allonge la durée réelle.
CinematicKit.PLANS = {
	hub_survol = { id = "hub_survol", shots = {
		{ anchor = "hubfountain", pos = { 0, 30, 70 }, look = { 0, 3, 0 }, toPos = { 0, 18, 40 }, path = "travel", dur = 2.2, ease = "Quint", title = "🥚 Bienvenue !" },
		{ anchor = "hubportals", pos = { 0, 22, 100 }, look = { 0, 8, -60 }, toPos = { 0, 14, 30 }, toLook = { 0, 8, -80 }, path = "travel", dur = 2.8, ease = "Sine", text = "Choisis un portail : seul, ou avec des amis." },
	} },
	secret = { id = "secret", shots = {
		{ anchor = "pad", pos = { 0, 6, 10 }, look = { 0, 3, 0 }, toPos = { 0, 14, 6 }, path = "dive", dur = 1.4, ease = "Quint", shake = 0.25, title = "✦ ???" },
		{ anchor = "pad", pos = { 0, 12, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = 2.4, height = 8, dur = 3.4, ease = "Sine", shake = 0.5, slow = { at = 0.35, to = 0.6, scale = 0.4 }, fx = "flash" },
		{ anchor = "pad", pos = { 0, 5, 9 }, look = { 0, 4, 0 }, path = "dolly", fov = 70, toFov = 46, toPos = { 0, 4, 3 }, dur = 1.4, ease = "Back", title = "✦ SECRET ✦" },
	} },
	chateau_entree = { id = "chateau_entree", shots = {
		{ anchor = "castle", pos = { -40, 16, 34 }, look = { 0, 6, -8 }, toPos = { 40, 14, 34 }, toLook = { 0, 8, -8 }, path = "travel", dur = 2.6, ease = "Sine", title = "🏰 Le Château" },
		{ anchor = "castle", pos = { 0, 5, 16 }, look = { 0, 7, 0 }, toPos = { 0, 6, 9 }, path = "dolly", fov = 70, toFov = 55, dur = 2.2, ease = "Quint", text = "La herse se lève…", fx = "gate" },
	} },
	base_niveau = { id = "base_niveau", shots = {
		{ anchor = "base", pos = { 0, 20, -46 }, look = { 0, 5, 4 }, path = "orbit", radius = 44, toRadius = 36, angle0 = 3.14, angle1 = 4.6, height = 18, dur = 2.4, ease = "Sine", title = "🏠 Ta base évolue !" },
		{ anchor = "base", pos = { 0, 12, -38 }, look = { 0, 6, 8 }, toPos = { 0, 9, -26 }, path = "dolly", fov = 70, toFov = 58, dur = 1.4, ease = "Quint" },
	} },
	chateau_victoire = { id = "chateau_victoire", shots = {
		{ anchor = "castle_chest", pos = { 6, 7, 10 }, look = { 0, 3, 0 }, toPos = { 3, 5, 6 }, path = "dolly", fov = 70, toFov = 52, dur = 1.6, ease = "Quint", slow = { at = 0.4, to = 0.9, scale = 0.35 }, shake = 0.3, fx = "sparks" },
		{ anchor = "castle_chest", pos = { 0, 6, 11 }, look = { 0, 3, 0 }, path = "orbit", radius = 11, toRadius = 9, angle0 = 0.6, angle1 = 2.0, height = 6, dur = 2.4, ease = "Sine", title = "🏆 Victoire !" },
	} },
}

-- Plan d'éclosion selon la rareté (1..6) : plus la rareté monte, plus la caméra s'engage (orbite, zoom, secousse, ralenti, pilier de lumière côté VfxKit).
-- Commun et Rare : AUCUNE cinématique (les effets 3D de VfxKit suffisent) ; Épique : plan court ; Légendaire et au-delà : plan complet.
function CinematicKit.hatchPlan(tier, secret)
	tier = math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), 6)
	if secret then
		return CinematicKit.PLANS.secret
	elseif tier <= 2 then
		return nil
	elseif tier == 3 then
		return { id = "eclosion_epique", skipOnTap = true, shots = {
			{ anchor = "pad", pos = { 0, 8, 12 }, look = { 0, 3, 0 }, toPos = { 0, 5, 7 }, path = "dolly", fov = 70, toFov = 56, dur = 1.6, ease = "Quint", shake = 0.15 },
		} }
	end
	local big = tier >= 5
	return { id = "eclosion", skipOnTap = true, shots = {
		{ anchor = "pad", pos = { 0, 7, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = big and 2.2 or 1.6, height = 6, dur = big and 2.4 or 1.8, ease = "Sine" },
		{ anchor = "pad", pos = { 0, 5, 8 }, look = { 0, 3.2, 0 }, path = "dolly", fov = 70, toFov = big and 44 or 52, toPos = { 0, 4, 4 }, dur = big and 1.8 or 1.2, ease = "Back", shake = big and 0.6 or 0.4, slow = { at = 0.5, to = 1, scale = 0.35 }, fx = "crack" },
		{ anchor = "pad", pos = { 0, 6, 9 }, look = { 0, 4, 0 }, toPos = { 0, 7, 11 }, path = "travel", fov = big and 52 or 60, toFov = 70, dur = big and 1.6 or 1.2, ease = "Quint", title = nil },
	} }
end

-- Plan court « gardien ou chevalier qui repère le joueur » : AUCUN mouvement de caméra (le joueur garde le contrôle, il est en danger) : un à-coup
-- de champ de vision, un peu de tremblement et un « ❗ » (voir `overlay`). Retourne le descriptif d'effet d'interface.
CinematicKit.ALERT = { seconds = 1.2, fovPunch = 8, shake = 0.35, title = "❗", cooldown = 90, perSession = 3 }

function CinematicKit.new(Easing, Cinema)
	local K = {}

	-- Courbe nommée (style de TweenService).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	local function lerp(a, b, e)
		return a + (b - a) * e
	end
	local function lerp3(a, b, e)
		return { lerp(a[1], b[1], e), lerp(a[2], b[2], e), lerp(a[3], b[3], e) }
	end

	-- Durée RÉELLE d'une prise (le ralenti l'allonge) : dur x (1 + (1/scale - 1) x largeur de la zone lente).
	function K.realDuration(shot)
		local s = shot.slow
		if not s then
			return shot.dur
		end
		local width = math.max(0, math.min(1, s.to) - math.max(0, s.at))
		return shot.dur * (1 + (1 / math.max(0.05, s.scale) - 1) * width)
	end

	function K.realTotal(def)
		local t = 0
		for _, shot in ipairs(def.shots) do
			t = t + K.realDuration(shot)
		end
		return t
	end

	-- Plan normalisé : durées réduites proportionnellement si la durée RÉELLE dépasse `maxSeconds` (8 par défaut) ; prise invalide (durée <= 0, NaN) = refus.
	-- Retourne (définition prête pour Cinema.sequence, durée réelle) ou (nil, raison).
	function K.build(def, maxSeconds)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucune prise"
		end
		maxSeconds = (type(maxSeconds) == "number" and maxSeconds > 0) and math.min(maxSeconds, CinematicKit.MAX_SECONDS) or CinematicKit.MAX_SECONDS
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur ~= shot.dur or shot.dur <= 0 or type(shot.pos) ~= "table" or type(shot.look) ~= "table" then
				return nil, "prise invalide (" .. i .. ")"
			end
		end
		local real = K.realTotal(def)
		local k = real > maxSeconds and (maxSeconds / real) or 1
		local shots = {}
		for i, shot in ipairs(def.shots) do
			local copy = {}
			for key, v in pairs(shot) do
				copy[key] = v
			end
			copy.dur = shot.dur * k
			shots[i] = copy
		end
		local out = { id = def.id, shots = shots, skipOnTap = def.skipOnTap }
		return out, real * k
	end

	-- Temps virtuel (celui des prises) atteint après `realElapsed` secondes réelles : le ralenti fait avancer le temps plus lentement dans sa zone.
	function K.virtualElapsed(def, realElapsed)
		local virtual, left = 0, math.max(0, realElapsed)
		for _, shot in ipairs(def.shots) do
			local rd = K.realDuration(shot)
			if left >= rd then
				virtual = virtual + shot.dur
				left = left - rd
			else
				local s = shot.slow
				if not s then
					return virtual + left
				end
				local a, b = math.max(0, s.at) * shot.dur, math.min(1, s.to) * shot.dur
				local slowReal = (b - a) / math.max(0.05, s.scale)
				if left <= a then
					return virtual + left
				elseif left <= a + slowReal then
					return virtual + a + (left - a) * math.max(0.05, s.scale)
				end
				return virtual + b + (left - a - slowReal)
			end
		end
		return virtual
	end

	-- Caméra à la progression p d'une prise : (position, point visé, champ de vision) dans le repère de l'ancre.
	function K.cameraAt(shot, p)
		local e = K.curve(shot.ease or "Sine", p)
		local fov = lerp(shot.fov or 70, shot.toFov or shot.fov or 70, e)
		local look = lerp3(shot.look, shot.toLook or shot.look, e)
		local path = shot.path
		if path == "orbit" then
			local r = lerp(shot.radius or 10, shot.toRadius or shot.radius or 10, e)
			local a = lerp(shot.angle0 or 0, shot.angle1 or (shot.angle0 or 0), e)
			return { look[1] + math.sin(a) * r, look[2] + (shot.height or 5), look[3] + math.cos(a) * r }, look, fov
		elseif path == "dive" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- plongée : de haut en bas (ou l'inverse) en gardant la cible
		elseif path == "dolly" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- zoom dolly : la caméra avance, le champ de vision se resserre
		end
		return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- travelling
	end

	-- Décalage de caméra dû au tremblement (amplitude shot.shake en studs, décroissante sur la prise, bruit déterministe).
	function K.shakeOffset(shot, p, time)
		local amp = shot.shake
		if not amp or amp <= 0 then
			return { 0, 0, 0 }
		end
		local decay = (1 - Easing.clamp01(p)) ^ 1.5
		local a = amp * decay
		return { math.sin(time * 47.3) * a * 0.5, math.sin(time * 61.1 + 1.7) * a * 0.4, math.cos(time * 39.7) * a * 0.3 }
	end

	-- Le joueur peut-il voir une cinématique maintenant ? ctx = { hp, maxHp, sinceHit (s depuis le dernier coup), chased (poursuivi par un gardien),
	-- inTrapRoom (dans une salle à pièges du château), dead }. Jamais en danger : peu de pv, coup récent, poursuite, salle à pièges, mort.
	function K.canPlay(ctx)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.5 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 4) or ctx.chased or ctx.inTrapRoom then
			return false
		end
		return true
	end

	-- Alerte (gardien ou chevalier qui repère le joueur) : pas une cinématique (aucune caméra) ; autorisée même poursuivi, mais pas à moins de 40 % de pv
	-- ni juste après un coup, avec temps de recharge et nombre maximum par session.
	function K.canAlert(ctx, now, lastAt, shown)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.4 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 2) then
			return false
		end
		if (shown or 0) >= CinematicKit.ALERT.perSession or (lastAt and now - lastAt < CinematicKit.ALERT.cooldown) then
			return false
		end
		return true
	end

	-- Gestionnaire de lecture : une seule cinématique à la fois (le directeur de Cinema refuse la seconde), passage immédiat, restitution garantie.
	-- host = { takeCamera(), giveCameraBack(), apply(shotIndex, progress, shot) } ; toute erreur de host.apply restitue la caméra et abandonne.
	-- Retourne un objet { start(def, now), update(now), skip(now), abort(), isActive(), restored } pour le client et les tests.
	function K.runner(host)
		local R = { restored = 0 }
		local director = Cinema.director()
		local current = nil
		local function restore()
			if current then
				current = nil
			end
			R.restored = R.restored + 1
			pcall(host.giveCameraBack)
		end
		-- Retourne "playing", "queued" ou "refused" (ou "invalid").
		function R.start(def, now, chain)
			local built, real = K.build(def)
			if not built then
				return "invalid"
			end
			local seq = Cinema.sequence(built)
			if not seq then
				return "invalid"
			end
			local result = director.request(def.id, seq, now, chain)
			if result == "playing" then
				current = { def = built, startedAt = now, seq = seq, real = real }
				local ok = pcall(host.takeCamera)
				if not ok then
					director.abort()
					restore()
					return "invalid"
				end
			end
			return result
		end
		function R.update(now)
			if not current then
				return nil
			end
			local virtual = K.virtualElapsed(current.def, now - current.startedAt)
			local id, ev = director.update(current.startedAt + virtual)
			if not id or (ev and ev.finished) then
				restore()
				return "finished"
			end
			if ev and ev.shot then
				local ok = pcall(host.apply, ev.shot, ev.progress, current.def.shots[ev.shot])
				if not ok then
					director.abort()
					restore()
					return "error"
				end
			end
			return "playing"
		end
		function R.skip(now)
			if director.skip(now) then
				restore()
				return true
			end
			return false
		end
		function R.abort()
			director.abort()
			if current then
				restore()
			end
		end
		function R.isActive()
			return director.isActive()
		end
		return R
	end

	return K
end

return CinematicKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Placement
-- Pose PLANIFIÉE du décor Blender (arbres, rochers, buissons, cabanes, barrières, ponts) : logique PURE, déterministe, testée hors de Roblox.
-- Principes : une grille de cellules parcourue dans un ordre fixe (aucun tirage libre), chaque objet a une empreinte circulaire ; il n'est posé que si son
-- empreinte ne touche NI l'eau (rivières, douves), NI un chemin, NI l'arène, un domaine, une base ou un secret, et reste à distance minimale des objets
-- déjà posés. Cabanes tournées face au centre de leur domaine, barrières alignées sur une même ligne, ponts centrés sur leur rivière et plus longs
-- qu'elle (les deux rives sont reliées). Utilisation : require(Placement).new(Config).plan().
local Placement = {}

local KIND_RADIUS = { tree = 3.5, fir = 3.5, rock = 2.5, bush = 2, hut = 7, fence = 5.5 }
Placement.KIND_RADIUS = KIND_RADIUS
Placement.MIN_GAP = 2 -- espace libre minimal entre deux empreintes (studs)
Placement.CELL = 30

-- Angle (degrés) de rotation autour de Y pour qu'un modèle dont l'avant est -Z regarde la direction (dx, dz). Portable (pas de math.atan2).
function Placement.facing(dx, dz)
	local fx, fz = -dx, -dz -- on veut sin(theta) = -dx/len et cos(theta) = -dz/len
	if fx == 0 and fz == 0 then
		return 0
	end
	local theta
	if fz == 0 then
		theta = fx > 0 and math.pi / 2 or -math.pi / 2
	else
		theta = math.atan(fx / fz)
		if fz < 0 then
			theta = theta + math.pi
		end
	end
	return math.deg(theta) % 360
end

local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / len2)) or 0
	local cx, cz = ax + dx * t, az + dz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Placement.distToSegment = distToSegment

-- Angle Y (degrés, convention Roblox : CFrame.Angles(0, a, 0) envoie +X vers (cos a, -sin a)) d'un déplacement (dx, dz). Pas de math.atan2.
function Placement.yawOfDir(dx, dz)
	local ax, az = dx, -dz -- on veut cos a = dx/len, sin a = -dz/len
	if ax == 0 and az == 0 then
		return 0
	end
	local a
	if ax == 0 then
		a = az > 0 and math.pi / 2 or -math.pi / 2
	else
		a = math.atan(az / ax)
		if ax < 0 then
			a = a + math.pi
		end
	end
	return math.deg(a) % 360
end

-- Variante d'arbre selon la zone : tree_sakura près des lacs et de l'arène centrale, tree_pine sur les falaises (autour des domaines), sinon prairie
-- (chênes, bouleau, arbre rond en alternance ; tree_oak_b porte des pommes). `kind` = "tree" ou "fir" (les sapins restent des pins). `k` = rang (déterministe).
function Placement.treeVariant(Config, kind, x, z, k)
	if kind == "fir" then
		return "tree_pine"
	end
	local geo = Config.Map.geo
	for _, lk in ipairs(geo.lakes or {}) do
		if math.sqrt((x - lk.x) ^ 2 + (z - lk.z) ^ 2) < lk.r + 70 then
			return "tree_sakura"
		end
	end
	if math.sqrt(x * x + z * z) < geo.arenaRadius + 70 then
		return "tree_sakura"
	end
	for i = 1, #Config.RIVALS do
		local cx, cz = Config.rivalCenter(i)
		if math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) < Config.Map.plateauRadius + 60 then
			return "tree_pine"
		end
	end
	return ({ "tree_oak_a", "tree_oak_b", "tree_birch", "tree_round" })[(k or 0) % 4 + 1]
end

-- Échelle aléatoire déterministe 1 ± jitter d'après la position (jamais de tirage libre).
function Placement.jitter(x, z, jitter)
	local h = math.abs(math.sin(x * 12.9898 + z * 78.233) * 43758.5453)
	return 1 + ((h - math.floor(h)) * 2 - 1) * jitter
end

-- Chemin sinueux : la polyligne est rééchantillonnée tous les `tile` studs et décalée latéralement d'une sinusoïde (amplitude `wind`, nulle aux
-- extrémités et aux sommets). Retourne { tiles = { {kind, x, z, rot} }, borders = { {x, z, rot} } } : tuiles droites (le long de X, tournées vers la
-- direction), tuile de virage quand la direction tourne de 50° à 130° (rotation par pas de 90°), bordures de pierres de part et d'autre.
function Placement.pathTiles(poly, tile, wind)
	local pts, cum = {}, { 0 }
	local verts = {}
	local total = 0
	for k = 1, #poly - 1 do
		local ax, az, bx, bz = poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2]
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		verts[#verts + 1] = total
		local n = math.max(1, math.floor(len / tile + 0.5))
		for j = 0, n - 1 do
			local t = j / n
			local dx, dz = (bx - ax) / len, (bz - az) / len
			pts[#pts + 1] = { x = ax + (bx - ax) * t, z = az + (bz - az) * t, nx = -dz, nz = dx, d = total + len * t }
		end
		total = total + len
	end
	local last = poly[#poly]
	local pdx, pdz = last[1] - poly[#poly - 1][1], last[2] - poly[#poly - 1][2]
	local pl = math.sqrt(pdx * pdx + pdz * pdz)
	pts[#pts + 1] = { x = last[1], z = last[2], nx = -pdz / pl, nz = pdx / pl, d = total }
	verts[#verts + 1] = total
	for _, p in ipairs(pts) do
		local near = total
		for _, v in ipairs(verts) do
			near = math.min(near, math.abs(p.d - v))
		end
		local env = math.min(1, near / (tile * 2))
		local off = (wind or 0) * math.sin(p.d / 38) * env
		p.x, p.z = p.x + p.nx * off, p.z + p.nz * off
	end
	local tiles, borders = {}, {}
	local snap = function(dx, dz)
		if math.abs(dx) >= math.abs(dz) then
			return dx > 0 and 1 or -1, 0
		end
		return 0, dz > 0 and 1 or -1
	end
	for i = 1, #pts do
		local a, b = pts[i], pts[i + 1] or pts[i]
		local pa = pts[i - 1]
		local dx, dz = b.x - a.x, b.z - a.z
		if i == #pts then
			dx, dz = a.x - pa.x, a.z - pa.z
		end
		local rot = Placement.yawOfDir(dx, dz)
		local kind = "path_straight"
		if pa and i < #pts then
			local ix, iz = a.x - pa.x, a.z - pa.z
			local li, lo = math.sqrt(ix * ix + iz * iz), math.sqrt(dx * dx + dz * dz)
			local cosT = (ix * dx + iz * dz) / (li * lo)
			if cosT < 0.64 and cosT > -0.64 then -- tourne de 50° à 130°
				local ux, uz = snap(ix, iz)
				local vx, vz = snap(dx, dz)
				-- virage de base : on entre en allant vers +X et on sort vers -Z ; 4 rotations x (sens direct / inverse)
				local found
				for q = 0, 3 do
					local th = math.rad(q * 90)
					local function rot90(x, z) -- image de (x, z) par Angles(0, th, 0)
						return math.floor(x * math.cos(th) + z * math.sin(th) + 0.5), math.floor(-x * math.sin(th) + z * math.cos(th) + 0.5)
					end
					local ex, ez = rot90(1, 0)
					local fx, fz = rot90(0, -1)
					if ex == ux and ez == uz and fx == vx and fz == vz then
						found = q * 90
					elseif -fx == ux and -fz == uz and -ex == vx and -ez == vz then
						found = q * 90 -- tuile parcourue en sens inverse
					end
				end
				if found then
					kind, rot = "path_curve", found
				end
			end
		end
		tiles[#tiles + 1] = { kind = kind, x = a.x, z = a.z, rot = rot }
		local nxl, nzl = -dz, dx
		local nl = math.sqrt(nxl * nxl + nzl * nzl)
		if nl > 0 then
			for _, side in ipairs({ -1, 1 }) do
				borders[#borders + 1] = { x = a.x + side * nxl / nl * (tile / 2 + 1.2), z = a.z + side * nzl / nl * (tile / 2 + 1.2), rot = rot }
			end
		end
	end
	return { tiles = tiles, borders = borders, length = total }
end

function Placement.new(Config)
	local P = {}
	local M = Config.Map
	local geo = M.geo
	local half = M.groundSize / 2

	-- Segments de chemin (mêmes extrémités que Scenery.paths) : de la moitié du x du domaine, devant l'arène, jusqu'au domaine.
	function P.pathSegments()
		local out = {}
		for _, poly in ipairs(M.paths) do
			for k = 1, #poly - 1 do
				out[#out + 1] = { poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2] }
			end
		end
		for i = 1, #Config.RIVALS do -- les rampes sont des chemins larges
			local r = Config.rampOf(i)
			out[#out + 1] = { r.top[1], r.top[2], r.bottom[1], r.bottom[2] }
		end
		return out
	end

	-- Altitude du sol en (x, z) : la hauteur du plateau d'un domaine si le point est sur ce plateau, sinon 0.
	function P.groundY(x, z)
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			if math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) < M.plateauRadius - 1 then
				return Config.rivalHeight(i)
			end
		end
		return 0
	end

	-- Pourquoi une empreinte (x, z, r) est interdite : "eau", "chemin", "arène", "domaine", "base", "secret", "bord" ou nil si libre.
	-- opts.allowDomain : l'empreinte peut se trouver dans un domaine (cabane et barrières d'un domaine).
	function P.blocked(x, z, r, opts)
		local margin = 1.5
		if math.abs(x) > half - 50 or math.abs(z) > half - 50 then
			return "bord"
		end
		for _, rv in ipairs(geo.rivers) do
			local c = rv.axis == "z" and z or x
			if math.abs(c - rv.at) < rv.half + r + margin then
				return "eau"
			end
		end
		for _, lk in ipairs(geo.lakes or {}) do
			if math.sqrt((x - lk.x) ^ 2 + (z - lk.z) ^ 2) < lk.r + 5 + r + margin then
				return "eau"
			end
		end
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)
			if d < M.plateauRadius + r + margin and (opts and opts.allowDomain) then
				-- sur le plateau : on ne pose rien dans la douve
				if math.abs(d - M.moat.radius) < M.moat.width / 2 + r + margin then
					return "eau"
				end
			elseif d < M.plateauRadius + r + margin then
				return "domaine"
			end
		end
		if math.sqrt(x * x + z * z) < geo.arenaRadius + r + margin then
			return "arène"
		end
		for _, seg in ipairs(P.pathSegments()) do
			if distToSegment(x, z, seg[1], seg[2], seg[3], seg[4]) < geo.pathHalf + r + margin then
				return "chemin"
			end
		end
		local ring = math.abs(math.sqrt(x * x + z * z) - (M.plotRadius - 30))
		if ring < geo.pathHalf + r + margin then
			return "chemin"
		end
		if math.abs(math.sqrt(x * x + z * z) - M.plotRadius) < geo.baseBand + r then
			return "base"
		end
		for _, sct in ipairs(Config.SECRETS) do
			if math.sqrt((x - sct.x) ^ 2 + (z - sct.z) ^ 2) < 40 + r then
				return "secret"
			end
		end
		return nil
	end

	-- Plan complet : { items = { {kind, x, z, rot, r} }, bridges = { {x, z, rot, length, river} } }. Déterministe.
	function P.plan()
		local items = {}
		local function fits(kind, x, z, opts)
			local r = KIND_RADIUS[kind]
			if P.blocked(x, z, r, opts) then
				return false
			end
			for _, it in ipairs(items) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + Placement.MIN_GAP then
					return false
				end
			end
			return true
		end
		local function add(kind, x, z, rot)
			items[#items + 1] = { kind = kind, x = x, z = z, rot = rot, r = KIND_RADIUS[kind], y = P.groundY(x, z) }
		end
		local plan = Config.Assets.propsPlan
		-- 1. par domaine : une cabane face au centre du domaine et une ligne de barrières alignée (jamais dans l'eau)
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			for _, off in ipairs({ { -28, 12 }, { 28, 12 }, { -28, -12 }, { 28, -12 } }) do
				if (plan.hut or 0) > 0 and fits("hut", cx + off[1], cz + off[2], { allowDomain = true }) then
					add("hut", cx + off[1], cz + off[2], Placement.facing(cx - (cx + off[1]), cz - (cz + off[2])))
					break
				end
			end
			local perDomain = math.ceil((plan.fence or 0) / #Config.RIVALS)
			for k = 0, perDomain - 1 do
				local fx, fz = cx - 20.25 + k * 13.5, cz - 34 -- côté nord (le côté sud porte le chemin d'arrivée)
				if fits("fence", fx, fz, { allowDomain = true }) then
					add("fence", fx, fz, 0) -- alignées sur l'axe X, même rotation : jamais de barrières qui se croisent
				end
			end
		end
		-- 2. décor libre : grille de cellules parcourue dans un ordre fixe (mélange déterministe), un genre par cellule selon les quantités du plan
		local kinds = {}
		local remaining = { tree = plan.tree or 0, fir = plan.fir or 0, rock = plan.rock or 0, bush = plan.bush or 0 }
		local order = { "tree", "rock", "fir", "bush" }
		local left = remaining.tree + remaining.fir + remaining.rock + remaining.bush
		local idx = 0
		while left > 0 do
			idx = idx % #order + 1
			local k = order[idx]
			if remaining[k] > 0 then
				remaining[k] = remaining[k] - 1
				left = left - 1
				kinds[#kinds + 1] = k
			end
		end
		local cells = {}
		local lo, hi = -half + 70, half - 70
		local cell = Placement.CELL
		for gx = lo, hi, cell do
			for gz = lo, hi, cell do
				cells[#cells + 1] = { gx + cell / 2, gz + cell / 2 }
			end
		end
		local seed = 4093 -- Park–Miller : mélange déterministe des cellules
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		for i = #cells, 2, -1 do
			local j = 1 + math.floor(rnd() * i)
			cells[i], cells[j] = cells[j], cells[i]
		end
		local ki = 1
		for _, c in ipairs(cells) do
			if ki > #kinds then
				break
			end
			local kind = kinds[ki]
			local x, z = c[1] + (rnd() - 0.5) * 12, c[2] + (rnd() - 0.5) * 12
			if math.sqrt(x * x + z * z) <= (M.decorRadius or math.huge) and fits(kind, x, z) then
				add(kind, x, z, rnd() * 360)
				ki = ki + 1
			end
		end
		-- 3. ponts : centrés sur la rivière, plus longs qu'elle (les deux rives sont reliées)
		local bridges = {}
		for _, rv in ipairs(geo.rivers) do
			local length = rv.half * 2 + 2 * geo.bridgeBank
			for _, along in ipairs(rv.bridgesAt) do
				if rv.axis == "z" then
					bridges[#bridges + 1] = { x = along, z = rv.at, rot = 90, length = length, river = rv }
				else
					bridges[#bridges + 1] = { x = rv.at, z = along, rot = 0, length = length, river = rv }
				end
			end
		end
		return { items = items, bridges = bridges }
	end

	-- Décor fin (fleurs, touffes, pierres, lanternes) : mêmes règles (rien dans l'eau ni sur un chemin), espacement plus serré, après le plan principal.
	-- Retourne { {kind, x, z, rot, r} } ; kinds : flower_a/b/c, tuft, stone_flat, stone_round, lantern. Les lanternes bordent les chemins (à 5 studs).
	local DECO_RADIUS = { flower_a = 1, flower_b = 1, flower_c = 1, tuft = 1, stone_flat = 1.5, stone_round = 1.5, lantern = 1 }
	Placement.DECO_RADIUS = DECO_RADIUS
	function P.decor(planItems, counts)
		counts = counts or { flowers = 36, tufts = 24, stones = 18, lanterns = 12 }
		local out = {}
		local function fits(kind, x, z)
			local r = DECO_RADIUS[kind]
			if P.blocked(x, z, r, { allowDomain = true }) then
				return false
			end
			for _, it in ipairs(planItems or {}) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 1 then
					return false
				end
			end
			for _, it in ipairs(out) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 0.5 then
					return false
				end
			end
			return true
		end
		local seed = 7919
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		-- lanternes le long des chemins (un côté, tous les ~28 studs)
		local placedLanterns = 0
		for _, seg in ipairs(P.pathSegments()) do
			local dx, dz = seg[3] - seg[1], seg[4] - seg[2]
			local len = math.sqrt(dx * dx + dz * dz)
			local nx, nz = -dz / len, dx / len
			local steps = math.max(1, math.floor(len / 28))
			for k = 1, steps do
				if placedLanterns >= counts.lanterns then
					break
				end
				local t = (k - 0.5) / steps
				local x, z = seg[1] + dx * t + nx * (geo.pathHalf + 3.5), seg[2] + dz * t + nz * (geo.pathHalf + 3.5)
				if fits("lantern", x, z) then
					out[#out + 1] = { kind = "lantern", x = x, z = z, rot = 0, r = DECO_RADIUS.lantern, y = P.groundY(x, z) }
					placedLanterns = placedLanterns + 1
				end
			end
		end
		-- fleurs, touffes, pierres : cellules de 24 studs dans un ordre mélangé déterministe ; les fleurs se regroupent autour des domaines et des chemins
		local kinds = {}
		for i = 1, counts.flowers do
			kinds[#kinds + 1] = ({ "flower_a", "flower_b", "flower_c" })[i % 3 + 1]
		end
		for _ = 1, counts.tufts do
			kinds[#kinds + 1] = "tuft"
		end
		for i = 1, counts.stones do
			kinds[#kinds + 1] = i % 2 == 0 and "stone_flat" or "stone_round"
		end
		local cells = {}
		local cell, lo, hi = 24, -half + 60, half - 60
		for gx = lo, hi, cell do
			for gz = lo, hi, cell do
				cells[#cells + 1] = { gx + cell / 2, gz + cell / 2 }
			end
		end
		for i = #cells, 2, -1 do
			local j = 1 + math.floor(rnd() * i)
			cells[i], cells[j] = cells[j], cells[i]
		end
		local ki = 1
		for _, c in ipairs(cells) do
			if ki > #kinds then
				break
			end
			local x, z = c[1] + (rnd() - 0.5) * 14, c[2] + (rnd() - 0.5) * 14
			if fits(kinds[ki], x, z) then
				out[#out + 1] = { kind = kinds[ki], x = x, z = z, rot = rnd() * 360, r = DECO_RADIUS[kinds[ki]], y = P.groundY(x, z) }
				ki = ki + 1
			end
		end
		return out
	end

	-- Décor de village de la carte (modèles scn_*) : candidats sur des anneaux autour de l'arène, ordre fixe ; mêmes règles que plan() (rien dans l'eau, sur un
	-- chemin, une base, un domaine ni sur un objet du plan). Retourne { {kind, x, z, rot, r, y} }.
	local VILLAGE = { { "scn_tour_cloche", 1 }, { "scn_maison_colombages", 3 }, { "scn_puits", 2 }, { "scn_pin_haut", 6 }, { "scn_rocher_a", 3 }, { "scn_rocher_b", 3 }, { "scn_rocher_c", 3 } }
	Placement.VILLAGE = VILLAGE
	function P.scenery(planItems)
		local out = {}
		local dims = Config.Assets.sceneryDims
		for _, entry in ipairs(VILLAGE) do
			local kind, want = entry[1], entry[2]
			local r = dims[kind].r
			local got, tries = 0, 0
			while got < want and tries < 400 do
				tries = tries + 1
				local ang = math.rad((tries * 137.5 + #out * 23) % 360)
				local rad = 105 + (tries * 29) % 110 -- anneau de 105 à 215 studs : entre l'arène et les bases
				local x, z = math.sin(ang) * rad, -math.cos(ang) * rad
				local ok = not P.blocked(x, z, r, {})
				if ok then
					for _, it in ipairs(planItems or {}) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 2 then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, it in ipairs(out) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 3 then
							ok = false
							break
						end
					end
				end
				if ok then
					out[#out + 1] = { kind = kind, x = x, z = z, rot = Placement.facing(-x, -z), r = r, y = P.groundY(x, z) }
					got = got + 1
				end
			end
		end
		return out
	end

	return P
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Culling</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Culling
-- Masquage des zones éloignées, côté client, SANS toucher à StreamingEnabled : logique PURE testée hors de Roblox. Une zone (domaine : plateau et contenu) plus
-- loin que `cullAt` du joueur est masquée (transparence locale, lumières, particules et étiquettes coupées) ; elle réapparaît en dessous de `showAt`
-- (hystérésis : pas de clignotement à la limite). Le travail est découpé en lots (`chunks`) pour ne jamais bloquer une image.
local Culling = {}

-- Retourne true si la zone doit être MASQUÉE. wasCulled : état actuel. Distance invalide (nil, NaN) : on ne masque rien (sûr).
function Culling.decide(distance, wasCulled, cullAt, showAt)
	if type(distance) ~= "number" or distance ~= distance then
		return false
	end
	if wasCulled then
		return distance > showAt
	end
	return distance > cullAt
end

-- Distance horizontale d'un point à une zone circulaire, bord compris (0 dans la zone).
function Culling.distanceTo(px, pz, zone)
	local d = math.sqrt((px - zone.x) ^ 2 + (pz - zone.z) ^ 2) - zone.radius
	return d > 0 and d or 0
end

-- Découpe une liste en lots de `size` éléments (au moins 1).
function Culling.chunks(list, size)
	size = math.max(1, math.floor(size or 1))
	local out = {}
	for i = 1, #list, size do
		local lot = {}
		for j = i, math.min(i + size - 1, #list) do
			lot[#lot + 1] = list[j]
		end
		out[#out + 1] = lot
	end
	return out
end

return Culling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">AssetReportUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/AssetReportUi
-- Diagnostic visible des modèles Blender (Config.Debug.AssetReport) : petite étiquette « Blender N/M » en bas à gauche (hub et partie) ; un clic ou F4 ouvre le
-- rapport complet (catégories et échecs : nom, ID, message). Le rapport vient du serveur (StringValue « AssetReport » dans ReplicatedStorage), imprimé aussi
-- dans la console client par lignes « [Assets] ». Tout sous pcall, jamais d'erreur.
local AssetReportUi = {}

-- Texte de l'étiquette : « Blender N/M » (ou « Blender … » tant que le rapport n'est pas arrivé).
function AssetReportUi.label(loaded, requested)
	if type(loaded) ~= "number" or type(requested) ~= "number" then
		return "Blender …"
	end
	return ("Blender %d/%d"):format(loaded, requested)
end

function AssetReportUi.start(Config, player, ReplicatedStorage, UserInputService)
	if not (Config.Debug and Config.Debug.AssetReport) then
		return nil
	end
	local ok, gui = pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "AssetReport"
		g.ResetOnSpawn = false
		g.DisplayOrder = 90
		local lbl = Instance.new("TextButton")
		lbl.Name = "Label"
		lbl.AnchorPoint = Vector2.new(0, 1)
		lbl.Position = UDim2.new(0, 8, 1, -8)
		lbl.Size = UDim2.fromOffset(130, 22)
		lbl.BackgroundColor3 = Color3.new(0, 0, 0)
		lbl.BackgroundTransparency = 0.5
		lbl.Font = Enum.Font.Code
		lbl.TextSize = 13
		lbl.TextColor3 = Color3.fromRGB(190, 255, 190)
		lbl.Text = AssetReportUi.label(nil, nil)
		lbl.AutoButtonColor = false
		lbl.Parent = g
		local box = Instance.new("TextLabel")
		box.Name = "Details"
		box.AnchorPoint = Vector2.new(0, 1)
		box.Position = UDim2.new(0, 8, 1, -34)
		box.Size = UDim2.new(0.8, 0, 0.6, 0)
		box.BackgroundColor3 = Color3.new(0, 0, 0)
		box.BackgroundTransparency = 0.25
		box.Font = Enum.Font.Code
		box.TextSize = 12
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
		box.TextWrapped = true
		box.Visible = false
		box.Text = ""
		box.Parent = g
		lbl.Activated:Connect(function()
			box.Visible = not box.Visible
		end)
		g.Parent = player:WaitForChild("PlayerGui")
		return g
	end)
	if not ok then
		return nil
	end
	task.spawn(function()
		local rv = ReplicatedStorage:WaitForChild("AssetReport", 120)
		if not rv then
			pcall(function()
				gui.Label.Text = "Blender : pas de rapport"
			end)
			return
		end
		pcall(function()
			gui.Label.Text = AssetReportUi.label(rv:GetAttribute("Loaded"), rv:GetAttribute("Requested"))
			gui.Details.Text = rv.Value
			for line in rv.Value:gmatch("[^\n]+") do
				print(line) -- rapport dans la console client
			end
		end)
	end)
	pcall(function()
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F4 then
				gui.Details.Visible = not gui.Details.Visible
			end
		end)
	end)
	return gui
end

return AssetReportUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Layout</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Layout
-- Disposition PURE de l'interface fixe (HUD) : tout est ancré aux bords (compteurs et objectif à gauche, bannière et notifications en haut
-- à droite, conseils en bas à gauche, boutons de menu en colonne en bas à droite) ; la zone centrale reste libre pour voir le personnage.
-- Testée avec une matrice d'appareils (tests/run.luau). Unités : pixels « de conception » ; le HUD est mis à l'échelle par `scale`.
local Layout = {}

Layout.MIN_SCALE = 0.85 -- en dessous, les boutons passent sous 44 px (cible tactile minimale)
Layout.MAX_SCALE = 1.25
Layout.EDGE = 8
Layout.NAV_BUTTON = 52
Layout.NAV_GAP = 4
-- Zone centrale à garder libre (en fraction de l'écran) : le personnage et la caméra.
Layout.CENTER = { x0 = 0.32, x1 = 0.68, y0 = 0.32, y1 = 0.75 }

function Layout.scaleFor(vw, vh)
	local s = math.min(vw / 900, vh / 520)
	if s ~= s then
		s = 1
	end
	return math.max(Layout.MIN_SCALE, math.min(Layout.MAX_SCALE, s))
end

-- Rectangles { x, y, w, h } en pixels de conception pour un écran de vw x vh pixels réels. Retourne (rects, scale, dw, dh).
function Layout.rects(vw, vh, navCount)
	navCount = navCount or 6
	local s = Layout.scaleFor(vw, vh)
	local dw, dh = vw / s, vh / s
	local e = Layout.EDGE
	local navH = navCount * Layout.NAV_BUTTON + (navCount - 1) * Layout.NAV_GAP
	local navW = Layout.NAV_BUTTON
	local rightW = math.min(330, math.max(180, dw - 196 - 3 * e)) -- bannière et notifications : à droite des compteurs
	local nav = { x = dw - e - navW, y = dh - e - navH, w = navW, h = navH }
	-- Notifications : sous la bannière, à droite des compteurs ; décalées à gauche de la colonne de menu si celle-ci monte jusqu'à elles.
	local toastsTop, toastsH = e + 46, 76
	local right = (nav.y < toastsTop + toastsH) and (nav.x - e) or (dw - e)
	local toastsW = math.min(240, right - (e + 196 + e))
	local r = {
		pillCoins = { x = e, y = e, w = 196, h = 52 },
		pillSpeed = { x = e, y = e + 58, w = 196, h = 52 },
		objective = { x = e, y = e + 118, w = 196, h = 62 },
		carry = { x = e, y = e + 188, w = 170, h = 26 },
		hp = { x = e, y = dh - e - 44 - 28, w = 170, h = 22 }, -- au-dessus des conseils, bas gauche (jamais au centre)
		banner = { x = dw - e - rightW, y = e, w = rightW, h = 40 },
		toasts = { x = right - toastsW, y = toastsTop, w = toastsW, h = toastsH },
		nav = nav,
		hint = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 },
		offer = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 }, -- offre d'achat non bloquante : prend la place du conseil (jamais les deux)
	}
	return r, s, dw, dh
end

local function overlap(a, b)
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end
Layout.overlap = overlap

-- Zone centrale à garder libre, en pixels de conception pour cet écran.
function Layout.centerRect(vw, vh)
	local s = Layout.scaleFor(vw, vh)
	local c = Layout.CENTER
	return { x = c.x0 * vw / s, y = c.y0 * vh / s, w = (c.x1 - c.x0) * vw / s, h = (c.y1 - c.y0) * vh / s }
end

return Layout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Party</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Party
-- Logique PURE du hub : file d'attente des zones de lancement (1 à 5 joueurs), création de partie, registre des parties ouvertes
-- (visibles des amis), rejoindre en cours de partie, repli de téléportation. Toutes les dépendances Roblox sont injectées pour pouvoir
-- tester avec un faux TeleportService (tests/run.luau). Aucune erreur ne sort de ce module : les échecs sont des valeurs de retour.
--   deps.clock() -> secondes
--   deps.reserve(placeId) -> accessCode            (réel : TeleportService:ReserveServer ; peut lever une erreur)
--   deps.teleport(players, placeId, accessCode|nil, data)   (réel : TeleportToPrivateServer / TeleportAsync ; peut lever une erreur)
--   deps.store : { get(key), update(key, fn) , remove(key), list() }   (réel : MemoryStoreService ; peut lever une erreur)
--   deps.log(msg) (facultatif)
local Party = {}

-- Un serveur de jeu accepte-t-il un joueur de plus ? count = joueurs déjà présents.
function Party.admit(count, max)
	return count < max
end

-- Admission d'un joueur dans un serveur de JEU. serverPartyId = identifiant de partie du serveur (celui du premier arrivé, nil si aucun),
-- data = TeleportData reçu à l'arrivée (nil si arrivée directe), count = joueurs déjà présents, role = Config.Game.roleFor(PlaceId).
-- Liste blanche : sur un serveur de partie, seul un joueur envoyé par le hub avec LE MÊME partyId entre. Retourne (true) ou (false, raison).
function Party.admitJoin(serverPartyId, data, count, max, role)
	if not Party.admit(count, max) then
		return false, "full"
	end
	if role ~= "game" then
		return true -- Studio / place non publiée : pas de liste blanche
	end
	local pid = type(data) == "table" and data.partyId or nil
	if serverPartyId ~= nil then
		if pid ~= serverPartyId or data.from ~= "hub" then
			return false, "not_member"
		end
	elseif pid ~= nil and data.from ~= "hub" then
		return false, "not_member"
	end
	return true
end

-- Retour d'un joueur de la partie vers le hub. deps.teleport(players, placeId, nil, data) peut lever une erreur (réseau, lieu non autorisé).
-- Retourne { ok = true } ou { ok = false, message } : le joueur reste alors dans la partie (aucune perte), avec un message clair.
function Party.returnToHub(Config, deps, player, partyId)
	local hub = Config.Game.Places.hub
	if type(hub) ~= "number" or hub <= 0 then
		return { ok = false, message = "Le hub n'est pas configuré. Tu restes dans la partie." }
	end
	local ok, err = pcall(deps.teleport, { player }, hub, nil, { from = "game", partyId = partyId, reason = "leave" })
	if not ok then
		if deps.log then
			deps.log("[Party] retour au hub impossible : " .. tostring(err))
		end
		return { ok = false, message = "Impossible de retourner au hub pour l'instant. Tu restes dans la partie : réessaie dans un instant." }
	end
	return { ok = true }
end

-- Même message pour « inexistante », « terminée » et « tu n'es pas ami de l'hôte » : rien n'est révélé sur les parties des autres.
local GONE_MESSAGE = "Cette partie n'existe plus : elle vient de se terminer ou ton ami est parti."

function Party.new(Config, deps)
	local G = Config.Game
	local P = { queues = {}, where = {} } -- queues[clé] = { size, mode, members = {userId...}, firstAt, readyAt } ; clé = taille (arène) ou "c<taille>" (château)

	local function log(msg)
		if deps.log then
			deps.log("[Party] " .. msg)
		end
	end

	-- Clé d'une file : la taille seule pour l'arène (compatibilité), « c<taille> » pour le mode Château.
	function P.key(size, mode)
		return mode == "castle" and ("c" .. tostring(size)) or size
	end

	for _, size in ipairs(G.Sizes) do
		P.queues[size] = { size = size, mode = "arena", members = {} }
		P.queues["c" .. size] = { size = size, mode = "castle", members = {} }
	end

	---------------------------------------------------------------- zones de lancement (file d'attente)
	function P.enter(userId, size, mode)
		local key = P.key(size, mode)
		local q = P.queues[key]
		if not q then
			return false, "taille inconnue"
		end
		if P.where[userId] then
			if P.where[userId] == key then
				return true
			end
			P.leave(userId)
		end
		if #q.members >= q.size then
			return false, "zone pleine"
		end
		q.members[#q.members + 1] = userId
		P.where[userId] = key
		if #q.members == 1 then
			q.firstAt = deps.clock()
		end
		q.readyAt = nil
		return true
	end

	function P.leave(userId)
		local key = P.where[userId]
		if not key then
			return false
		end
		local q = P.queues[key]
		for i, id in ipairs(q.members) do
			if id == userId then
				table.remove(q.members, i)
				break
			end
		end
		P.where[userId] = nil
		q.readyAt = nil
		if #q.members == 0 then
			q.firstAt = nil
		end
		return true
	end

	-- État affiché d'une zone : { size, mode = "arena" | "castle", count, countdown (secondes ou nil), state = "empty" | "waiting" | "full" }
	function P.status(size, mode)
		local q = P.queues[P.key(size, mode)]
		local now = deps.clock()
		local count = #q.members
		local out = { size = size, count = count, queue = mode == "castle" and "castle" or "arena" }
		out.mode = count == 0 and "empty" or (count >= size and "full" or "waiting") -- (nom historique : état de la file)
		if count > 0 then
			if count >= size then
				q.readyAt = q.readyAt or (now + (size == 1 and G.SoloCountdown or G.CountdownFull))
				out.countdown = math.max(0, q.readyAt - now)
			else
				q.readyAt = nil
				out.countdown = math.max(0, q.firstAt + G.PartialWait - now)
			end
		end
		return out
	end

	-- Groupes prêts à partir : { size, mode, members }. Les membres sont retirés de la file.
	function P.collectLaunches()
		local out = {}
		local keys = {}
		for _, size in ipairs(G.Sizes) do
			keys[#keys + 1] = size
			keys[#keys + 1] = "c" .. size
		end
		for _, key in ipairs(keys) do
			local q = P.queues[key]
			if #q.members > 0 then
				local st = P.status(q.size, q.mode)
				if st.countdown ~= nil and st.countdown <= 0 then
					local members = table.clone(q.members)
					for _, id in ipairs(members) do
						P.where[id] = nil
					end
					q.members = {}
					q.firstAt, q.readyAt = nil, nil
					out[#out + 1] = { size = q.size, mode = q.mode, members = members }
				end
			end
		end
		return out
	end

	---------------------------------------------------------------- registre des parties
	-- Identifiant imprévisible (GUID injecté : HttpService:GenerateGUID). Jamais dérivé de l'hôte ni de l'heure.
	local function newPartyId()
		if deps.guid then
			return deps.guid()
		end
		local t = {}
		for i = 1, 4 do
			t[i] = string.format("%08x", math.random(0, 0x7fffffff))
		end
		return table.concat(t, "-")
	end

	local function alive(e)
		return type(e) == "table" and deps.clock() - (e.createdAt or 0) < G.PartyTTL
	end

	-- Teleporte un groupe vers le lieu de jeu. Essaie les méthodes de G.Fallbacks dans l'ordre.
	-- group = { size = n, members = {userId...}, players = {Player...}, hostName = "..." }
	-- Retourne { ok = true, mode, partyId? } ou { ok = false, reason, message }.
	function P.launch(group)
		local gamePlace = G.Places.game
		if type(gamePlace) ~= "number" or gamePlace <= 0 then
			return { ok = false, reason = "lieu de jeu non configuré", message = "Le lieu de jeu n'est pas configuré. Préviens le créateur." }
		end
		local size = math.min(math.max(group.size or #group.members, 1), G.MaxPlayers)
		local mode = group.mode == "castle" and "castle" or "arena"
		local data = { from = "hub", size = size, late = false, mode = mode }
		local lastErr = "aucune méthode de téléportation"
		for _, method in ipairs(G.Fallbacks) do
			if method == "reserved" then
				local okR, code = pcall(deps.reserve, gamePlace)
				if okR and code then
					local partyId = newPartyId()
					data.partyId = partyId
					local okT, errT = pcall(deps.teleport, group.players, gamePlace, code, data)
					if okT then
						local entry = {
							id = partyId, host = group.members[1], hostName = group.hostName or "?", size = G.MaxPlayers, groupSize = size, mode = mode, count = #group.members,
							members = table.clone(group.members), code = code, createdAt = deps.clock(), open = true, -- toute partie (même solo) reste ouverte aux amis jusqu'au plafond
						}
						local okS, errS = pcall(deps.store.update, partyId, function()
							return entry
						end)
						if not okS then
							log("registre indisponible : " .. tostring(errS))
						end
						return { ok = true, mode = "reserved", partyId = partyId, registered = okS }
					end
					lastErr = "téléportation : " .. tostring(errT)
				else
					lastErr = "réservation : " .. tostring(code)
				end
			elseif method == "public" then
				data.partyId = nil
				local okT, errT = pcall(deps.teleport, group.players, gamePlace, nil, data)
				if okT then
					return { ok = true, mode = "public" }
				end
				lastErr = "téléportation publique : " .. tostring(errT)
			end
		end
		log("lancement impossible : " .. tostring(lastErr))
		return { ok = false, reason = lastErr, message = "Impossible de lancer la partie pour l'instant. Réessaie dans un instant." }
	end

	-- Parties ouvertes visibles par `viewerId` : celles de ses amis (friends[userId] = true) ou celles où il est déjà inscrit.
	-- Retourne une liste triée { id, hostName, count, size }.
	function P.visibleFor(viewerId, friends)
		local okL, list = pcall(deps.store.list)
		if not okL or type(list) ~= "table" then
			return {}, false
		end
		local out = {}
		for _, e in ipairs(list) do
			if alive(e) and e.open and e.count < e.size and e.count < G.MaxPlayers then
				local mine = false
				for _, id in ipairs(e.members or {}) do
					if id == viewerId then
						mine = true
					end
				end
				if not mine and friends and friends[e.host] then
					out[#out + 1] = { id = e.id, hostName = e.hostName, count = e.count, size = e.size }
				end
			end
		end
		table.sort(out, function(a, b)
			return a.id < b.id
		end)
		return out, true
	end

	-- Rejoindre une partie en cours. Retourne { ok = true } ou { ok = false, reason = "full" | "gone" | "registry" | "teleport", message }.
	-- friends = ensemble d'amis du joueur calculé par le SERVEUR (jamais fourni par le client) : seuls les amis de l'hôte (ou un joueur déjà
	-- inscrit) peuvent rejoindre, même s'ils connaissent l'identifiant de la partie.
	function P.join(partyId, player, userId, friends)
		if type(partyId) ~= "string" then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local okG, e = pcall(deps.store.get, partyId)
		if not okG then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not alive(e) or not e.open then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local isMember = false
		for _, id in ipairs(e.members or {}) do
			if id == userId then
				isMember = true
			end
		end
		if not isMember and not (type(friends) == "table" and friends[e.host]) then
			log("refus : " .. tostring(userId) .. " n'est pas ami de l'hôte")
			return { ok = false, reason = "gone", message = GONE_MESSAGE } -- même message : ne révèle pas son existence
		end
		-- réservation atomique de la place (compte + membre) ; refus si plein
		local reserved = false
		local okU, errU = pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" or old.count >= old.size or old.count >= G.MaxPlayers then
				return nil
			end
			for _, id in ipairs(old.members) do
				if id == userId then
					return nil
				end
			end
			old.count = old.count + 1
			old.members[#old.members + 1] = userId
			reserved = true
			return old
		end)
		if not okU then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not reserved then
			return { ok = false, reason = "full", message = "Cette partie est pleine (" .. G.MaxPlayers .. " joueurs maximum)." }
		end
		local okT, errT = pcall(deps.teleport, { player }, G.Places.game, e.code, { from = "hub", partyId = partyId, size = e.size, late = true, mode = e.mode or "arena" })
		if not okT then
			P.leaveParty(partyId, userId) -- annule la place prise
			log("rejoindre : " .. tostring(errT))
			return { ok = false, reason = "teleport", message = "Impossible de rejoindre la partie pour l'instant." }
		end
		return { ok = true }
	end

	-- Libère la place d'un joueur (retour au hub, échec de téléportation). Supprime la partie quand elle est vide.
	function P.leaveParty(partyId, userId)
		pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" then
				return nil
			end
			for i, id in ipairs(old.members) do
				if id == userId then
					table.remove(old.members, i)
					old.count = math.max(0, old.count - 1)
					break
				end
			end
			return old
		end)
		-- plus personne dans la partie : elle est retirée du registre (les amis ne la voient plus, « n'existe plus » s'ils réessaient)
		local okG, e = pcall(deps.store.get, partyId)
		if okG and type(e) == "table" and e.count <= 0 then
			pcall(deps.store.remove, partyId)
		end
	end

	return P
end

return Party
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Spawn</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Spawn
-- Décisions PURES du filet anti-chute et de la garantie de personnage (testées hors Roblox). Le module SpawnGuard les applique.
local Spawn = {}

-- Réglages par rôle. floorY : en dessous, le joueur est tombé hors du monde. half : demi-côté de la zone jouable (au-delà : hors zone).
-- freefallSpeed : vitesse verticale (studs/s, négative) au-delà de laquelle une chute au-dessus du sol est anormale.
Spawn.PRESETS = {
	game = { floorY = -25, half = 590, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 400 },
	hub = { floorY = -25, half = 205, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 140 },
}

-- st = { hasChar, alive, waited, x, y, z, vy } ; waited = secondes sans personnage. Retourne nil ou une raison :
-- "nochar" (aucun personnage depuis trop longtemps), "void" (sous le sol), "freefall" (chute libre), "outside" (hors de la zone), "sky" (trop haut).
function Spawn.rescueReason(st, cfg)
	if not st.hasChar then
		if (st.waited or 0) >= cfg.noCharTimeout then
			return "nochar"
		end
		return nil
	end
	if st.alive == false or st.y == nil then
		return nil
	end
	if st.y ~= st.y or (st.x or 0) ~= (st.x or 0) or (st.z or 0) ~= (st.z or 0) then
		return "void" -- NaN : position corrompue
	end
	if st.y < cfg.floorY then
		return "void"
	end
	if math.abs(st.x or 0) > cfg.half or math.abs(st.z or 0) > cfg.half then
		return "outside"
	end
	if st.y > cfg.sky then
		return "sky"
	end
	if (st.vy or 0) < cfg.freefallSpeed and st.y < cfg.freefallY then
		return "freefall"
	end
	return nil
end

-- Compteurs de sauvetages : une boucle de sauvetages (> maxPerMinute) est signalée pour ne pas masquer un vrai bug.
function Spawn.newTally()
	local t = { counts = {}, total = 0, times = {} }
	function t.add(kind, now)
		t.counts[kind] = (t.counts[kind] or 0) + 1
		t.total = t.total + 1
		t.times[#t.times + 1] = now
		while #t.times > 0 and now - t.times[1] > 60 do
			table.remove(t.times, 1)
		end
		return #t.times
	end
	return t
end

return Spawn
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">SpawnGuard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/SpawnGuard
-- Garantit qu'un joueur a toujours un personnage dans la zone de jeu : (1) si aucun personnage n'apparaît dans les `noCharTimeout`
-- secondes (script d'arrivée planté, CharacterAutoLoads coupé), il est chargé ici ; (2) un joueur sous le sol, hors zone, trop haut ou en
-- chute libre est replacé au point de départ ; (3) chaque événement est tracé dans la console serveur avec le préfixe [Spawn].
-- Les décisions sont dans Spawn (pur, testé) ; ce module n'applique que du Roblox. Aucune erreur ne sort d'ici (tout sous pcall).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spawn = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Spawn"))

local SpawnGuard = {}

-- opts = { role = "game" | "hub", safeCFrame = function(player) -> CFrame, interval = 0.5 }
function SpawnGuard.attach(opts)
	local cfg = Spawn.PRESETS[opts.role] or Spawn.PRESETS.game
	local tally = Spawn.newTally()
	local noChar = {} -- Player -> secondes sans personnage
	local loading = {} -- Player -> true pendant un LoadCharacterAsync lancé ici
	local function log(msg)
		print("[Spawn] (" .. opts.role .. ") " .. msg)
	end

	local function safeCF(player)
		local ok, cf = pcall(opts.safeCFrame, player)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
		return CFrame.new(0, 10, 0)
	end

	local function place(player, root, reason)
		local n = tally.add(reason, os.clock())
		local cf = safeCF(player)
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		log(player.Name .. " replacé (" .. reason .. ") vers " .. string.format("%.0f, %.0f, %.0f", cf.X, cf.Y, cf.Z) .. " [" .. tally.total .. " au total]")
		if n > 6 then
			warn("[Spawn] (" .. opts.role .. ") plus de 6 sauvetages en une minute : un joueur retombe en boucle, vérifie le point de départ")
		end
	end

	Players.PlayerAdded:Connect(function(player)
		log(player.Name .. " arrivé (" .. #Players:GetPlayers() .. " joueur(s), CharacterAutoLoads = " .. tostring(Players.CharacterAutoLoads) .. ")")
		player.CharacterAdded:Connect(function(char)
			log(player.Name .. " : personnage apparu")
			task.defer(function()
				local root = char:WaitForChild("HumanoidRootPart", 5)
				if root and player.Parent then
					local st = { hasChar = true, alive = true, x = root.Position.X, y = root.Position.Y, z = root.Position.Z, vy = 0 }
					local reason = Spawn.rescueReason(st, cfg)
					if reason then
						place(player, root, reason)
					end
				end
			end)
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(opts.interval or 0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(function()
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not root then
						noChar[player] = (noChar[player] or 0) + (opts.interval or 0.5)
					else
						noChar[player] = 0
					end
					local pos = root and root.Position
					local st = {
						hasChar = root ~= nil, alive = hum == nil or hum.Health > 0, waited = noChar[player] or 0,
						x = pos and pos.X, y = pos and pos.Y, z = pos and pos.Z, vy = root and root.AssemblyLinearVelocity.Y or 0,
					}
					local reason = Spawn.rescueReason(st, cfg)
					if reason == "nochar" then
						if not loading[player] and player.Parent then
							loading[player] = true
							noChar[player] = 0
							tally.add("nochar", os.clock())
							log(player.Name .. " sans personnage depuis " .. cfg.noCharTimeout .. " s : chargement forcé")
							task.spawn(function()
								local ok, err = pcall(function()
									player:LoadCharacterAsync()
								end)
								if not ok then
									warn("[Spawn] (" .. opts.role .. ") LoadCharacterAsync a échoué pour " .. player.Name .. " : " .. tostring(err))
								end
								loading[player] = nil
							end)
						end
					elseif reason and root then
						place(player, root, reason)
					end
				end)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		noChar[player] = nil
		loading[player] = nil
	end)
	log("filet de sécurité actif (sol " .. cfg.floorY .. ", demi-zone " .. cfg.half .. ")")
	return tally
end

return SpawnGuard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Assets (utilisé côté SERVEUR seulement : jeu et hub)
-- Chargement SÛR des modèles Roblox qui servent d'apparence aux œufs. Rien ici ne touche au gameplay : en cas d'échec quel qu'il soit,
-- cloneEgg retourne nil et l'appelant garde l'apparence par défaut. Les dépendances Roblox sont injectées (Assets.new(Config, deps)) pour
-- tester tous les cas d'échec avec un chargeur factice (tests/run.luau).
--   deps.loadAsset(id) -> modèle   (réel : InsertService:LoadAsset)
--   deps.spawn(fn), deps.wait(secondes), deps.clock() -> secondes   (réels : task.spawn, task.wait, os.clock)
--   deps.warn(message)  (facultatif)   deps.store(clé, modèle)  (facultatif : range le modèle, ex. dans ServerStorage)
local Assets = {}

-- Convention des modèles Blender : chaque pièce se nomme `Nom__RRGGBB` (hexadécimal). Retourne (r, g, b) en 0-255, ou nil si le nom n'a pas de
-- suffixe valide (exactement 6 chiffres hexadécimaux après le DERNIER « __ »). Pur et testé.
function Assets.parseColorSuffix(name)
	if type(name) ~= "string" then
		return nil
	end
	-- un doublon d'import Blender (« Sapin__2E7D4F.001 ») garde la couleur de son suffixe
	local hex = name:match("__(%x%x%x%x%x%x)$") or name:match("__(%x%x%x%x%x%x)%.%d+$")
	if not hex then
		return nil
	end
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

-- Clés des modèles d'effets (même liste que VfxKit.MODELS), pour l'export vers les clients.
Assets.vfxKeys = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Nom de base d'une pièce Blender : sans suffixe de couleur ni suffixe de doublon (« Lame__D8DCE8.001 » -> « Lame »).
function Assets.baseName(name)
	if type(name) ~= "string" then
		return ""
	end
	local n = name:gsub("%.%d+$", "")
	n = n:gsub("__%x%x%x%x%x%x$", "")
	return n
end

-- Met un modèle à la hauteur cible (studs) d'après GetExtentsSize, puis REMESURE : la hauteur obtenue doit être à ±10 % de la cible (deux corrections
-- au plus). Retourne (true, hauteur) ou (false, raison) : l'appelant ne pose alors pas le modèle (repli procédural), jamais d'échelle 1 brute.
function Assets.fitHeight(model, target)
	local ok, res = pcall(function()
		if type(target) ~= "number" or target ~= target or target <= 0 or target > 1000 then
			error("hauteur cible invalide")
		end
		local height
		for _ = 1, 3 do
			local e = model:GetExtentsSize()
			height = e and e.Y
			if type(height) ~= "number" or height ~= height or height < 0.05 or height > 1e6 then
				error("mesure impossible")
			end
			if math.abs(height - target) <= 0.1 * target and _ > 1 then
				return height
			end
			model:ScaleTo(model:GetScale() * target / height)
		end
		local e = model:GetExtentsSize()
		height = e and e.Y
		if type(height) ~= "number" or math.abs(height - target) > 0.1 * target then
			error("hauteur hors tolérance")
		end
		return height
	end)
	return ok, res
end

function Assets.new(Config, deps)
	local A = { templates = {}, status = {}, failedIds = {}, requested = {}, placeFailures = {} } -- status[clé] = { ok, reason | parts, removed } ; failedIds[id] = raison
	local warned = {} -- un seul avertissement par ID
	local byId = {} -- identifiant -> { model, status } des modèles déjà chargés
	local cfg = Config.Assets

	local function warn(msg, id)
		if id ~= nil then
			A.failedIds[id] = msg
			if warned[id] then
				return
			end
			warned[id] = true
		end
		if deps.warn then
			deps.warn("[Assets] " .. msg)
		end
	end

	-- Exécute fn avec un délai maximum (le chargeur réel peut ne jamais répondre). Retourne (ok, résultat | message).
	-- Si le résultat arrive après le délai, le modèle est détruit et ignoré.
	local function withTimeout(fn, seconds)
		local state = { done = false, abandoned = false }
		deps.spawn(function()
			local ok, res = pcall(fn)
			state.done, state.ok, state.res = true, ok, res
			if state.abandoned and ok and res ~= nil then
				pcall(function()
					res:Destroy()
				end)
			end
		end)
		local t0 = deps.clock()
		while not state.done and deps.clock() - t0 < seconds do
			deps.wait(0.1)
		end
		if not state.done then
			state.abandoned = true
			return false, "délai dépassé (" .. seconds .. " s)"
		end
		return state.ok, state.res
	end

	local function descendants(model)
		local ok, list = pcall(function()
			return model:GetDescendants()
		end)
		if ok and type(list) == "table" then
			return list
		end
		return nil
	end

	-- Retire tout ce qui est interdit, plafonne les particules, vérifie qu'il reste de la géométrie.
	-- Retourne (true, { parts, removed }) ou (false, raison). Ne lève jamais d'erreur.
	function A.sanitize(model, maxParts)
		maxParts = maxParts or cfg.maxParts
		if model == nil then
			return false, "modèle absent"
		end
		local list = descendants(model)
		if not list then
			return false, "modèle illisible ou corrompu"
		end
		local blocked = {}
		for _, d in ipairs(list) do
			local ok, className = pcall(function()
				return d.ClassName
			end)
			if not ok or type(className) ~= "string" then
				return false, "instance corrompue"
			end
			if Config.isBlockedClass(className) then
				blocked[#blocked + 1] = d
			end
		end
		for _, d in ipairs(blocked) do
			pcall(function()
				d:Destroy()
			end)
		end
		local after = descendants(model)
		if not after then
			return false, "modèle illisible après nettoyage"
		end
		local parts = 0
		for _, d in ipairs(after) do
			local okPart, isPart = pcall(function()
				return d:IsA("BasePart")
			end)
			if okPart and isPart then
				parts = parts + 1
			else
				local okEmitter, isEmitter = pcall(function()
					return d.ClassName == "ParticleEmitter"
				end)
				if okEmitter and isEmitter then
					pcall(function()
						if d.Rate > cfg.maxParticleRate then
							d.Rate = cfg.maxParticleRate
						end
					end)
				end
			end
		end
		if parts == 0 then
			return false, "modèle vide (aucune part)"
		end
		if parts > maxParts then
			return false, "modèle trop lourd (" .. parts .. " parts, maximum " .. maxParts .. ")"
		end
		return true, { parts = parts, removed = #blocked }
	end

	-- Applique la couleur lue dans le suffixe `__RRGGBB` du nom de chaque pièce (les couleurs du FBX ne sont jamais utilisées) ; sans suffixe, rien
	-- ne change. CastShadow = false pour les petits détails (arête la plus longue sous cfg.smallDetail studs). Retourne le nombre de pièces colorées.
	function A.colorize(model, keepMaterial)
		local make = deps.color or (Color3 and Color3.fromRGB)
		if not make then
			return 0
		end
		local list = descendants(model)
		if not list then
			return 0
		end
		local count = 0
		local MAT = deps.material or (Enum and Enum.Material)
		for _, d in ipairs(list) do
			local okName, name = pcall(function()
				return d.Name
			end)
			if MAT and not keepMaterial then
				-- matières : Metal et Neon seulement pour les pièces explicitement métalliques ou lumineuses (Metal sans reflets rend noir),
				-- tout le reste en plastique lisse, jamais de reflets
				pcall(function()
					if d:IsA("BasePart") then
						local base = Assets.baseName(okName and name or "")
						local metals, neons = cfg.metalParts or {}, cfg.neonParts or {}
						if metals[base] then
							d.Material = MAT.Metal
						elseif neons[base] then
							d.Material = MAT.Neon
						elseif d.Material ~= MAT.Plastic and d.Material ~= MAT.SmoothPlastic then
							d.Material = MAT.SmoothPlastic
						end
						d.Reflectance = 0
					end
				end)
			end
			local r, g, b = Assets.parseColorSuffix(okName and name or nil)
			if r then
				local isPart = false
				pcall(function()
					isPart = d:IsA("BasePart")
				end)
				if isPart then
					pcall(function()
						d.Color = make(r, g, b)
						count = count + 1
						pcall(function()
							if d.ClassName == "MeshPart" then
								d.TextureID = "" -- une texture importée teinterait la couleur (rendu sombre)
							end
							for _, c in ipairs(d:GetChildren()) do
								if c.ClassName == "SurfaceAppearance" then
									c:Destroy()
								end
							end
						end)
						local s = d.Size
						if s and math.max(s.X, s.Y, s.Z) < (cfg.smallDetail or 0.6) then
							d.CastShadow = false
						end
					end)
				end
			end
		end
		return count
	end

	-- Charge, nettoie et range un modèle. Retourne true si un modèle utilisable est disponible. Ne lève jamais d'erreur.
	function A.loadOne(key, id, maxParts)
		A.requested[key] = id
		-- un identifiant déjà chargé (même modèle sous une autre clé) est réutilisé : un seul LoadAsset par modèle
		if byId[id] then
			A.templates[key] = byId[id].model
			A.status[key] = byId[id].status
			return true
		end
		A.startedAt = A.startedAt or deps.clock()
		local t1 = deps.clock()
		local attempts = 1
		local ok, model = withTimeout(function()
			return deps.loadAsset(id)
		end, cfg.timeout)
		-- un seul nouvel essai (chargement refusé ou trop lent), tant que le plafond global de relance n'est pas atteint : un échec ne bloque jamais la suite
		if not ok and deps.clock() - A.startedAt < (cfg.retryUntil or 25) then
			deps.wait(0.4)
			attempts = 2
			ok, model = withTimeout(function()
				return deps.loadAsset(id)
			end, cfg.timeout)
		end
		if not ok then
			A.status[key] = { ok = false, reason = tostring(model), id = id, attempts = attempts, seconds = deps.clock() - t1 }
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(model) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local sOk, valid, info = pcall(A.sanitize, model, maxParts)
		if not sOk then
			valid, info = false, tostring(valid)
		end
		if not valid then
			A.status[key] = { ok = false, reason = tostring(info), id = id }
			pcall(function()
				if model ~= nil then
					model:Destroy()
				end
			end)
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(info) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local colored = 0
		local cOk, cn = pcall(A.colorize, model, key:sub(1, 2) == "v:" or key:sub(1, 6) == "m:vfx.") -- les effets gardent leur matière Neon
		if cOk then
			colored = cn
		end
		A.templates[key] = model
		A.status[key] = { ok = true, parts = info.parts, removed = info.removed, colored = colored, id = id, attempts = attempts, seconds = deps.clock() - t1 }
		byId[id] = { model = model, status = A.status[key] }
		if deps.store then
			pcall(deps.store, key, model)
		end
		return true
	end

	-- Charge une liste { {key, id, cap} } par LOTS PARALLÈLES (cfg.batchSize, 8 par défaut) : chaque modèle a son délai et son nouvel essai, un échec ou un modèle
	-- lent ne retarde jamais que son lot et n'empêche JAMAIS de lancer les suivants. Les identifiants en double sont chargés une seule fois.
	-- Retourne le nombre de modèles utilisables. Ne lève jamais d'erreur.
	function A.loadMany(entries)
		local first, dups, seen = {}, {}, {}
		for _, e in ipairs(entries) do
			A.requested[e.key] = e.id
			if byId[e.id] or seen[e.id] then
				dups[#dups + 1] = e
			else
				seen[e.id] = true
				first[#first + 1] = e
			end
		end
		local size = cfg.batchSize or 8
		local i = 1
		while i <= #first do
			local running = 0
			for j = i, math.min(i + size - 1, #first) do
				local e = first[j]
				running = running + 1
				deps.spawn(function()
					pcall(A.loadOne, e.key, e.id, e.cap)
					running = running - 1
				end)
			end
			while running > 0 do
				deps.wait(0.05)
			end
			i = i + size
		end
		for _, e in ipairs(dups) do
			pcall(A.loadOne, e.key, e.id, e.cap)
		end
		local loaded = 0
		for _, e in ipairs(entries) do
			if A.status[e.key] and A.status[e.key].ok then
				loaded = loaded + 1
			end
		end
		return loaded
	end

	-- Catégorie d'une clé de statut (pour le rapport) : arbres, chemins, protections d'œufs, base, village, pets, œufs, gardiens, décor...
	local CATEGORY = { trees = "arbres", paths = "chemins", eggguard = "protections d'œufs", base = "base", scenery = "village", guards = "gardiens", traps = "pièges", castle = "château", ground = "sol", deco = "décor", terrain = "relief", vfx = "effets", props = "accessoires" }
	function A.categoryOf(key)
		local grp = key:match("^m:(%a+)%.")
		if grp then
			return CATEGORY[grp] or grp
		end
		local prefix = key:match("^(%a+):")
		if prefix == "p" then
			return "pets"
		elseif prefix == "r" then
			return "œufs"
		elseif prefix == "d" then
			return "décor catalogue"
		elseif prefix == "x" then
			return "accessoires"
		elseif prefix == "t" then
			return "textures"
		end
		return "œufs"
	end

	-- Rapport par catégorie : { {cat, requested, loaded, fallback, failures = { {key, id, reason} }} } trié par nom ; les statuts sans demande (ID invalide) comptent.
	function A.report()
		local cats, order = {}, {}
		local function bucket(c)
			if not cats[c] then
				cats[c] = { cat = c, requested = 0, loaded = 0, fallback = 0, failures = {} }
				order[#order + 1] = c
			end
			return cats[c]
		end
		local keys, seenKey = {}, {}
		for k in pairs(A.requested) do
			keys[#keys + 1] = k
			seenKey[k] = true
		end
		for k in pairs(A.status) do
			if not seenKey[k] then
				keys[#keys + 1] = k
			end
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			local b = bucket(A.categoryOf(k))
			local st = A.status[k]
			b.requested = b.requested + 1
			if st and st.ok then
				b.loaded = b.loaded + 1
			else
				b.fallback = b.fallback + 1
				b.failures[#b.failures + 1] = { key = k, id = A.requested[k] or (st and st.id), reason = st and st.reason or "pas encore chargé" }
			end
		end
		table.sort(order)
		local out = {}
		for _, c in ipairs(order) do
			out[#out + 1] = cats[c]
		end
		return out
	end

	-- Lignes de texte du rapport (une par catégorie, puis une par échec) + totaux { loaded, requested }.
	function A.reportLines()
		local lines, loaded, requested = {}, 0, 0
		local rep = A.report()
		for _, b in ipairs(rep) do
			loaded, requested = loaded + b.loaded, requested + b.requested
			lines[#lines + 1] = ("[Assets] %s : %d/%d chargés, %d en repli"):format(b.cat, b.loaded, b.requested, b.fallback)
		end
		for _, b in ipairs(rep) do
			for _, f in ipairs(b.failures) do
				lines[#lines + 1] = ("[Assets]   ÉCHEC %s (ID %s) : %s"):format(tostring(f.key), tostring(f.id), tostring(f.reason))
			end
		end
		local shown = {}
		for _, f in ipairs(A.placeFailures) do
			if not shown[f] and #shown < 20 then -- un message distinct à la fois, 20 au plus
				shown[f] = true
				shown[#shown + 1] = f
				lines[#lines + 1] = "[Assets]   POSE REFUSÉE " .. f
			end
		end
		return lines, loaded, requested
	end

	-- Charge tous les modèles d'œufs (un par clé). onReady() est appelé une fois si au moins un modèle est utilisable.
	-- Retourne le nombre de modèles chargés. Ne lève jamais d'erreur ; ne fait rien si Config.Assets.Enabled est faux.
	function A.loadAll(onReady)
		if cfg.Enabled ~= true then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.eggs) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		if type(cfg.eggsByRarity) == "table" then -- modèles Blender par rareté (1..6 et « secret ») : prioritaires sur les modèles du catalogue, chargés en premier
			local rk = {}
			for rarity in pairs(cfg.eggsByRarity) do
				rk[#rk + 1] = rarity
			end
			table.sort(rk, function(a, b)
				return tostring(a) < tostring(b)
			end)
			for _, rarity in ipairs(rk) do
				local id = cfg.eggsByRarity[rarity]
				if type(id) == "number" and id > 0 and id % 1 == 0 then
					entries[#entries + 1] = { key = "r:" .. tostring(rarity), id = id }
				else
					A.status["r:" .. tostring(rarity)] = { ok = false, reason = "ID invalide" }
				end
			end
		end
		for _, key in ipairs(keys) do
			local id = cfg.eggs[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = key, id = id }
			else
				A.status[key] = { ok = false, reason = "ID invalide" }
			end
		end
		local loaded = A.loadMany(entries)
		if loaded > 0 and onReady then
			pcall(onReady)
		end
		return loaded
	end

	-- Charge les modèles de décor du hub (Config.Assets.decor : clé -> ID), plafond de Parts plus large que pour les œufs.
	-- Clés rangées sous « d:<clé> ». Retourne le nombre de modèles chargés. Ne lève jamais d'erreur.
	function A.loadDecor()
		if cfg.Enabled ~= true or type(cfg.decor) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.decor) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.decor[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "d:" .. key, id = id, cap = cfg.decorMaxParts or cfg.maxParts }
			else
				A.status["d:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Charge les modèles Blender des pets (Config.Assets.pets : index d'espèce -> ID). Clés « p:<index> ». Retourne le nombre de modèles chargés.
	function A.loadPets()
		if cfg.Enabled ~= true or type(cfg.pets) ~= "table" then
			return 0
		end
		local loaded = 0
		local idxs = {}
		for idx in pairs(cfg.pets) do
			idxs[#idxs + 1] = idx
		end
		table.sort(idxs, function(a, b)
			return tostring(a) < tostring(b)
		end)
		local entries = {}
		for _, idx in ipairs(idxs) do
			local id = cfg.pets[idx]
			if type(idx) == "number" and Config.PETS[idx] and type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "p:" .. idx, id = id, cap = cfg.petsMaxParts or cfg.maxParts }
			else
				A.status["p:" .. tostring(idx)] = { ok = false, reason = "entrée invalide" }
			end
		end
		loaded = A.loadMany(entries)
		return loaded
	end

	-- Copie du modèle du pet d'espèce `petIdx`, ou nil (repli : pet procédural).
	function A.clonePet(petIdx)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["p:" .. tostring(petIdx)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle de décor `key`, ou nil (coupé, échoué, pas encore chargé).
	function A.cloneDecor(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["d:" .. key]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle d'un œuf de rareté `tier`, ou nil (chargement coupé, échoué, pas encore terminé...) : garder l'apparence par défaut.
	function A.cloneEgg(tier, secret)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = nil
		if secret then
			template = A.templates["r:secret"]
		end
		template = template or A.templates["r:" .. tostring(tier)]
		if not template then
			local key = Config.eggAssetKey(tier)
			template = key and A.templates[key]
		end
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Accessoires (arbres, rochers, cabanes, pont, fontaine, nid...) : Config.Assets.props clé -> ID, plafond de Parts par clé (propsMaxParts).
	function A.loadProps()
		if cfg.Enabled ~= true or type(cfg.props) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.props) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.props[key]
			local cap = (cfg.propsMaxParts and cfg.propsMaxParts[key]) or cfg.decorMaxParts or cfg.maxParts
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "x:" .. key, id = id, cap = cap }
			else
				A.status["x:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Textures tuilables : chaque entrée de Config.Assets.textures est un ID de DÉCAL ; on charge le décal côté serveur, on lit son `Texture` (URL
	-- d'image) et on la met en cache (A.textureUrls[clé]). Un échec laisse la matière actuelle (aucune URL = rien n'est posé). Retourne le nombre chargé.
	A.textureUrls = {}
	function A.loadTextures()
		if cfg.Enabled ~= true or type(cfg.textures) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.textures) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local loaded = 0
		for _, key in ipairs(keys) do
			local id = cfg.textures[key].id
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				local ok, model = withTimeout(function()
					return deps.loadAsset(id)
				end, cfg.timeout)
				local url = nil
				if ok and model ~= nil then
					pcall(function()
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("Decal") and type(d.Texture) == "string" and d.Texture ~= "" then
								url = d.Texture
								break
							end
						end
					end)
					pcall(function()
						model:Destroy()
					end)
				end
				if url then
					A.textureUrls[key] = url
					A.status["t:" .. key] = { ok = true }
					loaded = loaded + 1
				else
					A.status["t:" .. key] = { ok = false, reason = ok and "aucun décal dans le modèle" or tostring(model) }
					warn("texture « " .. key .. " » (" .. tostring(id) .. ") indisponible : matière actuelle conservée.", id)
				end
			else
				A.status["t:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return loaded
	end

	-- Groupes de modèles Blender de Config.Assets.models (guards, castle, traps, ground, props...) : clé "groupe.nom", plafond de Parts par
	-- Config.Assets.modelsMaxParts["groupe.nom"]. Même garanties que loadProps (un seul LoadAsset par ID, jamais d'erreur levée).
	function A.loadGroup(group, only)
		local g = cfg.models and cfg.models[group]
		if cfg.Enabled ~= true or type(g) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(g) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = (not only or only[key]) and g[key] or nil
			local full = group .. "." .. key
			local cap = (cfg.modelsMaxParts and cfg.modelsMaxParts[full]) or (group == "vfx" and cfg.vfxMaxParts) or cfg.decorMaxParts or cfg.maxParts
			if not id then
				-- clé non demandée (filtre `only`)
			elseif type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "m:" .. full, id = id, cap = cap }
			else
				A.status["m:" .. full] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Copie d'un modèle d'un groupe (ou nil : repli procédural).
	function A.cloneModel(group, key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["m:" .. tostring(group) .. "." .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		return ok and clone or nil
	end

	-- Copie d'un accessoire (clone du modèle chargé une seule fois : jamais de LoadAsset répété), ou nil.
	function A.cloneProp(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["x:" .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Pose un modèle cloné : mis à l'échelle à `height` studs, posé au sol en (x, z), tourné de rotDeg, ancré, sans collision. Retourne (true, nombre de
	-- Parts) ou (false) ; en cas d'erreur le clone est détruit. Ne lève jamais d'erreur.
	function A.place(model, x, z, rotDeg, height, parent, length, groundY)
		local count = 0
		local mname = "?"
		pcall(function()
			mname = tostring(model.Name)
		end)
		local ok, err = pcall(function()
			if not model:IsA("Model") then
				error("pas un Model")
			end
			local _, size = model:GetBoundingBox()
			if size.Y < 0.05 then
				error("hauteur nulle")
			end
			local longest = math.max(size.X, size.Z)
			if length and longest > 0.05 then
				model:ScaleTo(length / longest) -- ponts : échelle d'après la longueur
			else
				local fitted, why = Assets.fitHeight(model, height) -- mesure puis vérification à ±10 % : sinon on ne pose pas
				if not fitted then
					error(why)
				end
			end
			local bbox, size2 = model:GetBoundingBox()
			local target = CFrame.new(x, (groundY or 0) + size2.Y / 2, z) * CFrame.Angles(0, math.rad(rotDeg or 0), 0)
			model:PivotTo(target * bbox:ToObjectSpace(model:GetPivot()))
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					count = count + 1
				end
			end
			model.Parent = parent
		end)
		if not ok then
			-- journal : le modèle est refusé (mesure, échelle ±10 %...) et l'apparence procédurale prend le relais
			if #A.placeFailures < 200 then
				A.placeFailures[#A.placeFailures + 1] = ("%s : %s"):format(mname, tostring(err))
			end
			pcall(function()
				model:Destroy()
			end)
			return false
		end
		return true, count
	end

	return A
end

return Assets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Reveal</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Reveal
-- Probabilité EXACTE d'un tirage et texte « 1 sur N » de la révélation d'œuf. Pur (Rules est injecté) et testé : la probabilité affichée
-- est celle que Rules.rollPet applique réellement (même poids de rareté, d'espèce, de taille, de mutation ; tirage de pitié inclus).
local Reveal = {}

-- Probabilité d'obtenir exactement (espèce p, taille s, mutation m) d'un œuf de rareté eggTier. guaranteed = tirage de pitié.
function Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local def = Config.PETS[p]
	if not def or not Config.SIZES[s] or not Config.MUTS[m] then
		return 0
	end
	local pTier
	if guaranteed and eggTier < #Config.TIERS then
		pTier = def.tier == eggTier + 1 and 1 or 0
	else
		local w = Rules.tierWeights(eggTier, upPoints)
		local total = w[1] + w[2] + w[3]
		local idx = def.tier - eggTier + 2
		pTier = (idx >= 1 and idx <= 3 and total > 0) and (math.max(w[idx], 0) / total) or 0
	end
	if pTier == 0 then
		return 0
	end
	local species = 0
	for _, q in ipairs(Config.PETS) do
		if q.tier == def.tier then
			species = species + 1
		end
	end
	local function share(weights, index)
		local total = 0
		for _, x in ipairs(weights) do
			total = total + math.max(x, 0)
		end
		return total > 0 and math.max(weights[index], 0) / total or 0
	end
	return pTier * (1 / species) * share(Rules.sizeWeights(), s) * share(Rules.mutWeights(alienBoost), m)
end

-- « 1 sur N » : N = 1 / probabilité (math.huge si impossible).
function Reveal.oneIn(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local pr = Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	return pr > 0 and 1 / pr or math.huge
end

-- Style de la révélation selon la rareté du pet et la probabilité réelle. Un tirage plus rare que Config.REVEAL.secret.oneInAtLeast
-- déclenche l'effet « œuf secret ». reduced = option mobile (moins de rayons, de particules et de secousse).
function Reveal.style(Config, petTier, oneIn, reduced)
	local R = Config.REVEAL
	local base = R.tiers[math.min(math.max(petTier, 1), #R.tiers)]
	local st = {}
	for k, v in pairs(base) do
		st[k] = v
	end
	st.secret = oneIn ~= nil and oneIn >= R.secret.oneInAtLeast
	if st.secret then
		for k, v in pairs(R.secret) do
			st[k] = v
		end
	end
	st.color = st.secret and R.secret.color or Config.TIERS[math.min(math.max(petTier, 1), #Config.TIERS)].color
	st.banner = Config.rarityBanner(petTier, st.secret)
	if reduced then
		local k = R.reducedFactor
		st.rays = math.max(4, math.floor(st.rays * k))
		st.particles = math.floor(st.particles * k)
		st.shake = st.shake * k
		st.rings = math.max(1, math.floor(st.rings * k + 0.5))
	end
	return st
end

-- Écran de tirage « machine à sous » : plan PUR des 3 colonnes. Chaque colonne est un anneau de symboles ; la position (continue, base 1) part de 1, tourne
-- `loops` tours puis ralentit (sortie en puissance 4) et s'arrête EXACTEMENT sur le résultat réel. fast : durées courtes (tirage banal ou mobile).
function Reveal.slotPlan(Config, petTier, sizeIdx, mutIdx, fast)
	local S = Config.REVEAL.slot
	local stops = fast and S.fastStops or S.stops
	local function column(title, symbols, final, k)
		local n = #symbols
		local f = math.min(math.max(math.floor(tonumber(final) or 1), 1), n)
		return { title = title, symbols = symbols, final = f, stop = stops[k], travel = n * S.loops[k] + (f - 1) }
	end
	local tiers, sizes, muts = {}, {}, {}
	for i, t in ipairs(Config.TIERS) do
		tiers[i] = { text = t.name, color = t.color }
	end
	for i, z in ipairs(Config.SIZES) do
		sizes[i] = { text = z.name } -- couleur nil : blanc côté client
	end
	for i, m in ipairs(Config.MUTS) do
		muts[i] = { text = m.name == "" and "Normal" or m.name, color = m.color }
	end
	local cols = { column("RARETÉ", tiers, petTier, 1), column("TAILLE", sizes, sizeIdx, 2), column("MUTATION", muts, mutIdx, 3) }
	return { columns = cols, duration = cols[3].stop + S.hold, hold = S.hold, tier = math.min(math.max(math.floor(tonumber(petTier) or 1), 1), #Config.TIERS) }
end

-- Position continue de la colonne `col` à l'instant t (s) : croît sans jamais reculer, ralentit, vaut exactement 1 + travel à l'arrêt.
function Reveal.slotPos(col, t)
	local u = math.min(math.max(t / col.stop, 0), 1)
	return 1 + col.travel * (1 - (1 - u) ^ 4)
end

-- Indice (1..n) du symbole centré à la position pos.
function Reveal.slotIndex(col, pos)
	local n = #col.symbols
	return (math.floor(pos + 0.5) - 1) % n + 1
end

return Reveal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Guard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Guard
-- Perception et état des gardiens (chien de Gus, loup de Mara, ours de Zed) : champ de vision (cône + distance), ouïe (le bruit dépend de la
-- vitesse du joueur), machine à états Patrouille / Alerte / Poursuite / Perte de cible / Retour, dégâts avec invulnérabilité courte et régénération.
-- PUR (aucun service Roblox, positions = tables { x, z }) : testé hors de Roblox. Main n'applique que ces décisions au monde.
local Guard = {}

local sqrt, acos, deg = math.sqrt, math.acos, math.deg

local function len(x, z)
	return sqrt(x * x + z * z)
end

-- Angle en degrés (0..180) entre le regard (fx, fz) et la direction (dx, dz). 0 si l'un des vecteurs est nul.
function Guard.angle(fx, fz, dx, dz)
	local a, b = len(fx, fz), len(dx, dz)
	if a < 1e-9 or b < 1e-9 then
		return 0
	end
	local c = (fx * dx + fz * dz) / (a * b)
	return deg(acos(math.max(-1, math.min(1, c))))
end

-- Le gardien g = { x, z, fx, fz } voit-il la cible t = { x, z } ? Cône de `viewAngle` degrés (total) et distance max `viewDist`.
function Guard.sees(g, t, viewDist, viewAngle)
	local dx, dz = t.x - g.x, t.z - g.z
	local d = len(dx, dz)
	if d > viewDist then
		return false
	end
	if d < 1.5 then
		return true -- collé au gardien : toujours vu
	end
	return Guard.angle(g.fx, g.fz, dx, dz) <= viewAngle / 2
end

-- Niveau de bruit (0..1) selon la vitesse : immobile = silence, marche lente = discret, course = plein bruit.
function Guard.noise(speed, cfg)
	if type(speed) ~= "number" or speed ~= speed or speed <= cfg.stillSpeed then
		return 0
	elseif speed < cfg.sneakSpeed then
		return cfg.sneakNoise
	end
	return 1
end

-- Entend-il la cible ? Rayon d'ouïe réduit proportionnellement au bruit.
function Guard.hears(dist, noise, hearRadius)
	return noise > 0 and dist <= hearRadius * noise
end

-- Perception complète : { sees, hears, dist }. g = { x, z, fx, fz }, t = { x, z, speed }, rival = { viewDist, viewAngle, hearRadius }.
function Guard.perceive(g, t, rival, cfg)
	local d = len(t.x - g.x, t.z - g.z)
	return { sees = Guard.sees(g, t, rival.viewDist, rival.viewAngle), hears = Guard.hears(d, Guard.noise(t.speed, cfg), rival.hearRadius), dist = d }
end

-- Machine à états. st = { state, timer, lost } ; percept = { sees, hears, atHome, dist } ; retourne le nouvel état (nouvelle table) et un événement
-- éventuel : "alert" (intrigué), "spotted" (poursuite), "lost" (cible perdue), "calm" (retour au calme).
--   patrol  : voit -> alert ; entend -> alert
--   alert   : s'arrête et regarde ; voit pendant alertDelay -> chase ; ne perçoit plus alertMax secondes -> return
--   chase   : voit ou entend -> poursuite continue ; ne perçoit plus -> lostChase ; trop loin (giveUpDist) -> return
--   lostChase : continue vers la dernière position connue loseDelay secondes (perte de cible), retrouve la cible -> chase, sinon -> return
--   return  : revient à la patrouille ; en route, voit -> alert
function Guard.nextState(st, dt, p, cfg)
	local s, timer, lost = st.state, st.timer or 0, st.lost or 0
	local event = nil
	if s == "patrol" then
		if p.sees or p.hears then
			s, timer, event = "alert", 0, "alert"
		end
	elseif s == "alert" then
		if p.sees then
			timer = timer + dt
			if timer >= cfg.alertDelay then
				s, timer, lost, event = "chase", 0, 0, "spotted"
			end
		elseif p.hears then
			timer = math.max(0, timer - dt * 0.25) -- bruit seul : reste méfiant mais ne poursuit pas
		else
			timer = timer + dt
			if timer >= cfg.alertMax then
				s, timer, event = "return", 0, "calm"
			end
		end
	elseif s == "chase" then
		if p.dist > cfg.giveUpDist then
			s, lost, event = "return", 0, "lost"
		elseif p.sees or p.hears then
			lost = 0
		else
			s, lost = "lostChase", 0
		end
	elseif s == "lostChase" then
		if p.sees or p.hears then
			s, lost, event = "chase", 0, "spotted"
		else
			lost = lost + dt
			if lost >= cfg.loseDelay then
				s, lost, event = "return", 0, "lost"
			end
		end
	else -- return
		if p.sees then
			s, timer, event = "alert", 0, "alert"
		elseif p.atHome then
			s, timer, event = "patrol", 0, "calm"
		end
	end
	return { state = s, timer = timer, lost = lost }, event
end

-- Dégâts : retourne (nouveaux points de vie, touché ?, invulnérabilité restante). Pendant l'invulnérabilité ou si hp <= 0 : aucun dégât.
function Guard.applyDamage(hp, damage, iframes, cfg)
	if iframes > 0 or hp <= 0 or damage <= 0 then
		return hp, false, iframes
	end
	return math.max(0, hp - damage), true, cfg.iframes
end

-- Régénération : après regenDelay secondes sans coup, regenPerSec par seconde (baseRegen par seconde dans la base du joueur). Plafonnée à maxHp.
-- Ramène (x, z) dans le disque de centre (cx, cz) et de rayon `radius` (territoire : le gardien ne quitte jamais son plateau ni ne traverse la douve).
function Guard.clampToDisc(x, z, cx, cz, radius)
	local dx, dz = x - cx, z - cz
	local d = len(dx, dz)
	if d <= radius or d < 1e-9 then
		return x, z
	end
	return cx + dx / d * radius, cz + dz / d * radius
end

-- Détection d'un gardien bloqué : `tr` = { t = 0 } conservé par gardien. Renvoie true quand il devrait bouger (want) mais avance de moins de cfg.stuckSpeed studs/s
-- depuis cfg.stuckSeconds secondes ; tout mouvement ou toute immobilité voulue (alerte) remet le compteur à zéro.
function Guard.stuckStep(tr, dt, moved, want, cfg)
	if not want or moved > cfg.stuckSpeed * dt then
		tr.t = 0
		return false
	end
	tr.t = tr.t + dt
	if tr.t >= cfg.stuckSeconds then
		tr.t = 0
		return true
	end
	return false
end

-- Pose de marche procédurale : rebond vertical et roulis en marchant (selon la vitesse), respiration à l'arrêt. `t` en secondes. Retourne (y, roulis en radians).
function Guard.walkPose(t, speed)
	if speed > 0.5 then
		local ph = t * speed * 0.9
		return math.abs(math.sin(ph)) * math.min(0.35, 0.04 * speed), math.sin(ph) * 0.06
	end
	return math.sin(t * 2) * 0.04, 0
end

function Guard.regen(hp, sinceHit, dt, atBase, cfg)
	if hp <= 0 or hp >= cfg.maxHp then
		return math.min(hp, cfg.maxHp)
	end
	local rate = atBase and cfg.baseRegen or (sinceHit >= cfg.regenDelay and cfg.regenPerSec or 0)
	return math.min(cfg.maxHp, hp + rate * dt)
end

return Guard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Castle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Castle
-- Mode « Château » : donjon de salles successives avec pièges à éviter (pics, lames tournantes, boulets, porte à timing) et coffre final.
-- Logique PURE (aucun service Roblox) : géométrie des salles, états des pièges en fonction du temps, détection des touches, difficulté croissante,
-- classement des temps et récompense. Coordonnées d'une salle : lx (travers, -20..20) et lz (profondeur depuis l'entrée, 0..roomLength).
local Castle = {}

Castle.ROOMS = 5
Castle.ROOM_LENGTH = 56
Castle.ROOM_WIDTH = 40
Castle.ORIGIN = { x = 470, z = -280 } -- entrée de la salle 1 dans le monde ; les salles avancent vers -z

-- Difficulté d'une salle r (1..ROOMS) : nombre de pièges et rythme, croissants.
function Castle.room(r)
	r = math.min(math.max(r, 1), Castle.ROOMS)
	return {
		index = r,
		spikes = 3 + r, -- plaques à pics (4 colonnes)
		blades = r >= 4 and 2 or (r >= 2 and 1 or 0),
		balls = r >= 3 and (r - 2) or 0,
		knights = r >= 5 and 2 or (r >= 3 and 1 or 0), -- chevaliers qui patrouillent d'un mur à l'autre (touche non mortelle)
		period = math.max(1.6, 3.4 - 0.3 * r), -- durée d'un cycle des pics (s)
		bladeSpeed = 1.2 + 0.3 * r, -- radians par seconde
		ballTravel = math.max(1.6, 3.2 - 0.25 * r), -- traversée d'un boulet (s)
		doorPeriod = math.max(3, 5 - 0.4 * r), -- cycle de la porte (s)
		doorOpen = math.max(1.4, 2.4 - 0.2 * r), -- durée d'ouverture (s)
	}
end

-- Pics : phase 0..1 du cycle ; avertissement avant le danger (les pics se dressent), danger 0,9 s par cycle.
local DANGER, WARN = 0.9, 0.6
function Castle.spikeState(t, trap, room)
	local period = room.period
	local phase = ((t + trap.offset) % period)
	local dangerStart = period - DANGER
	if phase >= dangerStart then
		return "danger"
	elseif phase >= dangerStart - WARN then
		return "warning"
	end
	return "safe"
end

-- Plaques à pics de la salle : 4 colonnes espacées (couloirs sûrs de 4 studs entre elles), phases décalées.
function Castle.spikes(room)
	local out = {}
	for i = 1, room.spikes do
		local col, row = (i - 1) % 4, math.floor((i - 1) / 4)
		out[i] = { lx = -15 + col * 10, lz = 10 + row * 9, radius = 3, offset = ((col + row) % 4) * (room.period / 4) }
	end
	return out
end

-- Lames tournantes : centre de la salle, deux bras opposés de 14 studs, angle selon le temps.
function Castle.blades(room)
	local out = {}
	for i = 1, room.blades do
		out[i] = { lx = (i - (room.blades + 1) / 2) * 20, lz = 34, arm = 14, phase = (i - 1) * math.pi / 2 }
	end
	return out
end

function Castle.bladeAngle(t, blade, room)
	return blade.phase + t * room.bladeSpeed
end

-- Boulets : couloirs horizontaux (traversée de gauche à droite puis pause avant de recommencer).
function Castle.balls(room)
	local out = {}
	for i = 1, room.balls do
		out[i] = { lz = 18 + (i - 1) * 9, radius = 3, offset = (i - 1) * 0.9 }
	end
	return out
end

-- Position latérale d'un boulet (nil pendant la pause).
function Castle.ballX(t, ball, room)
	local cycle = room.ballTravel + 1.4
	local phase = (t + ball.offset) % cycle
	if phase >= room.ballTravel then
		return nil
	end
	return -22 + 44 * (phase / room.ballTravel)
end

-- Chevaliers : patrouille en aller-retour latéral (onde triangulaire, vitesse constante), décalés pour ne pas être synchrones.
function Castle.knights(room)
	local out = {}
	for i = 1, room.knights do
		out[i] = { lz = 14 + (i - 1) * 24, amp = 15, period = math.max(5, 9 - 0.7 * room.index), offset = (i - 1) * 2.3, radius = 2.6 }
	end
	return out
end

-- Position latérale et sens (+1 vers la droite, -1 vers la gauche) d'un chevalier à l'instant t.
function Castle.knightPos(t, k)
	local phase = ((t + k.offset) % k.period) / k.period -- 0..1
	if phase < 0.5 then
		return -k.amp + 4 * k.amp * phase, 1
	end
	return k.amp - 4 * k.amp * (phase - 0.5), -1
end

-- Porte de fin de salle : ouverte pendant doorOpen secondes par cycle.
function Castle.doorIsOpen(t, room)
	return (t % room.doorPeriod) < room.doorOpen
end

-- Distance d'un point au segment [a, b].
local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local u = l2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / l2)) or 0
	local cx, cz = ax + u * dx, az + u * dz
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Castle.distToSegment = distToSegment

-- Le joueur (px, pz en coordonnées locales de salle) est-il touché par un piège à l'instant t ? Retourne le nom du piège ou nil.
function Castle.hit(t, room, px, pz, playerRadius)
	playerRadius = playerRadius or 1.2
	for _, sp in ipairs(Castle.spikes(room)) do
		if Castle.spikeState(t, sp, room) == "danger" and math.sqrt((px - sp.lx) ^ 2 + (pz - sp.lz) ^ 2) < sp.radius + playerRadius * 0.5 then
			return "spikes"
		end
	end
	for _, bl in ipairs(Castle.blades(room)) do
		local a = Castle.bladeAngle(t, bl, room)
		local cx, cz = math.cos(a) * bl.arm, math.sin(a) * bl.arm
		if distToSegment(px, pz, bl.lx - cx, bl.lz - cz, bl.lx + cx, bl.lz + cz) < 1.6 + playerRadius * 0.5 then
			return "blade"
		end
	end
	for _, ba in ipairs(Castle.balls(room)) do
		local bx = Castle.ballX(t, ba, room)
		if bx and math.sqrt((px - bx) ^ 2 + (pz - ba.lz) ^ 2) < ba.radius + playerRadius * 0.5 then
			return "ball"
		end
	end
	for _, kn in ipairs(Castle.knights(room)) do
		local kx = Castle.knightPos(t, kn)
		if math.sqrt((px - kx) ^ 2 + (pz - kn.lz) ^ 2) < kn.radius + playerRadius * 0.5 then
			return "knight"
		end
	end
	return nil
end

-- Conversion monde <-> salle : la salle r commence à ORIGIN.z - (r - 1) * ROOM_LENGTH et avance vers -z.
function Castle.toLocal(wx, wz)
	local depth = Castle.ORIGIN.z - wz -- profondeur totale depuis l'entrée
	local r = math.floor(depth / Castle.ROOM_LENGTH) + 1
	return r, wx - Castle.ORIGIN.x, depth - (r - 1) * Castle.ROOM_LENGTH
end

function Castle.toWorld(r, lx, lz)
	return Castle.ORIGIN.x + lx, Castle.ORIGIN.z - ((r - 1) * Castle.ROOM_LENGTH + lz)
end

-- Joueur dans le château ? (rectangle des salles). Retourne le numéro de salle ou nil.
function Castle.roomAt(wx, wz)
	local r, lx, lz = Castle.toLocal(wx, wz)
	if r >= 1 and r <= Castle.ROOMS and math.abs(lx) <= Castle.ROOM_WIDTH / 2 and lz >= 0 then
		return r, lx, lz
	end
	return nil
end

-- Classement des temps (secondes, plus petit = meilleur) : insère { name, userId, time }, conserve `max` entrées, un seul meilleur temps par joueur.
-- Retourne (nouvelle liste, rang du joueur ou nil s'il n'entre pas).
function Castle.insertScore(list, entry, max)
	local out, existing = {}, nil
	for _, e in ipairs(list) do
		if e.userId == entry.userId then
			existing = e
		else
			out[#out + 1] = e
		end
	end
	if existing and existing.time <= entry.time then
		local same = {}
		for i, e in ipairs(list) do
			same[i] = e
		end
		return same, nil -- son meilleur temps existant est conservé
	end
	out[#out + 1] = entry
	table.sort(out, function(a, b)
		if a.time ~= b.time then
			return a.time < b.time
		end
		return a.userId < b.userId
	end)
	local rank = nil
	for i, e in ipairs(out) do
		if e == entry then
			rank = i
		end
	end
	while #out > max do
		table.remove(out)
	end
	if rank and rank > max then
		rank = nil
	end
	return out, rank
end

-- Durée en « m:ss.d » (arrondie au dixième).
function Castle.formatTime(seconds)
	if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 then
		return "--:--.-"
	end
	local tenths = math.floor(seconds * 10 + 0.5)
	local m = tenths // 600
	local rest = (tenths - m * 600) / 10
	return string.format("%d:%04.1f", m, rest)
end

-- Récompense du coffre final : œuf rare (Épique, Légendaire si temps rapide), pièces proportionnelles aux revenus.
-- fastTime : durée de référence « rapide » (s) pour ce nombre de salles.
function Castle.reward(timeSeconds, income, deaths)
	local fast = 60 * Castle.ROOMS * 0.6 -- 3 min : bon temps
	local tier = (timeSeconds <= fast and (deaths or 0) == 0) and 4 or 3
	local coins = math.floor(math.max(5000, income * 600 * (timeSeconds <= fast and 1.5 or 1)))
	return { eggTier = tier, coins = coins }
end

return Castle
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX25"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX19"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Script : ServerScriptService/Main
-- Logique serveur complète de Chipe-Œufs (le serveur décide de tout, le client ne fait qu'afficher).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local MessagingService = game:GetService("MessagingService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
if Config.Game.roleFor(game.PlaceId) == "hub" then
	return -- le hub a son propre script (Hub.server) ; ce code est celui de la partie
end
local TeleportService = game:GetService("TeleportService")
local Party = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Party"))
local Reveal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Reveal"))
local Guard = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Guard"))
local Castle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Castle"))
local Data = require(script.Parent:WaitForChild("Data"))
local Builder = require(script.Parent:WaitForChild("Builder"))
local Rules = require(script.Parent:WaitForChild("Rules")).new(Config) -- règles pures (tirages, revenus), testées avec Lune

Players.CharacterAutoLoads = false

---------------------------------------------------------------- Remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = ReplicatedStorage
local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = Remotes
	return r
end
local RState, RNotify, RHatch, RAction = newRemote("State"), newRemote("Notify"), newRemote("Hatch"), newRemote("Action")
local RTop = newRemote("Top")

---------------------------------------------------------------- Monde
local onAssetsLoaded = nil -- défini après applyBase et refreshAllPads (voir plus bas), appelé par la tâche de chargement des modèles
-- Apparence des œufs : modèles Roblox chargés en arrière-plan (jamais bloquant ; échec = apparence par défaut, voir Config.Assets).
task.spawn(function()
	local InsertService = game:GetService("InsertService")
	local assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets")).new(Config, {
		loadAsset = function(id)
			return InsertService:LoadAsset(id)
		end,
		spawn = task.spawn,
		wait = task.wait,
		clock = os.clock,
		warn = warn,
		store = function(key, model)
			model.Name = "EggAsset_" .. key
			model.Parent = game:GetService("ServerStorage")
		end,
	})
	Builder.setAssets(assets)
	-- Ordre de chargement : d'abord ce qui se voit dans les premières secondes (œufs, base du joueur, chemins, arbres, accessoires, village), par lots parallèles
	assets.loadAll()
	assets.loadGroup("base")
	assets.loadGroup("paths")
	assets.loadGroup("trees")
	assets.loadProps()
	assets.loadGroup("scenery")
	assets.loadGroup("eggguard") -- protections d'œuf (dôme, cage, cristaux, nid) posées à chaque rafraîchissement de pad
	assets.loadPets()
	if onAssetsLoaded then
		pcall(onAssetsLoaded) -- base et pads déjà affichés : reconstruits avec les modèles arrivés
	end
	local propParts, propCount = Builder.dressWorld(assets)
	print("[Assets] accessoires Blender : " .. propCount .. " posés (" .. propParts .. " Parts)")
	assets.loadGroup("guards")
	print("[Assets] gardiens Blender : " .. Builder.dressGuards(assets) .. " remplacé(s)")
	assets.loadGroup("traps")
	assets.loadGroup("guards", { knight = true })
	print("[Assets] pièges Blender : " .. Builder.dressTraps(assets) .. " habillé(s)")
	print("[Assets] chevaliers Blender : " .. Builder.dressKnights(assets) .. " habillé(s)")
	assets.loadGroup("castle")
	assets.loadGroup("props") -- coffre, torche, drapeau, château en fond, moulin, enclos, lampadaire, banc, panneau
	assets.loadGroup("ground")
	print("[Assets] arène Blender : " .. Builder.dressArena(assets) .. " modèle(s) posé(s)")
	assets.loadTextures()
	print("[Assets] textures : " .. Builder.dressTextures(assets) .. " posée(s)")
	assets.loadGroup("deco")
	assets.loadGroup("terrain")
	local pt, pu = Builder.dressPaths(assets)
	print("[Assets] chemins sinueux : " .. pt .. " tuile(s), " .. pu .. " Parts (budget " .. Config.Assets.pathBudgetParts .. ")")
	local sn, su = Builder.dressScenery(assets)
	print("[Assets] décor de village : " .. sn .. " objet(s), " .. su .. " Parts (budget " .. Config.Assets.sceneryBudgetParts .. ")")
	local dp, du, df = Builder.dressDeco(assets)
	print("[Assets] décor fin : " .. dp .. " objet(s), " .. du .. " Parts Blender (budget " .. Config.Assets.decoBudgetParts .. "), " .. df .. " Parts de repli")
	local rn, ru = Builder.dressRelief(assets)
	print("[Assets] relief : " .. rn .. " pièce(s), " .. ru .. " Parts (budget " .. Config.Assets.reliefBudgetParts .. ")")
	print("[Assets] panneaux d'étoiles : " .. Builder.dressSigns(assets))
	assets.loadGroup("vfx")
	print("[Assets] effets 3D : " .. Builder.exportVfx(assets) .. " modèle(s) publiés pour les clients")
	local gt, gp = Builder.dressGround(assets)
	print("[Assets] sol Blender : " .. gt .. " tuile(s), " .. gp .. " Parts (budget " .. Config.Assets.groundBudgetParts .. ")")
	print("[Assets] château Blender : " .. Builder.dressCastle(assets) .. " modèle(s) posé(s)")
	if onAssetsLoaded then
		pcall(onAssetsLoaded)
	end
	-- Rapport de chargement : par catégorie (chargés / demandés / en repli) et, pour chaque échec, nom, ID et message ; publié aux clients (touche F3, « Blender N/M »)
	local lines, loaded, requested = assets.reportLines()
	for _, l in ipairs(lines) do
		if l:find("ÉCHEC", 1, true) then
			warn(l)
		else
			print(l)
		end
	end
	print(("[Assets] TOTAL Blender %d/%d (repli procédural : %d)"):format(loaded, requested, requested - loaded))
	local rv = Instance.new("StringValue")
	rv.Name = "AssetReport"
	rv:SetAttribute("Loaded", loaded)
	rv:SetAttribute("Requested", requested)
	rv.Value = table.concat(lines, "\n"):sub(1, 15000)
	rv.Parent = ReplicatedStorage
end)

local world = Builder.build()
local rng = Random.new()
local sessions = {} -- [Player] = session
local leavingSave = {} -- userId -> true tant que la sauvegarde de départ de ce joueur est en cours (une reconnexion attend)
local pendingSaves, saveLater = {}, nil -- profils à sauvegarder en arrière-plan (voir saveLater)
local castleEnter, castleFinish -- définies avec le mode Château (plus bas) ; déclarées ici car le gestionnaire de prompts les utilise
local serverPartyId = nil -- identifiant de la partie de ce serveur (celui du premier joueur envoyé par le hub)

local function rnd()
	return rng:NextNumber()
end
local function wpick(ws)
	return Rules.wpick(ws, rnd)
end

local function getRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function alive(player)
	local h = getHum(player)
	return h ~= nil and h.Health > 0
end
local function validSlot(i)
	return type(i) == "number" and i % 1 == 0 and i >= 1 and i <= 12
end
-- sfx (optionnel) : clé de Config.SOUNDS jouée par le client avec le message
local function notify(player, msg, sfx)
	if player and player.Parent then
		RNotify:FireClient(player, msg, sfx)
	end
end

---------------------------------------------------------------- Règles
local currentEvent = nil -- { cfg, ends }
local function evKey()
	return currentEvent and currentEvent.cfg.key or nil
end

local function cap(d)
	return Rules.capacity(d.up)
end
local function carryCap(d)
	return Rules.carryCapacity(d.up)
end
local function hatchTime(s, tier)
	return Rules.hatchTime(tier, s.data.up.inc, s.passes.Fast == true)
end
local function shieldTime(s)
	return Rules.shieldTime(s.data.up.lock) * (s.passes.VipBase == true and Config.VIP_SHIELD_MUL or 1)
end
-- Multiplicateur de vitesse de marche (pass « Vitesse+ »), appliqué aussi à la tolérance anti-triche.
local function speedMul(s)
	return s.passes.Speed == true and Config.SPEED_PASS_MUL or 1
end
local function freeSlot(d)
	for i = 1, cap(d) do
		if not d.slots[i] then
			return i
		end
	end
	return nil
end

local function gmult(s)
	return Rules.multiplier(s.data.rb, s.data.up.food, evKey() == "gold", s.passes.Coins2x == true, Config.collectionBonus(s.species or 0))
end

local function income(s)
	return Rules.income(s.data.slots, cap(s.data), gmult(s))
end

local function rollPet(s, eggTier, guaranteed)
	local up = Rules.upPoints(s.data.up.luck, evKey() == "luck", s.passes.Lucky == true, os.time() < s.data.luckUntil)
	local alien = evKey() == "alien"
	return Rules.rollPet(eggTier, up, alien, rnd, guaranteed), up, alien
end

---------------------------------------------------------------- Missions quotidiennes
local QUEST_TYPES = { "steal", "hatch", "earn", "train", "pvp", "discover", "sell", "castle", "rare", "secret" }

local function newQuests(s)
	local inc = math.max(income(s), 1)
	local pool = table.clone(QUEST_TYPES)
	local out = {}
	for _ = 1, 3 do
		local t = table.remove(pool, rng:NextInteger(1, #pool))
		local goal
		if t == "steal" then
			goal = rng:NextInteger(3, 7)
		elseif t == "hatch" then
			goal = rng:NextInteger(4, 9)
		elseif t == "earn" then
			goal = math.floor(math.max(1000, inc * 240))
		elseif t == "train" then
			goal = rng:NextInteger(3, 6) * 20
		elseif t == "sell" then
			goal = rng:NextInteger(2, 4)
		elseif t == "castle" or t == "rare" or t == "secret" then
			goal = 1
		else -- pvp, discover
			goal = rng:NextInteger(1, 2)
		end
		local bonus = Config.questBonus(t, #out + 1, s.data.story.ch)
		out[#out + 1] = { t = t, goal = goal, prog = 0, rew = math.floor(math.max(250, inc * 150)), re = bonus.egg or 0, rb = bonus.boost or 0, claimed = false }
	end
	return out
end

local function qp(s, t, n)
	for _, q in ipairs(s.data.quests) do
		if q.t == t and q.prog < q.goal then
			q.prog = math.min(q.goal, q.prog + n)
		end
	end
end

local function ensureQuests(s)
	local today = os.time() // 86400
	if s.data.qday ~= today or #s.data.quests == 0 then
		s.data.quests = newQuests(s)
		s.data.qday = today
	end
end

---------------------------------------------------------------- Histoire (chapitres), collection et rang
local function speciesCount(d)
	local n = 0
	for _ in pairs(d.dex) do
		n += 1
	end
	return n
end

local function chapter(s)
	return Config.STORY[s.data.story.ch + 1]
end

local function storyReached(s, c)
	notify(s.player, "📜 Chapitre « " .. c.title .. " » terminé ! Réclame ta récompense (Missions > Histoire).", "claim")
end

-- Fait avancer le chapitre en cours si son type correspond. info = { rival = n, tier = n } selon l'événement.
local function sp(s, kind, n, info)
	local c = chapter(s)
	local st = s.data.story
	if not c or c.type ~= kind or st.prog >= c.goal then
		return
	end
	if c.rival and (not info or info.rival ~= c.rival) then
		return
	end
	if c.tier and (not info or (info.tier or 0) < c.tier) then
		return
	end
	st.prog = math.min(c.goal, st.prog + n)
	if st.prog >= c.goal then
		storyReached(s, c)
	end
end

-- Chapitres fondés sur un état (espèces découvertes, renaissances).
local function storyRefresh(s)
	local c = chapter(s)
	local st = s.data.story
	if not c or st.prog >= c.goal then
		return
	end
	local value
	if c.type == "species" then
		value = s.species
	elseif c.type == "rebirth" then
		value = s.data.rb
	end
	if value and value > st.prog then
		st.prog = math.min(c.goal, value)
		if st.prog >= c.goal then
			storyReached(s, c)
		end
	end
end

local function updateSign(s)
	local r = Config.rankFor(s.data.story.ch)
	s.plot.nameLabel.Text = "🏠 Base de " .. s.player.DisplayName .. " · " .. r.emoji .. " " .. r.name
end

---------------------------------------------------------------- Énigme du jour (identique pour tous) et statistiques de succès
local riddleCache = { day = -1, riddle = nil }
local function currentRiddle()
	local day = os.time() // 86400
	if riddleCache.day ~= day then
		riddleCache.day = day
		riddleCache.riddle = Config.riddleFor(day)
		for _, lbl in ipairs(world.riddleLabels) do
			lbl.Text = riddleCache.riddle.text
		end
	end
	return riddleCache.riddle
end
currentRiddle() -- écrit l'énoncé sur les panneaux dès le démarrage

local function statValues(s)
	local d = s.data
	return { hatched = d.hatched, stolen = d.stolen, species = s.species, rb = d.rb, puzzles = d.puzzle.solved }
end

---------------------------------------------------------------- Synchronisation client
local function snapshot(s)
	local d = s.data
	local slots = {}
	for i = 1, 12 do
		local sl = d.slots[i]
		if sl and sl.k == "e" then
			slots[i] = { k = "e", t = sl.t, ends = sl.ends }
		elseif sl then
			slots[i] = { k = "p", p = sl.p, s = sl.s, m = sl.m }
		else
			slots[i] = false
		end
	end
	local today = os.time() // 86400
	local nextStreak = (d.daily == today - 1) and d.streak + 1 or 1
	return {
		up = d.up,
		slots = slots,
		rb = d.rb,
		dex = d.dex,
		mult = gmult(s),
		cap = cap(d),
		carry = #s.carry,
		carryCap = carryCap(d),
		passes = s.passes,
		starter = s.data.starter == true,
		dailyReady = d.daily ~= today,
		dailyReward = math.floor(math.max(200, income(s) * 600) * math.min(nextStreak, 7)),
		streak = nextStreak,
		stolen = d.stolen,
		hatched = d.hatched,
		cine = d.cine,
		quests = d.quests,
		equip = d.equip,
		luckLeft = math.max(0, d.luckUntil - os.time()),
		story = { ch = d.story.ch, prog = d.story.prog },
		pity = d.pity,
		species = s.species,
		collection = Config.collectionBonus(s.species),
		runes = s.runes,
		riddle = currentRiddle().text,
		puzzleDone = d.puzzle.day == today,
		puzzleSolved = d.puzzle.solved,
		ach = d.ach,
		stats = statValues(s),
		baseScore = d.baseScore,
		away = math.floor(d.pendingAway),
		baseLevel = s.baseLevel,
	}
end

local function pushStats(s)
	local d = s.data
	local p = s.player
	p:SetAttribute("Coins", d.coins)
	p:SetAttribute("Speed", d.speed)
	p:SetAttribute("Income", income(s))
	s.lsCoins.Value = math.floor(math.min(d.coins, 9e15))
	s.lsSpeed.Value = math.floor(d.speed)
	s.lsRb.Value = d.rb
	s.lsRank.Value = Config.rankFor(d.story.ch).name
end

local function sync(s)
	pushStats(s)
	RState:FireClient(s.player, snapshot(s))
end

---------------------------------------------------------------- Vitesse / étourdissement
local function applySpeed(s)
	local hum = getHum(s.player)
	if hum and s.stun <= 0 then
		local ws = Config.walkSpeed(s.data.speed) * speedMul(s) * 0.93 ^ #s.carry
		if math.abs(hum.WalkSpeed - ws) > 0.05 then
			hum.WalkSpeed = ws
		end
	end
end

---------------------------------------------------------------- Œufs portés
local function rebuildCarry(s)
	for _, p in ipairs(s.carryParts) do
		p:Destroy()
	end
	s.carryParts = {}
	local char = s.player.Character
	local root = getRoot(s.player)
	if not (char and root) then
		return
	end
	for i, e in ipairs(s.carry) do
		local egg = Builder.egg(e.t, false)
		egg.Massless = true
		local off = CFrame.new(0, 3.4 + (i - 1) * 1.8, 0)
		egg.CFrame = root.CFrame * off
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = egg
		w.C0 = off
		w.Parent = egg
		egg.Parent = char
		CollectionService:AddTag(egg, "CarryEgg") -- balancement pendant la course (client)
		s.carryParts[i] = egg
	end
end

---------------------------------------------------------------- Nids des rivaux
local function setNestEgg(n, tier)
	n.egg = tier
	if n.eggPart then
		n.eggPart:Destroy()
		n.eggPart = nil
	end
	if not tier then
		return
	end
	local egg = Builder.egg(tier, true)
	egg.CFrame = CFrame.new(n.pos)
	egg.Parent = n.folder
	n.eggPart = egg
	CollectionService:AddTag(egg, "EggShake") -- animé côté client (rebond ; pas d'attribut Ends = pas de tremblement)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Voler l'œuf"
	pr.ObjectText = "Œuf " .. Config.TIERS[tier].name
	pr.HoldDuration = Config.stealTime(0)
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", "Nest")
	pr:SetAttribute("Nest", n.index)
	pr:SetAttribute("Rival", n.rival) -- le client masque le prompt tant que la zone est verrouillée
	pr.Parent = egg
	CollectionService:AddTag(pr, "StealPrompt")
	Builder.sign(egg, Config.TIERS[tier].name, Config.TIERS[tier].color, 3, 160)
end

for i, n in ipairs(world.nests) do
	n.index = i
	setNestEgg(n, wpick(Config.RIVALS[n.rival].weights))
end

---------------------------------------------------------------- Pads d'une base
local hatch, speedUpEgg -- déclarations anticipées

local function clearPad(s, i)
	local pad = s.plot.pads[i]
	if pad.content then
		local gp = pad.content:GetAttribute("GuardParts")
		if s.guardBudget and gp then
			s.guardBudget.used = math.max(0, s.guardBudget.used - gp)
		end
		pad.content:Destroy()
		pad.content = nil
	end
	s.labels[i] = nil
end

local function refreshPad(s, i, animate)
	clearPad(s, i)
	local d = s.data
	local pad = s.plot.pads[i]
	local locked = i > cap(d)
	pad.lock.Enabled = locked
	pad.part.Transparency = locked and 0.25 or 0.7
	pad.part.Color = locked and Color3.fromRGB(40, 40, 45) or Color3.new(1, 1, 1)
	pad.frame.Color = locked and Color3.fromRGB(50, 52, 58) or s.plot.color
	pad.frame.Material = locked and Enum.Material.SmoothPlastic or Enum.Material.Neon
	local sl = d.slots[i]
	if locked or not sl then
		return
	end
	local content = Instance.new("Model")
	content.Name = "Content"
	content.Parent = pad.part
	pad.content = content

	if sl.k == "e" then
		local egg = Builder.egg(sl.t, true)
		egg.CFrame = pad.part.CFrame * CFrame.new(0, 1.9, 0)
		egg:SetAttribute("Ends", sl.ends)
		CollectionService:AddTag(egg, "EggShake")
		egg.Parent = content
		s.guardBudget = s.guardBudget or { used = 0 }
		Builder.nest(pad.part.Position + Vector3.new(0, 0.3, 0), content, sl.t, s.guardBudget) -- l'œuf repose sur une protection selon sa rareté
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Voler l'œuf"
		pr.ObjectText = "Œuf de " .. s.player.DisplayName
		pr.HoldDuration = Config.stealTime(0)
		pr.MaxActivationDistance = 10
		pr.RequiresLineOfSight = false
		pr:SetAttribute("Kind", "Pad")
		pr:SetAttribute("Owner", s.player.UserId)
		pr:SetAttribute("Slot", i)
		pr.Parent = egg
		CollectionService:AddTag(pr, "StealPrompt")
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 40
		cd.Parent = egg
		cd.MouseClick:Connect(function(who)
			speedUpEgg(s, i, who)
		end)
		s.labels[i] = Builder.sign(egg, "", Config.TIERS[sl.t].color, 3, 200)
	else
		local model, lift, labelY = Builder.pet(sl.p, sl.s, sl.m)
		model.Parent = content
		model:PivotTo(pad.part.CFrame * CFrame.new(0, 0.2 + lift, 0))
		CollectionService:AddTag(model, "Bob")
		model:SetAttribute("Seed", i * 17 + sl.p) -- désynchronise les clignements et les regards entre pets
		if animate then
			model:SetAttribute("Born", workspace:GetServerTimeNow())
			CollectionService:AddTag(model, "PopIn")
		end
		s.labels[i] = Builder.sign(model.PrimaryPart, "", Config.TIERS[Config.PETS[sl.p].tier].color, labelY, 220)
	end
end

local function refreshAllPads(s)
	for i = 1, 12 do
		refreshPad(s, i)
	end
end

---------------------------------------------------------------- Retour / chute des œufs portés
local function returnEgg(e)
	if e.rival then
		for _, n in ipairs(world.nests) do
			if n.rival == e.rival and not n.egg then
				setNestEgg(n, e.t)
				return
			end
		end
	elseif e.from then
		local vp = Players:GetPlayerByUserId(e.from)
		local vs = vp and sessions[vp]
		if vs then
			local i = freeSlot(vs.data)
			if i then
				vs.data.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(vs) }
				refreshPad(vs, i)
				notify(vs.player, "🥚 Ton œuf t'a été rendu !")
				sync(vs)
			end
		end
	end
end

local function dropCarry(s)
	if #s.carry == 0 then
		return
	end
	for _, e in ipairs(s.carry) do
		returnEgg(e)
	end
	s.carry = {}
	rebuildCarry(s)
	applySpeed(s)
	if s.player.Parent then
		sync(s)
	end
end

local function afterTake(s)
	rebuildCarry(s)
	applySpeed(s)
	sync(s)
	notify(s.player, "🥚 Œuf volé ! Rapporte-le vite à ta base.", "steal")
end

---------------------------------------------------------------- Pets suiveurs (le déplacement est calculé côté client, le serveur ne fait que créer les modèles)
local followersFolder = Instance.new("Folder")
followersFolder.Name = "Followers"
followersFolder.Parent = workspace

local function clearFollowers(s)
	for _, m in ipairs(s.followers) do
		m:Destroy()
	end
	s.followers = {}
end

local function rebuildFollowers(s)
	clearFollowers(s)
	local d = s.data
	local clean = {}
	for _, i in ipairs(d.equip) do
		local sl = validSlot(i) and d.slots[i]
		if sl and sl.k == "p" then
			clean[#clean + 1] = i
		end
	end
	d.equip = clean
	local root = getRoot(s.player)
	if not root or not alive(s.player) then
		return
	end
	for n, i in ipairs(d.equip) do
		local sl = d.slots[i]
		local m = Builder.follower(sl.p, sl.s, sl.m)
		m.Name = "Follower"
		m:SetAttribute("OwnerId", s.player.UserId)
		m:SetAttribute("Idx", n)
		m:PivotTo(root.CFrame * CFrame.new((n - 2) * 3, -2, 4))
		m.Parent = followersFolder
		CollectionService:AddTag(m, "Follower")
		s.followers[#s.followers + 1] = m
	end
end

---------------------------------------------------------------- Annonces (ce serveur + tous les serveurs)
local function announce(text)
	for _, pl in ipairs(Players:GetPlayers()) do
		notify(pl, text)
	end
	task.spawn(function()
		pcall(function()
			MessagingService:PublishAsync("ChipeAnnounce", { sid = Data.SERVER_ID, text = text })
		end)
	end)
end
task.spawn(function() -- SubscribeAsync attend le réseau : ne pas bloquer le démarrage du serveur
	pcall(function()
		MessagingService:SubscribeAsync("ChipeAnnounce", function(msg)
			local m = msg.Data
			if type(m) == "table" and m.sid ~= Data.SERVER_ID and type(m.text) == "string" then
				for _, pl in ipairs(Players:GetPlayers()) do
					notify(pl, m.text)
				end
			end
		end)
	end)
end)

---------------------------------------------------------------- Progression de la base (niveau d'après le score pondéré par la rareté)
-- Reconstruit l'apparence de la base au niveau courant et publie le niveau (attributs lus par le client : effet de montée de niveau, interface).
local function applyBase(s, announce, force)
	local level, nxt = Config.baseLevel(s.data.baseScore)
	local before = s.baseLevel
	s.baseLevel = level
	if (before ~= level or force) and s.plot then
		Builder.baseUpgrade(s.plot, level)
	end
	s.player:SetAttribute("BaseLevel", level)
	s.player:SetAttribute("BaseScore", s.data.baseScore)
	if announce and before and level > before then
		local lv = Config.BASE_LEVELS[level]
		notify(s.player, "🏠 Ta base passe au niveau " .. level .. " : " .. lv.emoji .. " " .. lv.name .. (nxt and (" · prochain palier : " .. nxt.name) or " · niveau maximum !"), "claim")
	end
end

-- Les modèles Blender arrivent APRÈS l'entrée des premiers joueurs : une fois un groupe chargé, on reconstruit la base et les pads déjà affichés
-- (sinon le repli procédural resterait visible jusqu'au prochain changement de niveau).
onAssetsLoaded = function()
	for _, s in pairs(sessions) do
		pcall(function()
			applyBase(s, false, true)
			refreshAllPads(s)
		end)
	end
end

---------------------------------------------------------------- Éclosion
function hatch(s, i)
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	local guaranteed = Config.PITY_ENABLED and sl.t < #Config.TIERS and d.pity >= Config.PITY_EVERY - 1
	local p, upPoints, alienBoost = rollPet(s, sl.t, guaranteed)
	local oneIn = Reveal.oneIn(Config, Rules, sl.t, upPoints, alienBoost, p.p, p.s, p.m, guaranteed)
	if p.tier > sl.t then
		d.pity = 0
	elseif sl.t < #Config.TIERS then
		d.pity += 1
	end
	d.slots[i] = { k = "p", p = p.p, s = p.s, m = p.m }
	d.hatched += 1
	d.baseScore += Config.baseGain(p.tier) -- la base grandit avec chaque pet éclos, d'autant plus que le pet est rare
	local key = tostring(p.p)
	local dx = d.dex[key]
	if not dx then
		dx = { n = 0, b = 0 }
		d.dex[key] = dx
		s.species += 1
		qp(s, "discover", 1)
	end
	dx.n += 1
	dx.b = math.max(dx.b, Config.SIZES[p.s].mult * Config.MUTS[p.m].mult)
	refreshPad(s, i, true)
	qp(s, "hatch", 1)
	local def = Config.PETS[p.p]
	sp(s, "hatch", 1)
	applyBase(s, true)
	sp(s, "tier", 1, { tier = def.tier })
	if p.m > 1 then
		sp(s, "mut", 1)
	end
	if def.tier >= 3 then
		qp(s, "rare", 1)
	end
	storyRefresh(s)
	local big = def.tier >= 4 or p.m > 1 or p.s >= 4
	local col = Config.MUTS[p.m].color or Config.TIERS[def.tier].color
	Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 3, 0), col, big and 90 or 25, big)
	-- Rareté élevée ou tirage secret : cercle runique au sol, particules, pilier de lumière et contour lumineux du pet (Config.AURA)
	local secretHit = oneIn >= Config.REVEAL.secret.oneInAtLeast
	if Config.AURA.Enabled and (def.tier >= Config.AURA.minTier or secretHit) then
		Builder.aura(s.plot.pads[i].part.Position, col, def.tier, secretHit)
		local holder = s.plot.pads[i].content
		local petModel = holder and holder:FindFirstChild("Pet")
		if Config.AURA.highlight and petModel then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 1
			hl.OutlineColor = col
			hl.OutlineTransparency = 0.1
			hl.Parent = petModel
			game:GetService("Debris"):AddItem(hl, Config.AURA.seconds)
		end
	end
	RHatch:FireClient(s.player, { p = p.p, s = p.s, m = p.m, slot = i, inc = Config.petIncome(p.p, p.s, p.m) * gmult(s), oneIn = oneIn < math.huge and oneIn or 0, egg = sl.t, upgraded = p.tier > sl.t })
	if def.tier >= 6 or p.m == 5 or p.s == 5 then
		announce("🌟 " .. s.player.DisplayName .. " vient d'obtenir " .. def.emoji .. " " .. Config.petName(p.p, p.s, p.m) .. " !")
	end
	sync(s)
end

function speedUpEgg(s, i, who)
	if who ~= s.player then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	local now = os.clock()
	if now - s.lastTap < 0.12 then
		return
	end
	s.lastTap = now
	sl.ends -= 1
	local content = s.plot.pads[i].content
	local eggPart = content and content:FindFirstChild("Egg")
	if eggPart then
		eggPart:SetAttribute("Ends", sl.ends)
	end
	if os.time() >= sl.ends then
		hatch(s, i)
	end
end

---------------------------------------------------------------- Énigme des runes
-- Récompense : un œuf (ou son prix en pièces si la base est pleine) + des pièces. Une résolution par jour et par joueur.
local function solvePuzzle(s)
	local d = s.data
	d.puzzle.day = os.time() // 86400
	d.puzzle.solved += 1
	local tier = Config.PUZZLE_EGG_TIER
	local i = freeSlot(d)
	local coins = Config.puzzleCoins(income(s))
	if i then
		d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s) }
		refreshPad(s, i)
	else
		coins += Config.EGG_PRICE[tier]
	end
	d.coins += coins
	s.runes = { 1, 1, 1, 1 }
	Builder.burst(world.monumentCenter, Color3.fromRGB(255, 214, 120), 140, true)
	notify(s.player, "🔮 Énigme résolue ! +" .. Config.fmt(coins) .. " 🪙" .. (i and (" et un œuf " .. Config.TIERS[tier].name .. " dans ta base") or " (base pleine : l'œuf est converti en pièces)"), "rare")
	sp(s, "puzzle", 1)
	sync(s)
end

local function rotateRune(s, root, prompt)
	local idx = prompt:GetAttribute("Idx")
	if type(idx) ~= "number" or idx % 1 ~= 0 or idx < 1 or idx > #Config.RUNES then
		return
	end
	if not prompt.Parent or (root.Position - prompt.Parent.Position).Magnitude > 16 then
		return
	end
	local now = os.clock()
	if now - s.lastRune < 0.12 then
		return
	end
	s.lastRune = now
	s.runes[idx] = s.runes[idx] % #Config.RUNES + 1
	sync(s)
end

local function confirmRunes(s, root, prompt)
	if not prompt.Parent or (root.Position - prompt.Parent.Position).Magnitude > 20 then
		return
	end
	local d = s.data
	if d.puzzle.day == os.time() // 86400 then
		notify(s.player, "🔮 Tu as déjà résolu l'énigme du jour. Reviens demain !")
		return
	end
	local now = os.clock()
	if now < s.runeLock then
		notify(s.player, "🔮 Les runes se reposent… patiente quelques secondes.")
		return
	end
	local answer = currentRiddle().answer
	for i = 1, #answer do
		if s.runes[i] ~= answer[i] then
			s.runeLock = now + Config.RUNE_LOCK_SECONDS
			notify(s.player, "🔮 Les runes restent muettes… relis l'énigme de Mère Poule.", "caught")
			return
		end
	end
	solvePuzzle(s)
end

---------------------------------------------------------------- Vol (nids PNJ et bases des joueurs)
-- Le serveur mesure lui-même la durée de maintien du bouton (le client ne fait qu'afficher la barre).
local holds = {}
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
	holds[player] = { prompt = prompt, t = os.clock() }
	local s = sessions[player]
	if s then
		s.holdSeen = true
	end
end)

-- Secrets de la carte : une récompense par jour et par secret, distance et existence vérifiées côté serveur.
local function claimSecret(s, root, prompt)
	local id = prompt:GetAttribute("SecretId")
	local sct = type(id) == "string" and Config.secret(id)
	local holder = prompt.Parent
	if not sct or not holder or not holder:IsA("BasePart") or (root.Position - holder.Position).Magnitude > 18 then
		return
	end
	local today = os.time() // 86400
	if s.data.secrets[sct.id] == today then
		notify(s.player, "💤 Tu as déjà fouillé ici aujourd'hui. Reviens demain !")
		return
	end
	local reward = Config.secretReward(sct, income(s))
	s.data.secrets[sct.id] = today
	s.data.coins += reward
	Builder.burst(holder.Position, Color3.fromRGB(255, 214, 90), 24, true)
	qp(s, "secret", 1)
	notify(s.player, sct.emoji .. " " .. sct.name .. " : +" .. Config.fmt(reward) .. " 🪙", "claim")
	sync(s)
end

-- Voyage rapide : le serveur valide TOUT (zone débloquée, joueur vivant, hors combat, hors château, délai) ; l'argument vient d'un attribut du prompt, jamais du client.
local function fastTravel(s, dest, prompt)
	local root = getRoot(s.player)
	if not root or not alive(s.player) or s.stun > 0 or s.castle then
		return false
	end
	if type(dest) ~= "number" or dest % 1 ~= 0 or dest < 0 or dest > #Config.RIVALS then
		return false
	end
	if prompt and prompt.Parent and (root.Position - prompt.Parent.CFrame.Position).Magnitude > 20 then
		return false
	end
	local now = os.clock()
	if now - (s.travelAt or -99) < Config.TRAVEL.cooldown then
		return false
	end
	if s.sinceHit < Config.TRAVEL.combatLock then
		notify(s.player, "⚔️ Pas de voyage rapide en plein combat.")
		return false
	end
	if dest > 0 and not Config.zoneUnlocked(s.data.story.ch, dest) then
		notify(s.player, "🔒 Zone verrouillée : termine l'histoire jusqu'au chapitre " .. Config.ZONES[dest].chapter .. ".", "refuse")
		return false
	end
	s.travelAt = now
	local x, z = Config.travelPoint(dest)
	root.CFrame = CFrame.new(x, 4, z)
	root.AssemblyLinearVelocity = Vector3.zero
	s.noCheckUntil = now + 2
	s.lastPos = nil
	s.lastActive = now
	return true
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	if CollectionService:HasTag(prompt, "FastTravel") then
		local ss = sessions[player]
		if ss then
			fastTravel(ss, prompt:GetAttribute("Dest"), prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "CastleEntry") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 and (rr.Position - prompt.Parent.Position).Magnitude <= 20 then
			castleEnter(ss)
		end
		return
	elseif CollectionService:HasTag(prompt, "CastleChest") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) then
			castleFinish(ss, rr, prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "SecretPrompt") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 then
			claimSecret(ss, rr, prompt)
		end
		return
	end
	local kind = prompt:GetAttribute("Kind")
	if kind ~= "Nest" and kind ~= "Pad" and kind ~= "Rune" and kind ~= "RuneConfirm" then
		return
	end
	local s = sessions[player]
	local root = getRoot(player)
	if not s or not root or not alive(player) or s.stun > 0 then
		return
	end
	if kind == "Rune" then
		rotateRune(s, root, prompt)
		return
	elseif kind == "RuneConfirm" then
		confirmRunes(s, root, prompt)
		return
	end
	local now = os.clock()
	if now - s.lastSteal < 0.3 then
		return
	end
	s.lastSteal = now
	if s.holdSeen then
		local h = holds[player]
		holds[player] = nil
		if not h or h.prompt ~= prompt or os.clock() - h.t < Config.stealTime(s.data.up.fing) * 0.7 then
			return
		end
	end
	if #s.carry >= carryCap(s.data) then
		notify(player, "Sac plein ! Rapporte tes œufs à ta base.")
		return
	end

	if kind == "Nest" then
		local n = world.nests[prompt:GetAttribute("Nest")]
		if not n or not n.egg or (root.Position - n.pos).Magnitude > 18 then
			return
		end
		local zone = Config.ZONES[n.rival]
		if not Config.zoneUnlocked(s.data.story.ch, n.rival) then
			notify(player, "🔒 " .. zone.name .. " : termine d'abord le chapitre " .. zone.chapter .. " de l'histoire.", "caught")
			return
		end
		local t = n.egg
		setNestEgg(n, nil)
		Builder.flyEgg(t, n.pos, player.UserId)
		Builder.burst(n.pos, Config.TIERS[t].color, 14, false)
		n.rt = rng:NextNumber(9, 16) * (1 + (n.rival - 1) * 0.3)
		s.carry[#s.carry + 1] = { t = t, rem = hatchTime(s, t), rival = n.rival }
		s.data.stolen += 1
		qp(s, "steal", 1)
		sp(s, "steal", 1, { rival = n.rival })
		afterTake(s)
	else
		local vp = Players:GetPlayerByUserId(prompt:GetAttribute("Owner") or 0)
		local vs = vp and sessions[vp]
		local i = prompt:GetAttribute("Slot")
		if not vs or vs == s or type(i) ~= "number" then
			return
		end
		local sl = vs.data.slots[i]
		if not sl or sl.k ~= "e" then
			return
		end
		if (sl.shield or 0) > os.time() or (vs.graceUntil or 0) > os.time() then
			notify(player, "🛡 Cet œuf est encore protégé !")
			return
		end
		local pad = vs.plot.pads[i].part
		if (root.Position - pad.Position).Magnitude > 20 then
			return
		end
		vs.data.slots[i] = false
		refreshPad(vs, i)
		Builder.flyEgg(sl.t, pad.Position + Vector3.new(0, 2, 0), player.UserId)
		s.carry[#s.carry + 1] = { t = sl.t, rem = math.max(0, sl.ends - os.time()), from = vp.UserId }
		s.data.stolen += 1
		qp(s, "steal", 1)
		qp(s, "pvp", 1)
		sp(s, "steal", 1, {})
		notify(vp, "😡 " .. player.DisplayName .. " a volé ton œuf ! Rattrape-le !", "caught")
		sync(vs)
		afterTake(s)
	end
end)

---------------------------------------------------------------- Gardiens PNJ : perception, états, dégâts non mortels (voir Guard.lua)
local GC = Config.GUARD

-- Réglages de perception propres à chaque gardien (délai de réaction : Gus 1,6 s, Mara 0,9 s, Zed 0,5 s).
local gcCache = {}
local function gcFor(rival)
	local c = gcCache[rival]
	if not c then
		c = setmetatable({ alertDelay = Config.RIVALS[rival].alertDelay or GC.alertDelay }, { __index = GC })
		gcCache[rival] = c
	end
	return c
end

local function setHp(s, hp)
	s.hp = hp
	s.player:SetAttribute("Hp", math.floor(hp + 0.5))
	s.player:SetAttribute("MaxHp", GC.maxHp)
end

-- Défaite (0 pv) : œufs portés rendus à leur nid, retour à la base avec tous les pv et une courte invulnérabilité. Jamais en un seul coup.
local function defeatAtBase(s)
	dropCarry(s)
	local root = getRoot(s.player)
	if root and s.plot then
		root.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end
	s.noCheckUntil = os.clock() + 2
	s.iframes, s.sinceHit = GC.respawnIframes, 0
	setHp(s, GC.maxHp)
	notify(s.player, "🏠 Tu as été vaincu : retour à ta base, œufs rendus, pv rétablis.", "caught")
end

local function hitPlayer(s, g)
	local r = Config.RIVALS[g.rival]
	if r.gentle then
		-- gardien clément (Gus) : jamais de dégâts ; la première prise renvoie à la base (la cargaison est gardée), puis 6 s de répit
		if os.clock() < (s.gentleUntil or 0) then
			return false
		end
		s.gentleUntil = os.clock() + GC.gentleRecover
		s.stun = GC.stun
		s.noCheckUntil = os.clock() + 2
		local root0 = getRoot(s.player)
		if root0 and s.plot then
			root0.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			root0.AssemblyLinearVelocity = Vector3.zero
		end
		notify(s.player, "🐕 " .. r.name .. " t'a attrapé, réessaie ! (aucun œuf ni pet perdu)", "hurt")
		return true
	end
	local hp, hit, inv = Guard.applyDamage(s.hp, r.damage, s.iframes, GC)
	if not hit then
		return false
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	s.stun = GC.stun
	s.noCheckUntil = os.clock() + 1.2
	local root, hum = getRoot(s.player), getHum(s.player)
	if hum then
		hum.PlatformStand = true
	end
	if root then
		local away = (root.Position - g.pos) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, 1)
		root.AssemblyLinearVelocity = away * GC.knockback + Vector3.new(0, 18, 0) -- recul
	end
	notify(s.player, "🐕 " .. r.name .. " t'a mordu : -" .. r.damage .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then
		defeatAtBase(s)
	end
	return true
end

-- Cible la plus proche dans la zone de perception maximale du gardien (seuls les joueurs dont le domaine est ouvert sont ciblables).
local function inPlot(s, root)
	local rel = s.plot.cf:PointToObjectSpace(root.Position)
	return math.abs(rel.X) <= 27 and math.abs(rel.Z) <= 27 and rel.Y < 30
end

-- Zone de sécurité : la base du joueur et l'entrée du plateau (sommet de la rampe) ne sont jamais ciblées.
local function safeSpot(s, root, rival)
	if s.plot and inPlot(s, root) then
		return true
	end
	local ramp = Config.rampOf(rival)
	return math.sqrt((root.Position.X - ramp.top[1]) ^ 2 + (root.Position.Z - ramp.top[2]) ^ 2) < GC.safeRadius
end

local function candidate(g, r)
	local best, bd = nil, math.max(r.viewDist, r.hearRadius) + 2
	for player, s in pairs(sessions) do
		if Config.zoneUnlocked(s.data.story.ch, g.rival) and alive(player) then
			local root = getRoot(player)
			if root and not safeSpot(s, root, g.rival) then
				local dd = math.sqrt((root.Position.X - g.pos.X) ^ 2 + (root.Position.Z - g.pos.Z) ^ 2)
				if dd < bd then
					best, bd = player, dd
				end
			end
		end
	end
	return best
end

-- Chemin : PathfindingService en tâche de fond (ComputeAsync cède) ; sans résultat, ligne droite (repli). Retourne le point visé.
local PathfindingService = game:GetService("PathfindingService")
local function aimPoint(g, goal, dt)
	g.pathT = (g.pathT or 0) - dt
	if g.pathT <= 0 and not g.pathBusy then
		g.pathT, g.pathBusy = GC.pathInterval, true
		local from = g.pos
		task.spawn(function()
			local ok, wps = pcall(function()
				local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false })
				path:ComputeAsync(from, goal)
				if path.Status ~= Enum.PathStatus.Success then
					return nil
				end
				local out = {}
				for _, w in ipairs(path:GetWaypoints()) do
					out[#out + 1] = w.Position
				end
				return out
			end)
			g.wps = ok and wps or nil
			g.pathBusy = false
		end)
	end
	if g.wps then
		while #g.wps > 0 and ((g.wps[1].X - g.pos.X) ^ 2 + (g.wps[1].Z - g.pos.Z) ^ 2) < 4 do
			table.remove(g.wps, 1)
		end
		if g.wps[1] then
			return Vector3.new(g.wps[1].X, g.pos.Y, g.wps[1].Z)
		end
	end
	return goal
end

local MARKS = { patrol = "", alert = "❓", chase = "❗", lostChase = "❓", ["return"] = "" }

for _, g in ipairs(world.guards) do -- marque d'état au-dessus de chaque gardien (❓ alerte, ❗ poursuite)
	local ok, label = pcall(Builder.sign, g.model.PrimaryPart, "", Color3.fromRGB(255, 230, 90), 7, 80)
	if ok then
		label.TextSize = 34
		g.mark = label
	end
end

local function guardsStep(dt)
	for _, s in pairs(sessions) do -- invulnérabilité et temps depuis le dernier coup
		s.iframes = math.max(0, (s.iframes or 0) - dt)
		s.sinceHit = (s.sinceHit or 99) + dt
	end
	for _, g in ipairs(world.guards) do
		local r = Config.RIVALS[g.rival]
		g.cd -= dt
		g.st = g.st or { state = "patrol", timer = 0, lost = 0 }
		g.look = g.look or Vector3.new(g.dir, 0, 0)
		-- perception de la cible (poursuivie ou la plus proche)
		local target = g.target
		local ts = target and sessions[target]
		if not (ts and alive(target) and getRoot(target) and Config.zoneUnlocked(ts.data.story.ch, g.rival)) then
			target, ts = nil, nil
		end
		if not target and (g.st.state == "patrol" or g.st.state == "alert" or g.st.state == "return") then
			g.scan = (g.scan or 0) - dt
			if g.scan <= 0 then
				g.scan = 0.15
				target = candidate(g, r)
				ts = target and sessions[target]
			else
				target, ts = nil, nil
			end
		end
		local percept = { sees = false, hears = false, dist = math.huge, atHome = false }
		local troot = target and getRoot(target)
		if troot then
			local v = troot.AssemblyLinearVelocity
			local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
			percept = Guard.perceive(
				{ x = g.pos.X, z = g.pos.Z, fx = g.look.X, fz = g.look.Z },
				{ x = troot.Position.X, z = troot.Position.Z, speed = speed },
				r, GC
			)
			if percept.sees or percept.hears then
				g.last = Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z)
			end
		end
		local home = Vector3.new(math.clamp(g.pos.X, g.cx - 12, g.cx + 12), g.pos.Y, g.patrolZ)
		percept.atHome = (home - g.pos).Magnitude < 1
		local prev = g.st.state
		local ev
		g.st, ev = Guard.nextState(g.st, dt, percept, gcFor(g.rival))
		local state = g.st.state
		if state ~= prev then
			if state == "alert" or state == "chase" then -- aboiement ou grognement pour les joueurs proches (une fois par changement d'état)
				local key = Config.guardSoundKey(Config.Assets.guardKinds[g.rival])
				for pl in pairs(sessions) do
					local pr = getRoot(pl)
					if pr and (pr.Position - g.pos).Magnitude < 60 then
						notify(pl, "", key)
					end
				end
			end
			local mark = g.mark
			if mark then
				mark.Text = MARKS[state] or ""
			end
			if state == "chase" or state == "patrol" or state == "return" then
				g.target = (state == "chase") and target or nil
			end
			if state == "chase" then
				g.target = target or g.target
			elseif state == "return" or state == "patrol" then
				g.target = nil
				g.wps = nil
			end
		end
		local look = nil
		local prevPos = g.pos
		local want = false -- le gardien DEVRAIT-il avancer ? (sert à la détection de blocage)
		if state == "patrol" then
			want = true
			g.pos += Vector3.new(g.dir * r.patrolSpeed * dt, 0, 0)
			if g.pos.X > g.cx + 12 then
				g.dir = -1
			elseif g.pos.X < g.cx - 12 then
				g.dir = 1
			end
			look = Vector3.new(g.dir, 0, 0)
		elseif state == "alert" then
			local to = g.last and (g.last - g.pos) or g.look -- s'arrête et se tourne vers le bruit ou la dernière position vue
			look = Vector3.new(to.X, 0, to.Z)
		elseif state == "chase" or state == "lostChase" then
			local goal = (state == "chase" and troot) and Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z) or g.last
			if goal then
				local aim = aimPoint(g, goal, dt)
				local dv = Vector3.new(aim.X - g.pos.X, 0, aim.Z - g.pos.Z)
				want = (goal - g.pos).Magnitude > GC.attackRange
				if dv.Magnitude > 0.01 then
					look = dv.Unit
					g.pos += look * math.min(dv.Magnitude, r.guardSpeed * dt)
				end
				local flat = Vector3.new(goal.X - g.pos.X, 0, goal.Z - g.pos.Z)
				if state == "chase" and ts and flat.Magnitude < GC.attackRange and g.cd <= 0 then
					if hitPlayer(ts, g) then
						g.cd = GC.attackCd
					end
				end
			end
		else -- retour
			local dv = home - g.pos
			want = dv.Magnitude >= 1
			if dv.Magnitude >= 1 then
				look = dv.Unit
				g.pos += look * math.min(dv.Magnitude, r.patrolSpeed * 1.6 * dt)
			end
		end
		-- le gardien reste sur son plateau (jamais dans la douve ni dans le vide), même en poursuite
		do
			local dcx, dcz = Config.rivalCenter(g.rival)
			local nx, nz = Guard.clampToDisc(g.pos.X, g.pos.Z, dcx, dcz, Config.Map.plateauRadius - GC.territoryMargin)
			g.pos = Vector3.new(nx, g.pos.Y, nz)
		end
		-- blocage : devrait bouger mais n'avance pas depuis plus de 4 s -> retour doux à son poste, état remis à zéro
		g.stuck = g.stuck or { t = 0 }
		local moved = (g.pos - prevPos).Magnitude
		if Guard.stuckStep(g.stuck, dt, moved, want, GC) then
			g.pos = Vector3.new(g.cx, g.pos.Y, g.patrolZ)
			g.wps, g.target, g.last = nil, nil, nil
			g.st = { state = "patrol", timer = 0, lost = 0 }
			g.stuckFixes = (g.stuckFixes or 0) + 1
			pcall(function()
				g.model:SetAttribute("StuckFixes", g.stuckFixes)
			end)
			look = Vector3.new(g.dir, 0, 0)
		end
		if look and look.Magnitude > 0.01 then
			g.look = look.Unit
		end
		-- orientation vers la marche + animation procédurale (rebond et roulis en marchant, respiration à l'arrêt)
		g.speedNow = (g.speedNow or 0) * 0.8 + (moved / math.max(dt, 1e-3)) * 0.2
		local by, roll = Guard.walkPose(os.clock(), g.speedNow)
		g.model:PivotTo(CFrame.lookAt(g.pos + Vector3.new(0, by, 0), g.pos + Vector3.new(0, by, 0) + g.look) * CFrame.Angles(0, 0, roll))
	end
end

---------------------------------------------------------------- Mode Château : salles à pièges, chrono, coffre final, classement des temps
local serverMode = "arena" -- « castle » si le premier joueur arrive du hub avec TeleportData.mode == "castle"
local castleWorld = world.castle

local function castleTeleport(s, room, depth)
	local root = getRoot(s.player)
	if root then
		local wx, wz = Castle.toWorld(room, 0, depth or 3)
		root.CFrame = CFrame.new(wx, 4, wz)
		root.AssemblyLinearVelocity = Vector3.zero
		s.noCheckUntil = os.clock() + 2
	end
end

function castleEnter(s)
	s.castle = { deaths = 0, maxRoom = 1, t0 = nil, finished = false }
	castleTeleport(s, 1, -4)
	notify(s.player, "🏰 Le Château : traverse 5 salles à pièges (pics, lames, boulets, portes). Le chrono démarre à la première salle. Coffre final : œuf rare !", "event")
end

-- Donne un œuf dans un emplacement libre (protégé quelques secondes) ; base pleine : l'équivalent de la moitié du prix en pièces. Retourne true si l'œuf est placé.
local function giveEgg(s, tier)
	local d = s.data
	local i = freeSlot(d)
	if not i then
		d.coins += Config.EGG_PRICE[tier] * 0.5
		return false
	end
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s) }
	refreshPad(s, i)
	return true
end

local function castleDamage(s, kind, room)
	local dmg = Config.CASTLE.damage[kind] or 20
	local hp, hit, inv = Guard.applyDamage(s.hp, dmg, s.iframes, GC)
	if not hit then
		return
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	local label = kind == "spikes" and "des pics" or (kind == "blade" and "une lame" or (kind == "knight" and "un chevalier" or "un boulet"))
	notify(s.player, "💥 Touché par " .. label .. " : -" .. dmg .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then -- défaite : retour au début de la salle, pv rétablis (jamais de perte d'œuf)
		local rootNow = getRoot(s.player)
		if rootNow and Config.purchasable(Config.PRODUCTS.Revive) then -- offre « Relancer maintenant » (produit payant, non bloquante)
			s.revive = { pos = rootNow.Position, room = room, expires = os.clock() + Config.REVIVE.offerSeconds }
			s.player:SetAttribute("ReviveUntil", os.time() + Config.REVIVE.offerSeconds)
		end
		s.castle.deaths += 1
		setHp(s, GC.maxHp)
		s.iframes = GC.respawnIframes
		castleTeleport(s, room, 3)
		notify(s.player, "🏰 Tu retentes la salle " .. room .. " (" .. s.castle.deaths .. " défaite(s)).", "caught")
	end
end

local castleBoardTimer = 0
local function castleBoardRefresh()
	task.spawn(function()
		local top = Data.castleTop(Config.CASTLE.boardSize)
		if castleWorld and castleWorld.board then
			local lines = { "🏰 Meilleurs temps" }
			for i, e in ipairs(top) do
				lines[#lines + 1] = i .. ". " .. e.name .. "  " .. Castle.formatTime(e.time)
			end
			if #top == 0 then
				lines[#lines + 1] = "(aucun pour l'instant)"
			end
			castleWorld.board.Text = table.concat(lines, "\n")
		end
	end)
end

local function castleStep(dt)
	Builder.animProps(os.clock())
	if not castleWorld then
		return
	end
	local T = os.clock()
	-- animation des pièges (positions répliquées 10 fois par seconde)
	for r, rec in ipairs(castleWorld.rooms) do
		local room = Castle.room(r)
		for i, sp in ipairs(Castle.spikes(room)) do
			local v = rec.spikes[i]
			local state = Castle.spikeState(T, sp, room)
			if state == "warning" and v.lastState ~= "warning" then
				rec.newWarn = true
			end
			v.lastState = state
			local tipY = state == "danger" and 0.9 or (state == "warning" and 0.05 or -1)
			v.tip.Position = Vector3.new(v.wx, tipY, v.wz)
			Builder.animSpike(v, tipY, state)
			v.tip.Color = state == "danger" and Color3.fromRGB(255, 90, 90) or (state == "warning" and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(210, 214, 222))
		end
		for i, bl in ipairs(Castle.blades(room)) do
			local v = rec.blades[i]
			local angle = Castle.bladeAngle(T, bl, room)
			v.arm.CFrame = CFrame.new(v.wx, 1.4, v.wz) * CFrame.Angles(0, angle, 0)
			Builder.animBlade(v, angle)
		end
		for i, ba in ipairs(Castle.balls(room)) do
			local v = rec.balls[i]
			local bx = Castle.ballX(T, ba, room)
			local bp = bx and Vector3.new(Castle.ORIGIN.x + bx, ba.radius, v.wz) or Vector3.new(Castle.ORIGIN.x, -10, v.wz)
			v.part.Position = bp
			Builder.animBall(v, bp.X, bp.Y, bp.Z)
		end
		if rec.newWarn then -- pics qui sortent : un son par salle (au plus toutes les 0,8 s) pour les joueurs de la salle
			rec.newWarn = false
			if T - (rec.lastSpikeSfx or -9) > 0.8 then
				rec.lastSpikeSfx = T
				for pl, ps in pairs(sessions) do
					local pr = ps.castle and getRoot(pl)
					if pr and Castle.roomAt(pr.Position.X, pr.Position.Z) == r then
						notify(pl, "", "spikes")
					end
				end
			end
		end
		for i, kn in ipairs(Castle.knights(room)) do
			local v = rec.knights[i]
			local kx, dir = Castle.knightPos(T, kn)
			v.part.Position = Vector3.new(Castle.ORIGIN.x + kx, 3, v.wz)
			Builder.animKnight(v, Castle.ORIGIN.x + kx, v.wz, dir, 4 * kn.amp / kn.period)
		end
		local open = Castle.doorIsOpen(T, room)
		rec.door.Position = Vector3.new(rec.doorX, open and 14 or rec.doorClosedY, rec.doorZ)
		rec.door.CanCollide = not open
		Builder.animDoor(rec, open)
	end
	-- joueurs dans le donjon : chrono, touches
	for player, s in pairs(sessions) do
		local root = getRoot(player)
		if s.castle and root and alive(player) and not s.castle.finished then
			local r, lx, lz = Castle.roomAt(root.Position.X, root.Position.Z)
			if r then
				s.castle.maxRoom = math.max(s.castle.maxRoom, r)
				if r == 1 and lz > 2 and not s.castle.t0 then
					s.castle.t0 = T
					notify(player, "⏱ Chrono lancé !")
				end
				local kind = Castle.hit(T, Castle.room(r), lx, lz)
				if kind then
					castleDamage(s, kind, r)
				end
			end
		end
	end
	castleBoardTimer += dt
	if castleBoardTimer >= Config.CASTLE.boardSeconds then
		castleBoardTimer = 0
		castleBoardRefresh()
	end
end
task.defer(castleBoardRefresh)

function castleFinish(s, root, prompt)
	local c = s.castle
	local holder = prompt.Parent
	if not (c and c.t0 and not c.finished and holder and (root.Position - holder.Position).Magnitude <= 18) then
		return
	end
	if c.maxRoom < Castle.ROOMS then
		return notify(s.player, "Il faut traverser les " .. Castle.ROOMS .. " salles avant d'ouvrir le coffre.")
	end
	c.finished = true
	notify(s.player, "", "fanfare")
	Builder.openChest()
	local seconds = os.clock() - c.t0
	local reward = Castle.reward(seconds, income(s), c.deaths)
	s.data.coins += reward.coins
	local placed = giveEgg(s, reward.eggTier)
	qp(s, "castle", 1)
	Data.castleSubmit(s.player, seconds)
	notify(s.player, "🏆 Château terminé en " .. Castle.formatTime(seconds) .. " (" .. c.deaths .. " défaite(s)) : +" .. Config.fmt(reward.coins) .. " 🪙 et un œuf " .. Config.TIERS[reward.eggTier].name .. (placed and " dans ta base !" or " (base pleine : converti en pièces)."), "claim")
	sync(s)
	task.delay(4, function()
		if s.player.Parent and sessions[s.player] == s then
			s.castle = nil
			local root2 = getRoot(s.player)
			if root2 and s.plot then
				root2.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			end
			castleBoardRefresh()
		end
	end)
end

---------------------------------------------------------------- Événements serveur
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "EventTint"
tint.Parent = Lighting
local evTimer = rng:NextNumber(25, 40)

local function setEvent(cfg)
	if cfg then
		currentEvent = { cfg = cfg, ends = os.time() + Config.EVENT_DURATION }
		workspace:SetAttribute("EventKey", cfg.key)
		workspace:SetAttribute("EventEnds", currentEvent.ends)
		tint.TintColor = cfg.tint
		for _, p in ipairs(Players:GetPlayers()) do
			notify(p, cfg.emoji .. " " .. cfg.name .. " ! " .. cfg.desc, "event")
		end
	else
		currentEvent = nil
		workspace:SetAttribute("EventKey", nil)
		workspace:SetAttribute("EventEnds", nil)
		tint.TintColor = Color3.new(1, 1, 1)
	end
	for _, s in pairs(sessions) do
		sync(s)
	end
end

local function eventStep(dt)
	if currentEvent then
		if os.time() >= currentEvent.ends then
			setEvent(nil)
			evTimer = rng:NextNumber(Config.EVENT_GAP[1], Config.EVENT_GAP[2])
		end
	else
		evTimer -= dt
		if evTimer <= 0 then
			setEvent(Config.EVENTS[rng:NextInteger(1, #Config.EVENTS)])
		end
	end
end

---------------------------------------------------------------- Boucles de jeu
local function fastTick(dt)
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			local root = getRoot(player)
			local hum = getHum(player)
			if s.stun > 0 then
				s.stun -= dt
				if s.stun <= 0 and hum then
					hum.PlatformStand = false
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
			if not (root and hum and hum.Health > 0) then
				return
			end
			-- tapis roulant : il faut courir dessus
			if s.stun <= 0 and world.treadmillContains(root.Position) and hum.MoveDirection.Magnitude > 0.1 then
				local rate = 0.8 * (1 + 0.35 * d.up.tm) * (evKey() == "run" and 3 or 1)
				d.speed += rate * dt
				qp(s, "train", dt)
				sp(s, "train", dt)
			end
			applySpeed(s)
			-- contrôle de vitesse : si le joueur parcourt bien plus que sa vitesse autorisée, on le remet en place
			local pos = root.Position
			if s.lastPos and s.stun <= 0 and os.clock() > s.noCheckUntil then
				local moved = Vector3.new(pos.X - s.lastPos.X, 0, pos.Z - s.lastPos.Z).Magnitude
				local allowed = (Config.walkSpeed(d.speed) * speedMul(s) + 16) * dt * 1.4 + 3
				if moved > allowed then
					s.flags += 1
					if s.flags >= 3 then
						root.CFrame = CFrame.new(s.lastPos) * root.CFrame.Rotation
						s.flags = 0
						warn("[AntiCheat] " .. player.Name .. " remis en place (vitesse anormale)")
						pos = s.lastPos
					end
				else
					s.flags = 0
				end
			end
			if s.lastPos and (pos - s.lastPos).Magnitude > 0.3 then
				s.lastActive = os.clock() -- déplacement = joueur actif
			end
			s.lastPos = pos
			-- dépôt des œufs dans sa base
			if #s.carry > 0 and inPlot(s, root) then
				local i = freeSlot(d)
				if not i then
					if os.clock() - s.lastFull > 4 then
						s.lastFull = os.clock()
						notify(player, "Base pleine ! Vends un pet ou agrandis-la.")
					end
				else
					local e = table.remove(s.carry, 1)
					d.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(s) }
					refreshPad(s, i)
					Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 2, 0), Config.TIERS[e.t].color, 12, false)
					rebuildCarry(s)
					applySpeed(s)
					sync(s)
				end
			end
		end)
		if not ok then
			warn("[fastTick] " .. tostring(err))
		end
	end
end

local function petLabel(s, sl)
	local def = Config.PETS[sl.p]
	return string.format("%s %s\n+%s/s", def.emoji, Config.petName(sl.p, sl.s, sl.m), Config.fmt(Config.petIncome(sl.p, sl.s, sl.m) * gmult(s)))
end

local function slowTick(dt)
	eventStep(dt)
	currentRiddle() -- change l'énoncé à minuit (UTC)
	for _, n in ipairs(world.nests) do
		if not n.egg then
			n.rt -= dt
			if n.rt <= 0 then
				setNestEgg(n, wpick(Config.RIVALS[n.rival].weights))
			end
		end
	end
	local now = os.time()
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			local inc = income(s)
			local active = os.clock() - s.lastActive <= Config.IDLE.seconds
			if (player:GetAttribute("Idle") == true) == active then
				player:SetAttribute("Idle", not active) -- le client affiche « 💤 revenus en pause »
			end
			if active then
				d.coins += inc * dt
				qp(s, "earn", inc * dt)
			end
			ensureQuests(s)
			storyRefresh(s)
			s.syncT += dt
			if s.syncT >= 10 then
				s.syncT = 0
				RState:FireClient(player, snapshot(s))
			end
			for i = 1, cap(d) do
				local sl = d.slots[i]
				if sl and sl.k == "e" then
					if now >= sl.ends then
						hatch(s, i)
					else
						local lbl = s.labels[i]
						if lbl then
							local txt = "🥚 " .. Config.fmtTime(sl.ends - now) .. ((sl.shield or 0) > now and "  🛡" or "")
							if lbl.Text ~= txt then
								lbl.Text = txt
							end
						end
					end
				elseif sl and sl.k == "p" then
					local lbl = s.labels[i]
					if lbl then
						local txt = petLabel(s, sl)
						if lbl.Text ~= txt then
							lbl.Text = txt
						end
					end
				end
			end
			-- régénération des pv (rapide dans la base, lente ailleurs après un délai sans coup)
			if s.hp < GC.maxHp then
				local root = getRoot(player)
				local atBase = root ~= nil and s.plot ~= nil and (root.Position - s.plot.spawn.Position).Magnitude < 40
				local newHp = Guard.regen(s.hp, s.sinceHit, dt, atBase, GC)
				if newHp ~= s.hp then
					setHp(s, newHp)
				end
			end
			pushStats(s)
		end)
		if not ok then
			warn("[slowTick] " .. tostring(err))
		end
	end
end

local acc1, acc2, acc3 = 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	guardsStep(dt)
	acc3 += dt
	if acc3 >= Config.CASTLE.step then
		local d3 = acc3
		acc3 = 0
		castleStep(d3)
	end
	acc2 += dt
	if acc2 >= 0.25 then
		local d2 = acc2
		acc2 = 0
		fastTick(d2)
	end
	acc1 += dt
	if acc1 >= 1 then
		local d1 = acc1
		acc1 = 0
		slowTick(d1)
	end
end)

---------------------------------------------------------------- Actions du client
local actions = {}

-- Retour au hub : la progression est sauvegardée d'abord ; si la téléportation échoue, le joueur reste en jeu avec un message clair.
function actions.toHub(s)
	local now = os.clock()
	if s.leaving or now - (s.toHubAt or -100) < 15 then
		return
	end
	if Config.Game.roleFor(game.PlaceId) ~= "game" then
		return notify(s.player, "Le hub n'est pas disponible depuis ce lieu.")
	end
	s.toHubAt = now
	if not s.noSave then
		Data.save(s.player, s.data)
	end
	local res = Party.returnToHub(Config, {
		teleport = function(players, placeId, _, data)
			local opts = Instance.new("TeleportOptions")
			opts:SetTeleportData(data)
			TeleportService:TeleportAsync(placeId, players, opts)
		end,
		log = warn,
	}, s.player, serverPartyId)
	if res.ok then
		notify(s.player, "🏠 Retour au hub…")
	else
		notify(s.player, "⚠️ " .. res.message)
	end
end

function actions.sync(s)
	sync(s)
end

function actions.buyEgg(s, tier)
	if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > #Config.TIERS then
		return
	end
	local d = s.data
	local price = Config.EGG_PRICE[tier]
	if d.coins < price then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	local i = freeSlot(d)
	if not i then
		return notify(s.player, "Base pleine !")
	end
	d.coins -= price
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s) }
	refreshPad(s, i)
	notify(s.player, "", "buy")
	sync(s)
end

function actions.buyUp(s, key)
	local u = type(key) == "string" and Config.upgrade(key)
	if not u then
		return
	end
	local d = s.data
	local l = d.up[key]
	if l >= u.max then
		return
	end
	local cost = u.cost(l)
	if d.coins < cost then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	d.coins -= cost
	notify(s.player, "", "buy")
	d.up[key] = l + 1
	if key == "slots" then
		refreshAllPads(s)
	end
	sync(s)
end

function actions.sell(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	s.data.coins += Config.sellValue(sl.p, sl.s, sl.m)
	s.data.slots[i] = false
	qp(s, "sell", 1)
	refreshPad(s, i)
	rebuildFollowers(s)
	sync(s)
end

-- Revend un œuf d'un emplacement (25 % du prix). Validé côté serveur : emplacement existant, contient un œuf.
function actions.sellEgg(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	s.data.coins += Config.eggSellValue(sl.t)
	s.data.slots[i] = false
	refreshPad(s, i)
	qp(s, "sell", 1)
	sync(s)
end

-- Revend les doublons de pets (garde le meilleur de chaque espèce). Les pets revendus quittent la liste de ceux qui suivent le joueur.
function actions.sellDupes(s)
	local d = s.data
	local list, total = Config.dupesToSell(d.slots, cap(d))
	if #list == 0 then
		return notify(s.player, "Aucun doublon à revendre.")
	end
	for _, i in ipairs(list) do
		d.slots[i] = false
		refreshPad(s, i)
		for n = #d.equip, 1, -1 do
			if d.equip[n] == i then
				table.remove(d.equip, n)
			end
		end
		qp(s, "sell", 1)
	end
	d.coins += total
	rebuildFollowers(s)
	notify(s.player, "⭐ " .. #list .. " doublon(s) échangé(s) : +" .. Config.fmt(total) .. " 🪙", "claim")
	sync(s)
end

function actions.rebirth(s)
	local d = s.data
	if d.coins < Config.rebirthCost(d.rb) then
		return notify(s.player, "Pas assez de pièces pour renaître.", "refuse")
	end
	local fresh = Data.default()
	fresh.speed, fresh.rb, fresh.dex = d.speed, d.rb + 1, d.dex
	fresh.daily, fresh.streak, fresh.stolen, fresh.hatched = d.daily, d.streak, d.stolen, d.hatched
	fresh.quests, fresh.qday, fresh.receipts, fresh.luckUntil = d.quests, d.qday, d.receipts, d.luckUntil
	fresh.story, fresh.pity = d.story, d.pity
	fresh.puzzle, fresh.ach = d.puzzle, d.ach
	fresh.cine = d.cine
	fresh.secrets = d.secrets
	fresh.starter, fresh.baseScore = d.starter, d.baseScore -- l'achat unique du pack de départ et la progression de la base survivent à la renaissance
	dropCarry(s)
	s.data = fresh
	refreshAllPads(s)
	rebuildFollowers(s)
	storyRefresh(s)
	sync(s)
	notify(s.player, string.format("🌅 Renaissance ! Revenus x%.1f", 1 + 0.5 * fresh.rb), "claim")
end

function actions.equip(s, i)
	if not validSlot(i) then
		return
	end
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	local at
	for n, v in ipairs(d.equip) do
		if v == i then
			at = n
		end
	end
	if at then
		table.remove(d.equip, at)
	else
		if #d.equip >= Config.MAX_FOLLOWERS then
			return notify(s.player, "Maximum " .. Config.MAX_FOLLOWERS .. " pets qui te suivent.")
		end
		d.equip[#d.equip + 1] = i
	end
	rebuildFollowers(s)
	sync(s)
end

function actions.claimQuest(s, i)
	local q = type(i) == "number" and s.data.quests[i]
	if not q or q.claimed or q.prog < q.goal then
		return
	end
	q.claimed = true
	s.data.coins += q.rew
	local extra = ""
	if (q.re or 0) > 0 and Config.TIERS[q.re] then
		extra = extra .. (giveEgg(s, q.re) and (" + œuf " .. Config.TIERS[q.re].name) or " (base pleine : œuf converti en pièces)")
	end
	if (q.rb or 0) > 0 then
		s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + q.rb
		extra = extra .. " + boost de chance"
	end
	notify(s.player, "🎯 Mission accomplie : +" .. Config.fmt(q.rew) .. " 🪙" .. extra, "claim")
	sync(s)
end

function actions.claimStory(s)
	local st = s.data.story
	local c = chapter(s)
	if not c or st.prog < c.goal then
		return
	end
	local rankBefore = Config.rankFor(st.ch).name
	local reward = Config.storyReward(c, income(s))
	s.data.coins += reward
	st.ch += 1
	st.prog = 0
	updateSign(s)
	notify(s.player, "📜 « " .. c.title .. " » accompli : +" .. Config.fmt(reward) .. " 🪙", "claim")
	local nextChapter = chapter(s)
	if nextChapter then
		notify(s.player, "📖 Chapitre " .. (st.ch + 1) .. " : " .. nextChapter.title .. " (Missions > Histoire)")
	else
		notify(s.player, "👑 Histoire terminée : tu es Roi des Couvées !", "event")
	end
	for _, z in ipairs(Config.ZONES) do
		if z.chapter > 0 and z.chapter == st.ch then
			notify(s.player, "🔓 " .. z.name .. " est ouvert ! Ses œufs sont plus rares.", "event")
		end
	end
	local rank = Config.rankFor(st.ch)
	if rank.name ~= rankBefore then
		notify(s.player, "🎖 Nouveau rang : " .. rank.emoji .. " " .. rank.name .. " !", "event")
	end
	storyRefresh(s) -- le chapitre suivant peut être déjà accompli (espèces déjà découvertes...)
	sync(s)
end

-- Mémorise qu'une cinématique a été vue (ou passée) : elle ne se rejouera pas à la prochaine connexion.
function actions.cineSeen(s, id)
	if type(id) ~= "string" then
		return
	end
	for _, known in ipairs(Config.CINE_IDS) do
		if known == id then
			if not s.data.cine[id] then
				s.data.cine[id] = true
				sync(s)
			end
			return
		end
	end
end

function actions.claimAch(s, id)
	local a = type(id) == "string" and Config.achievement(id)
	if not a then
		return
	end
	local d = s.data
	local tier = d.ach[a.id] or 0
	if tier >= #a.goals then
		return
	end
	local value = statValues(s)[a.stat]
	if not value or value < a.goals[tier + 1] then
		return
	end
	local reward = Config.achReward(tier + 1, income(s))
	d.ach[a.id] = tier + 1
	d.coins += reward
	notify(s.player, "🏅 Succès « " .. a.name .. " » (palier " .. (tier + 1) .. ") : +" .. Config.fmt(reward) .. " 🪙", "claim")
	sync(s)
end

local topCache = {}
function actions.top(s)
	RTop:FireClient(s.player, topCache)
end

function actions.claimAway(s)
	local gain = math.floor(s.data.pendingAway)
	if gain < 1 then
		return
	end
	s.data.pendingAway = 0
	s.data.coins += gain
	notify(s.player, "💰 Gains récupérés : +" .. Config.fmt(gain) .. " 🪙", "claim")
	RState:FireClient(s.player, snapshot(s))
end

function actions.daily(s)
	local d = s.data
	local today = os.time() // 86400
	if d.daily == today then
		return notify(s.player, "Bonus déjà récupéré aujourd'hui !")
	end
	local streak = (d.daily == today - 1) and d.streak + 1 or 1
	local reward = math.floor(math.max(200, income(s) * 600) * math.min(streak, 7) * (s.passes.VipBase == true and Config.VIP_DAILY_MUL or 1))
	d.daily, d.streak = today, streak
	d.coins += reward
	notify(s.player, "🎁 Bonus quotidien : +" .. Config.fmt(reward) .. " 🪙 (série " .. streak .. ")", "claim")
	sync(s)
end

RAction.OnServerEvent:Connect(function(player, action, arg)
	local s = sessions[player]
	if not s or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - s.lastAct < 0.08 then
		return
	end
	s.lastAct = now
	s.lastActive = now -- toute action = joueur actif
	local fn = actions[action]
	if fn then
		local ok, err = pcall(fn, s, arg)
		if not ok then
			warn("[Action " .. action .. "] " .. tostring(err))
		end
	end
end)

---------------------------------------------------------------- Game Passes
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local s = sessions[player]
	if not (s and purchased) then
		return
	end
	for name, def in pairs(Config.PASSES) do
		if Config.purchasable(def) and def.id == passId then
			s.passes[name] = true
		end
	end
	sync(s)
end)

---------------------------------------------------------------- Produits développeur (achats Robux ponctuels)
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local s = player and sessions[player]
	if not s then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local rid = tostring(info.PurchaseId)
	local function persist()
		-- PurchaseGranted seulement une fois la sauvegarde réussie ; sinon Roblox rappellera ProcessReceipt (le reçu en mémoire n'est
		-- compté « traité » qu'après une sauvegarde réussie, la livraison n'est donc jamais refaite : s.pendingReceipts).
		if not s.noSave and not Data.save(player, s.data) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		s.pendingReceipts[rid] = nil
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if s.pendingReceipts[rid] then
		return persist() -- déjà livré en mémoire, il ne reste qu'à sauvegarder
	end
	if s.data.receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local granted = false
	for name, def in pairs(Config.PRODUCTS) do
		if Config.purchasable(def) and def.id == info.ProductId then
			if name == "StarterPack" then
				if s.data.starter then
					return Enum.ProductPurchaseDecision.NotProcessedYet -- achat unique : déjà fait, rien n'est livré
				end
				s.data.starter = true
				s.data.coins += Config.STARTER_PACK.coins
				for _ = 1, Config.STARTER_PACK.eggs do
					giveEgg(s, Config.STARTER_PACK.eggTier)
				end
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
			elseif name == "ExclusiveEgg" then
				if not freeSlot(s.data) then
					notify(player, "Base pleine : libère une place, ton achat sera livré automatiquement.")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				giveEgg(s, Config.EXCLUSIVE_EGG_TIER)
			elseif name == "InstantHatch" then
				for i = 1, cap(s.data) do
					hatch(s, i)
				end
			elseif name == "Revive" then
				local rv = s.revive
				s.revive = nil
				player:SetAttribute("ReviveUntil", nil)
				local root = getRoot(player)
				if s.castle and not s.castle.finished and rv and os.clock() <= rv.expires + 5 and root then
					-- relance sur place : retour là où il est tombé, pv pleins, invulnérable un moment, la défaite n'est pas comptée
					root.CFrame = CFrame.new(rv.pos + Vector3.new(0, 3, 0))
					root.AssemblyLinearVelocity = Vector3.zero
					s.noCheckUntil = os.clock() + 2
					setHp(s, GC.maxHp)
					s.iframes = Config.REVIVE.iframes
					s.castle.deaths = math.max(0, s.castle.deaths - 1)
					notify(player, "💫 Relance ! Tu repars de là où tu es tombé.", "claim")
				else
					-- l'offre a expiré (ou il a quitté le château) : l'achat n'est jamais perdu, il est remplacé par une potion de chance
					s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
					notify(player, "💫 L'offre de relance avait expiré : une potion de chance t'est offerte à la place.", "claim")
				end
			elseif name == "LuckPotion" then
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
			elseif name == "CoinPack" then
				s.data.coins += math.max(Config.COIN_PACK_MIN, income(s) * Config.COIN_PACK_MINUTES * 60)
			end
			granted = true
		end
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local now = os.time()
	for k, t in pairs(s.data.receipts) do
		if type(t) ~= "number" or now - t > 30 * 86400 then
			s.data.receipts[k] = nil
		end
	end
	s.data.receipts[rid] = now
	s.pendingReceipts[rid] = true
	sync(s)
	return persist()
end

---------------------------------------------------------------- Cycle de vie des joueurs
local function claimPlot(player)
	for _, pl in ipairs(world.plots) do
		if not pl.owner then
			pl.owner = player
			pl.nameLabel.Text = "🏠 Base de " .. player.DisplayName
			return pl
		end
	end
	return nil
end

local function releasePlot(s)
	for i = 1, 12 do
		clearPad(s, i)
		s.plot.pads[i].lock.Enabled = true
		s.plot.pads[i].part.Transparency = 0.7
		s.plot.pads[i].frame.Color = Color3.fromRGB(50, 52, 58)
		s.plot.pads[i].frame.Material = Enum.Material.SmoothPlastic
	end
	s.plot.owner = nil
	s.plot.nameLabel.Text = "Base libre"
	Builder.clearBase(s.plot)
end

-- Partie pleine (5 joueurs au plus) ou lieu de jeu ouvert en trop : le joueur est renvoyé au hub (ou expulsé avec un message si le hub est injoignable).
local function bounceToHub(player, message)
	local hub = Config.Game.Places.hub
	local role = Config.Game.roleFor(game.PlaceId)
	if role == "game" and type(hub) == "number" and hub > 0 then
		local opts = Instance.new("TeleportOptions")
		opts:SetTeleportData({ from = "game", reason = "full" })
		local ok = pcall(function()
			TeleportService:TeleportAsync(hub, { player }, opts)
		end)
		if ok then
			return
		end
	end
	player:Kick(message)
end


local function onJoin(player)
	local okJ, joinData = pcall(function()
		return player:GetJoinData().TeleportData
	end)
	local admitted, why = Party.admitJoin(serverPartyId, okJ and joinData or nil, #Players:GetPlayers() - 1, Config.Game.MaxPlayers, Config.Game.roleFor(game.PlaceId))
	if not admitted then
		bounceToHub(player, why == "full" and ("Cette partie est pleine (" .. Config.Game.MaxPlayers .. " joueurs maximum). Réessaie avec une autre partie.") or "Tu ne fais pas partie de cette partie.")
		return
	end
	if serverPartyId == nil and okJ and type(joinData) == "table" and type(joinData.partyId) == "string" then
		serverPartyId = joinData.partyId
	end
	if okJ and type(joinData) == "table" and joinData.mode == "castle" and next(sessions) == nil then
		serverMode = "castle" -- le premier joueur détermine le mode du serveur réservé
	end
	local late = next(sessions) ~= nil -- arrivée dans une partie déjà commencée
	local waitedLeave = 0
	while leavingSave[player.UserId] and waitedLeave < 20 and player.Parent do -- il vient de partir : attendre la fin de sa sauvegarde (sinon on lirait un profil périmé puis on l'écraserait)
		task.wait(0.25)
		waitedLeave += 0.25
	end
	local d, noSave = Data.load(player)
	if not d then
		player:Kick("Impossible de charger tes données. Reconnecte-toi dans un instant.")
		return
	end
	if pendingSaves[player.UserId] and not noSave then
		d = pendingSaves[player.UserId] -- il revient avant que sa dernière sauvegarde ait réussi : ce profil (plus récent) fait foi
		pendingSaves[player.UserId] = nil
	end
	if not player.Parent then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session
		end
		return
	end
	local plot = claimPlot(player)
	if not plot then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session avant de refuser
		end
		player:Kick("Serveur plein. Réessaie dans un autre serveur.")
		return
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local function stat(name)
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
		return v
	end
	local rankStat = Instance.new("StringValue")
	rankStat.Name = "Rang"
	rankStat.Parent = ls
	local s = {
		species = speciesCount(d), lsRank = rankStat,
		player = player, data = d, plot = plot, carry = {}, carryParts = {}, labels = {}, passes = {},
		graceUntil = late and (os.time() + Config.Game.LateJoinGrace) or 0, hp = Config.GUARD.maxHp, iframes = 0, sinceHit = 99, stun = 0, lastAct = 0, lastActive = os.clock(), lastTap = 0, lastSteal = 0, lastFull = 0, noSave = noSave,
		followers = {}, pendingReceipts = {}, holdSeen = false, flags = 0, noCheckUntil = 0, syncT = 0, leaving = false,
		runes = { 1, 1, 1, 1 }, lastRune = 0, runeLock = 0,
		lsCoins = stat("Pièces"), lsSpeed = stat("Vitesse"), lsRb = stat("Renaissances"),
	}
	ls.Parent = player
	player:SetAttribute("Hp", Config.GUARD.maxHp)
	player:SetAttribute("MaxHp", Config.GUARD.maxHp)
	sessions[player] = s
	if plot and plot.spawn then
		player:SetAttribute("BaseX", plot.spawn.Position.X) -- le client affiche la distance à la base sur la bannière de zone
		player:SetAttribute("BaseZ", plot.spawn.Position.Z)
	end
	if late then
		notify(player, "🛡 Tu arrives en cours de partie : tes œufs sont protégés " .. Config.Game.LateJoinGrace .. " s.")
	end

	for name, def in pairs(Config.PASSES) do
		s.passes[name] = false
		if Config.purchasable(def) then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			s.passes[name] = ok and owns == true
		end
	end

	-- gains hors-ligne (les œufs éclosent seuls grâce aux horodatages)
	local away = math.clamp(os.time() - d.last, 0, Config.IDLE.offlineMaxSeconds)
	if away > 30 then
		local gain = income(s) * away * Config.IDLE.offlineRate
		d.pendingAway = math.min(d.pendingAway + gain, math.max(income(s), 1) * Config.IDLE.offlineMaxSeconds * Config.IDLE.offlineRate) -- mis de côté (plafonné) : se récupère d'un clic (claimAway)
	end
	if d.pendingAway >= 1 then
		notify(player, "💤 Gains pendant ton absence : " .. Config.fmt(d.pendingAway) .. " 🪙 : touche « Récupérer »")
	end

	ensureQuests(s)
	applyBase(s, false)
	updateSign(s)
	refreshAllPads(s)
	player:SetAttribute("PlotCF", plot.cf) -- position de la base : sert aux caméras des cinématiques (réplication sûre)
	player.RespawnLocation = plot.spawn
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		s.stun = 0
		s.carry = {}
		s.carryParts = {}
		s.lastPos = nil
		s.followers = {}
		applySpeed(s)
		task.spawn(function()
			char:WaitForChild("HumanoidRootPart", 10)
			if player.Parent and sessions[player] == s then
				rebuildFollowers(s)
				if serverMode == "castle" and not s.castle then
					castleEnter(s) -- serveur de mode Château : arrivée directement à l'entrée du donjon
				end
			end
		end)
		hum.Died:Connect(function()
			dropCarry(s)
			clearFollowers(s)
			task.delay(3, function()
				if player.Parent and sessions[player] == s then
					pcall(function()
						player:LoadCharacterAsync()
					end)
				end
			end)
		end)
	end)
	if player.Parent then
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok then
			warn("[onJoin] LoadCharacterAsync : " .. tostring(err))
		end
		if player.Parent then
			sync(s)
		end
	end
end

Players.PlayerAdded:Connect(onJoin)
-- Filet de sécurité : personnage garanti dans la zone, replacement si chute (voir Spawn / SpawnGuard, traces [Spawn] en console serveur)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpawnGuard")).attach({
	role = "game",
	safeCFrame = function(p)
		local ss = sessions[p]
		local sp = ss and ss.plot and ss.plot.spawn
		if sp then
			return sp.CFrame + Vector3.new(0, 4, 0)
		end
		return CFrame.new(0, 8, 60) -- à côté du tapis roulant : toujours au sol de l'arène
	end,
})
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

-- Profils dont la sauvegarde de départ a échoué : réessayée en arrière-plan (délais croissants, 10 essais), abandonnée si le joueur est revenu
-- (sa nouvelle session reprend ce profil au chargement) ; vidée aussi à la fermeture du serveur (BindToClose).
function saveLater(player, d)
	local uid = player.UserId
	pendingSaves[uid] = d
	task.spawn(function()
		local delay = 4
		for _ = 1, 10 do
			task.wait(delay)
			delay = math.min(delay * 2, 60)
			if pendingSaves[uid] ~= d then
				return
			end
			if Players:GetPlayerByUserId(uid) then
				return -- revenu : le chargement a repris pendingSaves, rien à écraser
			end
			if Data.save(player, d, true) then
				pendingSaves[uid] = nil
				return
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	local s = sessions[player]
	if not s then
		return
	end
	s.leaving = true -- l'autosave ne doit plus reprendre le verrou de session après ce point
	dropCarry(s)
	clearFollowers(s)
	holds[player] = nil
	if not s.noSave then
		leavingSave[player.UserId] = true
		local okSave = Data.save(player, s.data, true) -- libère le verrou
		if not okSave then
			saveLater(player, s.data) -- DataStore en panne ou lent : on réessaie en arrière-plan (la progression n'est pas perdue)
		end
		leavingSave[player.UserId] = nil
		Data.submit(player, s.data)
	end
	releasePlot(s)
	sessions[player] = nil
end)

-- sauvegarde automatique toutes les 60 s
task.spawn(function()
	while true do
		task.wait(60)
		for player, s in pairs(sessions) do
			if not s.noSave and not s.leaving then
				task.spawn(function()
					Data.save(player, s.data)
					Data.submit(player, s.data)
				end)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for uid, d in pairs(pendingSaves) do -- profils de joueurs déjà partis dont la sauvegarde a échoué
		pending += 1
		task.spawn(function()
			local ghost = Players:GetPlayerByUserId(uid) or { UserId = uid, Name = "joueur " .. uid }
			if Data.save(ghost, d, true) then
				pendingSaves[uid] = nil
			end
			pending -= 1
		end)
	end
	for player, s in pairs(sessions) do
		if not s.noSave then
			pending += 1
			task.spawn(function()
				Data.save(player, s.data, true)
				pending -= 1
			end)
		end
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 25 do
		task.wait()
	end
end)

-- classement global : rafraîchi toutes les 2 minutes
task.spawn(function()
	while true do
		topCache = Data.top(10)
		task.wait(120)
	end
end)

print("[Chipe-Œufs] serveur prêt")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Data
-- Sauvegarde DataStore avec VERROU DE SESSION (un joueur ne peut pas être chargé sur 2 serveurs à la fois :
-- empêche les pertes et duplications quand on change de serveur vite) + classement global.
-- Les emplacements vides valent `false` (un tableau JSON ne supporte pas les trous).
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Diag = require(script.Parent:WaitForChild("Diag"))

local STORE_NAME = "ChipeOeufs_v1"
local CASTLE_NAME = "ChipeOeufs_Castle_v1"
local BOARD_NAME = "ChipeOeufs_Board_v1"
local SLOT_COUNT = 12
local LOCK_TTL = 120 -- un verrou plus vieux que ça est considéré comme abandonné (crash serveur)
local SAVE_RETRIES = 3

-- Version du schéma des données sauvegardées. À incrémenter à chaque changement de structure, avec une étape dans migrate().
-- v1 : première version (sans champ ver). v2 : + equip, quests, qday, receipts, luckUntil, ver.
-- v3 : + story { ch, prog } (histoire) et pity (compteur de pitié).
-- v4 : + puzzle { day, solved } (énigmes), ach (succès) ; un chapitre d'histoire (énigme) est inséré en position 8.
-- v5 : + cine (cinématiques déjà vues).
-- v6 : + secrets (jour de la dernière fouille par secret de la carte).
-- v7 : + starter (pack de départ déjà acheté, achat unique).
-- v8 : + baseScore (progression de la base : points pondérés par la rareté des pets éclos).
local VERSION = 8

-- Studio sans accès aux API (réglage « Enable Studio Access to API Services » désactivé) : détecté à la première erreur précise,
-- puis le jeu passe en mode mémoire (aucune sauvegarde, aucun classement) avec UN seul avertissement. Ne concerne pas les vrais serveurs.
local apiBlocked = false
local function markApiBlocked(err)
	if Diag.isStudioApiError(err) then
		if not apiBlocked then
			apiBlocked = true
			warn("[Data] Studio sans accès aux API : mode mémoire (rien n'est sauvegardé, pas de classement). Pour tester les sauvegardes : Game Settings > Security > Enable Studio Access to API Services.")
		end
		return true
	end
	return false
end

local Data = {}
Data.VERSION = VERSION
Data.SERVER_ID = HttpService:GenerateGUID(false)

local store, board, castleBoard
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	local ok2, result2 = pcall(function()
		return DataStoreService:GetOrderedDataStore(BOARD_NAME)
	end)
	if ok2 then
		board = result2
	end
	local ok3, result3 = pcall(function()
		return DataStoreService:GetOrderedDataStore(CASTLE_NAME)
	end)
	if ok3 then
		castleBoard = result3
	end
end

function Data.default()
	local d = {
		ver = VERSION,
		coins = Config.START_COINS,
		speed = 0,
		rb = 0,
		up = {},
		slots = {},
		dex = {}, -- clé = tostring(index d'espèce)
		daily = 0, -- dernier jour réclamé (os.time() // 86400)
		streak = 0,
		stolen = 0,
		hatched = 0,
		last = os.time(),
		equip = {}, -- indices d'emplacements dont le pet suit le joueur
		quests = {}, -- missions du jour
		qday = 0,
		receipts = {}, -- achats Robux déjà traités (anti-double crédit)
		luckUntil = 0,
		story = { ch = 0, prog = 0 }, -- ch = chapitres réussis, prog = progression du chapitre en cours
		pity = 0,
		puzzle = { day = 0, solved = 0 }, -- day = dernier jour où l'énigme a été résolue
		ach = {}, -- id de succès -> palier déjà réclamé
		cine = {}, -- id de cinématique -> true une fois vue ou passée
		baseScore = 0, -- progression de la base
		pendingAway = 0, -- gains hors ligne à récupérer d'un clic (plafonnés à Config.IDLE.offlineMaxSeconds)
		starter = false, -- pack de départ déjà acheté (achat unique)
		secrets = {}, -- id de secret -> jour (os.time() // 86400) de la dernière fouille
	}
	for _, u in ipairs(Config.UPGRADES) do
		d.up[u.key] = 0
	end
	for i = 1, SLOT_COUNT do
		d.slots[i] = false
	end
	d.slots[1] = { k = "e", t = 1, ends = os.time() + 6, shield = 0 } -- œuf de départ
	return d
end

-- Garde-fou contre les valeurs corrompues (NaN, infini, négatif)
local function sane(v, default)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge or v < 0 then
		return default
	end
	return v
end

-- Migrations successives : chaque étape fait passer les données de la version n à n+1.
local MIGRATIONS = {
	[1] = function(_saved)
		-- v1 -> v2 : les nouveaux champs reçoivent leurs valeurs par défaut dans merge(), rien à convertir.
	end,
	[2] = function(_saved)
		-- v2 -> v3 : story et pity reçoivent leurs valeurs par défaut (histoire à reprendre au chapitre 1).
	end,
	[7] = function(saved)
		-- v7 -> v8 : le score de base est reconstitué d'après la collection (nombre de pets obtenus par espèce x poids de leur rareté).
		local score = 0
		if type(saved.dex) == "table" then
			for k, e in pairs(saved.dex) do
				local def = Config.PETS[tonumber(k) or 0]
				if def and type(e) == "table" and type(e.n) == "number" and e.n == e.n and e.n > 0 then
					score += math.floor(e.n) * Config.baseGain(def.tier)
				end
			end
		end
		saved.baseScore = score
	end,
	[6] = function(saved)
		-- v6 -> v7 : starter vaut false (pack de départ jamais acheté).
		saved.starter = saved.starter == true
	end,
	[5] = function(_saved)
		-- v5 -> v6 : secrets reçoit sa valeur par défaut (rien fouillé).
	end,
	[4] = function(_saved)
		-- v4 -> v5 : cine reçoit sa valeur par défaut (aucune cinématique vue : l'intro se jouera une fois).
	end,
	[3] = function(saved)
		-- v3 -> v4 : un nouveau chapitre (énigme) est inséré en position 8. Qui avait déjà réussi 8 chapitres ou plus
		-- garde ses acquis : on décale d'un cran pour ne pas lui faire refaire les chapitres suivants.
		if type(saved.story) == "table" and type(saved.story.ch) == "number" and saved.story.ch >= 8 then
			saved.story.ch += 1
		end
	end,
}

local function migrate(saved)
	local ver = tonumber(saved.ver) or 1
	while ver < VERSION do
		local step = MIGRATIONS[ver]
		if step then
			step(saved)
		end
		ver += 1
	end
	saved.ver = VERSION
end

-- Retourne (données, venantDUneVersionPlusRecente)
local function merge(saved)
	local d = Data.default()
	if type(saved) ~= "table" then
		return d, false
	end
	local newer = (tonumber(saved.ver) or 1) > VERSION
	if not newer then
		migrate(saved)
	end
	for _, key in ipairs({ "coins", "speed", "rb", "daily", "streak", "stolen", "hatched", "last", "qday", "luckUntil" }) do
		d[key] = sane(saved[key], d[key])
	end
	if type(saved.up) == "table" then
		for k, v in pairs(saved.up) do
			if d.up[k] ~= nil and type(v) == "number" then
				local u = Config.upgrade(k)
				d.up[k] = math.min(u and u.max or 0, math.floor(sane(v, 0)))
			end
		end
	end
	if type(saved.dex) == "table" then
		for k, e in pairs(saved.dex) do
			local idx = tonumber(k)
			if idx and Config.PETS[idx] and type(e) == "table" then
				d.dex[tostring(idx)] = { n = math.floor(sane(e.n, 0)), b = sane(e.b, 0) }
			end
		end
	end
	if type(saved.story) == "table" then
		d.story.ch = math.min(#Config.STORY, math.floor(sane(saved.story.ch, 0)))
		d.story.prog = sane(saved.story.prog, 0)
	end
	d.pity = math.min(Config.PITY_EVERY, math.floor(sane(saved.pity, 0)))
	if type(saved.puzzle) == "table" then
		d.puzzle.day = math.floor(sane(saved.puzzle.day, 0))
		d.puzzle.solved = math.floor(sane(saved.puzzle.solved, 0))
	end
	if type(saved.secrets) == "table" then
		for _, sct in ipairs(Config.SECRETS) do
			d.secrets[sct.id] = math.floor(sane(saved.secrets[sct.id], 0))
		end
	end
	if type(saved.cine) == "table" then
		for _, id in ipairs(Config.CINE_IDS) do
			d.cine[id] = saved.cine[id] == true
		end
	end
	if type(saved.ach) == "table" then
		for _, a in ipairs(Config.ACHIEVEMENTS) do
			d.ach[a.id] = math.min(#a.goals, math.floor(sane(saved.ach[a.id], 0)))
		end
	end
	d.starter = saved.starter == true
	d.baseScore = math.max(0, math.floor(sane(saved.baseScore, 0)))
	d.pendingAway = math.max(0, sane(saved.pendingAway, 0))
	if type(saved.receipts) == "table" then
		d.receipts = saved.receipts
	end
	if type(saved.equip) == "table" then
		for _, v in ipairs(saved.equip) do
			if type(v) == "number" and v >= 1 and v <= SLOT_COUNT and v % 1 == 0 and #d.equip < Config.MAX_FOLLOWERS then
				d.equip[#d.equip + 1] = v
			end
		end
	end
	if type(saved.quests) == "table" then
		for _, q in ipairs(saved.quests) do
			if type(q) == "table" and type(q.t) == "string" and type(q.goal) == "number" then
				d.quests[#d.quests + 1] = { t = q.t, goal = q.goal, prog = tonumber(q.prog) or 0, rew = tonumber(q.rew) or 0, re = math.floor(math.min(#Config.TIERS, math.max(0, tonumber(q.re) or 0))), rb = math.floor(math.min(3600, math.max(0, tonumber(q.rb) or 0))), claimed = q.claimed == true }
			end
		end
	end
	if type(saved.slots) == "table" then
		for i = 1, SLOT_COUNT do
			local sl = saved.slots[i]
			if type(sl) == "table" and (sl.k == "e" or sl.k == "p") then
				d.slots[i] = sl
			else
				d.slots[i] = false
			end
		end
	end
	return d, newer
end

local function key(player)
	return "P_" .. player.UserId
end

-- Enregistrement stocké : { v = données, lock = idServeur, t = horodatage }. Les anciennes sauvegardes (données brutes) sont migrées.
local function unwrap(rec)
	if type(rec) ~= "table" then
		return nil
	end
	if rec.v ~= nil then
		return rec.v
	end
	return rec
end

local function lockedByOther(rec)
	return type(rec) == "table" and rec.lock ~= nil and rec.lock ~= Data.SERVER_ID and os.time() - (tonumber(rec.t) or 0) < LOCK_TTL
end

-- Retourne (données, nePasSauvegarder). Données = nil si impossible de charger sans risque.
function Data.load(player)
	if not store or apiBlocked then
		return Data.default(), true
	end
	for attempt = 1, 8 do
		local lockedElsewhere = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old)
				if lockedByOther(old) then
					lockedElsewhere = true
					return nil -- annule l'écriture
				end
				return { v = unwrap(old), lock = Data.SERVER_ID, t = os.time() }
			end)
		end)
		if ok and not lockedElsewhere then
			local d, newer = merge(unwrap(result))
			if newer then
				warn("[Data] " .. player.Name .. " : données d'une version plus récente du jeu, sauvegarde désactivée pour ne rien écraser")
			end
			return d, newer
		end
		if ok then
			warn("[Data] " .. player.Name .. " est encore verrouillé sur un autre serveur (" .. attempt .. "/8)")
			task.wait(4)
		elseif markApiBlocked(result) then
			return Data.default(), true
		else
			warn("[Data] Chargement échoué (" .. attempt .. "/8) : " .. tostring(result))
			task.wait(1.5)
		end
	end
	if RunService:IsStudio() then
		return Data.default(), true -- Studio sans accès API : on joue sans sauvegarder
	end
	return nil, true
end

local saving = {} -- clé -> true tant qu'une sauvegarde de cette clé est en cours (évite les écritures concurrentes)

-- release = true : libère le verrou (départ du joueur). Refuse d'écrire si un autre serveur a pris le verrou.
-- Réessaie jusqu'à SAVE_RETRIES fois. Retourne true si la sauvegarde a réussi.
function Data.save(player, d, release)
	if not store or not d or apiBlocked then
		return false
	end
	local k = key(player)
	local waited = 0
	while saving[k] and waited < 8 do
		task.wait(0.25)
		waited += 0.25
	end
	saving[k] = true
	d.last = os.time()
	d.ver = VERSION
	-- Le JSON ne supporte ni NaN ni l'infini : une seule valeur invalide rendrait la sauvegarde impossible pour toujours.
	for _, f in ipairs({ "coins", "speed" }) do
		local v = d[f]
		if type(v) ~= "number" or v ~= v or v < 0 then
			d[f] = 0
		elseif v > 1e300 then
			d[f] = 1e300
		end
	end
	local success = false
	for attempt = 1, SAVE_RETRIES do
		local abort = false
		local ok, err = pcall(function()
			store:UpdateAsync(k, function(old)
				if lockedByOther(old) then
					abort = true
					return nil
				end
				local rec = { v = d, t = os.time() }
				if not release then
					rec.lock = Data.SERVER_ID
				end
				return rec
			end)
		end)
		if ok and not abort then
			success = true
			break
		end
		if abort then
			warn("[Data] " .. player.Name .. " : verrou pris par un autre serveur, sauvegarde annulée")
			break
		end
		if markApiBlocked(err) then
			break
		end
		warn("[Data] Sauvegarde échouée pour " .. player.Name .. " (" .. attempt .. "/" .. SAVE_RETRIES .. ") : " .. tostring(err))
		task.wait(1.5 * attempt)
	end
	saving[k] = nil
	return success
end

---------------------------------------------------------------- Classement global
function Data.score(d)
	return d.rb * Config.SCORE_UNIT + math.min(d.hatched, Config.SCORE_UNIT - 1)
end

function Data.submit(player, d)
	if not board or apiBlocked then
		return
	end
	local ok, err = pcall(function()
		board:SetAsync(tostring(player.UserId), math.floor(Data.score(d)))
	end)
	if not ok then
		markApiBlocked(err)
	end
end

-- Classement des temps du mode Château : valeur = centièmes de seconde, le plus petit est le meilleur ; seul le meilleur temps d'un joueur est gardé.
function Data.castleSubmit(player, seconds)
	if not castleBoard or apiBlocked or type(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 then
		return false
	end
	local value = math.max(1, math.floor(seconds * 100 + 0.5))
	local ok, err = pcall(function()
		castleBoard:UpdateAsync(tostring(player.UserId), function(old)
			if type(old) == "number" and old <= value then
				return nil
			end
			return value
		end)
	end)
	if not ok then
		markApiBlocked(err)
	end
	return ok
end

local nameCache = {}
local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and n or ("Joueur " .. userId)
	return nameCache[userId]
end

-- Meilleurs temps du Château : liste { {name=, time=secondes}, ... } triée (peut être vide).
function Data.castleTop(count)
	local out = {}
	if not castleBoard or apiBlocked then
		return out
	end
	local ok, page = pcall(function()
		return castleBoard:GetSortedAsync(true, count):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return out
	end
	for _, e in ipairs(page) do
		local v = type(e) == "table" and e.value
		-- entrées invalides (valeur non numérique, négative, nulle, NaN ou infinie) ignorées ; ex aequo : l'ordre du classement est conservé
		if type(v) == "number" and v == v and v > 0 and v < 1e9 then
			out[#out + 1] = { name = nameOf(tonumber(e.key) or 0), time = v / 100 }
		end
	end
	return out
end

-- Retourne une liste { {name=, rb=, hatched=}, ... } (peut être vide)
function Data.top(count)
	local out = {}
	if not board or apiBlocked then
		return out
	end
	local ok, page = pcall(function()
		return board:GetSortedAsync(false, count):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return out
	end
	for _, e in ipairs(page) do
		local score = tonumber(e.value) or 0
		out[#out + 1] = {
			name = nameOf(tonumber(e.key) or 0),
			rb = score // Config.SCORE_UNIT,
			hatched = score % Config.SCORE_UNIT,
		}
	end
	return out
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Builder
-- Construit TOUT le visuel avec des Parts, matériaux et particules de base Roblox (aucun asset externe).
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Scenery = require(script.Parent:WaitForChild("Scenery"))
local Castle = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Castle"))
local GuardMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Guard")) -- pose de marche
local AssetsMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets")) -- fonctions pures (fitHeight)
local PlacementMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Placement")) -- pose planifiée du décor

local Builder = {}

local FONT = Enum.Font.GothamBold
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function ball(props, parent)
	props.Shape = Enum.PartType.Ball
	props.CanCollide = false
	return part(props, parent)
end

local function sign(adornee, text, color, offsetY, width)
	local g = Instance.new("BillboardGui")
	g.Name = "Label"
	g.Adornee = adornee
	g.Size = UDim2.fromOffset(width or 200, 56)
	g.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	g.MaxDistance = 70
	g.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = FONT
	t.TextSize = 18
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.2
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	t.Text = text
	t.Parent = g
	g.Parent = adornee
	return t
end
Builder.sign = sign

---------------------------------------------------------------- Œuf
-- Chargeur de modèles d'œufs (module Assets, branché par Main). Nil = apparence par défaut partout.
local eggAssets = nil
local builtPlots = {} -- bases des joueurs (Builder.build) pour le dallage
local builtCastle = nil -- monde du château (Scenery.castle) pour l'habillage Blender différé
local builtGuards = {} -- { model, rival } des gardiens construits (habillage Blender différé)
function Builder.setAssets(a)
	eggAssets = a
end

-- Habille l'œuf `p` avec une copie du modèle Roblox de sa rareté : la Part reste la racine (tags, prompts, soudure au joueur, animations),
-- elle devient invisible et le modèle y est soudé par des Weld enfants des parts du modèle (pas de Weld direct sur l'œuf : l'animation de
-- course cherche le Weld du joueur). Retourne true si le modèle est en place ; en cas d'erreur, tout est défait (apparence par défaut).
local function dressEgg(p, tier)
	local clone = eggAssets and eggAssets.cloneEgg(tier)
	if not clone then
		return false
	end
	local ok = pcall(function()
		if not clone:IsA("Model") then
			error("pas un Model")
		end
		local fitted, why = AssetsMod.fitHeight(clone, Config.eggHeight(tier))
		if not fitted then
			error(why)
		end
		-- plafond relatif à l'emplacement et au joueur : un modèle très large ou trop haut est ramené à la borne (jamais d'œuf géant)
		local ext = clone:GetExtentsSize()
		local f = Config.fitScale({ X = ext.X, Y = ext.Y, Z = ext.Z }, Config.eggMaxSize())
		if f < 1 then
			clone:ScaleTo(clone:GetScale() * f)
		end
		local cf = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new() * cf:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				local w = Instance.new("Weld")
				w.Part0 = p
				w.Part1 = d
				w.C0 = d.CFrame
				w.Parent = d
			end
		end
		clone.Name = "Skin"
		clone.Parent = p
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return false
	end
	p.Transparency = 1
	return true
end

-- Halo décoratif soudé à l'œuf (sphère translucide ou anneau). Le client le fait tourner / scintiller (tag EggHalo, attributs Spin / Flicker).
local function addHalo(p, h)
	local halo = Instance.new("Part")
	halo.Name = "Halo"
	halo.Material = Enum.Material.Neon
	halo.Color = h.color
	halo.Transparency = h.transparency
	halo.CanCollide = false
	halo.CanTouch = false
	halo.CanQuery = false
	halo.Massless = true
	halo.Anchored = false
	halo.CastShadow = false
	local rot = CFrame.new()
	if h.shape == "ring" then
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.14, 3.2 * h.scale, 3.2 * h.scale)
		rot = CFrame.Angles(0, 0, math.rad(90))
	else
		halo.Shape = Enum.PartType.Ball
		halo.Size = Vector3.new(3.2 * h.scale, 3.2 * h.scale, 3.2 * h.scale)
	end
	local w = Instance.new("Weld")
	w.Name = "HaloWeld"
	w.Part0 = p
	w.Part1 = halo
	w.C0 = rot
	w.Parent = halo
	halo:SetAttribute("Spin", h.spin or 0)
	halo:SetAttribute("Flicker", h.flicker == true)
	halo:SetAttribute("BaseT", h.transparency)
	CollectionService:AddTag(halo, "EggHalo")
	halo.Parent = p
end

local function addParticles(p, pa)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(pa.color)
	e.Rate = pa.rate
	e.Lifetime = NumberRange.new(pa.life * 0.7, pa.life)
	e.Speed = NumberRange.new(pa.speed * 0.5, pa.speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, pa.size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = 0.8
	e.Parent = p
end

function Builder.egg(tier, anchored)
	local look = Config.EggFx.Enabled and Config.eggLook(tier) or nil
	local c = look and look.light or Config.TIERS[tier].color
	local p = Instance.new("Part")
	p.Name = "Egg"
	p.Size = Vector3.new(2.4, 3.2, 2.4)
	if look then
		p.Color = look.color
		p.Material = Enum.Material[look.material]
	else
		p.Color = Color3.fromRGB(255, 244, 222):Lerp(c, 0.35)
		p.Material = Enum.Material.SmoothPlastic
	end
	p.Anchored = anchored ~= false
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	local l = Instance.new("PointLight")
	l.Color = c
	l.Range = 7
	l.Brightness = look and look.brightness or 1.2
	l.Parent = p
	if dressEgg(p, tier) then
		m:Destroy() -- la sphère n'est plus visible : inutile de la garder
		l.Brightness = 1.2
	elseif look then
		if look.halo then
			addHalo(p, look.halo)
		end
		if look.particles then
			addParticles(p, look.particles)
		end
	end
	return p
end

---------------------------------------------------------------- Pet (modèle 3D en Parts)
-- Retourne (modèle, hauteur de levage). Le modèle regarde vers -Z.
-- Habille un pet avec le modèle Blender de Config.Assets.pets si disponible (même contrat que le pet procédural : Model, PrimaryPart, hauteur de
-- levage). Retourne (modèle, levage, hauteur d'étiquette) ou nil : l'appelant garde alors le pet procédural. Ne lève jamais d'erreur.
local function customPet(petIdx, size)
	local clone = eggAssets and eggAssets.clonePet and eggAssets.clonePet(petIdx)
	if not clone then
		return nil
	end
	local ok, lift, labelY = pcall(function()
		if not clone:IsA("Model") then
			error("pas un Model")
		end
		local height = Config.petTargetHeight(Config.PETS[petIdx].tier, size.scale)
		local fitted, why = AssetsMod.fitHeight(clone, height) -- mesure, mise à l'échelle sur la hauteur cible, vérification ±10 % (sinon pet procédural)
		if not fitted then
			error(why)
		end
		local first = nil
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				first = first or d
			end
		end
		if not first then
			error("aucune part")
		end
		clone.PrimaryPart = clone.PrimaryPart or first
		clone.Name = "Pet"
		return height / 2, height + 1.2
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return nil
	end
	return clone, lift, labelY
end

function Builder.pet(petIdx, sizeIdx, mutIdx)
	local def = Config.PETS[petIdx]
	local size = Config.SIZES[sizeIdx]
	local mut = Config.MUTS[mutIdx]
	local custom, customLift, customLabel = customPet(petIdx, size)
	if custom then
		custom:SetAttribute("Tier", def.tier)
		return custom, customLift, customLabel
	end
	local R = 0.9 * math.min(size.scale, 1.6) -- pet procédural : même échelle réduite que les modèles Blender
	local model = Instance.new("Model")
	model.Name = "Pet"

	local bodyColor = def.color
	local bodyMat = Enum.Material.SmoothPlastic
	if mut.color then
		bodyColor = mut.color
		bodyMat = Enum.Material.Neon
	elseif mut.rainbow then
		bodyColor = Color3.fromRGB(255, 120, 220)
		bodyMat = Enum.Material.Neon
	end

	local body = ball({ Name = "Body", Size = Vector3.new(2 * R, 2 * R, 2 * R), CFrame = CFrame.new(0, 0, 0), Color = bodyColor, Material = bodyMat }, model)
	model.PrimaryPart = body
	local dark = Color3.fromRGB(25, 25, 30)

	local function addBall(name, off, sz, col, mat)
		return ball({ Name = name, Size = Vector3.new(sz, sz, sz), CFrame = CFrame.new(off), Color = col, Material = mat or Enum.Material.SmoothPlastic }, model)
	end
	local function addBlock(name, off, sz, col, rotZ, mat)
		return part({ Name = name, CanCollide = false, Size = sz, CFrame = CFrame.new(off) * CFrame.Angles(0, 0, rotZ or 0), Color = col, Material = mat or Enum.Material.SmoothPlastic }, model)
	end

	-- yeux
	addBall("EyeL", Vector3.new(-0.42 * R, 0.25 * R, -0.86 * R), 0.36 * R, dark)
	addBall("EyeR", Vector3.new(0.42 * R, 0.25 * R, -0.86 * R), 0.36 * R, dark)

	-- paupières (invisibles, le client les affiche à chaque clignement) et bouche (animée côté client)
	for _, side in ipairs({ { "LidL", -0.42 }, { "LidR", 0.42 } }) do
		local lid = addBall(side[1], Vector3.new(side[2] * R, 0.25 * R, -0.88 * R), 0.42 * R, bodyColor)
		lid.Transparency = 1
	end
	addBlock("Mouth", Vector3.new(0, -0.18 * R, -0.93 * R), Vector3.new(0.34 * R, 0.06 * R, 0.1 * R), dark)

	-- reflets dans les yeux, joues et pieds
	addBall("ShineL", Vector3.new(-0.46 * R, 0.34 * R, -1.0 * R), 0.13 * R, Color3.new(1, 1, 1))
	addBall("ShineR", Vector3.new(0.38 * R, 0.34 * R, -1.0 * R), 0.13 * R, Color3.new(1, 1, 1))
	if def.tier <= 3 then
		addBall("CheekL", Vector3.new(-0.72 * R, -0.05 * R, -0.68 * R), 0.26 * R, Color3.fromRGB(255, 150, 170))
		addBall("CheekR", Vector3.new(0.72 * R, -0.05 * R, -0.68 * R), 0.26 * R, Color3.fromRGB(255, 150, 170))
	end
	if def.extra ~= "tentacles" then
		local footCol = bodyColor:Lerp(Color3.new(0, 0, 0), 0.25)
		addBall("FootL", Vector3.new(-0.45 * R, -0.92 * R, -0.15 * R), 0.55 * R, footCol)
		addBall("FootR", Vector3.new(0.45 * R, -0.92 * R, -0.15 * R), 0.55 * R, footCol)
	end

	-- oreilles
	local ears = def.ears
	if ears == "round" then
		addBall("EarL", Vector3.new(-0.62 * R, 0.95 * R, -0.05 * R), 0.62 * R, bodyColor)
		addBall("EarR", Vector3.new(0.62 * R, 0.95 * R, -0.05 * R), 0.62 * R, bodyColor)
	elseif ears == "long" then
		addBlock("EarL", Vector3.new(-0.4 * R, 1.5 * R, 0), Vector3.new(0.36 * R, 1.3 * R, 0.3 * R), bodyColor, 0.15)
		addBlock("EarR", Vector3.new(0.4 * R, 1.5 * R, 0), Vector3.new(0.36 * R, 1.3 * R, 0.3 * R), bodyColor, -0.15)
	elseif ears == "point" then
		addBlock("EarL", Vector3.new(-0.6 * R, 1.05 * R, 0), Vector3.new(0.4 * R, 0.8 * R, 0.3 * R), bodyColor, 0.5)
		addBlock("EarR", Vector3.new(0.6 * R, 1.05 * R, 0), Vector3.new(0.4 * R, 0.8 * R, 0.3 * R), bodyColor, -0.5)
	elseif ears == "floppy" then
		addBlock("EarL", Vector3.new(-1.0 * R, 0.35 * R, 0), Vector3.new(0.35 * R, 0.9 * R, 0.5 * R), Color3.fromRGB(110, 70, 40), 0.2)
		addBlock("EarR", Vector3.new(1.0 * R, 0.35 * R, 0), Vector3.new(0.35 * R, 0.9 * R, 0.5 * R), Color3.fromRGB(110, 70, 40), -0.2)
	end

	-- extras
	local lift = R
	local extra = def.extra
	if extra == "beak" then
		addBlock("Beak", Vector3.new(0, -0.05 * R, -1.0 * R), Vector3.new(0.5 * R, 0.3 * R, 0.5 * R), Color3.fromRGB(255, 150, 30))
	elseif extra == "tail" then
		addBall("Tail", Vector3.new(0, -0.1 * R, 1.05 * R), 0.55 * R, bodyColor)
	elseif extra == "mane" then
		addBall("Mane", Vector3.new(0, 0, 0.3 * R), 2.5 * R, Color3.fromRGB(150, 90, 30))
		body.Size = Vector3.new(1.9 * R, 1.9 * R, 1.9 * R)
	elseif extra == "horn" then
		addBlock("Horn", Vector3.new(0, 1.2 * R, -0.45 * R), Vector3.new(0.25 * R, 0.9 * R, 0.25 * R), Color3.fromRGB(255, 215, 90), 0, Enum.Material.Neon)
	elseif extra == "wings" then
		addBlock("WingL", Vector3.new(-1.1 * R, 0.35 * R, 0.3 * R), Vector3.new(0.15 * R, 1.1 * R, 1.3 * R), bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), 0.6)
		addBlock("WingR", Vector3.new(1.1 * R, 0.35 * R, 0.3 * R), Vector3.new(0.15 * R, 1.1 * R, 1.3 * R), bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), -0.6)
		addBlock("Horn", Vector3.new(0, 1.05 * R, -0.5 * R), Vector3.new(0.22 * R, 0.6 * R, 0.22 * R), Color3.fromRGB(255, 240, 200))
	elseif extra == "tentacles" then
		for i, o in ipairs({ { -0.5, -0.5 }, { 0.5, -0.5 }, { -0.5, 0.5 }, { 0.5, 0.5 } }) do
			addBlock("Tent" .. i, Vector3.new(o[1] * R, -1.25 * R, o[2] * R), Vector3.new(0.3 * R, 1.1 * R, 0.3 * R), bodyColor)
		end
		lift = 1.8 * R
	elseif extra == "antenna" then
		addBlock("Ant", Vector3.new(0, 1.3 * R, 0), Vector3.new(0.12 * R, 0.8 * R, 0.12 * R), bodyColor)
		addBall("AntTip", Vector3.new(0, 1.8 * R, 0), 0.35 * R, Color3.fromRGB(255, 80, 200), Enum.Material.Neon)
	end

	-- étincelles dorées discrètes : le pet « produit » des pièces
	local coin = Instance.new("ParticleEmitter")
	coin.Texture = SPARK
	coin.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	coin.Rate = 0.7
	coin.Lifetime = NumberRange.new(1.2, 1.8)
	coin.Speed = NumberRange.new(1, 2)
	coin.Acceleration = Vector3.new(0, 3, 0)
	coin.SpreadAngle = Vector2.new(60, 60)
	coin.LightEmission = 1
	coin.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	coin.Parent = body

	-- mutation : particules
	if mut.color or mut.rainbow then
		local e = Instance.new("ParticleEmitter")
		e.Texture = SPARK
		e.Rate = 8
		e.Lifetime = NumberRange.new(1, 2)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(180, 180)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * R), NumberSequenceKeypoint.new(1, 0) })
		if mut.rainbow then
			e.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 60)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 255, 120)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 120, 255)),
			})
		else
			e.Color = ColorSequence.new(mut.color)
		end
		e.Parent = body
	end

	-- étiquette
	model:SetAttribute("Height", lift)
	CollectionService:AddTag(model, "PetFace") -- visage animé côté client (clignement, regard, bouche)
	model:SetAttribute("Tier", def.tier) -- états des pets (capacité des raretés élevées)
	return model, lift, 2.3 * R + 1.5
end

---------------------------------------------------------------- Gardien
-- Remplace l'apparence procédurale d'un gardien par un modèle Blender : le Body devient invisible (il porte l'étiquette et sert de repère),
-- les autres Parts procédurales sont détruites, le modèle est mis à l'échelle (hauteur en studs), posé au sol sous le Body et ancré.
-- Retourne true si remplacé ; sinon le gardien procédural est conservé. Ne lève jamais d'erreur.
local function fitGuard(model, clone, height)
	local ok = pcall(function()
		local body = model.PrimaryPart
		local fitted, why = AssetsMod.fitHeight(clone, height)
		if not fitted then
			error(why)
		end
		local bbox, size2 = clone:GetBoundingBox()
		clone:PivotTo(body.CFrame * CFrame.new(0, -2.4 + size2.Y / 2, 0) * bbox:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		for _, c in ipairs(model:GetChildren()) do
			if c:IsA("BasePart") and c ~= body then
				c:Destroy()
			end
		end
		body.Transparency = 1
		local label = body:FindFirstChild("Label")
		if label then
			label.StudsOffsetWorldSpace = Vector3.new(0, height + 1.2, 0)
		end
		clone.Name = "Blender"
		clone.Parent = model
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
	end
	return ok
end

-- Pièce d'un modèle Blender par son nom de base : « Pics » et « Pics__C0C0C0 » (suffixe de couleur) désignent la même pièce.
local function findNamed(model, base)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and (d.Name == base or d.Name:match("^(.-)__%x%x%x%x%x%x$") == base) then
			return d
		end
	end
	return nil
end

-- Pose un clone de modèle Blender centré en (x, z), posé sur le sol y0, mis à l'échelle pour que sa plus grande arête horizontale vaille `span`
-- (ou, sans span, pour que sa hauteur vaille `height`), ancré, sans collision. Retourne la table { model, center } ou nil (clone détruit).
local function setModel(clone, x, y0, z, span, height, parent, rotY)
	local ok = pcall(function()
		local _, size = clone:GetBoundingBox()
		if size.Y < 0.05 then
			error("hauteur nulle")
		end
		local longest = math.max(size.X, size.Z)
		if span and longest > 0.05 then
			clone:ScaleTo(span / longest)
		elseif height then
			local fitted, why = AssetsMod.fitHeight(clone, height)
			if not fitted then
				error(why)
			end
		end
		local bbox, size2 = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new(x, y0 + size2.Y / 2, z) * CFrame.Angles(0, rotY or 0, 0) * bbox:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		clone.Parent = parent
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return false
	end
	return true
end

-- Habille les pièges du château (pics, lames, boulets) avec les modèles Blender (groupe `traps`). Les Parts procédurales restent les « pilotes » de la
-- logique (positions, couleurs) ; le modèle suit : Pics se lève/descend, Lame tourne autour de l'axe vertical du modèle, Boulet suit la sphère.
-- Un piège dont le modèle n'a pas la pièce animée attendue garde son apparence procédurale. Retourne le nombre de pièges habillés.
function Builder.dressTraps(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		if not builtCastle then
			return
		end
		local parent = builtCastle.rooms[1] and builtCastle.rooms[1].door and builtCastle.rooms[1].door.Parent
		if not parent then
			return
		end
		for _, rec in ipairs(builtCastle.rooms) do
			for _, v in ipairs(rec.spikes) do
				local clone = assets.cloneModel("traps", "spikes")
				if clone then
					clone.Name = "TrapSpikes"
				end
				if clone and findNamed(clone, "Pics") and setModel(clone, v.wx, 0, v.wz, 6.4, nil, parent) then
					local pics = findNamed(clone, "Pics")
					v.vis = { part = pics, base = pics.CFrame, last = "" }
					v.tip.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
			for _, v in ipairs(rec.blades) do
				local clone = assets.cloneModel("traps", "blade")
				if clone then
					clone.Name = "TrapBlade"
				end
				if clone and findNamed(clone, "Lame") and setModel(clone, v.wx, 0, v.wz, v.arm.Size.X, nil, parent) then
					local lame = findNamed(clone, "Lame")
					v.vis = { part = lame, base = lame.CFrame, center = Vector3.new(v.wx, 0, v.wz) }
					v.arm.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
			for _, v in ipairs(rec.balls) do
				local clone = assets.cloneModel("traps", "ball")
				if clone then
					clone.Name = "TrapBall"
				end
				local d = v.part.Size.X
				if clone and setModel(clone, v.part.Position.X, -10, v.wz, d, nil, parent) then
					v.vis = { model = clone, d = d }
					v.part.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
		end
	end)
	return n
end

-- Habille le château (murs, tours, herses, coffre, torches, drapeaux, bâtiment en fond) avec les modèles Blender (groupes `castle` et `props`), dans un
-- budget de Parts (Config.Assets.castleBudgetParts, pire cas = plafond de Parts de chaque modèle). Les Parts procédurales gardent la collision et la logique
-- (murs, portes, coffre) et deviennent invisibles seulement si leur modèle a été posé. Herse (porte) et Couvercle (coffre) sont animées par le code.
-- Retourne le nombre de modèles posés.
function Builder.dressCastle(assets)
	local n, spent = 0, 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		local w = builtCastle
		local parent = w and w.rooms[1] and w.rooms[1].door and w.rooms[1].door.Parent
		if not parent then
			return
		end
		local function put(group, key, x, y0, z, span, height, rotY, name)
			local cost = Config.Assets.modelsMaxParts[group .. "." .. key] or 60
			if spent + cost > Config.Assets.castleBudgetParts then
				return nil
			end
			local clone = assets.cloneModel(group, key)
			if not clone then
				return nil
			end
			clone.Name = name
			if setModel(clone, x, y0, z, span, height, parent, rotY) then
				spent = spent + cost
				n = n + 1
				return clone
			end
			return nil
		end
		local W, L = Castle.ROOM_WIDTH, Castle.ROOM_LENGTH
		-- murs : deux segments de L/2 par côté et par salle (les murs procéduraux restent les colliders)
		for r = 1, Castle.ROOMS do
			local placed = 0
			for _, sx in ipairs({ -1, 1 }) do
				for k = 0, 1 do
					local x, z = Castle.toWorld(r, sx * (W / 2 + 1), L / 4 + k * L / 2)
					if put("castle", "wall", x, 0, z, L / 2, nil, math.pi / 2, "CastleWallModel") then
						placed = placed + 1
					end
				end
			end
			if placed == 4 then
				local _, roomZ = Castle.toWorld(r, 0, L / 2)
				for _, c in ipairs(parent:GetChildren()) do
					if c.Name == "CastleWall" and c:IsA("BasePart") and math.abs(c.Position.Z - roomZ) < 1 then
						c.Transparency = 1
					end
				end
			end
		end
		-- tours de chaque côté de l'entrée
		local ex, ez = Castle.toWorld(1, 0, -6)
		for _, sx in ipairs({ -13, 13 }) do
			put("castle", "tower", ex + sx, 0, ez, nil, Config.Assets.targetHeights.tower, 0, "CastleTowerModel")
		end
		-- herses : la pièce Herse monte quand la porte s'ouvre (le pilote procédural garde la collision)
		for _, rec in ipairs(w.rooms) do
			local door = put("castle", "door", rec.doorX, 0, rec.doorZ, W, nil, 0, "CastleDoorModel")
			local herse = door and findNamed(door, "Herse")
			if herse then
				rec.vis = { part = herse, base = herse.CFrame, last = "" }
				rec.door.Transparency = 1
			elseif door then
				door:Destroy()
				n = n - 1
			end
		end
		-- coffre : le Couvercle s'ouvre quand le trésor est pris (Builder.openChest)
		if w.chest then
			local chest = put("props", "chest", w.chest.Position.X, 0, w.chest.Position.Z, nil, Config.Assets.targetHeights.chest, 0, "CastleChestModel")
			local lid = chest and findNamed(chest, "Couvercle")
			if lid then
				w.chestVis = { part = lid, base = lid.CFrame }
				w.chest.Transparency = 1
				local old = parent:FindFirstChild("CastleChestLid")
				if old then
					old.Transparency = 1
				end
			elseif chest then
				chest:Destroy()
				n = n - 1
			end
		end
		-- torches (la lumière du pilote reste) et drapeaux sur le portail
		for _, c in ipairs(parent:GetChildren()) do
			if c.Name == "CastleTorch" and c:IsA("BasePart") and put("props", "torch", c.Position.X, 4.4, c.Position.Z, nil, 3, 0, "CastleTorchModel") then
				c.Transparency = 1
			end
		end
		for _, sx in ipairs({ -8, 8 }) do
			put("props", "flag", ex + sx, 18.5, ez, nil, 7, 0, "CastleFlagModel")
		end
		-- bâtiment du château en fond, derrière la dernière salle
		local bx, bz = Castle.toWorld(Castle.ROOMS, 0, L + 45)
		put("props", "castle", bx, 0, bz, nil, 46, math.pi, "CastleBackdrop")
	end)
	return n
end

-- Habille l'arène : place pavée sous le monument (ground.plaza), bancs et lampadaires autour, moulin (pales animées) et enclos dans le domaine 1.
-- Budget `arenaBudgetParts` (pire cas) ; chaque modèle est facultatif (repli : rien n'est posé, la carte reste procédurale). Retourne le nombre posé.
local millVis = nil
function Builder.dressArena(assets)
	local n, spent = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderArena"
		folder.Parent = world
		local function put(group, key, x, y0, z, span, height, rotY, name)
			local cost = Config.Assets.modelsMaxParts[group .. "." .. key] or 60
			if spent + cost > Config.Assets.arenaBudgetParts then
				return nil
			end
			local clone = assets.cloneModel(group, key)
			if not clone then
				return nil
			end
			clone.Name = name
			if setModel(clone, x, y0, z, span, height, folder, rotY) then
				spent = spent + cost
				n = n + 1
				return clone
			end
			return nil
		end
		put("ground", "plaza", 0, 0.08, 0, 56, nil, 0, "ArenaPlaza")
		for k = 0, 3 do
			local a = k * math.pi / 2
			put("props", "bench", math.sin(a) * 24, 0, -math.cos(a) * 24, nil, Config.Assets.targetHeights.bench, math.pi - a, "ArenaBench") -- le banc regarde le monument
			local b = a + math.pi / 4
			put("props", "lamp", math.sin(b) * 28, 0, -math.cos(b) * 28, nil, Config.Assets.targetHeights.lamp, 0, "ArenaLamp")
		end
		local cx, cz = Config.rivalCenter(1)
		local mill = put("props", "mill", cx - 24, Config.rivalHeight(1), cz + 22, nil, Config.Assets.targetHeights.mill, math.pi / 6, "ArenaMill")
		if mill then
			local p1, p2 = findNamed(mill, "Pales"), findNamed(mill, "Pales2")
			if p1 then
				millVis = { p1 = p1, b1 = p1.CFrame, p2 = p2, b2 = p2 and p2.CFrame }
			end
		end
		put("props", "pen", cx + 30, Config.rivalHeight(1), cz + 4, 16, nil, 0, "ArenaPen")
	end)
	return n
end

-- Fait tourner les pales du moulin (appelé 10 fois par seconde ; tournent en sens contraires autour de leur axe avant).
function Builder.animProps(t)
	local m = millVis
	if m and m.p1.Parent then
		m.p1.CFrame = m.b1 * CFrame.Angles(0, 0, t * 0.5)
		if m.p2 then
			m.p2.CFrame = m.b2 * CFrame.Angles(0, 0, -t * 0.35)
		end
	end
end

-- Dallage du sol (ground.path : chemins du Grand Nid vers les domaines ; ground.grass : pelouses autour de chaque base). Le coût d'une tuile est
-- MESURÉ (nombre réel de Parts du modèle chargé, Assets.status) et le placement s'arrête dès que `groundBudgetParts` serait dépassé ou que
-- `groundMaxTiles` est atteint. Retourne (tuiles posées, Parts utilisées). Sans modèle : rien (sol procédural conservé).
function Builder.dressGround(assets)
	local tiles, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while (not world or #builtPlots == 0) and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderGround"
		folder.Parent = world
		local function cost(key)
			local st = assets.status and assets.status["m:ground." .. key]
			return st and st.ok and st.parts or nil
		end
		local function tile(key, x, z, span)
			local c = cost(key)
			if not c or used + c > Config.Assets.groundBudgetParts or tiles >= Config.Assets.groundMaxTiles then
				return false
			end
			local clone = assets.cloneModel("ground", key)
			if not clone then
				return false
			end
			clone.Name = "GroundTile"
			if setModel(clone, x, key == "path" and 0.12 or 0.06, z, span, nil, folder, 0) then -- les chemins sont posés 0,06 au-dessus des pelouses (jamais coplanaires)
				used = used + c
				tiles = tiles + 1
				return true
			end
			return false
		end
		-- chemins : du Grand Nid vers le centre de chaque domaine, une tuile tous les 12 studs
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			local dist = math.sqrt(cx * cx + cz * cz)
			local k = 0
			while 34 + k * 12 < dist - 40 do
				local t = (34 + k * 12) / dist
				tile("path", cx * t, cz * t, 12)
				k = k + 1
			end
		end
		-- pelouses : 3 x 3 tuiles de 20 studs devant chaque base
		for _, pl in ipairs(builtPlots) do
			local p = pl.spawn.Position
			for gx = -1, 1 do
				for gz = -1, 1 do
					tile("grass", p.X + gx * 20, p.Z + gz * 20, 20)
				end
			end
		end
	end)
	return tiles, used
end

-- Pose les textures tuilables (Config.Assets.textures) sur les grandes surfaces de la carte : herbe, eaux, sol et murs du château, planches, sable,
-- pavés. Une Texture par face listée, au plus `textureMaxCount` au total (priorité = `textureOrder`). Sans URL chargée pour une clé, la matière actuelle
-- reste. Retourne le nombre de Textures posées. Ne lève jamais d'erreur.
function Builder.dressTextures(assets)
	local count = 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local parts = {}
		for _, d in ipairs(world:GetDescendants()) do
			if d:IsA("BasePart") then
				parts[#parts + 1] = d
			end
		end
		local cfg = Config.Assets
		for _, key in ipairs(cfg.textureOrder) do
			local url = assets.textureUrls and assets.textureUrls[key]
			local def = cfg.textures[key]
			if url and def then
				for _, p in ipairs(parts) do
					for _, t in ipairs(def.targets) do
						if (t.name and p.Name == t.name) or (t.prefix and p.Name:sub(1, #t.prefix) == t.prefix) then
							for _, face in ipairs(t.faces) do
								if count >= cfg.textureMaxCount then
									return
								end
								local tx = Instance.new("Texture")
								tx.Name = "Tile_" .. key
								tx.Texture = url
								tx.Face = Enum.NormalId[face]
								tx.StudsPerTileU = def.tile
								tx.StudsPerTileV = def.tile
								tx.Transparency = def.transparency or 0
								tx.Parent = p
								count = count + 1
							end
						end
					end
				end
			end
		end
	end)
	return count
end

-- Publie les modèles d'effets (groupe `vfx`, déjà chargés par Assets) dans ReplicatedStorage.VfxTemplates : les clients les clonent pour VfxKit.play
-- (un client ne peut pas charger d'assets lui-même). Parts ancrées, sans collision, matière Neon d'origine conservée. Retourne le nombre publié.
function Builder.exportVfx(assets)
	local n = 0
	pcall(function()
		local RS = game:GetService("ReplicatedStorage")
		local folder = RS:FindFirstChild("VfxTemplates") or Instance.new("Folder")
		folder.Name = "VfxTemplates"
		for _, key in ipairs(AssetsMod.vfxKeys) do
			local clone = assets.cloneModel("vfx", key)
			if clone then
				clone.Name = key
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
					end
				end
				clone.Parent = folder
				n = n + 1
			end
		end
		folder.Parent = RS
	end)
	return n
end

-- Progression de la base : 8 apparences cumulatives, de l'enclos de bois au château doré (repère local de la base : l'entrée est du côté -Z, l'arrière +Z).
-- Chaque niveau ajoute des Parts (au plus 100 en tout par base) dans le dossier « BaseUpgrade » du modèle de la base ; la cabane et les tours utilisent
-- les modèles Blender (props.hut, castle.tower) tant que le budget Blender des bases n'est pas dépassé, sinon la version procédurale.
-- Retourne le nombre de Parts posées.
function Builder.baseUpgrade(plot, level)
	local made = 0
	pcall(function()
		if not (plot and plot.model and plot.cf) then
			return
		end
		Builder.clearBase(plot)
		local folder = Instance.new("Folder")
		folder.Name = "BaseUpgrade"
		folder.Parent = plot.model
		local cf0 = plot.cf
		-- modèle Blender COMPLET du niveau (base.levelN, emprise 52 x 52, entrée -Z) : il remplace toute la version procédurale de ce niveau
		do
			local clone = eggAssets and eggAssets.cloneModel and eggAssets.cloneModel("base", "level" .. level)
			if clone then
				local ok = pcall(function()
					local _, size = clone:GetBoundingBox()
					local longest = math.max(size.X, size.Z)
					if size.Y < 0.05 or longest < 0.05 then
						error("mesure impossible")
					end
					clone:ScaleTo(clone:GetScale() * 52 / longest)
					local bbox, size2 = clone:GetBoundingBox()
					clone:PivotTo(cf0 * CFrame.new(0, size2.Y / 2, 0) * bbox:ToObjectSpace(clone:GetPivot()))
					for _, d in ipairs(clone:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Anchored = true
							d.CanCollide = false
							d.CanQuery = false
						end
					end
					clone.Name = "BaseModel"
					clone.Parent = folder
				end)
				if ok then
					made = Config.Assets.modelsMaxParts["base.level" .. level] or 45
					return
				end
				pcall(function()
					clone:Destroy()
				end)
			end
		end
		local function box(name, x, y, z, sx, sy, sz, color, material, rot)
			made += 1
			return part({ Name = name, Size = Vector3.new(sx, sy, sz), CFrame = cf0 * CFrame.new(x, y, z) * CFrame.Angles(0, rot or 0, 0), Color = color, Material = material or Enum.Material.WoodPlanks, CanCollide = false }, folder)
		end
		local wood, wood2 = Color3.fromRGB(150, 104, 62), Color3.fromRGB(110, 76, 46)
		local stone, stone2 = Color3.fromRGB(150, 150, 158), Color3.fromRGB(112, 112, 122)
		local gold = Color3.fromRGB(255, 205, 70)
		local golden = level >= 8
		local E = 28.5 -- le pourtour : en dehors de la plateforme (demi-côté 26)
		local sideMat = level >= 4 and Enum.Material.Cobblestone or Enum.Material.WoodPlanks
		local sideCol = level >= 4 and stone or wood
		local h = level >= 4 and 2.2 or 1.6
		box("Rail", -E, h, 0, 0.6, 0.5, 2 * E, sideCol, sideMat)
		box("Rail", E, h, 0, 0.6, 0.5, 2 * E, sideCol, sideMat)
		box("Rail", 0, h, E, 2 * E, 0.5, 0.6, sideCol, sideMat)
		box("RailLow", -E, h * 0.45, 0, 0.5, 0.4, 2 * E, sideCol, sideMat)
		box("RailLow", E, h * 0.45, 0, 0.5, 0.4, 2 * E, sideCol, sideMat)
		box("RailLow", 0, h * 0.45, E, 2 * E, 0.4, 0.5, sideCol, sideMat)
		for k = -3, 3 do
			local t = k * (E / 3)
			box("Post", -E, h * 0.6, t, 0.8, h * 1.3, 0.8, wood2)
			box("Post", E, h * 0.6, t, 0.8, h * 1.3, 0.8, wood2)
			box("Post", t, h * 0.6, E, 0.8, h * 1.3, 0.8, wood2)
		end
		-- place un modèle Blender (hauteur cible), ancré, sans collision ; false si le budget Blender est dépassé ou si la mesure échoue
		local function placeModel(clone, cost, height, x, z, rot, name)
			plot.baseBlender = plot.baseBlender or 0
			if not clone or plot.baseBlender + cost > Config.Assets.baseBlenderBudget then
				if clone then
					pcall(function()
						clone:Destroy()
					end)
				end
				return false
			end
			local ok = pcall(function()
				local fitted, why = AssetsMod.fitHeight(clone, height)
				if not fitted then
					error(why)
				end
				local bbox, size = clone:GetBoundingBox()
				clone:PivotTo(cf0 * CFrame.new(x, size.Y / 2, z) * CFrame.Angles(0, rot, 0) * bbox:ToObjectSpace(clone:GetPivot()))
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
					end
				end
				clone.Name = name
				clone.Parent = folder
			end)
			if ok then
				plot.baseBlender += cost
				made += 4
				return true
			end
			pcall(function()
				clone:Destroy()
			end)
			return false
		end
		if level >= 2 then
			local clone = eggAssets and eggAssets.cloneProp and eggAssets.cloneProp("hut")
			if not placeModel(clone, Config.Assets.propsMaxParts.hut or 120, level >= 5 and 8 or 6, 0, 21, math.pi, "HutModel") then
				box("HutWall", 0, 2.4, 21, 11, 4.8, 7, level >= 4 and stone or wood2, level >= 4 and Enum.Material.Brick or Enum.Material.WoodPlanks)
				box("HutRoof", 0, 5.8, 21, 12.4, 0.8, 8.4, golden and gold or Color3.fromRGB(176, 70, 60), golden and Enum.Material.Metal or Enum.Material.Slate)
				box("HutDoor", 0, 1.6, 17.4, 2.4, 3.2, 0.3, wood)
			end
		end
		if level >= 3 then
			for _, c in ipairs({ { -E, -E }, { E, -E }, { -E, E }, { E, E } }) do
				box("LampPost", c[1], 2.6, c[2], 0.5, 5.2, 0.5, Color3.fromRGB(50, 52, 60), Enum.Material.Metal)
				local head = box("Lantern", c[1], 5.4, c[2], 1.1, 1.1, 1.1, Color3.fromRGB(255, 232, 160), Enum.Material.Neon)
				local l = Instance.new("PointLight")
				l.Color, l.Range, l.Brightness = Color3.fromRGB(255, 224, 150), 14, 0.9
				l.Parent = head
			end
			for k = 0, 4 do
				box("Flagstone", 0, 1.06 + 0.06 * (k % 2), -22 + k * 2.2, 4.2, 0.12, 1.9, stone, Enum.Material.Slate)
			end
		end
		if level >= 5 then
			for _, sx in ipairs({ -E, E }) do
				local towerH = golden and 11 or 9
				local clone = eggAssets and eggAssets.cloneModel and eggAssets.cloneModel("castle", "tower")
				if not placeModel(clone, Config.Assets.modelsMaxParts["castle.tower"] or 80, towerH + 3, sx, E, 0, "TowerModel") then
					made += 2
					part({ Name = "Tower", Shape = Enum.PartType.Cylinder, Size = Vector3.new(towerH, 5, 5), CFrame = cf0 * CFrame.new(sx, towerH / 2, E) * CFrame.Angles(0, 0, math.pi / 2), Color = stone2, Material = Enum.Material.Cobblestone, CanCollide = false }, folder)
					part({ Name = "TowerCap", Shape = Enum.PartType.Ball, Size = Vector3.new(5.6, 5.6, 5.6), CFrame = cf0 * CFrame.new(sx, towerH + 0.6, E), Color = golden and gold or Color3.fromRGB(176, 70, 60), Material = golden and Enum.Material.Metal or Enum.Material.Slate, CanCollide = false }, folder)
				end
			end
		end
		if level >= 6 then
			for k = -3, 3 do
				box("Merlon", k * 7, h + 1.2, E, 2.6, 1.4, 1.2, stone2, Enum.Material.Cobblestone)
			end
			for _, sx in ipairs({ -10, 10 }) do
				box("BannerPole", sx, 4, E - 1, 0.3, 8, 0.3, wood2)
				box("Banner", sx, 6.4, E - 1, 2.2, 3, 0.15, Color3.fromRGB(200, 50, 60), Enum.Material.Fabric)
			end
		end
		if level >= 7 then
			box("GatePillar", -6, 4, -E, 1.8, 8, 1.8, stone2, Enum.Material.Cobblestone)
			box("GatePillar", 6, 4, -E, 1.8, 8, 1.8, stone2, Enum.Material.Cobblestone)
			box("GateLintel", 0, 8.4, -E, 14, 1.6, 2, golden and gold or stone, golden and Enum.Material.Metal or Enum.Material.Cobblestone)
			for _, sx in ipairs({ -6, 6 }) do
				local t = box("Torch", sx, 5.2, -E + 1.2, 0.8, 0.8, 0.8, Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
				local l = Instance.new("PointLight")
				l.Color, l.Range, l.Brightness = Color3.fromRGB(255, 170, 90), 16, 1
				l.Parent = t
			end
		end
		if golden then
			box("GoldTrim", 0, h + 0.3, E, 2 * E, 0.35, 0.8, gold, Enum.Material.Metal)
			local glow = box("GoldGlow", 0, 7.4, 21, 3, 3, 3, gold, Enum.Material.Neon)
			local l = Instance.new("PointLight")
			l.Color, l.Range, l.Brightness = gold, 26, 1.4
			l.Parent = glow
		end
	end)
	return made
end

function Builder.clearBase(plot)
	pcall(function()
		local f = plot.model and plot.model:FindFirstChild("BaseUpgrade")
		if f then
			f:Destroy()
		end
		plot.baseBlender = 0
	end)
end

-- Décor fin (fleurs, touffes, pierres, lanternes) : budget SÉPARÉ (decoBudgetParts) posé après la carte, coût mesuré d'après les Parts réelles des modèles ;
-- repli procédural limité (decoFallbackMax Parts de fleurs) si les modèles manquent. Retourne (objets posés, Parts utilisées, Parts de repli).
function Builder.dressDeco(assets)
	local placed, used, fallback = 0, 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderDeco"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local items = P.decor(P.plan().items)
		for _, it in ipairs(items) do
			local st = assets.status and assets.status["m:deco." .. it.kind]
			local cost = (st and st.ok and st.parts) or 0
			local clone = cost > 0 and assets.cloneModel("deco", it.kind) or nil
			if clone then
				if used + cost <= Config.Assets.decoBudgetParts then
					local ok = assets.place(clone, it.x, it.z, it.rot, Config.Assets.decoHeights[it.kind], folder, nil, it.y)
					if ok then
						used = used + cost
						placed = placed + 1
					end
				else
					clone:Destroy()
				end
			elseif it.kind:sub(1, 6) == "flower" and fallback + 2 <= Config.Assets.decoFallbackMax then
				local col = ({ flower_a = Color3.fromRGB(255, 120, 154), flower_b = Color3.fromRGB(255, 210, 63), flower_c = Color3.fromRGB(255, 255, 255) })[it.kind]
				part({ Name = "FlowerStem", Size = Vector3.new(0.2, 0.9, 0.2), Position = Vector3.new(it.x, 0.45 + (it.y or 0), it.z), Color = Color3.fromRGB(62, 142, 68), CanCollide = false, CanQuery = false }, folder)
				ball({ Name = "FlowerHead", Size = Vector3.new(0.7, 0.7, 0.7), Position = Vector3.new(it.x, 1 + (it.y or 0), it.z), Color = col, CanQuery = false }, folder)
				fallback = fallback + 2
			end
		end
	end)
	return placed, used, fallback
end

-- Chemins sinueux Blender (tuiles droites/virages bordés de pierres, touffes sur les bords) posés sur les polylignes de Config.Map.paths ; les pavés
-- procéduraux (PathStone) proches d'une polyligne habillée sont retirés (jamais de superposition). Retourne (tuiles posées, Parts utilisées).
function Builder.dressPaths(assets)
	local tiles, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		local A = Config.Assets
		local straight = assets.status and assets.status["m:paths.path_straight"]
		if not (straight and straight.ok) then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderPaths"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local function cost(key)
			local st = assets.status["m:paths." .. key]
			return st and st.ok and st.parts or 0
		end
		for _, poly in ipairs(Config.Map.paths) do
			local plan = PlacementMod.pathTiles(poly, A.pathTile, A.pathWind)
			local placedHere = 0
			for _, t in ipairs(plan.tiles) do
				local key = t.kind
				local c = cost(key)
				if c <= 0 and key == "path_curve" then
					key, c = "path_straight", cost("path_straight")
				end
				if c > 0 and used + c <= A.pathBudgetParts and not (P.blocked(t.x, t.z, 2, { allowDomain = true }) == "eau") then
					local clone = assets.cloneModel("paths", key)
					if clone and assets.place(clone, t.x, t.z, t.rot, nil, folder, A.pathTile, 0.08) then
						used, tiles, placedHere = used + c, tiles + 1, placedHere + 1
					end
				end
			end
			local sc = cost("path_stones")
			for i, b in ipairs(plan.borders) do
				if sc > 0 and used + sc <= A.pathBudgetParts and i % 2 == 0 then -- une pierre sur deux : bordure aérée
					local clone = assets.cloneModel("paths", "path_stones")
					if clone and assets.place(clone, b.x, b.z, b.rot, A.pathBorderHeight, folder, nil, 0.08) then
						used = used + sc
					end
				end
			end
			if placedHere > 0 then
				for _, d in ipairs(world:GetDescendants()) do
					if d.Name == "PathStone" and d:IsA("BasePart") then
						for k = 1, #poly - 1 do
							if PlacementMod.distToSegment(d.Position.X, d.Position.Z, poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2]) < A.pathWind + 6 then
								d:Destroy()
								break
							end
						end
					end
				end
			end
		end
	end)
	return tiles, used
end

-- Décor de village Blender sur la carte (tour, maisons à colombages, puits, pins hauts, rochers) : planifié par Placement.scenery, budget séparé.
-- Retourne (objets posés, Parts utilisées).
function Builder.dressScenery(assets)
	local placed, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderVillage"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local dims = Config.Assets.sceneryDims
		for _, it in ipairs(P.scenery(P.plan().items)) do
			local st = assets.status and assets.status["m:scenery." .. it.kind]
			local cost = st and st.ok and st.parts or 0
			if cost > 0 and used + cost <= Config.Assets.sceneryBudgetParts then
				local clone = assets.cloneModel("scenery", it.kind)
				local d = dims[it.kind]
				if clone and assets.place(clone, it.x, it.z, it.rot, d.h, folder, d.len, it.y) then
					used, placed = used + cost, placed + 1
				end
			end
		end
	end)
	return placed, used
end

-- Panneaux de difficulté Blender (étoiles Etoile1..Etoile5 recolorées : or pour les étoiles acquises, gris sinon) à la place du panneau procédural.
function Builder.dressSigns(assets)
	local n = 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		for _, d in ipairs(world:GetDescendants()) do
			if d.Name == "DifficultyBoard" and d:IsA("BasePart") then
				local clone = assets.cloneModel("deco", "sign_stars")
				if clone then
					local stars = d:GetAttribute("Stars") or 1
					local pos = d.Position
					if setModel(clone, pos.X, pos.Y - 6.8, pos.Z, nil, Config.Assets.decoHeights.sign_stars, d.Parent, 0) then
						for _, q in ipairs(clone:GetDescendants()) do
							local idx = q:IsA("BasePart") and tonumber(AssetsMod.baseName(q.Name):match("^Etoile(%d)$"))
							if idx then
								q.Color = idx <= stars and Color3.fromRGB(255, 205, 70) or Color3.fromRGB(120, 120, 130)
							end
						end
						clone.Name = "StarSign"
						d.Transparency = 1
						n = n + 1
					end
				end
			end
		end
	end)
	return n
end

-- Relief en toile de fond (budget séparé reliefBudgetParts) : crête de falaises sur deux niveaux au nord de la carte (hors zone de jeu), cascades, escaliers de
-- terrasse, îlots Blender des lacs ; un mur invisible garde les joueurs hors de la crête. Retourne (pièces posées, Parts utilisées).
function Builder.dressRelief(assets)
	local n, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderRelief"
		folder.Parent = world
		local half = Config.Map.groundSize / 2
		local budget = Config.Assets.reliefBudgetParts
		local function cost(key)
			local st = assets.status and assets.status["m:terrain." .. key]
			return (st and st.ok and st.parts) or nil
		end
		local function put(key, x, y0, z, span, height, rot)
			local c = cost(key)
			if not c or used + c > budget then
				return false
			end
			local clone = assets.cloneModel("terrain", key)
			if clone and setModel(clone, x, y0, z, span, height, folder, rot) then
				used = used + c
				n = n + 1
				return true
			end
			return false
		end
		if not cost("cliff_a") then
			return
		end
		local zRow = -half + 28 -- crête au nord, à l'intérieur du bord de carte
		-- mur invisible : les joueurs ne montent pas sur la crête
		part({ Name = "ReliefWall", Size = Vector3.new(2 * half - 100, 14, 1.5), Position = Vector3.new(0, 7, zRow + 8), Transparency = 1, CanCollide = true, CanQuery = false, CanTouch = false }, folder)
		local x = -half + 130
		local k = 0
		while x <= half - 230 do
			local key = k % 3 == 2 and "cliff_b" or "cliff_a"
			put(key, x, 0, zRow, 16, nil, 180)
			x = x + 16
			k = k + 1
		end
		put("cliff_corner", -half + 114, 0, zRow, 12, nil, 180)
		put("cliff_corner", x, 0, zRow, 12, nil, 180)
		-- deuxième niveau (terrasse supérieure) sur la partie centrale, dans la limite du budget
		local x2 = -200
		while x2 <= 200 and put(k % 2 == 0 and "cliff_a" or "cliff_b", x2, 8, zRow - 5, 16, nil, 180) do
			x2 = x2 + 16
			k = k + 1
		end
		-- cascades devant la crête et escaliers de terrasse
		for _, wx in ipairs({ -260, 90 }) do
			put("waterfall", wx, 0, zRow + 4, nil, 8, 180)
		end
		for _, sx in ipairs({ -340, 260 }) do
			put("stairs", sx, 0, zRow + 8, 8, nil, 180)
		end
		-- îlots Blender des lacs : remplacent l'îlot procédural
		for _, lk in ipairs(Config.Map.geo.lakes or {}) do
			if lk.islet and put("islet", lk.x, 0.2, lk.z, 24, nil, 0) then
				for _, d in ipairs(world:GetDescendants()) do
					if (d.Name == "Islet" or d.Name == "IsletRock") and d:IsA("BasePart") and math.abs(d.Position.X - lk.x) < 12 and math.abs(d.Position.Z - lk.z) < 12 then
						d.Transparency = 1
						d.CanCollide = false
					end
				end
			end
		end
	end)
	return n, used
end

-- Anime la herse de la salle d'après l'état de la porte procédurale (appelé 10 fois par seconde, ne change que sur changement d'état).
function Builder.animDoor(rec, open)
	local vis = rec.vis
	if vis and vis.last ~= open then
		vis.last = open
		vis.part.CFrame = vis.base * CFrame.new(0, open and 9 or 0, 0)
	end
end

-- Ouvre le couvercle du coffre final quelques secondes.
function Builder.openChest()
	local cv = builtCastle and builtCastle.chestVis
	if cv then
		cv.part.CFrame = cv.base * CFrame.Angles(-1.2, 0, 0)
		task.delay(4, function()
			if cv.part.Parent then
				cv.part.CFrame = cv.base
			end
		end)
	end
end

-- Habille les chevaliers du château avec guards.knight (hauteur Config.Assets.guardHeights.knight). Le pilote procédural devient invisible.
function Builder.dressKnights(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		local parent = builtCastle and builtCastle.rooms[1] and builtCastle.rooms[1].door and builtCastle.rooms[1].door.Parent
		if not parent then
			return
		end
		for _, rec in ipairs(builtCastle.rooms) do
			for _, v in ipairs(rec.knights) do
				local clone = assets.cloneModel("guards", "knight")
				if clone then
					clone.Name = "CastleKnightModel"
					if setModel(clone, v.part.Position.X, 0, v.wz, nil, Config.Assets.guardHeights.knight, parent, 0) then
						v.vis = { model = clone, off = CFrame.new(v.part.Position.X, 0, v.wz):ToObjectSpace(clone:GetPivot()) }
						v.part.Transparency = 1
						n = n + 1
					end
				end
			end
		end
	end)
	return n
end

-- Place le modèle du chevalier sur sa position et le tourne dans le sens de la marche (devant = -Z : vers +X = -90°).
function Builder.animKnight(v, x, z, dir, speed)
	local vis = v.vis
	if vis then
		local by, roll = GuardMod.walkPose(os.clock() + (v.wz or 0), speed or 8) -- rebond et roulis de marche
		vis.model:PivotTo(CFrame.new(x, by, z) * CFrame.Angles(0, dir > 0 and -math.pi / 2 or math.pi / 2, 0) * CFrame.Angles(0, 0, roll) * vis.off)
	end
end

-- Anime le modèle d'un piège d'après la position de son pilote procédural (appelé 10 fois par seconde par le château).
function Builder.animSpike(v, tipY, state)
	local vis = v.vis
	if vis and vis.last ~= state then
		vis.last = state
		vis.part.CFrame = vis.base * CFrame.new(0, tipY - 0.9, 0) -- le modèle est dessiné pics sortis
	end
end
function Builder.animBlade(v, angle)
	local vis = v.vis
	if vis then
		local c = vis.center
		vis.part.CFrame = CFrame.new(c) * CFrame.Angles(0, angle, 0) * CFrame.new(-c) * vis.base
	end
end
function Builder.animBall(v, x, y, z)
	local vis = v.vis
	if vis then
		vis.model:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, 0, -x / math.max(0.5, vis.d / 2)))
	end
end

-- Habille les gardiens des domaines avec les modèles Blender chargés (guards.dog / wolf / bear). Retourne le nombre de gardiens remplacés.
function Builder.dressGuards(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while #builtGuards == 0 and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		for _, g in ipairs(builtGuards) do
			local kind = Config.Assets.guardKinds[g.rival]
			local clone = kind and assets.cloneModel("guards", kind)
			if clone and fitGuard(g.model, clone, Config.Assets.guardHeights[kind]) then
				n = n + 1
			end
		end
	end)
	return n
end

function Builder.guard(rivalIdx)
	local r = Config.RIVALS[rivalIdx]
	local col = r.color:Lerp(Color3.fromRGB(60, 40, 30), 0.6)
	local model = Instance.new("Model")
	model.Name = "Guard" .. rivalIdx
	local body = part({ Name = "Body", CanCollide = false, Size = Vector3.new(3, 2.4, 4.4), CFrame = CFrame.new(0, 0, 0), Color = col }, model)
	model.PrimaryPart = body
	ball({ Name = "Head", Size = Vector3.new(2.4, 2.4, 2.4), CFrame = CFrame.new(0, 0.7, -2.7), Color = col }, model)
	part({ Name = "Snout", CanCollide = false, Size = Vector3.new(1.2, 0.9, 1.2), CFrame = CFrame.new(0, 0.3, -3.7), Color = Color3.fromRGB(35, 30, 30) }, model)
	ball({ Name = "EyeL", Size = Vector3.new(0.45, 0.45, 0.45), CFrame = CFrame.new(-0.7, 1.2, -3.5), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon }, model)
	ball({ Name = "EyeR", Size = Vector3.new(0.45, 0.45, 0.45), CFrame = CFrame.new(0.7, 1.2, -3.5), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon }, model)
	part({ Name = "EarL", CanCollide = false, Size = Vector3.new(0.5, 1.1, 0.6), CFrame = CFrame.new(-1.0, 1.9, -2.5) * CFrame.Angles(0, 0, 0.3), Color = col }, model)
	part({ Name = "EarR", CanCollide = false, Size = Vector3.new(0.5, 1.1, 0.6), CFrame = CFrame.new(1.0, 1.9, -2.5) * CFrame.Angles(0, 0, -0.3), Color = col }, model)
	part({ Name = "Tail", CanCollide = false, Size = Vector3.new(0.6, 0.6, 2), CFrame = CFrame.new(0, 0.8, 3.0) * CFrame.Angles(0.5, 0, 0), Color = col }, model)
	for i, o in ipairs({ { -1, -1.4 }, { 1, -1.4 }, { -1, 1.4 }, { 1, 1.4 } }) do
		part({ Name = "Leg" .. i, CanCollide = false, Size = Vector3.new(0.7, 1.6, 0.7), CFrame = CFrame.new(o[1], -1.8, o[2]), Color = col }, model)
	end
	if r.gentle then -- anneau de vision au sol (disque jaune translucide de la portée de vue) : on voit jusqu'où Gus repère
		part({ Name = "VisionRing", Size = Vector3.new(0.1, r.viewDist * 2, r.viewDist * 2), CFrame = CFrame.new(0, -2.25, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.SmoothPlastic, Transparency = 0.8, CanCollide = false, CanQuery = false }, model)
	end
	local s = sign(body, "🐕 Gardien de " .. r.name, Color3.fromRGB(255, 120, 120), 4, 220)
	s.TextSize = 14
	return model
end

---------------------------------------------------------------- Éclairage
-- Ambiance « jour doré » : soleil chaud, brume légère, bloom discret, étalonnage plus vif.
function Builder.setupLighting()
	Lighting.ClockTime = 15.3
	Lighting.Brightness = 2.2 -- plus doux
	Lighting.Ambient = Color3.fromRGB(110, 112, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(135, 140, 158)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 238, 205)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ShadowSoftness = 0.35
	Lighting.GlobalShadows = true

	local function effect(class, name, props)
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(class)
			e.Name = name
			e.Parent = Lighting
		end
		for k, v in pairs(props) do
			e[k] = v
		end
		return e
	end

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.32 -- brouillard léger : les lointains se fondent dans le ciel
	atm.Offset = 0.25
	atm.Color = Color3.fromRGB(199, 220, 255)
	atm.Decay = Color3.fromRGB(255, 214, 170)
	atm.Glare = 0.25
	atm.Haze = 1.7

	effect("BloomEffect", "ChipeBloom", { Intensity = 0.3, Size = 24, Threshold = 0.96 })
	effect("SunRaysEffect", "ChipeSunRays", { Intensity = 0.15, Spread = 0.8 })
	effect("ColorCorrectionEffect", "ChipeGrade", { Saturation = 0.1, Contrast = 0.06, Brightness = 0.02 }) -- couleurs plus harmonieuses, moins saturées
end

---------------------------------------------------------------- Monument du Grand Nid (identité du jeu, au centre de l'arène)
function Builder.monument(parent)
	local gold = Color3.fromRGB(255, 214, 120)
	part({ Name = "MonumentBase", Size = Vector3.new(1.4, 17, 17), CFrame = CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(176, 160, 128), Material = Enum.Material.Slate }, parent)
	part({ Name = "MonumentStep", Size = Vector3.new(0.8, 12, 12), CFrame = CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(130, 116, 92), Material = Enum.Material.Slate }, parent)
	local egg = Instance.new("Part")
	egg.Name = "GrandNid"
	egg.Anchored = true
	egg.Size = Vector3.new(8, 11, 8)
	egg.CFrame = CFrame.new(0, 8.1, 0)
	egg.Color = gold
	egg.Material = Enum.Material.Metal
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = egg
	local glow = Instance.new("PointLight")
	glow.Color = gold
	glow.Range = 28
	glow.Brightness = 1.5
	glow.Parent = egg
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = SPARK
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 235, 160))
	sparks.Rate = 8
	sparks.Lifetime = NumberRange.new(2, 3.5)
	sparks.Speed = NumberRange.new(1, 3)
	sparks.Acceleration = Vector3.new(0, 2, 0)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	sparks.Parent = egg
	egg.Parent = parent
	for k, c in ipairs({ { 0, 9.5, -3.7, 0.3 }, { 1.2, 6.6, -3.75, -0.5 }, { -1.1, 4.2, -3.6, 0.6 } }) do -- fissures lumineuses
		part({ Name = "Crack" .. k, Size = Vector3.new(0.35, 3.2, 0.35), CFrame = CFrame.new(c[1], c[2], c[3]) * CFrame.Angles(0, 0, c[4]), Color = Color3.fromRGB(255, 248, 200), Material = Enum.Material.Neon, CanCollide = false }, parent)
	end
	-- Quatre runes cardinales (Nord = côté des rivaux). Chaque joueur règle ses propres runes : le symbole affiché est local au client
	-- (étiquette « Label » modifiée côté client), l'état est tenu par le serveur.
	local dirs = { { 0, -1 }, { 1, 0 }, { 0, 1 }, { -1, 0 } }
	for k, dv in ipairs(dirs) do
		local x, z = dv[1] * 9.5, dv[2] * 9.5
		local stone = part({ Name = "RuneStone", Size = Vector3.new(2.4, 5, 1.2), CFrame = CFrame.lookAt(Vector3.new(x, 3.2, z), Vector3.new(0, 3.2, 0)), Color = Color3.fromRGB(110, 104, 96), Material = Enum.Material.Slate }, parent)
		stone:SetAttribute("Idx", k)
		CollectionService:AddTag(stone, "RuneStone")
		part({ Name = "RuneGlow", Size = Vector3.new(1.1, 3.4, 0.2), CFrame = stone.CFrame * CFrame.new(0, 0.2, -0.65), Color = gold, Material = Enum.Material.Neon, CanCollide = false }, parent)
		local lbl = sign(stone, "?", Color3.fromRGB(255, 240, 190), 4.4, 120)
		lbl.TextSize = 44
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Tourner la rune"
		pr.ObjectText = "Rune du " .. Config.RUNE_DIRECTIONS[k]
		pr.HoldDuration = 0
		pr.MaxActivationDistance = 9
		pr.RequiresLineOfSight = false
		pr:SetAttribute("Kind", "Rune")
		pr:SetAttribute("Idx", k)
		pr.Parent = stone
	end
	-- Valider la combinaison en touchant le Grand Nid
	local confirm = Instance.new("ProximityPrompt")
	confirm.ActionText = "Poser la combinaison"
	confirm.ObjectText = "Grand Nid"
	confirm.HoldDuration = 0.5
	confirm.MaxActivationDistance = 14
	confirm.RequiresLineOfSight = false
	confirm:SetAttribute("Kind", "RuneConfirm")
	confirm.Parent = egg
	-- Panneau de l'énigme de Mère Poule (texte mis à jour chaque jour par le serveur), lisible des deux côtés
	local board = part({ Name = "RiddleBoard", Size = Vector3.new(12, 4.6, 0.5), Position = Vector3.new(0, 3.8, 14), Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.WoodPlanks }, parent)
	part({ Name = "RiddlePostL", Size = Vector3.new(0.7, 4, 0.7), Position = Vector3.new(-5.4, 2, 14), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	part({ Name = "RiddlePostR", Size = Vector3.new(0.7, 4, 0.7), Position = Vector3.new(5.4, 2, 14), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	local labels = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.CanvasSize = Vector2.new(720, 300)
		sg.LightInfluence = 0
		sg.Adornee = board
		sg.Parent = board
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, 0, 0, 56)
		title.Font = FONT
		title.TextSize = 40
		title.TextColor3 = gold
		title.Text = "📜 Énigme de Mère Poule"
		title.Parent = sg
		local body = Instance.new("TextLabel")
		body.BackgroundTransparency = 1
		body.Position = UDim2.fromOffset(16, 60)
		body.Size = UDim2.new(1, -32, 1, -64)
		body.Font = Enum.Font.GothamMedium
		body.TextSize = 29
		body.TextWrapped = true
		body.TextColor3 = Color3.fromRGB(255, 244, 220)
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.Text = "…"
		body.Parent = sg
		labels[#labels + 1] = body
	end
	local result = { labels = labels, center = Vector3.new(0, 8.1, 0) }
	local t = sign(egg, "✨ Le Grand Nid ✨\nReconstruis la Couvée, Chipeur !", gold, 9, 340)
	t.TextSize = 20
	return result
end

---------------------------------------------------------------- Mère Poule (gardienne du Grand Nid, guide de l'histoire)
-- Les parties de la tête portent un nom préfixé « Hen » : le client les fait picorer (Animations.client.lua) et la cinématique
-- d'introduction la met en scène (ancre « hen » = tag Hen).
function Builder.hen(parent)
	local white, red, orange, dark = Color3.fromRGB(250, 248, 240), Color3.fromRGB(235, 60, 60), Color3.fromRGB(255, 170, 40), Color3.fromRGB(30, 28, 32)
	local model = Instance.new("Model")
	model.Name = "MerePoule"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent -- cinématiques et énigme : toujours présente côté client
	local body = ball({ Name = "Body", Size = Vector3.new(4, 4, 4), CFrame = CFrame.new(0, 0, 0), Color = white }, model)
	model.PrimaryPart = body
	part({ Name = "Tail", Size = Vector3.new(1.2, 2.2, 0.6), CFrame = CFrame.new(0, 0.8, 2.1) * CFrame.Angles(-0.5, 0, 0), Color = white, CanCollide = false }, model)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Wing", Size = Vector3.new(0.3, 2, 2.2), CFrame = CFrame.new(side * 2.05, 0, 0.2) * CFrame.Angles(0, 0, side * 0.15), Color = Color3.fromRGB(238, 232, 220), CanCollide = false }, model)
		part({ Name = "Leg", Size = Vector3.new(0.3, 1.3, 0.3), CFrame = CFrame.new(side * 0.8, -2.5, 0), Color = orange, CanCollide = false }, model)
		part({ Name = "Foot", Size = Vector3.new(0.9, 0.2, 1.1), CFrame = CFrame.new(side * 0.8, -3.15, -0.3), Color = orange, CanCollide = false }, model)
		ball({ Name = "HenEye" .. (side < 0 and "L" or "R"), Size = Vector3.new(0.38, 0.38, 0.38), CFrame = CFrame.new(side * 0.6, 2.55, -2.6), Color = dark }, model)
	end
	ball({ Name = "HenHead", Size = Vector3.new(2.3, 2.3, 2.3), CFrame = CFrame.new(0, 2.3, -1.7), Color = white }, model)
	part({ Name = "HenComb", Size = Vector3.new(0.5, 0.9, 1.2), CFrame = CFrame.new(0, 3.6, -1.7), Color = red, CanCollide = false }, model)
	part({ Name = "HenBeak", Size = Vector3.new(0.8, 0.5, 0.9), CFrame = CFrame.new(0, 2.15, -3.0), Color = orange, CanCollide = false }, model)
	ball({ Name = "HenWattle", Size = Vector3.new(0.6, 0.8, 0.5), CFrame = CFrame.new(0, 1.6, -2.8), Color = red }, model)
	local label = sign(body, "🐔 Mère Poule\nGardienne du Grand Nid", Color3.fromRGB(255, 220, 140), 5.5, 260)
	label.TextSize = 17
	model:SetAttribute("Seed", 3)
	CollectionService:AddTag(model, "Hen")
	model:PivotTo(CFrame.lookAt(Vector3.new(-9, 3.2, 13), Vector3.new(0, 3.2, 0))) -- regarde le Grand Nid
	model.Parent = parent
	return model
end

---------------------------------------------------------------- Monde
local PLOT_COLORS = {
	Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 180, 80), Color3.fromRGB(255, 230, 90), Color3.fromRGB(140, 230, 110),
	Color3.fromRGB(80, 220, 200), Color3.fromRGB(90, 170, 255), Color3.fromRGB(170, 130, 255), Color3.fromRGB(255, 130, 220),
	Color3.fromRGB(235, 235, 235), Color3.fromRGB(170, 190, 160),
}
Builder.PLOT_COLORS = PLOT_COLORS
local FLOWER_COLORS = {
	Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 255, 255), Color3.fromRGB(160, 130, 255), Color3.fromRGB(255, 150, 70),
}

local function tree(pos, parent, rng)
	local s = rng:NextNumber(0.85, 1.3)
	part({ Name = "Trunk", Size = Vector3.new(2 * s, 8 * s, 2 * s), Position = pos + Vector3.new(0, 4 * s, 0), Color = Color3.fromRGB(110, 78, 50), Material = Enum.Material.Wood }, parent)
	local dark, light = Color3.fromRGB(62, 142, 68), Color3.fromRGB(92, 178, 86)
	ball({ Name = "Leaves", Size = Vector3.new(11 * s, 11 * s, 11 * s), Position = pos + Vector3.new(0, 11 * s, 0), Color = dark, Material = Enum.Material.Grass }, parent)
	ball({ Name = "Leaves", Size = Vector3.new(7 * s, 7 * s, 7 * s), Position = pos + Vector3.new(3.2 * s, 9.2 * s, 1.5 * s), Color = light, Material = Enum.Material.Grass }, parent)
	ball({ Name = "Leaves", Size = Vector3.new(6 * s, 6 * s, 6 * s), Position = pos + Vector3.new(-2.8 * s, 14 * s, -1 * s), Color = light, Material = Enum.Material.Grass }, parent)
end

local function torch(pos, parent)
	part({ Name = "TorchPost", Size = Vector3.new(0.8, 5, 0.8), Position = pos + Vector3.new(0, 2.5, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	local head = ball({ Name = "TorchHead", Size = Vector3.new(1.3, 1.3, 1.3), Position = pos + Vector3.new(0, 5.4, 0), Color = Color3.fromRGB(255, 150, 60), Material = Enum.Material.Neon }, parent)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 170, 70)
	fire.SecondaryColor = Color3.fromRGB(255, 90, 30)
	fire.Parent = head
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 170, 90)
	l.Range = 18
	l.Brightness = 1.2
	l.Parent = head
end

-- Falaise (cylindre de roche), dalle d'herbe au sommet (à la hauteur H exacte) et rampe du domaine i. Retourne le nombre de Parts.
function Builder.plateau(i, parent, riv)
	local d = Config.Map.domains[i]
	local R, H = Config.Map.plateauRadius, d.h
	local f = Instance.new("Folder")
	f.Name = "Terrace_" .. riv.name
	f.Parent = parent
	-- falaise : de -2 à H - 0,5 ; dalle d'herbe : de H - 0,5 à H (son dessus est le sol du domaine)
	part({ Name = "Cliff", Size = Vector3.new(H + 1.5, R * 2, R * 2), CFrame = CFrame.new(d.x, (H - 0.5 - 2) / 2, d.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(128, 122, 118), Material = Enum.Material.Slate }, f)
	part({ Name = "PlateauTop", Size = Vector3.new(0.5, R * 2 - 1.5, R * 2 - 1.5), CFrame = CFrame.new(d.x, H - 0.25, d.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = riv.color:Lerp(Color3.fromRGB(92, 160, 82), 0.65), Material = Enum.Material.Grass }, f)
	local ramp = Config.rampOf(i)
	local len = math.sqrt(ramp.run ^ 2 + H ^ 2)
	local mid = Vector3.new((ramp.top[1] + ramp.bottom[1]) / 2, H / 2 - 0.5, (ramp.top[2] + ramp.bottom[2]) / 2)
	part({ Name = "Ramp", Size = Vector3.new(Config.Map.rampWidth, 1, len), CFrame = CFrame.lookAt(mid, Vector3.new(ramp.bottom[1], -0.5, ramp.bottom[2])), Color = Color3.fromRGB(176, 150, 112), Material = Enum.Material.Slate }, f)
	return 3
end

-- Retourne { plots, nests, treadmill, guards, treadmillContains }
function Builder.build()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	for _, c in ipairs(workspace:GetChildren()) do
		if c:IsA("SpawnLocation") then
			c:Destroy()
		end
	end

	Builder.setupLighting()

	-- Sol, relief et décor ----------------------------------------------------------
	part({ Name = "Ground", Size = Vector3.new(Config.Map.groundSize, 2, Config.Map.groundSize), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(92, 160, 82), Material = Enum.Material.Grass }, world)
	local rng = Random.new(7)
	local half = Config.Map.groundSize / 2
	local DC = Config.Map.decor
	local patchSpots = {}
	for _ = 1, DC.patches do -- taches d'herbe plus claires / plus sombres, sans jamais se recouvrir (deux faces coplanaires scintilleraient)
		local d = rng:NextNumber(40, 100)
		local px, pz
		for _ = 1, 40 do
			local tx, tz = rng:NextNumber(-half + 60, half - 60), rng:NextNumber(-half + 60, half - 60)
			local free = math.sqrt(tx * tx + tz * tz) > 100 + d / 2 -- jamais sous l'arène
			for _, o in ipairs(patchSpots) do
				if math.sqrt((tx - o[1]) ^ 2 + (tz - o[2]) ^ 2) < (d + o[3]) / 2 + 2 then
					free = false
					break
				end
			end
			if free then
				px, pz = tx, tz
				break
			end
		end
		if px then
			patchSpots[#patchSpots + 1] = { px, pz, d }
			local c = rng:NextNumber() < 0.5 and Color3.fromRGB(104, 172, 90) or Color3.fromRGB(80, 146, 74)
			part({ Name = "Patch", Size = Vector3.new(0.1, d, d), CFrame = CFrame.new(px, 0.03, pz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = c, Material = Enum.Material.Grass, CanCollide = false }, world)
		end
	end
	for k = 0, DC.hills - 1 do -- collines à l'horizon (hors de la zone de jeu)
		local a = k / DC.hills * math.pi * 2
		local sz = rng:NextNumber(240, 380)
		ball({ Name = "Hill", Size = Vector3.new(sz, sz, sz), Position = Vector3.new(math.sin(a) * (half + 90), -sz * 0.36, math.cos(a) * (half + 90)), Color = Color3.fromRGB(78 + (k % 3) * 8, 150 + (k % 2) * 10, 80), Material = Enum.Material.Grass }, world)
	end
	for _, w in ipairs({ { 0, half - 2, half * 2, 4 }, { 0, -half + 2, half * 2, 4 }, { half - 2, 0, 4, half * 2 }, { -half + 2, 0, 4, half * 2 } }) do -- murs invisibles : on ne tombe plus dans le vide
		part({ Name = "Wall", Size = Vector3.new(w[3], 100, w[4]), Position = Vector3.new(w[1], 50, w[2]), Transparency = 1 }, world).CanQuery = false
	end
	part({ Name = "ArenaRim", Size = Vector3.new(0.2, 156, 156), CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(150, 125, 85), Material = Enum.Material.Sand, CanCollide = false }, world)
	part({ Name = "Arena", Size = Vector3.new(0.3, 150, 150), CFrame = CFrame.new(0, 0.02, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(214, 190, 140), Material = Enum.Material.Sand, CanCollide = false }, world)

	local monument = Builder.monument(world)
	Builder.hen(world)

	local function inDomain(x, z)
		for i = 1, #Config.RIVALS do
			local dx, dz = Config.rivalCenter(i)
			if math.sqrt((x - dx) ^ 2 + (z - dz) ^ 2) < Config.Map.domainRadius + 14 then
				return true
			end
		end
		return false
	end
	for _ = 1, DC.trees do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(90, 125)
		local tx, tz = math.sin(a) * r, math.cos(a) * r
		if not inDomain(tx, tz) then
			tree(Vector3.new(tx, 0, tz), world, rng)
		end
	end
	for _ = 1, DC.flowers do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(80, 136)
		ball({ Name = "Flower", Size = Vector3.new(0.9, 0.9, 0.9), Position = Vector3.new(math.sin(a) * r, 0.45, math.cos(a) * r), Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)] }, world)
	end
	for _ = 1, 22 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(80, 138)
		local sz = rng:NextNumber(2.5, 5)
		ball({ Name = "Rock", Size = Vector3.new(sz, sz, sz), Position = Vector3.new(math.sin(a) * r, sz * 0.15, math.cos(a) * r), Color = Color3.fromRGB(130, 134, 140), Material = Enum.Material.Slate }, world)
	end

	local result = { plots = {}, nests = {}, guards = {}, riddleLabels = monument.labels, monumentCenter = monument.center }

	-- Rivaux PNJ (au nord, z négatif) ------------------------------------------------
	local sceneryHelpers = { part = part, ball = ball, tree = tree, torch = torch, sign = sign }
	local sceneryParts = 0
	for i, riv in ipairs(Config.RIVALS) do
		local cx, cz = Config.rivalCenter(i)
		local folder = Instance.new("Folder")
		folder.Name = "Rival_" .. riv.name
		folder.Parent = world
		part({ Name = "GlowRing", Size = Vector3.new(0.4, 38, 38), CFrame = CFrame.new(cx, 0.3, cz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = riv.color, Material = Enum.Material.SmoothPlastic, CanCollide = false }, folder)
		part({ Name = "Disc", Size = Vector3.new(1, 34, 34), CFrame = CFrame.new(cx, 0.5, cz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = riv.color:Lerp(Color3.fromRGB(70, 55, 40), 0.55), Material = Enum.Material.Slate, CanCollide = false }, folder)
		for k = 0, DC.fencePosts - 1 do -- palissade sur l'arrière (le devant reste ouvert vers l'arène)
			local t = -0.15 * math.pi + k * (1.3 * math.pi / (DC.fencePosts - 1))
			local pp = Vector3.new(cx + 17.5 * math.cos(t), 0, cz - 17.5 * math.sin(t))
			part({ Name = "Post", Size = Vector3.new(1, 4, 1), Position = pp + Vector3.new(0, 2.5, 0), Color = Color3.fromRGB(100, 70, 46), Material = Enum.Material.Wood }, folder)
			ball({ Name = "PostCap", Size = Vector3.new(0.9, 0.9, 0.9), Position = pp + Vector3.new(0, 4.9, 0), Color = riv.color, Material = Enum.Material.Neon }, folder)
		end
		torch(Vector3.new(cx - 15, 0.5, cz + 9), folder)
		torch(Vector3.new(cx + 15, 0.5, cz + 9), folder)
		sceneryParts += Scenery.moat(sceneryHelpers, cx, cz, folder, Config)
		local theme = Scenery[Config.Map.zoneKeys[i]]
		if theme then
			local okS, countS = pcall(theme, sceneryHelpers, cx, cz, folder, Random.new(100 + i))
			if okS then
				sceneryParts += countS
			else
				warn("[Builder] décor du domaine " .. riv.name .. " : " .. tostring(countS))
			end
		end
		local zone = Config.ZONES[i]
		if zone and zone.chapter > 0 then
			-- Barrière du domaine verrouillé. Elle est solide pour tous ; le client la rend traversable (localement) dès que le
			-- joueur a réussi le chapitre requis. Le serveur refuse de toute façon tout vol dans une zone verrouillée.
			local gate = part({ Name = "ZoneGate", Size = Vector3.new(12, 40, 40), CFrame = CFrame.new(cx, 6, cz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 70, 90), Material = Enum.Material.Neon, Transparency = 0.6 }, folder)
			gate:SetAttribute("Rival", i)
			gate:SetAttribute("Chapter", zone.chapter)
			CollectionService:AddTag(gate, "ZoneGate")
			sign(gate, "🔒 " .. zone.name .. "\nHistoire : chapitre " .. zone.chapter, Color3.fromRGB(255, 210, 210), 10, 300)
		end
		local pole = part({ Name = "Sign", Size = Vector3.new(1, 9, 1), Position = Vector3.new(cx, 4.5, cz - 14), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, folder)
		part({ Name = "Flag", Size = Vector3.new(0.2, 3, 5), Position = Vector3.new(cx + 0.2, 8, cz - 11.5), Color = riv.color, Material = Enum.Material.Fabric, CanCollide = false }, folder)
		local t = sign(pole, riv.emoji .. " " .. riv.name .. "  " .. string.rep("★", riv.stars), Color3.fromRGB(255, 220, 90), 7, 260)
		t.TextSize = 22
		for j = 1, 3 do
			local nx = cx + (j - 2) * 8
			local mound = part({ Name = "Nest", Size = Vector3.new(0.7, 6, 6), CFrame = CFrame.new(nx, 1, cz - 3) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.Wood, CanCollide = false }, folder)
			part({ Name = "NestStraw", Size = Vector3.new(0.3, 4.4, 4.4), CFrame = CFrame.new(nx, 1.32, cz - 3) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(226, 196, 120), Material = Enum.Material.Fabric, CanCollide = false }, folder)
			Scenery.marker(sceneryHelpers, Vector3.new(nx, 0.5, cz - 3), folder, "✋", 8)
			sceneryParts += 1
			result.nests[#result.nests + 1] = { rival = i, pos = Vector3.new(nx, 3.2, cz - 3), mound = mound, folder = folder, egg = nil, rt = math.random() * 6 }
		end
		-- gardiens : de plus en plus nombreux (1, 2, 3), chacun avec son TERRITOIRE (± 12 studs, jamais superposés) et sa propre ligne de patrouille
		local count = riv.guards or 1
		for j = 1, count do
			local gx, gz = Config.guardTerritory(i, j, count)
			local g = Builder.guard(i)
			g.Name = "Guard" .. i .. "_" .. j
			g.Parent = folder
			builtGuards[#builtGuards + 1] = { model = g, rival = i }
			result.guards[#result.guards + 1] = {
				model = g, rival = i, cx = gx, patrolZ = gz, pos = Vector3.new(gx, 2.4, gz),
				dir = ((i + j) % 2 == 0) and -1 or 1, state = "patrol", cd = 0, lost = 0,
			}
			g:PivotTo(CFrame.new(gx, 2.4, gz))
		end
		-- panneau de difficulté à l'entrée du domaine (devant le pont sud) : étoiles et nombre de gardiens
		do
			local post = part({ Name = "DifficultySign", Size = Vector3.new(0.8, 6, 0.8), Position = Vector3.new(cx + 12, 3, cz + Config.Map.plateauRadius - 5), Color = Color3.fromRGB(110, 76, 46), Material = Enum.Material.Wood, CanCollide = false }, folder)
			local board = part({ Name = "DifficultyBoard", Size = Vector3.new(7, 3, 0.5), Position = Vector3.new(cx + 12, 6.8, cz + Config.Map.plateauRadius - 5), Color = Color3.fromRGB(70, 50, 36), Material = Enum.Material.WoodPlanks, CanCollide = false }, folder)
			local lbl = sign(board, string.rep("⭐", riv.stars) .. string.rep("☆", 5 - riv.stars) .. "\n" .. riv.name .. " : " .. count .. " gardien" .. (count > 1 and "s" or ""), Color3.fromRGB(255, 220, 120), 0, 200)
			lbl.TextSize = 16
			post.Anchored = true
			board:SetAttribute("Stars", riv.stars)
		end
		-- PLATEAU en terrasse : tout le domaine (décor, nids, gardiens, portail, douve) est relevé de H ; la falaise et la rampe sont posées hors du dossier
		local H = Config.rivalHeight(i)
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = d.CFrame + Vector3.new(0, H, 0)
			end
		end
		for _, nest in ipairs(result.nests) do
			if nest.rival == i then
				nest.pos = nest.pos + Vector3.new(0, H, 0)
			end
		end
		for _, g in ipairs(result.guards) do
			if g.rival == i then
				g.pos = g.pos + Vector3.new(0, H, 0)
			end
		end
		sceneryParts += Builder.plateau(i, world, riv)
	end

	-- Tapis roulant (les rayures sont animées côté client grâce au tag BeltStripe) -----
	do
		local belt = part({ Name = "Treadmill", Size = Vector3.new(16, 1, 40), Position = Vector3.new(0, 0.6, 38), Color = Color3.fromRGB(45, 48, 56), Material = Enum.Material.Metal }, world)
		belt.AssemblyLinearVelocity = Vector3.new(0, 0, -14) -- le tapis pousse vers -Z : il faut courir vers +Z
		for k = 0, 7 do
			local stripe = part({ Name = "Stripe", Size = Vector3.new(14, 0.1, 1.2), Position = Vector3.new(0, 1.16, 38 - 17.5 + k * 5), Color = Color3.fromRGB(255, 210, 63), Material = Enum.Material.Neon, CanCollide = false }, belt)
			stripe:SetAttribute("Z0", -17.5 + k * 5)
			stripe:SetAttribute("CenterZ", 38)
			CollectionService:AddTag(stripe, "BeltStripe")
		end
		for _, sx in ipairs({ -8.6, 8.6 }) do
			part({ Name = "Rail", Size = Vector3.new(0.8, 1.6, 40), Position = Vector3.new(sx, 1.1, 38), Color = Color3.fromRGB(255, 210, 63), Material = Enum.Material.Neon }, world)
		end
		local pole = part({ Name = "TreadSign", Size = Vector3.new(1, 8, 1), Position = Vector3.new(-11, 4, 38), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
		sign(pole, "🏃 TAPIS ROULANT\nCours dessus pour gagner en vitesse !", Color3.fromRGB(255, 220, 90), 6, 300)
		result.treadmill = { cf = belt.CFrame, size = belt.Size }
	end

	-- Bases des joueurs ---------------------------------------------------------------
	local N = Config.PLOT_COUNT
	local radius = Config.Map.plotRadius
	for i = 1, N do
		local pc = PLOT_COLORS[(i - 1) % #PLOT_COLORS + 1]
		local a = (i - 1) / N * math.pi * 2
		local pos = Vector3.new(math.sin(a) * radius, 0, math.cos(a) * radius)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0)) -- l'avant (-Z) regarde le centre
		local model = Instance.new("Model")
		model.Name = "Plot" .. i
		model.Parent = world
		local plat = part({ Name = "Platform", Size = Vector3.new(52, 1, 52), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(62, 112, 88):Lerp(pc, 0.15), Material = Enum.Material.Concrete }, model)
		for _, e in ipairs({ { 0, -25.5, 52, 1 }, { 0, 25.5, 52, 1 }, { -25.5, 0, 1, 52 }, { 25.5, 0, 1, 52 } }) do -- liseré néon aux couleurs de la base
			part({ Name = "Edge", Size = Vector3.new(e[3], 0.25, e[4]), CFrame = cf * CFrame.new(e[1], 1.1, e[2]), Color = pc, Material = Enum.Material.Neon, CanCollide = false }, model)
		end
		for _, c in ipairs({ { -25, -25 }, { 25, -25 }, { -25, 25 }, { 25, 25 } }) do -- lampadaires
			part({ Name = "LampPost", Size = Vector3.new(0.9, 7, 0.9), CFrame = cf * CFrame.new(c[1], 4.5, c[2]), Color = Color3.fromRGB(50, 52, 60), Material = Enum.Material.Metal }, model)
			ball({ Name = "Lamp", Size = Vector3.new(1.8, 1.8, 1.8), CFrame = cf * CFrame.new(c[1], 8.4, c[2]), Color = Color3.fromRGB(255, 235, 170), Material = Enum.Material.Neon }, model)
		end
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 235, 190)
		glow.Range = 45
		glow.Brightness = 0.7
		glow.Parent = plat

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 0.4, 6)
		spawn.CFrame = cf * CFrame.new(0, 1.2, -20)
		spawn.Color = pc
		spawn.Material = Enum.Material.Neon
		spawn.Transparency = 0.4
		spawn.Parent = model

		local pads = {}
		for idx = 1, 12 do
			local lx, lz = Config.padLocal(idx)
			local frame = part({ Name = "PadFrame" .. idx, Size = Vector3.new(8.8, 0.3, 8.8), CFrame = cf * CFrame.new(lx, 1.12, lz), Color = pc, Material = Enum.Material.Neon, CanCollide = false }, model)
			local pad = part({ Name = "Pad" .. idx, Size = Vector3.new(8, 0.4, 8), CFrame = cf * CFrame.new(lx, 1.2, lz), Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7, CanCollide = false }, model)
			local lockText = sign(pad, "🔒", Color3.new(1, 1, 1), 2.5, 80)
			pads[idx] = { part = pad, lock = lockText.Parent, frame = frame, content = nil }
			if Config.Map.pedestals then
				sceneryParts += Scenery.pedestal(sceneryHelpers, (cf * CFrame.new(lx, 0.62, lz)).Position, model, nil)
			end
		end

		local board = part({ Name = "Board", Size = Vector3.new(1, 7, 1), CFrame = cf * CFrame.new(0, 4.5, 24), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, model)
		local plank = part({ Name = "Plank", Size = Vector3.new(18, 4.2, 0.7), CFrame = cf * CFrame.new(0, 8.6, 23.6), Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.WoodPlanks }, model)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front -- face -Z de la planche = côté arène
		sg.CanvasSize = Vector2.new(720, 168)
		sg.LightInfluence = 0
		sg.Adornee = plank
		sg.Parent = plank
		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Size = UDim2.fromScale(1, 1)
		nameLabel.Font = FONT
		nameLabel.TextScaled = true
		nameLabel.TextColor3 = pc
		nameLabel.TextStrokeTransparency = 0.3
		nameLabel.Text = "Base libre"
		nameLabel.Parent = sg
		board.Name = "BoardPole"

		builtPlots[i] = { spawn = spawn }
		result.plots[i] = { model = model, cf = cf, pads = pads, spawn = spawn, nameLabel = nameLabel, owner = nil, platform = plat, color = pc }
	end

	-- Chemins, repères lointains, relief, secrets (chaque bloc est isolé : une erreur de décor ne bloque jamais le jeu)
	local srng = Random.new(2024)
	for name, fn in pairs({
		paths = function()
			return Scenery.paths(sceneryHelpers, world, Config)
		end,
		rivers = function()
			return Scenery.rivers(sceneryHelpers, world, Config)
		end,
		castle = function()
			local cw, cn = Scenery.castle(sceneryHelpers, world, Castle)
			result.castle = cw
			builtCastle = cw
			return cn
		end,
		lakes = function()
			return Scenery.lakes(sceneryHelpers, world, Config)
		end,
		landmarks = function()
			return Scenery.landmarks(sceneryHelpers, world, srng)
		end,
		relief = function()
			return Scenery.relief(sceneryHelpers, world, srng, Config)
		end,
		secrets = function()
			return Scenery.secrets(sceneryHelpers, world, Config)
		end,
	}) do
		local okS, countS = pcall(fn)
		if okS then
			sceneryParts += countS
		else
			warn("[Builder] décor « " .. name .. " » : " .. tostring(countS))
		end
	end
	local total = 0
	for _, d in ipairs(world:GetDescendants()) do
		if d:IsA("BasePart") then
			total += 1
		end
	end
	result.partCount = total
	if total > Config.Map.budgetParts then
		warn("[Builder] budget mobile dépassé : " .. total .. " Parts (budget " .. Config.Map.budgetParts .. "). Réduis le décor (Scenery) ou Config.Map.budgetParts.")
	else
		print("[Builder] carte construite : " .. total .. " Parts (budget " .. Config.Map.budgetParts .. ")")
	end

	-- Voyage rapide : portails du Grand Nid vers chaque zone et portails de retour au pied des rampes (prompt serveur, tag « FastTravel », attribut Dest)
	result.fastTravel = {}
	do
		local folder = Instance.new("Folder")
		folder.Name = "FastTravel"
		folder.Parent = world
		local function pad(x, z, dest, label, color)
			local p = part({ Name = "TravelPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7, 7), CFrame = CFrame.new(x, 0.3, z) * CFrame.Angles(0, 0, math.pi / 2), Color = color, Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false }, folder)
			part({ Name = "TravelRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 8.4, 8.4), CFrame = CFrame.new(x, 0.18, z) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.5, CanCollide = false }, folder)
			sign(p, label, color:Lerp(Color3.new(1, 1, 1), 0.4), 4.5, 190)
			local pr = Instance.new("ProximityPrompt")
			pr.ActionText = "Voyage rapide"
			pr.ObjectText = label
			pr.HoldDuration = 0.6
			pr.MaxActivationDistance = 8
			pr.RequiresLineOfSight = false
			pr:SetAttribute("Dest", dest)
			pr.Parent = p
			CollectionService:AddTag(pr, "FastTravel")
			result.fastTravel[#result.fastTravel + 1] = { prompt = pr, dest = dest, pos = Vector3.new(x, 0.3, z) }
		end
		local cols = { Color3.fromRGB(110, 200, 120), Color3.fromRGB(170, 120, 230), Color3.fromRGB(255, 130, 90) }
		for i = 1, #Config.RIVALS do
			local x, z = Config.travelPad(i)
			pad(x, z, i, "🌀 " .. Config.ZONES[i].name, cols[i])
			local rx, rz = Config.returnPad(i)
			pad(rx, rz, 0, "🌀 Grand Nid", Color3.fromRGB(255, 214, 120))
		end
	end

	result.treadmillContains = function(p)
		local rel = result.treadmill.cf:PointToObjectSpace(p)
		local s = result.treadmill.size
		return math.abs(rel.X) <= s.X / 2 and math.abs(rel.Z) <= s.Z / 2 and rel.Y > 0 and rel.Y < 8
	end

	return result
end

---------------------------------------------------------------- Effets
-- Explosion de particules + flash lumineux à l'éclosion (disparaît seule).
function Builder.burst(position, color, count, big)
	local anchor = Instance.new("Part")
	anchor.Name = "Burst"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = position
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.LightEmission = 1
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Speed = NumberRange.new(big and 14 or 8, big and 32 or 18)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, big and 1.8 or 1), NumberSequenceKeypoint.new(1, 0) })
	e.Rate = 0
	e.Parent = anchor
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = big and 26 or 14
	l.Brightness = big and 6 or 3
	l.Parent = anchor
	anchor.Parent = workspace
	e:Emit(count)
	local ring = Instance.new("Part")
	ring.Name = "Shockwave"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 3, 3)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = color
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.2
	ring:SetAttribute("Big", big == true)
	CollectionService:AddTag(ring, "Shockwave") -- animée côté client
	ring.Parent = workspace
	game:GetService("Debris"):AddItem(ring, 1.5)
	game:GetService("TweenService"):Create(l, TweenInfo.new(0.7), { Brightness = 0 }):Play()
	game:GetService("Debris"):AddItem(anchor, 2.5)
end

-- Œuf qui vole vers le joueur qui vient de le prendre (animé côté client grâce au tag FlyEgg).
function Builder.flyEgg(tier, fromPos, userId)
	local egg = Builder.egg(tier, true)
	egg.Name = "FlyEgg"
	egg.CFrame = CFrame.new(fromPos)
	egg:SetAttribute("Target", userId)
	egg:SetAttribute("Start", fromPos)
	CollectionService:AddTag(egg, "FlyEgg")
	egg.Parent = workspace
	game:GetService("Debris"):AddItem(egg, 1.2)
	return egg
end

-- Pet suiveur : version miniature d'un pet, sans étiquette.
-- Aura d'une rareté élevée : cercle runique, particules, pilier de lumière (voir Scenery.aura), détruite seule. Retourne true si créée.
function Builder.aura(position, color, tier, secret)
	local style = Config.auraStyle(tier, secret, false)
	if not style then
		return false
	end
	local ok, anchor = pcall(function()
		local a = Scenery.aura({ part = part, ball = ball }, position, workspace, style, color)
		CollectionService:AddTag(a, "AuraFx")
		return a
	end)
	if not ok then
		return false
	end
	game:GetService("Debris"):AddItem(anchor, style.seconds)
	return true
end

-- Nid sous un œuf (paille : plateau, bord, brins) ; remplacé par le modèle Blender NidOeufs si disponible. Retourne le nombre de Parts du repli.
-- Protection Blender de l'œuf d'un emplacement selon la rareté (nid à barrière, dôme de verre, cage, cristaux) : mise à la largeur cible, vitre du dôme
-- translucide, lumière proportionnelle à la rareté. `budget` = { used = n } (Parts de protection déjà posées dans la base). Retourne le nombre de Parts
-- posées ou nil (repli : nid procédural). Ne lève jamais d'erreur.
function Builder.eggGuard(position, parent, tier, budget)
	if not eggAssets or not eggAssets.cloneModel then
		return nil
	end
	local key = Config.eggGuardKey(tier)
	local st = eggAssets.status and eggAssets.status["m:eggguard." .. key]
	local cost = (st and st.ok and st.parts) or 0
	if cost <= 0 or (budget and budget.used + cost > Config.Assets.eggGuardBudgetPerBase) then
		return nil
	end
	local clone = eggAssets.cloneModel("eggguard", key)
	if not clone then
		return nil
	end
	local ok, count = eggAssets.place(clone, position.X, position.Z, 0, nil, parent, Config.Assets.eggGuardWidth[key], position.Y)
	if not ok then
		return nil
	end
	pcall(function()
		clone.Name = "EggGuard"
		local glow = Config.eggGuardGlow(tier)
		local tint = Config.TIERS[math.min(math.max(tier, 1), #Config.TIERS)].color
		local first
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				first = first or d
				if AssetsMod.baseName(d.Name) == "Dome_Verre" then
					d.Transparency = 0.7
					d.Material = Enum.Material.Glass
					d.Color = d.Color:Lerp(tint, 0.35)
					d.CastShadow = false
				end
			end
		end
		if first then
			local l = Instance.new("PointLight")
			l.Name = "RarityGlow"
			l.Color = tint
			l.Brightness = glow.brightness
			l.Range = glow.range
			l.Parent = first
		end
	end)
	if budget then
		budget.used = budget.used + (count or cost)
	end
	pcall(function()
		parent:SetAttribute("GuardParts", count or cost) -- relu par clearPad pour rendre le budget à la base
	end)
	return count or cost
end

function Builder.nest(position, parent, tier, budget)
	if tier and Builder.eggGuard(position, parent, tier, budget) then
		return 0
	end
	-- modèle Blender NidOeufs s'il est chargé (cloné, jamais rechargé), sinon nid de paille procédural
	local clone = eggAssets and eggAssets.cloneProp and eggAssets.cloneProp("nest")
	if clone then
		local ok = eggAssets.place(clone, position.X, position.Z, 0, Config.Assets.propsHeight.nest, parent, nil, position.Y)
		if ok then
			return 0
		end
	end
	local ok, n = pcall(Scenery.nest, { part = part, ball = ball }, position, parent)
	return ok and n or 0
end

-- Pose les accessoires Blender sur la carte une fois chargés (arbres, sapins, rochers, buissons, cabanes, barrières, ponts) avec un budget de Parts :
-- le placement s'arrête dès que Config.Assets.propsBudgetParts serait dépassé. Positions déterministes, hors domaines, secrets, rivières et bases.
-- Retourne le nombre de Parts posées. Ne lève jamais d'erreur (tout sous pcall) ; rien n'est posé si les modèles sont absents (la carte reste procédurale).
function Builder.dressWorld(assets)
	local total, placed = 0, 0
	local ok = pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do -- la carte est construite en parallèle : on l'attend (30 s au plus)
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderProps"
		folder.Parent = world
		-- Pose PLANIFIÉE (Placement) : grille, empreintes sans recouvrement, rien dans l'eau ni sur un chemin, cabanes face à leur domaine, barrières
		-- alignées, ponts centrés sur leurs rivières et plus longs qu'elles.
		local plan = PlacementMod.new(Config).plan()
		local huts, treeIdx, fences = 0, 0, 0
		local function put(key, x, z, rot, length, gy)
			if total + (Config.Assets.propsMaxParts[key] or 0) > Config.Assets.propsBudgetParts then
				return
			end
			local clone, height = nil, Config.Assets.propsHeight[key]
			if key == "bridge" then
				clone = assets.cloneModel("props", "bridge_rail") -- pont à rampes (repli : pont simple)
			elseif key == "hut" then
				huts = huts + 1
				local alt = huts % 2 == 1 and "hut_big" or "hut_small"
				clone = assets.cloneModel("props", alt)
				height = clone and Config.Assets.targetHeights[alt] or height
			end
			if key == "fence" then
				fences = fences + 1
				clone = assets.cloneModel("props", fences % 4 == 0 and "fence_gate" or "fence_corner") -- barrières Blender (le catalogue d'accessoires reste le repli)
			end
			if key == "tree" or key == "fir" then
				treeIdx = treeIdx + 1
				local variant = PlacementMod.treeVariant(Config, key, x, z, treeIdx)
				local st = assets.status and assets.status["m:trees." .. variant]
				local vc = st and st.ok and st.parts or Config.Assets.propsMaxParts[key]
				if st and st.ok and total + vc <= Config.Assets.propsBudgetParts then
					clone = assets.cloneModel("trees", variant)
					if clone then
						height = (Config.Assets.treeHeights[variant] or height) * PlacementMod.jitter(x, z, Config.Assets.treeScaleJitter)
					end
				end
			end
			clone = clone or assets.cloneProp(key)
			if not clone then
				return
			end
			local okPlace, count = assets.place(clone, x, z, rot, height, folder, length, gy)
			if okPlace then
				total = total + count
				placed = placed + 1
			end
		end
		for _, it in ipairs(plan.items) do
			put(it.kind, it.x, it.z, it.rot, nil, it.y)
		end
		for _, b in ipairs(plan.bridges) do
			put("bridge", b.x, b.z, b.rot, b.length)
		end
	end)
	return ok and total or 0, placed
end

function Builder.follower(petIdx, sizeIdx, mutIdx)
	local model = Builder.pet(petIdx, sizeIdx, mutIdx)
	model:ScaleTo(0.45)
	model:SetAttribute("Seed", petIdx * 31 + sizeIdx * 7 + mutIdx)
	return model
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Rules</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Rules
-- Règles de jeu PURES (aucun service Roblox) : tirages, revenus, durées, capacités.
-- Config est injectée (Rules.new(Config)) pour que ces règles se testent hors de Roblox (Lune, voir tests/run.luau).
local Rules = {}

function Rules.new(Config)
	local R = {}

	-- Plafond (en %) de la part « rareté supérieure » : garantit que le poids « identique » ne devient jamais négatif
	-- (niveau 10 du Trèfle + événement + Pass Chance + Potion donnaient 87 % + 22 % de « plus bas » = poids négatif).
	R.MAX_UP = 70

	-- Tirage pondéré. `rnd` retourne un nombre dans [0, 1). Les poids négatifs sont traités comme 0.
	-- Ne retourne jamais un index de poids nul (sauf si tous les poids sont nuls : dernier index).
	function R.wpick(weights, rnd)
		local total, last = 0, #weights
		for i, w in ipairs(weights) do
			if w > 0 then
				total += w
				last = i
			end
		end
		if total <= 0 then
			return #weights
		end
		local r = rnd() * total
		for i, w in ipairs(weights) do
			if w > 0 then
				r -= w
				if r < 0 then
					return i
				end
			end
		end
		return last
	end

	-- Points de « rareté supérieure » (en %) selon les bonus actifs.
	function R.upPoints(luckLevel, luckEvent, passLucky, potionActive)
		local up = Config.UPGRADE.base + luckLevel -- 5 % de base : UNE chance d'amélioration d'un cran (jamais de rétrogradation)
		if luckEvent then
			up += Config.UPGRADE.event
		end
		if passLucky then
			up += Config.UPGRADE.pass
		end
		if potionActive then
			up += Config.LUCK_POTION_BONUS
		end
		return up
	end

	-- Poids { plus bas, identique, plus haut } pour un œuf de rareté `tier`.
	function R.tierWeights(tier, upPoints)
		local down = 0 -- l'œuf annoncé fixe la rareté : jamais de rareté inférieure
		local up = tier < #Config.TIERS and math.min(math.max(upPoints, 0), R.MAX_UP) or 0
		return { down, 100 - down - up, up }
	end

	function R.pickTier(tier, upPoints, rnd)
		return tier + R.wpick(R.tierWeights(tier, upPoints), rnd) - 2
	end

	function R.mutWeights(alienBoost)
		local w = {}
		for i, m in ipairs(Config.MUTS) do
			w[i] = m.weight
			if alienBoost and m.name == "Alien" then
				w[i] = m.weight * 5
			end
		end
		return w
	end

	function R.sizeWeights()
		local w = {}
		for i, z in ipairs(Config.SIZES) do
			w[i] = z.weight
		end
		return w
	end

	-- Tire un pet : { p = index d'espèce, s = index de taille, m = index de mutation }.
	-- `guaranteed` : tirage de pitié, le pet est forcément d'une rareté au-dessus de l'œuf (sauf œuf de rareté maximale).
	function R.rollPet(eggTier, upPoints, alienBoost, rnd, guaranteed)
		local tier
		if guaranteed and eggTier < #Config.TIERS then
			tier = eggTier + 1
		else
			tier = R.pickTier(eggTier, upPoints, rnd)
		end
		local ids = {}
		for i, p in ipairs(Config.PETS) do
			if p.tier == tier then
				ids[#ids + 1] = i
			end
		end
		local pick = ids[math.min(#ids, math.floor(rnd() * #ids) + 1)]
		return { p = pick, s = R.wpick(R.sizeWeights(), rnd), m = R.wpick(R.mutWeights(alienBoost), rnd), tier = tier }
	end

	function R.multiplier(rebirths, foodLevel, goldEvent, pass2x, collectionBonus)
		local m = (1 + 0.5 * rebirths) * (1 + 0.2 * foodLevel) * (collectionBonus or 1)
		if goldEvent then
			m *= 2
		end
		if pass2x then
			m *= 2
		end
		return m
	end

	function R.capacity(up)
		return 4 + up.slots
	end

	function R.carryCapacity(up)
		return 1 + up.bag
	end

	function R.hatchTime(tier, incLevel, fastPass)
		return Config.HATCH[tier] * 0.9 ^ incLevel * (fastPass and 0.75 or 1)
	end

	function R.shieldTime(lockLevel)
		return Config.SHIELD_BASE + Config.SHIELD_PER_LEVEL * lockLevel
	end

	-- Revenu par seconde : somme des pets présents sur les emplacements débloqués, multipliée par `mult`.
	function R.income(slots, capacity, mult)
		local total = 0
		for i = 1, capacity do
			local sl = slots[i]
			if sl and sl.k == "p" then
				total += Config.petIncome(sl.p, sl.s, sl.m)
			end
		end
		return total * mult
	end

	return R
end

return Rules
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Diag</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Diag
-- Classement pur des erreurs de services Roblox (testé hors Roblox). Aucune dépendance.
local Diag = {}

-- Studio sans « Enable Studio Access to API Services » : DataStore refusé, inutile de réessayer.
function Diag.isStudioApiError(err)
	local s = tostring(err)
	return s:find("StudioAccessToApisNotAllowed", 1, true) ~= nil
		or s:find("API access is not enabled", 1, true) ~= nil
		or s:find("Studio access to APIs is not allowed", 1, true) ~= nil
end

return Diag
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Scenery</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Scenery
-- Décor identitaire de chaque domaine, chemins, repères lointains et secrets. Tout en Parts de base ; les outils de construction de
-- Builder sont injectés (h.part, h.ball, h.tree, h.torch, h.sign). Chaque fonction retourne le nombre de Parts créées (budget mobile).
local CollectionService = game:GetService("CollectionService")

local Scenery = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function cyl(h, props, parent, diameter, height, pos, rotY)
	-- cylindre à axe vertical : height = hauteur, diameter = diamètre
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(pos) * CFrame.Angles(0, rotY or 0, math.pi / 2)
	return h.part(props, parent)
end

local function light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
	return l
end

local function emitter(parent, color, rate, speed, life, size, accel)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.7, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(40, 40)
	e.Acceleration = accel or Vector3.new(0, 0, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 0.8
	e.Parent = parent
	return e
end

---------------------------------------------------------------- Château : 5 salles à pièges, entrée, coffre final, tableau des temps
-- Construit le donjon décrit par Castle (géométrie pure). Retourne (monde, nombre de Parts) : monde.rooms[r] = { spikes = { {base, spikes} }, blades = {...},
-- balls = {...}, door }, monde.chest (Part), monde.entry (Part), monde.board (TextLabel). Les pièges sont animés côté serveur (voir Main).
function Scenery.castle(h, parent, Castle)
	local world = { rooms = {} }
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	local W, L = Castle.ROOM_WIDTH, Castle.ROOM_LENGTH
	for r = 1, Castle.ROOMS do
		local room = Castle.room(r)
		local cx, cz = Castle.toWorld(r, 0, L / 2)
		local rec = { spikes = {}, blades = {}, balls = {}, knights = {} }
		world.rooms[r] = rec
		P({ Name = "CastleFloor" .. r, Size = Vector3.new(W, 1, L), Position = Vector3.new(cx, -0.5, cz), Color = r % 2 == 0 and rgb(122, 118, 132) or rgb(104, 100, 114), Material = Enum.Material.Slate })
		for _, sx in ipairs({ -1, 1 }) do
			P({ Name = "CastleWall", Size = Vector3.new(2, 14, L), Position = Vector3.new(cx + sx * (W / 2 + 1), 7, cz), Color = rgb(96, 92, 106), Material = Enum.Material.Slate })
		end
		-- liseré de salle (couleur de difficulté : de vert à rouge) et torches
		local heat = (r - 1) / (Castle.ROOMS - 1)
		local ex, ez = Castle.toWorld(r, 0, 0.6)
		P({ Name = "CastleStartLine", Size = Vector3.new(W, 0.15, 1.2), Position = Vector3.new(ex, 0.08, ez), Color = Color3.fromRGB(math.floor(80 + 175 * heat), math.floor(230 - 150 * heat), 90), Material = Enum.Material.Neon, CanCollide = false })
		for _, sx in ipairs({ -1, 1 }) do
			local tx, tz = Castle.toWorld(r, sx * (W / 2 - 1), 4)
			local torch = P({ Name = "CastleTorch", Size = Vector3.new(1, 1, 1), Position = Vector3.new(tx, 6, tz), Color = rgb(255, 150, 60), Material = Enum.Material.Neon, CanCollide = false })
			light(torch, rgb(255, 170, 90), 22, 1)
		end
		-- pics : plaque + pointes (la pointe monte quand le danger approche)
		for i, sp in ipairs(Castle.spikes(room)) do
			local wx, wz = Castle.toWorld(r, sp.lx, sp.lz)
			local base = P({ Name = "SpikePlate", Size = Vector3.new(6.4, 0.3, 6.4), Position = Vector3.new(wx, 0.15, wz), Color = rgb(70, 70, 80), Material = Enum.Material.Metal, CanCollide = false })
			local tip = P({ Name = "SpikeTips", Size = Vector3.new(5, 1.6, 5), Position = Vector3.new(wx, -1, wz), Color = rgb(210, 214, 222), Material = Enum.Material.Metal, CanCollide = false })
			rec.spikes[i] = { base = base, tip = tip, wx = wx, wz = wz }
		end
		-- lames : un bras traversant (deux demi-bras) autour d'un moyeu
		for i, bl in ipairs(Castle.blades(room)) do
			local wx, wz = Castle.toWorld(r, bl.lx, bl.lz)
			P({ Name = "BladeHub", Size = Vector3.new(2.4, 2.4, 2.4), Position = Vector3.new(wx, 1.4, wz), Color = rgb(60, 60, 70), Material = Enum.Material.Metal, CanCollide = false })
			local arm = P({ Name = "BladeArm", Size = Vector3.new(bl.arm * 2, 0.5, 1.4), Position = Vector3.new(wx, 1.4, wz), Color = rgb(215, 220, 232), Material = Enum.Material.Metal, CanCollide = false })
			CollectionService:AddTag(arm, "CastleBlade") -- le client joue la boucle de la lame selon la distance
			rec.blades[i] = { arm = arm, wx = wx, wz = wz }
		end
		-- boulets : sphère qui traverse la salle (cachée sous le sol pendant la pause)
		for i, ba in ipairs(Castle.balls(room)) do
			local wx, wz = Castle.toWorld(r, 0, ba.lz)
			local ball = h.ball({ Name = "Boulder", Size = Vector3.new(ba.radius * 2, ba.radius * 2, ba.radius * 2), Position = Vector3.new(wx, -10, wz), Color = rgb(122, 127, 140), Material = Enum.Material.Slate }, parent)
			n += 1
			CollectionService:AddTag(ball, "CastleBall")
			rec.balls[i] = { part = ball, wz = wz }
		end
		-- chevaliers : silhouette d'armure (pilote de la logique ; remplacée par le modèle Blender si chargé)
		for i, kn in ipairs(Castle.knights(room)) do
			local wx, wz = Castle.toWorld(r, 0, kn.lz)
			local k = P({ Name = "CastleKnight", Size = Vector3.new(3, 6, 3), Position = Vector3.new(wx, 3, wz), Color = rgb(150, 156, 170), Material = Enum.Material.Metal, CanCollide = false })
			rec.knights[i] = { part = k, wz = wz }
		end
		-- porte de fin de salle (s'ouvre par intervalles)
		local dx, dz = Castle.toWorld(r, 0, L - 1)
		rec.door = P({ Name = "CastleDoor" .. r, Size = Vector3.new(W, 9, 1.2), Position = Vector3.new(dx, 4.5, dz), Color = rgb(74, 74, 82), Material = Enum.Material.Metal })
		rec.doorClosedY, rec.doorX, rec.doorZ = 4.5, dx, dz
	end
	-- entrée (le joueur peut y entrer depuis l'arène) : arche et invite
	local ex, ez = Castle.toWorld(1, 0, -6)
	local entry = P({ Name = "CastleEntry", Size = Vector3.new(14, 1, 8), Position = Vector3.new(ex, 0.5, ez), Color = rgb(255, 110, 60), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.3 })
	for _, sx in ipairs({ -8, 8 }) do
		P({ Name = "CastleGatePillar", Size = Vector3.new(3, 16, 3), Position = Vector3.new(ex + sx, 8, ez), Color = rgb(112, 108, 120), Material = Enum.Material.Slate })
	end
	P({ Name = "CastleGateTop", Size = Vector3.new(19, 3, 3), Position = Vector3.new(ex, 17, ez), Color = rgb(96, 92, 104), Material = Enum.Material.Slate })
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Entrer"
	pr.ObjectText = "🏰 Le Château"
	pr.HoldDuration = 0.8
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	CollectionService:AddTag(pr, "CastleEntry")
	pr.Parent = entry
	world.entry = entry
	-- coffre final au bout de la salle 5
	local cx2, cz2 = Castle.toWorld(Castle.ROOMS, 0, L - 5)
	local chest = P({ Name = "CastleChest", Size = Vector3.new(6, 4, 4), Position = Vector3.new(cx2, 2, cz2), Color = rgb(150, 98, 44), Material = Enum.Material.Wood })
	P({ Name = "CastleChestLid", Size = Vector3.new(6.4, 1.4, 4.4), Position = Vector3.new(cx2, 4.4, cz2), Color = rgb(232, 185, 35), Material = Enum.Material.Metal, CanCollide = false })
	light(chest, rgb(255, 215, 90), 26, 1.6)
	local cp = Instance.new("ProximityPrompt")
	cp.ActionText = "Ouvrir le coffre"
	cp.ObjectText = "🏆 Trésor du Château"
	cp.HoldDuration = 1
	cp.MaxActivationDistance = 12
	cp.RequiresLineOfSight = false
	CollectionService:AddTag(cp, "CastleChest")
	cp.Parent = chest
	world.chest = chest
	-- tableau des meilleurs temps, à l'entrée
	local bx, bz = Castle.toWorld(1, 18, -6)
	local board = P({ Name = "CastleBoard", Size = Vector3.new(11, 7, 0.7), Position = Vector3.new(bx, 6, bz), Color = rgb(40, 30, 34), Material = Enum.Material.WoodPlanks })
	local bb = Instance.new("BillboardGui")
	bb.Adornee = board
	bb.Size = UDim2.fromOffset(360, 200)
	bb.MaxDistance = 110
	bb.LightInfluence = 0
	bb.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextColor3 = rgb(255, 214, 120)
	label.Text = "🏰 Meilleurs temps\n(aucun pour l'instant)"
	label.Parent = bb
	world.board = label
	return world, n
end

---------------------------------------------------------------- Nid de paille sous un œuf (repli procédural de NidOeufs)
function Scenery.nest(h, position, parent)
	local n = 0
	cyl(h, { Name = "NestBase", Color = rgb(196, 150, 70), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent, 6, 0.5, position + Vector3.new(0, 0.3, 0))
	cyl(h, { Name = "NestRim", Color = rgb(150, 104, 44), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent, 6.8, 0.35, position + Vector3.new(0, 0.2, 0))
	n += 2
	for i = 1, 8 do -- brins de paille dépassant du bord
		local a = i / 8 * math.pi * 2
		h.part({ Name = "NestStraw", Size = Vector3.new(0.3, 0.25, 1.6), CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 3.2, 0.55, math.sin(a) * 3.2)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = rgb(226, 190, 100), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent)
		n += 1
	end
	return n
end

---------------------------------------------------------------- Piédestal hexagonal des emplacements (lumières chaudes)
-- Trois dalles croisées à 60° dessinent un hexagone ; liseré néon chaud. Retourne le nombre de Parts.
function Scenery.pedestal(h, position, parent, warm)
	local n = 0
	cyl(h, { Name = "PedestalSlab", Color = rgb(210, 200, 184), Material = Enum.Material.Marble, CanCollide = false }, parent, 9.6, 0.5, position)
	cyl(h, { Name = "PedestalGlow", Color = warm or rgb(255, 190, 90), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.45 }, parent, 10.4, 0.15, position + Vector3.new(0, -0.15, 0))
	return 2
end

---------------------------------------------------------------- Aura des raretés élevées : cercle runique au sol, piliers, particules
-- style = Config.auraStyle(...) ; color = couleur de rareté. Disparaît seule après style.seconds (Debris côté appelant). Retourne (ancre, nombre de Parts).
function Scenery.aura(h, position, parent, style, color)
	local n = 0
	local anchor = h.part({ Name = "AuraAnchor", Size = Vector3.new(1, 1, 1), Position = position, Transparency = 1, CanCollide = false, CanQuery = false }, parent)
	n += 1
	cyl(h, { Name = "RuneRing", Color = color, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent, 11, 0.15, position + Vector3.new(0, 0.2, 0))
	cyl(h, { Name = "RuneRingInner", Color = color, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, CanQuery = false }, parent, 7, 0.15, position + Vector3.new(0, 0.25, 0))
	n += 2
	for i = 1, style.runes do -- glyphes : petits blocs néon répartis sur le cercle
		local a = i / style.runes * math.pi * 2
		h.part({ Name = "Rune", Size = Vector3.new(0.5, 0.2, 1.1), CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 4.6, 0.3, math.sin(a) * 4.6)) * CFrame.Angles(0, -a, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }, parent)
		n += 1
	end
	local em = emitter(anchor, color, style.rate, 7, 1.6, 0.5, Vector3.new(0, 2, 0))
	em.SpreadAngle = Vector2.new(25, 25)
	light(anchor, color, 24, 1.6)
	if style.pillar then -- Beam : pilier de lumière
		local top = h.part({ Name = "AuraTop", Size = Vector3.new(1, 1, 1), Position = position + Vector3.new(0, 26, 0), Transparency = 1, CanCollide = false, CanQuery = false }, parent)
		n += 1
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Parent = anchor
		a1.Parent = top
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1 = a0, a1
		beam.Width0, beam.Width1 = 3.2, 1.2
		beam.Color = ColorSequence.new(color)
		beam.Transparency = NumberSequence.new(0.3)
		beam.LightEmission = 1
		beam.FaceCamera = true
		beam.Parent = anchor
	end
	return anchor, n
end

---------------------------------------------------------------- Douve et pont en bois d'un domaine (îlot lisible de loin)
-- Anneau d'eau franchissable (décor, CanCollide faux) autour du domaine, liseré de sable, pont en bois au sud (face à l'arène). Retourne le nombre de Parts.
function Scenery.moat(h, cx, cz, parent, cfg)
	local n = 0
	local R, W = cfg.Map.moat.radius, cfg.Map.moat.width
	local segments = cfg.Map.decor.moatSegments
	local chord = 2 * math.pi * R / segments + 1.5
	for k = 0, segments - 1 do
		local a = k / segments * math.pi * 2
		local south = math.sin(a) > 0.99 -- face au sud (z+) : berge de sable sous le pont, pas d'eau
		h.part({ Name = south and "MoatBank" or "MoatWater", Size = Vector3.new(chord, 0.3, W), CFrame = CFrame.new(cx + math.cos(a) * R, south and 0.3 or (0.1 + (k % 2) * 0.11), cz + math.sin(a) * R) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = south and rgb(214, 190, 140) or rgb(60, 150, 220), Material = south and Enum.Material.Sand or Enum.Material.Glass, Transparency = south and 0 or 0.25, CanCollide = false, CanQuery = false }, parent)
		n += 1
	end
	-- pont en bois : planches, deux rampes de rambarde et poteaux, orienté nord-sud
	local bx, bz = cx, cz + R
	for k = -3, 3 do
		h.part({ Name = "BridgePlank", Size = Vector3.new(5.4, 0.45, 1.4), Position = Vector3.new(bx, 0.55, bz + k * 1.6), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks, CanCollide = true }, parent)
		n += 1
	end
	for _, sx in ipairs({ -2.9, 2.9 }) do
		h.part({ Name = "BridgeRail", Size = Vector3.new(0.35, 0.35, 11.4), Position = Vector3.new(bx + sx, 1.8, bz), Color = rgb(120, 82, 48), Material = Enum.Material.Wood, CanCollide = false }, parent)
		h.part({ Name = "BridgePost", Size = Vector3.new(0.6, 2.2, 0.6), Position = Vector3.new(bx + sx, 1.1, bz - 5), Color = rgb(100, 68, 40), Material = Enum.Material.Wood }, parent)
		h.part({ Name = "BridgePost", Size = Vector3.new(0.6, 2.2, 0.6), Position = Vector3.new(bx + sx, 1.1, bz + 5), Color = rgb(100, 68, 40), Material = Enum.Material.Wood }, parent)
		n += 3
	end
	return n
end

-- Deux rivières qui traversent la carte, avec deux ponts chacune : repères de lecture de la grande carte (franchissables).
function Scenery.rivers(h, parent, cfg)
	local n = 0
	local half = cfg.Map.groundSize / 2
	local geo = cfg.Map.geo
	local names, levels = { "RiverSouth", "RiverWest" }, { 0.1, 0.16 } -- deux niveaux : les rivières ne sont jamais coplanaires à leur croisement
	-- pont : planches posées EN TRAVERS de la rivière (axe du pont perpendiculaire à l'eau), plus long qu'elle (les deux rives sont reliées)
	local function bridge(rv, along)
		local planks = cfg.Map.decor.bridgePlanks
		local span = rv.half * 2 + 2 * geo.bridgeBank
		local step = span / (planks - 1)
		for idx = 0, planks - 1 do
			local off = (idx - (planks - 1) / 2) * step
			local px, pz, size
			if rv.axis == "z" then -- rivière le long de x : le pont va du nord au sud
				px, pz, size = along, rv.at + off, Vector3.new(6, 0.45, step + 0.2)
			else -- rivière le long de z : le pont va de l'est à l'ouest
				px, pz, size = rv.at + off, along, Vector3.new(step + 0.2, 0.45, 6)
			end
			h.part({ Name = "BridgePlank", Size = size, Position = Vector3.new(px, 0.55, pz), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks }, parent)
			n += 1
		end
	end
	for i, rv in ipairs(geo.rivers) do
		local length = half * 2 - 60
		if rv.axis == "z" then
			h.part({ Name = names[i], Size = Vector3.new(length, 0.3, rv.half * 2), Position = Vector3.new(0, levels[i], rv.at), Color = rgb(60, 150, 220), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent)
		else
			h.part({ Name = names[i], Size = Vector3.new(rv.half * 2, 0.3, length), Position = Vector3.new(rv.at, levels[i], 0), Color = rgb(60, 150, 220), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent)
		end
		n += 1
		-- mur invisible au milieu de la rivière, avec un passage à chaque pont : on ne traverse l'eau QUE par les ponts
		local cuts, edge = {}, length / 2
		for _, c in ipairs(rv.bridgesAt) do
			cuts[#cuts + 1] = c
		end
		table.sort(cuts)
		local from = -edge
		local function wall(a0, a1)
			if a1 - a0 < 1 then
				return
			end
			local mid, len = (a0 + a1) / 2, a1 - a0
			local pos = rv.axis == "z" and Vector3.new(mid, 5, rv.at) or Vector3.new(rv.at, 5, mid)
			local size = rv.axis == "z" and Vector3.new(len, 10, 1.5) or Vector3.new(1.5, 10, len)
			h.part({ Name = "RiverWall", Size = size, Position = pos, Transparency = 1, CanCollide = true, CanQuery = false, CanTouch = false }, parent)
			n += 1
		end
		for _, c in ipairs(cuts) do
			wall(from, c - geo.bridgeHalfGap)
			from = c + geo.bridgeHalfGap
		end
		wall(from, edge)
		for _, along in ipairs(rv.bridgesAt) do
			bridge(rv, along)
		end
	end
	return n
end

-- Grands lacs à bords nets : disque d'eau, rive de sable (plus bas), îlot (herbe et rocher) ; franchissables à gué (décor), jamais coplanaires.
function Scenery.lakes(h, parent, cfg)
	local n = 0
	for _, lk in ipairs(cfg.Map.geo.lakes or {}) do
		cyl(h, { Name = "LakeShore", Color = rgb(214, 190, 140), Material = Enum.Material.Sand, CanCollide = false }, parent, (lk.r + 5) * 2, 0.3, Vector3.new(lk.x, 0.08, lk.z))
		cyl(h, { Name = "Lake", Color = rgb(60, 150, 220), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent, lk.r * 2, 0.3, Vector3.new(lk.x, 0.16, lk.z))
		n += 2
		if lk.islet then
			cyl(h, { Name = "Islet", Color = rgb(92, 160, 82), Material = Enum.Material.Grass }, parent, 16, 0.6, Vector3.new(lk.x, 0.45, lk.z))
			h.ball({ Name = "IsletRock", Size = Vector3.new(4, 3, 4), Position = Vector3.new(lk.x + 3, 1.3, lk.z - 2), Color = rgb(130, 134, 140), Material = Enum.Material.Slate }, parent)
			n += 2
		end
	end
	return n
end

---------------------------------------------------------------- Marqueur d'élément interactif
-- Tout ce avec quoi on peut agir (nids à chiper, secrets) porte un anneau doré pulsant (tag Interactive, animé côté client) et une icône :
-- les décors n'utilisent jamais ce doré, on distingue donc d'un coup d'œil ce qui est cliquable de ce qui est décoratif.
function Scenery.marker(h, position, parent, icon, diameter)
	local ring = cyl(h, { Name = "InteractiveMarker", Color = rgb(255, 214, 64), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, CanQuery = false }, parent, diameter or 7, 0.2, position + Vector3.new(0, 0.3, 0))
	ring:SetAttribute("BaseT", 0.35)
	CollectionService:AddTag(ring, "Interactive")
	local bb = Instance.new("BillboardGui")
	bb.Name = "InteractiveIcon"
	bb.Adornee = ring
	bb.Size = UDim2.fromOffset(40, 40)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = ring
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.TextScaled = true
	t.Text = icon or "✋"
	t.Parent = bb
	return ring
end

---------------------------------------------------------------- Domaine de Gus : la ferme dorée
function Scenery.gus(h, cx, cz, parent, rng)
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	-- grange rouge (côté ouest, derrière la palisade)
	local bx, bz = cx - 24, cz - 24
	P({ Name = "BarnWalls", Size = Vector3.new(15, 9, 12), Position = Vector3.new(bx, 4.5, bz), Color = rgb(168, 52, 46), Material = Enum.Material.WoodPlanks })
	for _, side in ipairs({ -1, 1 }) do
		P({ Name = "BarnRoof", Size = Vector3.new(8.6, 0.8, 13.5), CFrame = CFrame.new(bx + side * 3.6, 10.6, bz) * CFrame.Angles(0, 0, -side * 0.62), Color = rgb(96, 70, 52), Material = Enum.Material.Wood })
	end
	P({ Name = "BarnDoor", Size = Vector3.new(5, 6.4, 0.5), Position = Vector3.new(bx, 3.2, bz + 6.2), Color = rgb(235, 225, 205), Material = Enum.Material.Wood })
	P({ Name = "BarnCross", Size = Vector3.new(5.6, 0.5, 0.3), CFrame = CFrame.new(bx, 3.2, bz + 6.5) * CFrame.Angles(0, 0, 0.9), Color = rgb(168, 52, 46), CanCollide = false })
	-- moulin à vent
	local mx, mz = cx + 26, cz - 22
	cyl(h, { Name = "MillTower", Color = rgb(226, 210, 178), Material = Enum.Material.Brick }, parent, 6.5, 15, Vector3.new(mx, 7.5, mz))
	n += 1
	cyl(h, { Name = "MillCap", Color = rgb(150, 70, 52), Material = Enum.Material.Wood }, parent, 7.4, 2.4, Vector3.new(mx, 16, mz))
	n += 1
	for k = 0, 3 do
		P({ Name = "MillBlade", Size = Vector3.new(1.6, 11, 0.4), CFrame = CFrame.new(mx, 14, mz + 3.4) * CFrame.Angles(0, 0, k * math.pi / 2 + 0.4) * CFrame.new(0, 5.5, 0), Color = rgb(245, 235, 215), Material = Enum.Material.Fabric, CanCollide = false })
	end
	-- champs de blé (rangées) et bottes de foin
	for r = 0, 5 do
		P({ Name = "Wheat", Size = Vector3.new(30, 2.6, 1.8), Position = Vector3.new(cx + 2, 1.3, cz - 40 + r * 3.2), Color = rgb(226 - (r % 2) * 14, 188 - (r % 2) * 10, 70), Material = Enum.Material.Grass, CanCollide = false })
	end
	for k = 1, 6 do
		n += 1
		cyl(h, { Name = "HayBale", Color = rgb(226, 196, 98), Material = Enum.Material.Fabric }, parent, 3.6, 3.2, Vector3.new(cx - 8 + k * 4.2, 1.8, cz - 12 + (k % 2) * 3), rng:NextNumber(0, 3))
	end
	-- clôture ouest, épouvantail
	for k = 0, 8 do
		P({ Name = "FencePost", Size = Vector3.new(0.7, 3.2, 0.7), Position = Vector3.new(cx - 40, 1.6, cz - 4 + k * 3.4), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
	end
	P({ Name = "FenceRail", Size = Vector3.new(0.4, 0.5, 28), Position = Vector3.new(cx - 40, 2.3, cz + 10), Color = rgb(140, 104, 70), Material = Enum.Material.Wood })
	P({ Name = "ScarecrowPole", Size = Vector3.new(0.5, 5, 0.5), Position = Vector3.new(cx + 12, 2.5, cz - 32), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
	P({ Name = "ScarecrowArms", Size = Vector3.new(4.6, 0.5, 0.5), Position = Vector3.new(cx + 12, 4, cz - 32), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
	n += 1
	h.ball({ Name = "ScarecrowHead", Size = Vector3.new(1.6, 1.6, 1.6), Position = Vector3.new(cx + 12, 5.6, cz - 32), Color = rgb(235, 200, 120) }, parent)
	P({ Name = "ScarecrowHat", Size = Vector3.new(2.2, 0.3, 2.2), Position = Vector3.new(cx + 12, 6.4, cz - 32), Color = rgb(150, 110, 60), Material = Enum.Material.Fabric, CanCollide = false })
	-- collines douces et lumière chaude
	for k = 1, 3 do
		n += 1
		h.ball({ Name = "FarmHill", Size = Vector3.new(60, 40, 60), Position = Vector3.new(cx - 40 + k * 40, -12, cz - 78), Color = rgb(120, 168, 70), Material = Enum.Material.Grass }, parent)
	end
	local lamp = P({ Name = "FarmLight", Size = Vector3.new(0.6, 0.6, 0.6), Position = Vector3.new(cx, 22, cz - 8), Transparency = 1, CanCollide = false })
	light(lamp, rgb(255, 214, 140), 60, 0.7)
	return n
end

---------------------------------------------------------------- Domaine de Mara : les bois ensorcelés
function Scenery.mara(h, cx, cz, parent, rng)
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	-- arbres morts tordus
	for k = 1, 9 do
		local a = k / 9 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local r = rng:NextNumber(26, 46)
		local x, z = cx + math.sin(a) * r, cz - math.abs(math.cos(a)) * r * 0.9 - 6
		local s = rng:NextNumber(0.9, 1.5)
		P({ Name = "DeadTrunk", Size = Vector3.new(1.6 * s, 11 * s, 1.6 * s), CFrame = CFrame.new(x, 5.5 * s, z) * CFrame.Angles(rng:NextNumber(-0.1, 0.1), 0, rng:NextNumber(-0.12, 0.12)), Color = rgb(52, 40, 52), Material = Enum.Material.Slate })
		for b = 1, 3 do
			P({ Name = "DeadBranch", Size = Vector3.new(0.7, 5.5 * s, 0.7), CFrame = CFrame.new(x, (6 + b * 1.6) * s, z) * CFrame.Angles(0, b * 2.1, 0.9 + b * 0.1) * CFrame.new(0, 2.4 * s, 0), Color = rgb(52, 40, 52), Material = Enum.Material.Slate, CanCollide = false })
		end
	end
	-- champignons lumineux (quelques-uns éclairent)
	local colors = { rgb(190, 110, 255), rgb(90, 235, 235), rgb(255, 110, 200) }
	for k = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(8, 40)
		local x, z = cx + math.sin(a) * r, cz - math.abs(math.cos(a)) * r - 4
		local s = rng:NextNumber(0.8, 1.8)
		local col = colors[(k % #colors) + 1]
		P({ Name = "MushroomStem", Size = Vector3.new(0.7 * s, 1.8 * s, 0.7 * s), Position = Vector3.new(x, 0.9 * s, z), Color = rgb(230, 225, 235), Material = Enum.Material.SmoothPlastic, CanCollide = false })
		n += 1
		local cap = h.ball({ Name = "MushroomCap", Size = Vector3.new(2.6 * s, 1.6 * s, 2.6 * s), Position = Vector3.new(x, 2 * s, z), Color = col, Material = Enum.Material.Neon }, parent)
		if k % 3 == 0 then
			light(cap, col, 14, 0.9)
		end
	end
	-- cimetière
	for k = 1, 10 do
		local x, z = cx - 38 + (k % 5) * 5, cz + 6 + math.floor(k / 5) * 6
		P({ Name = "Tombstone", Size = Vector3.new(2.4, 3.4, 0.7), CFrame = CFrame.new(x, 1.7, z) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.08, 0.08)), Color = rgb(120, 118, 130), Material = Enum.Material.Slate })
	end
	-- mare violette et lucioles
	n += 1
	local pond = cyl(h, { Name = "WitchPond", Color = rgb(150, 70, 230), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false }, parent, 16, 0.3, Vector3.new(cx + 26, 0.5, cz + 4))
	emitter(pond, rgb(220, 255, 140), 6, 2, 3, 0.35, Vector3.new(0, 0.6, 0))
	light(pond, rgb(170, 90, 255), 28, 1.2)
	-- lanterne-lune sur un grand mât
	P({ Name = "MoonPost", Size = Vector3.new(1, 24, 1), Position = Vector3.new(cx - 2, 12, cz - 48), Color = rgb(60, 48, 66), Material = Enum.Material.Metal })
	n += 1
	local moon = h.ball({ Name = "MoonLantern", Size = Vector3.new(6, 6, 6), Position = Vector3.new(cx - 2, 26, cz - 48), Color = rgb(235, 225, 255), Material = Enum.Material.Neon }, parent)
	light(moon, rgb(190, 170, 255), 60, 1.4)
	return n
end

---------------------------------------------------------------- Domaine de Zed : la citadelle de lave
function Scenery.zed(h, cx, cz, parent, rng)
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	-- aiguilles d'obsidienne
	for k = 1, 11 do
		local a = k / 11 * math.pi * 1.3 - 0.15 * math.pi
		local r = rng:NextNumber(32, 52)
		local x, z = cx + math.cos(a) * r, cz - math.sin(a) * r
		local hgt = rng:NextNumber(10, 24)
		P({ Name = "ObsidianSpire", Size = Vector3.new(rng:NextNumber(3, 5), hgt, rng:NextNumber(3, 5)), CFrame = CFrame.new(x, hgt / 2, z) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, 3), rng:NextNumber(-0.12, 0.12)), Color = rgb(36, 32, 44), Material = Enum.Material.Slate })
	end
	-- lacs de lave (braises, lueur)
	for k = 1, 4 do
		local x, z = cx - 30 + k * 15, cz - 16 - (k % 2) * 14
		n += 1
		local lava = cyl(h, { Name = "LavaPool", Color = rgb(255, 110, 30), Material = Enum.Material.Neon, CanCollide = false }, parent, rng:NextNumber(8, 13), 0.3, Vector3.new(x, 0.22, z))
		light(lava, rgb(255, 120, 40), 26, 1.5)
		if k == 2 then
			emitter(lava, rgb(255, 160, 60), 12, 8, 2, 0.5, Vector3.new(0, 4, 0))
		end
	end
	-- tour sombre aux anneaux cyan
	n += 1
	cyl(h, { Name = "TowerBase", Color = rgb(44, 40, 54), Material = Enum.Material.Slate }, parent, 9, 22, Vector3.new(cx + 30, 11, cz - 36))
	for k = 1, 3 do
		n += 1
		local ring = cyl(h, { Name = "TowerRing", Color = rgb(60, 230, 255), Material = Enum.Material.Neon, CanCollide = false }, parent, 9.6, 0.5, Vector3.new(cx + 30, 5 + k * 5.5, cz - 36))
		if k == 3 then
			light(ring, rgb(60, 230, 255), 40, 1.5)
		end
	end
	-- passerelle d'acier
	for k = 0, 5 do
		P({ Name = "BridgePlank", Size = Vector3.new(4, 0.4, 2.2), Position = Vector3.new(cx - 18 + k * 2.5, 0.9, cz + 4), Color = rgb(70, 72, 80), Material = Enum.Material.DiamondPlate })
	end
	return n
end

---------------------------------------------------------------- Chemins en pas japonais
function Scenery.paths(h, parent, cfg)
	local n = 0
	local placed = {}
	local ringR = cfg.Map.plotRadius - 30
	local function stones(ax, az, bx, bz, step)
		local dx, dz = bx - ax, bz - az
		local len = math.sqrt(dx * dx + dz * dz)
		local count = math.floor(len / step)
		for k = 0, count do
			local t = k / math.max(count, 1)
			local x, z = ax + dx * t, az + dz * t
			local free = math.abs(math.sqrt(x * x + z * z) - ringR) > 6 -- jamais sur l'anneau de pavés des bases (même niveau = scintillement)
			for _, o in ipairs(placed) do
				if math.sqrt((x - o[1]) ^ 2 + (z - o[2]) ^ 2) < 5.2 then
					free = false -- aux jonctions de deux segments, pas deux pavés l'un sur l'autre
					break
				end
			end
			if free then
				placed[#placed + 1] = { x, z }
				n += 1
				cyl(h, { Name = "PathStone", Color = rgb(196, 180, 150), Material = Enum.Material.Cobblestone, CanCollide = false }, parent, 4.4, 0.25, Vector3.new(x, 0.18, z))
			end
		end
	end
	for _, poly in ipairs(cfg.Map.paths) do
		for k = 1, #poly - 1 do
			stones(poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2], 16)
		end
	end
	local r = cfg.Map.plotRadius - 30
	for k = 0, 29 do
		local a = k / 30 * math.pi * 2
		n += 1
		cyl(h, { Name = "RingStone", Color = rgb(190, 176, 148), Material = Enum.Material.Cobblestone, CanCollide = false }, parent, 5.2, 0.25, Vector3.new(math.sin(a) * r, 0.18, math.cos(a) * r), a)
	end
	return n
end

---------------------------------------------------------------- Repères lointains (visibles de loin pour s'orienter)
function Scenery.landmarks(h, parent, rng)
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	-- Grand Arbre (sud-ouest)
	P({ Name = "GreatTreeTrunk", Size = Vector3.new(10, 46, 10), Position = Vector3.new(-300, 23, 220), Color = rgb(105, 74, 48), Material = Enum.Material.Wood })
	for k = 1, 5 do
		n += 1
		h.ball({ Name = "GreatTreeLeaves", Size = Vector3.new(52 - k * 4, 40 - k * 3, 52 - k * 4), Position = Vector3.new(-300 + math.sin(k * 1.7) * 12, 52 + (k % 3) * 4, 220 + math.cos(k * 1.7) * 12), Color = rgb(70 + k * 5, 150, 82), Material = Enum.Material.Grass }, parent)
	end
	-- Tour de guet (sud-est)
	for _, c in ipairs({ { -5, -5 }, { 5, -5 }, { -5, 5 }, { 5, 5 } }) do
		P({ Name = "WatchLeg", Size = Vector3.new(1.4, 30, 1.4), Position = Vector3.new(300 + c[1], 15, 230 + c[2]), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
	end
	P({ Name = "WatchDeck", Size = Vector3.new(15, 1.2, 15), Position = Vector3.new(300, 30, 230), Color = rgb(140, 104, 70), Material = Enum.Material.WoodPlanks })
	P({ Name = "WatchRoof", Size = Vector3.new(17, 1, 17), Position = Vector3.new(300, 38, 230), Color = rgb(150, 70, 52), Material = Enum.Material.Wood })
	for _, c in ipairs({ { -7, -7 }, { 7, -7 }, { -7, 7 }, { 7, 7 } }) do
		P({ Name = "WatchPost", Size = Vector3.new(0.8, 8, 0.8), Position = Vector3.new(300 + c[1], 34, 230 + c[2]), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
	end
	local fire = P({ Name = "WatchBeacon", Size = Vector3.new(2, 1, 2), Position = Vector3.new(300, 31.2, 230), Color = rgb(255, 150, 60), Material = Enum.Material.Neon, CanCollide = false })
	light(fire, rgb(255, 170, 80), 50, 1.6)
	-- Arche de pierre (est)
	for _, sx in ipairs({ -9, 9 }) do
		P({ Name = "ArchPillar", Size = Vector3.new(6, 26, 6), Position = Vector3.new(430 + sx, 13, 20), Color = rgb(140, 138, 148), Material = Enum.Material.Slate })
	end
	P({ Name = "ArchTop", Size = Vector3.new(26, 6, 7), Position = Vector3.new(430, 28, 20), Color = rgb(150, 148, 158), Material = Enum.Material.Slate })
	-- Obélisque doré (ouest)
	P({ Name = "ObeliskBase", Size = Vector3.new(10, 3, 10), Position = Vector3.new(-430, 1.5, -20), Color = rgb(150, 146, 140), Material = Enum.Material.Marble })
	P({ Name = "Obelisk", Size = Vector3.new(5, 34, 5), Position = Vector3.new(-430, 20, -20), Color = rgb(255, 214, 120), Material = Enum.Material.Metal })
	local tip = h.ball({ Name = "ObeliskTip", Size = Vector3.new(4, 4, 4), Position = Vector3.new(-430, 38.5, -20), Color = rgb(255, 240, 180), Material = Enum.Material.Neon }, parent)
	n += 1
	light(tip, rgb(255, 224, 140), 70, 1.6)
	return n
end

---------------------------------------------------------------- Relief : monticules et forêt périphérique
function Scenery.relief(h, parent, rng, cfg)
	local n = 0
	local half = cfg.Map.groundSize / 2
	local function clear(x, z)
		for i = 1, #cfg.RIVALS do
			local cx, cz = cfg.rivalCenter(i)
			if math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) < 110 then
				return false
			end
		end
		for _, sct in ipairs(cfg.SECRETS) do
			if math.sqrt((x - sct.x) ^ 2 + (z - sct.z) ^ 2) < 40 then
				return false
			end
		end
		return math.sqrt(x * x + z * z) > 270
	end
	for _ = 1, 34 do -- monticules praticables
		local x, z = rng:NextNumber(-half + 80, half - 80), rng:NextNumber(-half + 80, half - 80)
		if clear(x, z) then
			local sz = rng:NextNumber(36, 90)
			n += 1
			local m = h.ball({ Name = "Mound", Size = Vector3.new(sz, sz * 0.5, sz), Position = Vector3.new(x, -sz * 0.12, z), Color = Color3.fromRGB(86 + rng:NextInteger(0, 18), 150 + rng:NextInteger(0, 16), 80), Material = Enum.Material.Grass }, parent)
			m.CanCollide = true
		end
	end
	for _ = 1, 46 do -- forêt périphérique
		local x, z = rng:NextNumber(-half + 40, half - 40), rng:NextNumber(-half + 40, half - 40)
		if clear(x, z) then
			n += 4
			h.tree(Vector3.new(x, 0, z), parent, rng)
		end
	end
	return n
end

---------------------------------------------------------------- Secrets : un sanctuaire par domaine, fouillable une fois par jour
function Scenery.secrets(h, parent, cfg)
	local n = 0
	for _, sct in ipairs(cfg.SECRETS) do
		local base = Vector3.new(sct.x, 0, sct.z)
		n += 3
		cyl(h, { Name = "ShrineBase", Color = rgb(150, 146, 140), Material = Enum.Material.Marble }, parent, 12, 1.2, base + Vector3.new(0, 0.6, 0))
		h.part({ Name = "ShrinePillar", Size = Vector3.new(2.4, 7, 2.4), Position = base + Vector3.new(0, 4.7, 0), Color = rgb(190, 184, 176), Material = Enum.Material.Marble }, parent)
		local gem = h.ball({ Name = "Secret_" .. sct.id, Size = Vector3.new(3, 3, 3), Position = base + Vector3.new(0, 9.4, 0), Color = rgb(255, 214, 90), Material = Enum.Material.Neon }, parent)
		light(gem, rgb(255, 214, 120), 34, 1.4)
		emitter(gem, rgb(255, 230, 140), 5, 2, 2, 0.4, Vector3.new(0, 1, 0))
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Fouiller"
		pr.ObjectText = sct.emoji .. " " .. sct.name
		pr.HoldDuration = 1
		pr.MaxActivationDistance = 12
		pr.RequiresLineOfSight = false
		pr:SetAttribute("SecretId", sct.id)
		CollectionService:AddTag(pr, "SecretPrompt")
		pr.Parent = gem
		Scenery.marker(h, base + Vector3.new(0, 0.4, 0), parent, "🔍", 14)
		n += 1
	end
	return n
end

return Scenery
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX35"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX34"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX26"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Client
-- Interface 100 % générée par code (aucune image à importer).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Layout"))
local Reveal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Reveal"))
local Easing = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Easing"))
local RevealFx = require(script.Parent:WaitForChild("RevealFx"))
local SlotFx = require(script.Parent:WaitForChild("SlotFx"))
local VfxKitMod = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VfxKit"))
local Vfx = VfxKitMod.new(Config, Easing)
local CoinIcon = require(script.Parent:WaitForChild("CoinIcon"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RState, RNotify, RHatch, RAction = Remotes:WaitForChild("State"), Remotes:WaitForChild("Notify"), Remotes:WaitForChild("Hatch"), Remotes:WaitForChild("Action")
local RTop = Remotes:WaitForChild("Top")
local fmt = Config.fmt

local COL = {
	bg = Color3.fromRGB(15, 42, 27),
	panel = Color3.fromRGB(29, 77, 51),
	pill = Color3.fromRGB(10, 30, 20),
	yellow = Color3.fromRGB(255, 210, 63),
	text = Color3.fromRGB(244, 255, 246),
	muted = Color3.fromRGB(159, 199, 173),
	red = Color3.fromRGB(255, 107, 107),
	green = Color3.fromRGB(91, 227, 125),
	dis = Color3.fromRGB(75, 91, 81),
	dark = Color3.fromRGB(43, 34, 0),
}
local FONT = Enum.Font.GothamBold

local state = nil
local tryOfferLater, lastMilestone = nil, nil -- offre d'achat (définie avec le HUD) ; dernier palier d'éclosions vu
local topData = nil
local panel = nil -- { name, tab, confirm }
local costBtns = {}

---------------------------------------------------------------- Helpers UI
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o)
end
-- Retour tactile : le bouton se rétrécit légèrement quand on appuie.
-- Sons : voir Config.SOUNDS (clé -> { id, speed, vol }). Un id vide ou introuvable reste silencieux.
-- Un seul objet Sound par type (réutilisé), volume = définition x réglage général (menu Plus), rien (hors clics) avant que la carte soit prête,
-- aucune erreur si un son ne se charge pas (tout sous pcall).
local soundPool = {}
local soundReady = false -- vrai à la première réception de l'état du joueur (carte et joueur prêts)
local volumeIdx = 1
local function masterVolume()
	return Config.VOLUME_STEPS[volumeIdx] or 1
end
local function getSound(key)
	local snd = soundPool[key]
	if snd and snd.Parent then
		return snd
	end
	local def = Config.SOUNDS[key]
	if not def or def.id == "" then
		return nil
	end
	local ok, made = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "Sfx_" .. key
		s.SoundId = def.id
		s.PlaybackSpeed = def.speed or 1
		s.Looped = def.loop == true
		s.Parent = game:GetService("SoundService")
		return s
	end)
	if ok then
		soundPool[key] = made
		return made
	end
	return nil
end
local function playSound(key)
	if not soundReady and key ~= "click" and key ~= "menu" then
		return
	end
	local vol = Config.soundVolume(key, masterVolume())
	if vol <= 0 then
		return
	end
	pcall(function()
		local snd = getSound(key)
		if snd then
			snd.Volume = vol
			snd.TimePosition = 0
			snd:Play()
		end
	end)
end
-- Boucle (ambiance, lame, boulet) : factor 0..1 = proximité ; en dessous de 1 % elle s'arrête.
local function setLoop(key, factor)
	pcall(function()
		local vol = Config.soundVolume(key, masterVolume()) * (factor or 1)
		local snd = vol > 0.005 and getSound(key) or soundPool[key]
		if not snd then
			return
		end
		if vol > 0.005 then
			snd.Volume = vol
			if not snd.IsPlaying then
				snd:Play()
			end
		elseif snd.IsPlaying then
			snd:Stop()
		end
	end)
end

local lastPress = 0 -- horodatage du dernier appui : sert à ne pas reconstruire un panneau sous le doigt du joueur
local function pressFx(btn)
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	local function to(v)
		TweenService:Create(sc, TweenInfo.new(0.08), { Scale = v }):Play()
	end
	btn.MouseButton1Down:Connect(function()
		lastPress = os.clock()
		playSound("click")
		to(0.93)
	end)
	btn.MouseButton1Up:Connect(function()
		to(1)
	end)
	btn.MouseLeave:Connect(function()
		to(1)
	end)
end

local function text(parent, props)
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or COL.text
	return make("TextLabel", props, parent)
end

-- Style « cartoon glossy » : contour foncé épais, dégradé, coins très arrondis, reflet. kind = fonction (Config.UI.kinds) : colore le bouton.
-- Sans kind, la couleur existante est gardée (boutons de coût, recolorés selon les pièces). Retourne le style ou nil.
local function glossy(obj, kind, radius, thickness)
	if not Config.UI.glossy then
		return nil
	end
	local st = kind and Config.btnStyle(kind) or nil
	if st then
		obj.BackgroundColor3 = st.base
		obj.BackgroundTransparency = 0
	end
	local cr = obj:FindFirstChildOfClass("UICorner") or make("UICorner", {}, obj)
	cr.CornerRadius = UDim.new(0, radius or 14)
	local stroke = obj:FindFirstChildOfClass("UIStroke") or make("UIStroke", {}, obj)
	stroke.Color = st and st.stroke or Color3.fromRGB(14, 24, 18)
	stroke.Thickness = thickness or 3
	make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(176, 176, 176)), Rotation = 90 }, obj)
	local shine = make("Frame", { Name = "Shine", Size = UDim2.new(1, -12, 0.26, 0), Position = UDim2.fromOffset(6, 3), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0, Active = false }, obj)
	make("UICorner", { CornerRadius = UDim.new(0, math.max(6, (radius or 14) - 4)) }, shine)
	return st
end

local gui = make("ScreenGui", { Name = "ChipeUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets }, player:WaitForChild("PlayerGui"))

-- HUD fixe : conteneur mis à l'échelle (téléphone, tablette, PC) dont tous les éléments sont ancrés aux bords (voir Layout.lua, testé).
-- Les menus (panneau, éclosion) restent hors du conteneur : ils sont temporaires et s'adaptent à l'écran en fractions.
local hudRoot = make("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromOffset(900, 520) }, gui)
local hudScale = make("UIScale", { Scale = 1 }, hudRoot)
local hudParts = {} -- nom de Layout -> objet à placer

local function pill(y, icon, tint)
	local f = make("Frame", { Size = UDim2.fromOffset(196, 52), BackgroundColor3 = COL.pill, BackgroundTransparency = 0.05 }, hudRoot)
	corner(f, 26)
	make("UIStroke", { Color = tint, Thickness = 2, Transparency = 0.15 }, f)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(34, 88, 58), Color3.fromRGB(10, 30, 20)), Rotation = 90 }, f)
	local scale = make("UIScale", { Scale = 1 }, f)
	text(f, { Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(38, 52), Text = icon, TextSize = 28 })
	local big = text(f, { Position = UDim2.fromOffset(50, 4), Size = UDim2.new(1, -56, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 24, Text = "0", TextStrokeTransparency = 0.6 })
	local small = text(f, { Position = UDim2.fromOffset(50, 31), Size = UDim2.new(1, -56, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, TextColor3 = COL.muted, Text = "" })
	return big, small, scale, f
end
local coinsBig, coinsSmall, coinsScale, coinsFrame = pill(8, "🪙", COL.yellow)
local speedBig, speedSmall, _, speedFrame = pill(66, "⚡", Color3.fromRGB(110, 190, 255))
hudParts.pillCoins, hudParts.pillSpeed = coinsFrame, speedFrame
speedSmall.Text = "VITESSE"

local carryLbl = text(hudRoot, { Size = UDim2.fromOffset(170, 26), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 16, Text = "", BackgroundTransparency = 0.2, BackgroundColor3 = COL.pill })
corner(carryLbl, 13)
carryLbl.Visible = false

local banner = text(hudRoot, { Size = UDim2.fromOffset(330, 40), TextWrapped = true, TextSize = 13, TextColor3 = COL.yellow, BackgroundTransparency = 0.12, BackgroundColor3 = COL.pill, Text = "", Visible = false })
corner(banner, 15)
make("UIStroke", { Color = COL.yellow, Thickness = 2 }, banner)

-- Barre de vie (visible seulement quand les pv sont entamés) : rouge dégradé, contour épais, texte « ❤ 86/100 ». Attributs Hp / MaxHp du joueur (serveur).
local hpFrame = make("Frame", { Size = UDim2.fromOffset(170, 22), BackgroundColor3 = Color3.fromRGB(40, 12, 14), Visible = false }, hudRoot)
corner(hpFrame, 11)
make("UIStroke", { Color = Color3.fromRGB(20, 8, 10), Thickness = 3 }, hpFrame)
local hpFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 82, 82) }, hpFrame)
corner(hpFill, 11)
make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)), Rotation = 90 }, hpFill)
local hpText = text(hpFrame, { Size = UDim2.fromScale(1, 1), TextSize = 12, Text = "", TextStrokeTransparency = 0.3, ZIndex = 3 })
hudParts.hp = hpFrame
local function refreshHp()
	local hp, maxHp = player:GetAttribute("Hp"), player:GetAttribute("MaxHp")
	if type(hp) ~= "number" or type(maxHp) ~= "number" or maxHp <= 0 then
		hpFrame.Visible = false
		return
	end
	hpFrame.Visible = hp < maxHp
	hpText.Text = "❤ " .. hp .. "/" .. maxHp
	TweenService:Create(hpFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1) }):Play()
end
player:GetAttributeChangedSignal("Hp"):Connect(refreshHp)
player:GetAttributeChangedSignal("MaxHp"):Connect(refreshHp)

local toasts = make("Frame", { Size = UDim2.fromOffset(240, 76), BackgroundTransparency = 1, ClipsDescendants = false }, hudRoot)
make("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, toasts)

local hint = text(hudRoot, { Size = UDim2.fromOffset(260, 44), TextSize = 14, TextColor3 = COL.dark, BackgroundColor3 = COL.yellow, BackgroundTransparency = 0, TextWrapped = true, Text = "", Visible = false })
corner(hint, 12)

local function toast(msg)
	for _, c in ipairs(toasts:GetChildren()) do
		if c:IsA("TextLabel") and #toasts:GetChildren() > 3 then
			c:Destroy()
			break
		end
	end
	local accent = COL.panel
	if msg:find("^🌟") then
		accent = COL.yellow
	elseif msg:find("^😡") or msg:find("^🐕") or msg:find("^🥷") or msg:find("Pas assez") or msg:find("Sac plein") or msg:find("Base pleine") then
		accent = COL.red
	elseif msg:find("^🎯") or msg:find("^🎁") or msg:find("^🌅") or msg:find("^⭐") then
		accent = COL.green
	end
	local t = text(toasts, { Size = UDim2.new(1, 0, 0, 30), TextSize = 14, Text = msg, BackgroundColor3 = COL.pill, BackgroundTransparency = 0.08, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y })
	corner(t, 10)
	make("UIStroke", { Color = accent, Thickness = 1.5 }, t)
	make("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, t)
	local sc = make("UIScale", { Scale = 0.6 }, t)
	TweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	Debris:AddItem(t, 3.2)
end

---------------------------------------------------------------- Pop d'éclosion
local pop = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.fromOffset(340, 240), BackgroundTransparency = 1, Visible = false, ZIndex = 10 }, gui)
local popScale = make("UIScale", { Scale = 1 }, pop)
local popRarity = text(pop, { Size = UDim2.new(1, 0, 0, 30), TextSize = 22, Text = "", TextStrokeTransparency = 0 })
local popEmoji = text(pop, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 110), TextSize = 96, Text = "" })
local popName = text(pop, { Position = UDim2.fromOffset(0, 142), Size = UDim2.new(1, 0, 0, 36), TextSize = 28, Text = "", TextStrokeTransparency = 0 })
local popInfo = text(pop, { Position = UDim2.fromOffset(0, 180), Size = UDim2.new(1, 0, 0, 28), TextSize = 20, Text = "", TextStrokeTransparency = 0 })
local popOdds = text(pop, { Position = UDim2.fromOffset(0, 208), Size = UDim2.new(1, 0, 0, 24), TextSize = 16, Text = "", TextColor3 = COL.muted, TextStrokeTransparency = 0.4 })
local popToken = 0
local flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 }, gui)

-- Effets 3D (VfxKit) : modèles d'effets publiés par le serveur dans ReplicatedStorage.VfxTemplates ; qualité Basse sur tactile (3 effets simultanés
-- au plus, 40 particules par émetteur, pas de faisceau) ; un modèle absent ou une erreur = l'effet est simplement sauté.
local function vfxEnv()
	return {
		clone = function(key)
			local folder = ReplicatedStorage:FindFirstChild("VfxTemplates")
			local t = folder and folder:FindFirstChild(key)
			return t and t:Clone() or nil
		end,
		tween = TweenService, debris = Debris, parent = workspace, delay = task.delay, color = Color3.fromRGB,
	}
end
local function padCFrame(slot)
	local pc = player:GetAttribute("PlotCF")
	if typeof(pc) == "CFrame" and type(slot) == "number" then
		local lx, lz = Config.padLocal(slot)
		return pc * CFrame.new(lx, 0.4, lz)
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and (root.CFrame * CFrame.new(0, -2.6, -6)) or nil
end
local function playVfxAt(names, tier, cf)
	if not Config.animEnabled("vfx3d") or not cf then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local q = VfxKitMod.quality(touch, Config.VFX.quality)
	for _, name in ipairs(names) do
		if not Vfx.admit(Vfx.active, q) then
			break
		end
		local plan = Vfx.plan(name, tier, q, 1)
		if plan then
			Vfx.play(vfxEnv(), plan, cf)
		end
	end
end
local function playHatchVfx(info, tier, secret)
	if not Config.animEnabled("vfx3d") then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local q = VfxKitMod.quality(touch, Config.VFX.quality)
	local cf = padCFrame(info.slot)
	if not cf then
		return
	end
	for _, plan in ipairs(Vfx.hatchPlans(tier, secret, q, Vfx.active)) do
		Vfx.play(vfxEnv(), plan, cf)
	end
end

-- Animations d'interface (Config.Animations.uiFx / pulse) : balayage de brillance sur le bandeau de rareté, flash de vignette coloré, pulsation légère de
-- ColorCorrection et Bloom. Tout sous pcall, nettoyé par Debris ; coupé sur demande.
local function shineSweep(label, tint)
	if not Config.animEnabled("uiFx") then
		return
	end
	pcall(function()
		label.ClipsDescendants = true
		local shine = make("Frame", { Name = "Shine", Size = UDim2.new(0.18, 0, 1.6, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(Easing.shineX(0), 0.5), Rotation = 18, BackgroundColor3 = tint or Color3.new(1, 1, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 5 }, label)
		TweenService:Create(shine, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(Easing.shineX(1), 0.5), BackgroundTransparency = 1 }):Play()
		Debris:AddItem(shine, 1.1)
	end)
end
local function vignetteFlash(color, strength)
	if not Config.animEnabled("uiFx") then
		return
	end
	pcall(function()
		local g = make("ScreenGui", { Name = "UiFxVignette", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 40 }, player:WaitForChild("PlayerGui"))
		local function edge(anchor, pos, size, rot)
			local f = make("Frame", { AnchorPoint = anchor, Position = pos, Size = size, BackgroundColor3 = color, BackgroundTransparency = 1 - 0.55 * strength, BorderSizePixel = 0, Active = false }, g)
			make("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
			TweenService:Create(f, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
		end
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.22), 90)
		edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.22), -90)
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.16, 1), 0)
		edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.16, 1), 180)
		Debris:AddItem(g, 1)
	end)
end
local function pulseLighting(strength)
	if not Config.animEnabled("pulse") then
		return
	end
	pcall(function()
		local Lighting = game:GetService("Lighting")
		local bloom, grade = Lighting:FindFirstChild("ChipeBloom"), Lighting:FindFirstChild("ChipeGrade")
		if bloom and bloom:IsA("BloomEffect") and not bloom:GetAttribute("Pulsing") then
			local base = bloom.Intensity
			bloom:SetAttribute("Pulsing", true)
			TweenService:Create(bloom, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Intensity = base + 0.5 * strength }):Play()
			task.delay(0.2, function()
				TweenService:Create(bloom, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Intensity = base }):Play()
				task.delay(1, function()
					bloom.Intensity = base
					bloom:SetAttribute("Pulsing", nil)
				end)
			end)
		end
		if grade and grade:IsA("ColorCorrectionEffect") and not grade:GetAttribute("Pulsing") then
			local base = grade.Brightness
			grade:SetAttribute("Pulsing", true)
			TweenService:Create(grade, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Brightness = base + 0.07 * strength }):Play()
			task.delay(0.2, function()
				TweenService:Create(grade, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Brightness = base }):Play()
				task.delay(1, function()
					grade.Brightness = base
					grade:SetAttribute("Pulsing", nil)
				end)
			end)
		end
	end)
end

-- Montée de niveau de la base : pilier de lumière, aura runique et onde de choc au centre de la base (VfxKit), message du serveur en plus.
do
	local lastBaseLevel = nil
	local function onBaseLevel()
		local lv = player:GetAttribute("BaseLevel")
		if type(lv) ~= "number" then
			return
		end
		local previous = lastBaseLevel
		lastBaseLevel = lv
		if previous and lv > previous then
			local pc = player:GetAttribute("PlotCF")
			if typeof(pc) == "CFrame" then
				pcall(playVfxAt, { "pilier_revelation", "aura_runique", "onde_de_choc" }, math.min(6, math.max(2, lv - 1)), pc * CFrame.new(0, 1.2, 0))
			end
		end
	end
	player:GetAttributeChangedSignal("BaseLevel"):Connect(onBaseLevel)
	onBaseLevel()
end

local function revealPop(info)
	local def = Config.PETS[info.p]
	if def.tier >= 4 and tryOfferLater then
		tryOfferLater("rare")
	end
	local tier = Config.TIERS[def.tier]
	popToken += 1
	local token = popToken
	popEmoji.Text = def.emoji
	popEmoji.Rotation = -14
	TweenService:Create(popEmoji, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	popRarity.Text = def.tier >= 4 and ("★ " .. string.upper(tier.name) .. " ★") or string.upper(tier.name)
	popRarity.TextColor3 = tier.color
	popRarity.TextSize = def.tier >= 4 and 28 or 20
	popName.Text = Config.petName(info.p, info.s, info.m)
	popName.TextColor3 = tier.color
	popInfo.Text = tier.name .. "  ·  +" .. fmt(info.inc) .. "/s"
	pop.Visible = true
	popScale.Scale = 0.2
	-- Révélation par rareté : style calculé (Reveal.style) d'après la rareté et la probabilité réelle « 1 sur N » envoyée par le serveur.
	local oneIn = type(info.oneIn) == "number" and info.oneIn > 0 and info.oneIn or nil
	popOdds.Text = oneIn and Config.fmtOdds(oneIn) or ""
	local reduced = Config.REVEAL.forceReduced or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
	local st = Reveal.style(Config, def.tier, oneIn, reduced)
	if info.upgraded == true and Config.TIERS[info.egg] then
		popRarity.Text = "⬆ AMÉLIORÉ ! " .. Config.TIERS[info.egg].name .. " → " .. tier.name
		popRarity.TextSize = 22
	end
	if st.secret then
		popRarity.Text = "✦ " .. st.label .. " ✦"
		popRarity.TextColor3 = st.color
		popRarity.TextSize = 26
	end
	if Config.REVEAL.Enabled then
		RevealFx.play(gui, st, UDim2.new(0.5, 0, 0.3, -35))
	end
	local big = def.tier >= 4 or info.m > 1 or info.s >= 4
	if st.flash > 0 then
		flash.BackgroundColor3 = Config.MUTS[info.m].color or st.color
		flash.BackgroundTransparency = 1 - 0.7 * st.flash
		TweenService:Create(flash, TweenInfo.new(0.35 + 0.5 * st.flash), { BackgroundTransparency = 1 }):Play()
	end
	playSound(Config.hatchSoundKey(def.tier, st.secret))
	pcall(playHatchVfx, info, def.tier, st.secret) -- effets 3D en plus de la révélation en interface, selon la qualité
	if def.tier >= 3 then -- rareté croissante : brillance sur le bandeau dès Épique, vignette colorée et pulsation dès Légendaire
		shineSweep(popRarity, tier.color:Lerp(Color3.new(1, 1, 1), 0.6))
		if def.tier >= 4 or st.secret then
			vignetteFlash(st.secret and st.color or tier.color, math.min(1, 0.4 + 0.15 * def.tier))
			pulseLighting(math.min(1.5, 0.5 + 0.2 * def.tier))
		end
	end
	if st.shake > 0.2 then -- secousse de la caméra proportionnelle à la rareté
		task.spawn(function()
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hum then
				return
			end
			local frames = math.floor(8 + 12 * st.shake)
			for k = 1, frames do
				local amp = 0.8 * st.shake * (1 - k / frames)
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0)
				task.wait(0.03)
			end
			hum.CameraOffset = Vector3.zero
		end)
	end
	TweenService:Create(popScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(st.secret and 3.4 or 2.6, function()
		if token == popToken then
			pop.Visible = false
		end
	end)
end

---------------------------------------------------------------- Promesse d'accueil : visible tout de suite, ne bloque rien
-- Une carte compacte (titre, promesse, bouton vert « Jouer ») en haut au centre pendant Config.PROMISE.seconds ; le joueur peut agir pendant ce temps
-- (l'œuf de départ éclot en quelques secondes). Une seule fois par session.
local function showPromise()
	local card = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -140), Size = UDim2.fromOffset(340, 104), BackgroundColor3 = COL.bg, ZIndex = 30 }, gui)
	corner(card, 20)
	make("UIStroke", { Color = Color3.fromRGB(14, 24, 18), Thickness = 4 }, card)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(70, 160, 110), Color3.fromRGB(20, 60, 40)), Rotation = 90 }, card)
	text(card, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 30), Text = "🥚 " .. Config.TITLE, TextSize = 24, TextColor3 = COL.yellow, TextStrokeTransparency = 0.3, ZIndex = 31 })
	text(card, { Position = UDim2.fromOffset(12, 36), Size = UDim2.new(1, -24, 0, 36), Text = Config.TAGLINE, TextSize = 13, TextWrapped = true, ZIndex = 31 })
	local play = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.fromOffset(120, 28), Text = Config.PROMISE.button, Font = FONT, TextSize = 15, ZIndex = 32 }, card)
	local st = glossy(play, "play", 12, 2)
	if st then
		play.TextColor3 = st.text
	end
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -140) }):Play()
		Debris:AddItem(card, 0.5)
	end
	play.Activated:Connect(close)
	TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 10) }):Play()
	task.delay(Config.PROMISE.seconds, close)
end

---------------------------------------------------------------- Introduction (nouveaux joueurs uniquement)
local introChecked = false
