-- Titre « Ami de la Mère Poule » : 7 fragments du Grand Œuf cumulés (puzzle.fragments). Config.titles (24 titres de succès) reste INCHANGÉE pour ne pas
-- casser ses tests ; Config.allTitles lui ajoute ce titre (25e), c'est elle que lit l'onglet Titres.
Config.TITLE_HEN = { id = "hen", name = "🐔 Ami de la Mère Poule", desc = "7 fragments du Grand Œuf" }
function Config.allTitles(stats)
	local out = Config.titles(stats)
	local frags = stats and stats.fragments
	out[#out + 1] = { id = Config.TITLE_HEN.id, name = Config.TITLE_HEN.name, desc = Config.TITLE_HEN.desc, unlocked = type(frags) == "number" and frags >= Config.HEN.fragmentsForEgg }
	return out
end

-- LOT 9b : calendrier des œufs sur 30 jours. Le SERVEUR décide du jour (UTC) ; le client ne désigne que la carte qu'il veut réclamer. Un jour = une carte.
--   dayCap = réclamations au plus par jour UTC (le jour en cours + 1 rattrapage) ; monthCap = récompenses au plus par cycle de 30 jours (rattrapages compris).
--   Jour de grâce : 1 jour manqué pardonné (gratuit) toutes les `graceEvery` jours (gagné dès le jour 1, puis aux jours 8, 15, 22, 29). Rattrapage : jour de grâce,
--   `catchupQuests` missions réclamées (compteur cal.qc), ou 1 jeton payant (CalendarCatchup, 29 R$). Éligibilité : compte Roblox de `minAccountAgeDays` jour(s) et
--   `minPlayMinutes` min de jeu cumulées (le cycle démarre alors). Récompense d'une carte : c = minutes de revenu en pièces (au moins coinFloor), egg = rareté de l'œuf
--   (placé dans la base : réclamation refusée si elle est pleine), scrolls (parchemins), plumes, tokens (jetons de combat), cosm (cosmétique), title (titre), draw = tirage J30.
Config.CALENDAR = {
	days = 30, dayCap = 2, monthCap = 30, graceEvery = 7, minAccountAgeDays = 1, minPlayMinutes = 10, catchupQuests = 3, catchupMax = 5, coinFloor = 500,
	legendaryDay = 3, milestones = { 3, 7, 10, 14, 17, 20, 25, 28, 30 },
	caps = { scrolls = 9999, plumes = 9999, tokens = 99 },
	-- Tirage du jour 30 (affiché sur la carte, vérifié sur 1 000 000 tirages à +-0,3 point) : œuf de rareté fixe. Décision : 40 % Légendaire, 45 % Mythique, 15 % Ultra Rare.
	draw = { { tier = 5, pct = 40 }, { tier = 6, pct = 45 }, { tier = 7, pct = 15 } },
	cosmetics = { ribbon = { name = "Ruban doré", emoji = "🎀" }, cape = { name = "Cape du Couvoir", emoji = "🧣" }, aura = { name = "Aura de braise", emoji = "🔥" }, crown = { name = "Couronne de plumes", emoji = "👑" } },
	titles = { cal10 = { name = "📅 Habitué du Couvoir", desc = "Jour 10 du calendrier" }, cal25 = { name = "📅 Fidèle du Couvoir", desc = "Jour 25 du calendrier" }, cal30 = { name = "📅 Maître du Calendrier", desc = "Les 30 jours du calendrier" } },
	rewards = {
		{ egg = 1, scrolls = 1 }, { c = 8, tokens = 1 }, { egg = 5, plumes = 1 }, { c = 10, scrolls = 1 }, { scrolls = 2, plumes = 1 }, { c = 12, tokens = 1 }, { egg = 3, cosm = "ribbon" },
		{ c = 12 }, { scrolls = 2, tokens = 1 }, { c = 25, plumes = 2, title = "cal10" }, { c = 15 }, { scrolls = 2 }, { tokens = 2, c = 15 }, { egg = 4, cosm = "cape" },
		{ c = 20, plumes = 1 }, { scrolls = 3 }, { tokens = 2, plumes = 2, c = 25 }, { c = 25 }, { scrolls = 3, tokens = 1 }, { egg = 6, cosm = "aura" },
		{ c = 30 }, { plumes = 2, scrolls = 2 }, { c = 35, tokens = 2 }, { scrolls = 3 }, { egg = 5, title = "cal25", plumes = 3 }, { c = 40 }, { tokens = 3, scrolls = 3 },
		{ cosm = "crown", plumes = 3, c = 60 }, { c = 60, scrolls = 4 }, { draw = true, title = "cal30", c = 120, plumes = 5 },
	},
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Easing</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Easing
-- Fonctions d'animation PURES (aucun service Roblox, aucun Instance) : courbes, squash & stretch, rebonds, clignements, regards,
-- paramètres de confettis et garde-fou d'exécution. Testées hors de Roblox (tests/run.luau). Le client (Animations.client.lua)
-- ne fait qu'appliquer ces valeurs aux objets.
local Easing = {}

local pi, sin, cos, exp, abs, floor, sqrt = math.pi, math.sin, math.cos, math.exp, math.abs, math.floor, math.sqrt

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end
Easing.clamp01 = clamp01

local function frac(x)
	return x - floor(x)
end

-- Direction de déplacement unitaire (dx, dz) d'un objet qui a parcouru (dx, dz) en dt secondes, ou nil s'il va plus lentement que minSpeed (studs/s) : il garde
-- alors son orientation. Sert à tourner les pets suiveurs vers leur direction de marche.
function Easing.travelDir(dx, dz, dt, minSpeed)
	if type(dx) ~= "number" or type(dz) ~= "number" or type(dt) ~= "number" or dt <= 0 or dx ~= dx or dz ~= dz then
		return nil
	end
	local d = sqrt(dx * dx + dz * dz)
	if d / dt < (minSpeed or 1.5) or d < 1e-9 then
		return nil
	end
	return dx / d, dz / d
end

function Easing.lerp(a, b, t)
	return a + (b - a) * t
end

-- Animations d'interface -------------------------------------------------------------------------------------------------------
-- Compteur qui défile : rapproche `shown` de `target` (approche exponentielle, jamais de dépassement, arrêt exact). dt en secondes.
function Easing.rollTo(shown, target, dt)
	if type(shown) ~= "number" or shown ~= shown then
		return type(target) == "number" and target == target and target or 0
	end
	if type(target) ~= "number" or target ~= target then
		return shown
	end
	local diff = target - shown
	if math.abs(diff) <= math.max(1, math.abs(target) * 0.0005) then
		return target
	end
	local k = 1 - exp(-(dt or 1 / 30) * 9)
	local nextValue = shown + diff * k
	if (diff > 0 and nextValue > target) or (diff < 0 and nextValue < target) then
		return target
	end
	return nextValue
end

-- Balayage de brillance : position horizontale (fraction de la largeur, de -0,25 à 1,25) à la progression p.
function Easing.shineX(p)
	p = clamp01(p)
	return -0.25 + 1.5 * (1 - (1 - p) * (1 - p))
end

-- Pulsation unique (montée rapide, descente douce) : 0 -> 1 -> 0 sur p dans [0, 1].
function Easing.pulse(p)
	p = clamp01(p)
	if p < 0.2 then
		return 1 - (1 - p / 0.2) ^ 2
	end
	local e = (p - 0.2) / 0.8
	return (1 - e) ^ 2
end

-- Courbes classiques (entrée et sortie dans [0, 1]) ---------------------------------------------------------------
function Easing.inOutSine(x)
	x = clamp01(x)
	return -(cos(pi * x) - 1) / 2
end

function Easing.outQuad(x)
	x = clamp01(x)
	return 1 - (1 - x) * (1 - x)
end

function Easing.outBack(x)
	x = clamp01(x)
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

function Easing.outElastic(x)
	x = clamp01(x)
	if x == 0 or x == 1 then
		return x
	end
	return 2 ^ (-10 * x) * sin((x * 10 - 0.75) * (2 * pi) / 3) + 1
end

function Easing.outBounce(x)
	x = clamp01(x)
	local n1, d1 = 7.5625, 2.75
	if x < 1 / d1 then
		return n1 * x * x
	elseif x < 2 / d1 then
		x = x - 1.5 / d1
		return n1 * x * x + 0.75
	elseif x < 2.5 / d1 then
		x = x - 2.25 / d1
		return n1 * x * x + 0.9375
	end
	x = x - 2.625 / d1
	return n1 * x * x + 0.984375
end

-- Squash & stretch : au temps t (0 -> 1), retourne (sx, sy) à appliquer en largeur et en hauteur.
-- Part écrasé (sy < 1, sx > 1), puis s'étire, puis oscille de moins en moins jusqu'à (1, 1). Toujours strictement positif.
function Easing.squashStretch(t, strength)
	if t >= 1 then
		return 1, 1
	end
	if t < 0 then
		t = 0
	end
	local amp = (strength or 0.4) * exp(-5 * t) * cos(14 * t)
	return math.max(0.2, 1 + amp * 0.6), math.max(0.2, 1 - amp)
end

-- Petit saut d'un œuf toutes les `period` secondes. Retourne (décalage vertical >= 0, sx, sy).
-- Étirement en l'air, écrasement à l'atterrissage ; hors du saut : (0, 1, 1).
function Easing.eggHop(time, phase, height, period)
	period = period or 3.2
	height = height or 0.6
	local u = ((time + (phase or 0)) % period) / 0.6 -- le saut dure 0,6 s
	if u >= 1 then
		return 0, 1, 1
	end
	local y = height * sin(u * pi)
	local sy = 1 + 0.15 * sin(u * pi)
	if u > 0.85 then
		sy = 1 - 0.12 * sin((u - 0.85) / 0.15 * pi)
	end
	return y, 1 / sqrt(sy), sy
end

-- Balancement d'un œuf porté pendant la course (décalage vertical >= 0).
function Easing.runBounce(time, moving)
	if not moving then
		return 0
	end
	return 0.25 * abs(sin(time * 8))
end

-- Clignement : 1 = œil ouvert, 0 = fermé. Bref (0,16 s) à intervalle irrégulier propre à chaque `seed`.
function Easing.blinkOpenness(time, seed)
	seed = seed or 0
	local period = 2.6 + (seed % 7) * 0.37
	local ph = (time + seed * 0.53) % period
	local d = 0.16
	if ph < d then
		return clamp01(1 - sin(ph / d * pi)) -- bornée : sin(pi) vaut ±1e-16 selon le moteur
	end
	return 1
end

-- Regard : décalage (dx, dy) des yeux, dx dans [-0.85, 0.85], dy dans [-0.3, 0.3].
function Easing.look(time, seed)
	seed = seed or 0
	local dx = sin(time * 0.7 + seed) * 0.6 + sin(time * 1.9 + seed * 2) * 0.25
	local dy = sin(time * 0.5 + seed * 3) * 0.3
	return dx, dy
end

-- Bouche : ouverture dans [0, 1] ; elle « mâche » brièvement de temps en temps.
function Easing.mouthOpen(time, seed)
	seed = seed or 0
	local period = 4 + (seed % 5) * 0.6
	local ph = (time + seed * 0.9) % period
	if ph < 0.7 then
		return sin(ph / 0.7 * pi)
	end
	return 0
end

-- Poule : coups de bec doubles à intervalle irrégulier. Retourne l'enfoncement de la tête dans [0, 1].
function Easing.peck(time, seed)
	seed = seed or 0
	local period = 3.4 + (seed % 5) * 0.5
	local ph = (time + seed * 0.7) % period
	if ph < 0.25 then
		return clamp01(sin(ph / 0.25 * pi))
	elseif ph < 0.5 then
		return clamp01(sin((ph - 0.25) / 0.25 * pi))
	end
	return 0
end

-- Pulsation d'une barrière de zone, dans [0, 1].
-- Échelle du pet qui apparaît à l'éclosion (a = progression 0..1) : part de 25 %, ne dépasse jamais `cap` et vaut exactement 1 à la fin.
function Easing.popScale(a, squash, cap)
	cap = cap or 1.15
	if a >= 1 then
		return 1
	end
	local scale
	if squash then
		local _, sy = Easing.squashStretch(a, 0.45)
		scale = (0.25 + 0.75 * Easing.outQuad(math.min(1, a * 1.8))) * sy
	else
		scale = 0.25 + 0.75 * Easing.outBack(a)
	end
	return math.min(cap, math.max(0.05, scale))
end

-- États des pets : idle (respiration), move (bonds penchés vers l'avant), ability (saut en vrille). Retourne { y, pitch, yaw, scale } ;
-- state "ability" attend p = progression 0..1 de la capacité (Easing.abilityProgress). Toutes les valeurs sont bornées.
function Easing.petPose(state, t, seed, p)
	seed = seed or 0
	if state == "move" then
		return { y = abs(sin(t * 9 + seed)) * 0.7, pitch = -0.18, yaw = sin(t * 9 + seed) * 0.08, scale = 1 }
	elseif state == "ability" then
		local q = clamp01(p or 0)
		return { y = sin(q * pi) * 1.8, pitch = 0, yaw = q * 2 * pi, scale = 1 + 0.25 * sin(q * pi) }
	end
	return { y = sin(t * 3 + seed) * 0.25, pitch = 0, yaw = sin(t * 0.8 + seed) * 0.12, scale = 1 }
end

-- Progression 0..1 de la capacité d'un pet (durée `window` s toutes les `interval` s environ, décalée par seed), nil hors capacité.
function Easing.abilityProgress(t, seed, interval, window)
	window = window or 1.1
	local period = (interval or 9) + ((seed or 0) % 5)
	if period <= window then
		return nil
	end
	local phase = (t + (seed or 0) * 1.3) % period
	if phase < window then
		return phase / window
	end
	return nil
end

function Easing.gatePulse(time, speed)
	return 0.5 + 0.5 * sin(time * (speed or 2))
end

-- Récompenses : effets de confettis selon la clé de son envoyée avec la notification serveur. nil = pas de confettis.
Easing.REWARD = {
	claim = { count = 24, minSpeed = 160, maxSpeed = 340, life = 1.3 },
	event = { count = 40, minSpeed = 180, maxSpeed = 380, life = 1.5 },
	rare = { count = 70, minSpeed = 200, maxSpeed = 440, life = 1.7 },
	levelup = { count = 60, minSpeed = 190, maxSpeed = 420, life = 1.8 }, -- montée de niveau de la maison
}
function Easing.rewardBurst(sfx)
	return Easing.REWARD[sfx]
end

-- Secousse de caméra (champ de vision) selon la clé de son : delta en degrés, durée d'un aller en secondes.
Easing.FOV_KICK = {
	steal = { delta = 5, time = 0.14 },
	caught = { delta = -8, time = 0.2 },
}

-- Particule `i` d'une salve de `count` confettis : éventail vers le haut, déterministe (suite de la section d'or).
-- Retourne { angle (radians, 0 = droite, -pi/2 = haut), speed, spin (degrés/s), hue [0,1), w, h (pixels) }.
function Easing.confettiParticle(i, count, burst)
	local minSpeed, maxSpeed = burst.minSpeed, burst.maxSpeed
	return {
		angle = -pi / 2 + (frac(i * 0.6180339887) - 0.5) * 1.8,
		speed = minSpeed + frac(i * 0.7548776662) * (maxSpeed - minSpeed),
		spin = (frac(i * 0.5698402910) - 0.5) * 720,
		hue = frac(i * 0.3819660113 + count * 0.01),
		w = 6 + floor(frac(i * 0.2599) * 7),
		h = 10 + floor(frac(i * 0.4143) * 9),
	}
end

-- Garde-fou d'une animation. isEnabled(name) -> bool ; failed : table partagée name -> true ; fn : l'animation (appelée sous pcall).
-- Une animation désactivée n'est pas exécutée. Une animation qui lève une erreur est désactivée pour le reste de la session
-- (onError(name, err) est appelé une seule fois). Retourne true si fn s'est exécutée sans erreur.
function Easing.guard(isEnabled, failed, name, fn, onError)
	if failed[name] or not isEnabled(name) then
		return false
	end
	local ok, err = pcall(fn)
	if not ok then
		failed[name] = true
		if onError then
			onError(name, err)
		end
	end
	return ok
end

return Easing
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Cinema</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Cinema
-- Logique PURE des cinématiques (aucun service Roblox, aucune Instance) : séquences de plans, lecteur à états (lecture, skip, abandon,
-- reprise), interpolation de caméra, directeur qui enchaîne une file. Easing est injecté : require(Cinema).new(Easing).
-- Le client (Cinematics.client.lua) ne fait qu'appliquer ces valeurs à la caméra.
local Cinema = {}

function Cinema.new(Easing)
	local C = {}

	-- Construit une séquence à partir de { id, shots = { { dur = secondes, ... }, ... } }.
	-- Retourne nil et un message si la définition est invalide (aucun plan, durée <= 0).
	function C.sequence(def)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucun plan"
		end
		local starts, t = {}, 0
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur <= 0 then
				return nil, "durée invalide (plan " .. i .. ")"
			end
			starts[i] = t
			t = t + shot.dur
		end
		return { id = def.id, shots = def.shots, starts = starts, total = t }
	end

	-- Plan actif à l'instant t (secondes depuis le début) : (index, progression dans [0, 1[), ou nil si la séquence est terminée.
	-- Un temps négatif est ramené à 0.
	function C.shotAt(seq, t)
		if t < 0 then
			t = 0
		end
		if t >= seq.total then
			return nil
		end
		for i = #seq.shots, 1, -1 do
			if t >= seq.starts[i] then
				return i, (t - seq.starts[i]) / seq.shots[i].dur
			end
		end
		return 1, 0
	end

	local function lerp3(a, b, e)
		return { a[1] + (b[1] - a[1]) * e, a[2] + (b[2] - a[2]) * e, a[3] + (b[3] - a[3]) * e }
	end

	-- Position et point visé de la caméra pour la progression p du plan (repère de l'ancre), avec adoucissement.
	function C.cameraAt(shot, p)
		local e = Easing.inOutSine(Easing.clamp01(p))
		return lerp3(shot.pos, shot.toPos or shot.pos, e), lerp3(shot.look, shot.toLook or shot.look, e)
	end

	-- Lecteur d'une séquence. États : idle -> playing -> done (raison : completed | skipped | aborted). play() redémarre à zéro (reprise).
	function C.player(seq)
		local P = { state = "idle", reason = nil, startedAt = 0, lastShot = 0 }
		function P.play(now)
			P.state, P.reason, P.startedAt, P.lastShot = "playing", nil, now, 0
		end
		function P.isPlaying()
			return P.state == "playing"
		end
		-- À appeler à chaque image. nil si rien ne joue ; sinon { shot, progress, shotChanged, finished, reason }.
		-- L'événement `finished` n'est renvoyé qu'une seule fois.
		function P.update(now)
			if P.state ~= "playing" then
				return nil
			end
			local i, p = C.shotAt(seq, now - P.startedAt)
			if not i then
				P.state, P.reason = "done", "completed"
				return { finished = true, reason = "completed" }
			end
			local changed = i ~= P.lastShot
			P.lastShot = i
			return { shot = i, progress = p, shotChanged = changed, finished = false }
		end
		function P.skip()
			if P.state == "playing" then
				P.state, P.reason = "done", "skipped"
				return true
			end
			return false
		end
		function P.abort()
			if P.state == "playing" then
				P.state, P.reason = "done", "aborted"
				return true
			end
			return false
		end
		return P
	end

	-- Directeur : une seule cinématique à la fois. Une demande « chain » pendant une lecture est mise en file (intro puis tutoriel) ;
	-- une autre demande est refusée (jamais de cinématique superposée). Une cinématique ne démarre jamais seule en plein jeu.
	function C.director()
		local D = { current = nil, queue = {} }

		local function startNext(now)
			local nxt = table.remove(D.queue, 1)
			if nxt then
				D.current = { id = nxt.id, seq = nxt.seq, player = C.player(nxt.seq) }
				D.current.player.play(now)
			end
		end

		-- Retourne "playing", "queued" ou "refused".
		function D.request(id, seq, now, chain)
			if D.current and D.current.player.isPlaying() then
				if chain then
					D.queue[#D.queue + 1] = { id = id, seq = seq }
					return "queued"
				end
				return "refused"
			end
			D.current = { id = id, seq = seq, player = C.player(seq) }
			D.current.player.play(now)
			return "playing"
		end

		-- Retourne (id, événement). À la fin d'une séquence, la suivante de la file démarre ; l'événement `finished` est renvoyé une fois.
		function D.update(now)
			local cur = D.current
			if not cur then
				return nil
			end
			local ev = cur.player.update(now)
			if ev and ev.finished then
				D.current = nil
				startNext(now)
			end
			return cur.id, ev
		end

		-- Passe la séquence en cours (la file continue). Retourne l'id passé, ou nil si rien ne jouait.
		function D.skip(now)
			local cur = D.current
			if cur and cur.player.skip() then
				D.current = nil
				startNext(now)
				return cur.id
			end
			return nil
		end

		-- Passe tout : la séquence en cours et la file. Retourne la liste des identifiants passés.
		function D.skipAll()
			local ids = {}
			local cur = D.current
			if cur and cur.player.skip() then
				ids[#ids + 1] = cur.id
			end
			for _, q in ipairs(D.queue) do
				ids[#ids + 1] = q.id
			end
			D.current, D.queue = nil, {}
			return ids
		end

		-- Abandon (mort, attaque, erreur) : tout s'arrête, la file est vidée, rien n'est considéré comme vu.
		function D.abort()
			local cur = D.current
			if cur then
				cur.player.abort()
			end
			D.current, D.queue = nil, {}
		end

		function D.isActive()
			return D.current ~= nil
		end

		return D
	end

	return C
end

return Cinema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">VfxKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/VfxKit
-- Effets visuels 3D : DONNÉES PURES (préréglages nommés = séquences de pièces Blender, émetteurs de particules, faisceau, surbrillance) et
-- fonctions de planification testées hors de Roblox (qualité Élevé / Moyen / Bas, plafonds mobiles, effets par rareté), puis EXÉCUTION côté
-- client (VfxKit.play) : chaque pièce est un modèle Blender blanc (`Nom__FFFFFF`, Neon) cloné depuis ReplicatedStorage.VfxTemplates, recoloré
-- par code, ancré, sans collision, dont la transparence, l'échelle, la rotation et la hauteur sont animées par TweenService ; tout est nettoyé
-- (Debris) et protégé par pcall : un effet qui échoue ne casse jamais le jeu.
-- Utilisation : local Vfx = require(Shared.VfxKit).new(Config, Easing)
local VfxKit = {}

-- Modèles Blender d'effets (clé = nom du fichier Blender, voir Config.Assets.models.vfx).
VfxKit.MODELS = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Préréglages. Pièce : { model, at (retard s), dur (s), s0/s1 (échelle de départ/arrivée, 1 = taille Blender), t0/t1 (transparence), spin (rad/s),
-- rise (studs montés pendant l'effet), style (Back, Elastic, Quint, Quad, Sine), dir (Out, In, InOut), color ("rarity" | "white" | {r,g,b} 0-255) }.
-- L'ordre des pièces est leur priorité : la qualité Basse n'en garde que les premières. Particules : { count, life, speed, size, color }.
VfxKit.PRESETS = {
	aura_runique = {
		pieces = {
			{ model = "cercle_runique", at = 0, dur = 1.8, s0 = 0.3, s1 = 1.15, t0 = 0.9, t1 = 1, spin = 1.4, style = "Back", dir = "Out", color = "rarity", peak = 0.35 },
			{ model = "halo", at = 0.1, dur = 1.6, s0 = 0.5, s1 = 1.0, t0 = 0.85, t1 = 1, spin = -0.8, style = "Quint", dir = "Out", color = "rarity", peak = 0.4 },
		},
		particles = { count = 24, life = 1.4, speed = 5, size = 0.35, color = "rarity" },
		minQuality = "low",
	},
	aura_ailes = {
		pieces = { { model = "ailes", at = 0.2, dur = 2.2, s0 = 0.2, s1 = 1.2, t0 = 0.8, t1 = 1, rise = 1.5, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 } },
		particles = { count = 18, life = 1.8, speed = 3, size = 0.3, color = "rarity" },
		highlight = true,
		minQuality = "medium",
	},
	onde_de_choc = {
		pieces = { { model = "onde", at = 0, dur = 0.9, s0 = 0.2, s1 = 3.2, t0 = 0.2, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 } },
		particles = { count = 14, life = 0.8, speed = 14, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	pilier_revelation = {
		pieces = {
			{ model = "pilier_lumiere", at = 0.15, dur = 1.8, s0 = 0.1, s1 = 1.1, t0 = 0.7, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.25 },
			{ model = "rayons", at = 0.2, dur = 1.6, s0 = 0.4, s1 = 1.3, t0 = 0.75, t1 = 1, spin = 0.9, style = "Quint", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cone_lumiere", at = 0.3, dur = 1.5, s0 = 0.6, s1 = 1.0, t0 = 0.8, t1 = 1, style = "Sine", dir = "InOut", color = "white", peak = 0.45 },
		},
		particles = { count = 30, life = 2, speed = 8, size = 0.4, color = "white" },
		beam = true,
		minQuality = "low",
	},
	bouclier = {
		pieces = { { model = "bouclier", at = 0, dur = 1.4, s0 = 0.5, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.6, style = "Back", dir = "Out", color = { 90, 200, 255 }, peak = 0.45 } },
		highlight = true,
		minQuality = "low",
	},
	etincelles = {
		pieces = { { model = "etincelles", at = 0, dur = 1.6, s0 = 0.5, s1 = 1.2, t0 = 0.3, t1 = 1, rise = 3, style = "Quad", dir = "Out", color = "rarity", peak = 0.1 } },
		particles = { count = 30, life = 1.5, speed = 9, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	spirale_montee = {
		pieces = {
			{ model = "spirale", at = 0, dur = 2.4, s0 = 0.4, s1 = 1.2, t0 = 0.6, t1 = 1, spin = 3, rise = 8, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 },
			{ model = "etoile", at = 1.0, dur = 1.2, s0 = 0.2, s1 = 1.4, t0 = 0.5, t1 = 1, spin = 1, rise = 10, style = "Back", dir = "Out", color = "white", peak = 0.2 },
		},
		particles = { count = 26, life = 2.2, speed = 6, size = 0.35, color = "rarity" },
		minQuality = "medium",
	},
	portail_torii = {
		pieces = {
			{ model = "torii", at = 0.3, dur = 2.6, s0 = 0.3, s1 = 1.0, t0 = 0.85, t1 = 1, style = "Back", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cristaux", at = 0.5, dur = 2.2, s0 = 0.2, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.4, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 },
		},
		particles = { count = 22, life = 2, speed = 4, size = 0.4, color = "rarity" },
		minQuality = "medium",
	},
}

-- Qualités. Mobile = Bas : au plus 3 effets simultanés, 40 particules par émetteur, jamais de faisceau (Beam).
VfxKit.QUALITY = {
	high = { rank = 3, maxConcurrent = 8, particleCap = 120, beams = true, maxPieces = 3, highlight = true },
	medium = { rank = 2, maxConcurrent = 5, particleCap = 70, beams = false, maxPieces = 2, highlight = true },
	low = { rank = 1, maxConcurrent = 3, particleCap = 40, beams = false, maxPieces = 1, highlight = false },
}

-- Effets (préréglages) joués pour une éclosion : ampleur croissante avec la rareté (1 Commun discret .. 5 Mythique) ; Cosmique et secret sont
-- spectaculaires. Retourne la liste ordonnée des préréglages et un facteur d'ampleur (échelle).
-- Lot 9 : tables indexées par rareté (1..10), sans seuil codé en dur ; les raretés migrées gardent leurs effets d'avant.
VfxKit.HATCH_AMP = { 0.55, 0.65, 0.75, 0.95, 1.2, 1.45, 1.8, 1.9, 1.9, 2 }
VfxKit.HATCH_FX = {
	{ "etincelles" },
	{ "etincelles" },
	{ "etincelles", "onde_de_choc" },
	{ "aura_runique", "onde_de_choc" },
	{ "pilier_revelation", "aura_runique", "aura_ailes", "onde_de_choc" },
	{ "pilier_revelation", "aura_runique", "aura_ailes", "spirale_montee", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
}
function VfxKit.hatchEffects(tier, secret)
	tier = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), #VfxKit.HATCH_FX))
	if secret then
		return { "pilier_revelation", "spirale_montee", "portail_torii", "aura_runique", "onde_de_choc", "etincelles" }, 2
	end
	return VfxKit.HATCH_FX[tier], VfxKit.HATCH_AMP[tier]
end

-- Qualité : tactile = Bas, sinon Élevé ; `override` (« high », « medium », « low ») la remplace.
function VfxKit.quality(isTouch, override)
	if override and VfxKit.QUALITY[override] then
		return override
	end
	return isTouch and "low" or "high"
end

function VfxKit.new(Config, Easing)
	local K = { active = 0 }

	-- Couleur (r, g, b en 0-255) d'une rareté ; blanc si inconnue.
	function K.rarityColor(tier)
		local t = Config.TIERS[tier]
		local c = t and t.color
		if c then
			return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
		end
		return { 255, 255, 255 }
	end

	local function resolveColor(spec, tier)
		if spec == "white" then
			return { 255, 255, 255 }
		elseif type(spec) == "table" then
			return spec
		end
		return K.rarityColor(tier)
	end

	-- Courbe nommée (style de TweenService) sur [0, 1] : Back, Elastic, Quint, Quad, Sine (sortie ou entrée-sortie).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	-- Plan concret d'un préréglage pour une rareté et une qualité : pièces (priorité, nombre limité par la qualité), particules plafonnées,
	-- faisceau seulement en Élevé, surbrillance selon la qualité, durée totale. nil si préréglage inconnu ou trop exigeant pour la qualité.
	-- amp multiplie l'échelle (ampleur selon la rareté).
	function K.plan(name, tier, quality, amp)
		local preset = VfxKit.PRESETS[name]
		local q = VfxKit.QUALITY[quality]
		if not preset or not q then
			return nil
		end
		local need = VfxKit.QUALITY[preset.minQuality or "low"]
		if q.rank < need.rank then
			return nil
		end
		amp = (type(amp) == "number" and amp == amp and amp > 0) and math.min(amp, 3) or 1
		local pieces, duration = {}, 0
		for i, p in ipairs(preset.pieces) do
			if i > q.maxPieces then
				break
			end
			pieces[#pieces + 1] = {
				model = p.model, at = p.at, dur = p.dur, s0 = p.s0 * amp, s1 = p.s1 * amp, t0 = p.t0, t1 = p.t1, spin = p.spin or 0, rise = (p.rise or 0) * amp,
				style = p.style, dir = p.dir, color = resolveColor(p.color, tier), peak = p.peak,
			}
			duration = math.max(duration, p.at + p.dur)
		end
		local particles = nil
		if preset.particles then
			particles = {
				count = math.min(preset.particles.count, q.particleCap), life = preset.particles.life, speed = preset.particles.speed,
				size = preset.particles.size, color = resolveColor(preset.particles.color, tier),
			}
		end
		return {
			name = name, pieces = pieces, particles = particles, beam = preset.beam == true and q.beams, highlight = preset.highlight == true and q.highlight,
			duration = duration,
		}
	end

	-- Admission : combien d'effets peuvent encore démarrer (limite de simultanéité de la qualité).
	function K.admit(active, quality)
		local q = VfxKit.QUALITY[quality]
		return q ~= nil and type(active) == "number" and active < q.maxConcurrent
	end

	-- Liste ordonnée des plans d'une éclosion, tronquée à la simultanéité de la qualité (rien de plus que ce que le téléphone peut jouer).
	function K.hatchPlans(tier, secret, quality, activeNow)
		local names, amp = VfxKit.hatchEffects(tier, secret)
		local out = {}
		local active = activeNow or 0
		for _, name in ipairs(names) do
			if not K.admit(active + #out, quality) then
				break
			end
			local plan = K.plan(name, tier, quality, amp)
			if plan then
				out[#out + 1] = plan
			end
		end
		return out
	end

	-- Transparence d'une pièce à la progression p (0..1) : monte en fondu vers `peak` (visibilité maximale) puis disparaît ; valeur dans [0, 1].
	function K.transparencyAt(piece, p)
		p = Easing.clamp01(p)
		local appear = 0.25
		if p < appear then
			return piece.t0 + (piece.peak - piece.t0) * K.curve("Quad", p / appear)
		end
		local e = (p - appear) / (1 - appear)
		return math.min(math.max(piece.peak + (piece.t1 - piece.peak) * K.curve("Sine", e), 0), 1)
	end

	-- Échelle d'une pièce à la progression p.
	function K.scaleAt(piece, p)
		return piece.s0 + (piece.s1 - piece.s0) * K.curve(piece.style, p)
	end

	---------------------------------------------------------------- Exécution (client)
	-- env = { clone(model) -> Model|nil, tween = TweenService, debris = Debris, parent = Instance, spawn = task.spawn, delay = task.delay, color = Color3.fromRGB }
	-- Retourne true si l'effet a démarré. Tout est sous pcall ; l'effet est détruit à la fin (Debris) quoi qu'il arrive.
	function K.play(env, plan, cframe, opts)
		if not plan or K.active >= 99 then
			return false
		end
		local started = false
		local ok = pcall(function()
			local folder = Instance.new("Folder")
			folder.Name = "Vfx_" .. plan.name
			folder.Parent = env.parent
			env.debris:AddItem(folder, plan.duration + 1.5)
			K.active += 1
			env.delay(plan.duration + 1.4, function()
				K.active = math.max(0, K.active - 1)
			end)
			for _, piece in ipairs(plan.pieces) do
				env.delay(piece.at, function()
					pcall(function()
						local model = env.clone(piece.model)
						if not model then
							return
						end
						model.Parent = folder
						local color = env.color(piece.color[1], piece.color[2], piece.color[3])
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false
								d.CanQuery = false
								d.CanTouch = false
								d.CastShadow = false
								d.Color = color
								d.Transparency = piece.t0
							end
						end
						local base = model:GetScale()
						local pivot = cframe
						local value = Instance.new("NumberValue")
						value.Parent = folder
						local function apply(p)
							if not model.Parent then
								return
							end
							pcall(function()
								model:ScaleTo(math.max(0.01, base * K.scaleAt(piece, p)))
								model:PivotTo(pivot * CFrame.new(0, piece.rise * p, 0) * CFrame.Angles(0, piece.spin * p * piece.dur, 0))
								local tr = K.transparencyAt(piece, p)
								for _, d in ipairs(model:GetDescendants()) do
									if d:IsA("BasePart") then
										d.Transparency = tr
									end
								end
							end)
						end
						apply(0)
						value.Changed:Connect(apply)
						env.tween:Create(value, TweenInfo.new(piece.dur, Enum.EasingStyle.Linear), { Value = 1 }):Play() -- les courbes sont appliquées par apply (Back, Elastic, Quint...)
					end)
				end)
			end
			if plan.particles then
				local anchor = Instance.new("Part")
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanQuery = false
				anchor.Transparency = 1
				anchor.Size = Vector3.new(1, 1, 1)
				anchor.CFrame = cframe
				anchor.Parent = folder
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(env.color(plan.particles.color[1], plan.particles.color[2], plan.particles.color[3]))
				e.Rate = 0
				e.Lifetime = NumberRange.new(plan.particles.life * 0.6, plan.particles.life)
				e.Speed = NumberRange.new(plan.particles.speed * 0.5, plan.particles.speed)
				e.SpreadAngle = Vector2.new(180, 180)
				e.LightEmission = 1
				e.Size = NumberSequence.new(plan.particles.size)
				e.Parent = anchor
				e:Emit(plan.particles.count) -- plafonné par la qualité (40 sur téléphone)
			end
			if plan.beam then -- faisceau vertical (qualité Élevée seulement)
				local top = Instance.new("Part")
				top.Anchored = true
				top.CanCollide = false
				top.CanQuery = false
				top.Transparency = 1
				top.Size = Vector3.new(1, 1, 1)
				top.CFrame = cframe * CFrame.new(0, 14, 0)
				top.Parent = folder
				local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
				a0.Parent = top
				a1.Parent = folder:FindFirstChildOfClass("Part") or top
				local beam = Instance.new("Beam")
				beam.Attachment0, beam.Attachment1 = a0, a1
				beam.Width0, beam.Width1 = 0.6, 2.2
				beam.LightEmission = 1
				beam.Transparency = NumberSequence.new(0.35, 1)
				beam.Color = ColorSequence.new(env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255))
				beam.Parent = top
			end
			if plan.highlight and opts and opts.target then
				local hl = Instance.new("Highlight")
				hl.FillTransparency = 0.8
				hl.OutlineTransparency = 0.2
				hl.FillColor = env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255)
				hl.Parent = opts.target
				env.debris:AddItem(hl, plan.duration)
			end
			started = true
		end)
		return ok and started
	end

	return K
end

return VfxKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">CinematicKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/CinematicKit
-- Caméras de cinématique : LOGIQUE PURE (aucun service Roblox) testée hors de Roblox. Un « plan » est une liste de prises { dur, pos, look, toPos, toLook,
-- fov, toFov, path, ease, shake, slow, text, title, fx, anchor } dans le repère de son ancre ; trajectoires : travelling (linéaire), orbite autour du
-- point visé, plongée (de haut en bas), zoom dolly (la caméra avance et le champ de vision se resserre). Bandes noires, cartons de titre, tremblement,
-- ralenti et bouton Passer sont appliqués par le client (Cinematics.client.lua) à partir de ces valeurs.
-- Garanties : jamais plus de 8 secondes réelles (MAX_SECONDS) ; aucune cinématique si le joueur est en danger (`canPlay`) ; la caméra et le contrôle
-- sont restitués par le client quoi qu'il arrive (fin, passage, erreur, départ). Utilisation : require(CinematicKit).new(Easing, Cinema).
local CinematicKit = {}

CinematicKit.MAX_SECONDS = 8

-- Plans nommés. Les positions sont { x, y, z } dans le repère de l'ancre (arena, base, pad, rival1..3, castle, world, hubfountain, hubportals).
-- `slow = { at, to, scale }` : entre ces progressions de la prise (0..1), le temps s'écoule à `scale` (0.35 = ralenti), ce qui allonge la durée réelle.
CinematicKit.PLANS = {
	hub_survol = { id = "hub_survol", shots = {
		{ anchor = "hubfountain", pos = { 0, 30, 70 }, look = { 0, 3, 0 }, toPos = { 0, 18, 40 }, path = "travel", dur = 2.2, ease = "Quint", title = "🥚 Bienvenue !" },
		{ anchor = "hubportals", pos = { 0, 22, 100 }, look = { 0, 8, -60 }, toPos = { 0, 14, 30 }, toLook = { 0, 8, -80 }, path = "travel", dur = 2.8, ease = "Sine", text = "Choisis un portail : seul, ou avec des amis." },
	} },
	secret = { id = "secret", shots = {
		{ anchor = "pad", pos = { 0, 6, 10 }, look = { 0, 3, 0 }, toPos = { 0, 14, 6 }, path = "dive", dur = 1.4, ease = "Quint", shake = 0.25, title = "✦ ???" },
		{ anchor = "pad", pos = { 0, 12, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = 2.4, height = 8, dur = 3.4, ease = "Sine", shake = 0.5, slow = { at = 0.35, to = 0.6, scale = 0.4 }, fx = "flash" },
		{ anchor = "pad", pos = { 0, 5, 9 }, look = { 0, 4, 0 }, path = "dolly", fov = 70, toFov = 46, toPos = { 0, 4, 3 }, dur = 1.4, ease = "Back", title = "✦ SECRET ✦" },
	} },
	chateau_entree = { id = "chateau_entree", shots = {
		{ anchor = "castle", pos = { -40, 16, 34 }, look = { 0, 6, -8 }, toPos = { 40, 14, 34 }, toLook = { 0, 8, -8 }, path = "travel", dur = 2.6, ease = "Sine", title = "🏰 Le Château" },
		{ anchor = "castle", pos = { 0, 5, 16 }, look = { 0, 7, 0 }, toPos = { 0, 6, 9 }, path = "dolly", fov = 70, toFov = 55, dur = 2.2, ease = "Quint", text = "La herse se lève…", fx = "gate" },
	} },
	-- Montée de niveau de la maison (D.4) : 4,5 s au total (2,7 + 1,8), plan large depuis l'avant de la base vers la maison à l'arrière ; passable (Passer, toucher l'écran).
	base_niveau = { id = "base_niveau", skipOnTap = true, shots = {
		{ anchor = "base", pos = { 0, 24, -62 }, look = { 0, 6, 14 }, toPos = { 0, 20, -50 }, path = "travel", dur = 2.7, ease = "Sine", title = "🏠 Ta base évolue !" },
		{ anchor = "base", pos = { -34, 16, -26 }, look = { 0, 8, 16 }, toPos = { 34, 16, -26 }, path = "travel", dur = 1.8, ease = "Sine" },
	} },
	chateau_victoire = { id = "chateau_victoire", shots = {
		{ anchor = "castle_chest", pos = { 6, 7, 10 }, look = { 0, 3, 0 }, toPos = { 3, 5, 6 }, path = "dolly", fov = 70, toFov = 52, dur = 1.6, ease = "Quint", slow = { at = 0.4, to = 0.9, scale = 0.35 }, shake = 0.3, fx = "sparks" },
		{ anchor = "castle_chest", pos = { 0, 6, 11 }, look = { 0, 3, 0 }, path = "orbit", radius = 11, toRadius = 9, angle0 = 0.6, angle1 = 2.0, height = 6, dur = 2.4, ease = "Sine", title = "🏆 Victoire !" },
	} },
}

-- Plan d'éclosion selon la rareté (1..6) : plus la rareté monte, plus la caméra s'engage (orbite, zoom, secousse, ralenti, pilier de lumière côté VfxKit).
-- Commun et Rare : AUCUNE cinématique (les effets 3D de VfxKit suffisent) ; Épique : plan court ; Légendaire et au-delà : plan complet.
-- Lot 9 : genre de plan par rareté (1..10) : "none", "short" (Épique), "full", "big" (Mythique et au-delà).
CinematicKit.TIER_PLAN = { "none", "none", "none", "short", "full", "big", "big", "big", "big", "big" }
function CinematicKit.hatchPlan(tier, secret)
	tier = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), #CinematicKit.TIER_PLAN))
	local kind = CinematicKit.TIER_PLAN[tier]
	if secret then
		return CinematicKit.PLANS.secret
	elseif kind == "none" then
		return nil
	elseif kind == "short" then
		return { id = "eclosion_epique", skipOnTap = true, shots = {
			{ anchor = "pad", pos = { 0, 8, 12 }, look = { 0, 3, 0 }, toPos = { 0, 5, 7 }, path = "dolly", fov = 70, toFov = 56, dur = 1.6, ease = "Quint", shake = 0.15 },
		} }
	end
	local big = kind == "big"
	return { id = "eclosion", skipOnTap = true, shots = {
		{ anchor = "pad", pos = { 0, 7, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = big and 2.2 or 1.6, height = 6, dur = big and 2.4 or 1.8, ease = "Sine" },
		{ anchor = "pad", pos = { 0, 5, 8 }, look = { 0, 3.2, 0 }, path = "dolly", fov = 70, toFov = big and 44 or 52, toPos = { 0, 4, 4 }, dur = big and 1.8 or 1.2, ease = "Back", shake = big and 0.6 or 0.4, slow = { at = 0.5, to = 1, scale = 0.35 }, fx = "crack" },
		{ anchor = "pad", pos = { 0, 6, 9 }, look = { 0, 4, 0 }, toPos = { 0, 7, 11 }, path = "travel", fov = big and 52 or 60, toFov = 70, dur = big and 1.6 or 1.2, ease = "Quint", title = nil },
	} }
end

-- Plan court « gardien ou chevalier qui repère le joueur » : AUCUN mouvement de caméra (le joueur garde le contrôle, il est en danger) : un à-coup
-- de champ de vision, un peu de tremblement et un « ❗ » (voir `overlay`). Retourne le descriptif d'effet d'interface.
CinematicKit.ALERT = { seconds = 1.2, fovPunch = 8, shake = 0.35, title = "❗", cooldown = 90, perSession = 3 }

function CinematicKit.new(Easing, Cinema)
	local K = {}

	-- Courbe nommée (style de TweenService).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	local function lerp(a, b, e)
		return a + (b - a) * e
	end
	local function lerp3(a, b, e)
		return { lerp(a[1], b[1], e), lerp(a[2], b[2], e), lerp(a[3], b[3], e) }
	end

	-- Durée RÉELLE d'une prise (le ralenti l'allonge) : dur x (1 + (1/scale - 1) x largeur de la zone lente).
	function K.realDuration(shot)
		local s = shot.slow
		if not s then
			return shot.dur
		end
		local width = math.max(0, math.min(1, s.to) - math.max(0, s.at))
		return shot.dur * (1 + (1 / math.max(0.05, s.scale) - 1) * width)
	end

	function K.realTotal(def)
		local t = 0
		for _, shot in ipairs(def.shots) do
			t = t + K.realDuration(shot)
		end
		return t
	end

	-- Plan normalisé : durées réduites proportionnellement si la durée RÉELLE dépasse `maxSeconds` (8 par défaut) ; prise invalide (durée <= 0, NaN) = refus.
	-- Retourne (définition prête pour Cinema.sequence, durée réelle) ou (nil, raison).
	function K.build(def, maxSeconds)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucune prise"
		end
		maxSeconds = (type(maxSeconds) == "number" and maxSeconds > 0) and math.min(maxSeconds, CinematicKit.MAX_SECONDS) or CinematicKit.MAX_SECONDS
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur ~= shot.dur or shot.dur <= 0 or type(shot.pos) ~= "table" or type(shot.look) ~= "table" then
				return nil, "prise invalide (" .. i .. ")"
			end
		end
		local real = K.realTotal(def)
		local k = real > maxSeconds and (maxSeconds / real) or 1
		local shots = {}
		for i, shot in ipairs(def.shots) do
			local copy = {}
			for key, v in pairs(shot) do
				copy[key] = v
			end
			copy.dur = shot.dur * k
			shots[i] = copy
		end
		local out = { id = def.id, shots = shots, skipOnTap = def.skipOnTap }
		return out, real * k
	end

	-- Temps virtuel (celui des prises) atteint après `realElapsed` secondes réelles : le ralenti fait avancer le temps plus lentement dans sa zone.
	function K.virtualElapsed(def, realElapsed)
		local virtual, left = 0, math.max(0, realElapsed)
		for _, shot in ipairs(def.shots) do
			local rd = K.realDuration(shot)
			if left >= rd then
				virtual = virtual + shot.dur
				left = left - rd
			else
				local s = shot.slow
				if not s then
					return virtual + left
				end
				local a, b = math.max(0, s.at) * shot.dur, math.min(1, s.to) * shot.dur
				local slowReal = (b - a) / math.max(0.05, s.scale)
				if left <= a then
					return virtual + left
				elseif left <= a + slowReal then
					return virtual + a + (left - a) * math.max(0.05, s.scale)
				end
				return virtual + b + (left - a - slowReal)
			end
		end
		return virtual
	end

	-- Caméra à la progression p d'une prise : (position, point visé, champ de vision) dans le repère de l'ancre.
	function K.cameraAt(shot, p)
		local e = K.curve(shot.ease or "Sine", p)
		local fov = lerp(shot.fov or 70, shot.toFov or shot.fov or 70, e)
		local look = lerp3(shot.look, shot.toLook or shot.look, e)
		local path = shot.path
		if path == "orbit" then
			local r = lerp(shot.radius or 10, shot.toRadius or shot.radius or 10, e)
			local a = lerp(shot.angle0 or 0, shot.angle1 or (shot.angle0 or 0), e)
			return { look[1] + math.sin(a) * r, look[2] + (shot.height or 5), look[3] + math.cos(a) * r }, look, fov
		elseif path == "dive" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- plongée : de haut en bas (ou l'inverse) en gardant la cible
		elseif path == "dolly" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- zoom dolly : la caméra avance, le champ de vision se resserre
		end
		return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- travelling
	end

	-- Décalage de caméra dû au tremblement (amplitude shot.shake en studs, décroissante sur la prise, bruit déterministe).
	function K.shakeOffset(shot, p, time)
		local amp = shot.shake
		if not amp or amp <= 0 then
			return { 0, 0, 0 }
		end
		local decay = (1 - Easing.clamp01(p)) ^ 1.5
		local a = amp * decay
		return { math.sin(time * 47.3) * a * 0.5, math.sin(time * 61.1 + 1.7) * a * 0.4, math.cos(time * 39.7) * a * 0.3 }
	end

	-- Le joueur peut-il voir une cinématique maintenant ? ctx = { hp, maxHp, sinceHit (s depuis le dernier coup), chased (poursuivi par un gardien),
	-- inTrapRoom (dans une salle à pièges du château), dead }. Jamais en danger : peu de pv, coup récent, poursuite, salle à pièges, mort.
	function K.canPlay(ctx)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.5 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 4) or ctx.chased or ctx.inTrapRoom then
			return false
		end
		return true
	end

	-- Alerte (gardien ou chevalier qui repère le joueur) : pas une cinématique (aucune caméra) ; autorisée même poursuivi, mais pas à moins de 40 % de pv
	-- ni juste après un coup, avec temps de recharge et nombre maximum par session.
	function K.canAlert(ctx, now, lastAt, shown)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.4 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 2) then
			return false
		end
		if (shown or 0) >= CinematicKit.ALERT.perSession or (lastAt and now - lastAt < CinematicKit.ALERT.cooldown) then
			return false
		end
		return true
	end

	-- Gestionnaire de lecture : une seule cinématique à la fois (le directeur de Cinema refuse la seconde), passage immédiat, restitution garantie.
	-- host = { takeCamera(), giveCameraBack(), apply(shotIndex, progress, shot) } ; toute erreur de host.apply restitue la caméra et abandonne.
	-- Retourne un objet { start(def, now), update(now), skip(now), abort(), isActive(), restored } pour le client et les tests.
	function K.runner(host)
		local R = { restored = 0 }
		local director = Cinema.director()
		local current = nil
		local function restore()
			if current then
				current = nil
			end
			R.restored = R.restored + 1
			pcall(host.giveCameraBack)
		end
		-- Retourne "playing", "queued" ou "refused" (ou "invalid").
		function R.start(def, now, chain)
			local built, real = K.build(def)
			if not built then
				return "invalid"
			end
			local seq = Cinema.sequence(built)
			if not seq then
				return "invalid"
			end
			local result = director.request(def.id, seq, now, chain)
			if result == "playing" then
				current = { def = built, startedAt = now, seq = seq, real = real }
				local ok = pcall(host.takeCamera)
				if not ok then
					director.abort()
					restore()
					return "invalid"
				end
			end
			return result
		end
		function R.update(now)
			if not current then
				return nil
			end
			local virtual = K.virtualElapsed(current.def, now - current.startedAt)
			local id, ev = director.update(current.startedAt + virtual)
			if not id or (ev and ev.finished) then
				restore()
				return "finished"
			end
			if ev and ev.shot then
				local ok = pcall(host.apply, ev.shot, ev.progress, current.def.shots[ev.shot])
				if not ok then
					director.abort()
					restore()
					return "error"
				end
			end
			return "playing"
		end
		function R.skip(now)
			if director.skip(now) then
				restore()
				return true
			end
			return false
		end
		function R.abort()
			director.abort()
			if current then
				restore()
			end
		end
		function R.isActive()
			return director.isActive()
		end
		return R
	end

	return K
end

return CinematicKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Placement
-- Pose PLANIFIÉE du décor Blender (arbres, rochers, buissons, cabanes, barrières, ponts) : logique PURE, déterministe, testée hors de Roblox.
-- Principes : une grille de cellules parcourue dans un ordre fixe (aucun tirage libre), chaque objet a une empreinte circulaire ; il n'est posé que si son
-- empreinte ne touche NI l'eau (lacs, rivières, fontaine, douve), NI un chemin, NI la place, l'arène, un territoire, une base, un secret ou une plume
-- (règles de MapGeo.blocked), et reste à distance minimale des objets déjà posés. Cabanes tournées face au centre de leur territoire, barrières
-- alignées sur une même ligne, ponts de bois centrés sur leur cours d'eau. Forêts par rectangles et bosquets (REFONTE lot 2, carte 700 x 500).
-- Utilisation : require(Placement).new(Config).plan() (MapGeo chargé à côté ; les tests le passent : Placement.new(Config, MapGeo)).
local Placement = {}

-- Pause coopérative facultative (Builder la règle sur task.wait) : les calculs de pose cèdent la main tous les 25 essais (jamais de gel du serveur ;
-- les tests purs la laissent à nil).
Placement.yield = nil
local pauseCount = 0
local function pause()
	pauseCount = pauseCount + 1
	if Placement.yield and pauseCount % 25 == 0 then
		Placement.yield()
	end
end

local KIND_RADIUS = { tree = 3.5, fir = 3.5, rock = 2.5, bush = 2, hut = 7, fence = 5.5 }
Placement.KIND_RADIUS = KIND_RADIUS
Placement.MIN_GAP = 2 -- espace libre minimal entre deux empreintes (studs)
Placement.CELL = 30

-- Angle (degrés) de rotation autour de Y pour qu'un modèle dont l'avant est -Z regarde la direction (dx, dz). Portable (pas de math.atan2).
function Placement.facing(dx, dz)
	local fx, fz = -dx, -dz -- on veut sin(theta) = -dx/len et cos(theta) = -dz/len
	if fx == 0 and fz == 0 then
		return 0
	end
	local theta
	if fz == 0 then
		theta = fx > 0 and math.pi / 2 or -math.pi / 2
	else
		theta = math.atan(fx / fz)
		if fz < 0 then
			theta = theta + math.pi
		end
	end
	return math.deg(theta) % 360
end

local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / len2)) or 0
	local cx, cz = ax + dx * t, az + dz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Placement.distToSegment = distToSegment

-- Angle Y (degrés, convention Roblox : CFrame.Angles(0, a, 0) envoie +X vers (cos a, -sin a)) d'un déplacement (dx, dz). Pas de math.atan2.
function Placement.yawOfDir(dx, dz)
	local ax, az = dx, -dz -- on veut cos a = dx/len, sin a = -dz/len
	if ax == 0 and az == 0 then
		return 0
	end
	local a
	if ax == 0 then
		a = az > 0 and math.pi / 2 or -math.pi / 2
	else
		a = math.atan(az / ax)
		if ax < 0 then
			a = a + math.pi
		end
	end
	return math.deg(a) % 360
end

-- REFONTE (lot 2) : le module MapGeo (géométrie de la carte 700 x 500) est injecté par l'appelant ou chargé à côté de ce module.
local function loadGeo(MapGeo)
	if MapGeo then
		return MapGeo
	end
	if Placement.MapGeo then
		return Placement.MapGeo
	end
	local ok, mod = pcall(function()
		return require(script.Parent:WaitForChild("MapGeo"))
	end)
	if ok then
		Placement.MapGeo = mod
		return mod
	end
	error("Placement : module MapGeo introuvable (passe-le à Placement.new(Config, MapGeo))")
end

-- Variante d'arbre selon la zone : tree_sakura près des lacs et de la place, tree_pine au nord (derrière la rivière), autour des territoires et sur le
-- plateau du château, sinon prairie (chênes, bouleau, arbre rond en alternance ; tree_oak_b porte des pommes). `kind` = "tree" ou "fir" (les sapins
-- restent des pins). `k` = rang (déterministe).
function Placement.treeVariant(Config, kind, x, z, k, MapGeo)
	if kind == "fir" then
		return "tree_pine"
	end
	local M2 = Config.Map2
	for _, lk in ipairs(M2.lakes) do
		if math.sqrt((x - lk.x) ^ 2 + (z - lk.z) ^ 2) < lk.r + 40 then
			return "tree_sakura"
		end
	end
	if math.sqrt((x - M2.plaza.x) ^ 2 + (z - M2.plaza.z) ^ 2) < M2.plaza.r + 50 then
		return "tree_sakura"
	end
	if z < -180 then
		return "tree_pine"
	end
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		if math.sqrt((x - t.x) ^ 2 + (z - t.z) ^ 2) < t.r + 25 then
			return "tree_pine"
		end
	end
	return ({ "tree_oak_a", "tree_oak_b", "tree_birch", "tree_round" })[(k or 0) % 4 + 1]
end

-- Échelle aléatoire déterministe 1 ± jitter d'après la position (jamais de tirage libre).
function Placement.jitter(x, z, jitter)
	local h = math.abs(math.sin(x * 12.9898 + z * 78.233) * 43758.5453)
	return 1 + ((h - math.floor(h)) * 2 - 1) * jitter
end

-- Chemin sinueux : la polyligne est rééchantillonnée tous les `tile` studs et décalée latéralement d'une sinusoïde (amplitude `wind`, nulle aux
-- extrémités et aux sommets). Retourne { tiles = { {kind, x, z, rot} }, borders = { {x, z, rot} } } : tuiles droites (le long de X, tournées vers la
-- direction), tuile de virage quand la direction tourne de 50° à 130° (rotation par pas de 90°), bordures de pierres de part et d'autre.
function Placement.pathTiles(poly, tile, wind)
	local pts, cum = {}, { 0 }
	local verts = {}
	local total = 0
	for k = 1, #poly - 1 do
		local ax, az, bx, bz = poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2]
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		verts[#verts + 1] = total
		local n = math.max(1, math.floor(len / tile + 0.5))
		for j = 0, n - 1 do
			local t = j / n
			local dx, dz = (bx - ax) / len, (bz - az) / len
			pts[#pts + 1] = { x = ax + (bx - ax) * t, z = az + (bz - az) * t, nx = -dz, nz = dx, d = total + len * t }
		end
		total = total + len
	end
	local last = poly[#poly]
	local pdx, pdz = last[1] - poly[#poly - 1][1], last[2] - poly[#poly - 1][2]
	local pl = math.sqrt(pdx * pdx + pdz * pdz)
	pts[#pts + 1] = { x = last[1], z = last[2], nx = -pdz / pl, nz = pdx / pl, d = total }
	verts[#verts + 1] = total
	for _, p in ipairs(pts) do
		local near = total
		for _, v in ipairs(verts) do
			near = math.min(near, math.abs(p.d - v))
		end
		local env = math.min(1, near / (tile * 2))
		local off = (wind or 0) * math.sin(p.d / 38) * env
		p.x, p.z = p.x + p.nx * off, p.z + p.nz * off
	end
	local tiles, borders = {}, {}
	local snap = function(dx, dz)
		if math.abs(dx) >= math.abs(dz) then
			return dx > 0 and 1 or -1, 0
		end
		return 0, dz > 0 and 1 or -1
	end
	for i = 1, #pts do
		local a, b = pts[i], pts[i + 1] or pts[i]
		local pa = pts[i - 1]
		local dx, dz = b.x - a.x, b.z - a.z
		if i == #pts then
			dx, dz = a.x - pa.x, a.z - pa.z
		end
		local rot = Placement.yawOfDir(dx, dz)
		local kind = "path_straight"
		if pa and i < #pts then
			local ix, iz = a.x - pa.x, a.z - pa.z
			local li, lo = math.sqrt(ix * ix + iz * iz), math.sqrt(dx * dx + dz * dz)
			local cosT = (ix * dx + iz * dz) / (li * lo)
			if cosT < 0.64 and cosT > -0.64 then -- tourne de 50° à 130°
				local ux, uz = snap(ix, iz)
				local vx, vz = snap(dx, dz)
				-- virage de base : on entre en allant vers +X et on sort vers -Z ; 4 rotations x (sens direct / inverse)
				local found
				for q = 0, 3 do
					local th = math.rad(q * 90)
					local function rot90(x, z) -- image de (x, z) par Angles(0, th, 0)
						return math.floor(x * math.cos(th) + z * math.sin(th) + 0.5), math.floor(-x * math.sin(th) + z * math.cos(th) + 0.5)
					end
					local ex, ez = rot90(1, 0)
					local fx, fz = rot90(0, -1)
					if ex == ux and ez == uz and fx == vx and fz == vz then
						found = q * 90
					elseif -fx == ux and -fz == uz and -ex == vx and -ez == vz then
						found = q * 90 -- tuile parcourue en sens inverse
					end
				end
				if found then
					kind, rot = "path_curve", found
				end
			end
		end
		tiles[#tiles + 1] = { kind = kind, x = a.x, z = a.z, rot = rot }
		local nxl, nzl = -dz, dx
		local nl = math.sqrt(nxl * nxl + nzl * nzl)
		if nl > 0 then
			for _, side in ipairs({ -1, 1 }) do
				borders[#borders + 1] = { x = a.x + side * nxl / nl * (tile / 2 + 1.2), z = a.z + side * nzl / nl * (tile / 2 + 1.2), rot = rot }
			end
		end
	end
	return { tiles = tiles, borders = borders, length = total }
end

function Placement.new(Config, MapGeo)
	local MG = loadGeo(MapGeo)
	local G = MG.new(Config)
	local P = { G = G }
	local M2 = Config.Map2
	local B = M2.bounds

	-- Segments des chemins au sol (mêmes polylignes que Scenery.paths) : { ax, az, bx, bz } ; les ponts sont des chemins.
	function P.pathSegments()
		local out = {}
		for _, sg in ipairs(G.pathSegs) do
			if (sg.y or 0) == 0 then
				out[#out + 1] = { sg[1], sg[2], sg[3], sg[4], half = sg.half }
			end
		end
		return out
	end

	-- Altitude du sol en (x, z) : plateau du château, colline, sinon 0.
	function P.groundY(x, z)
		return G.groundY(x, z)
	end

	-- Pourquoi une empreinte (x, z, r) est interdite : "eau", "chemin", "place", "repère", "arène", "château", "domaine", "base", "secret",
	-- "plume", "bord" ou nil si libre. opts.allowDomain : dans un territoire (cabanes, barrières) ; opts.allowPlateau : sur le plateau du château.
	function P.blocked(x, z, r, opts)
		return G.blocked(x, z, r, opts)
	end

	-- Empreintes réservées dans les territoires : nids et postes des gardiens (rien n'y est posé).
	local reserved = {}
	for _, t in ipairs(G.terrs) do
		for _, n in ipairs(t.nests or {}) do
			reserved[#reserved + 1] = { n[1], n[2], 5 }
		end
		for _, p in ipairs(t.posts or {}) do
			reserved[#reserved + 1] = { p[1], p[2], 6 }
		end
	end
	reserved[#reserved + 1] = { G.keep.x, G.keep.z, G.keep.half + 4 }
	local function freeOfReserved(x, z, r)
		for _, q in ipairs(reserved) do
			if math.sqrt((x - q[1]) ^ 2 + (z - q[2]) ^ 2) < q[3] + r then
				return false
			end
		end
		return true
	end

	-- Arbres PROCÉDURAUX des forêts (rectangles de Map2.forests, débordant sur le décor de fond au bord de la carte) et des bosquets : positions
	-- déterministes, rien dans l'eau, sur un chemin, une base ou un territoire. { {x, z, r, y, grove} } ; au plus Map2.procTrees en forêt.
	function P.forest()
		if G._forest then
			return G._forest
		end
		local out = {}
		local r = 3.5
		local function freeHere(x, z)
			pause()
			if math.abs(x) > M2.backdrop.w / 2 - 6 or math.abs(z) > M2.backdrop.d / 2 - 6 then
				return false
			end
			local why = G.blocked(x, z, r, {})
			if why and not (why == "bord" and not G.inBounds(x, z, 0)) then
				return false
			end
			if not freeOfReserved(x, z, r) then
				return false
			end
			for _, o in ipairs(out) do
				if math.sqrt((x - o.x) ^ 2 + (z - o.z) ^ 2) < 2 * r + Placement.MIN_GAP then
					return false
				end
			end
			return true
		end
		-- bosquets : groveTrees arbres en couronne
		for gi, gv in ipairs(M2.groves) do
			for k = 1, M2.groveTrees do
				local a = (k / M2.groveTrees + gi * 0.13) * math.pi * 2
				local rad = M2.groveRadius * (k % 2 == 0 and 0.75 or 0.35)
				local x, z = gv.x + math.cos(a) * rad, gv.z + math.sin(a) * rad
				if freeHere(x, z) then
					out[#out + 1] = { x = x, z = z, r = r, y = G.groundY(x, z), grove = gi }
				end
			end
		end
		-- forêts : quota proportionnel au maximum de chaque rectangle ; un rectangle collé au bord déborde de 24 studs dans le décor de fond
		local sumMax = 0
		for _, f in ipairs(M2.forests) do
			sumMax = sumMax + f.max
		end
		local seed = 2711
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		for _, f in ipairs(M2.forests) do
			local quota = math.floor(M2.procTrees * f.max / sumMax + 0.5)
			local x0, x1, z0, z1 = f.x0, f.x1, f.z0, f.z1
			if x0 <= B.x0 then
				x0 = x0 - 24
			end
			if x1 >= B.x1 then
				x1 = x1 + 24
			end
			if z0 <= B.z0 then
				z0 = z0 - 24
			end
			if z1 >= B.z1 then
				z1 = z1 + 24
			end
			local cells = {}
			local step = 11
			for gx = x0 + step / 2, x1, step do
				for gz = z0 + step / 2, z1, step do
					cells[#cells + 1] = { gx, gz }
				end
			end
			for i = #cells, 2, -1 do
				local j = 1 + math.floor(rnd() * i)
				cells[i], cells[j] = cells[j], cells[i]
			end
			local got = 0
			for _, c in ipairs(cells) do
				if got >= quota then
					break
				end
				local x, z = c[1] + (rnd() - 0.5) * 5, c[2] + (rnd() - 0.5) * 5
				if freeHere(x, z) then
					out[#out + 1] = { x = x, z = z, r = r, y = G.groundY(x, z) }
					got = got + 1
				end
			end
		end
		G._forest = out
		return out
	end

	-- Plan complet : { items = { {kind, x, z, rot, r, y} }, bridges = { {x, z, rot, length, name} }, forest = P.forest() }. Déterministe.
	function P.plan()
		if G._plan then
			return G._plan
		end
		local items = {}
		local forest = P.forest()
		local function fits(kind, x, z, opts)
			pause()
			local r = KIND_RADIUS[kind]
			if P.blocked(x, z, r, opts) or not freeOfReserved(x, z, r) then
				return false
			end
			for _, it in ipairs(items) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + Placement.MIN_GAP then
					return false
				end
			end
			for _, it in ipairs(forest) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + Placement.MIN_GAP then
					return false
				end
			end
			return true
		end
		local function add(kind, x, z, rot)
			items[#items + 1] = { kind = kind, x = x, z = z, rot = rot, r = KIND_RADIUS[kind], y = P.groundY(x, z) }
		end
		local plan = Config.Assets.propsPlan
		-- 1. par rival (premier territoire) : une ligne de barrières alignée puis une cabane face au centre du territoire (jamais dans l'eau)
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			local t = G.terr(Config.rivalTerritories(i)[1].key)
			local inner = t.r - 10
			local opts = { allowDomain = true, allowPlateau = true }
			local perDomain = math.ceil((plan.fence or 0) / #Config.RIVALS)
			for k = 0, perDomain - 1 do
				local fx, fz = cx - 20.25 + k * 13.5, cz - (t.r - 12) -- côté nord du territoire
				if fits("fence", fx, fz, opts) then
					add("fence", fx, fz, 0) -- alignées sur l'axe X, même rotation : jamais de barrières qui se croisent
				end
			end
			for _, off in ipairs({ { -1, 0.3 }, { 1, 0.3 }, { -0.7, -0.7 }, { 0.7, -0.7 }, { 0, 1 }, { 0, -1 }, { 0, 0.55 }, { 0.55, 0 }, { -0.55, 0 }, { 0, -0.55 } }) do
				local hx, hz = cx + off[1] * inner, cz + off[2] * inner
				if (plan.hut or 0) > 0 and fits("hut", hx, hz, opts) then
					add("hut", hx, hz, Placement.facing(cx - hx, cz - hz))
					break
				end
			end
		end
		-- 2. décor libre : les sapins et les arbres vont d'abord dans les forêts, puis partout ; rochers et buissons sur toute la carte
		local seed = 4093 -- Park–Miller : mélange déterministe des cellules
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		local cell = Placement.CELL
		local cells, forestCells = {}, {}
		for gx = B.x0 + 10, B.x1 - 10, cell do
			for gz = B.z0 + 10, B.z1 - 10, cell do
				local c = { gx + cell / 2, gz + cell / 2 }
				cells[#cells + 1] = c
				for _, f in ipairs(M2.forests) do
					if c[1] >= f.x0 - 10 and c[1] <= f.x1 + 10 and c[2] >= f.z0 - 10 and c[2] <= f.z1 + 10 then
						forestCells[#forestCells + 1] = c
						break
					end
				end
			end
		end
		local function shuffle(list)
			for i = #list, 2, -1 do
				local j = 1 + math.floor(rnd() * i)
				list[i], list[j] = list[j], list[i]
			end
		end
		shuffle(cells)
		shuffle(forestCells)
		local function scatter(kind, count, list)
			local got = 0
			for _, c in ipairs(list) do
				if got >= count then
					break
				end
				local x, z = c[1] + (rnd() - 0.5) * 14, c[2] + (rnd() - 0.5) * 14
				if fits(kind, x, z) then
					add(kind, x, z, rnd() * 360)
					got = got + 1
				end
			end
			return got
		end
		local firs = scatter("fir", plan.fir or 0, forestCells)
		scatter("fir", (plan.fir or 0) - firs, cells)
		local trees = scatter("tree", math.ceil((plan.tree or 0) / 2), forestCells)
		scatter("tree", (plan.tree or 0) - trees, cells)
		scatter("rock", plan.rock or 0, cells)
		scatter("bush", plan.bush or 0, cells)
		-- 3. ponts de bois (Blender) : centrés sur leur cours d'eau, axe du pont ; le pont de pierre du château (rampe) reste procédural
		local bridges = {}
		for _, b in ipairs(G.bridges) do
			if not b.stone then
				bridges[#bridges + 1] = { x = b.x, z = b.z, rot = b.axis == "NS" and 90 or 0, length = b.len, name = b.name, river = b.river }
			end
		end
		G._plan = { items = items, bridges = bridges, forest = forest }
		return G._plan
	end

	-- Décor fin (fleurs, touffes, pierres, lanternes) : mêmes règles (rien dans l'eau ni sur un chemin), espacement plus serré, après le plan principal.
	-- Retourne { {kind, x, z, rot, r} } ; kinds : flower_a/b/c, tuft, stone_flat, stone_round, lantern. Les lanternes bordent les chemins (à 5 studs).
	local DECO_RADIUS = { flower_a = 1, flower_b = 1, flower_c = 1, tuft = 1, stone_flat = 1.5, stone_round = 1.5, lantern = 1 }
	Placement.DECO_RADIUS = DECO_RADIUS
	function P.decor(planItems, counts)
		counts = counts or { flowers = 36, tufts = 24, stones = 18, lanterns = 12 }
		local out = {}
		local function fits(kind, x, z)
			pause()
			local r = DECO_RADIUS[kind]
			if P.blocked(x, z, r, { allowDomain = true }) then
				return false
			end
			for _, it in ipairs(planItems or {}) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 1 then
					return false
				end
			end
			for _, it in ipairs(P.forest()) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 1 then
					return false
				end
			end
			for _, it in ipairs(out) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 0.5 then
					return false
				end
			end
			return true
		end
		local seed = 7919
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		-- lanternes le long des chemins (un côté, tous les ~28 studs)
		local placedLanterns = 0
		for _, seg in ipairs(P.pathSegments()) do
			local dx, dz = seg[3] - seg[1], seg[4] - seg[2]
			local len = math.sqrt(dx * dx + dz * dz)
			local nx, nz = -dz / len, dx / len
			local steps = math.max(1, math.floor(len / 28))
			for k = 1, steps do
				if placedLanterns >= counts.lanterns then
					break
				end
				local t = (k - 0.5) / steps
				local x, z = seg[1] + dx * t + nx * ((seg.half or M2.pathHalf) + 3.5), seg[2] + dz * t + nz * ((seg.half or M2.pathHalf) + 3.5)
				if fits("lantern", x, z) then
					out[#out + 1] = { kind = "lantern", x = x, z = z, rot = 0, r = DECO_RADIUS.lantern, y = P.groundY(x, z) }
					placedLanterns = placedLanterns + 1
				end
			end
		end
		-- fleurs, touffes, pierres : cellules de 24 studs dans un ordre mélangé déterministe ; les fleurs se regroupent autour des domaines et des chemins
		local kinds = {}
		for i = 1, counts.flowers do
			kinds[#kinds + 1] = ({ "flower_a", "flower_b", "flower_c" })[i % 3 + 1]
		end
		for _ = 1, counts.tufts do
			kinds[#kinds + 1] = "tuft"
		end
		for i = 1, counts.stones do
			kinds[#kinds + 1] = i % 2 == 0 and "stone_flat" or "stone_round"
		end
		local cells = {}
		local cell = 24
		for gx = B.x0 + 12, B.x1 - 12, cell do
			for gz = B.z0 + 12, B.z1 - 12, cell do
				cells[#cells + 1] = { gx + cell / 2, gz + cell / 2 }
			end
		end
		for i = #cells, 2, -1 do
			local j = 1 + math.floor(rnd() * i)
			cells[i], cells[j] = cells[j], cells[i]
		end
		local ki = 1
		for _, c in ipairs(cells) do
			if ki > #kinds then
				break
			end
			local x, z = c[1] + (rnd() - 0.5) * 14, c[2] + (rnd() - 0.5) * 14
			if fits(kinds[ki], x, z) then
				out[#out + 1] = { kind = kinds[ki], x = x, z = z, rot = rnd() * 360, r = DECO_RADIUS[kinds[ki]], y = P.groundY(x, z) }
				ki = ki + 1
			end
		end
		return out
	end

	-- Décor de village de la carte (modèles scn_*) : candidats sur des anneaux autour de la place, ordre fixe ; mêmes règles que plan() (rien dans l'eau, sur un
	-- chemin, une base, un territoire ni sur un objet du plan). Retourne { {kind, x, z, rot, r, y} }.
	local VILLAGE = { { "scn_tour_cloche", 1 }, { "scn_maison_colombages", 3 }, { "scn_puits", 2 }, { "scn_pin_haut", 6 }, { "scn_rocher_a", 3 }, { "scn_rocher_b", 3 }, { "scn_rocher_c", 3 } }
	Placement.VILLAGE = VILLAGE
	function P.scenery(planItems)
		local out = {}
		local dims = Config.Assets.sceneryDims
		for _, entry in ipairs(VILLAGE) do
			local kind, want = entry[1], entry[2]
			local r = dims[kind].r
			local got, tries = 0, 0
			while got < want and tries < 400 do
				tries = tries + 1
				pause()
				local ang = math.rad((tries * 137.5 + #out * 23) % 360)
				local rad = 75 + (tries * 29) % 250 -- anneaux de 75 à 325 studs autour de la place
				local x, z = math.sin(ang) * rad, -math.cos(ang) * rad
				local ok = not P.blocked(x, z, r, {}) and freeOfReserved(x, z, r)
				if ok then
					for _, it in ipairs(planItems or {}) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 2 then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, it in ipairs(P.forest()) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 2 then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, it in ipairs(out) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 3 then
							ok = false
							break
						end
					end
				end
				if ok then
					out[#out + 1] = { kind = kind, x = x, z = z, rot = Placement.facing(-x, -z), r = r, y = P.groundY(x, z) }
					got = got + 1
				end
			end
		end
		return out
	end

	return P
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">MapGeo</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/MapGeo
-- REFONTE (lot 2) : géométrie PURE de la carte 700 x 500 (Config.Map2 et Config.TERR), testée hors de Roblox. Source unique pour Builder, Scenery,
-- Placement, la mini-carte et les tests : bases orientées vers la place (spawn devant), territoires, chemins, eau (lacs, rivières en polylignes,
-- fontaine, douve), murs invisibles de la rivière du Nord coupés aux ponts, hauteur du sol (plateau du château, collines), accessibilité d'un point.
-- Nord = -Z, Est = +X. Aucun service Roblox ; pas de math.atan2. Utilisation : require(MapGeo).new(Config).
local MapGeo = {}

local function dist(ax, az, bx, bz)
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end
MapGeo.dist = dist

local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / len2)) or 0
	return dist(px, pz, ax + dx * t, az + dz * t)
end
MapGeo.distToSegment = distToSegment

-- Distance d'un point à une polyligne { {x, z}, ... }.
function MapGeo.distToPoly(px, pz, pts)
	local best = math.huge
	for k = 1, #pts - 1 do
		best = math.min(best, distToSegment(px, pz, pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]))
	end
	return best
end

function MapGeo.polyLength(pts)
	local total = 0
	for k = 1, #pts - 1 do
		total = total + dist(pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2])
	end
	return total
end

local function cross(ax, az, bx, bz)
	return ax * bz - az * bx
end

-- Les segments [A, B] et [C, D] se coupent-ils (contact compris) ? Deux segments parallèles ne se coupent pas (un mur ne se longe pas « à travers »).
function MapGeo.segmentsCross(ax, az, bx, bz, cx, cz, dx, dz)
	local rx, rz = bx - ax, bz - az
	local sx, sz = dx - cx, dz - cz
	local den = cross(rx, rz, sx, sz)
	if math.abs(den) < 1e-12 then
		return false
	end
	local t = cross(cx - ax, cz - az, sx, sz) / den
	local u = cross(cx - ax, cz - az, rx, rz) / den
	return t >= -1e-9 and t <= 1 + 1e-9 and u >= -1e-9 and u <= 1 + 1e-9
end

-- Colline en calotte sphérique (rayon au sol r, hauteur h) : rayon de la sphère et hauteur de son centre (sous le sol).
function MapGeo.hillSphere(hill)
	local R = (hill.r * hill.r + hill.h * hill.h) / (2 * hill.h)
	return R, hill.h - R
end

local cache = setmetatable({}, { __mode = "k" })

function MapGeo.new(Config, fresh)
	if cache[Config] and not fresh then
		return cache[Config]
	end
	local M = Config.Map2
	local G = { M = M }
	cache[Config] = G
	local B = M.bounds

	function G.inBounds(x, z, margin)
		margin = margin or 0
		return x >= B.x0 + margin and x <= B.x1 - margin and z >= B.z0 + margin and z <= B.z1 - margin
	end

	---------------------------------------------------------------- Bases : façade (-Z local) tournée vers la place, spawn devant
	G.bases = {}
	for i, b in ipairs(M.bases) do
		local d = dist(b.x, b.z, M.plaza.x, M.plaza.z)
		local fx, fz = (M.plaza.x - b.x) / d, (M.plaza.z - b.z) / d
		G.bases[i] = { i = i, x = b.x, z = b.z, fx = fx, fz = fz, half = M.baseSizeMax / 2, spawn = { x = b.x + fx * M.spawnForward, z = b.z + fz * M.spawnForward } }
	end
	-- Coordonnées locales d'un point dans la base i : (avant = vers la place, côté = à droite).
	function G.baseLocal(i, x, z)
		local b = G.bases[i]
		local rx, rz = x - b.x, z - b.z
		return rx * b.fx + rz * b.fz, rx * -b.fz + rz * b.fx
	end
	-- Distance d'un point au carré de la base i (demi-côté `half`, par défaut l'emprise maximale) ; 0 dedans.
	function G.distToBase(i, x, z, half)
		local a, s = G.baseLocal(i, x, z)
		half = half or G.bases[i].half
		local ex, ez = math.max(0, math.abs(a) - half), math.max(0, math.abs(s) - half)
		return math.sqrt(ex * ex + ez * ez)
	end

	---------------------------------------------------------------- Territoires (Config.TERR, ordre TERR_ORDER)
	G.terrs = {}
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		local ex, ez = Config.territoryEntry(key)
		G.terrs[#G.terrs + 1] = { key = key, x = t.x, z = t.z, r = t.r, rival = t.rival, guards = t.guards, nests = t.nests, posts = t.posts or {}, entry = { x = ex, z = ez }, data = t }
	end
	function G.terr(key)
		for _, t in ipairs(G.terrs) do
			if t.key == key then
				return t
			end
		end
		return nil
	end
	-- Territoire qui contient (x, z) (marge facultative), ou nil.
	function G.terrAt(x, z, margin)
		for _, t in ipairs(G.terrs) do
			if dist(x, z, t.x, t.z) < t.r + (margin or 0) then
				return t
			end
		end
		return nil
	end

	---------------------------------------------------------------- Chemins
	G.paths = M.paths
	-- Segments de tous les chemins : { ax, az, bx, bz, half, name, y }.
	G.pathSegs = {}
	for _, p in ipairs(M.paths) do
		local half = p.kind == "dirt" and M.dirtHalf or M.pathHalf
		for k = 1, #p.pts - 1 do
			G.pathSegs[#G.pathSegs + 1] = { p.pts[k][1], p.pts[k][2], p.pts[k + 1][1], p.pts[k + 1][2], half = half, name = p.name, y = p.y or 0 }
		end
	end
	function G.path(name)
		for _, p in ipairs(M.paths) do
			if p.name == name then
				return p
			end
		end
		return nil
	end
	-- Distance au bord du chemin le plus proche (négative sur le chemin).
	function G.pathEdgeDist(x, z)
		local best = math.huge
		for _, s in ipairs(G.pathSegs) do
			best = math.min(best, distToSegment(x, z, s[1], s[2], s[3], s[4]) - s.half)
		end
		return best
	end

	---------------------------------------------------------------- Eau
	-- Distance au bord de l'eau la plus proche (négative dans l'eau) et son nom. withShore : la rive de sable des lacs compte comme de l'eau.
	function G.waterEdgeDist(x, z, withShore)
		local best, name = math.huge, nil
		local function try(d, n)
			if d < best then
				best, name = d, n
			end
		end
		for _, lk in ipairs(M.lakes) do
			try(dist(x, z, lk.x, lk.z) - lk.r - (withShore and lk.shore or 0), lk.name)
		end
		for _, rv in ipairs(M.rivers) do
			try(MapGeo.distToPoly(x, z, rv.pts) - rv.width / 2, rv.name)
		end
		try(dist(x, z, M.fountain.x, M.fountain.z) - M.fountain.r, "Fountain")
		local mo = G.moat
		local ex = math.max(mo.x0 - x, 0, x - mo.x1)
		local ez = math.max(mo.z0 - z, 0, z - mo.z1)
		try(math.sqrt(ex * ex + ez * ez) - ((ex == 0 and ez == 0) and 0.01 or 0), "CastleMoat")
		return best, name
	end
	-- Douve décorative : bande de 6 au pied de la falaise sud du château, entre la rivière et le plateau.
	G.moat = { x0 = M.castle.x0 + 8, x1 = M.castle.x1, z0 = M.castle.z1, z1 = M.castle.z1 + 6 }

	---------------------------------------------------------------- Ponts et murs de la rivière du Nord
	-- Pont : rivière franchie (la plus proche), point de franchissement sur la rivière, demi-passage dans le mur.
	G.bridges = {}
	for _, b in ipairs(M.bridges) do
		local bestR, bestD = nil, math.huge
		for ri, rv in ipairs(M.rivers) do
			local d = MapGeo.distToPoly(b.x, b.z, rv.pts)
			if d < bestD then
				bestR, bestD = ri, d
			end
		end
		local pts = M.rivers[bestR].pts
		local cxp, czp, cd = b.x, b.z, math.huge -- point de la rivière le plus proche du centre du pont
		for k = 1, #pts - 1 do
			local ax, az, bx, bz = pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]
			local dx, dz = bx - ax, bz - az
			local t = math.max(0, math.min(1, ((b.x - ax) * dx + (b.z - az) * dz) / (dx * dx + dz * dz)))
			local qx, qz = ax + dx * t, az + dz * t
			local d = dist(b.x, b.z, qx, qz)
			if d < cd then
				cxp, czp, cd = qx, qz, d
			end
		end
		G.bridges[#G.bridges + 1] = { name = b.name, x = b.x, z = b.z, axis = b.axis, w = b.w, len = b.len, stone = b.stone, river = bestR, cross = { x = cxp, z = czp }, gapHalf = math.max(b.w / 2, M.bridgeHalfGap) }
	end
	-- Murs invisibles de la rivière du Nord (rivière 1) : sa ligne médiane découpée, sans les passages des ponts. { {ax, az, bx, bz}, ... }
	function G.riverWalls(ri)
		ri = ri or 1
		local pts = M.rivers[ri].pts
		local gaps = {}
		for _, b in ipairs(G.bridges) do
			if b.river == ri then
				gaps[#gaps + 1] = b
			end
		end
		local out = {}
		for k = 1, #pts - 1 do
			local ax, az, bx, bz = pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]
			local dx, dz = bx - ax, bz - az
			local len = math.sqrt(dx * dx + dz * dz)
			local cuts = {} -- intervalles [t0, t1] retirés (points à moins de gapHalf du point de franchissement)
			for _, b in ipairs(gaps) do
				-- |A + t D - C|^2 = g^2  ->  t^2 L^2 + 2 t (A-C).D + |A-C|^2 - g^2 = 0
				local ox, oz = ax - b.cross.x, az - b.cross.z
				local qa, qb, qc = len * len, 2 * (ox * dx + oz * dz), ox * ox + oz * oz - b.gapHalf * b.gapHalf
				local disc = qb * qb - 4 * qa * qc
				if disc > 0 then
					local s = math.sqrt(disc)
					local t0, t1 = (-qb - s) / (2 * qa), (-qb + s) / (2 * qa)
					if t1 > 0 and t0 < 1 then
						cuts[#cuts + 1] = { math.max(0, t0), math.min(1, t1) }
					end
				end
			end
			table.sort(cuts, function(p, q)
				return p[1] < q[1]
			end)
			local from = 0
			local function add(t0, t1)
				if (t1 - t0) * len > 0.5 then
					out[#out + 1] = { ax + dx * t0, az + dz * t0, ax + dx * t1, az + dz * t1 }
				end
			end
			for _, c in ipairs(cuts) do
				add(from, c[1])
				from = math.max(from, c[2])
			end
			add(from, 1)
		end
		return out
	end
	-- Le trajet [A, B] traverse-t-il un mur de la rivière du Nord ?
	function G.crossesRiverWall(ax, az, bx, bz)
		for _, w in ipairs(G.riverWalls(1)) do
			if MapGeo.segmentsCross(ax, az, bx, bz, w[1], w[2], w[3], w[4]) then
				return true
			end
		end
		return false
	end

	---------------------------------------------------------------- Relief : plateau du château, collines
	local C = M.castle
	-- Palier du pont du château : relie le pont (dont la moitié ouest dépasse du plateau) au plateau.
	G.landing = { x0 = C.x0 - 7, x1 = C.x0, z0 = C.z1 - 8, z1 = C.z1 }
	function G.onPlateau(x, z)
		return (x >= C.x0 and x <= C.x1 and z >= C.z0 and z <= C.z1) or (x >= G.landing.x0 and x <= G.landing.x1 and z >= G.landing.z0 and z <= G.landing.z1)
	end
	function G.hillHeight(x, z)
		local best = 0
		for _, h in ipairs(M.hills) do
			local d = dist(x, z, h.x, h.z)
			if d < h.r then
				local R, cy = MapGeo.hillSphere(h)
				best = math.max(best, math.sqrt(R * R - d * d) + cy)
			end
		end
		return best
	end
	-- Hauteur du sol : plateau du château, sinon colline, sinon 0.
	function G.groundY(x, z)
		if G.onPlateau(x, z) then
			return C.h
		end
		return G.hillHeight(x, z)
	end

	---------------------------------------------------------------- Accessibilité (plumes, arrivées) : approximation documentée
	-- Un point est atteignable s'il est dans les bornes, hors de l'eau (sauf sur un ponton), hors des bâtiments pleins (donjon, cabane), et pas dans la
	-- bande close entre la rivière du Nord et la falaise du château (à l'est du pont : on n'y accède ni par le pont ni par le plateau).
	G.docks = {}
	for _, dk in ipairs(M.docks) do
		local lk = M.lakes[dk.lake]
		local d = dist(dk.x, dk.z, lk.x, lk.z)
		local ux, uz = (lk.x - dk.x) / d, (lk.z - dk.z) / d -- vers le centre du lac
		G.docks[#G.docks + 1] = { ax = dk.x - ux * 4, az = dk.z - uz * 4, bx = dk.x + ux * dk.len, bz = dk.z + uz * dk.len, w = dk.w, lake = dk.lake }
	end
	function G.onDock(x, z)
		for _, dk in ipairs(G.docks) do
			if distToSegment(x, z, dk.ax, dk.az, dk.bx, dk.bz) <= dk.w / 2 then
				return true
			end
		end
		return false
	end
	G.keep = { x = C.keep.x, z = C.keep.z, half = 12 }
	function G.reachable(x, z)
		if not G.inBounds(x, z, 2) then
			return false, "bord"
		end
		if not G.onDock(x, z) and G.waterEdgeDist(x, z, false) < 1 then
			return false, "eau"
		end
		if math.abs(x - G.keep.x) < G.keep.half and math.abs(z - G.keep.z) < G.keep.half then
			return false, "donjon"
		end
		local cab = M.cabin
		if math.abs(x - cab.x) < cab.w / 2 and math.abs(z - cab.z) < cab.d / 2 then
			return false, "cabane"
		end
		if x > C.x0 + 6 and z > C.z1 and z < C.z1 + 30 then -- entre le plateau et la rivière, à l'est du pont : bande close
			local rz = nil
			local pts = M.rivers[1].pts
			for k = 1, #pts - 1 do
				if x >= pts[k][1] and x <= pts[k + 1][1] then
					local t = (x - pts[k][1]) / (pts[k + 1][1] - pts[k][1])
					rz = pts[k][2] + (pts[k + 1][2] - pts[k][2]) * t
				end
			end
			if rz and z < rz then
				return false, "bande close"
			end
		end
		return true, nil
	end

	---------------------------------------------------------------- Portails et repères de la place
	G.portals = {}
	for k, p in ipairs(Config.TRAVEL2.portals) do
		local px, pz = Config.portalPad(k)
		G.portals[k] = { k = k, name = p.name, pad = { x = px, z = pz }, to = { x = p.to[1], z = p.to[2] }, back = { x = p.back[1], z = p.back[2] }, chapter = p.chapter or 0 }
	end
	G.homeArches = {}
	for i = 1, #M.bases do
		local x, z = Config.homeArch(i)
		G.homeArches[i] = { x = x, z = z }
	end

	---------------------------------------------------------------- Emprises occupées (pose du décor) : raison du blocage ou nil
	-- opts.allowDomain : l'empreinte peut être dans un territoire (cabanes, barrières) ; opts.allowPlateau : sur le plateau du château.
	local function feathers()
		local out = {}
		for _, list in pairs(Config.FEATHER_SPOTS or {}) do
			for _, f in ipairs(list) do
				out[#out + 1] = f
			end
		end
		return out
	end
	G.featherList = feathers()
	function G.blocked(x, z, r, opts)
		local margin = 1.5
		if not G.inBounds(x, z, 4 + r) then
			return "bord"
		end
		if G.waterEdgeDist(x, z, true) < r + margin then
			return "eau"
		end
		if dist(x, z, M.plaza.x, M.plaza.z) < M.plaza.r + r + margin then
			return "place"
		end
		if dist(x, z, M.bigEgg.x, M.bigEgg.z) < M.bigEgg.r + r + margin then
			return "repère"
		end
		local tr = M.track
		if math.abs(x - tr.x) < tr.w / 2 + r + margin and math.abs(z - tr.z) < tr.d / 2 + r + margin then
			return "repère"
		end
		for _, p in ipairs(G.portals) do
			if dist(x, z, p.back.x, p.back.z) < 6 + r or dist(x, z, p.to.x, p.to.z) < 4 + r then
				return "repère"
			end
		end
		local A = M.arena
		if dist(x, z, A.x, A.z) < A.r + r + margin then
			return "arène"
		end
		if G.onPlateau(x, z) or (x > C.x0 - 8 - r and x < C.x1 + r and z > C.z0 - r and z < C.z1 + r) then
			if not (opts and opts.allowPlateau) then
				return "château"
			end
		end
		for _, t in ipairs(G.terrs) do
			if dist(x, z, t.x, t.z) < t.r + r + margin and not (opts and opts.allowDomain) then
				return "domaine"
			end
		end
		if G.pathEdgeDist(x, z) < r + margin then
			return "chemin"
		end
		for _, b in ipairs(G.bridges) do
			if dist(x, z, b.x, b.z) < b.len / 2 + r then
				return "chemin"
			end
		end
		for i = 1, #G.bases do
			if G.distToBase(i, x, z) < r + 4 then
				return "base"
			end
		end
		for _, sct in ipairs(Config.SECRETS) do
			if dist(x, z, sct.x, sct.z) < 14 + r then
				return "secret"
			end
		end
		for _, f in ipairs(G.featherList) do
			if dist(x, z, f.x, f.z) < 4 + r then
				return "plume"
			end
		end
		local cab = M.cabin
		if math.abs(x - cab.x) < cab.w / 2 + r + 2 and math.abs(z - cab.z) < cab.d / 2 + r + 2 then
			return "repère"
		end
		return nil
	end

	return G
end

return MapGeo
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Culling</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Culling
-- Masquage des zones éloignées, côté client, SANS toucher à StreamingEnabled : logique PURE testée hors de Roblox. Une zone (domaine : plateau et contenu) plus
-- loin que `cullAt` du joueur est masquée (transparence locale, lumières, particules et étiquettes coupées) ; elle réapparaît en dessous de `showAt`
-- (hystérésis : pas de clignotement à la limite). Le travail est découpé en lots (`chunks`) pour ne jamais bloquer une image.
local Culling = {}

-- Retourne true si la zone doit être MASQUÉE. wasCulled : état actuel. Distance invalide (nil, NaN) : on ne masque rien (sûr).
function Culling.decide(distance, wasCulled, cullAt, showAt)
	if type(distance) ~= "number" or distance ~= distance then
		return false
	end
	if wasCulled then
		return distance > showAt
	end
	return distance > cullAt
end

-- Distance horizontale d'un point à une zone circulaire, bord compris (0 dans la zone).
function Culling.distanceTo(px, pz, zone)
	local d = math.sqrt((px - zone.x) ^ 2 + (pz - zone.z) ^ 2) - zone.radius
	return d > 0 and d or 0
end

-- Découpe une liste en lots de `size` éléments (au moins 1).
function Culling.chunks(list, size)
	size = math.max(1, math.floor(size or 1))
	local out = {}
	for i = 1, #list, size do
		local lot = {}
		for j = i, math.min(i + size - 1, #list) do
			lot[#lot + 1] = list[j]
		end
		out[#out + 1] = lot
	end
	return out
end

return Culling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">AssetReportUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/AssetReportUi
-- Diagnostic visible des modèles Blender (Config.Debug.AssetReport) : petite étiquette « Blender N/M » en bas à gauche (hub et partie) ; un clic ou F4 ouvre le
-- rapport complet (catégories et échecs : nom, ID, message). Le rapport vient du serveur (StringValue « AssetReport » dans ReplicatedStorage), imprimé aussi
-- dans la console client par lignes « [Assets] ». Tout sous pcall, jamais d'erreur.
local AssetReportUi = {}

-- Texte de l'étiquette : « Blender N/M » (ou « Blender … » tant que le rapport n'est pas arrivé).
function AssetReportUi.label(loaded, requested)
	if type(loaded) ~= "number" or type(requested) ~= "number" then
		return "Blender …"
	end
	return ("Blender %d/%d"):format(loaded, requested)
end

function AssetReportUi.start(Config, player, ReplicatedStorage, UserInputService)
	if not (Config.Debug and Config.Debug.AssetReport) then
		return nil
	end
	local ok, gui = pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "AssetReport"
		g.ResetOnSpawn = false
		g.DisplayOrder = 90
		local lbl = Instance.new("TextButton")
		lbl.Name = "Label"
		lbl.AnchorPoint = Vector2.new(0, 1)
		lbl.Position = UDim2.new(0, 8, 1, -8)
		lbl.Size = UDim2.fromOffset(130, 22)
		lbl.BackgroundColor3 = Color3.new(0, 0, 0)
		lbl.BackgroundTransparency = 0.5
		lbl.Font = Enum.Font.Code
		lbl.TextSize = 13
		lbl.TextColor3 = Color3.fromRGB(190, 255, 190)
		lbl.Text = AssetReportUi.label(nil, nil)
		lbl.AutoButtonColor = false
		lbl.Parent = g
		local box = Instance.new("TextLabel")
		box.Name = "Details"
		box.AnchorPoint = Vector2.new(0, 1)
		box.Position = UDim2.new(0, 8, 1, -34)
		box.Size = UDim2.new(0.8, 0, 0.6, 0)
		box.BackgroundColor3 = Color3.new(0, 0, 0)
		box.BackgroundTransparency = 0.25
		box.Font = Enum.Font.Code
		box.TextSize = 12
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
		box.TextWrapped = true
		box.Visible = false
		box.Text = ""
		box.Parent = g
		lbl.Activated:Connect(function()
			box.Visible = not box.Visible
		end)
		g.Parent = player:WaitForChild("PlayerGui")
		return g
	end)
	if not ok then
		return nil
	end
	task.spawn(function()
		local rv = ReplicatedStorage:WaitForChild("AssetReport", 120)
		if not rv then
			pcall(function()
				gui.Label.Text = "Blender : pas de rapport"
			end)
			return
		end
		pcall(function()
			gui.Label.Text = AssetReportUi.label(rv:GetAttribute("Loaded"), rv:GetAttribute("Requested"))
			gui.Details.Text = rv.Value
			for line in rv.Value:gmatch("[^\n]+") do
				print(line) -- rapport dans la console client
			end
		end)
	end)
	pcall(function()
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F4 then
				gui.Details.Visible = not gui.Details.Visible
			end
		end)
	end)
	return gui
end

return AssetReportUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">MiniMap</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/MiniMap
-- Mini-carte : projection PURE (testée) d'un point du monde vers un disque centré sur le joueur, nord en haut (axe -Z vers le haut de l'écran).
-- `radius` = studs représentés du centre au bord, `half` = demi-taille du disque en pixels. Les repères importants (base, zones, portails) sont ramenés
-- au bord quand ils sont trop loin (`clamp`), les autres (gardiens) disparaissent hors du disque.
local MiniMap = {}

function MiniMap.place(px, pz, x, z, radius, half, clamp)
	if type(px) ~= "number" or type(pz) ~= "number" or type(x) ~= "number" or type(z) ~= "number" or x ~= x or z ~= z or px ~= px or pz ~= pz or radius <= 0 then
		return nil
	end
	local dx, dz = x - px, z - pz
	local d = math.sqrt(dx * dx + dz * dz)
	if d > radius then
		if not clamp then
			return nil
		end
		dx, dz = dx / d * radius, dz / d * radius
	end
	return dx / radius * half, dz / radius * half -- (droite, bas) en pixels depuis le centre
end

-- Repères du monde : { {kind, x, z, label, locked} } (REFONTE lot 2) : ta base (🏠), les autres bases (kind « plot »), les territoires (zones ;
-- grisés si verrouillés), les portails de la rose (grisés si verrouillés). Pur : ne lit que Config et la position de la base.
function MiniMap.landmarks(Config, plotX, plotZ, chaptersDone)
	local out = {}
	if plotX then
		out[#out + 1] = { kind = "base", x = plotX, z = plotZ, label = "🏠" }
	end
	for _, b in ipairs(Config.Map2.bases) do
		if not (plotX and math.abs(b.x - plotX) < 1 and math.abs(b.z - plotZ) < 1) then
			out[#out + 1] = { kind = "plot", x = b.x, z = b.z, label = "⬜" }
		end
	end
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		local riv = Config.RIVALS[t.rival]
		out[#out + 1] = { kind = "zone", x = t.x, z = t.z, label = riv and riv.emoji or "🧺", locked = riv ~= nil and not Config.zoneUnlocked(chaptersDone or 0, t.rival), key = key }
	end
	for k = 1, #Config.TRAVEL2.portals do
		local px, pz = Config.portalPad(k)
		out[#out + 1] = { kind = "portal", x = px, z = pz, label = "🌀", locked = not Config.portalUnlocked(chaptersDone or 0, k) }
	end
	return out
end

-- Plumes dorées non ramassées à moins de `range` studs (icône 🪶, REFONTE lot 6). spots = { { x, z } } publiés par le serveur (étape 1 seulement).
function MiniMap.featherMarks(spots, px, pz, range)
	local out = {}
	if type(spots) ~= "table" or type(px) ~= "number" or type(pz) ~= "number" or px ~= px or pz ~= pz then
		return out
	end
	for _, sp in ipairs(spots) do
		if type(sp.x) == "number" and type(sp.z) == "number" then
			local dx, dz = sp.x - px, sp.z - pz
			if dx * dx + dz * dz <= range * range then
				out[#out + 1] = { kind = "feather", x = sp.x, z = sp.z, label = "🪶" }
			end
		end
	end
	return out
end

return MiniMap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Battle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Battle
-- Moteur de combat PUR (aucun service Roblox) de l'Arène des pets : équipes de 3 pets, tour par tour, résolution DÉTERMINISTE d'après une graine.
-- Le serveur est la seule autorité : le client n'envoie qu'une intention (attaque, compétence, changer de pet) et rejoue les événements reçus.
-- Types (6) : roue Feu > Nature > Eau > Feu et Lumière > Ombre > Ciel > Lumière (avantage x1,5, désavantage x0,67). Une compétence par espèce.
local Battle = {}

Battle.TYPES = { "Feu", "Eau", "Nature", "Ciel", "Ombre", "Lumière" }
Battle.TYPE_EMOJI = { Feu = "🔥", Eau = "💧", Nature = "🌿", Ciel = "🌪️", Ombre = "🌑", ["Lumière"] = "✨" }
Battle.BEATS = { Feu = "Nature", Nature = "Eau", Eau = "Feu", ["Lumière"] = "Ombre", Ombre = "Ciel", Ciel = "Lumière" }
Battle.STRONG, Battle.WEAK = 1.5, 0.67
Battle.MAX_TURNS = 30

-- Type de chacune des 18 espèces (ordre de Config.PETS), 3 par type ; les 3 espèces d'une même rareté forment un TRIANGLE complet de la roue (Feu/Nature/Eau ou Lumière/Ombre/Ciel) : à rareté égale, aucune n'est favorisée.
Battle.SPECIES_TYPE = { "Ciel", "Ombre", "Lumière", "Eau", "Nature", "Feu", "Lumière", "Ombre", "Ciel", "Feu", "Nature", "Eau", "Ciel", "Ombre", "Lumière", "Nature", "Eau", "Feu" }
-- Compétence de chaque espèce : strike (dégâts x1,8), drain (dégâts x1,1 et soin du tiers), heal (soin 30 %), guard (le prochain coup ne fait que 30 %), stun (dégâts x1 et l'ennemi passe son tour), focus (attaque +25 % pendant 3 tours).
Battle.SPECIES_SKILL = { "focus", "heal", "guard", "stun", "strike", "drain", "heal", "stun", "guard", "drain", "strike", "heal", "strike", "focus", "stun", "drain", "heal", "guard" }
Battle.SKILLS = {
	strike = { name = "Coup puissant", cd = 3, mul = 1.6 },
	drain = { name = "Morsure vampire", cd = 3, mul = 1.1 },
	heal = { name = "Soin", cd = 4, heal = 0.25 },
	guard = { name = "Garde", cd = 3, keep = 0.3 },
	stun = { name = "Étourdissement", cd = 5, mul = 1.0 },
	focus = { name = "Concentration", cd = 4, boost = 1.4 },
}

-- Multiplicateur d'efficacité du type `atk` contre le type `def`.
function Battle.typeMul(atk, def)
	if Battle.BEATS[atk] == def then
		return Battle.STRONG
	elseif Battle.BEATS[def] == atk then
		return Battle.WEAK
	end
	return 1
end

-- Générateur déterministe (Park–Miller) : état = entier, retourne (valeur 0..1, nouvel état).
local function nextRnd(state)
	state = (state * 16807) % 2147483647
	return state / 2147483647, state
end
Battle.nextRnd = nextRnd

local SIZE_BONUS = { 0.95, 1, 1.05, 1.10, 1.15 }
local MUT_BONUS = { 1, 1.03, 1.05, 1.08, 1.10, 1.12 }
Battle.SIZE_BONUS, Battle.MUT_BONUS = SIZE_BONUS, MUT_BONUS

-- LOT 9, REGLE DE DESIGN (2) : stats de base par rareté (1..10). Puissance = pv + 3 x attaque + 2 x vitesse (Battle.power), strictement croissante,
-- facteur >= 1,25 entre raretés consécutives (testé). Raretés 3 à 7 (Rare .. Ultra Rare) = valeurs EXACTES de l'ancienne formule pour les anciennes
-- raretés 2 à 6 (un pet migré garde ses stats) ; le Commun passe de 60/10/12 à 50/8/12 pour laisser la place au Peu commun (règle x1,25).
Battle.STATS = {
	{ hp = 50, atk = 8, spd = 12 },
	{ hp = 68, atk = 11, spd = 12 },
	{ hp = 87, atk = 14, spd = 14 },
	{ hp = 126, atk = 20, spd = 16 },
	{ hp = 183, atk = 27, spd = 18 },
	{ hp = 265, atk = 38, spd = 20 },
	{ hp = 385, atk = 54, spd = 22 },
	{ hp = 490, atk = 68, spd = 24 },
	{ hp = 620, atk = 86, spd = 26 },
	{ hp = 785, atk = 108, spd = 28 },
}
Battle.POWER_GROWTH_MIN = 1.25
function Battle.power(st)
	return st.hp + 3 * st.atk + 2 * st.spd
end
-- Profils de combat au sein d'une rareté (lot 12 : attribués par espèce). `k` = répartition pv / attaque / vitesse, `power` = puissance visée
-- relative à l'équilibré : l'écart entre le profil le plus faible et le plus fort d'une rareté est de 8 à 15 % (1,06 / 0,94 = +12,8 %), et le
-- plus fort d'une rareté reste sous le plus faible de la suivante (testé). Rien d'achetable ne modifie ces tables.
Battle.PROFILES = {
	balanced = { k = { hp = 1, atk = 1, spd = 1 }, power = 1 },
	tank = { k = { hp = 1.3, atk = 0.85, spd = 0.85 }, power = 1.05 },
	attacker = { k = { hp = 0.85, atk = 1.3, spd = 1 }, power = 1.06 },
	fast = { k = { hp = 0.85, atk = 0.95, spd = 1.35 }, power = 0.94 },
}
function Battle.profileStats(r, profile)
	local b = Battle.STATS[r]
	local pr = Battle.PROFILES[profile] or Battle.PROFILES.balanced
	local raw = { hp = b.hp * pr.k.hp, atk = b.atk * pr.k.atk, spd = b.spd * pr.k.spd }
	local f = pr.power * Battle.power(b) / Battle.power(raw)
	return { hp = raw.hp * f, atk = raw.atk * f, spd = raw.spd * f }
end

-- Unité de combat d'un pet { p = espèce, s = taille, m = mutation } ; `scale` : multiplicateur de niveau (adversaires de la tour) ;
-- `tierOverride` : rareté des stats (étage de la tour dont la rareté n'a pas encore d'espèce : apparence d'une rareté inférieure, stats de l'étage).
function Battle.unit(Config, pet, scale, tierOverride)
	local def = Config.PETS[pet.p]
	local bonus = (SIZE_BONUS[pet.s] or 1) * (MUT_BONUS[pet.m] or 1) * (scale or 1)
	local t = tierOverride or def.tier
	local st = Battle.STATS[math.min(math.max(t, 1), #Battle.STATS)]
	local hp = math.floor(st.hp * bonus + 0.5)
	return {
		p = pet.p, s = pet.s, m = pet.m, tier = t,
		type = Battle.SPECIES_TYPE[pet.p], skill = Battle.SPECIES_SKILL[pet.p],
		maxHp = hp, hp = hp, atk = math.floor(st.atk * bonus + 0.5), spd = st.spd,
		cd = 0, guard = false, stun = 0, focus = 0,
	}
end

local function copyUnit(u)
	local c = {}
	for k, v in pairs(u) do
		c[k] = v
	end
	return c
end

-- Nouveau combat. teamA/teamB : listes d'unités (Battle.unit). Camp A = joueur (ou attaquant), camp B = adversaire (ou défenseur).
function Battle.new(seed, teamA, teamB)
	local function side(team)
		local units = {}
		for i, u in ipairs(team) do
			units[i] = copyUnit(u)
		end
		return { units = units, active = 1 }
	end
	return { seed = seed, rnd = (math.floor(seed) % 2147483646) + 1, turn = 0, sides = { side(teamA), side(teamB) }, over = false, winner = nil, log = {} }
end

local function alive(u)
	return u.hp > 0
end

local function activeOf(st, i)
	local sd = st.sides[i]
	return sd.units[sd.active]
end

local function firstAlive(sd, from)
	for k = 0, #sd.units - 1 do
		local idx = ((from - 1 + k) % #sd.units) + 1
		if alive(sd.units[idx]) then
			return idx
		end
	end
	return nil
end

-- Actions : { kind = "attack" } | { kind = "skill" } | { kind = "swap", to = n }. Retourne nil si valide, sinon la raison du refus.
function Battle.validate(st, sideIdx, action)
	if type(action) ~= "table" then
		return "action invalide"
	end
	local sd = st.sides[sideIdx]
	local u = sd.units[sd.active]
	if action.kind == "attack" then
		return nil
	elseif action.kind == "skill" then
		if u.cd > 0 then
			return "compétence en recharge"
		end
		return nil
	elseif action.kind == "swap" then
		local to = action.to
		if type(to) ~= "number" or to % 1 ~= 0 or not sd.units[to] then
			return "pet inconnu"
		elseif to == sd.active or not alive(sd.units[to]) then
			return "pet indisponible"
		end
		return nil
	end
	return "action inconnue"
end

-- Action de l'IA (déterministe) : compétence si prête et utile, sinon attaque ; change de pet quand le type est très défavorable et qu'un meilleur existe.
function Battle.aiAction(st, sideIdx)
	local sd, foe = st.sides[sideIdx], activeOf(st, 3 - sideIdx)
	local u = sd.units[sd.active]
	if Battle.typeMul(foe.type, u.type) > 1 then
		for i, o in ipairs(sd.units) do
			if i ~= sd.active and alive(o) and Battle.typeMul(foe.type, o.type) <= 1 and u.hp < u.maxHp * 0.6 then
				return { kind = "swap", to = i }
			end
		end
	end
	if u.cd == 0 then
		local sk = u.skill
		if sk == "heal" and u.hp > u.maxHp * 0.6 then
			return { kind = "attack" }
		end
		return { kind = "skill" }
	end
	return { kind = "attack" }
end

local function emit(st, ev)
	st.log[#st.log + 1] = ev
	return ev
end

-- Inflige des dégâts de `side` (attaquant) à l'unité active adverse ; retourne les dégâts.
local function strike(st, atkSide, mul)
	local a, d = activeOf(st, atkSide), activeOf(st, 3 - atkSide)
	local r
	r, st.rnd = nextRnd(st.rnd)
	local tm = Battle.typeMul(a.type, d.type)
	local atk = a.atk * (a.focus > 0 and Battle.SKILLS.focus.boost or 1)
	local dmg = math.max(1, math.floor(atk * mul * tm * (0.9 + 0.2 * r) + 0.5))
	if d.guard then
		dmg = math.max(1, math.floor(dmg * Battle.SKILLS.guard.keep))
		d.guard = false
	end
	d.hp = math.max(0, d.hp - dmg)
	return dmg, tm
end

local function perform(st, sideIdx, action)
	local sd = st.sides[sideIdx]
	local u = sd.units[sd.active]
	if not alive(u) then
		return
	end
	if u.stun > 0 then
		u.stun = u.stun - 1
		emit(st, { t = "stunned", side = sideIdx, p = u.p })
		return
	end
	if action.kind == "swap" then
		sd.active = action.to
		emit(st, { t = "swap", side = sideIdx, to = action.to, p = sd.units[action.to].p })
		return
	end
	local foe = activeOf(st, 3 - sideIdx)
	if action.kind == "skill" and u.cd == 0 then
		local sk = Battle.SKILLS[u.skill]
		u.cd = sk.cd
		if u.skill == "heal" then
			local h = math.min(u.maxHp - u.hp, math.floor(u.maxHp * sk.heal + 0.5))
			u.hp = u.hp + h
			emit(st, { t = "heal", side = sideIdx, amount = h, skill = u.skill, p = u.p })
		elseif u.skill == "guard" then
			u.guard = true
			emit(st, { t = "guard", side = sideIdx, skill = u.skill, p = u.p })
		elseif u.skill == "focus" then
			u.focus = 3
			emit(st, { t = "buff", side = sideIdx, skill = u.skill, p = u.p })
		else
			local dmg, tm = strike(st, sideIdx, sk.mul)
			emit(st, { t = "hit", side = sideIdx, dmg = dmg, mul = tm, skill = u.skill, hp = foe.hp, p = u.p, target = foe.p })
			if u.skill == "drain" then
				local h = math.min(u.maxHp - u.hp, math.floor(dmg / 3))
				u.hp = u.hp + h
			elseif u.skill == "stun" and foe.hp > 0 then
				foe.stun = 1
			end
		end
	else
		local dmg, tm = strike(st, sideIdx, 1)
		emit(st, { t = "hit", side = sideIdx, dmg = dmg, mul = tm, hp = foe.hp, p = u.p, target = foe.p })
	end
end

local function settle(st)
	for i = 1, 2 do
		local sd = st.sides[i]
		if not alive(sd.units[sd.active]) then
			local nxt = firstAlive(sd, sd.active)
			if nxt then
				sd.active = nxt
				emit(st, { t = "swap", side = i, to = nxt, forced = true, p = sd.units[nxt].p })
			else
				emit(st, { t = "ko", side = i })
			end
		end
	end
	local aOut, bOut = firstAlive(st.sides[1], 1) == nil, firstAlive(st.sides[2], 1) == nil
	if aOut or bOut then
		st.over, st.winner = true, aOut and 2 or 1
		if aOut and bOut then
			st.winner = 2 -- égalité : le défenseur l'emporte
		end
	end
end

local function totalFrac(sd)
	local hp, mx = 0, 0
	for _, u in ipairs(sd.units) do
		hp, mx = hp + u.hp, mx + u.maxHp
	end
	return hp / mx
end

-- Joue UN tour : actionA = intention du camp A (validée ici ; invalide -> attaque), le camp B joue l'IA (ou actionB). Retourne les événements du tour.
function Battle.turn(st, actionA, actionB)
	if st.over then
		return {}
	end
	local from = #st.log + 1
	st.turn = st.turn + 1
	if Battle.validate(st, 1, actionA) then
		actionA = { kind = "attack" }
	end
	actionB = actionB or Battle.aiAction(st, 2)
	if Battle.validate(st, 2, actionB) then
		actionB = { kind = "attack" }
	end
	emit(st, { t = "turn", n = st.turn })
	-- les changements de pet passent en premier, puis la vitesse décide (égalité : camp A)
	local order = { 1, 2 }
	local acts = { actionA, actionB }
	local function prio(i)
		return acts[i].kind == "swap" and 1 or 0
	end
	local ua, ub = activeOf(st, 1), activeOf(st, 2)
	local tie
	tie, st.rnd = nextRnd(st.rnd)
	if prio(2) > prio(1) or (prio(2) == prio(1) and (ub.spd > ua.spd or (ub.spd == ua.spd and tie < 0.5))) then
		order = { 2, 1 }
	end
	for _, i in ipairs(order) do
		if not st.over and alive(activeOf(st, i)) then
			perform(st, i, acts[i])
			settle(st)
		end
	end
	settle(st) -- même si personne n'a pu agir (deux camps déjà à terre)
	for i = 1, 2 do -- recharges et effets qui s'estompent
		for _, u in ipairs(st.sides[i].units) do
			if u.cd > 0 then
				u.cd = u.cd - 1
			end
			if u.focus > 0 then
				u.focus = u.focus - 1
			end
		end
	end
	if not st.over and st.turn >= Battle.MAX_TURNS then
		local fa, fb = totalFrac(st.sides[1]), totalFrac(st.sides[2])
		st.over, st.winner = true, fa > fb and 1 or 2 -- limite de tours : le plus de PV restants gagne, égalité au défenseur
		emit(st, { t = "timeout" })
	end
	local out = {}
	for i = from, #st.log do
		out[#out + 1] = st.log[i]
	end
	return out
end

-- Équipe adverse de l'étage `floor` de la tour (déterministe) : 3 espèces de la rareté de l'étage, taille normale, niveau Config.towerScale.
function Battle.towerTeam(Config, floor)
	local tier = Config.towerTier(floor)
	local look = Config.liveEggTier(tier) -- lot 9 : rareté sans espèce publiée : espèces de la rareté inférieure, stats de l'étage
	local ids = {}
	for i, d in ipairs(Config.PETS) do
		if d.tier == look then
			ids[#ids + 1] = i
		end
	end
	local scale = Config.towerScale(floor)
	local team = {}
	for k = 1, Config.TOWER.teamSize do
		team[k] = Battle.unit(Config, { p = ids[(floor + k) % #ids + 1], s = 2, m = 1 }, scale, tier)
	end
	return team
end

-- Combat complet automatique (IA des deux côtés) : sert à l'équilibrage et aux tests. Retourne l'état final.
function Battle.run(seed, teamA, teamB)
	local st = Battle.new(seed, teamA, teamB)
	while not st.over do
		Battle.turn(st, Battle.aiAction(st, 1))
	end
	return st
end

-- Texte court d'un événement pour le journal : « 🐰 Lapin : Coup puissant ! 12 dégâts (super efficace) ». `side` 1 = toi.
function Battle.describe(Config, ev)
	local def = ev.p and Config.PETS[ev.p]
	local who = def and (def.emoji .. " " .. def.name) or ""
	local pre = ev.side == 1 and "" or "Adversaire · "
	if ev.t == "turn" then
		return "— Tour " .. ev.n .. " —"
	elseif ev.t == "hit" then
		local eff = ev.mul > 1 and " (super efficace !)" or (ev.mul < 1 and " (peu efficace)" or "")
		local sk = ev.skill and (Battle.SKILLS[ev.skill].name .. " ! ") or ""
		return pre .. who .. " : " .. sk .. ev.dmg .. " dégâts" .. eff
	elseif ev.t == "heal" then
		return pre .. who .. " se soigne de " .. ev.amount
	elseif ev.t == "guard" then
		return pre .. who .. " se met en garde"
	elseif ev.t == "buff" then
		return pre .. who .. " se concentre (attaque +40 %)"
	elseif ev.t == "stunned" then
		return pre .. who .. " est étourdi et passe son tour"
	elseif ev.t == "swap" then
		return pre .. (ev.forced and "envoie " or "change pour ") .. who
	elseif ev.t == "ko" then
		return (ev.side == 1 and "Ton équipe est" or "L'équipe adverse est") .. " à terre"
	elseif ev.t == "timeout" then
		return "Limite de " .. Battle.MAX_TURNS .. " tours : les PV restants décident"
	end
	return ""
end

-- Vue minimale d'un camp pour l'interface (aucune donnée de graine).
function Battle.view(st)
	local out = { turn = st.turn, over = st.over, winner = st.winner, sides = {} }
	for i = 1, 2 do
		local sd = st.sides[i]
		local units = {}
		for k, u in ipairs(sd.units) do
			units[k] = { p = u.p, s = u.s, m = u.m, type = u.type, hp = u.hp, maxHp = u.maxHp, cd = u.cd, skill = u.skill, guard = u.guard, stun = u.stun, focus = u.focus }
		end
		out.sides[i] = { units = units, active = sd.active }
	end
	return out
end

return Battle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Layout</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Layout
-- Disposition PURE de l'interface fixe (HUD) : tout est ancré aux bords (compteurs et objectif à gauche, bannière et notifications en haut
-- à droite, conseils en bas à gauche, boutons de menu en colonne en bas à droite) ; la zone centrale reste libre pour voir le personnage.
-- Testée avec une matrice d'appareils (tests/run.luau). Unités : pixels « de conception » ; le HUD est mis à l'échelle par `scale`.
local Layout = {}

Layout.MIN_SCALE = 0.85 -- en dessous, les boutons passent sous 44 px (cible tactile minimale)
Layout.MAX_SCALE = 1.25
Layout.EDGE = 8
Layout.NAV_BUTTON = 52
Layout.NAV_GAP = 4
-- Zone centrale à garder libre (en fraction de l'écran) : le personnage et la caméra.
Layout.CENTER = { x0 = 0.32, x1 = 0.68, y0 = 0.32, y1 = 0.75 }

function Layout.scaleFor(vw, vh)
	local s = math.min(vw / 900, vh / 520)
	if s ~= s then
		s = 1
	end
	return math.max(Layout.MIN_SCALE, math.min(Layout.MAX_SCALE, s))
end

-- Rectangles { x, y, w, h } en pixels de conception pour un écran de vw x vh pixels réels. Retourne (rects, scale, dw, dh).
function Layout.rects(vw, vh, navCount)
	navCount = navCount or 6
	local s = Layout.scaleFor(vw, vh)
	local dw, dh = vw / s, vh / s
	local e = Layout.EDGE
	local navH = navCount * Layout.NAV_BUTTON + (navCount - 1) * Layout.NAV_GAP
	local navW = Layout.NAV_BUTTON
	local rightW = math.min(330, math.max(180, dw - 196 - 3 * e)) -- bannière et notifications : à droite des compteurs
	local nav = { x = dw - e - navW, y = dh - e - navH, w = navW, h = navH }
	-- Notifications : sous la bannière, à droite des compteurs ; décalées à gauche de la colonne de menu si celle-ci monte jusqu'à elles.
	local toastsTop, toastsH = e + 46, 76
	local right = (nav.y < toastsTop + toastsH) and (nav.x - e) or (dw - e)
	local toastsW = math.min(240, right - (e + 196 + e))
	local r = {
		pillCoins = { x = e, y = e, w = 196, h = 52 },
		pillSpeed = { x = e, y = e + 58, w = 196, h = 52 },
		objective = { x = e, y = e + 118, w = 196, h = 78 },
		carry = { x = e, y = e + 204, w = 170, h = 26 },
		hp = { x = e, y = dh - e - 44 - 28, w = 170, h = 22 }, -- au-dessus des conseils, bas gauche (jamais au centre)
		banner = { x = dw - e - rightW, y = e, w = rightW, h = 40 },
		toasts = { x = right - toastsW, y = toastsTop, w = toastsW, h = toastsH },
		nav = nav,
		hint = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 },
		offer = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 }, -- offre d'achat non bloquante : prend la place du conseil (jamais les deux)
	}
	return r, s, dw, dh
end

local function overlap(a, b)
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end
Layout.overlap = overlap

-- Zone centrale à garder libre, en pixels de conception pour cet écran.
function Layout.centerRect(vw, vh)
	local s = Layout.scaleFor(vw, vh)
	local c = Layout.CENTER
	return { x = c.x0 * vw / s, y = c.y0 * vh / s, w = (c.x1 - c.x0) * vw / s, h = (c.y1 - c.y0) * vh / s }
end

return Layout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Party</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Party
-- Logique PURE du hub : file d'attente des zones de lancement (1 à 5 joueurs), création de partie, registre des parties ouvertes
-- (visibles des amis), rejoindre en cours de partie, repli de téléportation. Toutes les dépendances Roblox sont injectées pour pouvoir
-- tester avec un faux TeleportService (tests/run.luau). Aucune erreur ne sort de ce module : les échecs sont des valeurs de retour.
--   deps.clock() -> secondes
--   deps.reserve(placeId) -> accessCode            (réel : TeleportService:ReserveServer ; peut lever une erreur)
--   deps.teleport(players, placeId, accessCode|nil, data)   (réel : TeleportToPrivateServer / TeleportAsync ; peut lever une erreur)
--   deps.store : { get(key), update(key, fn) , remove(key), list() }   (réel : MemoryStoreService ; peut lever une erreur)
--   deps.log(msg) (facultatif)
local Party = {}

-- Un serveur de jeu accepte-t-il un joueur de plus ? count = joueurs déjà présents.
function Party.admit(count, max)
	return count < max
end

-- Admission d'un joueur dans un serveur de JEU. serverPartyId = identifiant de partie du serveur (celui du premier arrivé, nil si aucun),
-- data = TeleportData reçu à l'arrivée (nil si arrivée directe), count = joueurs déjà présents, role = Config.Game.roleFor(PlaceId).
-- Liste blanche : sur un serveur de partie, seul un joueur envoyé par le hub avec LE MÊME partyId entre. Retourne (true) ou (false, raison).
function Party.admitJoin(serverPartyId, data, count, max, role)
	if not Party.admit(count, max) then
		return false, "full"
	end
	if role ~= "game" then
		return true -- Studio / place non publiée : pas de liste blanche
	end
	local pid = type(data) == "table" and data.partyId or nil
	if serverPartyId ~= nil then
		if pid ~= serverPartyId or data.from ~= "hub" then
			return false, "not_member"
		end
	elseif pid ~= nil and data.from ~= "hub" then
		return false, "not_member"
	end
	return true
end

-- Retour d'un joueur de la partie vers le hub. deps.teleport(players, placeId, nil, data) peut lever une erreur (réseau, lieu non autorisé).
-- Retourne { ok = true } ou { ok = false, message } : le joueur reste alors dans la partie (aucune perte), avec un message clair.
function Party.returnToHub(Config, deps, player, partyId)
	local hub = Config.Game.Places.hub
	if type(hub) ~= "number" or hub <= 0 then
		return { ok = false, message = "Le hub n'est pas configuré. Tu restes dans la partie." }
	end
	local ok, err = pcall(deps.teleport, { player }, hub, nil, { from = "game", partyId = partyId, reason = "leave" })
	if not ok then
		if deps.log then
			deps.log("[Party] retour au hub impossible : " .. tostring(err))
		end
		return { ok = false, message = "Impossible de retourner au hub pour l'instant. Tu restes dans la partie : réessaie dans un instant." }
	end
	return { ok = true }
end

-- Même message pour « inexistante », « terminée » et « tu n'es pas ami de l'hôte » : rien n'est révélé sur les parties des autres.
local GONE_MESSAGE = "Cette partie n'existe plus : elle vient de se terminer ou ton ami est parti."

function Party.new(Config, deps)
	local G = Config.Game
	local P = { queues = {}, where = {} } -- queues[clé] = { size, mode, members = {userId...}, firstAt, readyAt } ; clé = taille (arène) ou "c<taille>" (château)

	local function log(msg)
		if deps.log then
			deps.log("[Party] " .. msg)
		end
	end

	-- Clé d'une file : la taille seule pour l'arène (compatibilité), « c<taille> » pour le mode Château.
	function P.key(size, mode)
		return mode == "castle" and ("c" .. tostring(size)) or size
	end

	for _, size in ipairs(G.Sizes) do
		P.queues[size] = { size = size, mode = "arena", members = {} }
		P.queues["c" .. size] = { size = size, mode = "castle", members = {} }
	end

	---------------------------------------------------------------- zones de lancement (file d'attente)
	function P.enter(userId, size, mode)
		local key = P.key(size, mode)
		local q = P.queues[key]
		if not q then
			return false, "taille inconnue"
		end
		if P.where[userId] then
			if P.where[userId] == key then
				return true
			end
			P.leave(userId)
		end
		if #q.members >= q.size then
			return false, "zone pleine"
		end
		q.members[#q.members + 1] = userId
		P.where[userId] = key
		if #q.members == 1 then
			q.firstAt = deps.clock()
		end
		q.readyAt = nil
		return true
	end

	function P.leave(userId)
		local key = P.where[userId]
		if not key then
			return false
		end
		local q = P.queues[key]
		for i, id in ipairs(q.members) do
			if id == userId then
				table.remove(q.members, i)
				break
			end
		end
		P.where[userId] = nil
		q.readyAt = nil
		if #q.members == 0 then
			q.firstAt = nil
		end
		return true
	end

	-- État affiché d'une zone : { size, mode = "arena" | "castle", count, countdown (secondes ou nil), state = "empty" | "waiting" | "full" }
	function P.status(size, mode)
		local q = P.queues[P.key(size, mode)]
		local now = deps.clock()
		local count = #q.members
		local out = { size = size, count = count, queue = mode == "castle" and "castle" or "arena" }
		out.mode = count == 0 and "empty" or (count >= size and "full" or "waiting") -- (nom historique : état de la file)
		if count > 0 then
			if count >= size then
				q.readyAt = q.readyAt or (now + (size == 1 and G.SoloCountdown or G.CountdownFull))
				out.countdown = math.max(0, q.readyAt - now)
			else
				q.readyAt = nil
				out.countdown = math.max(0, q.firstAt + G.PartialWait - now)
			end
		end
		return out
	end

	-- Groupes prêts à partir : { size, mode, members }. Les membres sont retirés de la file.
	function P.collectLaunches()
		local out = {}
		local keys = {}
		for _, size in ipairs(G.Sizes) do
			keys[#keys + 1] = size
			keys[#keys + 1] = "c" .. size
		end
		for _, key in ipairs(keys) do
			local q = P.queues[key]
			if #q.members > 0 then
				local st = P.status(q.size, q.mode)
				if st.countdown ~= nil and st.countdown <= 0 then
					local members = table.clone(q.members)
					for _, id in ipairs(members) do
						P.where[id] = nil
					end
					q.members = {}
					q.firstAt, q.readyAt = nil, nil
					out[#out + 1] = { size = q.size, mode = q.mode, members = members }
				end
			end
		end
		return out
	end

	---------------------------------------------------------------- registre des parties
	-- Identifiant imprévisible (GUID injecté : HttpService:GenerateGUID). Jamais dérivé de l'hôte ni de l'heure.
	local function newPartyId()
		if deps.guid then
			return deps.guid()
		end
		local t = {}
		for i = 1, 4 do
			t[i] = string.format("%08x", math.random(0, 0x7fffffff))
		end
		return table.concat(t, "-")
	end

	local function alive(e)
		return type(e) == "table" and deps.clock() - (e.createdAt or 0) < G.PartyTTL
	end

	-- Teleporte un groupe vers le lieu de jeu. Essaie les méthodes de G.Fallbacks dans l'ordre.
	-- group = { size = n, members = {userId...}, players = {Player...}, hostName = "..." }
	-- Retourne { ok = true, mode, partyId? } ou { ok = false, reason, message }.
	function P.launch(group)
		local gamePlace = G.Places.game
		if type(gamePlace) ~= "number" or gamePlace <= 0 then
			return { ok = false, reason = "lieu de jeu non configuré", message = "Le lieu de jeu n'est pas configuré. Préviens le créateur." }
		end
		local size = math.min(math.max(group.size or #group.members, 1), G.MaxPlayers)
		local mode = group.mode == "castle" and "castle" or "arena"
		local data = { from = "hub", size = size, late = false, mode = mode }
		local lastErr = "aucune méthode de téléportation"
		for _, method in ipairs(G.Fallbacks) do
			if method == "reserved" then
				local okR, code = pcall(deps.reserve, gamePlace)
				if okR and code then
					local partyId = newPartyId()
					data.partyId = partyId
					local okT, errT = pcall(deps.teleport, group.players, gamePlace, code, data)
					if okT then
						local entry = {
							id = partyId, host = group.members[1], hostName = group.hostName or "?", size = G.MaxPlayers, groupSize = size, mode = mode, count = #group.members,
							members = table.clone(group.members), code = code, createdAt = deps.clock(), open = true, -- toute partie (même solo) reste ouverte aux amis jusqu'au plafond
						}
						local okS, errS = pcall(deps.store.update, partyId, function()
							return entry
						end)
						if not okS then
							log("registre indisponible : " .. tostring(errS))
						end
						return { ok = true, mode = "reserved", partyId = partyId, registered = okS }
					end
					lastErr = "téléportation : " .. tostring(errT)
				else
					lastErr = "réservation : " .. tostring(code)
				end
			elseif method == "public" then
				data.partyId = nil
				local okT, errT = pcall(deps.teleport, group.players, gamePlace, nil, data)
				if okT then
					return { ok = true, mode = "public" }
				end
				lastErr = "téléportation publique : " .. tostring(errT)
			end
		end
		log("lancement impossible : " .. tostring(lastErr))
		return { ok = false, reason = lastErr, message = "Impossible de lancer la partie pour l'instant. Réessaie dans un instant." }
	end

	-- Parties ouvertes visibles par `viewerId` : celles de ses amis (friends[userId] = true) ou celles où il est déjà inscrit.
	-- Retourne une liste triée { id, hostName, count, size }.
	function P.visibleFor(viewerId, friends)
		local okL, list = pcall(deps.store.list)
		if not okL or type(list) ~= "table" then
			return {}, false
		end
		local out = {}
		for _, e in ipairs(list) do
			if alive(e) and e.open and e.count < e.size and e.count < G.MaxPlayers then
				local mine = false
				for _, id in ipairs(e.members or {}) do
					if id == viewerId then
						mine = true
					end
				end
				if not mine and friends and friends[e.host] then
					out[#out + 1] = { id = e.id, hostName = e.hostName, count = e.count, size = e.size }
				end
			end
		end
		table.sort(out, function(a, b)
			return a.id < b.id
		end)
		return out, true
	end

	-- Rejoindre une partie en cours. Retourne { ok = true } ou { ok = false, reason = "full" | "gone" | "registry" | "teleport", message }.
	-- friends = ensemble d'amis du joueur calculé par le SERVEUR (jamais fourni par le client) : seuls les amis de l'hôte (ou un joueur déjà
	-- inscrit) peuvent rejoindre, même s'ils connaissent l'identifiant de la partie.
	function P.join(partyId, player, userId, friends)
		if type(partyId) ~= "string" then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local okG, e = pcall(deps.store.get, partyId)
		if not okG then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not alive(e) or not e.open then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local isMember = false
		for _, id in ipairs(e.members or {}) do
			if id == userId then
				isMember = true
			end
		end
		if not isMember and not (type(friends) == "table" and friends[e.host]) then
			log("refus : " .. tostring(userId) .. " n'est pas ami de l'hôte")
			return { ok = false, reason = "gone", message = GONE_MESSAGE } -- même message : ne révèle pas son existence
		end
		-- réservation atomique de la place (compte + membre) ; refus si plein
		local reserved = false
		local okU, errU = pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" or old.count >= old.size or old.count >= G.MaxPlayers then
				return nil
			end
			for _, id in ipairs(old.members) do
				if id == userId then
					return nil
				end
			end
			old.count = old.count + 1
			old.members[#old.members + 1] = userId
			reserved = true
			return old
		end)
		if not okU then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not reserved then
			return { ok = false, reason = "full", message = "Cette partie est pleine (" .. G.MaxPlayers .. " joueurs maximum)." }
		end
		local okT, errT = pcall(deps.teleport, { player }, G.Places.game, e.code, { from = "hub", partyId = partyId, size = e.size, late = true, mode = e.mode or "arena" })
		if not okT then
			P.leaveParty(partyId, userId) -- annule la place prise
			log("rejoindre : " .. tostring(errT))
			return { ok = false, reason = "teleport", message = "Impossible de rejoindre la partie pour l'instant." }
		end
		return { ok = true }
	end

	-- Libère la place d'un joueur (retour au hub, échec de téléportation). Supprime la partie quand elle est vide.
	function P.leaveParty(partyId, userId)
		pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" then
				return nil
			end
			for i, id in ipairs(old.members) do
				if id == userId then
					table.remove(old.members, i)
					old.count = math.max(0, old.count - 1)
					break
				end
			end
			return old
		end)
		-- plus personne dans la partie : elle est retirée du registre (les amis ne la voient plus, « n'existe plus » s'ils réessaient)
		local okG, e = pcall(deps.store.get, partyId)
		if okG and type(e) == "table" and e.count <= 0 then
			pcall(deps.store.remove, partyId)
		end
	end

	return P
end

return Party
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Spawn</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Spawn
-- Décisions PURES du filet anti-chute et de la garantie de personnage (testées hors Roblox). Le module SpawnGuard les applique.
local Spawn = {}

-- Réglages par rôle. floorY : en dessous, le joueur est tombé hors du monde. half : demi-côté de la zone jouable (au-delà : hors zone).
-- freefallSpeed : vitesse verticale (studs/s, négative) au-delà de laquelle une chute au-dessus du sol est anormale.
Spawn.PRESETS = {
	game = { floorY = -25, half = 590, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 400 },
	hub = { floorY = -25, half = 205, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 140 },
}

-- st = { hasChar, alive, waited, x, y, z, vy } ; waited = secondes sans personnage. Retourne nil ou une raison :
-- "nochar" (aucun personnage depuis trop longtemps), "void" (sous le sol), "freefall" (chute libre), "outside" (hors de la zone), "sky" (trop haut).
function Spawn.rescueReason(st, cfg)
	if not st.hasChar then
		if (st.waited or 0) >= cfg.noCharTimeout then
			return "nochar"
		end
		return nil
	end
	if st.alive == false or st.y == nil then
		return nil
	end
	if st.y ~= st.y or (st.x or 0) ~= (st.x or 0) or (st.z or 0) ~= (st.z or 0) then
		return "void" -- NaN : position corrompue
	end
	if st.y < cfg.floorY then
		return "void"
	end
	if math.abs(st.x or 0) > cfg.half or math.abs(st.z or 0) > cfg.half then
		return "outside"
	end
	if st.y > cfg.sky then
		return "sky"
	end
	if (st.vy or 0) < cfg.freefallSpeed and st.y < cfg.freefallY then
		return "freefall"
	end
	return nil
end

-- Compteurs de sauvetages : une boucle de sauvetages (> maxPerMinute) est signalée pour ne pas masquer un vrai bug.
function Spawn.newTally()
	local t = { counts = {}, total = 0, times = {} }
	function t.add(kind, now)
		t.counts[kind] = (t.counts[kind] or 0) + 1
		t.total = t.total + 1
		t.times[#t.times + 1] = now
		while #t.times > 0 and now - t.times[1] > 60 do
			table.remove(t.times, 1)
		end
		return #t.times
	end
	return t
end

return Spawn
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">SpawnGuard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/SpawnGuard
-- Garantit qu'un joueur a toujours un personnage dans la zone de jeu : (1) si aucun personnage n'apparaît dans les `noCharTimeout`
-- secondes (script d'arrivée planté, CharacterAutoLoads coupé), il est chargé ici ; (2) un joueur sous le sol, hors zone, trop haut ou en
-- chute libre est replacé au point de départ ; (3) chaque événement est tracé dans la console serveur avec le préfixe [Spawn].
-- Les décisions sont dans Spawn (pur, testé) ; ce module n'applique que du Roblox. Aucune erreur ne sort d'ici (tout sous pcall).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spawn = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Spawn"))

local SpawnGuard = {}

-- opts = { role = "game" | "hub", safeCFrame = function(player) -> CFrame, interval = 0.5 }
function SpawnGuard.attach(opts)
	local cfg = Spawn.PRESETS[opts.role] or Spawn.PRESETS.game
	local tally = Spawn.newTally()
	local noChar = {} -- Player -> secondes sans personnage
	local loading = {} -- Player -> true pendant un LoadCharacterAsync lancé ici
	local function log(msg)
		print("[Spawn] (" .. opts.role .. ") " .. msg)
	end

	local function safeCF(player)
		local ok, cf = pcall(opts.safeCFrame, player)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
		return CFrame.new(0, 10, 0)
	end

	local function place(player, root, reason)
		local n = tally.add(reason, os.clock())
		local cf = safeCF(player)
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		log(player.Name .. " replacé (" .. reason .. ") vers " .. string.format("%.0f, %.0f, %.0f", cf.X, cf.Y, cf.Z) .. " [" .. tally.total .. " au total]")
		if n > 6 then
			warn("[Spawn] (" .. opts.role .. ") plus de 6 sauvetages en une minute : un joueur retombe en boucle, vérifie le point de départ")
		end
	end

	Players.PlayerAdded:Connect(function(player)
		log(player.Name .. " arrivé (" .. #Players:GetPlayers() .. " joueur(s), CharacterAutoLoads = " .. tostring(Players.CharacterAutoLoads) .. ")")
		player.CharacterAdded:Connect(function(char)
			log(player.Name .. " : personnage apparu")
			task.defer(function()
				local root = char:WaitForChild("HumanoidRootPart", 5)
				if root and player.Parent then
					local st = { hasChar = true, alive = true, x = root.Position.X, y = root.Position.Y, z = root.Position.Z, vy = 0 }
					local reason = Spawn.rescueReason(st, cfg)
					if reason then
						place(player, root, reason)
					end
				end
			end)
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(opts.interval or 0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(function()
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not root then
						noChar[player] = (noChar[player] or 0) + (opts.interval or 0.5)
					else
						noChar[player] = 0
					end
					local pos = root and root.Position
					local st = {
						hasChar = root ~= nil, alive = hum == nil or hum.Health > 0, waited = noChar[player] or 0,
						x = pos and pos.X, y = pos and pos.Y, z = pos and pos.Z, vy = root and root.AssemblyLinearVelocity.Y or 0,
					}
					local reason = Spawn.rescueReason(st, cfg)
					if reason == "nochar" then
						if not loading[player] and player.Parent then
							loading[player] = true
							noChar[player] = 0
							tally.add("nochar", os.clock())
							log(player.Name .. " sans personnage depuis " .. cfg.noCharTimeout .. " s : chargement forcé")
							task.spawn(function()
								local ok, err = pcall(function()
									player:LoadCharacterAsync()
								end)
								if not ok then
									warn("[Spawn] (" .. opts.role .. ") LoadCharacterAsync a échoué pour " .. player.Name .. " : " .. tostring(err))
								end
								loading[player] = nil
							end)
						end
					elseif reason and root then
						place(player, root, reason)
					end
				end)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		noChar[player] = nil
		loading[player] = nil
	end)
	log("filet de sécurité actif (sol " .. cfg.floorY .. ", demi-zone " .. cfg.half .. ")")
	return tally
end

return SpawnGuard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Belt</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Belt
-- Tapis roulant central du marché : logique PURE (aucun service Roblox), testée. Le serveur appelle step() à 10 Hz et tryBuy() à chaque demande d'achat ;
-- le client ne fait qu'afficher. La rareté d'un œuf est tirée à son apparition et reste VISIBLE avant l'achat. Un œuf n'a qu'un acheteur (réservation atomique).
local Belt = {}

local function nextRnd(state)
	state = (state * 16807) % 2147483647
	return state / 2147483647, state
end

-- Tire une rareté (1..#weights) d'après des poids ; r dans [0, 1).
function Belt.pick(weights, r)
	local total = 0
	for _, w in ipairs(weights) do
		total = total + math.max(w, 0)
	end
	local x = r * total
	local last = #weights
	for i, w in ipairs(weights) do
		if w > 0 then
			last = i
			x = x - w
			if x < 0 then
				return i
			end
		end
	end
	return last -- jamais une rareté de poids nul (lot 9)
end

-- Prix en pièces d'un œuf de rareté `tier` au tapis : `priceRatio` du prix de la boutique (arrondi inférieur).
function Belt.price(Config, tier)
	return math.floor(Config.EGG_PRICE[tier] * Config.BELT.priceRatio)
end

function Belt.new(seed, startAt)
	return { eggs = {}, nextId = 1, rnd = (math.floor(seed) % 2147483646) + 1, nextSpawn = startAt or 0, lastBuy = {}, legendaryAt = {}, goldenUntil = 0, sold = 0, welcomed = {} }
end

-- Le tapis doré est-il actif à l'instant `now` ? Retourne les secondes restantes (0 si inactif).
function Belt.goldenLeft(st, now)
	return math.max(0, st.goldenUntil - now)
end

-- Ajoute `seconds` de tapis doré (cumulable, plafonné à `maxSeconds` restantes). `by` (optionnel) : nom du donateur, affiché sur le panneau.
function Belt.addGolden(Config, st, now, seconds, by)
	local G = Config.BELT.golden
	if type(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 then
		return Belt.goldenLeft(st, now)
	end
	local left = Belt.goldenLeft(st, now)
	st.goldenUntil = now + math.min(G.maxSeconds, left + seconds)
	if by then
		st.goldenBy = by
	end
	return Belt.goldenLeft(st, now)
end

-- « 9:05 » pour 545 secondes.
function Belt.clock(seconds)
	local n = math.max(0, math.floor((seconds or 0) + 0.999))
	return string.format("%d:%02d", n // 60, n % 60)
end

-- Contenu du panneau du tapis : les deux tables de rareté (textes de Config.beltOddsText, donc identiques à la config), celle en vigueur, le compte à rebours du tapis doré.
function Belt.panel(Config, st, now)
	local left = Belt.goldenLeft(st, now)
	local golden = left > 0
	local status = "Tapis standard : un œuf toutes les " .. Config.BELT.interval .. " s"
	if golden then
		status = "✨ TAPIS DORÉ : " .. Belt.clock(left) .. (st.goldenBy and (" · Offert par " .. st.goldenBy) or "")
	end
	return { normal = Config.beltOddsText("normal"), golden = Config.beltOddsText("golden"), active = golden and "golden" or "normal", left = left, status = status }
end

-- Abscisse de l'œuf sur le tapis (de belt.x0 vers belt.x1 à `speed` studs/s) ; nil s'il est tombé dans le bac.
function Belt.positionX(Config, egg, now)
	local B = Config.Map2.belt
	local x = B.x0 + Config.BELT.speed * (now - egg.born)
	if x > B.x1 then
		return nil
	end
	return x
end

-- Fait vivre le tapis : retire les œufs arrivés au bac, en fait apparaître un nouveau toutes les `interval` secondes (3 en doré) tant qu'il y en a moins de maxEggs.
-- `welcome` : si non nil, { userId = n } -> un œuf de bienvenue Commun gratuit est posé en tête (une fois par joueur, voir Belt.welcome). Retourne (apparus, retirés).
function Belt.step(Config, st, now)
	local C = Config.BELT
	local removed, spawned = {}, {}
	local keep = {}
	for _, e in ipairs(st.eggs) do
		if Belt.positionX(Config, e, now) then
			keep[#keep + 1] = e
		else
			removed[#removed + 1] = e
		end
	end
	st.eggs = keep
	local golden = Belt.goldenLeft(st, now) > 0
	local interval = golden and C.golden.interval or C.interval
	local weights = Config.foldWeights(golden and C.weights.golden or C.weights.normal) -- lot 9 : raretés sans espèce reportées vers le bas
	local guard = 0
	while now >= st.nextSpawn and guard < 50 do
		guard = guard + 1
		if #st.eggs < C.maxEggs then
			local r
			r, st.rnd = nextRnd(st.rnd)
			local egg = { id = st.nextId, tier = Belt.pick(weights, r), born = st.nextSpawn, claimedBy = nil, price = nil }
			egg.price = Belt.price(Config, egg.tier)
			st.nextId = st.nextId + 1
			st.eggs[#st.eggs + 1] = egg
			spawned[#spawned + 1] = egg
		end
		st.nextSpawn = st.nextSpawn + interval
	end
	if now - st.nextSpawn > 60 then
		st.nextSpawn = now -- serveur en pause : pas de rattrapage massif
	end
	return spawned, removed
end

-- Œuf de bienvenue : gratuit, posé sur le tapis au nom du joueur, une seule fois par joueur (et seulement si hatched < welcome.maxHatched). Retourne l'œuf ou nil.
function Belt.welcome(Config, st, userId, hatched, now)
	local W = Config.BELT.welcome
	if st.welcomed[userId] or hatched >= W.maxHatched or #st.eggs >= Config.BELT.maxEggs then
		return nil
	end
	st.welcomed[userId] = true
	local egg = { id = st.nextId, tier = 1, born = now, claimedBy = nil, price = 0, forUser = userId }
	st.nextId = st.nextId + 1
	st.eggs[#st.eggs + 1] = egg
	return egg
end

-- Tapis privé (pass PrivateBelt) : état { acc, pending = { raretés } }. Un œuf gratuit toutes les `interval` secondes d'ACTIVITÉ (`active` : le joueur a agi ou bougé dans
-- Config.IDLE.seconds), `pending` œufs en attente au plus (plein : le compteur est suspendu), table STANDARD (Config.BELT.weights.normal), AUCUNE production hors ligne
-- (ce module n'est appelé que pour un joueur présent). `r` dans [0, 1) tire la rareté. Retourne la rareté créée, ou nil.
function Belt.privateStep(Config, st, dt, active, r)
	local P = Config.BELT.private
	if not active or type(dt) ~= "number" or dt ~= dt or dt <= 0 or #st.pending >= P.pending then
		return nil
	end
	st.acc = st.acc + math.min(dt, 5) -- un grand dt (serveur en pause) ne rattrape pas plusieurs œufs
	if st.acc < P.interval then
		return nil
	end
	st.acc = 0
	local tier = Belt.pick(Config.foldWeights(Config.BELT.weights.normal), r)
	st.pending[#st.pending + 1] = tier
	return tier
end

-- Tente l'achat de l'œuf `eggId` par `userId` ; `coins` = pièces du joueur. Retourne (true, œuf) ou (false, raison).
-- Règles : 1 achat par joueur toutes les `buyCooldown` s ; œuf Légendaire+ : prompt actif seulement `legendaryDelay` s après son apparition et 1 par joueur
-- et par minute ; œuf de bienvenue réservé à son destinataire ; réservation atomique (le premier valide l'emporte).
function Belt.tryBuy(Config, st, userId, eggId, coins, now)
	local C = Config.BELT
	local egg
	for _, e in ipairs(st.eggs) do
		if e.id == eggId then
			egg = e
		end
	end
	if not egg or not Belt.positionX(Config, egg, now) then
		return false, "gone"
	end
	if egg.claimedBy then
		return false, "late" -- « Trop tard ! »
	end
	if egg.forUser and egg.forUser ~= userId then
		return false, "reserved"
	end
	if not egg.forUser and now - (st.lastBuy[userId] or -1e9) < C.buyCooldown then
		return false, "cooldown"
	end
	if Config.tierAtLeast(egg.tier, "belt2s") then
		if now - egg.born < C.legendaryDelay then
			return false, "wait"
		end
		if now - (st.legendaryAt[userId] or -1e9) < 60 / C.legendaryPerMinute then
			return false, "legendaryLimit"
		end
	end
	if type(coins) ~= "number" or coins ~= coins or coins < egg.price then
		return false, "poor"
	end
	egg.claimedBy = userId -- atomique : la deuxième demande reçoit « late »
	if not egg.forUser then
		st.lastBuy[userId] = now
	end
	if Config.tierAtLeast(egg.tier, "belt2s") then
		st.legendaryAt[userId] = now
	end
	st.sold = st.sold + 1
	-- l'œuf quitte le tapis
	local keep = {}
	for _, e in ipairs(st.eggs) do
		if e ~= egg then
			keep[#keep + 1] = e
		end
	end
	st.eggs = keep
	return true, egg
end

return Belt
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Raven</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Raven
-- Règles PURES du vol à distance « Corbeau chipeur » (aucun service Roblox), testées une par une. Le serveur fournit des « contextes » (tables simples) et applique
-- la décision ; le client n'envoie qu'une intention. Jamais d'anonymat, jamais de protection payante : les protections sont gratuites.
local Raven = {}

-- Ancienneté de compte (jours) d'après une valeur d'origine incertaine : tout ce qui n'est pas un nombre fini vaut 0 (donc refusé).
local function days(v)
	if type(v) ~= "number" or v ~= v then
		return 0
	end
	return v
end

-- Vérifie le DÉPART d'un corbeau. thief = { userId, tokens, level, playMinutes, freeSlot, dailyDone, flying, newbie, inCastle }
-- (lot 7b : thief et victim portent aussi accountAgeDays ; egg porte rvAt = os.time() du dernier vol par corbeau, nil sinon)
-- victim = { userId, level, playMinutes, newbie, inCastle, graceUntil, shieldUntil, ravenCooldownUntil, friendOfThief, blockFriendRavens }
-- egg = { tier, incubating, eggShieldUntil, endsAt }, now en secondes (os.time). Retourne true ou (false, code).
function Raven.canLaunch(Config, thief, victim, egg, now)
	local R = Config.REMOTE_STEAL
	if not thief or not victim or not egg then
		return false, "invalid"
	end
	if thief.userId == victim.userId then
		return false, "self"
	end
	if (thief.tokens or 0) < 1 then
		return false, "noToken"
	end
	if thief.flying then
		return false, "alreadyFlying"
	end
	if (thief.dailyDone or 0) >= R.dailyMax then
		return false, "dailyLimit"
	end
	if thief.inCastle or victim.inCastle then
		return false, "castle"
	end
	if thief.newbie or victim.newbie then
		return false, "newbie"
	end
	if (thief.playMinutes or 0) < R.minPlayMinutes or (victim.playMinutes or 0) < R.victimMinMinutes then
		return false, "tooYoung"
	end
	if days(thief.accountAgeDays) < R.minAccountAgeDays or days(victim.accountAgeDays) < R.minAccountAgeDays then
		return false, "accountAge"
	end
	if not thief.freeSlot then
		return false, "noSlot"
	end
	if (victim.level or 1) < (thief.level or 1) - R.levelGap then
		return false, "levelGap"
	end
	if now < (victim.shieldUntil or 0) then
		return false, "victimShield"
	end
	if now < (victim.ravenCooldownUntil or 0) then
		return false, "victimCooldown"
	end
	if now < (victim.graceUntil or 0) then
		return false, "grace"
	end
	if victim.friendOfThief and victim.blockFriendRavens then
		return false, "friendBlocked"
	end
	if not egg.incubating then
		return false, "notEgg"
	end
	if type(egg.tier) ~= "number" or egg.tier > R.maxTier or egg.tier < 1 then
		return false, "tier"
	end
	if now < (egg.eggShieldUntil or 0) then
		return false, "eggShield"
	end
	if type(egg.rvAt) == "number" and now - egg.rvAt < R.reStealSeconds then
		return false, "recentlyStolen" -- un œuf volé par corbeau ne se revole pas tout de suite (anti-aller-retour entre comptes complices)
	end
	if (egg.endsAt or 0) - now <= R.minEggSecondsLeft then
		return false, "tooLate"
	end
	return true
end

-- Indemnité de la victime : floor(prix de la boutique x ratio).
function Raven.compensation(Config, tier)
	return math.floor(Config.EGG_PRICE[tier] * Config.REMOTE_STEAL.compensationRatio)
end

-- Indemnité RÉELLEMENT versée (lot 7b) : 0 pour un œuf non indemnisable (`rv` : déjà volé par corbeau, issu du tapis privé ou de l'œuf de bienvenue), sinon
-- l'indemnité normale plafonnée par ce que la victime peut encore recevoir aujourd'hui (plafond = prix d'un œuf de Config.REMOTE_STEAL.compensationCapTier).
function Raven.indemnity(Config, tier, rv, receivedToday)
	if rv == true then
		return 0
	end
	local R = Config.REMOTE_STEAL
	local got = (type(receivedToday) == "number" and receivedToday == receivedToday) and math.max(0, receivedToday) or 0 -- valeur incertaine : nombre fini sinon 0
	local room = Config.EGG_PRICE[R.compensationCapTier] - got
	return math.max(0, math.min(Raven.compensation(Config, tier), room))
end

-- Jour UTC d'un horodatage (clé du plafond quotidien).
function Raven.day(now)
	return math.floor(now / 86400)
end

-- Plafond quotidien : retourne le nouveau compteur (remis à zéro si le jour a changé) sous la forme (jour, compte).
function Raven.rollDaily(day, count, now)
	local today = Raven.day(now)
	if day ~= today then
		return today, 0
	end
	return day, count
end

-- Un achat de `n` jetons est-il possible sans dépasser le plafond ? (sinon le reçu n'est PAS traité : jamais de jeton payé perdu.)
function Raven.canBuy(Config, tokens, n)
	return math.max(0, tokens) + n <= Config.REMOTE_STEAL.tokenMax
end

-- Jetons après un achat de `n` jetons (plafond tokenMax) : retourne (nouveau total, jetons perdus au-delà du plafond).
function Raven.addTokens(Config, tokens, n)
	local cap = Config.REMOTE_STEAL.tokenMax
	local total = math.min(cap, math.max(0, tokens) + n)
	return total, math.max(0, math.max(0, tokens) + n - cap)
end

-- Issue du vol : la victime a-t-elle chassé le corbeau (touche son pad à temps, présente dans sa base) ?
function Raven.resolve(chased)
	return chased and "chased" or "success"
end

-- Jetons offerts par un produit (RemoteSteal 1, RemoteStealPack 3) ; 0 si le produit n'en donne pas.
function Raven.tokensFor(Config, productName)
	local n = Config.REMOTE_STEAL.packs[productName]
	return type(n) == "number" and n or 0
end

-- Jetons « détenus » pour le plafond d'achat : ceux du profil PLUS celui qui est en vol (il sera rendu en cas d'échec : le compter évite de le perdre au-delà du plafond).
function Raven.held(tokens, flying)
	return math.max(0, tokens) + (flying and 1 or 0)
end

-- Cumul d'un bonus serveur (tapis doré, pluie de chance) : `left` secondes restantes, `add` secondes achetées, plafond `max`. Retourne (nouveau restant, accepté).
-- Un achat qui dépasserait le plafond n'est PAS accepté (le reçu reste « pas encore traité » : aucun argent perdu).
function Raven.stack(left, add, max)
	left = math.max(0, left)
	if left + add > max then
		return left, false
	end
	return left + add, true
end

-- Une demande de vol en cours est-elle toujours valable ? Tout est décidé par le serveur ; `w` = { thiefHere, victimHere, eggStill, eggLeft, chased, shielded, thiefFreeSlot, now, endsAt }.
-- (lot 7b : `inCastle` et `newbie` = l'un des DEUX joueurs, relus à chaque pas.)
-- Retourne (decision, raison) : "pending" (le corbeau vole encore), "chased" (jeton rendu), "success", ou "aborted" (raison : thiefGone, victimGone, eggGone, shield, noSlot ;
-- jeton rendu partout sauf thiefGone, où le serveur le rend dans le profil du voleur avant sa sauvegarde de départ).
function Raven.settle(w)
	if not w.thiefHere then
		return "aborted", "thiefGone"
	end
	if not w.victimHere then
		return "aborted", "victimGone"
	end
	if not w.eggStill or (type(w.eggLeft) == "number" and w.eggLeft <= 0) then
		return "aborted", "eggGone"
	end
	if w.inCastle then
		return "aborted", "castle" -- l'un des deux est entré au Château pendant le vol (relu à chaque pas) : pas de corbeau dans ce mode
	end
	if w.newbie then
		return "aborted", "newbie" -- protection débutant d'un des deux (relue pendant le vol)
	end
	if w.chased then
		return "chased", "chased"
	end
	if w.now < w.endsAt then
		return "pending", "flying"
	end
	if w.shielded then
		return "aborted", "shield" -- un autre corbeau (ou un vol) vient de protéger la victime : un seul vol à la fois la dépouille
	end
	if not w.thiefFreeSlot then
		return "aborted", "noSlot"
	end
	return "success", "success"
end

-- Journal « Qui m'a volé ? » : insère l'entrée en tête, ne garde que `max` entrées. Retourne la liste (modifiée en place).
function Raven.logPush(list, entry, max)
	table.insert(list, 1, entry)
	while #list > max do
		table.remove(list)
	end
	return list
end

-- Clés du journal serveur RavenLog (une clé par jour UTC) : jour courant, et jour à effacer (plus vieux que `days` jours).
function Raven.dayKey(now)
	return "D" .. Raven.day(now)
end
function Raven.expiredKey(now, days)
	return "D" .. (Raven.day(now) - days - 1)
end

-- Position du corbeau (x, y, z) à l'instant t (0 à 1) d'un vol de `from` vers `to` : montée en arc puis cercle au-dessus de la cible sur la fin.
-- Pure (aucun Vector3) : le serveur en tire un CFrame. `orbit` = fraction du vol passée à tourner (0,3).
function Raven.birdPos(from, to, t, orbit)
	t = math.min(math.max(t, 0), 1)
	local o = orbit or 0.3
	local k = 1 - o
	if t < k then
		local u = t / k
		local e = u * u * (3 - 2 * u)
		return from.x + (to.x - from.x) * e, from.y + (to.y - from.y) * e + math.sin(u * math.pi) * 6, from.z + (to.z - from.z) * e
	end
	local a = (t - k) / o * math.pi * 2
	return to.x + math.cos(a) * 5, to.y, to.z + math.sin(a) * 5
end

return Raven
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Assets (utilisé côté SERVEUR seulement : jeu et hub)
-- Chargement SÛR des modèles Roblox qui servent d'apparence aux œufs. Rien ici ne touche au gameplay : en cas d'échec quel qu'il soit,
-- cloneEgg retourne nil et l'appelant garde l'apparence par défaut. Les dépendances Roblox sont injectées (Assets.new(Config, deps)) pour
-- tester tous les cas d'échec avec un chargeur factice (tests/run.luau).
--   deps.loadAsset(id) -> modèle   (réel : InsertService:LoadAsset)
--   deps.spawn(fn), deps.wait(secondes), deps.clock() -> secondes   (réels : task.spawn, task.wait, os.clock)
--   deps.warn(message)  (facultatif)   deps.store(clé, modèle)  (facultatif : range le modèle, ex. dans ServerStorage)
local Assets = {}

-- Convention des modèles Blender : chaque pièce se nomme `Nom__RRGGBB` (hexadécimal). Retourne (r, g, b) en 0-255, ou nil si le nom n'a pas de
-- suffixe valide (exactement 6 chiffres hexadécimaux après le DERNIER « __ »). Pur et testé.
function Assets.parseColorSuffix(name)
	if type(name) ~= "string" then
		return nil
	end
	-- un doublon d'import Blender (« Sapin__2E7D4F.001 ») garde la couleur de son suffixe
	local hex = name:match("__(%x%x%x%x%x%x)$") or name:match("__(%x%x%x%x%x%x)%.%d+$")
	if not hex then
		return nil
	end
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

-- Clés des modèles d'effets (même liste que VfxKit.MODELS), pour l'export vers les clients.
Assets.vfxKeys = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Nom de base d'une pièce Blender : sans suffixe de couleur ni suffixe de doublon (« Lame__D8DCE8.001 » -> « Lame »).
function Assets.baseName(name)
	if type(name) ~= "string" then
		return ""
	end
	local n = name:gsub("%.%d+$", "")
	n = n:gsub("__%x%x%x%x%x%x$", "")
	return n
end

-- Met un modèle à la hauteur cible (studs) d'après GetExtentsSize, puis REMESURE : la hauteur obtenue doit être à ±10 % de la cible (deux corrections
-- au plus). Retourne (true, hauteur) ou (false, raison) : l'appelant ne pose alors pas le modèle (repli procédural), jamais d'échelle 1 brute.
function Assets.fitHeight(model, target)
	local ok, res = pcall(function()
		if type(target) ~= "number" or target ~= target or target <= 0 or target > 1000 then
			error("hauteur cible invalide")
		end
		local height
		for _ = 1, 3 do
			local e = model:GetExtentsSize()
			height = e and e.Y
			if type(height) ~= "number" or height ~= height or height < 0.05 or height > 1e6 then
				error("mesure impossible")
			end
			if math.abs(height - target) <= 0.1 * target and _ > 1 then
				return height
			end
			model:ScaleTo(model:GetScale() * target / height)
		end
		local e = model:GetExtentsSize()
		height = e and e.Y
		if type(height) ~= "number" or math.abs(height - target) > 0.1 * target then
			error("hauteur hors tolérance")
		end
		return height
	end)
	return ok, res
end

-- Lot 9 : met un modèle à l'échelle d'après la hauteur d'UNE pièce (`partName`, nom de base sans suffixe de couleur, ex. « Coque » des œufs) :
-- couronne, auréole ou ailes dépassent sans fausser la taille de l'œuf. Le rapport hauteur de la pièce / hauteur du modèle est mesuré AVANT la mise
-- à l'échelle, puis Assets.fitHeight vise target / rapport (vérifié à ±10 %). Sans cette pièce : repli sur la hauteur du modèle entier.
-- Retourne (true, hauteur du modèle) ou (false, raison).
function Assets.partRatio(model, partName)
	local ok, r = pcall(function()
		local e = model:GetExtentsSize()
		local mh = e and e.Y
		if type(mh) ~= "number" or mh ~= mh or mh <= 0 then
			return nil
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and Assets.baseName(d.Name) == partName then
				local h = d.Size.Y
				if type(h) == "number" and h == h and h > 0 and h <= mh * 1.001 then
					return h / mh
				end
			end
		end
		return nil
	end)
	return ok and r or nil
end
function Assets.fitByPart(model, partName, target)
	local r = Assets.partRatio(model, partName)
	if not r or r < 0.2 then
		return Assets.fitHeight(model, target)
	end
	return Assets.fitHeight(model, target / r)
end

function Assets.new(Config, deps)
	local A = { templates = {}, status = {}, failedIds = {}, requested = {}, placeFailures = {} } -- status[clé] = { ok, reason | parts, removed } ; failedIds[id] = raison
	local warned = {} -- un seul avertissement par ID
	local byId = {} -- identifiant -> { model, status } des modèles déjà chargés
	local cfg = Config.Assets

	local function warn(msg, id)
		if id ~= nil then
			A.failedIds[id] = msg
			if warned[id] then
				return
			end
			warned[id] = true
		end
		if deps.warn then
			deps.warn("[Assets] " .. msg)
		end
	end

	-- Exécute fn avec un délai maximum (le chargeur réel peut ne jamais répondre). Retourne (ok, résultat | message).
	-- Si le résultat arrive après le délai, le modèle est détruit et ignoré.
	local function withTimeout(fn, seconds)
		local state = { done = false, abandoned = false }
		deps.spawn(function()
			local ok, res = pcall(fn)
			state.done, state.ok, state.res = true, ok, res
			if state.abandoned and ok and res ~= nil then
				pcall(function()
					res:Destroy()
				end)
			end
		end)
		local t0 = deps.clock()
		while not state.done and deps.clock() - t0 < seconds do
			deps.wait(0.1)
		end
		if not state.done then
			state.abandoned = true
			return false, "délai dépassé (" .. seconds .. " s)"
		end
		return state.ok, state.res
	end

	local function descendants(model)
		local ok, list = pcall(function()
			return model:GetDescendants()
		end)
		if ok and type(list) == "table" then
			return list
		end
		return nil
	end

	-- Retire tout ce qui est interdit, plafonne les particules, vérifie qu'il reste de la géométrie.
	-- Retourne (true, { parts, removed }) ou (false, raison). Ne lève jamais d'erreur.
	function A.sanitize(model, maxParts)
		maxParts = maxParts or cfg.maxParts
		if model == nil then
			return false, "modèle absent"
		end
		local list = descendants(model)
		if not list then
			return false, "modèle illisible ou corrompu"
		end
		local blocked = {}
		for _, d in ipairs(list) do
			local ok, className = pcall(function()
				return d.ClassName
			end)
			if not ok or type(className) ~= "string" then
				return false, "instance corrompue"
			end
			if Config.isBlockedClass(className) then
				blocked[#blocked + 1] = d
			end
		end
		for _, d in ipairs(blocked) do
			pcall(function()
				d:Destroy()
			end)
		end
		local after = descendants(model)
		if not after then
			return false, "modèle illisible après nettoyage"
		end
		local parts = 0
		for _, d in ipairs(after) do
			local okPart, isPart = pcall(function()
				return d:IsA("BasePart")
			end)
			if okPart and isPart then
				parts = parts + 1
			else
				local okEmitter, isEmitter = pcall(function()
					return d.ClassName == "ParticleEmitter"
				end)
				if okEmitter and isEmitter then
					pcall(function()
						if d.Rate > cfg.maxParticleRate then
							d.Rate = cfg.maxParticleRate
						end
					end)
				end
			end
		end
		if parts == 0 then
			return false, "modèle vide (aucune part)"
		end
		if parts > maxParts then
			return false, "modèle trop lourd (" .. parts .. " parts, maximum " .. maxParts .. ")"
		end
		return true, { parts = parts, removed = #blocked }
	end

	-- Applique la couleur lue dans le suffixe `__RRGGBB` du nom de chaque pièce (les couleurs du FBX ne sont jamais utilisées) ; sans suffixe, rien
	-- ne change. CastShadow = false pour les petits détails (arête la plus longue sous cfg.smallDetail studs). Retourne le nombre de pièces colorées.
	function A.colorize(model, keepMaterial)
		local make = deps.color or (Color3 and Color3.fromRGB)
		if not make then
			return 0
		end
		local list = descendants(model)
		if not list then
			return 0
		end
		local count = 0
		local MAT = deps.material or (Enum and Enum.Material)
		for _, d in ipairs(list) do
			local okName, name = pcall(function()
				return d.Name
			end)
			if MAT and not keepMaterial then
				-- matières : Metal et Neon seulement pour les pièces explicitement métalliques ou lumineuses (Metal sans reflets rend noir),
				-- tout le reste en plastique lisse, jamais de reflets
				pcall(function()
					if d:IsA("BasePart") then
						local base = Assets.baseName(okName and name or "")
						local metals, neons = cfg.metalParts or {}, cfg.neonParts or {}
						if metals[base] then
							d.Material = MAT.Metal
						elseif neons[base] then
							d.Material = MAT.Neon
						elseif d.Material ~= MAT.Plastic and d.Material ~= MAT.SmoothPlastic then
							d.Material = MAT.SmoothPlastic
						end
						d.Reflectance = 0
					end
				end)
			end
			local r, g, b = Assets.parseColorSuffix(okName and name or nil)
			if r then
				local isPart = false
				pcall(function()
					isPart = d:IsA("BasePart")
				end)
				if isPart then
					pcall(function()
						d.Color = make(r, g, b)
						count = count + 1
						pcall(function()
							if d.ClassName == "MeshPart" then
								d.TextureID = "" -- une texture importée teinterait la couleur (rendu sombre)
							end
							for _, c in ipairs(d:GetChildren()) do
								if c.ClassName == "SurfaceAppearance" then
									c:Destroy()
								end
							end
						end)
						local s = d.Size
						if s and math.max(s.X, s.Y, s.Z) < (cfg.smallDetail or 0.6) then
							d.CastShadow = false
						end
					end)
				end
			end
		end
		return count
	end

	-- Charge, nettoie et range un modèle. Retourne true si un modèle utilisable est disponible. Ne lève jamais d'erreur.
	function A.loadOne(key, id, maxParts)
		A.requested[key] = id
		-- un identifiant déjà chargé (même modèle sous une autre clé) est réutilisé : un seul LoadAsset par modèle
		if byId[id] then
			A.templates[key] = byId[id].model
			A.status[key] = byId[id].status
			return true
		end
		A.startedAt = A.startedAt or deps.clock()
		local t1 = deps.clock()
		local attempts = 1
		local ok, model = withTimeout(function()
			return deps.loadAsset(id)
		end, cfg.timeout)
		-- un seul nouvel essai (chargement refusé ou trop lent), tant que le plafond global de relance n'est pas atteint : un échec ne bloque jamais la suite
		if not ok and deps.clock() - A.startedAt < (cfg.retryUntil or 25) then
			deps.wait(0.4)
			attempts = 2
			ok, model = withTimeout(function()
				return deps.loadAsset(id)
			end, cfg.timeout)
		end
		if not ok then
			A.status[key] = { ok = false, reason = tostring(model), id = id, attempts = attempts, seconds = deps.clock() - t1 }
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(model) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local sOk, valid, info = pcall(A.sanitize, model, maxParts)
		if not sOk then
			valid, info = false, tostring(valid)
		end
		if not valid then
			A.status[key] = { ok = false, reason = tostring(info), id = id }
			pcall(function()
				if model ~= nil then
					model:Destroy()
				end
			end)
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(info) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local colored = 0
		local cOk, cn = pcall(A.colorize, model, key:sub(1, 2) == "v:" or key:sub(1, 6) == "m:vfx.") -- les effets gardent leur matière Neon
		if cOk then
			colored = cn
		end
		A.templates[key] = model
		A.status[key] = { ok = true, parts = info.parts, removed = info.removed, colored = colored, id = id, attempts = attempts, seconds = deps.clock() - t1 }
		byId[id] = { model = model, status = A.status[key] }
		if deps.store then
			pcall(deps.store, key, model)
		end
		return true
	end

	-- Charge une liste { {key, id, cap} } par LOTS PARALLÈLES (cfg.batchSize, 8 par défaut) : chaque modèle a son délai et son nouvel essai, un échec ou un modèle
	-- lent ne retarde jamais que son lot et n'empêche JAMAIS de lancer les suivants. Les identifiants en double sont chargés une seule fois.
	-- Retourne le nombre de modèles utilisables. Ne lève jamais d'erreur.
	function A.loadMany(entries)
		local first, dups, seen = {}, {}, {}
		for _, e in ipairs(entries) do
			A.requested[e.key] = e.id
			if byId[e.id] or seen[e.id] then
				dups[#dups + 1] = e
			else
				seen[e.id] = true
				first[#first + 1] = e
			end
		end
		local size = cfg.batchSize or 8
		local i = 1
		while i <= #first do
			local running = 0
			for j = i, math.min(i + size - 1, #first) do
				local e = first[j]
				running = running + 1
				deps.spawn(function()
					pcall(A.loadOne, e.key, e.id, e.cap)
					running = running - 1
				end)
			end
			while running > 0 do
				deps.wait(0.05)
			end
			i = i + size
		end
		for _, e in ipairs(dups) do
			pcall(A.loadOne, e.key, e.id, e.cap)
		end
		local loaded = 0
		for _, e in ipairs(entries) do
			if A.status[e.key] and A.status[e.key].ok then
				loaded = loaded + 1
			end
		end
		return loaded
	end

	-- Catégorie d'une clé de statut (pour le rapport) : arbres, chemins, protections d'œufs, base, village, pets, œufs, gardiens, décor...
	local CATEGORY = { trees = "arbres", paths = "chemins", eggguard = "protections d'œufs", base = "base", scenery = "village", guards = "gardiens", traps = "pièges", castle = "château", ground = "sol", deco = "décor", terrain = "relief", vfx = "effets", props = "accessoires" }
	function A.categoryOf(key)
		local grp = key:match("^m:(%a+)%.")
		if grp then
			return CATEGORY[grp] or grp
		end
		local prefix = key:match("^(%a+):")
		if prefix == "p" then
			return "pets"
		elseif prefix == "r" then
			return "œufs"
		elseif prefix == "d" then
			return "décor catalogue"
		elseif prefix == "x" then
			return "accessoires"
		elseif prefix == "t" then
			return "textures"
		end
		return "œufs"
	end

	-- Rapport par catégorie : { {cat, requested, loaded, fallback, failures = { {key, id, reason} }} } trié par nom ; les statuts sans demande (ID invalide) comptent.
	function A.report()
		local cats, order = {}, {}
		local function bucket(c)
			if not cats[c] then
				cats[c] = { cat = c, requested = 0, loaded = 0, fallback = 0, failures = {} }
				order[#order + 1] = c
			end
			return cats[c]
		end
		local keys, seenKey = {}, {}
		for k in pairs(A.requested) do
			keys[#keys + 1] = k
			seenKey[k] = true
		end
		for k in pairs(A.status) do
			if not seenKey[k] then
				keys[#keys + 1] = k
			end
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			local b = bucket(A.categoryOf(k))
			local st = A.status[k]
			b.requested = b.requested + 1
			if st and st.ok then
				b.loaded = b.loaded + 1
			else
				b.fallback = b.fallback + 1
				b.failures[#b.failures + 1] = { key = k, id = A.requested[k] or (st and st.id), reason = st and st.reason or "pas encore chargé" }
			end
		end
		table.sort(order)
		local out = {}
		for _, c in ipairs(order) do
			out[#out + 1] = cats[c]
		end
		return out
	end

	-- Lignes de texte du rapport (une par catégorie, puis une par échec) + totaux { loaded, requested }.
	function A.reportLines()
		local lines, loaded, requested = {}, 0, 0
		local rep = A.report()
		for _, b in ipairs(rep) do
			loaded, requested = loaded + b.loaded, requested + b.requested
			lines[#lines + 1] = ("[Assets] %s : %d/%d chargés, %d en repli"):format(b.cat, b.loaded, b.requested, b.fallback)
		end
		for _, b in ipairs(rep) do
			for _, f in ipairs(b.failures) do
				lines[#lines + 1] = ("[Assets]   ÉCHEC %s (ID %s) : %s"):format(tostring(f.key), tostring(f.id), tostring(f.reason))
			end
		end
		local shown = {}
		for _, f in ipairs(A.placeFailures) do
			if not shown[f] and #shown < 20 then -- un message distinct à la fois, 20 au plus
				shown[f] = true
				shown[#shown + 1] = f
				lines[#lines + 1] = "[Assets]   POSE REFUSÉE " .. f
			end
		end
		return lines, loaded, requested
	end

	-- Charge tous les modèles d'œufs (un par clé). onReady() est appelé une fois si au moins un modèle est utilisable.
	-- Retourne le nombre de modèles chargés. Ne lève jamais d'erreur ; ne fait rien si Config.Assets.Enabled est faux.
	function A.loadAll(onReady)
		if cfg.Enabled ~= true then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.eggs) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		if type(cfg.eggsByRarity) == "table" then -- modèles Blender par rareté (1..6 et « secret ») : prioritaires sur les modèles du catalogue, chargés en premier
			local rk = {}
			for rarity in pairs(cfg.eggsByRarity) do
				rk[#rk + 1] = rarity
			end
			table.sort(rk, function(a, b)
				return tostring(a) < tostring(b)
			end)
			for _, rarity in ipairs(rk) do
				local id = cfg.eggsByRarity[rarity]
				if type(id) == "number" and id > 0 and id % 1 == 0 then
					entries[#entries + 1] = { key = "r:" .. tostring(rarity), id = id, cap = cfg.eggsMaxParts }
				else
					A.status["r:" .. tostring(rarity)] = { ok = false, reason = "ID invalide" }
				end
			end
		end
		for _, key in ipairs(keys) do
			local id = cfg.eggs[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = key, id = id, cap = cfg.eggsMaxParts } -- lot 9 : plafond propre des œufs (40)
			else
				A.status[key] = { ok = false, reason = "ID invalide" }
			end
		end
		local loaded = A.loadMany(entries)
		if loaded > 0 and onReady then
			pcall(onReady)
		end
		return loaded
	end

	-- Charge les modèles de décor du hub (Config.Assets.decor : clé -> ID), plafond de Parts plus large que pour les œufs.
	-- Clés rangées sous « d:<clé> ». Retourne le nombre de modèles chargés. Ne lève jamais d'erreur.
	function A.loadDecor()
		if cfg.Enabled ~= true or type(cfg.decor) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.decor) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.decor[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "d:" .. key, id = id, cap = cfg.decorMaxParts or cfg.maxParts }
			else
				A.status["d:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Charge les modèles Blender des pets (Config.Assets.pets : index d'espèce -> ID). Clés « p:<index> ». Retourne le nombre de modèles chargés.
	function A.loadPets()
		if cfg.Enabled ~= true or type(cfg.pets) ~= "table" then
			return 0
		end
		local loaded = 0
		local idxs = {}
		for idx in pairs(cfg.pets) do
			idxs[#idxs + 1] = idx
		end
		table.sort(idxs, function(a, b)
			return tostring(a) < tostring(b)
		end)
		local entries = {}
		for _, idx in ipairs(idxs) do
			local id = cfg.pets[idx]
			if type(idx) == "number" and Config.PETS[idx] and type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "p:" .. idx, id = id, cap = cfg.petsMaxParts or cfg.maxParts }
			else
				A.status["p:" .. tostring(idx)] = { ok = false, reason = "entrée invalide" }
			end
		end
		loaded = A.loadMany(entries)
		return loaded
	end

	-- Copie du modèle du pet d'espèce `petIdx`, ou nil (repli : pet procédural).
	function A.clonePet(petIdx)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["p:" .. tostring(petIdx)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle de décor `key`, ou nil (coupé, échoué, pas encore chargé).
	function A.cloneDecor(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["d:" .. key]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle d'un œuf de rareté `tier`, ou nil (chargement coupé, échoué, pas encore terminé...) : garder l'apparence par défaut.
	function A.cloneEgg(tier, secret)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = nil
		if secret then
			template = A.templates["r:secret"]
		end
		template = template or A.templates["r:" .. tostring(tier)]
		if not template then
			local key = Config.eggAssetKey(tier)
			template = key and A.templates[key]
		end
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Accessoires (arbres, rochers, cabanes, pont, fontaine, nid...) : Config.Assets.props clé -> ID, plafond de Parts par clé (propsMaxParts).
	function A.loadProps()
		if cfg.Enabled ~= true or type(cfg.props) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.props) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.props[key]
			local cap = (cfg.propsMaxParts and cfg.propsMaxParts[key]) or cfg.decorMaxParts or cfg.maxParts
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "x:" .. key, id = id, cap = cap }
			else
				A.status["x:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Textures tuilables : chaque entrée de Config.Assets.textures est un ID de DÉCAL ; on charge le décal côté serveur, on lit son `Texture` (URL
	-- d'image) et on la met en cache (A.textureUrls[clé]). Un échec laisse la matière actuelle (aucune URL = rien n'est posé). Retourne le nombre chargé.
	A.textureUrls = {}
	function A.loadTextures()
		if cfg.Enabled ~= true or type(cfg.textures) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.textures) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local loaded = 0
		for _, key in ipairs(keys) do
			local id = cfg.textures[key].id
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				local ok, model = withTimeout(function()
					return deps.loadAsset(id)
				end, cfg.timeout)
				local url = nil
				if ok and model ~= nil then
					pcall(function()
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("Decal") and type(d.Texture) == "string" and d.Texture ~= "" then
								url = d.Texture
								break
							end
						end
					end)
					pcall(function()
						model:Destroy()
					end)
				end
				if url then
					A.textureUrls[key] = url
					A.status["t:" .. key] = { ok = true }
					loaded = loaded + 1
				else
					A.status["t:" .. key] = { ok = false, reason = ok and "aucun décal dans le modèle" or tostring(model) }
					warn("texture « " .. key .. " » (" .. tostring(id) .. ") indisponible : matière actuelle conservée.", id)
				end
			else
				A.status["t:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return loaded
	end

	-- Groupes de modèles Blender de Config.Assets.models (guards, castle, traps, ground, props...) : clé "groupe.nom", plafond de Parts par
	-- Config.Assets.modelsMaxParts["groupe.nom"]. Même garanties que loadProps (un seul LoadAsset par ID, jamais d'erreur levée).
	function A.loadGroup(group, only)
		local g = cfg.models and cfg.models[group]
		if cfg.Enabled ~= true or type(g) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(g) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = (not only or only[key]) and g[key] or nil
			local full = group .. "." .. key
			local cap = (cfg.modelsMaxParts and cfg.modelsMaxParts[full]) or (group == "vfx" and cfg.vfxMaxParts) or cfg.decorMaxParts or cfg.maxParts
			if not id then
				-- clé non demandée (filtre `only`)
			elseif type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "m:" .. full, id = id, cap = cap }
			else
				A.status["m:" .. full] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Copie d'un modèle d'un groupe (ou nil : repli procédural).
	function A.cloneModel(group, key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["m:" .. tostring(group) .. "." .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		return ok and clone or nil
	end

	-- Copie d'un accessoire (clone du modèle chargé une seule fois : jamais de LoadAsset répété), ou nil.
	function A.cloneProp(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["x:" .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Pose un modèle cloné : mis à l'échelle à `height` studs, posé au sol en (x, z), tourné de rotDeg, ancré, sans collision. Retourne (true, nombre de
	-- Parts) ou (false) ; en cas d'erreur le clone est détruit. Ne lève jamais d'erreur.
	function A.place(model, x, z, rotDeg, height, parent, length, groundY)
		local count = 0
		local mname = "?"
		pcall(function()
			mname = tostring(model.Name)
		end)
		local ok, err = pcall(function()
			if not model:IsA("Model") then
				error("pas un Model")
			end
			local _, size = model:GetBoundingBox()
			if size.Y < 0.05 then
				error("hauteur nulle")
			end
			local longest = math.max(size.X, size.Z)
			if length and longest > 0.05 then
				model:ScaleTo(length / longest) -- ponts : échelle d'après la longueur
			else
				local fitted, why = Assets.fitHeight(model, height) -- mesure puis vérification à ±10 % : sinon on ne pose pas
				if not fitted then
					error(why)
				end
			end
			local bbox, size2 = model:GetBoundingBox()
			local target = CFrame.new(x, (groundY or 0) + size2.Y / 2, z) * CFrame.Angles(0, math.rad(rotDeg or 0), 0)
			model:PivotTo(target * bbox:ToObjectSpace(model:GetPivot()))
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					count = count + 1
				end
			end
			model.Parent = parent
		end)
		if not ok then
			-- journal : le modèle est refusé (mesure, échelle ±10 %...) et l'apparence procédurale prend le relais
			if #A.placeFailures < 200 then
				A.placeFailures[#A.placeFailures + 1] = ("%s : %s"):format(mname, tostring(err))
			end
			pcall(function()
				model:Destroy()
			end)
			return false
		end
		return true, count
	end

	return A
end

return Assets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Reveal</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Reveal
-- Probabilité EXACTE d'un tirage et texte « 1 sur N » de la révélation d'œuf. Pur (Rules est injecté) et testé : la probabilité affichée
-- est celle que Rules.rollPet applique réellement (même poids de rareté, d'espèce, de taille, de mutation ; tirage de pitié inclus).
local Reveal = {}

-- Probabilité d'obtenir exactement (espèce p, taille s, mutation m) d'un œuf de rareté eggTier. guaranteed = tirage de pitié.
function Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local def = Config.PETS[p]
	if not def or not Config.SIZES[s] or not Config.MUTS[m] then
		return 0
	end
	local pTier
	eggTier = Config.liveEggTier(eggTier)
	local nxt = Config.nextLiveTier(eggTier)
	if guaranteed and eggTier <= Config.UPGRADE.maxEggTier and nxt then
		pTier = def.tier == nxt and 1 or 0
	else
		local w = Rules.tierWeights(eggTier, upPoints)
		local total = w[1] + w[2] + w[3]
		local idx = def.tier == eggTier and 2 or (def.tier == nxt and 3 or 0)
		pTier = (idx >= 1 and total > 0) and (math.max(w[idx], 0) / total) or 0
	end
	if pTier == 0 then
		return 0
	end
	local species = 0
	for _, q in ipairs(Config.PETS) do
		if q.tier == def.tier then
			species = species + 1
		end
	end
	local function share(weights, index)
		local total = 0
		for _, x in ipairs(weights) do
			total = total + math.max(x, 0)
		end
		return total > 0 and math.max(weights[index], 0) / total or 0
	end
	return pTier * (1 / species) * share(Rules.sizeWeights(), s) * share(Rules.mutWeights(alienBoost), m)
end

-- « 1 sur N » : N = 1 / probabilité (math.huge si impossible).
function Reveal.oneIn(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local pr = Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	return pr > 0 and 1 / pr or math.huge
end

-- Style de la révélation selon la rareté du pet et la probabilité réelle. Un tirage plus rare que Config.REVEAL.secret.oneInAtLeast
-- déclenche l'effet « œuf secret ». reduced = option mobile (moins de rayons, de particules et de secousse).
function Reveal.style(Config, petTier, oneIn, reduced)
	local R = Config.REVEAL
	local base = R.tiers[math.min(math.max(petTier, 1), #R.tiers)]
	local st = {}
	for k, v in pairs(base) do
		st[k] = v
	end
	st.secret = oneIn ~= nil and oneIn >= R.secret.oneInAtLeast
	if st.secret then
		for k, v in pairs(R.secret) do
			st[k] = v
		end
	end
	st.color = st.secret and R.secret.color or Config.TIERS[math.min(math.max(petTier, 1), #Config.TIERS)].color
	st.banner = Config.rarityBanner(petTier, st.secret)
	if reduced then
		local k = R.reducedFactor
		st.rays = math.max(4, math.floor(st.rays * k))
		st.particles = math.floor(st.particles * k)
		st.shake = st.shake * k
		st.rings = math.max(1, math.floor(st.rings * k + 0.5))
	end
	return st
end

-- Écran de tirage « machine à sous » : plan PUR des 3 colonnes. Chaque colonne est un anneau de symboles ; la position (continue, base 1) part de 1, tourne
-- `loops` tours puis ralentit (sortie en puissance 4) et s'arrête EXACTEMENT sur le résultat réel. fast : durées courtes (tirage banal ou mobile).
function Reveal.slotPlan(Config, petTier, sizeIdx, mutIdx, fast)
	local S = Config.REVEAL.slot
	local stops = fast and S.fastStops or S.stops
	local function column(title, symbols, final, k)
		local n = #symbols
		local f = math.min(math.max(math.floor(tonumber(final) or 1), 1), n)
		return { title = title, symbols = symbols, final = f, stop = stops[k], travel = n * S.loops[k] + (f - 1) }
	end
	local tiers, sizes, muts = {}, {}, {}
	for i, t in ipairs(Config.TIERS) do
		tiers[i] = { text = t.name, color = t.color }
	end
	for i, z in ipairs(Config.SIZES) do
		sizes[i] = { text = z.name } -- couleur nil : blanc côté client
	end
	for i, m in ipairs(Config.MUTS) do
		muts[i] = { text = m.name == "" and "Normal" or m.name, color = m.color }
	end
	local cols = { column("RARETÉ", tiers, petTier, 1), column("TAILLE", sizes, sizeIdx, 2), column("MUTATION", muts, mutIdx, 3) }
	return { columns = cols, duration = cols[3].stop + S.hold, hold = S.hold, tier = math.min(math.max(math.floor(tonumber(petTier) or 1), 1), #Config.TIERS) }
end

-- Position continue de la colonne `col` à l'instant t (s) : croît sans jamais reculer, ralentit, vaut exactement 1 + travel à l'arrêt.
function Reveal.slotPos(col, t)
	local u = math.min(math.max(t / col.stop, 0), 1)
	return 1 + col.travel * (1 - (1 - u) ^ 4)
end

-- Indice (1..n) du symbole centré à la position pos.
function Reveal.slotIndex(col, pos)
	local n = #col.symbols
	return (math.floor(pos + 0.5) - 1) % n + 1
end

return Reveal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Guard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Guard
-- Perception et état des gardiens (chien de Gus, loup de Mara, ours de Zed) : champ de vision (cône + distance), ouïe (le bruit dépend de la
-- vitesse du joueur), machine à états Patrouille / Alerte / Poursuite / Perte de cible / Retour, dégâts avec invulnérabilité courte et régénération.
-- PUR (aucun service Roblox, positions = tables { x, z }) : testé hors de Roblox. Main n'applique que ces décisions au monde.
local Guard = {}

local sqrt, acos, deg = math.sqrt, math.acos, math.deg

local function len(x, z)
	return sqrt(x * x + z * z)
end

-- Angle en degrés (0..180) entre le regard (fx, fz) et la direction (dx, dz). 0 si l'un des vecteurs est nul.
function Guard.angle(fx, fz, dx, dz)
	local a, b = len(fx, fz), len(dx, dz)
	if a < 1e-9 or b < 1e-9 then
		return 0
	end
	local c = (fx * dx + fz * dz) / (a * b)
	return deg(acos(math.max(-1, math.min(1, c))))
end

-- Le gardien g = { x, z, fx, fz } voit-il la cible t = { x, z } ? Cône de `viewAngle` degrés (total) et distance max `viewDist`.
function Guard.sees(g, t, viewDist, viewAngle)
	local dx, dz = t.x - g.x, t.z - g.z
	local d = len(dx, dz)
	if d > viewDist then
		return false
	end
	if d < 1.5 then
		return true -- collé au gardien : toujours vu
	end
	return Guard.angle(g.fx, g.fz, dx, dz) <= viewAngle / 2
end

-- Niveau de bruit (0..1) selon la vitesse : immobile = silence, marche lente = discret, course = plein bruit.
function Guard.noise(speed, cfg)
	if type(speed) ~= "number" or speed ~= speed or speed <= cfg.stillSpeed then
		return 0
	elseif speed < cfg.sneakSpeed then
		return cfg.sneakNoise
	end
	return 1
end

-- Entend-il la cible ? Rayon d'ouïe réduit proportionnellement au bruit.
function Guard.hears(dist, noise, hearRadius)
	return noise > 0 and dist <= hearRadius * noise
end

-- Perception complète : { sees, hears, dist }. g = { x, z, fx, fz }, t = { x, z, speed }, rival = { viewDist, viewAngle, hearRadius }.
function Guard.perceive(g, t, rival, cfg)
	local d = len(t.x - g.x, t.z - g.z)
	return { sees = Guard.sees(g, t, rival.viewDist, rival.viewAngle), hears = Guard.hears(d, Guard.noise(t.speed, cfg), rival.hearRadius), dist = d }
end

-- Machine à états. st = { state, timer, lost } ; percept = { sees, hears, atHome, dist } ; retourne le nouvel état (nouvelle table) et un événement
-- éventuel : "alert" (intrigué), "spotted" (poursuite), "lost" (cible perdue), "calm" (retour au calme).
--   patrol  : voit -> alert ; entend -> alert
--   alert   : s'arrête et regarde ; voit pendant alertDelay -> chase ; ne perçoit plus alertMax secondes -> return
--   chase   : voit ou entend -> poursuite continue ; ne perçoit plus -> lostChase ; trop loin (giveUpDist) -> return
--   lostChase : continue vers la dernière position connue loseDelay secondes (perte de cible), retrouve la cible -> chase, sinon -> return
--   return  : revient à la patrouille ; en route, voit -> alert
function Guard.nextState(st, dt, p, cfg)
	local s, timer, lost = st.state, st.timer or 0, st.lost or 0
	local event = nil
	if s == "patrol" then
		if p.sees or p.hears then
			s, timer, event = "alert", 0, "alert"
		end
	elseif s == "alert" then
		if p.sees then
			timer = timer + dt
			if timer >= cfg.alertDelay then
				s, timer, lost, event = "chase", 0, 0, "spotted"
			end
		elseif p.hears then
			timer = math.max(0, timer - dt * 0.25) -- bruit seul : reste méfiant mais ne poursuit pas
		else
			timer = timer + dt
			if timer >= cfg.alertMax then
				s, timer, event = "return", 0, "calm"
			end
		end
	elseif s == "chase" then
		if p.dist > cfg.giveUpDist then
			s, lost, event = "return", 0, "lost"
		elseif p.sees or p.hears then
			lost = 0
		else
			s, lost = "lostChase", 0
		end
	elseif s == "lostChase" then
		if p.sees or p.hears then
			s, lost, event = "chase", 0, "spotted"
		else
			lost = lost + dt
			if lost >= cfg.loseDelay then
				s, lost, event = "return", 0, "lost"
			end
		end
	else -- return
		if p.sees then
			s, timer, event = "alert", 0, "alert"
		elseif p.atHome then
			s, timer, event = "patrol", 0, "calm"
		end
	end
	return { state = s, timer = timer, lost = lost }, event
end

-- Alarme du nid (cour de Zed, lot 8A) : l'ours réveillé passe directement en poursuite du voleur (nouvelle table d'état).
function Guard.charge(_st)
	return { state = "chase", timer = 0, lost = 0 }
end

-- Dégâts : retourne (nouveaux points de vie, touché ?, invulnérabilité restante). Pendant l'invulnérabilité ou si hp <= 0 : aucun dégât.
function Guard.applyDamage(hp, damage, iframes, cfg)
	if iframes > 0 or hp <= 0 or damage <= 0 then
		return hp, false, iframes
	end
	return math.max(0, hp - damage), true, cfg.iframes
end

-- Régénération : après regenDelay secondes sans coup, regenPerSec par seconde (baseRegen par seconde dans la base du joueur). Plafonnée à maxHp.
-- Ramène (x, z) dans le disque de centre (cx, cz) et de rayon `radius` (territoire : le gardien ne quitte jamais son plateau ni ne traverse la douve).
function Guard.clampToDisc(x, z, cx, cz, radius)
	local dx, dz = x - cx, z - cz
	local d = len(dx, dz)
	if d <= radius or d < 1e-9 then
		return x, z
	end
	return cx + dx / d * radius, cz + dz / d * radius
end

-- Détection d'un gardien bloqué : `tr` = { t = 0 } conservé par gardien. Renvoie true quand il devrait bouger (want) mais avance de moins de cfg.stuckSpeed studs/s
-- depuis cfg.stuckSeconds secondes ; tout mouvement ou toute immobilité voulue (alerte) remet le compteur à zéro.
function Guard.stuckStep(tr, dt, moved, want, cfg)
	if not want or moved > cfg.stuckSpeed * dt then
		tr.t = 0
		return false
	end
	tr.t = tr.t + dt
	if tr.t >= cfg.stuckSeconds then
		tr.t = 0
		return true
	end
	return false
end

-- Pose de marche procédurale : rebond vertical et roulis en marchant (selon la vitesse), respiration à l'arrêt. `t` en secondes. Retourne (y, roulis en radians).
function Guard.walkPose(t, speed)
	if speed > 0.5 then
		local ph = t * speed * 0.9
		return math.abs(math.sin(ph)) * math.min(0.35, 0.04 * speed), math.sin(ph) * 0.06
	end
	return math.sin(t * 2) * 0.04, 0
end

-- Vigilance d'un territoire (Config.VIGILANCE) : `steals` = horodatages (s) des vols réussis dans CE territoire. Bonus de vue et d'ouïe = perSteal par vol
-- des `window` dernières secondes, plafonné à `max` ; retour à zéro `decay` secondes après le dernier vol. Retourne un nombre (0 .. max).
function Guard.vigilance(steals, now, cfg)
	local last, n = nil, 0
	for _, t in ipairs(steals) do
		if t <= now then
			if now - t <= cfg.window then
				n = n + 1
			end
			if last == nil or t > last then
				last = t
			end
		end
	end
	if last == nil or now - last >= cfg.decay then
		return 0
	end
	return math.min(cfg.max, n * cfg.perSteal)
end

-- Retire les vols trop anciens pour compter (hors de la fenêtre) : la liste ne grossit jamais. Retourne la nouvelle liste.
function Guard.vigilancePrune(steals, now, cfg)
	local out = {}
	for _, t in ipairs(steals) do
		if now - t <= cfg.window then
			out[#out + 1] = t
		end
	end
	return out
end

-- Réglages de perception majorés par la vigilance (vue et ouïe x (1 + bonus)) ; l'angle de vue ne change pas. Nouvelle table.
function Guard.boosted(rival, bonus)
	return { viewDist = rival.viewDist * (1 + bonus), viewAngle = rival.viewAngle, hearRadius = rival.hearRadius * (1 + bonus) }
end

function Guard.regen(hp, sinceHit, dt, atBase, cfg)
	if hp <= 0 or hp >= cfg.maxHp then
		return math.min(hp, cfg.maxHp)
	end
	local rate = atBase and cfg.baseRegen or (sinceHit >= cfg.regenDelay and cfg.regenPerSec or 0)
	return math.min(cfg.maxHp, hp + rate * dt)
end

return Guard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Traps</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Traps
-- Pièges des territoires (REFONTE lot 4) : fils à clochettes et flaques de boue de Mara, herse, dalles d'alarme et lanternes tournantes de Zed, plus la
-- fraîcheur des œufs de Zed. PUR (aucun service Roblox, positions = nombres x, z) : testé hors de Roblox. Les positions sont DÉRIVÉES de Config.TERR
-- (centre, rayon, entrée) : rien n'est écrit en dur. Le serveur (Main) applique les décisions, le Builder construit les Parts d'après `layout`.
local Traps = {}

local sqrt, cos, sin, rad, deg, acos, pi = math.sqrt, math.cos, math.sin, math.rad, math.deg, math.acos, math.pi

-- Tourne le vecteur unitaire (ux, uz) de `degrees` degrés.
local function rot(ux, uz, degrees)
	local c, s = cos(rad(degrees)), sin(rad(degrees))
	return ux * c - uz * s, ux * s + uz * c
end

-- Plan des pièges d'un territoire (nil si le territoire n'en a pas). `Config` = module Config. Tout est calculé autour de l'entrée du territoire :
--   fils à clochettes : 3 fils tangents sur l'arc à 70 % du rayon, à -30 / 0 / +30 degrés de l'entrée (demi-longueur Config.TRAPS.bellHalfWidth)
--   boue : flaques à 45 % du rayon, étalées de -70 à +70 degrés
--   dalles d'alarme : à 55 % du rayon, tous les 360/n degrés à partir de 45 degrés
--   lanternes : à 55 % du rayon, à +90 et -90 degrés, tournant en sens inverse l'une de l'autre depuis des angles opposés
--   herse : à l'entrée (Config.TERR.zed.traps.gate)
function Traps.layout(Config, key)
	local t = Config.TERR[key]
	local tr = t and t.traps
	if not tr then
		return nil
	end
	local C = Config.TRAPS
	local ex, ez = Config.territoryEntry(key)
	local dx, dz = ex - t.x, ez - t.z
	local d = sqrt(dx * dx + dz * dz)
	local ux, uz = dx / d, dz / d
	local function at(frac, degrees)
		local vx, vz = rot(ux, uz, degrees)
		return t.x + vx * t.r * frac, t.z + vz * t.r * frac, vx, vz
	end
	local L = { key = key, cx = t.x, cz = t.z, r = t.r, bells = {}, mud = {}, plates = {}, lights = {}, gate = nil }
	for k = 1, tr.bells or 0 do
		local x, z, vx, vz = at(0.7, (k - 2) * 30)
		local tx, tz = -vz, vx -- tangente au cercle : le fil barre le passage vers l'intérieur
		L.bells[k] = { x = x, z = z, ax = x - tx * C.bellHalfWidth, az = z - tz * C.bellHalfWidth, bx = x + tx * C.bellHalfWidth, bz = z + tz * C.bellHalfWidth }
	end
	local nm = tr.mud or 0
	for k = 1, nm do
		local x, z = at(0.45, -70 + (k - 1) * 140 / math.max(1, nm - 1))
		L.mud[k] = { x = x, z = z, r = C.mudRadius }
	end
	local np = tr.plates or 0
	for k = 1, np do
		local x, z = at(0.55, 45 + (k - 1) * 360 / np)
		L.plates[k] = { x = x, z = z, r = C.plateRadius }
	end
	for k = 1, tr.searchlights or 0 do
		local x, z = at(0.55, 90 + (k - 1) * 180)
		L.lights[k] = { x = x, z = z, phase = (k - 1) * pi, rev = tr.searchlightRev or 0.5, range = C.lightRange, cone = C.lightCone }
	end
	if tr.gate then
		L.gate = { x = tr.gate.x, z = tr.gate.z, open = tr.gate.open, closed = tr.gate.closed }
	end
	return L
end

-- Nombre de Parts que les pièges d'un plan font construire au Builder (budget : <= 40 pour tous les territoires).
-- fil : 2 poteaux + le fil ; flaque : 1 ; dalle : 1 ; lanterne : poteau + faisceau ; herse : 0 (la Part CourtGate de Scenery est réutilisée).
function Traps.partCount(L)
	if not L then
		return 0
	end
	return #L.bells * 3 + #L.mud + #L.plates + #L.lights * 2
end

---------------------------------------------------------------- géométrie
local function orient(px, pz, qx, qz, rx, rz)
	return (qx - px) * (rz - pz) - (qz - pz) * (rx - px)
end

-- Les segments [a b] et [c d] se croisent-ils strictement ?
function Traps.segCross(ax, az, bx, bz, cx, cz, dx, dz)
	local o1, o2 = orient(ax, az, bx, bz, cx, cz), orient(ax, az, bx, bz, dx, dz)
	local o3, o4 = orient(cx, cz, dx, dz, ax, az), orient(cx, cz, dx, dz, bx, bz)
	return o1 * o2 < 0 and o3 * o4 < 0
end

-- Distance du point (px, pz) au segment [a b].
function Traps.distToSeg(px, pz, ax, az, bx, bz)
	local vx, vz = bx - ax, bz - az
	local l2 = vx * vx + vz * vz
	local t = l2 > 0 and math.max(0, math.min(1, ((px - ax) * vx + (pz - az) * vz) / l2)) or 0
	local qx, qz = ax + vx * t, az + vz * t
	return sqrt((px - qx) ^ 2 + (pz - qz) ^ 2)
end

---------------------------------------------------------------- herse (cycle ouverte `open` s / fermée `closed` s, ouverte au temps 0)
function Traps.gateOpen(t, gate)
	local cyc = gate.open + gate.closed
	return (t % cyc) < gate.open
end

-- Hauteur de la herse : 1 = levée (ouverte), 0 = baissée (fermée). Montée ou descente en `window` secondes au début de chaque phase.
function Traps.gateLift(t, gate, window)
	local cyc = gate.open + gate.closed
	local ph = t % cyc
	if ph < gate.open then
		return math.min(1, ph / window)
	end
	return math.max(0, 1 - (ph - gate.open) / window)
end

-- La herse est SOLIDE tant qu'elle est descendue à moitié ou plus (elle ne bloque pas pendant qu'elle monte).
function Traps.gateSolid(t, gate, window)
	return Traps.gateLift(t, gate, window) <= 0.5 and not Traps.gateOpen(t, gate)
end

---------------------------------------------------------------- lanternes tournantes
function Traps.lanternAngle(t, light)
	return light.phase + 2 * pi * light.rev * t
end

-- La lanterne éclaire-t-elle (px, pz) au temps t ? Portée `range`, cône de `cone` degrés (total) centré sur l'angle courant.
function Traps.lanternSees(light, t, px, pz)
	local dx, dz = px - light.x, pz - light.z
	local d = sqrt(dx * dx + dz * dz)
	if d > light.range then
		return false
	end
	if d < 1 then
		return true
	end
	local a = Traps.lanternAngle(t, light)
	local c = (cos(a) * dx + sin(a) * dz) / d
	return deg(acos(math.max(-1, math.min(1, c)))) <= light.cone / 2
end

---------------------------------------------------------------- décision par joueur
function Traps.newPlayerState()
	return { px = nil, pz = nil, mudUntil = 0, cd = {} }
end

-- Un pas de simulation pour un joueur en (x, z) au temps t (le serveur l'appelle ~10 fois par seconde pour les joueurs proches du territoire).
-- Met `ps` à jour (position précédente, délais) et retourne la liste des événements :
--   { kind = "bell", index }  : le joueur a traversé un fil (ou le frôle à moins d'un stud)
--   { kind = "plate", index } : il marche sur une dalle d'alarme
--   { kind = "light", index } : une lanterne l'éclaire
--   { kind = "mud", index }   : il entre dans une flaque (une seule fois par passage ; la vitesse est ralentie tant que t < ps.mudUntil)
-- Chaque alarme a un délai de recharge par joueur (cfg = Config.TRAPS).
function Traps.playerStep(ps, L, cfg, t, x, z)
	local ev = {}
	local qx, qz = ps.px or x, ps.pz or z
	ps.px, ps.pz = x, z
	for i, b in ipairs(L.bells) do
		local key = "b" .. i
		if t >= (ps.cd[key] or 0) and (Traps.segCross(qx, qz, x, z, b.ax, b.az, b.bx, b.bz) or Traps.distToSeg(x, z, b.ax, b.az, b.bx, b.bz) < 1) then
			ps.cd[key] = t + cfg.bellCooldown
			ev[#ev + 1] = { kind = "bell", index = i }
		end
	end
	for i, m in ipairs(L.mud) do
		if (x - m.x) ^ 2 + (z - m.z) ^ 2 <= m.r * m.r then
			if t >= ps.mudUntil then
				ev[#ev + 1] = { kind = "mud", index = i }
			end
			ps.mudUntil = t + cfg.mudSeconds
		end
	end
	for i, p in ipairs(L.plates) do
		local key = "p" .. i
		if t >= (ps.cd[key] or 0) and (x - p.x) ^ 2 + (z - p.z) ^ 2 <= p.r * p.r then
			ps.cd[key] = t + cfg.plateCooldown
			ev[#ev + 1] = { kind = "plate", index = i }
		end
	end
	for i, l in ipairs(L.lights) do
		local key = "l" .. i
		if t >= (ps.cd[key] or 0) and Traps.lanternSees(l, t, x, z) then
			ps.cd[key] = t + cfg.lightCooldown
			ev[#ev + 1] = { kind = "light", index = i }
		end
	end
	return ev
end

-- Multiplicateur de vitesse de la boue (1 hors flaque).
function Traps.mudMul(ps, t, cfg)
	return t < ps.mudUntil and cfg.mudMul or 1
end

---------------------------------------------------------------- fraîcheur des œufs
-- Échéance (temps absolu) d'un œuf de rareté `tier` pris dans le territoire `terr`, ou nil s'il ne se refroidit pas : seuls les œufs de rareté
-- Config.CARRY.beamTier ou plus (Légendaire+) pris dans un territoire qui a une `freshness` (Zed : 75 s).
function Traps.freshDeadline(Config, tier, terr, now)
	local t = terr and Config.TERR[terr]
	if t and t.freshness and tier >= Config.CARRY.beamTier then
		return now + t.freshness
	end
	return nil
end

function Traps.expired(egg, now)
	return egg.fresh ~= nil and now >= egg.fresh
end

return Traps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Riddle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Riddle
-- REFONTE lot 6 : énigme de la Mère Poule en 3 étapes GUIDÉES (plumes, runes, berceuse). Module PUR : aucune dépendance à Roblox, testé avec Lune/lupa.
-- Le serveur tient l'état (profil `puzzle`), le client ne fait qu'afficher ; ce module décide de tout ce qui est « règle » :
--   plumes du jour, berceuse du jour, transitions d'étape (refusées si invalides), indices, compte à rebours, répliques, guidage, effet collectif.
--
-- Générateur : Config.dayRng (le MÊME Park-Miller déterministe que Config.riddleFor) avec un « sel » par usage, pour que les plumes, la berceuse et
-- les runes d'un même jour ne soient pas corrélées : plumes = dayRng(jour + 5003), berceuse = dayRng(jour + 9007), runes = dayRng(jour) (Config.riddleFor).
-- Même jour = mêmes plumes, mêmes runes, même berceuse pour tous les joueurs.
--
-- Étapes : 0 non commencée · 1 plumes · 2 runes · 3 berceuse · 4 faite (= puzzle.day == jour). Le profil ne stocke que 0..3 (+ puzzle.pday, le jour de la
-- progression : un autre jour = remise à zéro) ; « 4 » se déduit de puzzle.day.
local Riddle = {}

Riddle.STEP = { idle = 0, feathers = 1, runes = 2, lullaby = 3, done = 4 }
Riddle.DIRS = { "N", "E", "S", "O" } -- ordre de Config.RUNE_DIRECTIONS et de Config.Map2.runeStones
Riddle.DIR_OF = { "du Nord", "de l'Est", "du Sud", "de l'Ouest" } -- « La plume du Nord », « la rune de l'Est »
local FEATHER_SALT, LULLABY_SALT = 5003, 9007
local BIT = { 1, 2, 4, 8 } -- masque des plumes : Nord 1, Est 2, Sud 4, Ouest 8

local function validDir(dir)
	return type(dir) == "number" and dir == dir and dir % 1 == 0 and dir >= 1 and dir <= 4
end

-- Profil `puzzle` neuf (même forme que Data.default().puzzle).
function Riddle.fresh()
	return { day = 0, solved = 0, step = 0, feathers = 0, hints = 0, fragments = 0, pday = 0, met = false }
end

---------------------------------------------------------------- Plumes et berceuse du jour
-- Une plume par direction (N, E, S, O) parmi les 3 emplacements de Config.FEATHER_SPOTS : { { dir, key, index, x, z, where } x4 }.
function Riddle.featherSpots(Config, day)
	local r = Config.dayRng(day + FEATHER_SALT)
	local out = {}
	for dir = 1, 4 do
		local list = Config.FEATHER_SPOTS[Riddle.DIRS[dir]]
		local idx = r(#list)
		local sp = list[idx]
		out[dir] = { dir = dir, key = Riddle.DIRS[dir], index = idx, x = sp.x, z = sp.z, where = sp.where, dock = sp.dock == true }
	end
	return out
end

-- Berceuse du jour : Config.HEN.lullabyLength pierres (numéros 1..4 = Nord, Est, Sud, Ouest), chaque pierre présente au moins une fois
-- (les 4 pierres d'abord, puis des pierres tirées, le tout mélangé).
function Riddle.lullaby(Config, day)
	local r = Config.dayRng(day + LULLABY_SALT)
	local n = math.max(4, Config.HEN.lullabyLength)
	local seq = { 1, 2, 3, 4 }
	for i = 5, n do
		seq[i] = r(4)
	end
	for i = n, 2, -1 do
		local j = r(i)
		seq[i], seq[j] = seq[j], seq[i]
	end
	return seq
end

-- Durée totale d'une écoute de la berceuse (secondes) : chaque pierre brille `lullabyNote` s, puis `lullabyGap` s de silence.
function Riddle.lullabyDuration(Config)
	return Config.HEN.lullabyLength * (Config.HEN.lullabyNote + Config.HEN.lullabyGap)
end

-- Début (en secondes depuis le début de l'écoute) de la note i.
function Riddle.noteStart(Config, i)
	return (i - 1) * (Config.HEN.lullabyNote + Config.HEN.lullabyGap)
end

---------------------------------------------------------------- État et transitions (toutes pures : elles modifient p et disent si c'était permis)
function Riddle.available(chaptersDone)
	return type(chaptersDone) == "number" and chaptersDone >= 2 -- chapitre 2 réussi
end

function Riddle.featherCount(mask)
	local n = 0
	for dir = 1, 4 do
		if math.floor(mask / BIT[dir]) % 2 == 1 then
			n = n + 1
		end
	end
	return n
end

function Riddle.hasFeather(mask, dir)
	return validDir(dir) and type(mask) == "number" and math.floor(mask / BIT[dir]) % 2 == 1
end

-- Un autre jour que celui de la progression : remise à zéro (étape, plumes, indices ; fragments et résolutions sont conservés).
-- Retourne true si une remise à zéro a eu lieu, puis true si une progression a été perdue.
function Riddle.normalize(p, day)
	if p.pday ~= day then
		local lost = p.step ~= 0 or p.feathers ~= 0 or p.hints ~= 0
		p.pday, p.step, p.feathers, p.hints = day, 0, 0, 0
		return true, lost
	end
	return false, false
end

-- Étape effective : 4 si résolue ce jour, sinon l'étape sauvegardée (0..3).
function Riddle.stepOf(p, day)
	if p.day == day then
		return 4
	end
	return p.step
end

-- 0 -> 1 : le joueur accepte d'aider la Mère Poule. Refusée si indisponible (chapitre 2), déjà faite ou déjà commencée.
function Riddle.start(p, day, avail)
	if not avail then
		return false, "locked"
	end
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 0 then
		return false, "started"
	end
	p.step = 1
	return true
end

-- Ramassage d'une plume (étape 1 seulement). Retourne ok, nombre de plumes (ou ok=false, raison).
function Riddle.collect(p, day, dir)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 1 then
		return false, "step"
	end
	if not validDir(dir) then
		return false, "dir"
	end
	if Riddle.hasFeather(p.feathers, dir) then
		return false, "have"
	end
	p.feathers = p.feathers + BIT[dir]
	return true, Riddle.featherCount(p.feathers)
end

-- 1 -> 2 : IMPOSSIBLE sans les 4 plumes.
function Riddle.toRunes(p, day)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 1 then
		return false, "step"
	end
	if Riddle.featherCount(p.feathers) ~= 4 then
		return false, "feathers"
	end
	p.step = 2
	return true
end

-- Une rune ne se tourne qu'une fois la plume de sa direction ramassée, et seulement pendant les étapes 1 et 2.
function Riddle.runeUnlocked(p, day, dir)
	if p.day == day or p.pday ~= day then
		return false
	end
	return (p.step == 1 or p.step == 2) and Riddle.hasFeather(p.feathers, dir)
end

-- Nombre de runes justes (jamais lesquelles). runes et answer : 4 symboles.
function Riddle.runesCorrect(runes, answer)
	local k = 0
	for i = 1, 4 do
		if runes[i] ~= nil and runes[i] == answer[i] then
			k = k + 1
		end
	end
	return k
end

-- 2 -> 3 : seulement si les 4 runes sont justes (`correct` = résultat de runesCorrect).
function Riddle.toLullaby(p, day, correct)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 2 then
		return false, "step"
	end
	if correct ~= 4 then
		return false, "runes"
	end
	p.step = 3
	return true
end

-- Touche d'une pierre pendant la berceuse : seq = suite attendue, pos = position attendue (1..#seq), stone = pierre touchée (1..4).
-- Retourne "ok" (bonne pierre, pos avance), "done" (dernière pierre juste) ou "wrong" (erreur : pos revient à 1, la suite est rejouée).
function Riddle.tap(seq, pos, stone)
	if seq[pos] ~= nil and stone == seq[pos] then
		if pos >= #seq then
			return "done", 1
		end
		return "ok", pos + 1
	end
	return "wrong", 1
end

function Riddle.tapAllowed(Config, now, lastTap)
	return type(now) == "number" and type(lastTap) == "number" and now - lastTap >= Config.HEN.tapMinGap
end

function Riddle.pickupAllowed(Config, dist, now, lastPick)
	return type(dist) == "number" and dist == dist and dist <= Config.HEN.pickupDistance and type(now) == "number" and type(lastPick) == "number" and now - lastPick >= Config.HEN.pickupGap
end

-- 3 -> 4 : récompense UNE fois par jour. Retourne ok puis { eggTier, coinsMins, fragments, legendary, titleNew } ; fragments cumulés,
-- 1 œuf Légendaire à chaque tranche de Config.HEN.fragmentsForEgg (7) atteinte, titre « Ami de la Mère Poule » dès 7.
function Riddle.complete(Config, p, day, lullabyDone)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 3 then
		return false, "step"
	end
	if lullabyDone ~= true then
		return false, "lullaby"
	end
	local before = p.fragments
	local after = before + 1
	local per = Config.HEN.fragmentsForEgg
	local legendary = math.floor(after / per) - math.floor(before / per)
	p.day = day
	p.solved = p.solved + 1
	p.step, p.feathers = 0, 0
	p.fragments = after
	return true, { eggTier = Config.PUZZLE_EGG_TIER, mins = Config.PUZZLE_MINS, fragments = after, legendary = legendary, titleNew = before < per and after >= per }
end

function Riddle.hasTitle(Config, fragments)
	return type(fragments) == "number" and fragments >= Config.HEN.fragmentsForEgg
end

---------------------------------------------------------------- Indices (« 💡 Un coup de bec »)
-- 2 par jour, jamais payants. Le 1er : gratuit après hintAfterSeconds dans l'étape courante. Le 2e : après failsForHint validations ratées à l'étape 2.
-- Retourne ok ; sinon false, raison ("step" | "max" | "wait" | "fails"), et le temps (s) ou le nombre de validations ratées restantes.
function Riddle.hintStatus(Config, p, day, secondsInStep, fails)
	local H = Config.HEN
	local step = Riddle.stepOf(p, day)
	if step < 1 or step > 3 then
		return false, "step"
	end
	if p.hints >= H.hintsPerDay then
		return false, "max"
	end
	if p.hints == 0 then
		if secondsInStep >= H.hintAfterSeconds then
			return true
		end
		return false, "wait", math.ceil(H.hintAfterSeconds - secondsInStep)
	end
	if step == 2 and fails >= H.failsForHint then
		return true
	end
	return false, "fails", step == 2 and (H.failsForHint - fails) or nil
end

-- Contenu de l'indice : identifiant de réplique et paramètres. runes = symboles actuels du joueur (4 numéros).
function Riddle.hintFor(Config, p, day, runes)
	local step = Riddle.stepOf(p, day)
	if step == 1 then
		local spots = Riddle.featherSpots(Config, day)
		for dir = 1, 4 do
			if not Riddle.hasFeather(p.feathers, dir) then
				return "hintFeather", { dir = Riddle.DIR_OF[dir], where = spots[dir].where }
			end
		end
	elseif step == 2 then
		local answer = Config.riddleFor(day).answer
		for dir = 1, 4 do
			if runes[dir] ~= answer[dir] then
				return "hintRune", { dir = Riddle.DIR_OF[dir], symbol = Config.RUNES[answer[dir]] }
			end
		end
	elseif step == 3 then
		return "hintLullaby", { dir = Riddle.DIR_OF[Riddle.lullaby(Config, day)[1]] }
	end
	return nil
end

---------------------------------------------------------------- Compte à rebours
-- « Nouvelle berceuse dans h mm » : heures, minutes (arrondies au-dessus), secondes restantes avant 00:00 UTC.
function Riddle.untilNext(now)
	local left = 86400 - (now % 86400)
	local total = math.ceil(left / 60)
	return math.floor(total / 60), total % 60, left
end

---------------------------------------------------------------- Répliques
function Riddle.format(tpl, params)
	return (tpl:gsub("{(%w+)}", function(k)
		local v = params and params[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

-- « du Nord, de l'Est et de l'Ouest » d'après le masque de plumes (les directions MANQUANTES).
function Riddle.missingDirs(mask)
	local list = {}
	for dir = 1, 4 do
		if not Riddle.hasFeather(mask, dir) then
			list[#list + 1] = Riddle.DIR_OF[dir]
		end
	end
	if #list <= 1 then
		return list[1] or ""
	end
	return table.concat(list, ", ", 1, #list - 1) .. " et " .. list[#list]
end

-- Paramètres de la réplique « missing » d'après le masque.
function Riddle.missingParams(mask)
	return { n = 4 - Riddle.featherCount(mask), dirs = Riddle.missingDirs(mask) }
end

-- Réplique « {h} h {mm} ».
function Riddle.doneParams(now)
	local h, m = Riddle.untilNext(now)
	return { h = h, mm = string.format("%02d", m) }
end

-- Texte d'une réplique (id de Config.HEN_LINES) : { id, pages = { texte, ... }, buttons = { { id, text }, ... } }.
-- step = étape du joueur : ajoute « 💡 Un coup de bec » (étapes 1 à 3) et « 🔁 Réécouter » (étape 3) aux répliques de suivi.
function Riddle.say(Config, id, params, step)
	local L = Config.HEN_LINES
	local B = L.buttons
	local pages, ids = nil, {}
	if id == "first" then
		pages, ids = L.first, { "go", "again" }
	elseif id == "explain" or id == "again" then
		pages, ids = { L[id] }, { "go", "later" }
	elseif id == "success" or id == "done" or id == "locked" or id == "feather" then
		pages = { L[id] }
	elseif L[id] ~= nil and type(L[id]) == "string" then
		pages = { L[id] }
		if step == 1 or step == 2 or step == 3 then
			ids[#ids + 1] = "hint"
		end
		if step == 3 then
			ids[#ids + 1] = "replay"
		end
	else
		return { id = id, pages = {}, buttons = {} }
	end
	local out = {}
	for i, p in ipairs(pages) do
		out[i] = Riddle.format(p, params)
	end
	local buttons = {}
	for _, b in ipairs(ids) do
		buttons[#buttons + 1] = { id = b, text = B[b] }
	end
	return { id = id, pages = out, buttons = buttons }
end

-- Texte d'une plume ramassée : « 🪶 Plume du Nord : « ce qui coule et berce » ».
function Riddle.featherLine(Config, day, dir)
	local clue = Config.riddleFor(day).clues[dir]
	return Riddle.format(Config.HEN_LINES.feather, { dir = Riddle.DIR_OF[dir], clue = clue }), clue
end

---------------------------------------------------------------- Guidage (faisceau, mini-carte)
-- Centre du quart de carte (quadrant Nord-Ouest, Nord-Est, Sud-Ouest, Sud-Est de Config.Map2.bounds) qui contient (x, z).
function Riddle.quarter(Config, x, z)
	local b = Config.Map2.bounds
	return (x < 0 and b.x0 or b.x1) / 2, (z < 0 and b.z0 or b.z1) / 2
end

local function dist2d(ax, az, bx, bz)
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Cible du faisceau jaune d'après l'état `hen` envoyé par le serveur (avail, step, spots = plumes NON ramassées { dir, x, z }) et la position du joueur.
-- { kind = "hen" | "quarter" | "feather" | "runes", x, z, dir, near } ou nil. Étape 0 : la Mère Poule. Étape 1 : le centre du quart de carte de la plume la
-- plus proche tant qu'on en est loin (> quarterReach du centre), puis la plume elle-même ; `near` = à moins de sparkleDistance (la plume scintille).
-- Étapes 2 et 3 : le Grand Œuf (les 4 runes l'entourent).
function Riddle.guide(Config, hen, px, pz)
	if type(hen) ~= "table" or hen.avail ~= true or type(hen.step) ~= "number" or hen.step >= 4 then
		return nil
	end
	local H = Config.HEN
	if hen.step == 0 then
		return { kind = "hen", x = Config.Map2.hen.x, z = Config.Map2.hen.z }
	elseif hen.step >= 2 then
		return { kind = "runes", x = Config.Map2.bigEgg.x, z = Config.Map2.bigEgg.z }
	end
	local best, bd = nil, math.huge
	for _, sp in ipairs(hen.spots or {}) do
		if type(sp.x) == "number" and type(sp.z) == "number" then
			local d = dist2d(px, pz, sp.x, sp.z)
			if d < bd then
				best, bd = sp, d
			end
		end
	end
	if not best then
		return { kind = "hen", x = Config.Map2.hen.x, z = Config.Map2.hen.z }
	end
	if bd <= H.sparkleDistance then
		return { kind = "feather", x = best.x, z = best.z, dir = best.dir, near = true }
	end
	local qx, qz = Riddle.quarter(Config, best.x, best.z)
	if dist2d(px, pz, qx, qz) > H.quarterReach then
		return { kind = "quarter", x = qx, z = qz, dir = best.dir }
	end
	return { kind = "feather", x = best.x, z = best.z, dir = best.dir, near = false }
end

---------------------------------------------------------------- Effet collectif (Pluie de chance)
-- c = { day, count, fired } propre au serveur. Retourne true quand l'événement doit démarrer MAINTENANT (une fois par jour et par serveur).
function Riddle.collectiveAdd(Config, c, day)
	if c.day ~= day then
		c.day, c.count, c.fired = day, 0, false
	end
	c.count = c.count + 1
	if not c.fired and c.count >= Config.HEN.collectiveSolves then
		c.fired = true
		return true
	end
	return false
end

return Riddle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Castle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Castle
-- Mode « Château » : donjon de salles successives avec pièges à éviter (pics, lames tournantes, boulets, porte à timing) et coffre final.
-- Logique PURE (aucun service Roblox) : géométrie des salles, états des pièges en fonction du temps, détection des touches, difficulté croissante,
-- classement des temps et récompense. Coordonnées d'une salle : lx (travers, -20..20) et lz (profondeur depuis l'entrée, 0..roomLength).
local Castle = {}

Castle.ROOMS = 5
Castle.ROOM_LENGTH = 56
Castle.ROOM_WIDTH = 40
Castle.ORIGIN = { x = 470, z = -280 } -- entrée de la salle 1 dans le monde ; les salles avancent vers -z

-- Difficulté d'une salle r (1..ROOMS) : nombre de pièges et rythme, croissants.
function Castle.room(r)
	r = math.min(math.max(r, 1), Castle.ROOMS)
	return {
		index = r,
		spikes = 3 + r, -- plaques à pics (4 colonnes)
		blades = r >= 4 and 2 or (r >= 2 and 1 or 0),
		balls = r >= 3 and (r - 2) or 0,
		knights = r >= 5 and 2 or (r >= 3 and 1 or 0), -- chevaliers qui patrouillent d'un mur à l'autre (touche non mortelle)
		period = math.max(1.6, 3.4 - 0.3 * r), -- durée d'un cycle des pics (s)
		bladeSpeed = 1.2 + 0.3 * r, -- radians par seconde
		ballTravel = math.max(1.6, 3.2 - 0.25 * r), -- traversée d'un boulet (s)
		doorPeriod = math.max(3, 5 - 0.4 * r), -- cycle de la porte (s)
		doorOpen = math.max(1.4, 2.4 - 0.2 * r), -- durée d'ouverture (s)
	}
end

-- Pics : phase 0..1 du cycle ; avertissement avant le danger (les pics se dressent), danger 0,9 s par cycle.
local DANGER, WARN = 0.9, 0.6
function Castle.spikeState(t, trap, room)
	local period = room.period
	local phase = ((t + trap.offset) % period)
	local dangerStart = period - DANGER
	if phase >= dangerStart then
		return "danger"
	elseif phase >= dangerStart - WARN then
		return "warning"
	end
	return "safe"
end

-- Plaques à pics de la salle : 4 colonnes espacées (couloirs sûrs de 4 studs entre elles), phases décalées.
function Castle.spikes(room)
	local out = {}
	for i = 1, room.spikes do
		local col, row = (i - 1) % 4, math.floor((i - 1) / 4)
		out[i] = { lx = -15 + col * 10, lz = 10 + row * 9, radius = 3, offset = ((col + row) % 4) * (room.period / 4) }
	end
	return out
end

-- Lames tournantes : centre de la salle, deux bras opposés de 14 studs, angle selon le temps.
function Castle.blades(room)
	local out = {}
	for i = 1, room.blades do
		out[i] = { lx = (i - (room.blades + 1) / 2) * 20, lz = 34, arm = 14, phase = (i - 1) * math.pi / 2 }
	end
	return out
end

function Castle.bladeAngle(t, blade, room)
	return blade.phase + t * room.bladeSpeed
end

-- Boulets : couloirs horizontaux (traversée de gauche à droite puis pause avant de recommencer).
function Castle.balls(room)
	local out = {}
	for i = 1, room.balls do
		out[i] = { lz = 18 + (i - 1) * 9, radius = 3, offset = (i - 1) * 0.9 }
	end
	return out
end

-- Position latérale d'un boulet (nil pendant la pause).
function Castle.ballX(t, ball, room)
	local cycle = room.ballTravel + 1.4
	local phase = (t + ball.offset) % cycle
	if phase >= room.ballTravel then
		return nil
	end
	return -22 + 44 * (phase / room.ballTravel)
end

-- Chevaliers : patrouille en aller-retour latéral (onde triangulaire, vitesse constante), décalés pour ne pas être synchrones.
function Castle.knights(room)
	local out = {}
	for i = 1, room.knights do
		out[i] = { lz = 14 + (i - 1) * 24, amp = 15, period = math.max(5, 9 - 0.7 * room.index), offset = (i - 1) * 2.3, radius = 2.6 }
	end
	return out
end

-- Position latérale et sens (+1 vers la droite, -1 vers la gauche) d'un chevalier à l'instant t.
function Castle.knightPos(t, k)
	local phase = ((t + k.offset) % k.period) / k.period -- 0..1
	if phase < 0.5 then
		return -k.amp + 4 * k.amp * phase, 1
	end
	return k.amp - 4 * k.amp * (phase - 0.5), -1
end

-- Porte de fin de salle : ouverte pendant doorOpen secondes par cycle.
function Castle.doorIsOpen(t, room)
	return (t % room.doorPeriod) < room.doorOpen
end

-- Distance d'un point au segment [a, b].
local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local u = l2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / l2)) or 0
	local cx, cz = ax + u * dx, az + u * dz
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Castle.distToSegment = distToSegment

-- Le joueur (px, pz en coordonnées locales de salle) est-il touché par un piège à l'instant t ? Retourne le nom du piège ou nil.
function Castle.hit(t, room, px, pz, playerRadius)
	playerRadius = playerRadius or 1.2
	for _, sp in ipairs(Castle.spikes(room)) do
		if Castle.spikeState(t, sp, room) == "danger" and math.sqrt((px - sp.lx) ^ 2 + (pz - sp.lz) ^ 2) < sp.radius + playerRadius * 0.5 then
			return "spikes"
		end
	end
	for _, bl in ipairs(Castle.blades(room)) do
		local a = Castle.bladeAngle(t, bl, room)
		local cx, cz = math.cos(a) * bl.arm, math.sin(a) * bl.arm
		if distToSegment(px, pz, bl.lx - cx, bl.lz - cz, bl.lx + cx, bl.lz + cz) < 1.6 + playerRadius * 0.5 then
			return "blade"
		end
	end
	for _, ba in ipairs(Castle.balls(room)) do
		local bx = Castle.ballX(t, ba, room)
		if bx and math.sqrt((px - bx) ^ 2 + (pz - ba.lz) ^ 2) < ba.radius + playerRadius * 0.5 then
			return "ball"
		end
	end
	for _, kn in ipairs(Castle.knights(room)) do
		local kx = Castle.knightPos(t, kn)
		if math.sqrt((px - kx) ^ 2 + (pz - kn.lz) ^ 2) < kn.radius + playerRadius * 0.5 then
			return "knight"
		end
	end
	return nil
end

-- Conversion monde <-> salle : la salle r commence à ORIGIN.z - (r - 1) * ROOM_LENGTH et avance vers -z.
function Castle.toLocal(wx, wz)
	local depth = Castle.ORIGIN.z - wz -- profondeur totale depuis l'entrée
	local r = math.floor(depth / Castle.ROOM_LENGTH) + 1
	return r, wx - Castle.ORIGIN.x, depth - (r - 1) * Castle.ROOM_LENGTH
end

function Castle.toWorld(r, lx, lz)
	return Castle.ORIGIN.x + lx, Castle.ORIGIN.z - ((r - 1) * Castle.ROOM_LENGTH + lz)
end

-- Joueur dans le château ? (rectangle des salles). Retourne le numéro de salle ou nil.
function Castle.roomAt(wx, wz)
	local r, lx, lz = Castle.toLocal(wx, wz)
	if r >= 1 and r <= Castle.ROOMS and math.abs(lx) <= Castle.ROOM_WIDTH / 2 and lz >= 0 then
		return r, lx, lz
	end
	return nil
end

-- Classement des temps (secondes, plus petit = meilleur) : insère { name, userId, time }, conserve `max` entrées, un seul meilleur temps par joueur.
-- Retourne (nouvelle liste, rang du joueur ou nil s'il n'entre pas).
function Castle.insertScore(list, entry, max)
	local out, existing = {}, nil
	for _, e in ipairs(list) do
		if e.userId == entry.userId then
			existing = e
		else
			out[#out + 1] = e
		end
	end
	if existing and existing.time <= entry.time then
		local same = {}
		for i, e in ipairs(list) do
			same[i] = e
		end
		return same, nil -- son meilleur temps existant est conservé
	end
	out[#out + 1] = entry
	table.sort(out, function(a, b)
		if a.time ~= b.time then
			return a.time < b.time
		end
		return a.userId < b.userId
	end)
	local rank = nil
	for i, e in ipairs(out) do
		if e == entry then
			rank = i
		end
	end
	while #out > max do
		table.remove(out)
	end
	if rank and rank > max then
		rank = nil
	end
	return out, rank
end

-- Durée en « m:ss.d » (arrondie au dixième).
function Castle.formatTime(seconds)
	if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 then
		return "--:--.-"
	end
	local tenths = math.floor(seconds * 10 + 0.5)
	local m = tenths // 600
	local rest = (tenths - m * 600) / 10
	return string.format("%d:%04.1f", m, rest)
end

Castle.REWARD_TIERS = { fast = 5, slow = 4 } -- lot 9 : Légendaire et Épique (indices des 10 raretés)
-- Récompense du coffre final : œuf rare (Épique, Légendaire si temps rapide), pièces proportionnelles aux revenus.
-- fastTime : durée de référence « rapide » (s) pour ce nombre de salles.
function Castle.reward(timeSeconds, income, deaths)
	local fast = 60 * Castle.ROOMS * 0.6 -- 3 min : bon temps
	local tier = (timeSeconds <= fast and (deaths or 0) == 0) and Castle.REWARD_TIERS.fast or Castle.REWARD_TIERS.slow
	local coins = math.floor(math.max(5000, income * 600 * (timeSeconds <= fast and 1.5 or 1)))
	return { eggTier = tier, coins = coins }
end

return Castle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Upgrade</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Upgrade
-- Montée de niveau de la maison (REFONTE lot 5, D.4) : LOGIQUE PURE (aucun service Roblox), testée hors de Roblox. Calcule, pour un temps t (secondes),
-- l'état de chaque phase de l'animation ; le client (BaseUpgradeFx) l'applique aux objets. Ne lève jamais d'erreur (valeurs invalides = début).
-- Phases (Config.UPGRADE_FX) : ① échafaudage 0,8 s ② poussière + onde 0,4 s ③ l'ancienne maison s'enfonce, la nouvelle monte (squash & stretch) 1,5 s
-- ④ fête (confettis, bannière) 1,8 s ; total 4,5 s. Utilisation : require(Upgrade).new(Config, Easing).
local Upgrade = {}

function Upgrade.new(Config, Easing)
	local U = {}
	local F = Config.UPGRADE_FX

	local function clamp01(x)
		if type(x) ~= "number" or x ~= x then
			return 0
		end
		return math.min(1, math.max(0, x))
	end

	U.seconds = F.seconds
	U.dustAt = F.scaffold -- début de la poussière
	U.swapAt = F.scaffold + F.dust -- début de l'échange des maisons
	U.partyAt = F.scaffold + F.dust + F.swap -- début de la fête

	-- État au temps t : toutes les valeurs sont dans [0, 1] sauf sx / sy (squash & stretch de la nouvelle maison, > 0).
	--   scaffold : hauteur de l'échafaudage ; strip : retrait de l'échafaudage (pendant la fête) ; dust : poussière (0 -> 1 -> 0) ; wave : onde (0 avant, 1 pendant la poussière)
	--   drop : enfoncement de l'ancienne maison ; rise : montée de la nouvelle ; party : progression de la fête ; done : animation terminée
	function U.state(t)
		t = (type(t) == "number" and t == t) and math.max(t, 0) or 0
		local sc = clamp01(t / F.scaffold)
		local swap = clamp01((t - U.swapAt) / F.swap)
		local sx, sy = 1, 1
		if swap > 0 and swap < 1 then
			sx, sy = Easing.squashStretch(swap, 0.35)
		end
		local dustP = clamp01((t - U.dustAt) / F.dust)
		return {
			t = t,
			scaffold = Easing.outQuad(sc),
			strip = clamp01((t - U.partyAt) / 0.5),
			dust = dustP > 0 and dustP < 1 and math.sin(dustP * math.pi) or 0,
			wave = (t >= U.dustAt and t < U.swapAt) and 1 or 0,
			drop = swap * swap, -- l'ancienne maison accélère en s'enfonçant
			rise = Easing.outBack(swap), -- la nouvelle monte avec un léger dépassement
			sx = sx,
			sy = sy,
			party = clamp01((t - U.partyAt) / F.party),
			done = t >= U.seconds,
		}
	end

	-- Texte de la bannière : « 🏠 Niveau 5 : Maison au garage ! +2 emplacements, revenus +20 % ».
	function U.banner(level)
		return Config.upgradeBanner(level)
	end

	-- La caméra large est-elle permise ? Propriétaire seul, sans œuf porté, pas poursuivi (`chased`), vivant, aucune autre cinématique en cours.
	function U.canFrame(isOwner, carrying, chased, dead, busy)
		return isOwner == true and (carrying or 0) <= 0 and not chased and not dead and not busy
	end

	return U
end

return Upgrade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Odds   (lot 10, B.1 et B.2)
-- Compteur de rareté « 1 sur N » : module PUR (aucun service Roblox, aucun require). Les tables viennent de la table `Config` PASSÉE en paramètre :
--   Config.SIZES[i].weight, Config.MUTS[i].weight, Config.PETS[i].tier (espèces par rareté), Config.ODDS.REF[r] (poids de référence, en %).
-- Le compteur est la rareté de RÉFÉRENCE d'une combinaison (espèce, taille, mutation) : identique pour tous les joueurs, quel que soit l'œuf ou les
-- bonus utilisés. Aucune fonction d'ici ne reçoit de bonus (chance, trèfle, passe, potion, événement) : un achat ne peut donc pas gonfler le chiffre.
--   p_ref = REF[r]/100 × 1/n_r × SIZES[s].weight/ΣSIZES × MUTS[m].weight/ΣMUTS      N = 1/p_ref, arrondi
-- API (toutes les fonctions renvoient nil / "" / false sur entrée invalide, jamais d'erreur) :
--   Odds.value(Config, r, s, m [, nr])    -> N arrondi (nombre) ou nil. nr = nombre d'espèces de la rareté r (défaut : Odds.speciesCount)
--   Odds.forPet(Config, petIndex, s, m [, nr]) -> idem à partir de l'indice d'espèce de Config.PETS
--   Odds.speciesCount(Config, r)          -> nombre d'espèces publiées de rareté r (pet.published == false ou pet.hidden == true : exclu)
--   Odds.pRef(Config, r, s, m [, nr])     -> probabilité de référence (0..1) ou nil
--   Odds.round(n)                         -> arrondi : entier, sauf N < 10 (une décimale)
--   Odds.short(n) / Odds.label(n)         -> « 38 494 » / « 1 sur 38 494 » (milliers séparés par une espace insécable, « 12,5 M », « 8 Md »)
--   Odds.isSpecial(n [, Config])          -> n >= 10 000 (Config.ODDS.specialMin), seuil des effets spéciaux
--   Odds.level(n [, Config])              -> 0 (rien) .. 5 (voir Odds.LEVELS)
--   Odds.fx(n, r [, Config])              -> { special, level, banner, secretSound, announceServer, announceWorld, pillar, billboard }
--   Odds.countSteps(n [, steps])          -> liste croissante de paliers 1 .. n pour le compteur animé (12 paliers par défaut, dernier = n exact)
--   Odds.validate(Config)                 -> ok, liste de problèmes (tables de poids, REF)
-- Pour la brancher : `local Odds = require(ReplicatedStorage.Odds)` ; serveur à l'éclosion : `slot.o = Odds.forPet(Config, petIdx, s, m)` (une seule fois,
-- jamais recalculé) ; client : `Odds.label(slot.o)`. Pas de += ni de continue (le lanceur lupa du dépôt ne les gère pas dans ReplicatedStorage).
local Odds = {}

Odds.SEP = "\u{00A0}" -- espace insécable : rendue par toutes les polices Roblox (l'espace fine U+202F n'est pas garantie)
Odds.MAX = 9007199254740992 -- 2^53, borne du classement OrderedDataStore
Odds.DEFAULT_SPECIAL = 10000
Odds.DEFAULT_BILLBOARD = 1000
-- Seuils des niveaux d'effet : 1 = spécial (>= 10 000), 2 = bandeau « Tirage exceptionnel » (>= 100 000), 3 = son secret (>= 1 000 000),
-- 4 = >= 100 000 000, 5 = >= 1 000 000 000.
Odds.LEVELS = { 10000, 100000, 1000000, 100000000, 1000000000 }
Odds.BANNER_MIN = 100000
Odds.SECRET_SOUND_MIN = 1000000
Odds.SERVER_ANNOUNCE_N, Odds.SERVER_ANNOUNCE_R = 10000, 7
Odds.WORLD_ANNOUNCE_N, Odds.WORLD_ANNOUNCE_R = 1000000, 8

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Somme des poids d'une liste { {weight = x}, ... } ; nil si la liste est inutilisable.
local function sumWeights(list)
	if type(list) ~= "table" then
		return nil
	end
	local total, count = 0, 0
	for i = 1, #list do
		local e = list[i]
		local w = type(e) == "table" and e.weight or nil
		if isNum(w) and w >= 0 then
			total = total + w
		end
		count = count + 1
	end
	if count == 0 or total <= 0 then
		return nil
	end
	return total
end

local function weightAt(list, i)
	if type(list) ~= "table" or not isNum(i) or i ~= math.floor(i) or i < 1 or i > #list then
		return nil
	end
	local e = list[i]
	local w = type(e) == "table" and e.weight or nil
	if isNum(w) and w > 0 then
		return w
	end
	return nil
end

function Odds.speciesCount(Config, r)
	if type(Config) ~= "table" or type(Config.PETS) ~= "table" or not isNum(r) then
		return 0
	end
	local n = 0
	for i = 1, #Config.PETS do
		local p = Config.PETS[i]
		if type(p) == "table" and p.tier == r and p.published ~= false and p.hidden ~= true then
			n = n + 1
		end
	end
	return n
end

function Odds.pRef(Config, r, s, m, nr)
	local ok, res = pcall(function()
		if type(Config) ~= "table" or not isNum(r) or r ~= math.floor(r) or r < 1 then
			return nil
		end
		local odds = Config.ODDS
		local ref = type(odds) == "table" and type(odds.REF) == "table" and odds.REF[r] or nil
		if not isNum(ref) or ref <= 0 then
			return nil
		end
		local count = nr
		if count == nil then
			count = Odds.speciesCount(Config, r)
		end
		if not isNum(count) or count < 1 then
			return nil
		end
		local sw, mw = weightAt(Config.SIZES, s), weightAt(Config.MUTS, m)
		local sTotal, mTotal = sumWeights(Config.SIZES), sumWeights(Config.MUTS)
		if sw == nil or mw == nil or sTotal == nil or mTotal == nil then
			return nil
		end
		local p = (ref / 100) * (1 / count) * (sw / sTotal) * (mw / mTotal)
		if isNum(p) and p > 0 then
			return p
		end
		return nil
	end)
	if ok then
		return res
	end
	return nil
end

-- Arrondi du compteur : entier, sauf N < 10 (une décimale) ; jamais < 1, jamais > 2^53.
function Odds.round(n)
	if not isNum(n) then
		return nil
	end
	if n < 1 then
		return 1
	end
	if n > Odds.MAX then
		return Odds.MAX
	end
	if n < 9.95 then
		return math.floor(n * 10 + 0.5) / 10
	end
	return math.floor(n + 0.5)
end

function Odds.value(Config, r, s, m, nr)
	local p = Odds.pRef(Config, r, s, m, nr)
	if p == nil then
		return nil
	end
	return Odds.round(1 / p)
end

function Odds.forPet(Config, petIndex, s, m, nr)
	if type(Config) ~= "table" or type(Config.PETS) ~= "table" or not isNum(petIndex) then
		return nil
	end
	local pet = Config.PETS[petIndex]
	if type(pet) ~= "table" then
		return nil
	end
	return Odds.value(Config, pet.tier, s, m, nr)
end

-- Groupe les milliers d'une chaîne de chiffres.
local function group(digits)
	local out, n = "", #digits
	for i = 1, n do
		out = out .. digits:sub(i, i)
		local left = n - i
		if left > 0 and left % 3 == 0 then
			out = out .. Odds.SEP
		end
	end
	return out
end

-- 12.5 -> « 12,5 » ; 8 -> « 8 » (une décimale seulement si elle n'est pas nulle).
local function oneDecimal(v)
	local t = math.floor(v * 10 + 0.5) / 10
	if t == math.floor(t) then
		return group(string.format("%.0f", t))
	end
	return (string.format("%.1f", t):gsub("%.", ","))
end

function Odds.short(n)
	if not isNum(n) or n <= 0 then
		return ""
	end
	n = Odds.round(n)
	if n < 10 then
		return (string.format("%.1f", n):gsub("%.", ","))
	end
	if n < 10000000 then
		return group(string.format("%.0f", n))
	end
	if n < 1000000000 then
		local v = n / 1000000
		if math.floor(v * 10 + 0.5) / 10 < 1000 then
			return oneDecimal(v) .. Odds.SEP .. "M"
		end
	end
	local v = n / 1000000000
	if v < 100 then
		return oneDecimal(v) .. Odds.SEP .. "Md"
	end
	return group(string.format("%.0f", math.floor(v + 0.5))) .. Odds.SEP .. "Md"
end

function Odds.label(n)
	local s = Odds.short(n)
	if s == "" then
		return ""
	end
	return "1 sur " .. s
end

function Odds.isSpecial(n, Config)
	if not isNum(n) then
		return false
	end
	local min = Odds.DEFAULT_SPECIAL
	if type(Config) == "table" and type(Config.ODDS) == "table" and isNum(Config.ODDS.specialMin) and Config.ODDS.specialMin > 0 then
		min = Config.ODDS.specialMin
	end
	return n >= min
end

function Odds.level(n, Config)
	if not isNum(n) then
		return 0
	end
	if not Odds.isSpecial(n, Config) then
		return 0
	end
	local lvl = 1
	for i = 2, #Odds.LEVELS do
		if n >= Odds.LEVELS[i] then
			lvl = i
		end
	end
	return lvl
end

-- Effets et annonces liés à un tirage (B.1 et B.2). r = rareté de l'espèce (peut être nil).
function Odds.fx(n, r, Config)
	local num = isNum(n) and n or 0
	local rr = isNum(r) and r or 0
	local billboardMin = Odds.DEFAULT_BILLBOARD
	if type(Config) == "table" and type(Config.ODDS) == "table" and isNum(Config.ODDS.billboardMin) and Config.ODDS.billboardMin > 0 then
		billboardMin = Config.ODDS.billboardMin
	end
	return {
		special = Odds.isSpecial(num, Config),
		level = Odds.level(num, Config),
		banner = num >= Odds.BANNER_MIN,
		secretSound = num >= Odds.SECRET_SOUND_MIN,
		announceServer = num >= Odds.SERVER_ANNOUNCE_N or rr >= Odds.SERVER_ANNOUNCE_R,
		announceWorld = num >= Odds.WORLD_ANNOUNCE_N or rr >= Odds.WORLD_ANNOUNCE_R,
		pillar = rr >= 10,
		billboard = num >= billboardMin,
	}
end

-- Paliers du compteur animé : de 1 à N, ralentissement final (ease out cubique), croissants, le dernier est N exact.
function Odds.countSteps(n, steps)
	local count = 12
	if isNum(steps) then
		count = math.max(1, math.min(60, math.floor(steps)))
	end
	local target = Odds.round(isNum(n) and n or 1) or 1
	local out = {}
	local prev = 1
	for i = 1, count do
		local t = i / count
		local v = 1 + (target - 1) * (1 - (1 - t) ^ 3)
		if target >= 10 then
			v = math.floor(v + 0.5)
		else
			v = math.floor(v * 10 + 0.5) / 10
		end
		if v < prev then
			v = prev
		end
		if i == count then
			v = target
		end
		out[i] = v
		prev = v
	end
	return out
end

-- Vérifie les tables lues dans Config : sommes de poids, REF, espèces par rareté.
function Odds.validate(Config)
	local problems = {}
	if type(Config) ~= "table" then
		return false, { "Config absente" }
	end
	local sTotal, mTotal = sumWeights(Config.SIZES), sumWeights(Config.MUTS)
	if sTotal == nil then
		problems[#problems + 1] = "Config.SIZES inutilisable"
	elseif math.abs(sTotal - 100) > 1e-6 then
		problems[#problems + 1] = "somme des tailles = " .. tostring(sTotal) .. " (attendu 100)"
	end
	if mTotal == nil then
		problems[#problems + 1] = "Config.MUTS inutilisable"
	elseif math.abs(mTotal - 100) > 1e-6 then
		problems[#problems + 1] = "somme des mutations = " .. tostring(mTotal) .. " (attendu 100)"
	end
	local odds = Config.ODDS
	if type(odds) ~= "table" or type(odds.REF) ~= "table" then
		problems[#problems + 1] = "Config.ODDS.REF absente"
	else
		for r = 1, #odds.REF do
			if not isNum(odds.REF[r]) or odds.REF[r] <= 0 then
				problems[#problems + 1] = "REF[" .. r .. "] invalide"
			end
			if Odds.speciesCount(Config, r) < 1 then
				problems[#problems + 1] = "aucune espèce publiée de rareté " .. r
			end
		end
	end
	return #problems == 0, problems
end

return Odds
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">HatchPlan</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/HatchPlan   (lot 10, B.3)
-- PLAN PUR des 10 animations d'éclosion (une par rareté) : aucune dépendance, aucun service Roblox, déterministe (mêmes entrées -> même plan), jamais d'erreur.
-- Remplace `CinematicKit.hatchPlan` pour le nouvel écran d'éclosion (HatchFx exécute le plan). Le plan est une liste de « prises » (beats) :
--   { t = début (s), d = durée (s), kind = "...", n = nombre d'objets d'effet créés (0 si aucun), color = "main"|"second"|"white"|"black"|"gold"|"red"|"rainbow", ... }
-- Types de prises : shake (l'œuf tremble), pop (l'œuf disparaît), burst (n éclats), rays (n rayons), ring (anneaux, mode "converge"|"expand"|"ground"|"rise"),
-- flash (plein écran), shakeScreen, text (glyphe ou libellé : couronne, « ??? »), banner (bandeau de rareté), zoom (champ de vision), tint (teinte / désaturation
-- de l'image 3D), black (écran noir), slot (mini machine à sous rareté/taille/mutation), crystals, frost, cracks, chains, runes, smoke, stars, wings, pillar, split.
-- Plan complet : { r, duration, skipAfter, noSkip, camera, reduced, sound = {key, fanfare}, revealAt, beats, counter = {t, d, steps, from, to} | nil, special, exceptional,
--   secretSound, objects (somme des n, <= 30), particles (objets hors bandeau/texte/ailes/pilier ; <= 50 % en version réduite), peakRate (objets/s au pic, <= 40), seed }.
-- DÉCISIONS : durée de r10 ramenée de 9,0 s (spec B.3) à 8,0 s (plafond demandé) ; chaque n est ensuite ajusté pour tenir 30 objets et 40 objets/s ;
-- la version réduite (mobile) divise chaque n de particule par deux (arrondi bas) donc <= 50 % ; bandeau, texte, ailes et pilier restent ; zoom retiré si la caméra ne doit pas bouger (œuf porté, poursuite).
-- Brancher : `local plan = HatchPlan.plan(slot.r, slot.o, { reduced = isMobile, firstTime = firstTimeForThisRarity, still = carryingEgg })` puis HatchFx.play(gui, plan, opts).
-- Pas de += ni de continue (lanceur lupa).
local HatchPlan = {}

HatchPlan.MAX_DURATION = 8
HatchPlan.MAX_OBJECTS = 30
HatchPlan.MAX_RATE = 40
HatchPlan.SKIP_AFTER = 1.5
HatchPlan.COUNTER_SECONDS = 0.8
HatchPlan.COUNTER_STEPS = 12
-- Durées par rareté (B.3 ; r10 plafonnée à 8 s).
HatchPlan.DURATIONS = { 1.2, 1.5, 2.0, 2.8, 4.0, 5.0, 6.0, 7.0, 6.5, 8.0 }
local EXCEPTIONAL_MIN = 100000
local SECRET_SOUND_MIN = 1000000
local SPECIAL_MIN = 10000

-- Prises qui ne sont pas des particules : toujours conservées telles quelles en version réduite (bandeau, texte, anneau unique, ailes, pilier, éclat plein écran).
local FIXED_KINDS = { banner = true, text = true, wings = true, pillar = true }

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Clé de son (reprend Config.hatchSoundKey du lot 9 : r1-2 hatch, r3 rare, r4 epic, r5-6 legendary, r7-10 hatchSecret ; fanfare dès r8).
function HatchPlan.soundKey(r)
	local rr = isNum(r) and math.floor(r) or 1
	local key = "hatch"
	if rr >= 7 then
		key = "hatchSecret"
	elseif rr >= 5 then
		key = "legendary"
	elseif rr == 4 then
		key = "epic"
	elseif rr == 3 then
		key = "rare"
	end
	return { key = key, fanfare = rr >= 8, divine = rr >= 10 }
end

local function beat(t, d, kind, n, extra)
	local b = { t = t, d = d, kind = kind, n = n or 0 }
	if extra then
		for k, v in pairs(extra) do
			b[k] = v
		end
	end
	return b
end

-- Nombre de runes du cercle runique pour r >= 5 (B.3) : min(12, 4 + (r-4) x 2).
function HatchPlan.runes(r)
	return math.min(12, 4 + (r - 4) * 2)
end

-- Séquences de base (version complète, avant ajustement des plafonds). rv = instant de la révélation.
local function build(r)
	local B = {}
	local rv
	if r == 1 then
		rv = 0.5
		B = {
			beat(0, 0.4, "shake", 0, { amp = 3 }),
			beat(0.4, 0.1, "pop", 0),
			beat(0.4, 0.15, "flash", 0, { color = "white", a = 0.7 }),
			beat(0.4, 0.5, "rays", 6, { color = "white", len = 120 }),
		}
	elseif r == 2 then
		rv = 0.55
		B = {
			beat(0, 0.5, "shake", 0, { amp = 4 }),
			beat(0.5, 0.1, "pop", 0),
			beat(0.5, 0.7, "burst", 12, { color = "main", glyph = "cube", dist = 150, arc = "crown" }),
			beat(0.7, 0.7, "burst", 6, { color = "second", glyph = "petal", dist = 110, arc = "fall" }),
		}
	elseif r == 3 then
		rv = 1.05
		B = {
			beat(0, 1.0, "ring", 1, { color = "main", mode = "converge", ease = "in" }),
			beat(0.2, 0.8, "shake", 0, { amp = 5, grow = true }),
			beat(1.0, 0.15, "flash", 0, { color = "main", a = 0.6 }),
			beat(1.0, 0.1, "pop", 0),
			beat(1.0, 0.8, "ring", 2, { color = "main", mode = "ground" }),
		}
	elseif r == 4 then
		rv = 2.1
		B = {
			beat(0, 0.8, "crystals", 6, { color = "main", from = "ground" }),
			beat(0.8, 0.25, "shakeScreen", 0, { amp = 6 }),
			beat(0.9, 1.2, "slot", 4, { color = "main" }),
			beat(2.0, 0.1, "pop", 0),
			beat(2.1, 0.7, "banner", 1, { color = "main" }),
		}
	elseif r == 5 then
		rv = 2.1
		B = {
			beat(0, 1.4, "text", 1, { glyph = "crown", color = "gold", fall = true }),
			beat(0.6, 1.4, "shake", 0, { amp = 6, grow = true }),
			beat(0.8, 1.2, "runes", HatchPlan.runes(5), { color = "gold" }),
			beat(1.4, 2.4, "zoom", 0, { k = 1.15 }),
			beat(2.0, 0.2, "flash", 0, { color = "gold", a = 0.8 }),
			beat(2.0, 0.1, "pop", 0),
			beat(2.0, 0.5, "split", 2, { color = "gold" }),
			beat(2.0, 1.0, "rays", 12, { color = "gold", len = 220 }),
			beat(2.2, 1.8, "banner", 1, { color = "gold" }),
		}
	elseif r == 6 then
		rv = 2.6
		B = {
			beat(0.3, 2.1, "chains", 6, { color = "second", breakAt = 2.1 }),
			beat(0.4, 1.6, "cracks", 4, { color = "red" }),
			beat(0.5, 1.8, "shake", 0, { amp = 8, grow = true }),
			beat(2.0, 0.6, "tint", 0, { color = "red", a = 0.5 }),
			beat(2.4, 0.6, "shakeScreen", 0, { amp = 10 }),
			beat(2.4, 0.1, "pop", 0),
			beat(2.4, 1.0, "runes", HatchPlan.runes(6), { color = "red" }),
			beat(2.7, 2.0, "banner", 1, { color = "red" }),
		}
	elseif r == 7 then
		rv = 3.2
		B = {
			beat(0, 1.5, "crystals", 6, { color = "main", from = "around" }),
			beat(0.8, 1.6, "frost", 3, { color = "white" }),
			beat(1.5, 1.4, "shake", 0, { amp = 7, grow = true }),
			beat(3.0, 0.15, "flash", 0, { color = "main", a = 0.8 }),
			beat(3.0, 0.1, "pop", 0),
			beat(3.0, 0.8, "burst", 8, { color = "main", glyph = "shard", dist = 190, arc = "ball" }),
			beat(3.0, 1.5, "runes", HatchPlan.runes(7), { color = "main" }),
			beat(3.3, 2.4, "banner", 1, { color = "main" }),
		}
	elseif r == 8 then
		rv = 2.9
		B = {
			beat(0, 2.5, "black", 0, { a = 1, fadeOut = true }),
			beat(0.5, 2.0, "text", 1, { glyph = "???", color = "white" }),
			beat(2.5, 0.9, "ring", 1, { color = "rainbow", mode = "expand" }),
			beat(2.8, 0.9, "ring", 1, { color = "rainbow", mode = "expand" }),
			beat(2.5, 1.0, "stars", 8, { color = "rainbow" }),
			beat(2.5, 0.15, "flash", 0, { color = "white", a = 0.9 }),
			beat(2.5, 0.1, "pop", 0),
			beat(2.6, 1.2, "runes", HatchPlan.runes(8), { color = "rainbow" }),
			beat(3.0, 3.2, "banner", 1, { color = "rainbow" }),
		}
	elseif r == 9 then
		rv = 2.8
		B = {
			beat(0, 0.8, "tint", 0, { sat = -1, hold = true, a = 0 }),
			beat(0.5, 2.0, "text", 1, { glyph = "crown", color = "black" }),
			beat(2.5, 0.8, "burst", 6, { color = "black", glyph = "shard", dist = 160, arc = "ball" }),
			beat(2.5, 2.0, "smoke", 5, { color = "second" }),
			beat(2.5, 0.4, "shakeScreen", 0, { amp = 8 }),
			beat(2.5, 0.1, "pop", 0),
			beat(2.6, 1.2, "runes", HatchPlan.runes(9), { color = "white" }),
			beat(2.9, 2.2, "banner", 1, { color = "white" }),
		}
	else
		rv = 3.3
		B = {
			beat(0, 1.8, "wings", 2, { color = "main" }),
			beat(1.0, 1.5, "ring", 1, { color = "gold", mode = "rise" }),
			beat(1.4, 6.0, "pillar", 1, { color = "main" }),
			beat(2.4, 3.0, "zoom", 0, { k = 1.1 }),
			beat(3.0, 0.2, "flash", 0, { color = "white", a = 0.9 }),
			beat(3.0, 0.1, "pop", 0),
			beat(3.0, 2.0, "rays", 16, { color = "main", len = 260 }),
			beat(3.0, 2.0, "runes", HatchPlan.runes(10), { color = "gold" }),
			beat(3.4, 4.0, "banner", 1, { color = "main" }),
		}
	end
	return B, rv
end

-- Somme des objets et pic de débit (objets/s, estimé sur une grille de 0,05 s) d'une liste de prises.
local function measure(beats, duration)
	local total = 0
	for i = 1, #beats do
		total = total + beats[i].n
	end
	local peak = 0
	local t = 0
	while t <= duration do
		local rate = 0
		for i = 1, #beats do
			local b = beats[i]
			if b.n > 0 and t >= b.t and t < b.t + math.max(b.d, 0.4) then
				rate = rate + b.n / math.max(b.d, 0.4)
			end
		end
		if rate > peak then
			peak = rate
		end
		t = t + 0.05
	end
	return total, peak
end

-- Réduit les plus gros n (un cran à la fois, ordre stable) jusqu'à respecter les plafonds d'objets et de débit. Les prises à 1 objet ne sont jamais supprimées.
local function fit(beats, duration, maxObjects)
	local guard = 0
	while guard < 400 do
		guard = guard + 1
		local total, peak = measure(beats, duration)
		if total <= maxObjects and peak <= HatchPlan.MAX_RATE then
			return
		end
		local bestI, bestN = nil, 1
		for i = 1, #beats do
			if beats[i].n > bestN and not FIXED_KINDS[beats[i].kind] then
				bestI, bestN = i, beats[i].n
			end
		end
		if bestI == nil then
			return
		end
		beats[bestI].n = beats[bestI].n - math.max(1, math.floor(bestN * 0.15))
	end
end

-- Plan d'éclosion. r : rareté (1..10, borné), N : compteur « 1 sur N » (nombre, sinon ignoré).
-- opts : reduced (version mobile), firstTime (première fois qu'une rareté >= 8 est obtenue : non passable), still (la caméra ne bouge pas).
function HatchPlan.plan(r, N, opts)
	local o = type(opts) == "table" and opts or {}
	local rr = 1
	if isNum(r) then
		rr = math.max(1, math.min(10, math.floor(r)))
	end
	local duration = HatchPlan.DURATIONS[rr]
	local beats, revealAt = build(rr)
	if o.still == true then
		local kept = {}
		for i = 1, #beats do
			if beats[i].kind ~= "zoom" then
				kept[#kept + 1] = beats[i]
			end
		end
		beats = kept
	end
	local num = nil
	if isNum(N) and N >= 1 then
		num = math.min(N, 9007199254740992)
	end
	local exceptional = num ~= nil and num >= EXCEPTIONAL_MIN
	if exceptional then
		beats[#beats + 1] = beat(revealAt + 0.2, math.min(1.6, duration - revealAt - 0.2), "text", 1, { glyph = "exceptional", color = "gold", y = "low" })
	end
	-- plafonds d'objets et de débit sur la version complète, puis réduction mobile (moitié, arrondi bas)
	fit(beats, duration, HatchPlan.MAX_OBJECTS)
	local reduced = o.reduced == true
	if reduced then
		for i = 1, #beats do
			if not FIXED_KINDS[beats[i].kind] then
				beats[i].n = math.floor(beats[i].n / 2)
			end
		end
	end
	table.sort(beats, function(a, b)
		if a.t ~= b.t then
			return a.t < b.t
		end
		return a.kind < b.kind
	end)
	local objects, peak = measure(beats, duration)
	local particles = 0
	for i = 1, #beats do
		if not FIXED_KINDS[beats[i].kind] then
			particles = particles + beats[i].n
		end
	end
	local counter = nil
	if num ~= nil then
		local cd = math.min(HatchPlan.COUNTER_SECONDS, duration - revealAt)
		counter = { t = revealAt, d = math.max(0.25, cd), steps = HatchPlan.COUNTER_STEPS, from = 1, to = num }
	end
	return {
		r = rr,
		duration = duration,
		skipAfter = HatchPlan.SKIP_AFTER,
		noSkip = o.firstTime == true and rr >= 8,
		camera = o.still ~= true,
		reduced = reduced,
		sound = HatchPlan.soundKey(rr),
		revealAt = revealAt,
		beats = beats,
		counter = counter,
		special = num ~= nil and num >= SPECIAL_MIN,
		exceptional = exceptional,
		secretSound = num ~= nil and num >= SECRET_SOUND_MIN,
		objects = objects,
		particles = particles,
		peakRate = peak,
		seed = (rr * 7919 + (num and math.floor(num) % 100003 or 0)) % 2147483647,
	}
end

-- Contrôle de cohérence d'un plan (utilisé par les tests et par HatchFx avant exécution) : retourne ok, raison.
function HatchPlan.check(plan)
	if type(plan) ~= "table" or type(plan.beats) ~= "table" or not isNum(plan.duration) then
		return false, "plan invalide"
	end
	if plan.duration <= 0 or plan.duration > HatchPlan.MAX_DURATION then
		return false, "durée hors bornes"
	end
	for i = 1, #plan.beats do
		local b = plan.beats[i]
		if type(b) ~= "table" or type(b.kind) ~= "string" or not isNum(b.t) or not isNum(b.d) or not isNum(b.n) then
			return false, "prise " .. i .. " invalide"
		end
		if b.t < 0 or b.d < 0 or b.t + b.d > plan.duration + 1e-9 or b.n < 0 then
			return false, "prise " .. i .. " hors de la durée"
		end
	end
	return true, ""
end

return HatchPlan
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">IntroPlan</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/IntroPlan   (lot 10, B.4)
-- PLAN PUR de l'intro de combat (aucun service Roblox, aucun require, déterministe, jamais d'erreur) : deux bandeaux (joueur à gauche, adversaire à droite) avec
-- nom, ligue, trophées, ratio « 124 V / 37 D (77 %) » et 3 vignettes de pets (type + compteur de rareté), « VS » qui frappe, flèche d'avantage de type, décompte 3-2-1.
-- DÉCISION : durée totale 3,0 s au maximum (la spec disait 3,5 s ; plafond demandé 3 s) ; passable après 1,0 s ; sans décompte l'intro dure 2,2 s.
-- Entrée : IntroPlan.plan(info, opts)
--   info = { mode = "pvp"|"duel"|"pve"|"npc"|"tower", countdown = bool (décompte 3-2-1 si le temps de tour n'a pas démarré), advantage = nombre (multiplicateur du pet actif du joueur
--            contre le pet actif de l'adversaire, 1,5 / 1,25 / 1 / 0,8 / 0,67),
--            me = { name, userId, wins, losses, league, trophies, pets = { { type = "Feu", odds = 38494, tier = 5 }, ... } },
--            foe = { même forme ; name peut être un PNJ avec wins/losses fictifs } }
--   opts = { fmtOdds = function(n) -> texte (défaut : Odds.label, injecté par l'appelant ; sinon « 1 sur N » simple) }
-- Sortie : { duration, skipAfter, countdown, mode, left = side, right = side, vs = {t, d, ...}, arrow = {...} | nil, count = {{t, text}...}, beats }
--   side = { name, record = "124 V / 37 D (77 %)", wins, losses, percent, league, trophies, userId, pets = { {type, odds, oddsText, tier} (3 au plus) } }
-- Brancher : `BattleIntro.play(gui, IntroPlan.plan(info, { fmtOdds = Odds.label }), { onDone = startBattle })`.
-- Pas de += ni de continue (lanceur lupa).
local IntroPlan = {}

IntroPlan.MAX_DURATION = 3
IntroPlan.SKIP_AFTER = 1
IntroPlan.SLIDE = 0.4
IntroPlan.MAX_PETS = 3
IntroPlan.CAP = 999999999

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function count(v)
	if not isNum(v) or v < 0 then
		return 0
	end
	return math.min(IntroPlan.CAP, math.floor(v))
end

-- Pourcentage de victoires : floor(100 x V / max(1, V + D) + 0,5).
function IntroPlan.percent(wins, losses)
	local w, l = count(wins), count(losses)
	return math.floor(100 * w / math.max(1, w + l) + 0.5)
end

-- « 124 V / 37 D (77 %) »
function IntroPlan.record(wins, losses)
	local w, l = count(wins), count(losses)
	return w .. " V / " .. l .. " D (" .. IntroPlan.percent(w, l) .. " %)"
end

-- Multiplicateur en français : 1,5 -> « 1,5 » ; 1,25 -> « 1,25 » ; 0,67 -> « 0,67 » ; 0,8 -> « 0,8 ».
function IntroPlan.fmtMult(m)
	if not isNum(m) or m <= 0 then
		return "1"
	end
	local s = string.format("%.2f", m)
	s = s:gsub("0+$", ""):gsub("%.$", "")
	return (s:gsub("%.", ","))
end

local function cleanText(v, fallback, maxLen)
	if type(v) ~= "string" or v == "" then
		return fallback
	end
	return v:sub(1, maxLen or 24)
end

local function simpleOdds(n)
	if not isNum(n) or n < 1 then
		return ""
	end
	return "1 sur " .. string.format("%.0f", math.floor(n + 0.5))
end

local function side(raw, fmt)
	local t = type(raw) == "table" and raw or {}
	local w, l = count(t.wins), count(t.losses)
	local pets = {}
	local src = type(t.pets) == "table" and t.pets or {}
	for i = 1, math.min(IntroPlan.MAX_PETS, #src) do
		local p = type(src[i]) == "table" and src[i] or {}
		local odds = isNum(p.odds) and p.odds > 0 and p.odds or nil
		local text = ""
		if odds then
			local ok, res = pcall(fmt, odds)
			text = ok and type(res) == "string" and res or simpleOdds(odds)
		end
		pets[i] = { type = cleanText(p.type, "", 16), odds = odds, oddsText = text, tier = isNum(p.tier) and math.max(1, math.min(10, math.floor(p.tier))) or 1 }
	end
	return {
		name = cleanText(t.name, "???", 20),
		userId = isNum(t.userId) and math.floor(t.userId) or 0,
		wins = w,
		losses = l,
		percent = IntroPlan.percent(w, l),
		record = IntroPlan.record(w, l),
		league = cleanText(t.league, "", 16),
		trophies = count(t.trophies),
		pets = pets,
	}
end

function IntroPlan.plan(info, opts)
	local inf = type(info) == "table" and info or {}
	local fmt = type(opts) == "table" and type(opts.fmtOdds) == "function" and opts.fmtOdds or simpleOdds
	local countdown = inf.countdown == true
	local duration = countdown and 3.0 or 2.2
	local S = IntroPlan.SLIDE
	local mult = isNum(inf.advantage) and inf.advantage or 1
	local arrow = nil
	if mult > 1.0001 or mult < 0.9999 then
		arrow = { t = 1.0, d = 1.0, mult = mult, text = (mult > 1 and "Avantage ×" or "Désavantage ×") .. IntroPlan.fmtMult(mult), good = mult > 1, side = "left" }
	end
	local counts = {}
	local beats = {
		{ t = 0, d = S, kind = "slide", side = "left" },
		{ t = 0, d = S, kind = "slide", side = "right" },
		{ t = S, d = 0.4, kind = "pets" },
		{ t = 0.5, d = 0.3, kind = "vs", from = 2, to = 1, shake = 0.3, volume = 0.5, sound = "fanfare" },
	}
	if arrow then
		beats[#beats + 1] = { t = arrow.t, d = arrow.d, kind = "arrow" }
	end
	if countdown then
		for i = 1, 3 do
			local t = 1.6 + (i - 1) * 0.4
			counts[i] = { t = t, text = tostring(4 - i) }
			beats[#beats + 1] = { t = t, d = 0.4, kind = "count", text = tostring(4 - i) }
		end
	end
	beats[#beats + 1] = { t = duration - 0.2, d = 0.2, kind = "exit" }
	return {
		duration = duration,
		skipAfter = IntroPlan.SKIP_AFTER,
		countdown = countdown,
		mode = type(inf.mode) == "string" and inf.mode:sub(1, 12) or "pve",
		left = side(inf.me, fmt),
		right = side(inf.foe, fmt),
		vs = beats[4],
		arrow = arrow,
		count = counts,
		beats = beats,
	}
end

-- Contrôle de cohérence (tests, BattleIntro).
function IntroPlan.check(plan)
	if type(plan) ~= "table" or type(plan.beats) ~= "table" or not isNum(plan.duration) then
		return false, "plan invalide"
	end
	if plan.duration <= 0 or plan.duration > IntroPlan.MAX_DURATION then
		return false, "durée hors bornes"
	end
	for i = 1, #plan.beats do
		local b = plan.beats[i]
		if type(b) ~= "table" or not isNum(b.t) or not isNum(b.d) or b.t < 0 or b.d < 0 or b.t + b.d > plan.duration + 1e-9 then
			return false, "prise " .. i .. " hors de la durée"
		end
	end
	return true, ""
end

return IntroPlan
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">TypeFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/TypeFx   (lot 10, B.6)
-- DONNÉES PURES des effets d'attaque par type (9 types de la matrice D.2) : couleur, attaque de base (0,5 s) et spécial (1,2 s). Aucune dépendance.
-- Sera exposé plus tard comme `Config.TYPE_FX = TypeFx.DATA` ; le client StarterPlayerScripts/TypeFx.lua lit ces données (passées en paramètre, pas de require).
-- Forme : DATA[type] = { hex = "FF6A1A", rgb = {r, g, b}, basic = Effet, special = Effet }
--   Effet = { d = durée (s), shake = secousse de l'écran (s) | nil, linger = durée de persistance au sol (s) | nil, layers = { Couche, ... } }
--   Couche = { prim = "shoot"|"burst"|"bolt"|"column"|"ring"|"cone"|"flash"|"runes"|"decal"|"spiral"|"chainring"|"beam", n = nombre d'objets créés (>= 1),
--              t = début (s), d = durée (s), glyph = texte | nil, size = taille px | nil, color = "main"|"white"|"dark" | nil, ... }
-- Coût d'un effet = 1 (conteneur) + somme des n (TypeFx.cost) ; plafonds : base <= 14, spécial <= 30 (vérifiés par les tests).
-- Noms de types : ceux de D.2 (Feu, Eau, Plante, Glace, Foudre, Terre, Ciel, Ombre, Lumière) ; l'ancien nom « Nature » est un alias de « Plante » (TypeFx.get).
-- Pas de += ni de continue (lanceur lupa).
local TypeFx = {}

TypeFx.TYPES = { "Feu", "Eau", "Plante", "Glace", "Foudre", "Terre", "Ciel", "Ombre", "Lumière" }
TypeFx.ALIASES = { Nature = "Plante" }
TypeFx.BASIC_MAX, TypeFx.SPECIAL_MAX = 14, 30
TypeFx.BASIC_SECONDS, TypeFx.SPECIAL_SECONDS = 0.5, 1.2

local function rgb(hex)
	return { tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16) }
end

local function L(prim, n, t, d, extra)
	local l = { prim = prim, n = n, t = t, d = d }
	if extra then
		for k, v in pairs(extra) do
			l[k] = v
		end
	end
	return l
end

local function def(hex, basic, special)
	return { hex = hex, rgb = rgb(hex), basic = basic, special = special }
end

TypeFx.DATA = {
	Feu = def("FF6A1A",
		{ d = 0.5, layers = { L("shoot", 1, 0, 0.35, { glyph = "●", size = 28 }), L("burst", 5, 0.3, 0.2, { glyph = "✦", dist = 40 }) } },
		{ d = 1.2, shake = 0.4, linger = 2, layers = { L("runes", 6, 0, 1.2), L("cone", 10, 0.1, 0.8, { glyph = "●", size = 26 }), L("decal", 1, 0.6, 0.6, { color = "dark" }), L("burst", 6, 0.6, 0.5, { glyph = "✦", dist = 70 }) } }),
	Eau = def("3C96DC",
		{ d = 0.5, layers = { L("shoot", 4, 0, 0.35, { glyph = "💧", size = 20 }), L("burst", 4, 0.3, 0.2, { glyph = "•", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("ring", 3, 0.2, 0.9), L("burst", 8, 0.5, 0.6, { glyph = "💧", dist = 80 }) } }),
	Plante = def("5CB256",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.4, { glyph = "🍃", size = 24, spin = true }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("column", 6, 0.2, 0.7, { glyph = "vine", size = 18 }), L("burst", 4, 0.8, 0.3, { glyph = "🍃", dist = 50 }) } }),
	Glace = def("BFEFFF",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.35, { glyph = "❄", size = 24, spin = true }), L("burst", 4, 0.3, 0.2, { glyph = "✧", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, linger = 2, layers = { L("runes", 6, 0, 1.2), L("column", 6, 0.2, 0.6, { glyph = "spike", size = 20 }), L("decal", 1, 0.6, 0.5, { color = "white" }), L("burst", 6, 0.7, 0.4, { glyph = "❄", dist = 70 }) } }),
	Foudre = def("FFE14A",
		{ d = 0.5, layers = { L("bolt", 6, 0, 0.3), L("flash", 1, 0.3, 0.1, { alpha = 0.3 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("bolt", 6, 0.2, 0.4), L("bolt", 6, 0.55, 0.4), L("flash", 1, 0.9, 0.1, { alpha = 0.6 }) } }),
	Terre = def("9C6B45",
		{ d = 0.5, layers = { L("column", 4, 0, 0.4, { glyph = "rock", size = 26 }), L("burst", 4, 0.3, 0.2, { glyph = "•", dist = 34 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("ring", 2, 0.2, 0.9), L("bolt", 4, 0.3, 0.5, { color = "dark" }), L("burst", 8, 0.5, 0.6, { glyph = "•", dist = 80 }) } }),
	Ciel = def("DDEBFF",
		{ d = 0.5, layers = { L("shoot", 5, 0, 0.4, { glyph = "✧", size = 22, spin = true }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("spiral", 10, 0.2, 1.0, { glyph = "☁", size = 24 }), L("burst", 4, 0.9, 0.3, { glyph = "✧", dist = 60 }) } }),
	Ombre = def("8A3CFF",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.4, { glyph = "●", size = 24 }), L("burst", 4, 0.3, 0.2, { glyph = "☁", dist = 40 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("chainring", 6, 0.2, 0.9), L("burst", 6, 0.7, 0.5, { glyph = "☁", dist = 70 }) } }),
	["Lumière"] = def("FFE680",
		{ d = 0.5, layers = { L("beam", 1, 0, 0.4), L("burst", 3, 0.3, 0.2, { glyph = "✦", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 8, 0, 1.2), L("column", 1, 0.2, 0.9, { glyph = "pillar", size = 70 }), L("flash", 1, 0.3, 0.15, { alpha = 0.5 }), L("burst", 6, 0.6, 0.5, { glyph = "✦", dist = 70 }) } }),
}

-- Nom canonique d'un type (alias « Nature » -> « Plante »), ou nil.
function TypeFx.canonical(name)
	if type(name) ~= "string" then
		return nil
	end
	local n = TypeFx.ALIASES[name] or name
	if TypeFx.DATA[n] then
		return n
	end
	return nil
end

function TypeFx.get(name)
	local n = TypeFx.canonical(name)
	return n and TypeFx.DATA[n] or nil
end

-- Coût (objets créés, conteneur compris) d'un effet ; reduced : moitié des objets de chaque couche (arrondi bas, au moins 1).
function TypeFx.cost(name, special, reduced)
	local def = TypeFx.get(name)
	if def == nil then
		return 0
	end
	local fx = special and def.special or def.basic
	local total = 1
	for i = 1, #fx.layers do
		local n = fx.layers[i].n
		if reduced then
			n = math.max(1, math.floor(n / 2))
		end
		total = total + n
	end
	return total
end

-- Texte d'efficacité flottant (B.6) pour un multiplicateur de type : texte, couleur RGB ; nil si neutre (x1) ou invalide.
TypeFx.EFFICACY = {
	{ min = 1.5, text = "Super efficace !", rgb = { 70, 220, 90 } },
	{ min = 1.2, text = "Efficace", rgb = { 150, 230, 120 } },
	{ max = 0.7, text = "Pas très efficace…", rgb = { 230, 70, 70 } },
	{ max = 0.95, text = "Peu efficace", rgb = { 255, 160, 50 } },
}

function TypeFx.efficacy(mult)
	if type(mult) ~= "number" or mult ~= mult or mult <= 0 then
		return nil
	end
	for i = 1, #TypeFx.EFFICACY do
		local e = TypeFx.EFFICACY[i]
		if (e.min ~= nil and mult >= e.min - 1e-9) or (e.max ~= nil and mult <= e.max + 1e-9) then
			return e.text, e.rgb
		end
	end
	return nil
end

return TypeFx
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX39"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX31"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Script : ServerScriptService/Main
-- Logique serveur complète de Chipe-Œufs (le serveur décide de tout, le client ne fait qu'afficher).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local MessagingService = game:GetService("MessagingService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
if Config.Game.roleFor(game.PlaceId) == "hub" then
	return -- le hub a son propre script (Hub.server) ; ce code est celui de la partie
end
local TeleportService = game:GetService("TeleportService")
local Party = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Party"))
local Reveal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Reveal"))
local Guard = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Guard"))
local Castle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Castle"))
local Belt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Belt"))
local Traps = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Traps")) -- pièges des territoires (lot 4)
local Riddle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Riddle")) -- énigme de la Mère Poule : règles pures (lot 6)
local Raven = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Raven")) -- vol à distance « Corbeau chipeur » : règles pures (lot 7)
local Data = require(script.Parent:WaitForChild("Data"))
local Builder = require(script.Parent:WaitForChild("Builder"))
local HenQuest = require(script.Parent:WaitForChild("HenQuest")) -- énigme de la Mère Poule : état, prompts, récompense (lot 6)
local Rules = require(script.Parent:WaitForChild("Rules")).new(Config) -- règles pures (tirages, revenus), testées avec Lune
local tele = (function() -- lot 9 : 12 métriques AnalyticsService (pcall, 1 événement / s / joueur) ; une seule variable locale (limite de 200)
	local svc = nil
	pcall(function()
		svc = game:GetService("AnalyticsService")
	end)
	return require(script.Parent:WaitForChild("Telemetry")).new(svc)
end)()

Players.CharacterAutoLoads = false

---------------------------------------------------------------- Remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = ReplicatedStorage
local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = Remotes
	return r
end
local RState, RNotify, RHatch, RAction = newRemote("State"), newRemote("Notify"), newRemote("Hatch"), newRemote("Action")
local RTop = newRemote("Top")
local RBattle = newRemote("Battle") -- serveur -> client : début, tours (événements à rejouer) et fin des combats de l'Arène des pets
local RRaven = newRemote("Raven") -- Corbeau chipeur (lot 7) : serveur -> client seulement (alerte de la victime, liste des cibles) ; les demandes passent par Action
local RHen = newRemote("Hen") -- serveur -> client : répliques de la Mère Poule (identifiant + paramètres), berceuse à jouer, retour des touches, plume ramassée

---------------------------------------------------------------- Monde
local onAssetsLoaded = nil -- défini après applyBase et refreshAllPads (voir plus bas), appelé par la tâche de chargement des modèles
-- Apparence des œufs : modèles Roblox chargés en arrière-plan (jamais bloquant ; échec = apparence par défaut, voir Config.Assets).
task.spawn(function()
	local InsertService = game:GetService("InsertService")
	local assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets")).new(Config, {
		loadAsset = function(id)
			return InsertService:LoadAsset(id)
		end,
		spawn = task.spawn,
		wait = task.wait,
		clock = os.clock,
		warn = warn,
		store = function(key, model)
			model.Name = "EggAsset_" .. key
			model.Parent = game:GetService("ServerStorage")
		end,
	})
	Builder.setAssets(assets)
	-- Ordre de chargement : d'abord ce qui se voit dans les premières secondes (œufs, base du joueur, chemins, arbres, accessoires, village), par lots parallèles
	assets.loadAll()
	assets.loadGroup("base")
	assets.loadGroup("house") -- maisons évolutives (niveaux 2 à 7) : avant tous les groupes non essentiels, onAssetsLoaded les applique
	assets.loadGroup("paths")
	assets.loadGroup("trees")
	assets.loadProps()
	assets.loadGroup("scenery")
	assets.loadGroup("eggguard") -- protections d'œuf (dôme, cage, cristaux, nid) posées à chaque rafraîchissement de pad
	assets.loadPets()
	if onAssetsLoaded then
		pcall(onAssetsLoaded) -- base et pads déjà affichés : reconstruits avec les modèles arrivés
	end
	local propParts, propCount = Builder.dressWorld(assets)
	print("[Assets] accessoires Blender : " .. propCount .. " posés (" .. propParts .. " Parts)")
	assets.loadGroup("guards")
	print("[Assets] gardiens Blender : " .. Builder.dressGuards(assets) .. " remplacé(s)")
	assets.loadGroup("traps")
	assets.loadGroup("guards", { knight = true })
	print("[Assets] pièges Blender : " .. Builder.dressTraps(assets) .. " habillé(s)")
	print("[Assets] chevaliers Blender : " .. Builder.dressKnights(assets) .. " habillé(s)")
	assets.loadGroup("castle")
	assets.loadGroup("props") -- coffre, torche, drapeau, château en fond, moulin, enclos, lampadaire, banc, panneau
	assets.loadGroup("ground")
	print("[Assets] arène Blender : " .. Builder.dressArena(assets) .. " modèle(s) posé(s)")
	assets.loadTextures()
	print("[Assets] textures : " .. Builder.dressTextures(assets) .. " posée(s)")
	assets.loadGroup("deco")
	assets.loadGroup("terrain")
	local pt, pu = Builder.dressPaths(assets)
	print("[Assets] chemins sinueux : " .. pt .. " tuile(s), " .. pu .. " Parts (budget " .. Config.Assets.pathBudgetParts .. ")")
	local sn, su = Builder.dressScenery(assets)
	print("[Assets] décor de village : " .. sn .. " objet(s), " .. su .. " Parts (budget " .. Config.Assets.sceneryBudgetParts .. ")")
	local dp, du, df = Builder.dressDeco(assets)
	print("[Assets] décor fin : " .. dp .. " objet(s), " .. du .. " Parts Blender (budget " .. Config.Assets.decoBudgetParts .. "), " .. df .. " Parts de repli")
	local rn, ru = Builder.dressRelief(assets)
	print("[Assets] relief : " .. rn .. " pièce(s), " .. ru .. " Parts (budget " .. Config.Assets.reliefBudgetParts .. ")")
	print("[Assets] panneaux d'étoiles : " .. Builder.dressSigns(assets))
	assets.loadGroup("vfx")
	print("[Assets] effets 3D : " .. Builder.exportVfx(assets) .. " modèle(s) publiés pour les clients")
	local gt, gp = Builder.dressGround(assets)
	print("[Assets] sol Blender : " .. gt .. " tuile(s), " .. gp .. " Parts (budget " .. Config.Assets.groundBudgetParts .. ")")
	print("[Assets] château Blender : " .. Builder.dressCastle(assets) .. " modèle(s) posé(s)")
	if onAssetsLoaded then
		pcall(onAssetsLoaded)
	end
	-- Rapport de chargement : par catégorie (chargés / demandés / en repli) et, pour chaque échec, nom, ID et message ; publié aux clients (touche F3, « Blender N/M »)
	local lines, loaded, requested = assets.reportLines()
	for _, l in ipairs(lines) do
		if l:find("ÉCHEC", 1, true) then
			warn(l)
		else
			print(l)
		end
	end
	print(("[Assets] TOTAL Blender %d/%d (repli procédural : %d)"):format(loaded, requested, requested - loaded))
	local rv = Instance.new("StringValue")
	rv.Name = "AssetReport"
	rv:SetAttribute("Loaded", loaded)
	rv:SetAttribute("Requested", requested)
	rv.Value = table.concat(lines, "\n"):sub(1, 15000)
	rv.Parent = ReplicatedStorage
end)

local world = Builder.build()
local rng = Random.new()
local sessions = {} -- [Player] = session
local leavingSave = {} -- userId -> true tant que la sauvegarde de départ de ce joueur est en cours (une reconnexion attend)
local pendingSaves, saveLater = {}, nil -- profils à sauvegarder en arrière-plan (voir saveLater)
local beltBuy -- définie avec le tapis roulant central (section dédiée) ; déclarée ici car le gestionnaire de prompts l'utilise
-- lot 9b : Calendar (règles pures du calendrier de 30 jours) et Cal (fonctions du bloc « Lot 9b » plus bas) logent dans Lot7 : AUCUNE variable locale de plus (limite de 200 atteinte)
local Lot7 = { Calendar = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Calendar")), Cal = {}, luckUntil = 0, luckBy = nil, compPaid = 0 } -- lot 7 : Corbeau, tapis privé, bonus serveur, PolicyService (fonctions ajoutées dans le bloc « Lot 7 » plus bas)
local Hen = nil -- énigme de la Mère Poule (HenQuest) : construite après les événements serveur, utilisée par les prompts et la synchronisation
local castleEnter, castleFinish -- définies avec le mode Château (plus bas) ; déclarées ici car le gestionnaire de prompts les utilise
local serverPartyId = nil -- identifiant de la partie de ce serveur (celui du premier joueur envoyé par le hub)

local function rnd()
	return rng:NextNumber()
end
local function wpick(ws)
	return Rules.wpick(ws, rnd)
end

local function getRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function alive(player)
	local h = getHum(player)
	return h ~= nil and h.Health > 0
end
local function validSlot(i)
	return type(i) == "number" and i % 1 == 0 and i >= 1 and i <= Config.SLOTS_MAX
end
-- sfx (optionnel) : clé de Config.SOUNDS jouée par le client avec le message
local function notify(player, msg, sfx)
	if player and player.Parent then
		RNotify:FireClient(player, msg, sfx)
	end
end

---------------------------------------------------------------- Règles
local currentEvent = nil -- { cfg, ends }
local function evKey()
	return currentEvent and currentEvent.cfg.key or nil
end

-- Capacité de la base : 4 + améliorations + bonus de niveau de maison + pass ExtraSlots (jamais plus de Config.SLOTS_MAX = 20).
local function cap(s)
	return Rules.capacity(s.data.up, s.baseLevel or 1, s.passes.ExtraSlots == true)
end
local function carryCap(d)
	return Rules.carryCapacity(d.up)
end
local function hatchTime(s, tier)
	return Rules.hatchTime(tier, s.data.up.inc, s.passes.Fast == true)
end
local function shieldTime(s)
	local lv = Config.BASE_LEVELS[s.baseLevel or 1]
	return Rules.shieldTime(s.data.up.lock) * (s.passes.VipBase == true and Config.VIP_SHIELD_MUL or 1) + (lv and lv.shieldBonus or 0) -- château doré : +10 s
end
-- Multiplicateur de vitesse de marche (pass « Vitesse+ »), appliqué aussi à la tolérance anti-triche.
local function speedMul(s)
	return s.passes.Speed == true and Config.SPEED_PASS_MUL or 1
end
local function freeSlot(s)
	for i = 1, cap(s) do
		if not s.data.slots[i] then
			return i
		end
	end
	return nil
end

-- Une passe est-elle ACTIVE ? Les passes à hasard (Lucky, Tapis privé) exigent que PolicyService ait confirmé « non restreint » (restricted == false) : restreint ou inconnu = inactive,
-- même si le joueur la possède (lot 7b : sinon une reconnexion la réactivait). Toute lecture d'une passe à hasard passe par ici.
local function passOn(s, name)
	if s.passes[name] ~= true then
		return false
	end
	local def = Config.PASSES[name]
	return not (def and def.random == true and s.restricted ~= false)
end

-- Multiplicateur de revenu : renaissances, Festin, événement, passe, collection, puis bonus de la maison évolutive (1 + 5 % à 50 %, REFONTE lot 5).
local function gmult(s)
	return Rules.multiplier(s.data.rb, s.data.up.food, evKey() == "gold", s.passes.Coins2x == true, Config.collectionBonus(s.species or 0)) * Rules.levelMul(s.baseLevel or 1)
end

local function income(s)
	return Rules.income(s.data.slots, cap(s), gmult(s))
end

local function luckPoints(s)
	return Rules.upPoints(s.data.up.luck, evKey() == "luck", passOn(s, "Lucky"), os.time() < s.data.luckUntil, os.time() < Lot7.luckUntil)
end

local function rollPet(s, eggTier, guaranteed)
	local up = Config.effectiveUp(eggTier, luckPoints(s), Config.dexTopTier(s.data.dex)) -- lot 9 : pas d'amélioration vers une rareté jamais découverte
	local alien = evKey() == "alien"
	return Rules.rollPet(eggTier, up, alien, rnd, guaranteed), up, alien
end

---------------------------------------------------------------- Missions quotidiennes
local QUEST_TYPES = { "steal", "hatch", "earn", "train", "pvp", "discover", "sell", "castle", "rare", "secret" }

local function newQuests(s)
	local inc = math.max(income(s), 1)
	local pool = table.clone(QUEST_TYPES)
	local out = {}
	for _ = 1, 3 do
		local t = table.remove(pool, rng:NextInteger(1, #pool))
		local goal
		if t == "steal" then
			goal = rng:NextInteger(3, 7)
		elseif t == "hatch" then
			goal = rng:NextInteger(4, 9)
		elseif t == "earn" then
			goal = math.floor(math.max(1000, inc * 240))
		elseif t == "train" then
			goal = rng:NextInteger(3, 6) * 20
		elseif t == "sell" then
			goal = rng:NextInteger(2, 4)
		elseif t == "castle" or t == "rare" or t == "secret" then
			goal = 1
		else -- pvp, discover
			goal = rng:NextInteger(1, 2)
		end
		local bonus = Config.questBonus(t, #out + 1, s.data.story.ch)
		out[#out + 1] = { t = t, goal = goal, prog = 0, rew = math.floor(math.max(250, inc * 150)), re = bonus.egg or 0, rb = bonus.boost or 0, claimed = false }
	end
	return out
end

local function qp(s, t, n)
	for _, q in ipairs(s.data.quests) do
		if q.t == t and q.prog < q.goal then
			q.prog = math.min(q.goal, q.prog + n)
		end
	end
end

local function ensureQuests(s)
	local today = os.time() // 86400
	if s.data.qday ~= today or #s.data.quests == 0 then
		s.data.quests = newQuests(s)
		s.data.qday = today
	end
end

---------------------------------------------------------------- Histoire (chapitres), collection et rang
local function speciesCount(d)
	local n = 0
	for _ in pairs(d.dex) do
		n += 1
	end
	return n
end

local function chapter(s)
	return Config.STORY[s.data.story.ch + 1]
end

local function storyReached(s, c)
	notify(s.player, "📜 Chapitre « " .. c.title .. " » terminé ! Réclame ta récompense (Missions > Histoire).", "claim")
end

-- Fait avancer le chapitre en cours si son type correspond. info = { rival = n, tier = n } selon l'événement.
local function sp(s, kind, n, info)
	local c = chapter(s)
	local st = s.data.story
	if not c or c.type ~= kind or st.prog >= c.goal then
		return
	end
	if c.rival and (not info or info.rival ~= c.rival) then
		return
	end
	if c.tier and (not info or (info.tier or 0) < c.tier) then
		return
	end
	st.prog = math.min(c.goal, st.prog + n)
	if st.prog >= c.goal then
		storyReached(s, c)
	end
end

-- Chapitres fondés sur un état (espèces découvertes, renaissances).
local function storyRefresh(s)
	local c = chapter(s)
	local st = s.data.story
	if not c or st.prog >= c.goal then
		return
	end
	local value
	if c.type == "species" then
		value = s.species
	elseif c.type == "rebirth" then
		value = s.data.rb
	end
	if value and value > st.prog then
		st.prog = math.min(c.goal, value)
		if st.prog >= c.goal then
			storyReached(s, c)
		end
	end
end

local function updateSign(s)
	local r = Config.rankFor(s.data.story.ch)
	s.plot.nameLabel.Text = "🏠 Base de " .. s.player.DisplayName .. " · " .. r.emoji .. " " .. r.name
end

---------------------------------------------------------------- Statistiques de succès (l'énigme du jour est dans HenQuest)
local function statValues(s)
	local d = s.data
	return { hatched = d.hatched, stolen = d.stolen, species = s.species, rb = d.rb, puzzles = d.puzzle.solved, tower = d.battle.best, fragments = d.puzzle.fragments }
end

---------------------------------------------------------------- Synchronisation client
local function snapshot(s)
	local d = s.data
	local slots = {}
	for i = 1, Config.SLOTS_MAX do
		local sl = d.slots[i]
		if sl and sl.k == "e" then
			slots[i] = { k = "e", t = sl.t, ends = sl.ends }
		elseif sl then
			slots[i] = { k = "p", p = sl.p, s = sl.s, m = sl.m }
		else
			slots[i] = false
		end
	end
	local today = os.time() // 86400
	local nextStreak = (d.daily == today - 1) and d.streak + 1 or 1
	return {
		up = d.up,
		slots = slots,
		rb = d.rb,
		dex = d.dex,
		mult = gmult(s),
		cap = cap(s),
		baseLevelFloor = d.baseLevelFloor,
		carry = #s.carry,
		carryCap = carryCap(d),
		passes = s.passes,
		starter = s.data.starter == true,
		dailyReady = d.daily ~= today,
		dailyReward = math.floor(math.max(200, income(s) * 600) * math.min(nextStreak, 7)),
		streak = nextStreak,
		stolen = d.stolen,
		hatched = d.hatched,
		cine = d.cine,
		quests = d.quests,
		equip = d.equip,
		luckLeft = math.max(0, d.luckUntil - os.time()),
		story = { ch = d.story.ch, prog = d.story.prog },
		pity = d.pity,
		species = s.species,
		collection = Config.collectionBonus(s.species),
		runes = s.runes,
		hen = Hen and Hen.snapshot(s) or nil, -- énigme de la Mère Poule : étape, plumes, indices (lot 6) ; aucun indice n'est envoyé avant le ramassage de la plume
		puzzleDone = d.puzzle.day == today,
		puzzleSolved = d.puzzle.solved,
		ach = d.ach,
		stats = statValues(s),
		baseScore = d.baseScore,
		away = math.floor(d.pendingAway),
		battle = { pvp = { trophies = d.battle.pvp.trophies, season = d.battle.pvp.season, wins = d.battle.pvp.wins, losses = d.battle.pvp.losses, hasDefense = #d.battle.pvp.defense > 0, fightsLeft = math.max(0, Config.PVP.dailyFights - (d.battle.pvp.day == os.time() // 86400 and d.battle.pvp.fights or 0)) }, team = d.battle.team, best = d.battle.best, fightsLeft = math.max(0, Config.TOWER.dailyFights - (d.battle.day == os.time() // 86400 and d.battle.fights or 0)), repeatsLeft = math.max(0, Config.TOWER.dailyRepeats - (d.battle.day == os.time() // 86400 and d.battle.repeats or 0)) },
		baseLevel = s.baseLevel,
		welcome = s.welcome, -- œuf de bienvenue du tapis : wait / offered / taken / gone / none (onboarding)
		newbie = s.newbie == true, -- protection débutant active (lot 4)
		tokens = d.tokens.remoteSteal, -- lot 7 : jetons du Corbeau, réglage, journal « Qui m'a volé ? », offres masquées (PolicyService), bonus serveur, œufs du tapis privé
		ravenLeft = Lot7.ravenLeft and Lot7.ravenLeft(s) or 0,
		settings = { blockFriendRavens = d.settings.blockFriendRavens == true },
		stealLog = d.stealLog,
		restricted = s.restricted ~= false, -- vrai tant que PolicyService n'a pas confirmé « non restreint » (repli prudent : offres à hasard masquées)
		srv = Lot7.serverBuffs and Lot7.serverBuffs() or { golden = 0, luck = 0 },
		pbCount = #d.pb,
		cal = Lot7.Cal.snapshot and Lot7.Cal.snapshot(s) or nil, -- lot 9b : vue du calendrier (le jour est décidé ICI, jamais par le client)
	}
end

local function pushStats(s)
	local d = s.data
	local p = s.player
	p:SetAttribute("Coins", d.coins)
	p:SetAttribute("Speed", d.speed)
	p:SetAttribute("Income", income(s))
	s.lsCoins.Value = math.floor(math.min(d.coins, 9e15))
	s.lsSpeed.Value = math.floor(d.speed)
	s.lsRb.Value = d.rb
	s.lsRank.Value = Config.rankFor(d.story.ch).name
end

local function sync(s)
	pushStats(s)
	RState:FireClient(s.player, snapshot(s))
end

---------------------------------------------------------------- Vigilance des territoires et protection débutant (lot 4)
-- Vols réussis par territoire (horodatages os.clock) : Guard.vigilance en tire le bonus de vue et d'ouïe des gardiens de CE territoire.
local vigilSteals = {}
local function recordSteal(terr)
	local now = os.clock()
	local list = Guard.vigilancePrune(vigilSteals[terr] or {}, now, Config.VIGILANCE)
	list[#list + 1] = now
	vigilSteals[terr] = list
end
local function vigilanceOf(terr)
	return Guard.vigilance(vigilSteals[terr] or {}, os.clock(), Config.VIGILANCE)
end
-- Protection débutant : moins de Config.NEWBIE.minutes de jeu cumulées ET maison sous le niveau Config.NEWBIE.untilLevel (sauf fin anticipée).
local function isNewbie(s)
	return Config.isNewbie(s.data.played, s.baseLevel, s.data.newbieOff)
end

---------------------------------------------------------------- Vitesse / étourdissement
-- Rarétés des œufs portés (liste d'indices) : le poids du portage dépend de la rareté (Config.CARRY.weight, produit, plancher 0,70).
local function carryTiers(s)
	local out = {}
	for i, e in ipairs(s.carry) do
		out[i] = e.t
	end
	return out
end
-- Boue (Mara) : vitesse x Config.TRAPS.mudMul tant que le joueur est encore « embourbé » dans l'un des territoires (états de Traps par territoire).
local function mudMulOf(s)
	local m = 1
	local now = os.clock()
	for _, ps in pairs(s.traps or {}) do
		m = math.min(m, Traps.mudMul(ps, now, Config.TRAPS))
	end
	return m
end
local function applySpeed(s)
	local hum = getHum(s.player)
	if hum and s.stun <= 0 then
		local ws = Config.walkSpeed(s.data.speed) * speedMul(s) * Config.carryMul(carryTiers(s)) * mudMulOf(s) * ((s.slowUntil or 0) > os.clock() and Config.INTRUDER.dogMul or 1)
		if math.abs(hum.WalkSpeed - ws) > 0.05 then
			hum.WalkSpeed = ws
		end
	end
end

---------------------------------------------------------------- Badge débutant, porte de base (lot 4)
-- Met à jour la protection débutant d'un joueur : attribut `Newbie` (le client l'affiche), badge 🐣 au-dessus de la tête (recréé après chaque réapparition).
local function refreshNewbie(s)
	local nb = isNewbie(s)
	if nb ~= s.newbie then
		local was = s.newbie
		s.newbie = nb
		s.player:SetAttribute("Newbie", nb)
		if was == true and not nb then
			notify(s.player, "⚔️ Protection débutant terminée : tu peux voler les autres joueurs, et ils peuvent te voler.")
		end
	end
	local char = s.player.Character
	local adornee = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if nb and adornee and not (s.badge and s.badge.Parent and s.badge.Adornee == adornee) then -- recréé après chaque réapparition (nouveau personnage)
		if s.badge then
			s.badge:Destroy()
			s.badge = nil
		end
		do
			local gui = Instance.new("BillboardGui")
			gui.Name = "NewbieBadge"
			gui.Adornee = adornee
			gui.Size = UDim2.fromOffset(44, 44)
			gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
			gui.MaxDistance = 80
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Enum.Font.GothamBold
			t.TextSize = 30
			t.Text = "🐣"
			t.Parent = gui
			gui.Parent = adornee
			s.badge = gui
		end
	elseif not nb and s.badge then
		s.badge:Destroy()
		s.badge = nil
	end
end

-- Barrière lumineuse de la porte de base : un mur de lumière sur le bord de la base qui regarde la place (aucune collision : le serveur refuse le vol).
local function setDoorBarrier(s, on)
	if on and not s.doorPart and s.plot then
		local half = math.max(s.plot.platform.Size.X / 2, (Config.baseExtent(s.baseLevel or 1)))
		local p = Instance.new("Part")
		p.Name = "DoorBarrier"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 120, 90)
		p.Transparency = 0.6
		p.Size = Vector3.new(half * 2, 7, 0.4)
		p.CFrame = s.plot.cf * CFrame.new(0, 4.5, -(half + 0.2))
		p.Parent = s.plot.model
		s.doorPart = p
	elseif not on and s.doorPart then
		s.doorPart:Destroy()
		s.doorPart = nil
	end
end

---------------------------------------------------------------- Œufs portés
local function rebuildCarry(s)
	s.player:SetAttribute("Carry", #s.carry) -- le client évite les plans de caméra quand un œuf est porté
	for _, p in ipairs(s.carryParts) do
		p:Destroy()
	end
	s.carryParts = {}
	local char = s.player.Character
	local root = getRoot(s.player)
	if not (char and root) then
		return
	end
	for i, e in ipairs(s.carry) do
		local egg = Builder.egg(e.t, false)
		egg.Massless = true
		local off = CFrame.new(0, 3.4 + (i - 1) * 1.8, 0)
		egg.CFrame = root.CFrame * off
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = egg
		w.C0 = off
		w.Parent = egg
		egg.Parent = char
		CollectionService:AddTag(egg, "CarryEgg") -- balancement pendant la course (client)
		s.carryParts[i] = egg
	end
	-- colonne de lumière : le porteur d'un œuf Légendaire ou plus est visible de loin (BillboardGui, portée Config.CARRY.beamRange, détruit avec les œufs)
	local top = 0
	for _, e in ipairs(s.carry) do
		top = math.max(top, e.t)
	end
	if top >= Config.CARRY.beamTier then
		local gui = Instance.new("BillboardGui")
		gui.Name = "CarryBeam"
		gui.Adornee = root
		gui.Size = UDim2.fromOffset(22, 640)
		gui.ExtentsOffset = Vector3.new(0, 0.5, 0)
		gui.MaxDistance = Config.CARRY.beamRange
		gui.AlwaysOnTop = true
		local col = Instance.new("Frame")
		col.Name = "Column"
		col.Size = UDim2.fromScale(1, 1)
		col.BorderSizePixel = 0
		col.BackgroundColor3 = Config.TIERS[top].color
		col.BackgroundTransparency = 0.25
		col.Parent = gui
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		fade.Parent = col
		gui.Parent = root
		s.carryParts[#s.carryParts + 1] = gui
	end
end

---------------------------------------------------------------- Nids des rivaux
local function setNestEgg(n, tier)
	n.egg = tier
	if n.eggPart then
		n.eggPart:Destroy()
		n.eggPart = nil
	end
	if not tier then
		return
	end
	local egg = Builder.egg(tier, true)
	egg.CFrame = CFrame.new(n.pos)
	egg.Parent = n.folder
	n.eggPart = egg
	CollectionService:AddTag(egg, "EggShake") -- animé côté client (rebond ; pas d'attribut Ends = pas de tremblement)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Voler l'œuf"
	pr.ObjectText = "Œuf " .. Config.TIERS[tier].name
	pr.HoldDuration = Config.stealTime(0, n.terr) -- temps de vol propre au territoire (sauvage 0,8 / Gus 1,3 / Mara 2,2 / Zed 3,5)
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Terr", n.terr)
	pr:SetAttribute("Kind", "Nest")
	pr:SetAttribute("Nest", n.index)
	pr:SetAttribute("Rival", n.rival) -- le client masque le prompt tant que la zone est verrouillée
	pr.Parent = egg
	CollectionService:AddTag(pr, "StealPrompt")
	Builder.sign(egg, Config.TIERS[tier].name, Config.TIERS[tier].color, 3, 160)
end

for i, n in ipairs(world.nests) do
	n.index = i
	setNestEgg(n, wpick(Config.foldWeights(n.weights or Config.RIVALS[n.rival].weights))) -- enclos sauvage : poids propres (Config.TERR.wild)
end

---------------------------------------------------------------- Pads d'une base
local hatch, speedUpEgg -- déclarations anticipées

local function clearPad(s, i)
	local pad = s.plot.pads[i]
	if pad.content then
		local gp = pad.content:GetAttribute("GuardParts")
		if s.guardBudget and gp then
			s.guardBudget.used = math.max(0, s.guardBudget.used - gp)
		end
		pad.content:Destroy()
		pad.content = nil
	end
	s.labels[i] = nil
end

local function refreshPad(s, i, animate)
	clearPad(s, i)
	local d = s.data
	local pad = s.plot.pads[i]
	local locked = i > cap(s)
	pad.locked = locked
	pad.lock.Enabled = locked
	if locked then
		local lbl = pad.lock:FindFirstChild("Text")
		if lbl then
			lbl.Text = Config.slotHint(i, cap(s), s.data.up.slots, s.baseLevel or 1, s.passes.ExtraSlots == true) -- cadenas + coût du prochain emplacement
		end
	end
	pad.part.Transparency = locked and 0.25 or 0.7
	pad.part.Color = locked and Color3.fromRGB(40, 40, 45) or Color3.new(1, 1, 1)
	pad.frame.Color = locked and Color3.fromRGB(50, 52, 58) or s.plot.color
	pad.frame.Material = locked and Enum.Material.SmoothPlastic or Enum.Material.Neon
	local sl = d.slots[i]
	if locked or not sl then
		return
	end
	local content = Instance.new("Model")
	content.Name = "Content"
	content.Parent = pad.part
	pad.content = content

	if sl.k == "e" then
		local egg = Builder.egg(sl.t, true)
		egg.CFrame = pad.part.CFrame * CFrame.new(0, 1.9, 0)
		egg:SetAttribute("Ends", sl.ends)
		CollectionService:AddTag(egg, "EggShake")
		egg.Parent = content
		s.guardBudget = s.guardBudget or { used = 0 }
		Builder.nest(pad.part.Position + Vector3.new(0, 0.3, 0), content, sl.t, s.guardBudget) -- l'œuf repose sur une protection selon sa rareté
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Voler l'œuf"
		pr.ObjectText = "Œuf de " .. s.player.DisplayName
		pr.HoldDuration = Config.stealTime(0)
		pr.MaxActivationDistance = 10
		pr.RequiresLineOfSight = false
		pr:SetAttribute("Kind", "Pad")
		pr:SetAttribute("Owner", s.player.UserId)
		pr:SetAttribute("Slot", i)
		pr.Parent = egg
		CollectionService:AddTag(pr, "StealPrompt")
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 40
		cd.Parent = egg
		cd.MouseClick:Connect(function(who)
			speedUpEgg(s, i, who)
		end)
		s.labels[i] = Builder.sign(egg, "", Config.TIERS[sl.t].color, 3, 200)
	else
		local model, lift, labelY = Builder.pet(sl.p, sl.s, sl.m)
		model.Parent = content
		model:PivotTo(pad.part.CFrame * CFrame.new(0, 0.2 + lift, 0))
		CollectionService:AddTag(model, "Bob")
		model:SetAttribute("Seed", i * 17 + sl.p) -- désynchronise les clignements et les regards entre pets
		if animate then
			model:SetAttribute("Born", workspace:GetServerTimeNow())
			CollectionService:AddTag(model, "PopIn")
		end
		s.labels[i] = Builder.sign(model.PrimaryPart, "", Config.TIERS[Config.PETS[sl.p].tier].color, labelY, 220)
	end
end

local function refreshAllPads(s)
	for i = 1, Config.SLOTS_MAX do
		refreshPad(s, i)
	end
end

-- Capacité modifiée (niveau de maison, pass) : seuls les emplacements dont l'état verrouillé change, ou qui affichent un coût, sont rafraîchis ;
-- les emplacements occupés ne sont JAMAIS recréés.
local function refreshLocks(s)
	local c = cap(s)
	for i = 1, Config.SLOTS_MAX do
		local pad = s.plot.pads[i]
		if pad and (pad.locked ~= (i > c) or i == c + 1 or pad.hintShown) then
			refreshPad(s, i)
			pad.hintShown = (i > c) and i == c + 1 or nil
		end
	end
end

---------------------------------------------------------------- Retour / chute des œufs portés
local function returnEgg(e)
	if e.rival then
		local home = e.nest and world.nests[e.nest]
		if home then -- l'œuf regagne SON nid (même si un autre œuf y est réapparu entre-temps : le nid est remis tel qu'il était)
			setNestEgg(home, e.t)
			return
		end
		for pass = 1, 2 do -- d'abord un nid libre de SON territoire (clé `terr`), à défaut n'importe quel nid libre du même rival
			for _, n in ipairs(world.nests) do
				if n.rival == e.rival and not n.egg and (pass == 2 or n.terr == e.terr) then
					setNestEgg(n, e.t)
					return
				end
			end
		end
	elseif e.from then
		local vp = Players:GetPlayerByUserId(e.from)
		local vs = vp and sessions[vp]
		if vs then
			local i = freeSlot(vs)
			if i then
				vs.data.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(vs), rv = e.rv, rvAt = e.rvAt }
				refreshPad(vs, i)
				notify(vs.player, "🥚 Ton œuf t'a été rendu !")
				sync(vs)
			end
		end
	end
end

local function dropCarry(s)
	if #s.carry == 0 then
		return
	end
	for _, e in ipairs(s.carry) do
		if e.belt and (e.paid or 0) > 0 then
			s.data.coins += e.paid -- œuf du tapis perdu en route : les pièces sont rendues (il n'a pas de nid d'origine)
			notify(s.player, "🪙 Œuf du tapis perdu : " .. Config.fmt(e.paid) .. " 🪙 rendues.")
		end
		returnEgg(e)
	end
	s.carry = {}
	rebuildCarry(s)
	applySpeed(s)
	if s.player.Parent then
		sync(s)
	end
end

local function afterTake(s, msg, sfx)
	rebuildCarry(s)
	applySpeed(s)
	sync(s)
	notify(s.player, msg or "🥚 Œuf volé ! Rapporte-le vite à ta base.", sfx or "steal")
end

---------------------------------------------------------------- Pets suiveurs (le déplacement est calculé côté client, le serveur ne fait que créer les modèles)
local followersFolder = Instance.new("Folder")
followersFolder.Name = "Followers"
followersFolder.Parent = workspace

local function clearFollowers(s)
	for _, m in ipairs(s.followers) do
		m:Destroy()
	end
	s.followers = {}
end

local function rebuildFollowers(s)
	clearFollowers(s)
	local d = s.data
	local clean = {}
	for _, i in ipairs(d.equip) do
		local sl = validSlot(i) and d.slots[i]
		if sl and sl.k == "p" then
			clean[#clean + 1] = i
		end
	end
	d.equip = clean
	local root = getRoot(s.player)
	if not root or not alive(s.player) then
		return
	end
	for n, i in ipairs(d.equip) do
		local sl = d.slots[i]
		local m = Builder.follower(sl.p, sl.s, sl.m)
		m.Name = "Follower"
		m:SetAttribute("OwnerId", s.player.UserId)
		m:SetAttribute("Idx", n)
		m:PivotTo(root.CFrame * CFrame.new((n - 2) * 3, -2, 4))
		m.Parent = followersFolder
		CollectionService:AddTag(m, "Follower")
		s.followers[#s.followers + 1] = m
	end
end

---------------------------------------------------------------- Annonces (ce serveur + tous les serveurs)
local function announce(text)
	for _, pl in ipairs(Players:GetPlayers()) do
		notify(pl, text)
	end
	task.spawn(function()
		pcall(function()
			MessagingService:PublishAsync("ChipeAnnounce", { sid = Data.SERVER_ID, text = text })
		end)
	end)
end
task.spawn(function() -- SubscribeAsync attend le réseau : ne pas bloquer le démarrage du serveur
	pcall(function()
		MessagingService:SubscribeAsync("ChipeAnnounce", function(msg)
			local m = msg.Data
			if type(m) == "table" and m.sid ~= Data.SERVER_ID and type(m.text) == "string" then
				for _, pl in ipairs(Players:GetPlayers()) do
					notify(pl, m.text)
				end
			end
		end)
	end)
end)

---------------------------------------------------------------- Progression de la base (niveau d'après le score pondéré par la rareté)
-- Niveau de maison d'après le score pondéré par la rareté, la rareté découverte (niveaux 7 et 8) et le plancher sauvegardé (jamais de recul).
local function levelOf(s)
	return Config.baseLevel(s.data.baseScore, s.data.dex, s.data.baseLevelFloor)
end
-- Reconstruit l'apparence de la base au niveau courant et publie le niveau (attributs lus par le client : animation de montée de niveau, interface).
-- Une vraie montée (célébration demandée, niveau supérieur à celui déjà construit) lance l'animation : l'ancienne maison reste le temps de l'effet (Config.UPGRADE_FX),
-- les pads ne sont pas recréés (refreshLocks). `force` reconstruit sans animation (modèles Blender arrivés, renaissance).
local function applyBase(s, celebrate, force)
	local level = levelOf(s)
	local before = s.baseLevel
	s.baseLevel = level
	local built = s.baseBuilt
	local rose = celebrate and built ~= nil and level > built
	if s.plot and (built ~= level or force) then
		Builder.baseUpgrade(s.plot, level, rose and { animate = true } or nil)
		s.baseBuilt = level
		if rose then
			local plot = s.plot
			task.delay(Config.UPGRADE_FX.seconds, function()
				if plot.upgrading then
					Builder.finishUpgrade(plot)
				end
			end)
		end
	end
	if before ~= nil and level > before then
		tele.log(s.player, "house_level_reached", s.data.played, "_l" .. level)
	end
	if s.plot and before ~= level then
		refreshLocks(s) -- la capacité dépend du niveau : cadenas et coûts à jour, pets déjà posés intacts
	end
	s.player:SetAttribute("BaseLevel", level)
	s.player:SetAttribute("BaseScore", s.data.baseScore)
	if rose or (celebrate and before and level > before) then
		local lv = Config.BASE_LEVELS[level]
		local text = Config.upgradeBanner(level)
		local player = s.player
		-- la bannière, la fanfare et les confettis arrivent au début de la fête (après échafaudage, poussière et échange des maisons : 2,7 s)
		task.delay(Config.UPGRADE_FX.scaffold + Config.UPGRADE_FX.dust + Config.UPGRADE_FX.swap, function()
			notify(player, text, "levelup")
		end)
		if level >= Config.UPGRADE_FX.announceFrom then
			announce("🏠 " .. player.DisplayName .. " passe au niveau " .. level .. " : " .. lv.emoji .. " " .. lv.name .. " !")
		end
		sync(s)
	end
end

-- Les modèles Blender arrivent APRÈS l'entrée des premiers joueurs : une fois un groupe chargé, on reconstruit la base et les pads déjà affichés
-- (sinon le repli procédural resterait visible jusqu'au prochain changement de niveau).
onAssetsLoaded = function()
	for _, s in pairs(sessions) do
		pcall(function()
			applyBase(s, false, true)
			refreshAllPads(s)
		end)
	end
end

---------------------------------------------------------------- Éclosion
function hatch(s, i)
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	local guaranteed = Config.PITY_ENABLED and sl.t <= Config.UPGRADE.maxEggTier and d.pity >= Config.PITY_EVERY - 1
	local p, upPoints, alienBoost = rollPet(s, sl.t, guaranteed)
	local oneIn = Reveal.oneIn(Config, Rules, sl.t, upPoints, alienBoost, p.p, p.s, p.m, guaranteed)
	if p.tier > sl.t then
		d.pity = 0
	elseif sl.t <= Config.UPGRADE.maxEggTier then
		d.pity += 1
	end
	local firstOfTier = true -- lot 9 (mesure) : première fois que cette rareté est obtenue ?
	for k, e in pairs(d.dex) do
		local dd = Config.PETS[tonumber(k) or 0]
		if dd and dd.tier == p.tier and type(e) == "table" and type(e.n) == "number" and e.n > 0 then
			firstOfTier = false
		end
	end
	d.slots[i] = { k = "p", p = p.p, s = p.s, m = p.m }
	d.hatched += 1
	if d.hatched == 1 then
		tele.log(s.player, "first_hatch_seconds", d.played)
	end
	if firstOfTier then
		tele.log(s.player, "tier_first_reached", d.played, "_r" .. p.tier)
	end
	tele.log(s.player, "hatch_tier", 1, "_r" .. p.tier)
	d.baseScore += Config.baseGain(p.tier) -- la base grandit avec chaque pet éclos, d'autant plus que le pet est rare
	local key = tostring(p.p)
	local dx = d.dex[key]
	if not dx then
		dx = { n = 0, b = 0 }
		d.dex[key] = dx
		s.species += 1
		qp(s, "discover", 1)
	end
	dx.n += 1
	dx.b = math.max(dx.b, Config.SIZES[p.s].mult * Config.MUTS[p.m].mult)
	refreshPad(s, i, true)
	qp(s, "hatch", 1)
	local def = Config.PETS[p.p]
	sp(s, "hatch", 1)
	applyBase(s, true)
	sp(s, "tier", 1, { tier = def.tier })
	if p.m > 1 then
		sp(s, "mut", 1)
	end
	if Config.tierAtLeast(def.tier, "shine") then
		qp(s, "rare", 1)
	end
	storyRefresh(s)
	local big = Config.tierAtLeast(def.tier, "announce") or p.m > 1 or p.s >= 4
	local col = Config.MUTS[p.m].color or Config.TIERS[def.tier].color
	Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 3, 0), col, big and 90 or 25, big)
	-- Rareté élevée ou tirage secret : cercle runique au sol, particules, pilier de lumière et contour lumineux du pet (Config.AURA)
	local secretHit = oneIn >= Config.REVEAL.secret.oneInAtLeast
	if Config.AURA.Enabled and (def.tier >= Config.AURA.minTier or secretHit) then
		Builder.aura(s.plot.pads[i].part.Position, col, def.tier, secretHit)
		local holder = s.plot.pads[i].content
		local petModel = holder and holder:FindFirstChild("Pet")
		if Config.AURA.highlight and petModel then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 1
			hl.OutlineColor = col
			hl.OutlineTransparency = 0.1
			hl.Parent = petModel
			game:GetService("Debris"):AddItem(hl, Config.AURA.seconds)
		end
	end
	RHatch:FireClient(s.player, { p = p.p, s = p.s, m = p.m, slot = i, inc = Config.petIncome(p.p, p.s, p.m) * gmult(s), oneIn = oneIn < math.huge and oneIn or 0, egg = sl.t, upgraded = p.tier > sl.t })
	if Config.tierAtLeast(def.tier, "serverBanner") or p.m >= 5 or p.s == 5 then
		announce("🌟 " .. s.player.DisplayName .. " vient d'obtenir " .. def.emoji .. " " .. Config.petName(p.p, p.s, p.m) .. " !")
	end
	sync(s)
end

function speedUpEgg(s, i, who)
	if who ~= s.player then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	Lot7.chase(s, i) -- un corbeau vise cet œuf : le toucher (dans sa base) le chasse
	local now = os.clock()
	if now - s.lastTap < 0.12 then
		return
	end
	s.lastTap = now
	sl.ends -= 1
	local content = s.plot.pads[i].content
	local eggPart = content and content:FindFirstChild("Egg")
	if eggPart then
		eggPart:SetAttribute("Ends", sl.ends)
	end
	if os.time() >= sl.ends then
		hatch(s, i)
	end
end

---------------------------------------------------------------- Vol (nids PNJ et bases des joueurs)
-- Le serveur mesure lui-même la durée de maintien du bouton (le client ne fait qu'afficher la barre).
local holds = {}
local pendingCharges = {} -- lot 8A : alarmes de nid en attente { player, terr, at } (Mara et Zed ; traitées par guardsStep)
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
	holds[player] = { prompt = prompt, t = os.clock() }
	local s = sessions[player]
	if s then
		s.holdSeen = true
	end
end)

-- Secrets de la carte : une récompense par jour et par secret, distance et existence vérifiées côté serveur.
local function claimSecret(s, root, prompt)
	local id = prompt:GetAttribute("SecretId")
	local sct = type(id) == "string" and Config.secret(id)
	local holder = prompt.Parent
	if not sct or not holder or not holder:IsA("BasePart") or (root.Position - holder.Position).Magnitude > 18 then
		return
	end
	local today = os.time() // 86400
	if s.data.secrets[sct.id] == today then
		notify(s.player, "💤 Tu as déjà fouillé ici aujourd'hui. Reviens demain !")
		return
	end
	local reward = Config.secretReward(sct, income(s))
	s.data.secrets[sct.id] = today
	s.data.coins += reward
	Builder.burst(holder.Position, Color3.fromRGB(255, 214, 90), 24, true)
	qp(s, "secret", 1)
	notify(s.player, sct.emoji .. " " .. sct.name .. " : +" .. Config.fmt(reward) .. " 🪙", "secret_decouvert") -- secret de la carte (lot 8A)
	sync(s)
end

-- Voyage rapide (Config.TRAVEL2) : le serveur valide TOUT (destination, portail débloqué, joueur vivant, hors combat, hors château, à moins de
-- maxDistance du portail, délai, AUCUN œuf porté : on ne téléporte jamais un œuf) ; la destination vient d'un attribut du prompt, jamais du client.
-- dest > 0 : portail k de la rose ; 0 : retour à la place ; -i : arche de la base i (réservée à son propriétaire).
local function fastTravel(s, dest, prompt)
	local root = getRoot(s.player)
	local T = Config.TRAVEL2
	if not root or not alive(s.player) or s.stun > 0 or s.castle then
		return false
	end
	if type(dest) ~= "number" or dest % 1 ~= 0 or dest < -Config.PLOT_COUNT or dest > #T.portals then
		return false
	end
	if not (prompt and prompt.Parent and prompt.Parent:IsA("BasePart")) or (root.Position - prompt.Parent.CFrame.Position).Magnitude > T.maxDistance + 1 then
		return false
	end
	local now = os.clock()
	if now - (s.travelAt or -99) < T.cooldown then
		return false
	end
	if s.sinceHit < T.combatLock then
		notify(s.player, "⚔️ Pas de voyage rapide en plein combat.")
		return false
	end
	if T.blockWhileCarrying and #s.carry > 0 then
		notify(s.player, "🥚 Pas de portail avec un œuf : rapporte-le à pied !", "refuse")
		return false
	end
	local x, z
	if dest < 0 then
		local plot = s.plot
		if not plot or plot.index ~= -dest then
			notify(s.player, "🏠 Cette arche mène à la base d'un autre joueur.", "refuse")
			return false
		end
		local sp = plot.spawn.CFrame.Position
		x, z = sp.X, sp.Z
	else
		if dest > 0 and not Config.portalUnlocked(s.data.story.ch, dest) then
			notify(s.player, "🔒 Portail verrouillé : termine l'histoire jusqu'au chapitre " .. T.portals[dest].chapter .. ".", "refuse")
			return false
		end
		x, z = Config.travelDest(dest)
	end
	s.travelAt = now
	root.CFrame = CFrame.new(x, 4, z)
	root.AssemblyLinearVelocity = Vector3.zero
	s.noCheckUntil = now + 2
	s.lastPos = nil
	s.lastActive = now
	notify(s.player, "", "portal") -- son de portail
	return true
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	if CollectionService:HasTag(prompt, "BeltEgg") then
		beltBuy(player, prompt)
		return
	end
	if CollectionService:HasTag(prompt, "FastTravel") then
		local ss = sessions[player]
		if ss then
			fastTravel(ss, prompt:GetAttribute("Dest"), prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "CastleEntry") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 and (rr.Position - prompt.Parent.Position).Magnitude <= 20 then
			castleEnter(ss)
		end
		return
	elseif CollectionService:HasTag(prompt, "CastleChest") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) then
			castleFinish(ss, rr, prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "SecretPrompt") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 then
			claimSecret(ss, rr, prompt)
		end
		return
	end
	local kind = prompt:GetAttribute("Kind")
	if kind ~= "Nest" and kind ~= "Pad" and kind ~= "Rune" and kind ~= "RuneConfirm" and kind ~= "HenTalk" and kind ~= "Feather" and kind ~= "PrivBelt" then
		return
	end
	local s = sessions[player]
	local root = getRoot(player)
	if not s or not root or not alive(player) or s.stun > 0 then
		return
	end
	if kind == "PrivBelt" then
		Lot7.privTake(s, root, prompt) -- tapis privé : seul le propriétaire prend l'œuf (validé dans privTake)
		return
	end
	if kind == "Rune" or kind == "RuneConfirm" or kind == "HenTalk" or kind == "Feather" then
		if Hen then -- énigme de la Mère Poule (toutes les validations sont dans HenQuest)
			if kind == "Rune" then
				Hen.stoneTap(s, root, prompt)
			elseif kind == "RuneConfirm" then
				Hen.confirmRunes(s, root)
			elseif kind == "HenTalk" then
				Hen.talk(s, root)
			else
				Hen.pickFeather(s, root, prompt)
			end
		end
		return
	end
	local now = os.clock()
	if now - s.lastSteal < 0.3 then
		return
	end
	s.lastSteal = now
	if s.holdSeen then
		local h = holds[player]
		holds[player] = nil
		if not h or h.prompt ~= prompt or os.clock() - h.t < Config.stealTime(s.data.up.fing, prompt:GetAttribute("Terr")) * 0.7 then
			return
		end
	end
	if #s.carry >= carryCap(s.data) then
		notify(player, "Sac plein ! Rapporte tes œufs à ta base.")
		return
	end

	if kind == "Nest" then
		local n = world.nests[prompt:GetAttribute("Nest")]
		if not n or not n.egg or (root.Position - n.pos).Magnitude > 18 then
			return
		end
		local zone = Config.ZONES[n.rival]
		if not Config.zoneUnlocked(s.data.story.ch, n.rival) then
			notify(player, "🔒 " .. zone.name .. " : termine d'abord le chapitre " .. zone.chapter .. " de l'histoire.", "caught")
			return
		end
		local t = n.egg
		setNestEgg(n, nil)
		Builder.flyEgg(t, n.pos, player.UserId)
		Builder.burst(n.pos, Config.TIERS[t].color, 14, false)
		n.rt = rng:NextNumber(9, 16) * (1 + (n.rival - 1) * 0.3)
		s.carry[#s.carry + 1] = { t = t, rem = hatchTime(s, t), rival = n.rival, terr = n.terr, nest = n.index, fresh = Traps.freshDeadline(Config, t, n.terr, os.clock()) }
		recordSteal(n.terr) -- vigilance : les gardiens de ce territoire voient et entendent plus loin pendant un moment
		s.data.stolen += 1
		qp(s, "steal", 1)
		sp(s, "steal", 1, { rival = n.rival })
		local alarm = Config.TERR[n.terr] and Config.TERR[n.terr].nestAlarm
		if alarm then -- alarme du nid (Mara, Zed) : le gardien le plus proche chargera le voleur dans alarm.delay s (voir guardsStep)
			if #pendingCharges < 64 then -- borne de sécurité (une entrée par vol, purgée en alarm.delay s)
				pendingCharges[#pendingCharges + 1] = { player = player, terr = n.terr, at = os.clock() + alarm.delay }
			end
			afterTake(s, "🥚 Œuf chipé ! " .. (n.rival == 3 and "🐻 L'ours" or "🐺 Le loup") .. " a senti le nid se vider : file vers la sortie !")
		else
			afterTake(s)
		end
	else
		local vp = Players:GetPlayerByUserId(prompt:GetAttribute("Owner") or 0)
		local vs = vp and sessions[vp]
		local i = prompt:GetAttribute("Slot")
		if not vs or vs == s or type(i) ~= "number" then
			return
		end
		local sl = vs.data.slots[i]
		if not sl or sl.k ~= "e" then
			return
		end
		if isNewbie(s) then
			notify(player, "🐣 Protection débutant : tu ne peux pas encore voler d'autres joueurs (menu : « Je suis prêt pour le PvP »).")
			return
		end
		if isNewbie(vs) then
			notify(player, "🐣 Ce joueur est sous protection débutant : ses œufs ne peuvent pas être volés.")
			return
		end
		if (vs.lockUntil or 0) > os.clock() then
			notify(player, "🔒 La porte de cette base est fermée !")
			return
		end
		if (sl.shield or 0) > os.time() or (vs.graceUntil or 0) > os.time() then
			notify(player, "🛡 Cet œuf est encore protégé !")
			return
		end
		local pad = vs.plot.pads[i].part
		if (root.Position - pad.Position).Magnitude > 20 then
			return
		end
		vs.data.slots[i] = false
		refreshPad(vs, i)
		Builder.flyEgg(sl.t, pad.Position + Vector3.new(0, 2, 0), player.UserId)
		s.carry[#s.carry + 1] = { t = sl.t, rem = math.max(0, sl.ends - os.time()), from = vp.UserId, rv = sl.rv, rvAt = sl.rvAt } -- rv/rvAt suivent l'œuf (lot 7b)
		s.data.stolen += 1
		qp(s, "steal", 1)
		qp(s, "pvp", 1)
		sp(s, "steal", 1, {})
		notify(vp, "😡 " .. player.DisplayName .. " a volé ton œuf ! Rattrape-le !", "caught")
		Lot7.onPhysicalSteal(vs, player.DisplayName, sl.t) -- journal « Qui m'a volé ? » + bouclier post-vol de 5 min contre les corbeaux
		sync(vs)
		afterTake(s)
	end
end)

---------------------------------------------------------------- Gardiens PNJ : perception, états, dégâts non mortels (voir Guard.lua)
local GC = Config.GUARD

-- Réglages de perception propres à chaque gardien (délai de réaction : Gus 1,6 s, Mara 0,9 s, Zed 0,5 s).
local gcCache = {}
local function gcFor(rival)
	local c = gcCache[rival]
	if not c then
		c = setmetatable({ alertDelay = Config.RIVALS[rival].alertDelay or GC.alertDelay }, { __index = GC })
		gcCache[rival] = c
	end
	return c
end

local function setHp(s, hp)
	s.hp = hp
	s.player:SetAttribute("Hp", math.floor(hp + 0.5))
	s.player:SetAttribute("MaxHp", GC.maxHp)
end

-- Défaite (0 pv) : œufs portés rendus à leur nid, retour à la base avec tous les pv et une courte invulnérabilité. Jamais en un seul coup.
local function defeatAtBase(s)
	dropCarry(s)
	local root = getRoot(s.player)
	if root and s.plot then
		root.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end
	s.noCheckUntil = os.clock() + 2
	s.iframes, s.sinceHit = GC.respawnIframes, 0
	setHp(s, GC.maxHp)
	notify(s.player, "🏠 Tu as été vaincu : retour à ta base, œufs rendus, pv rétablis.", "caught")
end

local function hitPlayer(s, g)
	local r = g.stats
	if r.gentle then
		-- gardien clément (Gus) : jamais de dégâts ; la première prise renvoie à la base (la cargaison est gardée), puis 6 s de répit
		if os.clock() < (s.gentleUntil or 0) then
			return false
		end
		s.gentleUntil = os.clock() + GC.gentleRecover
		s.stun = GC.stun
		s.noCheckUntil = os.clock() + 2
		local root0 = getRoot(s.player)
		if root0 and s.plot then
			root0.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			root0.AssemblyLinearVelocity = Vector3.zero
		end
		notify(s.player, "🐕 " .. r.name .. " t'a attrapé, réessaie ! (aucun œuf ni pet perdu)", "hurt")
		return true
	end
	local hp, hit, inv = Guard.applyDamage(s.hp, r.damage, s.iframes, GC)
	if not hit then
		return false
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	s.stun = GC.stun
	s.noCheckUntil = os.clock() + 1.2
	local root, hum = getRoot(s.player), getHum(s.player)
	if hum then
		hum.PlatformStand = true
	end
	if root then
		local away = (root.Position - g.pos) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, 1)
		root.AssemblyLinearVelocity = away * GC.knockback + Vector3.new(0, 18, 0) -- recul
	end
	notify(s.player, "🐕 " .. r.name .. " t'a mordu : -" .. r.damage .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then
		defeatAtBase(s)
		return true
	end
	-- lot 8A (B.4 « prise par un gardien ») : le gardien qui CHARGE après l'alarme du nid reprend les œufs de SON territoire (ils regagnent leur nid)
	local back = false
	if g.charge == s.player then
		g.charge = nil
		for i = #s.carry, 1, -1 do
			local e = s.carry[i]
			if e.rival and e.terr == g.terr then
				table.remove(s.carry, i)
				returnEgg(e)
				back = true
			end
		end
	end
	if back then
		rebuildCarry(s)
		applySpeed(s)
		sync(s)
		notify(s.player, "↩️ " .. r.name .. " a repris l'œuf : il retourne à son nid.", "caught")
	end
	return true
end

-- Cible la plus proche dans la zone de perception maximale du gardien (seuls les joueurs dont le domaine est ouvert sont ciblables).
local function inPlot(s, root)
	local rel = s.plot.cf:PointToObjectSpace(root.Position)
	return Config.inBase(s.baseLevel or 1, rel.X, rel.Z, rel.Y) -- la plateforme grandit avec le niveau de la maison
end

-- Intrusion dans la base de `host` par `visitor` (D.2) : alarme (niveau 3, notification à l'hôte) et chien de garde (niveau 5, intrus ralenti x0,7 pendant 3 s).
-- Chaque effet a un délai de récupération ; aucun des deux ne bloque le vol (la porte de base et la protection débutant restent les règles de protection).
local function onIntrusion(host, visitor)
	local lv = Config.BASE_LEVELS[host.baseLevel or 1]
	if not lv then
		return
	end
	local now = os.clock()
	if lv.alarm and now - (host.lastAlarm or -99) >= Config.INTRUDER.alarmCooldown then
		host.lastAlarm = now
		notify(host.player, "🔔 Alarme : " .. visitor.player.DisplayName .. " est entré dans ta base !")
	end
	if lv.guardDog and now - (visitor.lastDog or -99) >= Config.INTRUDER.dogCooldown then
		visitor.lastDog = now
		visitor.slowUntil = now + Config.INTRUDER.dogSeconds
		applySpeed(visitor)
		notify(visitor.player, "🐕 Le chien de garde de " .. host.player.DisplayName .. " te ralentit !")
		task.delay(Config.INTRUDER.dogSeconds + 0.1, function()
			if visitor.player.Parent then
				applySpeed(visitor)
			end
		end)
	end
end

-- Zone de sécurité (A.5) : la base du joueur, toute la place du marché et les safeRadius studs autour de l'entrée du territoire du gardien ne sont
-- jamais ciblés.
local PLAZA = Config.Map2.plaza
local function safeSpot(s, root, g)
	if s.plot and inPlot(s, root) then
		return true
	end
	local p = root.Position
	if math.sqrt((p.X - PLAZA.x) ^ 2 + (p.Z - PLAZA.z) ^ 2) < PLAZA.r then
		return true
	end
	local ex, ez = Config.territoryEntry(g.terr)
	return math.sqrt((p.X - ex) ^ 2 + (p.Z - ez) ^ 2) < GC.safeRadius
end

local function candidate(g, r)
	local best, bd = nil, math.max(r.viewDist, r.hearRadius) + 2
	for player, s in pairs(sessions) do
		if Config.zoneUnlocked(s.data.story.ch, g.rival) and alive(player) then
			local root = getRoot(player)
			if root and not safeSpot(s, root, g) then
				local dd = math.sqrt((root.Position.X - g.pos.X) ^ 2 + (root.Position.Z - g.pos.Z) ^ 2)
				if dd < bd then
					best, bd = player, dd
				end
			end
		end
	end
	return best
end

-- Chemin : PathfindingService en tâche de fond (ComputeAsync cède) ; sans résultat, ligne droite (repli). Retourne le point visé.
local PathfindingService = game:GetService("PathfindingService")
local function aimPoint(g, goal, dt)
	g.pathT = (g.pathT or 0) - dt
	if g.pathT <= 0 and not g.pathBusy then
		g.pathT, g.pathBusy = GC.pathInterval, true
		local from = g.pos
		task.spawn(function()
			local ok, wps = pcall(function()
				local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false })
				path:ComputeAsync(from, goal)
				if path.Status ~= Enum.PathStatus.Success then
					return nil
				end
				local out = {}
				for _, w in ipairs(path:GetWaypoints()) do
					out[#out + 1] = w.Position
				end
				return out
			end)
			g.wps = ok and wps or nil
			g.pathBusy = false
		end)
	end
	if g.wps then
		while #g.wps > 0 and ((g.wps[1].X - g.pos.X) ^ 2 + (g.wps[1].Z - g.pos.Z) ^ 2) < 4 do
			table.remove(g.wps, 1)
		end
		if g.wps[1] then
			return Vector3.new(g.wps[1].X, g.pos.Y, g.wps[1].Z)
		end
	end
	return goal
end

local MARKS = { patrol = "", alert = "❓", chase = "❗", lostChase = "❓", ["return"] = "" }

for _, g in ipairs(world.guards) do -- marque d'état au-dessus de chaque gardien (❓ alerte, ❗ poursuite)
	local ok, label = pcall(Builder.sign, g.model.PrimaryPart, "", Color3.fromRGB(255, 230, 90), 7, 80)
	if ok then
		label.TextSize = 34
		g.mark = label
	end
end

-- Réglages de chaque gardien d'après SON territoire (Config.guardStats : vitesses, vue, ouïe, coup de Config.TERR ; Gus = son rival, clément).
for _, g in ipairs(world.guards) do
	g.stats = Config.guardStats(g.terr)
end

local function guardsStep(dt)
	for _, s in pairs(sessions) do -- invulnérabilité et temps depuis le dernier coup
		s.iframes = math.max(0, (s.iframes or 0) - dt)
		s.sinceHit = (s.sinceHit or 99) + dt
	end
	local nowc = os.clock()
	for i = #pendingCharges, 1, -1 do -- alarmes de nid échues (lot 8A) : le gardien du territoire le plus proche du voleur le charge
		local pc = pendingCharges[i]
		if nowc >= pc.at then
			table.remove(pendingCharges, i)
			local ps = sessions[pc.player]
			local proot = ps and alive(pc.player) and getRoot(pc.player)
			if proot then
				local best, bd = nil, math.huge
				for _, g in ipairs(world.guards) do
					if g.terr == pc.terr then
						local d = (Vector3.new(g.pos.X, 0, g.pos.Z) - Vector3.new(proot.Position.X, 0, proot.Position.Z)).Magnitude
						if d < bd then
							best, bd = g, d
						end
					end
				end
				if best and not safeSpot(ps, proot, best) then -- déjà à l'abri (entrée, place, base) : aucune charge
					best.st = Guard.charge(best.st)
					best.target, best.charge, best.wps = pc.player, pc.player, nil
					best.last = Vector3.new(proot.Position.X, best.pos.Y, proot.Position.Z)
					if best.mark then
						best.mark.Text = "❗"
					end
					local key = Config.guardSoundKey(Config.Assets.guardKinds[best.rival])
					for pl in pairs(sessions) do
						local pr = getRoot(pl)
						if pr and (pr.Position - best.pos).Magnitude < 60 then
							notify(pl, "", key)
						end
					end
				end
			end
		end
	end
	for _, g in ipairs(world.guards) do
		local r = g.stats
		local bonus = vigilanceOf(g.terr)
		if bonus ~= g.vigBonus or not g.rv then -- vue et ouïe majorées par la vigilance du territoire (recalculé seulement quand le bonus change)
			g.vigBonus, g.rv = bonus, Guard.boosted(r, bonus)
		end
		local rv = g.rv
		g.cd -= dt
		g.st = g.st or { state = "patrol", timer = 0, lost = 0 }
		g.look = g.look or Vector3.new(g.dir, 0, 0)
		-- perception de la cible (poursuivie ou la plus proche)
		local target = g.target
		local ts = target and sessions[target]
		if not (ts and alive(target) and getRoot(target) and Config.zoneUnlocked(ts.data.story.ch, g.rival)) then
			target, ts = nil, nil
		end
		if not target and (g.st.state == "patrol" or g.st.state == "alert" or g.st.state == "return") then
			g.scan = (g.scan or 0) - dt
			if g.scan <= 0 then
				g.scan = 0.15
				target = candidate(g, rv)
				ts = target and sessions[target]
			else
				target, ts = nil, nil
			end
		end
		local percept = { sees = false, hears = false, dist = math.huge, atHome = false }
		local troot = target and getRoot(target)
		if troot then
			local v = troot.AssemblyLinearVelocity
			local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
			percept = Guard.perceive(
				{ x = g.pos.X, z = g.pos.Z, fx = g.look.X, fz = g.look.Z },
				{ x = troot.Position.X, z = troot.Position.Z, speed = speed },
				rv, GC
			)
			if percept.sees or percept.hears then
				g.last = Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z)
			end
		end
		local home = Vector3.new(math.clamp(g.pos.X, g.cx - g.patrolHalf, g.cx + g.patrolHalf), g.pos.Y, g.patrolZ)
		percept.atHome = (home - g.pos).Magnitude < 1
		local prev = g.st.state
		local ev
		g.st, ev = Guard.nextState(g.st, dt, percept, gcFor(g.rival))
		local state = g.st.state
		if state ~= prev then
			if state == "alert" or state == "chase" then -- aboiement ou grognement pour les joueurs proches (une fois par changement d'état)
				local key = Config.guardSoundKey(Config.Assets.guardKinds[g.rival])
				for pl in pairs(sessions) do
					local pr = getRoot(pl)
					if pr and (pr.Position - g.pos).Magnitude < 60 then
						notify(pl, "", key)
					end
				end
			end
			local mark = g.mark
			if mark then
				mark.Text = MARKS[state] or ""
			end
			if state == "chase" or state == "patrol" or state == "return" then
				g.target = (state == "chase") and target or nil
			end
			if state ~= "chase" then
				g.charge = nil -- l'alarme du nid s'arrête avec la poursuite
			end
			if state == "chase" then
				g.target = target or g.target
			elseif state == "return" or state == "patrol" then
				g.target = nil
				g.wps = nil
			end
		end
		local look = nil
		local prevPos = g.pos
		local want = false -- le gardien DEVRAIT-il avancer ? (sert à la détection de blocage)
		if state == "patrol" then
			want = true
			g.pos += Vector3.new(g.dir * r.patrolSpeed * dt, 0, 0)
			if g.pos.X > g.cx + g.patrolHalf then
				g.dir = -1
			elseif g.pos.X < g.cx - g.patrolHalf then
				g.dir = 1
			end
			look = Vector3.new(g.dir, 0, 0)
		elseif state == "alert" then
			local to = g.last and (g.last - g.pos) or g.look -- s'arrête et se tourne vers le bruit ou la dernière position vue
			look = Vector3.new(to.X, 0, to.Z)
		elseif state == "chase" or state == "lostChase" then
			local goal = (state == "chase" and troot) and Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z) or g.last
			if goal then
				local aim = aimPoint(g, goal, dt)
				local dv = Vector3.new(aim.X - g.pos.X, 0, aim.Z - g.pos.Z)
				want = (goal - g.pos).Magnitude > GC.attackRange
				if dv.Magnitude > 0.01 then
					look = dv.Unit
					g.pos += look * math.min(dv.Magnitude, r.guardSpeed * dt)
				end
				local flat = Vector3.new(goal.X - g.pos.X, 0, goal.Z - g.pos.Z)
				if state == "chase" and ts and flat.Magnitude < GC.attackRange and g.cd <= 0 and troot ~= nil and not safeSpot(ts, troot, g) then -- jamais de coup dans la zone sûre (A.5, comme la simulation)
					if hitPlayer(ts, g) then
						g.cd = GC.attackCd
					end
				end
			end
		else -- retour
			local dv = home - g.pos
			want = dv.Magnitude >= 1
			if dv.Magnitude >= 1 then
				look = dv.Unit
				g.pos += look * math.min(dv.Magnitude, r.patrolSpeed * 1.6 * dt)
			end
		end
		-- le gardien reste dans le disque de SON territoire (Config.TERR), même en poursuite
		do
			local nx, nz = Guard.clampToDisc(g.pos.X, g.pos.Z, g.tx, g.tz, g.clampR)
			g.pos = Vector3.new(nx, g.pos.Y, nz)
		end
		-- blocage : devrait bouger mais n'avance pas depuis plus de 4 s -> retour doux à son poste, état remis à zéro
		g.stuck = g.stuck or { t = 0 }
		local moved = (g.pos - prevPos).Magnitude
		if Guard.stuckStep(g.stuck, dt, moved, want, GC) then
			g.pos = Vector3.new(g.cx, g.pos.Y, g.patrolZ)
			g.wps, g.target, g.last = nil, nil, nil
			g.st = { state = "patrol", timer = 0, lost = 0 }
			g.stuckFixes = (g.stuckFixes or 0) + 1
			pcall(function()
				g.model:SetAttribute("StuckFixes", g.stuckFixes)
			end)
			look = Vector3.new(g.dir, 0, 0)
		end
		if look and look.Magnitude > 0.01 then
			g.look = look.Unit
		end
		-- orientation vers la marche + animation procédurale (rebond et roulis en marchant, respiration à l'arrêt)
		g.speedNow = (g.speedNow or 0) * 0.8 + (moved / math.max(dt, 1e-3)) * 0.2
		local by, roll = Guard.walkPose(os.clock(), g.speedNow)
		g.model:PivotTo(CFrame.lookAt(g.pos + Vector3.new(0, by, 0), g.pos + Vector3.new(0, by, 0) + g.look) * CFrame.Angles(0, 0, roll))
	end
end

---------------------------------------------------------------- Pièges des territoires (lot 4) : fils à clochettes, boue, herse, dalles d'alarme, lanternes
-- Traps (pur) décide, ce code applique : alarme = les gardiens du territoire foncent vers l'endroit (état « perte de cible » = ils vont à la dernière
-- position connue puis reprennent leur poste, et repèrent le joueur s'il y est toujours) ; boue = vitesse x0,6 (applySpeed) ; herse = Part animée à 10 Hz.
local trapsWorld = world.traps or { layouts = {}, lights = {}, plates = {} }
local ALARM_TEXT = { bell = "🔔 Un fil à clochettes a sonné : les gardiens accourent !", plate = "🚨 Dalle d'alarme : les gardiens accourent !", light = "🔦 Une lanterne t'a repéré : les gardiens accourent !" }

local function alarmGuards(terr, x, z)
	for _, g in ipairs(world.guards) do
		if g.terr == terr and g.st and g.st.state ~= "chase" then
			g.st = { state = "lostChase", timer = 0, lost = 0 }
			g.last = Vector3.new(x, g.pos.Y, z)
			g.target, g.wps = nil, nil
			if g.mark then
				g.mark.Text = "❗"
			end
		end
	end
end

local function trapsStep(_dt)
	local now = os.clock()
	for player, s in pairs(sessions) do
		local root = getRoot(player)
		if root and alive(player) then
			local px, pz = root.Position.X, root.Position.Z
			for key, L in pairs(trapsWorld.layouts) do
				local ps = s.traps[key]
				if (px - L.cx) ^ 2 + (pz - L.cz) ^ 2 <= (L.r + 8) ^ 2 then
					if not ps then
						ps = Traps.newPlayerState()
						s.traps[key] = ps
					end
					for _, ev in ipairs(Traps.playerStep(ps, L, Config.TRAPS, now, px, pz)) do
						if ev.kind == "mud" then
							applySpeed(s)
							notify(player, "🟤 De la boue ! Tu es ralenti.")
						else
							alarmGuards(key, px, pz)
							notify(player, ALARM_TEXT[ev.kind] or "🔔", "caught")
							if ev.kind == "plate" then
								for _, pl in ipairs(trapsWorld.plates) do
									if pl.key == key and pl.index == ev.index then
										pl.part.Color = Color3.fromRGB(255, 220, 90)
										task.delay(0.8, function()
											pl.part.Color = Color3.fromRGB(150, 60, 60)
										end)
									end
								end
							end
						end
					end
				elseif ps then
					s.traps[key] = nil
					applySpeed(s)
				end
			end
		end
	end
	for _, ln in ipairs(trapsWorld.lights) do -- lanternes : le faisceau tourne (0,5 tour/s)
		local l = ln.light
		local a = Traps.lanternAngle(now, l)
		local dx, dz = math.cos(a), math.sin(a)
		local mid = Vector3.new(l.x + dx * l.range / 2, ln.y, l.z + dz * l.range / 2)
		ln.part.CFrame = CFrame.lookAt(mid, mid + Vector3.new(dx, 0, dz))
	end
	local gt = trapsWorld.gate
	local gl = trapsWorld.layouts.zed
	if gt and gl and gl.gate then -- herse de la cour de Zed : cycle 3 s ouverte / 3 s fermée, solide quand elle est descendue
		local lift = Traps.gateLift(now, gl.gate, Config.TRAPS.gateWindow)
		if lift ~= gt.lift then
			gt.lift = lift
			gt.part.CFrame = gt.baseCF + Vector3.new(0, -5.5 + 8.5 * lift, 0)
		end
		local solid = Traps.gateSolid(now, gl.gate, Config.TRAPS.gateWindow)
		if gt.solid ~= solid then
			gt.solid = solid
			gt.part.CanCollide = solid
		end
	end
end

---------------------------------------------------------------- Mode Château : salles à pièges, chrono, coffre final, classement des temps
local serverMode = "arena" -- « castle » si le premier joueur arrive du hub avec TeleportData.mode == "castle"
local castleWorld = world.castle

local function castleTeleport(s, room, depth)
	local root = getRoot(s.player)
	if root then
		local wx, wz = Castle.toWorld(room, 0, depth or 3)
		root.CFrame = CFrame.new(wx, 4, wz)
		root.AssemblyLinearVelocity = Vector3.zero
		s.noCheckUntil = os.clock() + 2
	end
end

function castleEnter(s)
	s.castle = { deaths = 0, maxRoom = 1, t0 = nil, finished = false }
	castleTeleport(s, 1, -4)
	notify(s.player, "🏰 Le Château : traverse 5 salles à pièges (pics, lames, boulets, portes). Le chrono démarre à la première salle. Coffre final : œuf rare !", "event")
end

-- Donne un œuf dans un emplacement libre (protégé quelques secondes) ; base pleine : l'équivalent de la moitié du prix en pièces. Retourne true si l'œuf est placé.
local function giveEgg(s, tier)
	local d = s.data
	local i = freeSlot(s)
	if not i then
		d.coins += Config.eggCoinValue(tier) * 0.5
		return false
	end
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s) }
	refreshPad(s, i)
	return true
end

local function castleDamage(s, kind, room)
	local dmg = Config.CASTLE.damage[kind] or 20
	local hp, hit, inv = Guard.applyDamage(s.hp, dmg, s.iframes, GC)
	if not hit then
		return
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	local label = kind == "spikes" and "des pics" or (kind == "blade" and "une lame" or (kind == "knight" and "un chevalier" or "un boulet"))
	notify(s.player, "💥 Touché par " .. label .. " : -" .. dmg .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then -- défaite : retour au début de la salle, pv rétablis (jamais de perte d'œuf)
		local rootNow = getRoot(s.player)
		if rootNow and Config.purchasable(Config.PRODUCTS.Revive) then -- offre « Relancer maintenant » (produit payant, non bloquante)
			s.revive = { pos = rootNow.Position, room = room, expires = os.clock() + Config.REVIVE.offerSeconds }
			s.player:SetAttribute("ReviveUntil", os.time() + Config.REVIVE.offerSeconds)
		end
		s.castle.deaths += 1
		setHp(s, GC.maxHp)
		s.iframes = GC.respawnIframes
		castleTeleport(s, room, 3)
		notify(s.player, "🏰 Tu retentes la salle " .. room .. " (" .. s.castle.deaths .. " défaite(s)).", "caught")
	end
end

local castleBoardTimer = 0
local function castleBoardRefresh()
	task.spawn(function()
		local top = Data.castleTop(Config.CASTLE.boardSize)
		if castleWorld and castleWorld.board then
			local lines = { "🏰 Meilleurs temps" }
			for i, e in ipairs(top) do
				lines[#lines + 1] = i .. ". " .. e.name .. "  " .. Castle.formatTime(e.time)
			end
			if #top == 0 then
				lines[#lines + 1] = "(aucun pour l'instant)"
			end
			castleWorld.board.Text = table.concat(lines, "\n")
		end
	end)
end

local function castleStep(dt)
	Builder.animProps(os.clock())
	if not castleWorld then
		return
	end
	local T = os.clock()
	-- animation des pièges (positions répliquées 10 fois par seconde)
	for r, rec in ipairs(castleWorld.rooms) do
		local room = Castle.room(r)
		for i, sp in ipairs(Castle.spikes(room)) do
			local v = rec.spikes[i]
			local state = Castle.spikeState(T, sp, room)
			if state == "warning" and v.lastState ~= "warning" then
				rec.newWarn = true
			end
			v.lastState = state
			local tipY = state == "danger" and 0.9 or (state == "warning" and 0.05 or -1)
			v.tip.Position = Vector3.new(v.wx, tipY, v.wz)
			Builder.animSpike(v, tipY, state)
			v.tip.Color = state == "danger" and Color3.fromRGB(255, 90, 90) or (state == "warning" and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(210, 214, 222))
		end
		for i, bl in ipairs(Castle.blades(room)) do
			local v = rec.blades[i]
			local angle = Castle.bladeAngle(T, bl, room)
			v.arm.CFrame = CFrame.new(v.wx, 1.4, v.wz) * CFrame.Angles(0, angle, 0)
			Builder.animBlade(v, angle)
		end
		for i, ba in ipairs(Castle.balls(room)) do
			local v = rec.balls[i]
			local bx = Castle.ballX(T, ba, room)
			local bp = bx and Vector3.new(Castle.ORIGIN.x + bx, ba.radius, v.wz) or Vector3.new(Castle.ORIGIN.x, -10, v.wz)
			v.part.Position = bp
			Builder.animBall(v, bp.X, bp.Y, bp.Z)
		end
		if rec.newWarn then -- pics qui sortent : un son par salle (au plus toutes les 0,8 s) pour les joueurs de la salle
			rec.newWarn = false
			if T - (rec.lastSpikeSfx or -9) > 0.8 then
				rec.lastSpikeSfx = T
				for pl, ps in pairs(sessions) do
					local pr = ps.castle and getRoot(pl)
					if pr and Castle.roomAt(pr.Position.X, pr.Position.Z) == r then
						notify(pl, "", "spikes")
					end
				end
			end
		end
		for i, kn in ipairs(Castle.knights(room)) do
			local v = rec.knights[i]
			local kx, dir = Castle.knightPos(T, kn)
			v.part.Position = Vector3.new(Castle.ORIGIN.x + kx, 3, v.wz)
			Builder.animKnight(v, Castle.ORIGIN.x + kx, v.wz, dir, 4 * kn.amp / kn.period)
		end
		local open = Castle.doorIsOpen(T, room)
		rec.door.Position = Vector3.new(rec.doorX, open and 14 or rec.doorClosedY, rec.doorZ)
		rec.door.CanCollide = not open
		Builder.animDoor(rec, open)
	end
	-- joueurs dans le donjon : chrono, touches
	for player, s in pairs(sessions) do
		local root = getRoot(player)
		if s.castle and root and alive(player) and not s.castle.finished then
			local r, lx, lz = Castle.roomAt(root.Position.X, root.Position.Z)
			if r then
				s.castle.maxRoom = math.max(s.castle.maxRoom, r)
				if r == 1 and lz > 2 and not s.castle.t0 then
					s.castle.t0 = T
					notify(player, "⏱ Chrono lancé !")
				end
				local kind = Castle.hit(T, Castle.room(r), lx, lz)
				if kind then
					castleDamage(s, kind, r)
				end
			end
		end
	end
	castleBoardTimer += dt
	if castleBoardTimer >= Config.CASTLE.boardSeconds then
		castleBoardTimer = 0
		castleBoardRefresh()
	end
end
task.defer(castleBoardRefresh)

function castleFinish(s, root, prompt)
	local c = s.castle
	local holder = prompt.Parent
	if not (c and c.t0 and not c.finished and holder and (root.Position - holder.Position).Magnitude <= 18) then
		return
	end
	if c.maxRoom < Castle.ROOMS then
		return notify(s.player, "Il faut traverser les " .. Castle.ROOMS .. " salles avant d'ouvrir le coffre.")
	end
	c.finished = true
	notify(s.player, "", "fanfare")
	Builder.openChest()
	local seconds = os.clock() - c.t0
	local reward = Castle.reward(seconds, income(s), c.deaths)
	s.data.coins += reward.coins
	local placed = giveEgg(s, reward.eggTier)
	qp(s, "castle", 1)
	Data.castleSubmit(s.player, seconds)
	notify(s.player, "🏆 Château terminé en " .. Castle.formatTime(seconds) .. " (" .. c.deaths .. " défaite(s)) : +" .. Config.fmt(reward.coins) .. " 🪙 et un œuf " .. Config.TIERS[reward.eggTier].name .. (placed and " dans ta base !" or " (base pleine : converti en pièces)."), "claim")
	sync(s)
	task.delay(4, function()
		if s.player.Parent and sessions[s.player] == s then
			s.castle = nil
			local root2 = getRoot(s.player)
			if root2 and s.plot then
				root2.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			end
			castleBoardRefresh()
		end
	end)
end

---------------------------------------------------------------- Événements serveur
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "EventTint"
tint.Parent = Lighting
local evTimer = rng:NextNumber(25, 40)

local function setEvent(cfg, seconds)
	if cfg then
		currentEvent = { cfg = cfg, ends = os.time() + (type(seconds) == "number" and seconds or Config.EVENT_DURATION) } -- seconds : événement offert plus long (énigme, lot 6)
		workspace:SetAttribute("EventKey", cfg.key)
		workspace:SetAttribute("EventEnds", currentEvent.ends)
		tint.TintColor = cfg.tint
		for _, p in ipairs(Players:GetPlayers()) do
			notify(p, cfg.emoji .. " " .. cfg.name .. " ! " .. cfg.desc, "event")
		end
	else
		currentEvent = nil
		workspace:SetAttribute("EventKey", nil)
		workspace:SetAttribute("EventEnds", nil)
		tint.TintColor = Color3.new(1, 1, 1)
	end
	for _, s in pairs(sessions) do
		sync(s)
	end
end

local function eventStep(dt)
	if currentEvent then
		if os.time() >= currentEvent.ends then
			setEvent(nil)
			evTimer = rng:NextNumber(Config.EVENT_GAP[1], Config.EVENT_GAP[2])
		end
	else
		evTimer -= dt
		if evTimer <= 0 then
			setEvent(Config.EVENTS[rng:NextInteger(1, #Config.EVENTS)])
		end
	end
end

-- Énigme de la Mère Poule (lot 6) : construite ici car elle déclenche l'événement « Pluie de chance » (setEvent) ; le gestionnaire de prompts la lit via `Hen`.
Hen = HenQuest.new({
	Config = Config, Riddle = Riddle, Builder = Builder, world = world, sessions = sessions, RHen = RHen,
	notify = notify, sync = sync, getRoot = getRoot, freeSlot = freeSlot, hatchTime = hatchTime, shieldTime = shieldTime, refreshPad = refreshPad,
	income = income, story = sp, setEvent = setEvent,
	onSolved = function(s)
		tele.log(s.player, "puzzle_solved")
	end,
})

---------------------------------------------------------------- Boucles de jeu
local function fastTick(dt)
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			local root = getRoot(player)
			local hum = getHum(player)
			if s.stun > 0 then
				s.stun -= dt
				if s.stun <= 0 and hum then
					hum.PlatformStand = false
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
			if not (root and hum and hum.Health > 0) then
				return
			end
			-- piste d'entraînement (ancien tapis roulant) : il faut courir dessus
			if s.stun <= 0 and world.treadmillContains(root.Position) and hum.MoveDirection.Magnitude > 0.1 then
				local rate = 0.8 * (1 + 0.35 * d.up.tm) * (evKey() == "run" and 3 or 1)
				d.speed += rate * dt
				qp(s, "train", dt)
				sp(s, "train", dt)
			end
			applySpeed(s)
			-- contrôle de vitesse : si le joueur parcourt bien plus que sa vitesse autorisée, on le remet en place
			local pos = root.Position
			if s.lastPos and s.stun <= 0 and os.clock() > s.noCheckUntil then
				local moved = Vector3.new(pos.X - s.lastPos.X, 0, pos.Z - s.lastPos.Z).Magnitude
				local allowed = (Config.walkSpeed(d.speed) * speedMul(s) + 16) * dt * 1.4 + 3
				if moved > allowed then
					s.flags += 1
					if s.flags >= 3 then
						root.CFrame = CFrame.new(s.lastPos) * root.CFrame.Rotation
						s.flags = 0
						warn("[AntiCheat] " .. player.Name .. " remis en place (vitesse anormale)")
						pos = s.lastPos
					end
				else
					s.flags = 0
				end
			end
			if s.lastPos and (pos - s.lastPos).Magnitude > 0.3 then
				s.lastActive = os.clock() -- déplacement = joueur actif
			end
			s.lastPos = pos
			-- intrusion : un autre joueur entre dans la base d'un hôte (alarme au niveau 3, chien de garde au niveau 5)
			do
				local host = nil
				for _, o in pairs(sessions) do
					if o ~= s and o.plot then
						local rel = o.plot.cf:PointToObjectSpace(pos)
						if Config.inBase(o.baseLevel or 1, rel.X, rel.Z, rel.Y) then
							host = o
							break
						end
					end
				end
				if host ~= s.intruderIn then
					s.intruderIn = host
					if host then
						onIntrusion(host, s)
					end
				end
			end
			-- dépôt des œufs dans sa base
			if #s.carry > 0 and inPlot(s, root) then
				local i = freeSlot(s)
				if not i then
					if os.clock() - s.lastFull > 4 then
						s.lastFull = os.clock()
						notify(player, "Base pleine ! Vends un pet ou agrandis-la.")
					end
				else
					local e = table.remove(s.carry, 1)
					d.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(s), rv = (e.rv == true or (e.belt == true and e.paid == 0)) or nil, rvAt = e.rvAt } -- lot 7b : un œuf gratuit (bienvenue) ou volé par corbeau reste non indemnisable
					refreshPad(s, i)
					Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 2, 0), Config.TIERS[e.t].color, 12, false)
					rebuildCarry(s)
					applySpeed(s)
					sync(s)
				end
			end
			-- fraîcheur : un œuf Légendaire+ pris chez Zed refroidit s'il n'atteint pas la base à temps -> il regagne son nid
			if #s.carry > 0 then
				local nowc, cooled, soonest = os.clock(), false, 0
				for i = #s.carry, 1, -1 do
					local e = s.carry[i]
					if Traps.expired(e, nowc) then
						table.remove(s.carry, i)
						returnEgg(e)
						cooled = true
					elseif e.fresh then
						soonest = (soonest == 0) and (e.fresh - nowc) or math.min(soonest, e.fresh - nowc)
					end
				end
				if cooled then
					notify(player, "🧊 L'œuf a refroidi et regagne son nid")
					rebuildCarry(s)
					applySpeed(s)
					sync(s)
				end
				player:SetAttribute("FreshLeft", math.ceil(soonest))
			elseif player:GetAttribute("FreshLeft") ~= 0 then
				player:SetAttribute("FreshLeft", 0)
			end
			-- porte de base : fin de la fermeture
			if s.doorPart and os.clock() >= (s.lockUntil or 0) then
				setDoorBarrier(s, false)
			end
		end)
		if not ok then
			warn("[fastTick] " .. tostring(err))
		end
	end
end

local function petLabel(s, sl)
	local def = Config.PETS[sl.p]
	return string.format("%s %s\n+%s/s", def.emoji, Config.petName(sl.p, sl.s, sl.m), Config.fmt(Config.petIncome(sl.p, sl.s, sl.m) * gmult(s)))
end

local function slowTick(dt)
	eventStep(dt)
	tele.step()
	for _, n in ipairs(world.nests) do
		if not n.egg then
			n.rt -= dt
			if n.rt <= 0 then
				setNestEgg(n, wpick(Config.foldWeights(n.weights or Config.RIVALS[n.rival].weights)))
			end
		end
	end
	local now = os.time()
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			d.played += dt -- temps de jeu cumulé (secondes, sauvegardé) : protection débutant
			refreshNewbie(s)
			Lot7.Cal.tick(s)
			local inc = income(s)
			local active = os.clock() - s.lastActive <= Config.IDLE.seconds
			if (player:GetAttribute("Idle") == true) == active then
				player:SetAttribute("Idle", not active) -- le client affiche « 💤 revenus en pause »
			end
			if active then
				d.coins += inc * dt
				qp(s, "earn", inc * dt)
			end
			Lot7.privStep(s, dt, active) -- tapis privé : un œuf gratuit toutes les 120 s d'activité
			ensureQuests(s)
			storyRefresh(s)
			s.syncT += dt
			if s.syncT >= 10 then
				s.syncT = 0
				RState:FireClient(player, snapshot(s))
			end
			for i = 1, cap(s) do
				local sl = d.slots[i]
				if sl and sl.k == "e" then
					if now >= sl.ends then
						hatch(s, i)
					else
						local lbl = s.labels[i]
						if lbl then
							local txt = "🥚 " .. Config.fmtTime(sl.ends - now) .. ((sl.shield or 0) > now and "  🛡" or "")
							if lbl.Text ~= txt then
								lbl.Text = txt
							end
						end
					end
				elseif sl and sl.k == "p" then
					local lbl = s.labels[i]
					if lbl then
						local txt = petLabel(s, sl)
						if lbl.Text ~= txt then
							lbl.Text = txt
						end
					end
				end
			end
			-- régénération des pv (rapide dans la base, lente ailleurs après un délai sans coup)
			if s.hp < GC.maxHp then
				local root = getRoot(player)
				local atBase = root ~= nil and s.plot ~= nil and (root.Position - s.plot.spawn.Position).Magnitude < 40
				local newHp = Guard.regen(s.hp, s.sinceHit, dt, atBase, GC)
				if newHp ~= s.hp then
					setHp(s, newHp)
				end
			end
			pushStats(s)
		end)
		if not ok then
			warn("[slowTick] " .. tostring(err))
		end
	end
end

local acc1, acc2, acc3, acc4 = 0, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	guardsStep(dt)
	acc4 += dt
	if acc4 >= 0.1 then
		local d4 = acc4
		acc4 = 0
		local okT, errT = pcall(trapsStep, d4)
		if not okT then
			warn("[traps] " .. tostring(errT))
		end
	end
	acc3 += dt
	if acc3 >= Config.CASTLE.step then
		local d3 = acc3
		acc3 = 0
		castleStep(d3)
	end
	acc2 += dt
	if acc2 >= 0.25 then
		local d2 = acc2
		acc2 = 0
		fastTick(d2)
	end
	acc1 += dt
	if acc1 >= 1 then
		local d1 = acc1
		acc1 = 0
		slowTick(d1)
	end
end)

---------------------------------------------------------------- Tapis roulant central (lot 3 de la refonte)
-- Le serveur fait tout : Belt.step à 10 Hz (apparitions et sorties), un œuf visible par œuf du tapis (rareté et prix lisibles AVANT l'achat), un prompt
-- par œuf, achat par réservation atomique (Belt.tryBuy) après validation de la distance, des pièces et du sac. L'œuf acheté passe dans les bras du joueur
-- (s.carry, comme un œuf chipé) et doit être rapporté à la base. Tout œuf visuel est détruit à sa sortie (bac) ou à son achat : aucun objet ne fuit.
local BC = Config.BELT
local beltSt = Belt.new(rng:NextInteger(1, 2147483000), os.clock() + 2)
local beltFolder = Instance.new("Folder")
beltFolder.Name = "BeltEggs"
beltFolder.Parent = workspace
local beltEggs = {} -- [id] = { egg = œuf logique (Belt), part, prompt }
local beltPanelAt, beltPanelKey = 0, ""
local BELT_Y = 3.0 -- hauteur du centre d'un œuf posé sur le tapis
local BELT_REACH = 14 -- distance serveur maximale joueur -> œuf (le prompt s'active à 10 ; marge pour la latence et le défilement)

local function beltRemoveVisual(id)
	local v = beltEggs[id]
	if v then
		beltEggs[id] = nil
		if v.egg.forUser and not v.egg.claimedBy then
			local op = Players:GetPlayerByUserId(v.egg.forUser)
			local os_ = op and sessions[op]
			if os_ and os_.welcome == "offered" then
				os_.welcome = "gone" -- l'œuf de bienvenue est tombé dans le bac sans être pris
				sync(os_)
			end
		end
		if v.part then
			v.part:Destroy() -- détruit aussi le prompt, l'étiquette, la lumière et le halo
		end
	end
end

local function beltAnnounce(tier)
	local t = Config.TIERS[tier]
	for _, p in ipairs(Players:GetPlayers()) do
		notify(p, "✨ Un œuf " .. t.name .. " arrive sur le tapis du marché !", Config.hatchSoundKey(tier, false))
	end
end

local function beltAddVisual(egg, ownerName)
	local t = Config.TIERS[egg.tier]
	local part = Builder.egg(egg.tier, true)
	local x = Belt.positionX(Config, egg, os.clock()) or Config.Map2.belt.x0
	part.CFrame = CFrame.new(x, BELT_Y, Config.Map2.belt.z)
	part:SetAttribute("EggId", egg.id)
	part:SetAttribute("Tier", egg.tier)
	part:SetAttribute("Price", egg.price)
	if egg.forUser then
		part:SetAttribute("ForUser", egg.forUser)
	end
	CollectionService:AddTag(part, "EggShake")
	local rare = Config.tierAtLeast(egg.tier, "announce")
	if rare then
		CollectionService:AddTag(part, "BeltRare") -- annonce visuelle côté client
	end
	local pr = Instance.new("ProximityPrompt")
	if egg.forUser then
		pr.ActionText = "Prendre (gratuit)"
		pr.ObjectText = "Œuf de bienvenue"
	else
		pr.ActionText = "Acheter 🪙 " .. Config.fmt(egg.price)
		pr.ObjectText = "Œuf " .. t.name
	end
	pr.HoldDuration = 0.3
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr.Enabled = not rare -- Légendaire et plus : le prompt s'active après Config.BELT.legendaryDelay (voir beltStep)
	pr:SetAttribute("EggId", egg.id)
	if egg.forUser then
		pr:SetAttribute("ForUser", egg.forUser)
	end
	pr.Parent = part
	CollectionService:AddTag(pr, "BeltEgg")
	local label
	if egg.forUser then
		label = "🎁 Œuf de bienvenue de " .. tostring(ownerName or "?") .. "\nGratuit"
	else
		label = t.name .. "\n🪙 " .. Config.fmt(egg.price)
	end
	Builder.sign(part, label, t.color, 3, 200)
	part.Parent = beltFolder
	beltEggs[egg.id] = { egg = egg, part = part, prompt = pr }
	if rare then
		beltAnnounce(egg.tier)
	end
end

local function beltPanelUpdate(now)
	local b = world.belt
	if not b then
		return
	end
	local info = Belt.panel(Config, beltSt, now)
	local key = info.active .. "|" .. info.status
	if key == beltPanelKey then
		return
	end
	beltPanelKey = key
	local mark = "▶ "
	b.panel.normal.Text = (info.active == "normal" and mark or "") .. "Standard : " .. info.normal
	b.panel.golden.Text = (info.active == "golden" and mark or "") .. "Doré : " .. info.golden
	b.panel.normal.TextColor3 = info.active == "normal" and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(190, 190, 205)
	b.panel.golden.TextColor3 = info.active == "golden" and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(190, 190, 205)
	b.panel.status.Text = info.status
end

local function beltStep()
	local now = os.clock()
	local spawned, removed = Belt.step(Config, beltSt, now)
	for _, e in ipairs(removed) do
		beltRemoveVisual(e.id)
	end
	for _, e in ipairs(spawned) do
		local owner = e.forUser and Players:GetPlayerByUserId(e.forUser)
		beltAddVisual(e, owner and owner.DisplayName)
	end
	local alive_ = {}
	for _, e in ipairs(beltSt.eggs) do
		alive_[e.id] = true
	end
	local stale = {}
	for id in pairs(beltEggs) do
		if not alive_[id] then
			stale[#stale + 1] = id -- vendu, parti ou jamais revu dans la liste du tapis : plus aucun objet orphelin
		end
	end
	for _, id in ipairs(stale) do
		beltRemoveVisual(id)
	end
	for _, e in ipairs(beltSt.eggs) do
		local v = beltEggs[e.id]
		if v then
			local x = Belt.positionX(Config, e, now)
			if x then
				v.part.CFrame = CFrame.new(x, BELT_Y, Config.Map2.belt.z)
			end
			if not v.prompt.Enabled and now - e.born >= BC.legendaryDelay then
				v.prompt.Enabled = true
			end
		end
	end
	if now - beltPanelAt >= 1 then
		beltPanelAt = now
		beltPanelUpdate(now)
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(beltStep)
		if not ok then
			warn("[belt] " .. tostring(err))
		end
	end
end)

-- Action serveur INTERNE : ajoute des secondes de tapis doré (cumulables, plafonnées). Le produit Robux la branchera plus tard (lot 7) ; aucun ProcessReceipt ici.
local function goldenBeltAdd(seconds, byName)
	local left = Belt.addGolden(Config, beltSt, os.clock(), seconds, byName)
	beltPanelKey = ""
	return left
end
Builder.beltHooks = { goldenAdd = goldenBeltAdd, stats = function() -- crochet interne (tests, lot 7) : jamais exposé aux clients
	local n = 0
	for _ in pairs(beltEggs) do
		n += 1
	end
	return { eggs = #beltSt.eggs, visuals = n, children = #beltFolder:GetChildren(), sold = beltSt.sold, goldenLeft = Belt.goldenLeft(beltSt, os.clock()) }
end }

-- Œuf de bienvenue : une fois par joueur, 20 s après l'arrivée, si hatched < 5 ; gratuit, étiqueté à son nom, achetable par lui seul.
local function beltWelcome(player, s)
	for _ = 1, 8 do
		if not (player.Parent and sessions[player] == s) then
			return
		end
		local egg = Belt.welcome(Config, beltSt, player.UserId, s.data.hatched, os.clock())
		if egg then
			s.welcome = "offered"
			beltAddVisual(egg, player.DisplayName)
			notify(player, "🎁 Un œuf de bienvenue t'attend sur le tapis du marché : il est gratuit, et il est à toi !", "event")
			sync(s)
			return
		end
		if s.data.hatched >= BC.welcome.maxHatched or beltSt.welcomed[player.UserId] then
			s.welcome = "none"
			sync(s)
			return
		end
		task.wait(1.5) -- tapis plein : on réessaie
	end
	s.welcome = "none"
end

local BELT_MSG = {
	late = "Trop tard ! Quelqu'un a pris cet œuf.",
	gone = "Trop tard ! Cet œuf n'est plus sur le tapis.",
	cooldown = "Attends un peu avant d'acheter un autre œuf.",
	wait = "Attends un instant : cet œuf rare vient d'arriver.",
	reserved = "Cet œuf de bienvenue est réservé à un autre joueur.",
	legendaryLimit = "Un seul œuf Légendaire ou plus par minute et par joueur.",
}

function beltBuy(player, prompt)
	local s, root = sessions[player], getRoot(player)
	if not s or not root or not alive(player) or s.stun > 0 then
		return
	end
	local now = os.clock()
	if now - (s.lastBeltTry or -10) < 0.25 then
		return -- anti-rafale
	end
	s.lastBeltTry = now
	local id = prompt:GetAttribute("EggId")
	local v = type(id) == "number" and beltEggs[id] or nil
	if not v or prompt.Parent ~= v.part then
		notify(player, BELT_MSG.late, "refuse") -- l'œuf a déjà été pris (ou est tombé dans le bac) pendant que la demande voyageait
		return
	end
	if (root.Position - v.part.CFrame.Position).Magnitude > BELT_REACH then
		return
	end
	if #s.carry >= carryCap(s.data) then
		notify(player, "Sac plein ! Rapporte tes œufs à ta base.")
		return
	end
	local ok, res = Belt.tryBuy(Config, beltSt, player.UserId, id, s.data.coins, now)
	if not ok then
		if res == "poor" then
			notify(player, "Pas assez de pièces : il te faut " .. Config.fmt(v.egg.price) .. " 🪙.", "refuse")
		else
			notify(player, BELT_MSG[res] or "Achat impossible.", "refuse")
		end
		return
	end
	local egg = res
	s.data.coins -= egg.price
	beltRemoveVisual(egg.id)
	Builder.burst(v.part.CFrame.Position, Config.TIERS[egg.tier].color, 10, false)
	s.carry[#s.carry + 1] = { t = egg.tier, rem = hatchTime(s, egg.tier), belt = true, paid = egg.price }
	if egg.forUser then
		s.welcome = "taken"
	end
	afterTake(s, "🥚 Œuf " .. Config.TIERS[egg.tier].name .. (egg.price > 0 and (" acheté (-" .. Config.fmt(egg.price) .. " 🪙)") or " pris") .. " ! Porte-le vite dans ta base.", egg.price > 0 and "buy" or "claim")
end

---------------------------------------------------------------- Actions du client
local actions = {}

-- Retour au hub : la progression est sauvegardée d'abord ; si la téléportation échoue, le joueur reste en jeu avec un message clair.
function actions.toHub(s)
	local now = os.clock()
	if s.leaving or now - (s.toHubAt or -100) < 15 then
		return
	end
	if Config.Game.roleFor(game.PlaceId) ~= "game" then
		return notify(s.player, "Le hub n'est pas disponible depuis ce lieu.")
	end
	s.toHubAt = now
	if not s.noSave then
		Data.save(s.player, s.data)
	end
	local res = Party.returnToHub(Config, {
		teleport = function(players, placeId, _, data)
			local opts = Instance.new("TeleportOptions")
			opts:SetTeleportData(data)
			TeleportService:TeleportAsync(placeId, players, opts)
		end,
		log = warn,
	}, s.player, serverPartyId)
	if res.ok then
		notify(s.player, "🏠 Retour au hub…")
	else
		notify(s.player, "⚠️ " .. res.message)
	end
end

-- Porte de base : ferme la base pendant Config.lockSeconds(niveau) secondes (aucun vol d'emplacement), puis recharge Config.DOOR.cooldown secondes.
function actions.lockDoor(s)
	local now = os.clock()
	if (s.lockUntil or 0) > now then
		return
	end
	if (s.lockReadyAt or 0) > now then
		notify(s.player, "🔒 La porte se recharge : encore " .. math.ceil(s.lockReadyAt - now) .. " s.")
		return
	end
	local dur = Config.lockSeconds(s.baseLevel or 1)
	s.lockUntil = now + dur
	s.lockReadyAt = s.lockUntil + Config.DOOR.cooldown
	local okT, server = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if not okT or type(server) ~= "number" then
		server = os.time()
	end
	s.player:SetAttribute("DoorUntil", server + dur)
	s.player:SetAttribute("DoorReady", server + dur + Config.DOOR.cooldown)
	setDoorBarrier(s, true)
	notify(s.player, "🔒 Porte fermée pendant " .. dur .. " s : personne ne peut voler tes œufs.")
end

-- Fin anticipée de la protection débutant (« Je suis prêt pour le PvP »).
function actions.newbieOff(s)
	if isNewbie(s) then
		s.data.newbieOff = true
		refreshNewbie(s)
		sync(s)
	end
end

function actions.sync(s)
	sync(s)
end

function actions.buyEgg(s, tier)
	if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > #Config.TIERS then
		return
	end
	if not Config.tierLive(tier) then -- lot 9 : rareté sans espèce publiée (Peu commun tant que le lot 11 n'est pas livré)
		return notify(s.player, "🥚 Les œufs " .. Config.TIERS[tier].name .. " arrivent bientôt !", "refuse")
	end
	if tier > Config.SHOP_MAX_TIER then -- lot 8A (B.3) : Mythique et Cosmique seulement au tapis du marché
		return notify(s.player, "🎪 Les œufs " .. Config.TIERS[tier].name .. " ne se trouvent qu'au tapis du marché !", "refuse")
	end
	local d = s.data
	local price = Config.EGG_PRICE[tier]
	if d.coins < price then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	local i = freeSlot(s)
	if not i then
		return notify(s.player, "Base pleine !")
	end
	d.coins -= price
	tele.economy(s.player, price, d.coins, "egg_r" .. tier) -- lot 9 : pièces dépensées en œufs
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s) }
	refreshPad(s, i)
	notify(s.player, "", "buy")
	sync(s)
end

function actions.buyUp(s, key)
	local u = type(key) == "string" and Config.upgrade(key)
	if not u then
		return
	end
	local d = s.data
	local l = d.up[key]
	if l >= u.max then
		return
	end
	local cost = u.cost(l)
	if d.coins < cost then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	d.coins -= cost
	notify(s.player, "", "buy")
	d.up[key] = l + 1
	if key == "slots" then
		refreshAllPads(s)
	end
	sync(s)
end

function actions.sell(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	s.data.coins += Config.sellValue(sl.p, sl.s, sl.m)
	s.data.slots[i] = false
	qp(s, "sell", 1)
	refreshPad(s, i)
	rebuildFollowers(s)
	sync(s)
end

-- Revend un œuf d'un emplacement (25 % du prix). Validé côté serveur : emplacement existant, contient un œuf.
function actions.sellEgg(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	s.data.coins += Config.eggSellValue(sl.t)
	s.data.slots[i] = false
	refreshPad(s, i)
	qp(s, "sell", 1)
	sync(s)
end

-- Revend les doublons de pets (garde le meilleur de chaque espèce). Les pets revendus quittent la liste de ceux qui suivent le joueur.
function actions.sellDupes(s)
	local d = s.data
	local list, total = Config.dupesToSell(d.slots, cap(s))
	if #list == 0 then
		return notify(s.player, "Aucun doublon à revendre.")
	end
	for _, i in ipairs(list) do
		d.slots[i] = false
		refreshPad(s, i)
		for n = #d.equip, 1, -1 do
			if d.equip[n] == i then
				table.remove(d.equip, n)
			end
		end
		qp(s, "sell", 1)
	end
	d.coins += total
	rebuildFollowers(s)
	notify(s.player, "⭐ " .. #list .. " doublon(s) échangé(s) : +" .. Config.fmt(total) .. " 🪙", "claim")
	sync(s)
end

-- Dialogue de la Mère Poule (lot 6) : boutons « J'y vais ! », « Explique encore », « 💡 Un coup de bec », « 🔁 Réécouter » (intentions seulement).
function actions.henGo(s)
	return Hen and Hen.go(s)
end
function actions.henExplain(s)
	return Hen and Hen.explain(s)
end
function actions.henHint(s)
	return Hen and Hen.hint(s)
end
function actions.henReplay(s)
	return Hen and Hen.replay(s)
end

function actions.rebirth(s)
	local d = s.data
	if d.coins < Config.rebirthCost(d.rb) then
		return notify(s.player, "Pas assez de pièces pour renaître.", "refuse")
	end
	local fresh = Data.default()
	fresh.speed, fresh.rb, fresh.dex = d.speed, d.rb + 1, d.dex
	fresh.daily, fresh.streak, fresh.stolen, fresh.hatched = d.daily, d.streak, d.stolen, d.hatched
	fresh.quests, fresh.qday, fresh.receipts, fresh.luckUntil = d.quests, d.qday, d.receipts, d.luckUntil
	fresh.story, fresh.pity = d.story, d.pity
	fresh.battle = d.battle -- le meilleur étage de la tour survit à la renaissance (l'équipe est revalidée à chaque combat)
	fresh.puzzle, fresh.ach = d.puzzle, d.ach
	fresh.cine = d.cine
	fresh.secrets = d.secrets
	fresh.baseLevelFloor, fresh.tokens, fresh.settings = d.baseLevelFloor, d.tokens, d.settings -- le niveau de maison, les jetons et les réglages survivent aussi
	fresh.raven, fresh.stealLog, fresh.pb = d.raven, d.stealLog, d.pb -- plafond du jour, boucliers, journal et œufs du tapis privé survivent aussi (lot 7)
	fresh.starter, fresh.baseScore = d.starter, d.baseScore -- l'achat unique du pack de départ et la progression de la base survivent à la renaissance
	dropCarry(s)
	s.data = fresh
	refreshAllPads(s)
	rebuildFollowers(s)
	storyRefresh(s)
	sync(s)
	notify(s.player, string.format("🌅 Renaissance ! Revenus x%.1f", 1 + 0.5 * fresh.rb), "claim")
end

function actions.equip(s, i)
	if not validSlot(i) then
		return
	end
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	local at
	for n, v in ipairs(d.equip) do
		if v == i then
			at = n
		end
	end
	if at then
		table.remove(d.equip, at)
	else
		if #d.equip >= Config.MAX_FOLLOWERS then
			return notify(s.player, "Maximum " .. Config.MAX_FOLLOWERS .. " pets qui te suivent.")
		end
		d.equip[#d.equip + 1] = i
	end
	rebuildFollowers(s)
	sync(s)
end

function actions.claimQuest(s, i)
	local q = type(i) == "number" and s.data.quests[i]
	if not q or q.claimed or q.prog < q.goal then
		return
	end
	q.claimed = true
	Lot7.Calendar.addQuest(Config, s.data.cal) -- lot 9b : une mission réclamée compte pour le rattrapage « 3 missions » du calendrier
	tele.log(s.player, "daily_quest_completed")
	s.data.coins += q.rew
	local extra = ""
	if (q.re or 0) > 0 and Config.TIERS[q.re] then
		extra = extra .. (giveEgg(s, q.re) and (" + œuf " .. Config.TIERS[q.re].name) or " (base pleine : œuf converti en pièces)")
	end
	if (q.rb or 0) > 0 then
		s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + q.rb
		extra = extra .. " + boost de chance"
	end
	notify(s.player, "🎯 Mission accomplie : +" .. Config.fmt(q.rew) .. " 🪙" .. extra, "claim")
	sync(s)
end

function actions.claimStory(s)
	local st = s.data.story
	local c = chapter(s)
	if not c or st.prog < c.goal then
		return
	end
	local rankBefore = Config.rankFor(st.ch).name
	local reward = Config.storyReward(c, income(s))
	s.data.coins += reward
	st.ch += 1
	st.prog = 0
	updateSign(s)
	notify(s.player, "📜 « " .. c.title .. " » accompli : +" .. Config.fmt(reward) .. " 🪙", "claim")
	local nextChapter = chapter(s)
	if nextChapter then
		notify(s.player, "📖 Chapitre " .. (st.ch + 1) .. " : " .. nextChapter.title .. " (Missions > Histoire)")
	else
		notify(s.player, "👑 Histoire terminée : tu es Roi des Couvées !", "event")
	end
	for _, z in ipairs(Config.ZONES) do
		if z.chapter > 0 and z.chapter == st.ch then
			notify(s.player, "🔓 " .. z.name .. " est ouvert ! Ses œufs sont plus rares.", "event")
		end
	end
	local rank = Config.rankFor(st.ch)
	if rank.name ~= rankBefore then
		notify(s.player, "🎖 Nouveau rang : " .. rank.emoji .. " " .. rank.name .. " !", "event")
	end
	storyRefresh(s) -- le chapitre suivant peut être déjà accompli (espèces déjà découvertes...)
	sync(s)
end

-- Mémorise qu'une cinématique a été vue (ou passée) : elle ne se rejouera pas à la prochaine connexion.
function actions.cineSeen(s, id)
	if type(id) ~= "string" then
		return
	end
	for _, known in ipairs(Config.CINE_IDS) do
		if known == id then
			if not s.data.cine[id] then
				s.data.cine[id] = true
				sync(s)
			end
			return
		end
	end
end

function actions.claimAch(s, id)
	local a = type(id) == "string" and Config.achievement(id)
	if not a then
		return
	end
	local d = s.data
	local tier = d.ach[a.id] or 0
	if tier >= #a.goals then
		return
	end
	local value = statValues(s)[a.stat]
	if not value or value < a.goals[tier + 1] then
		return
	end
	local reward = Config.achReward(tier + 1, income(s))
	d.ach[a.id] = tier + 1
	d.coins += reward
	notify(s.player, "🏅 Succès « " .. a.name .. " » (palier " .. (tier + 1) .. ") : +" .. Config.fmt(reward) .. " 🪙", "claim")
	sync(s)
end

local topCache = {}
function actions.top(s)
	RTop:FireClient(s.player, topCache)
end

function actions.claimAway(s)
	local gain = math.floor(s.data.pendingAway)
	if gain < 1 then
		return
	end
	s.data.pendingAway = 0
	s.data.coins += gain
	notify(s.player, "💰 Gains récupérés : +" .. Config.fmt(gain) .. " 🪙", "claim")
	RState:FireClient(s.player, snapshot(s))
end

function actions.daily(s)
	local d = s.data
	local today = os.time() // 86400
	if d.daily == today then
		return notify(s.player, "Bonus déjà récupéré aujourd'hui !")
	end
	local streak = (d.daily == today - 1) and d.streak + 1 or 1
	local reward = math.floor(math.max(200, income(s) * 600) * math.min(streak, 7) * (s.passes.VipBase == true and Config.VIP_DAILY_MUL or 1))
	d.daily, d.streak = today, streak
	d.coins += reward
	notify(s.player, "🎁 Bonus quotidien : +" .. Config.fmt(reward) .. " 🪙 (série " .. streak .. ")", "claim")
	sync(s)
end

---------------------------------------------------------------- Lot 9b : calendrier des œufs sur 30 jours
-- Le serveur possède tout : jour UTC (os.time() // 86400), éligibilité, ressources de rattrapage, tirage du jour 30, œuf placé. Le client n'envoie que { day, how }.
-- Une réclamation : verrou s.calBusy (aucune seconde réclamation pendant la sauvegarde), validation (Calendar.check), jour MARQUÉ dans le profil, sauvegarde réussie,
-- ENFIN octroi. Sauvegarde échouée = jour démarqué, rien n'est donné. Mort du serveur entre la sauvegarde et l'octroi : récompense perdue (jamais doublée), limite documentée.
do
	local Calendar, CalSys, CAL = Lot7.Calendar, Lot7.Cal, Config.CALENDAR
	local function age(player)
		local ok, a = pcall(function()
			return player.AccountAge
		end)
		return (ok and type(a) == "number" and a == a) and a or 0
	end
	local function eligible(s)
		return Calendar.eligible(Config, age(s.player), s.data.played)
	end
	local function today()
		return os.time() // 86400
	end
	local refusal = {
		ineligible = "📅 Le calendrier n'est pas encore débloqué pour toi.", day = "📅 Jour invalide.", notStarted = "📅 Le calendrier n'a pas encore commencé.",
		future = "📅 Ce jour n'est pas encore arrivé : reviens à la date prévue !", claimed = "📅 Récompense déjà réclamée.", monthCap = "📅 Les 30 récompenses du cycle sont déjà réclamées.",
		dayCap = "📅 Reviens demain : une seule réclamation de rattrapage par jour.", how = "📅 Choisis comment rattraper ce jour.",
		noResource = "📅 Il te manque de quoi rattraper ce jour (jour de grâce, 3 missions ou un rattrapage).",
	}
	-- Vue du calendrier pour le client : normalise le cycle (renouvelé après 30 jours) ; ne démarre jamais un cycle (voir CalSys.tick).
	function CalSys.snapshot(s)
		local d = s.data
		Calendar.normalize(Config, d.cal, today())
		local ok, why = eligible(s)
		local v = Calendar.view(Config, d.cal, today(), ok, why)
		v.scrolls, v.plumes, v.ftokens = d.scrolls, d.plumes, d.fightTokens
		v.cosm, v.titles = d.cosm, { cal10 = d.titles.cal10 == true, cal25 = d.titles.cal25 == true, cal30 = d.titles.cal30 == true }
		v.playLeft = math.max(0, math.ceil(CAL.minPlayMinutes - d.played / 60))
		v.last = d.calLast
		return v
	end
	-- Une fois par seconde et par joueur (slowTick) : démarre le cycle d'un joueur devenu éligible, renouvelle un cycle fini, prévient d'une récompense disponible.
	function CalSys.tick(s)
		local d = s.data
		local day = today()
		local changed = false
		if d.cal.start == 0 then
			if eligible(s) and Calendar.begin(Config, d.cal, day) then
				changed = true
				notify(s.player, "📅 Calendrier des œufs débloqué ! Ouvre Bonus > Calendrier : un œuf Légendaire t'attend au jour 3.", "claim")
			end
		elseif Calendar.normalize(Config, d.cal, day) then
			changed = true
			notify(s.player, "📅 Nouveau cycle de 30 jours : la récompense du jour 1 t'attend.", "claim")
		end
		if changed or s.calSeenDay ~= day then
			s.calSeenDay = day
			sync(s)
		end
	end
	local function applyReward(s, plan)
		local d = s.data
		local bits = {}
		if plan.coins > 0 then
			d.coins += plan.coins
			bits[#bits + 1] = "🪙 " .. Config.fmt(plan.coins)
		end
		if plan.egg then
			local placed = giveEgg(s, plan.egg)
			bits[#bits + 1] = "🥚 Œuf " .. Config.TIERS[plan.egg].name .. (placed and "" or " (base pleine : converti en pièces)")
		end
		if plan.scrolls > 0 then
			d.scrolls = math.min(CAL.caps.scrolls, d.scrolls + plan.scrolls)
			bits[#bits + 1] = "📜 +" .. plan.scrolls
		end
		if plan.plumes > 0 then
			d.plumes = math.min(CAL.caps.plumes, d.plumes + plan.plumes)
			bits[#bits + 1] = "🪶 +" .. plan.plumes
		end
		if plan.tokens > 0 then
			d.fightTokens = math.min(CAL.caps.tokens, d.fightTokens + plan.tokens)
			bits[#bits + 1] = "⚔️ +" .. plan.tokens
		end
		if plan.cosm and CAL.cosmetics[plan.cosm] then
			d.cosm[plan.cosm] = true
			bits[#bits + 1] = CAL.cosmetics[plan.cosm].emoji .. " " .. CAL.cosmetics[plan.cosm].name
		end
		if plan.title and CAL.titles[plan.title] then
			d.titles[plan.title] = true
			bits[#bits + 1] = "🏷 " .. CAL.titles[plan.title].name
		end
		return table.concat(bits, " · ")
	end
	function CalSys.claim(s, day, how)
		local d = s.data
		local cal = d.cal
		if s.leaving or s.calBusy ~= true then
			return
		end
		if how ~= "grace" and how ~= "quest" and how ~= "paid" then
			how = "today"
		end
		-- un rattrapage PAYANT d'un jour au tirage aléatoire (jour 30) : seulement si PolicyService a confirmé « non restreint » (rien n'est débité ici : le jeton est déjà acheté)
		if how == "paid" and type(day) == "number" and Calendar.isRandom(Config, day) and Lot7.awaitPolicy(s) then
			notify(s.player, "📅 Ce rattrapage n'est pas disponible pour ton compte.")
			return
		end
		if s.leaving or sessions[s.player] ~= s then
			return
		end
		local now = today()
		local okE, why = eligible(s)
		if okE and cal.start == 0 then
			Calendar.begin(Config, cal, now)
		end
		Calendar.normalize(Config, cal, now)
		local ok, code = Calendar.check(Config, cal, now, day, how, okE)
		if not ok then
			if code == "ineligible" then
				notify(s.player, why == "age" and ("📅 Il faut un compte Roblox d'au moins " .. CAL.minAccountAgeDays .. " jour pour le calendrier.") or ("📅 Encore " .. math.max(1, math.ceil(CAL.minPlayMinutes - d.played / 60)) .. " min de jeu avant de débloquer le calendrier."))
			else
				notify(s.player, refusal[code] or refusal.day)
			end
			sync(s)
			return
		end
		local plan = Calendar.plan(Config, day, rng:NextNumber(), income(s))
		if plan.egg and not freeSlot(s) then
			notify(s.player, "📅 Libère un emplacement dans ta base : un œuf t'attend (rien n'est perdu).")
			return
		end
		-- 1. jour marqué dans le profil (état d'avant gardé pour l'annuler), 2. sauvegarde, 3. octroi
		local before = { days = cal.days, grace = cal.grace, catch = cal.catch, qc = cal.qc, dayD = cal.dayD, dayN = cal.dayN, streak = d.calStreak, last = d.calLast }
		local streak = Calendar.apply(Config, cal, now, day, how)
		d.calStreak, d.calLast = streak, now
		if not s.noSave and not Data.save(s.player, d, false) then
			cal.days, cal.grace, cal.catch, cal.qc, cal.dayD, cal.dayN = before.days, before.grace, before.catch, before.qc, before.dayD, before.dayN
			d.calStreak, d.calLast = before.streak, before.last
			notify(s.player, "📅 Sauvegarde impossible pour l'instant : réessaie dans un moment (rien n'a été perdu).")
			sync(s)
			return
		end
		local text = applyReward(s, plan)
		notify(s.player, "📅 Jour " .. day .. (how == "today" and "" or " rattrapé") .. " : " .. text, "claim")
		tele.log(s.player, "calendar_claim_day", day, how == "today" and "_today" or nil)
		if how ~= "today" then
			tele.log(s.player, "calendar_catchup", day, "_" .. how)
		end
		tele.log(s.player, "calendar_streak", streak)
		if Calendar.claimedCount(cal) >= CAL.days then
			tele.log(s.player, "calendar_cycle_complete", cal.cycle)
		end
		sync(s)
		if not s.noSave then -- l'octroi est sauvegardé tout de suite (au mieux) : la sauvegarde automatique le reprendrait sinon dans la minute
			task.spawn(function()
				Data.save(s.player, d, s.leaving == true)
			end)
		end
	end
end

function actions.calClaim(s, arg)
	if type(arg) ~= "table" or s.calBusy then
		return
	end
	s.calBusy = true
	local ok, err = pcall(Lot7.Cal.claim, s, arg.day, arg.how)
	s.calBusy = nil
	if not ok then
		warn("[Calendrier] " .. tostring(err))
	end
end

RAction.OnServerEvent:Connect(function(player, action, arg)
	local s = sessions[player]
	if not s or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - s.lastAct < 0.08 then
		return
	end
	s.lastAct = now
	s.lastActive = now -- toute action = joueur actif
	local fn = actions[action]
	if fn then
		local ok, err = pcall(fn, s, arg)
		if not ok then
			warn("[Action " .. action .. "] " .. tostring(err))
		end
	end
end)

---------------------------------------------------------------- Arène des pets (PvE : tour des Dresseurs)
-- Le serveur possède tout : l'équipe est relue dans le profil à chaque combat, la graine est tirée ici, le client n'envoie qu'une intention par tour
-- (« attack », « skill », « swap1 » à « swap3 ») et rejoue les événements reçus. Récompense versée UNE fois (s.battle est vidé avant le paiement).
local Battle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Battle"))
local TW = Config.TOWER

local function battleDay(s)
	local day = os.time() // 86400
	local b = s.data.battle
	if b.day ~= day then
		b.day, b.fights, b.repeats = day, 0, 0
	end
	return b
end

local function battleUnits(s)
	local units = {}
	for _, idx in ipairs(s.data.battle.team) do
		local sl = validSlot(idx) and s.data.slots[idx]
		if sl and sl.k == "p" then
			units[#units + 1] = Battle.unit(Config, sl)
		end
	end
	return units
end

function actions.setTeam(s, arg)
	if s.battle or type(arg) ~= "table" then
		return
	end
	local team, seen = {}, {}
	for i = 1, TW.teamSize do
		local v = arg[i]
		if type(v) == "number" and v == v and v % 1 == 0 and validSlot(v) and not seen[v] then
			local sl = s.data.slots[v]
			if sl and sl.k == "p" then
				seen[v] = true
				team[#team + 1] = v
			end
		end
	end
	s.data.battle.team = team
	RState:FireClient(s.player, snapshot(s))
end

-- PvP : saison en cours, remise à zéro douce des trophées et récompense de la saison écoulée (une seule fois, selon le palier atteint).
local function pvpState(s)
	local pv = s.data.battle.pvp
	local season = Config.pvpSeason(os.time())
	if pv.season ~= season then
		local rw = pv.season > 0 and Config.pvpSeasonReward(pv.trophies) or nil
		if rw then
			s.data.coins += rw.coins
			giveEgg(s, rw.eggTier)
			if rw.potion then
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
			end
			notify(s.player, "🏆 Fin de saison PvP : " .. pv.trophies .. " trophées -> +" .. Config.fmt(rw.coins) .. " 🪙 et un œuf " .. Config.TIERS[rw.eggTier].name .. (rw.potion and " + potion de chance" or ""), "claim")
		end
		pv.season, pv.trophies, pv.wins, pv.losses = season, math.floor(pv.trophies / 4), 0, 0
	end
	local day = os.time() // 86400
	if pv.day ~= day then
		pv.day, pv.fights = day, 0
	end
	return pv
end

local function pvpPublishAsync(s)
	local pv = s.data.battle.pvp
	local team, season, trophies, player = {}, pv.season, pv.trophies, s.player
	for _, e in ipairs(pv.defense) do
		team[#team + 1] = { p = e.p, s = e.s, m = e.m }
	end
	if #team > 0 then
		task.spawn(function()
			pcall(Data.pvpPublish, player, team, trophies, season)
		end)
	end
end

local function battleFinish(s)
	local bt = s.battle
	s.battle = nil -- vidé AVANT tout paiement : aucune double récompense possible
	local st, win = bt.st, bt.st.winner == 1
	local b = s.data.battle
	local rewards = {}
	if bt.pvp then
		local pv = pvpState(s)
		if win then
			local gain = Config.pvpGain(pv.trophies, bt.pvp.trophies)
			pv.trophies, pv.wins = pv.trophies + gain, pv.wins + 1
			rewards.trophies = gain
		else
			local loss = math.min(pv.trophies, Config.PVP.loss)
			pv.trophies, pv.losses = pv.trophies - loss, pv.losses + 1
			rewards.trophies = -loss
		end
		rewards.total = pv.trophies
		pvpPublishAsync(s)
		RBattle:FireClient(s.player, { k = "end", win = win, rewards = rewards, best = b.best, floor = 0, pvp = true, foe = bt.pvp.name, view = Battle.view(st) })
		RState:FireClient(s.player, snapshot(s))
		return
	end
	if win then
		local first = bt.floor > b.best
		if first then
			b.best = bt.floor
			tele.log(s.player, "tower_floor_reached", bt.floor)
		end
		if first or b.repeats < TW.dailyRepeats then
			local rw = Config.towerReward(bt.floor, income(s), first)
			if not first then
				b.repeats += 1
			end
			s.data.coins += rw.coins
			rewards.coins = rw.coins
			if rw.eggTier and rw.eggTier > 0 then
				giveEgg(s, rw.eggTier)
				rewards.egg = rw.eggTier
			end
			if rw.potion then
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
				rewards.potion = true
			end
			rewards.first = first
		else
			rewards.limited = true
		end
	end
	RBattle:FireClient(s.player, { k = "end", win = win, rewards = rewards, best = b.best, floor = bt.floor, view = Battle.view(st) })
	RState:FireClient(s.player, snapshot(s))
end

local function battleStep(s, act)
	local bt = s.battle
	if not bt or bt.st.over then
		return
	end
	local events = Battle.turn(bt.st, act)
	bt.deadline = os.clock() + TW.turnSeconds
	if bt.st.over then
		RBattle:FireClient(s.player, { k = "turn", events = events, view = Battle.view(bt.st) })
		battleFinish(s)
	else
		RBattle:FireClient(s.player, { k = "turn", events = events, view = Battle.view(bt.st), seconds = TW.turnSeconds })
	end
end

function actions.pvpDefense(s)
	if s.battle then
		return
	end
	local pv = pvpState(s)
	local def = {}
	for _, idx in ipairs(s.data.battle.team) do
		local sl = validSlot(idx) and s.data.slots[idx]
		if sl and sl.k == "p" then
			def[#def + 1] = { p = sl.p, s = sl.s, m = sl.m }
		end
	end
	if #def == 0 then
		notify(s.player, "🛡 Choisis d'abord une équipe de pets.", "refuse")
		return
	end
	pv.defense = def
	pvpPublishAsync(s)
	notify(s.player, "🛡 Équipe de défense enregistrée (" .. #def .. " pet" .. (#def > 1 and "s" or "") .. "). Les autres joueurs peuvent l'affronter.", "buy")
	RState:FireClient(s.player, snapshot(s))
end

function actions.pvpStart(s)
	if s.battle or s.castle or s.pvpPending then
		return
	end
	local pv = pvpState(s)
	if #pv.defense == 0 then
		notify(s.player, "🛡 Enregistre d'abord ton équipe de défense pour entrer au classement.", "refuse")
		return
	end
	if pv.fights >= Config.PVP.dailyFights then
		notify(s.player, "🏆 Limite de combats classés atteinte pour aujourd'hui (" .. Config.PVP.dailyFights .. ").", "refuse")
		return
	end
	local mine = battleUnits(s)
	if #mine == 0 then
		notify(s.player, "⚔️ Compose d'abord une équipe de pets.", "refuse")
		return
	end
	s.pvpPending = true -- la recherche d'adversaire attend le DataStore : un seul départ à la fois
	local player = s.player
	task.spawn(function()
		local okOpp, opp = pcall(Data.pvpOpponent, player.UserId, pv.trophies, pv.season, rng:NextInteger(0, 4))
		s.pvpPending = nil
		if not (okOpp and sessions[player] == s) or s.battle then
			return
		end
		if not opp then -- aucun autre joueur classé : adversaire fantôme de la tour, au niveau des trophées
			local floor = math.min(Config.TOWER.floors, 1 + pv.trophies // 40)
			local ghost = {}
			for _, u in ipairs(Battle.towerTeam(Config, floor)) do
				ghost[#ghost + 1] = { p = u.p, s = u.s, m = u.m }
			end
			opp = { name = "Dresseur fantôme", team = ghost, trophies = pv.trophies }
		end
		local foes = {}
		for _, e in ipairs(opp.team) do
			foes[#foes + 1] = Battle.unit(Config, e)
		end
		pv.fights += 1
		s.battle = { st = Battle.new(rng:NextInteger(1, 2147483000), battleUnits(s), foes), floor = 0, pvp = { name = opp.name, trophies = opp.trophies }, deadline = os.clock() + TW.turnSeconds }
		RBattle:FireClient(player, { k = "start", floor = 0, foe = "🏆 " .. opp.name, pvp = true, view = Battle.view(s.battle.st), seconds = TW.turnSeconds })
	end)
end

function actions.towerStart(s, floor)
	if s.battle or s.castle or type(floor) ~= "number" or floor ~= floor or floor % 1 ~= 0 then
		return
	end
	local b = battleDay(s)
	if floor < 1 or floor > TW.floors or floor > b.best + 1 then
		notify(s.player, "🔒 Étage verrouillé : bats d'abord l'étage " .. (b.best + 1) .. ".", "refuse")
		return
	end
	if b.fights >= TW.dailyFights then
		notify(s.player, "⚔️ Limite de combats atteinte pour aujourd'hui (" .. TW.dailyFights .. "). Reviens demain !", "refuse")
		return
	end
	local mine = battleUnits(s)
	if #mine == 0 then
		notify(s.player, "⚔️ Compose d'abord une équipe de pets (1 à " .. TW.teamSize .. ").", "refuse")
		return
	end
	b.fights += 1
	local seed = rng:NextInteger(1, 2147483000)
	s.battle = { st = Battle.new(seed, mine, Battle.towerTeam(Config, floor)), floor = floor, deadline = os.clock() + TW.turnSeconds }
	RBattle:FireClient(s.player, { k = "start", floor = floor, foe = Config.towerFoeName(floor), view = Battle.view(s.battle.st), seconds = TW.turnSeconds })
end

function actions.battleAct(s, arg)
	local bt = s.battle
	if not bt or type(arg) ~= "string" then
		return
	end
	local act
	if arg == "attack" or arg == "skill" then
		act = { kind = arg }
	else
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			act = { kind = "swap", to = n }
		end
	end
	if not act or Battle.validate(bt.st, 1, act) then
		notify(s.player, "⚔️ Action impossible.", "refuse")
		return
	end
	battleStep(s, act)
end

function actions.battleQuit(s)
	if s.battle then
		s.battle.st.over, s.battle.st.winner = true, 2 -- abandon = défaite (le combat compte dans la limite du jour)
		battleFinish(s)
	end
end

task.spawn(function() -- tour limité à 10 s : action par défaut (attaque)
	while true do
		task.wait(1)
		for _, s in pairs(sessions) do
			local bt = s.battle
			if bt and os.clock() > bt.deadline then
				pcall(battleStep, s, { kind = "attack" })
			end
		end
	end
end)

function actions.ravenList(s)
	return Lot7.ravenList(s)
end
function actions.ravenGo(s, arg)
	return Lot7.ravenGo(s, arg)
end
function actions.setBlockRavens(s, v)
	return Lot7.setBlockRavens(s, v)
end

---------------------------------------------------------------- Lot 7 : Corbeau chipeur, tapis privé, bonus serveur, PolicyService
-- Tout est décidé ICI, par le serveur : le client n'envoie que des intentions (ravenList, ravenGo { u, i }, setBlockRavens), jamais un contexte. Les règles pures sont dans
-- Raven.lua (canLaunch, settle, compensation...), testées une par une ; ce bloc construit les contextes d'après les sessions et applique les décisions.
do
	local RV = Config.REMOTE_STEAL
	local flights = {} -- [Player voleur] = vol en cours (un seul par voleur)
	local bySlot = {} -- [Player victime] = { [emplacement] = vol } : un seul corbeau par œuf
	local ravensFolder = Instance.new("Folder")
	ravensFolder.Name = "Ravens"
	ravensFolder.Parent = workspace

	local MSG = {
		invalid = "🐦‍⬛ Cible invalide.", self = "🐦‍⬛ Tu ne peux pas viser ta propre base.", noToken = "🐦‍⬛ Tu n'as plus de jeton de corbeau (Bonus > Corbeau chipeur).",
		alreadyFlying = "🐦‍⬛ Ton corbeau est déjà en vol.", dailyLimit = "🐦‍⬛ Limite atteinte : " .. RV.dailyMax .. " vols à distance réussis par jour.",
		castle = "🐦‍⬛ Pas de corbeau dans le mode Château.", newbie = "🐣 Protection débutant : pas de corbeau pour toi, ni contre toi.",
		tooYoung = "🐦‍⬛ Le corbeau demande " .. RV.minPlayMinutes .. " min de jeu à toi et " .. RV.victimMinMinutes .. " min à ta cible.",
		accountAge = "🐦‍⬛ Le corbeau demande un compte Roblox de " .. RV.minAccountAgeDays .. " jours au moins, pour toi comme pour ta cible.", recentlyStolen = "🛡 Cet œuf vient d'être volé par un corbeau : il est protégé un moment.", noSlot = "🐦‍⬛ Libère un emplacement dans ta base d'abord.",
		levelGap = "🐦‍⬛ Cette base est trop petite pour ton corbeau.", victimShield = "🛡 Cette base est protégée pour l'instant.", victimCooldown = "🛡 Cette base a déjà reçu un corbeau récemment.",
		grace = "🛡 Ce joueur vient d'arriver : ses œufs sont protégés.", friendBlocked = "🐦‍⬛ Ce joueur refuse les corbeaux de ses amis.", notEgg = "🐦‍⬛ Il faut un œuf en incubation.",
		tier = "🐦‍⬛ Cet œuf est trop rare pour un corbeau.", eggShield = "🛡 Cet œuf est encore protégé.", tooLate = "🐦‍⬛ Cet œuf éclôt trop bientôt.",
		targeted = "🐦‍⬛ Un corbeau vise déjà cet œuf.", gone = "🐦‍⬛ Joueur ou œuf introuvable.", busy = "🐦‍⬛ Patiente un instant.", cooldown = "🐦‍⬛ Ton corbeau se repose : encore quelques secondes.",
	}

	local function inCastleMode(s)
		return s.castle ~= nil or serverMode == "castle"
	end
	local function rollDaily(d)
		d.raven.day, d.raven.n = Raven.rollDaily(d.raven.day, d.raven.n, os.time())
	end
	function Lot7.ravenLeft(s) -- vols à distance restants aujourd'hui (sans modifier le profil)
		local _, n = Raven.rollDaily(s.data.raven.day, s.data.raven.n, os.time())
		return math.max(0, RV.dailyMax - n)
	end
	function Lot7.serverBuffs()
		return { golden = math.floor(Belt.goldenLeft(beltSt, os.clock())), luck = math.max(0, math.floor(Lot7.luckUntil - os.time())), luckBy = Lot7.luckBy, goldenBy = beltSt.goldenBy }
	end

	-- Journal serveur : print + DataStore RavenLog (en arrière-plan, jamais bloquant). File BORNÉE (Config.REMOTE_STEAL.logQueueMax : au-delà, la plus ancienne entrée est jetée avec un
	-- avertissement) vidée par UN seul travailleur, par lots de logBatch entrées ; Data.logRavenBatch réessaie un nombre borné de fois, un lot définitivement échoué est abandonné (journal
	-- de secours : les warn/print serveur). Un DataStore lent ou en panne ne peut donc ni bloquer le jeu ni faire grossir la mémoire.
	local logQueue, logWorker = {}, false
	Lot7.logDropped = 0
	function Lot7.logPending()
		return #logQueue + (logWorker and 1 or 0)
	end
	local function pumpLog()
		if logWorker then
			return
		end
		logWorker = true
		task.spawn(function()
			while #logQueue > 0 do
				local batch = {}
				while #logQueue > 0 and #batch < RV.logBatch do
					batch[#batch + 1] = table.remove(logQueue, 1)
				end
				local ok, res = pcall(Data.logRavenBatch, batch)
				if not (ok and res) then
					Lot7.logDropped += #batch
					warn("[Raven] journal : lot de " .. #batch .. " entrée(s) abandonné après essais (" .. tostring(ok and res or res) .. ")")
				end
			end
			logWorker = false
		end)
	end
	function Lot7.logEnqueue(entry)
		if #logQueue >= RV.logQueueMax then
			table.remove(logQueue, 1)
			Lot7.logDropped += 1
			warn("[Raven] journal : file pleine (" .. RV.logQueueMax .. "), entrée la plus ancienne jetée")
		end
		logQueue[#logQueue + 1] = entry
		pumpLog()
	end
	local function logEvent(f, result)
		print(string.format("[Raven] %s (%d) -> %s (%d) : œuf %s, résultat %s", f.thiefName, f.thiefId, f.victimName, f.victimId, Config.TIERS[f.tier].name, result))
		Lot7.logEnqueue({ thief = f.thiefId, thiefName = f.thiefName, victim = f.victimId, victimName = f.victimName, tier = f.tier, result = result, at = os.time() })
	end

	-- Amitié (appel réseau, avec cache de 5 min par session). Échec = considéré ami : le refus de la victime est respecté (repli prudent).
	local function friendsWith(s, other)
		s.friendCache = s.friendCache or {}
		local c = s.friendCache[other.UserId]
		if c and os.clock() - c.t < 300 then
			return c.v
		end
		local ok, res = pcall(function()
			return s.player:IsFriendsWith(other.UserId)
		end)
		local v = (not ok) or res == true
		s.friendCache[other.UserId] = { v = v, t = os.clock() }
		return v
	end

	-- Ancienneté du compte en jours : valeur d'origine incertaine (propriété Roblox) -> nombre ou 0 (refusé).
	local function ageDays(player)
		local ok, a = pcall(function()
			return player.AccountAge
		end)
		return (ok and type(a) == "number" and a == a) and a or 0
	end
	-- CONTEXTES de Raven.canLaunch : construits ICI d'après les sessions (aucun champ ne vient du client).
	local function thiefCtx(s)
		rollDaily(s.data)
		return { userId = s.player.UserId, tokens = s.data.tokens.remoteSteal, level = s.baseLevel or 1, playMinutes = s.data.played / 60, freeSlot = freeSlot(s) ~= nil,
			dailyDone = s.data.raven.n, flying = flights[s.player] ~= nil, newbie = isNewbie(s), inCastle = inCastleMode(s), accountAgeDays = ageDays(s.player) }
	end
	local function victimCtx(vs, friend)
		return { userId = vs.player.UserId, level = vs.baseLevel or 1, playMinutes = vs.data.played / 60, newbie = isNewbie(vs), inCastle = inCastleMode(vs), graceUntil = vs.graceUntil or 0,
			shieldUntil = vs.data.raven.sh, ravenCooldownUntil = vs.data.raven.cd, friendOfThief = friend == true, blockFriendRavens = vs.data.settings.blockFriendRavens == true, accountAgeDays = ageDays(vs.player) }
	end
	local function eggCtx(vs, i)
		local sl = vs.data.slots[i]
		if i > cap(vs) or type(sl) ~= "table" or sl.k ~= "e" then
			return nil
		end
		return { tier = sl.t, incubating = true, eggShieldUntil = sl.shield or 0, endsAt = sl.ends, rvAt = type(sl.rvAt) == "number" and sl.rvAt or nil }
	end

	function Lot7.addLog(vs, name, tier, kind)
		Raven.logPush(vs.data.stealLog, { n = string.sub(tostring(name), 1, 24), t = tier, at = os.time(), k = kind }, RV.logMax)
	end
	-- Vol PHYSIQUE subi : journal et bouclier post-vol de 5 min (il protège contre les corbeaux ; le vol physique garde ses propres règles).
	function Lot7.onPhysicalSteal(vs, thiefName, tier)
		Lot7.addLog(vs, thiefName, tier, "p")
		vs.data.raven.sh = math.max(vs.data.raven.sh, os.time() + RV.postStealShield)
	end

	---------------------------------------------------------------- Oiseau
	local function lerpPos(a, b, u)
		return a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, a.z + (b.z - a.z) * u
	end
	local function placeBird(bird, x, y, z, ax, ay, az)
		local dx, dy, dz = ax - x, ay - y, az - z
		if dx * dx + dy * dy + dz * dz < 1e-4 then
			bird:PivotTo(CFrame.new(x, y, z))
		else
			bird:PivotTo(CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(ax, ay, az)))
		end
	end
	local function moveBird(f, now)
		local bird = f.bird
		if not (bird and bird.Parent) then
			return
		end
		local t = (now - f.t0) / RV.flightSeconds
		local x, y, z = Raven.birdPos(f.from, f.to, t, 0.3)
		local ax, ay, az = Raven.birdPos(f.from, f.to, math.min(1, t + 0.06), 0.3)
		placeBird(bird, x, y, z, ax, ay, az)
		f.flap = not f.flap
		Builder.ravenFlap(bird, f.flap)
	end
	-- Départ après le vol (réussi : vers la base du voleur ; chassé : loin). Temporaire et borné : l'oiseau est TOUJOURS détruit à la fin.
	local function depart(bird, from, to, secs)
		if not bird then
			return
		end
		task.spawn(function()
			local t0, flap = os.clock(), false
			while bird.Parent and os.clock() - t0 < secs do
				local u = math.min(1, (os.clock() - t0) / secs)
				local x, y, z = lerpPos(from, to, u)
				placeBird(bird, x, y, z, to.x, to.y, to.z)
				flap = not flap
				Builder.ravenFlap(bird, flap)
				task.wait(0.1)
			end
			pcall(function()
				bird:Destroy()
			end)
		end)
	end

	---------------------------------------------------------------- Fin d'un vol
	local function release(f)
		flights[f.thief.player] = nil
		local list = bySlot[f.victim.player]
		if list then
			list[f.slot] = nil
			if next(list) == nil then
				bySlot[f.victim.player] = nil
			end
		end
	end
	local function refund(f)
		if f.refunded then
			return -- jamais deux fois
		end
		f.refunded = true
		local tk = f.thief.data.tokens
		tk.remoteSteal = math.min(RV.tokenMax, tk.remoteSteal + 1) -- le jeton en vol est compté dans le plafond d'achat : jamais perdu
	end

	local function finish(f, decision, reason)
		release(f) -- d'abord : plus aucun état partagé ne dépend de ce vol, même si la suite lève une erreur
		local s, vs = f.thief, f.victim
		local bird = f.bird
		f.bird = nil
		local result = decision == "aborted" and ("aborted:" .. reason) or decision
		if decision == "success" then
			local now = os.time()
			local rem = math.max(0, f.ref.ends - now)
			local ti = freeSlot(s)
			local rvv = vs.data.raven
			rvv.icDay, rvv.ic = Raven.rollDaily(rvv.icDay, rvv.ic, now) -- indemnités reçues aujourd'hui (jour UTC)
			local comp = Raven.indemnity(Config, f.tier, f.ref.rv == true, rvv.ic) -- 0 si l'œuf est non indemnisable ; plafonné par jour et par victime (lot 7b)
			-- 1. données (opérations de table seulement : rien ne peut échouer à mi-chemin)
			s.data.slots[ti] = { k = "e", t = f.tier, ends = now + rem, shield = now + shieldTime(s), rv = true, rvAt = now } -- temps restant conservé, bouclier d'œuf normal ; marqué : plus jamais indemnisé, pas de revol avant 20 min
			vs.data.slots[f.slot] = false
			vs.data.coins += comp
			rvv.ic += comp
			Lot7.compPaid += comp -- compteur de session (tests, journal)
			vs.data.raven.cd = now + RV.victimCooldown
			vs.data.raven.sh = math.max(vs.data.raven.sh, now + RV.postStealShield)
			rollDaily(s.data)
			s.data.raven.n += 1 -- compte aux 3 vols par jour ; ne compte PAS dans `stolen` ni dans les quêtes de vol (classement)
			Lot7.addLog(vs, f.thiefName, f.tier, "r")
			-- 2. visuels et messages (un échec ici ne défait pas le vol)
			local okV, errV = pcall(function()
				local pad = vs.plot.pads[f.slot].part
				refreshPad(vs, f.slot)
				refreshPad(s, ti)
				Builder.flyEgg(f.tier, pad.Position + Vector3.new(0, 2, 0), s.player.UserId)
				local tp = s.plot.pads[ti].part.Position
				depart(bird, f.to, { x = tp.X, y = tp.Y + 9, z = tp.Z }, 2)
				bird = nil
			end)
			if not okV then
				warn("[Raven] visuels : " .. tostring(errV))
			end
			if bird then
				pcall(function()
					bird:Destroy()
				end)
			end
			local tn = Config.TIERS[f.tier].name
			notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " a emporté ton œuf " .. tn .. ". " .. (comp > 0 and ("Tu reçois 🪙 " .. Config.fmt(comp)) or "Pas d'indemnité (œuf non indemnisable ou plafond du jour atteint)") .. " et " .. math.floor(RV.postStealShield / 60) .. " min à l'abri des corbeaux.", "caught")
			notify(s.player, "🐦‍⬛ Ton corbeau rapporte un œuf " .. tn .. " de " .. f.victimName .. " ! (temps restant conservé)", "steal")
		else
			refund(f) -- chassé ou annulé : jeton rendu, sans remboursement Robux
			if bird then
				if decision == "chased" then
					depart(bird, f.to, { x = f.to.x + 40, y = f.to.y + 30, z = f.to.z }, 1.5)
				else
					pcall(function()
						bird:Destroy()
					end)
				end
			end
			if decision == "chased" then
				notify(s.player, "🐦‍⬛ " .. f.victimName .. " a chassé ton corbeau. Jeton rendu.", "refuse")
				notify(vs.player, "🐦‍⬛ Tu as chassé le corbeau de " .. f.thiefName .. " !", "claim")
			elseif reason == "victimGone" then
				notify(s.player, "🐦‍⬛ " .. f.victimName .. " a quitté la partie : ton corbeau rentre. Jeton rendu.")
			elseif reason == "eggGone" then
				notify(s.player, "🐦‍⬛ L'œuf n'est plus là (éclos ou volé) : ton corbeau rentre. Jeton rendu.")
			elseif reason == "thiefGone" then
				notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " est reparti.")
			elseif reason == "castle" then
				notify(s.player, "🐦‍⬛ Un des deux joueurs est entré au Château : ton corbeau rentre. Jeton rendu.")
				notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " est reparti.")
			elseif reason == "newbie" then
				notify(s.player, "🐣 Protection débutant : ton corbeau rentre. Jeton rendu.")
			elseif reason == "shutdown" then
				notify(s.player, "🐦‍⬛ Le serveur ferme : ton corbeau rentre. Jeton rendu.")
			else
				notify(s.player, "🐦‍⬛ Le vol a échoué (" .. tostring(reason) .. "). Jeton rendu.", "refuse")
			end
		end
		RRaven:FireClient(vs.player, "end", { slot = f.slot, result = result })
		if sessions[s.player] == s and not s.leaving then
			RRaven:FireClient(s.player, "end", { slot = f.slot, result = result })
		end
		logEvent(f, result)
		if sessions[s.player] == s then
			sync(s)
		end
		if sessions[vs.player] == vs then
			sync(vs)
		end
	end

	local function worldOf(f, now)
		local s, vs = f.thief, f.victim
		local sl = vs.data.slots[f.slot]
		local still = sl == f.ref and type(sl) == "table" and sl.k == "e"
		local t = os.time()
		return { thiefHere = sessions[s.player] == s and not s.leaving, victimHere = sessions[vs.player] == vs and not vs.leaving, eggStill = still, eggLeft = still and (sl.ends - t) or 0,
			chased = f.chased, shielded = vs.data.raven.sh > t, thiefFreeSlot = freeSlot(s) ~= nil, now = now, endsAt = f.endsAt,
			inCastle = inCastleMode(s) or inCastleMode(vs), newbie = isNewbie(s) or isNewbie(vs) } -- château et protection débutant relus à chaque pas (lot 7b)
	end

	local function step()
		local now = os.clock()
		local list = {}
		for _, f in pairs(flights) do
			list[#list + 1] = f
		end
		for _, f in ipairs(list) do
			local ok, err = pcall(function()
				local decision, reason = Raven.settle(worldOf(f, now))
				if decision == "pending" and now > f.endsAt + 5 then
					decision, reason = "aborted", "timeout" -- filet de sécurité : un vol ne reste jamais bloqué
				end
				if decision == "pending" then
					moveBird(f, now)
				else
					finish(f, decision, reason)
				end
			end)
			if not ok then
				warn("[Raven] " .. tostring(err))
				if flights[f.thief.player] == f then
					pcall(finish, f, "aborted", "error")
					flights[f.thief.player] = nil
				end
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.1)
			if next(flights) then
				step()
			end
		end
	end)

	-- Départ d'un joueur : tout vol qui le concerne est annulé AVANT sa sauvegarde (le jeton du voleur lui est rendu dans son profil).
	function Lot7.onLeave(s)
		local list = {}
		for _, f in pairs(flights) do
			if f.thief == s or f.victim == s then
				list[#list + 1] = f
			end
		end
		for _, f in ipairs(list) do
			pcall(finish, f, "aborted", f.thief == s and "thiefGone" or "victimGone")
		end
		flights[s.player] = nil
		bySlot[s.player] = nil
		s.friendCache, s.priv = nil, nil
	end
	-- Fermeture du serveur (BindToClose, AVANT les sauvegardes) : tout vol en cours est annulé et son jeton rendu dans le profil, qui est sauvegardé juste après.
	function Lot7.abortAll()
		local list = {}
		for _, f in pairs(flights) do
			list[#list + 1] = f
		end
		for _, f in ipairs(list) do
			local ok, err = pcall(finish, f, "aborted", "shutdown")
			if not ok then
				warn("[Raven] abortAll : " .. tostring(err))
				release(f)
				refund(f) -- repli : le jeton est rendu quoi qu'il arrive (sans effet s'il l'a déjà été)
			end
		end
	end
	function Lot7.flightCount()
		local n, m = 0, 0
		for _ in pairs(flights) do
			n += 1
		end
		for _, l in pairs(bySlot) do
			for _ in pairs(l) do
				m += 1
			end
		end
		return n, m, #ravensFolder:GetChildren()
	end

	-- La victime touche son œuf (dans sa base) : le corbeau est chassé.
	function Lot7.chase(s, i)
		local list = bySlot[s.player]
		local f = list and list[i]
		if not f or f.chased then
			return
		end
		local root = getRoot(s.player)
		if not root or not alive(s.player) or not inPlot(s, root) then
			if os.clock() - (s.lastChaseMsg or -10) > 2 then
				s.lastChaseMsg = os.clock()
				notify(s.player, "🐦‍⬛ Reviens dans ta base pour chasser le corbeau !", "refuse")
			end
			return
		end
		f.chased = true -- résolu au prochain pas (0,1 s) par Raven.settle
	end

	---------------------------------------------------------------- Actions du client
	-- Liste des cibles : joueurs éligibles et leurs œufs éligibles (rareté et temps restant), calculée par le serveur avec les MÊMES règles que le lancement.
	function Lot7.ravenList(s)
		local clock = os.clock()
		if clock - (s.lastRavenList or -10) < RV.tryGap then
			return
		end
		s.lastRavenList = clock
		local cands = {}
		for _, vs in pairs(sessions) do
			if vs ~= s and not vs.leaving then
				cands[#cands + 1] = vs
			end
		end
		table.sort(cands, function(a, b)
			return a.player.UserId < b.player.UserId
		end)
		local friends = {}
		for _, vs in ipairs(cands) do
			friends[vs] = friendsWith(s, vs.player) -- peut attendre le réseau (mis en cache) : tout est relu ensuite
		end
		if sessions[s.player] ~= s or s.leaving then
			return
		end
		local t = thiefCtx(s)
		local now = os.time()
		local ideal = { userId = -1, level = t.level, playMinutes = 1e9, newbie = false, inCastle = false, graceUntil = 0, shieldUntil = 0, ravenCooldownUntil = 0, friendOfThief = false, blockFriendRavens = false, accountAgeDays = 1e9 }
		local okSelf, whySelf = Raven.canLaunch(Config, t, ideal, { tier = 1, incubating = true, eggShieldUntil = 0, endsAt = math.huge }, now)
		local targets = {}
		for _, vs in ipairs(cands) do
			if sessions[vs.player] == vs and not vs.leaving then
				local vctx = victimCtx(vs, friends[vs])
				local eggs = {}
				for i = 1, cap(vs) do
					local ectx = eggCtx(vs, i)
					if ectx and not (bySlot[vs.player] and bySlot[vs.player][i]) and Raven.canLaunch(Config, t, vctx, ectx, now) then
						eggs[#eggs + 1] = { i = i, t = ectx.tier, left = math.max(0, math.floor(ectx.endsAt - now)) }
					end
				end
				if #eggs > 0 then
					targets[#targets + 1] = { u = vs.player.UserId, name = vs.player.DisplayName, eggs = eggs }
				end
			end
		end
		RRaven:FireClient(s.player, "list", { tokens = s.data.tokens.remoteSteal, left = Lot7.ravenLeft(s), blocked = (not okSelf) and (MSG[whySelf] or MSG.invalid) or nil, targets = targets })
	end

	function Lot7.ravenGo(s, arg)
		if type(arg) ~= "table" then
			return
		end
		local uid, slot = arg.u, arg.i
		if type(uid) ~= "number" or uid % 1 ~= 0 or not validSlot(slot) then
			return
		end
		local clock = os.clock()
		if s.ravenBusy or clock - (s.lastRavenTry or -10) < RV.tryGap then
			return notify(s.player, MSG.busy, "refuse")
		end
		s.lastRavenTry = clock
		if clock - (s.lastRavenGo or -100) < RV.launchCooldown then
			return notify(s.player, MSG.cooldown, "refuse")
		end
		local vp = Players:GetPlayerByUserId(uid)
		local vs = vp and sessions[vp]
		if not vs or vs.leaving or vs == s then
			return notify(s.player, vs == s and MSG.self or MSG.gone, "refuse")
		end
		s.ravenBusy = true
		local friend = friendsWith(s, vp) -- seul point d'attente : tout ce qui suit est relu après lui
		s.ravenBusy = nil
		if sessions[s.player] ~= s or s.leaving or sessions[vp] ~= vs or vs.leaving then
			return
		end
		if bySlot[vp] and bySlot[vp][slot] then
			return notify(s.player, MSG.targeted, "refuse")
		end
		local ectx = eggCtx(vs, slot)
		if not ectx then
			return notify(s.player, MSG.notEgg, "refuse")
		end
		local ok, why = Raven.canLaunch(Config, thiefCtx(s), victimCtx(vs, friend), ectx, os.time())
		if not ok then
			return notify(s.player, MSG[why] or MSG.invalid, "refuse")
		end
		-- Décollage : le jeton est débité D'ABORD, avant toute construction ; si la construction échoue (erreur, pad introuvable...), il est rendu et rien n'est enregistré.
		local sl = vs.data.slots[slot]
		s.data.tokens.remoteSteal -= 1
		local f, bird
		local okF, errF = pcall(function()
			local pad = vs.plot.pads[slot].part
			local plaza = Config.Map2.plaza
			f = {
				thief = s, victim = vs, slot = slot, ref = sl, tier = sl.t, t0 = os.clock(), endsAt = os.clock() + RV.flightSeconds, chased = false, flap = false,
				thiefId = s.player.UserId, victimId = vp.UserId, thiefName = s.player.DisplayName, victimName = vp.DisplayName,
				from = { x = plaza.x, y = 30, z = plaza.z }, to = { x = pad.Position.X, y = pad.Position.Y + 12, z = pad.Position.Z },
			}
			local okB, b = pcall(Builder.raven, ravensFolder)
			bird = okB and b or nil -- sans oiseau visible le vol reste valable
			f.bird = bird
		end)
		if not okF then
			warn("[Raven] décollage impossible, jeton rendu : " .. tostring(errF))
			if bird then
				pcall(function()
					bird:Destroy()
				end)
			end
			s.data.tokens.remoteSteal = math.min(RV.tokenMax, s.data.tokens.remoteSteal + 1)
			return notify(s.player, "🐦‍⬛ Ton corbeau n'a pas pu décoller. Jeton rendu.", "refuse")
		end
		-- enregistrement (opérations de table seulement : ne peut pas échouer à mi-chemin)
		s.lastRavenGo = os.clock()
		vs.data.raven.cd = math.max(vs.data.raven.cd, os.time() + RV.victimFailCooldown) -- anti-harcèlement : 3 min de répit dès l'alerte ; les 20 min ne sont posées qu'en cas de SUCCÈS (finish)
		flights[s.player] = f
		bySlot[vp] = bySlot[vp] or {}
		bySlot[vp][slot] = f
		local okN, errN = pcall(function()
			local tn = Config.TIERS[sl.t].name
			RRaven:FireClient(vp, "alert", { who = f.thiefName, tier = sl.t, slot = slot, secs = RV.flightSeconds })
			notify(vp, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " vise ton œuf " .. tn .. " ! Touche l'œuf pour le chasser (" .. RV.flightSeconds .. " s).", "caught")
			notify(s.player, "🐦‍⬛ Ton corbeau s'envole vers l'œuf " .. tn .. " de " .. f.victimName .. " (" .. RV.flightSeconds .. " s).", "event")
			RRaven:FireClient(s.player, "flight", { to = f.victimName, tier = sl.t, secs = RV.flightSeconds })
		end)
		if not okN then
			warn("[Raven] messages de décollage : " .. tostring(errN)) -- le vol est enregistré : il se règle normalement
		end
		logEvent(f, "launched")
		sync(s)
	end

	function Lot7.setBlockRavens(s, v)
		if type(v) ~= "boolean" then
			return
		end
		s.data.settings.blockFriendRavens = v
		sync(s)
	end

	---------------------------------------------------------------- Achats : jetons, tapis doré, pluie de chance
	-- Retourne true (livré), (false, message) = reçu NON traité (Roblox le rappellera : rien n'est perdu), ou nil si ce n'est pas un produit du lot 7.
	function Lot7.grant(s, name)
		local n = Raven.tokensFor(Config, name)
		if n > 0 then
			local held = Raven.held(s.data.tokens.remoteSteal, flights[s.player] ~= nil)
			if not Raven.canBuy(Config, held, n) then
				return false, "🐦‍⬛ Tu as déjà " .. held .. " jeton(s) : le maximum est " .. RV.tokenMax .. ". Utilise-en avant de finaliser cet achat (il sera livré automatiquement, rien n'est perdu)."
			end
			s.data.tokens.remoteSteal = Raven.addTokens(Config, s.data.tokens.remoteSteal, n)
			notify(s.player, "🐦‍⬛ +" .. n .. " jeton(s) de corbeau (" .. s.data.tokens.remoteSteal .. "/" .. RV.tokenMax .. ").", "buy")
			return true
		elseif name == "GoldenBelt" then
			local G = Config.BELT.golden
			local left, ok = Raven.stack(Belt.goldenLeft(beltSt, os.clock()), G.seconds, G.maxSeconds)
			if not ok then
				return false, "🌟 Le tapis doré est déjà presque au maximum (" .. Belt.clock(left) .. "). Ton achat sera livré dès qu'il y aura de la place, rien n'est perdu."
			end
			goldenBeltAdd(G.seconds, s.player.DisplayName)
			Lot7.goldenById = s.player.UserId
			announce("🌟 " .. s.player.DisplayName .. " offre le tapis doré à tout le serveur !")
			return true
		elseif name == "ServerLuck" then
			local L = Config.SERVER_LUCK
			local left, ok = Raven.stack(math.max(0, Lot7.luckUntil - os.time()), L.seconds, L.maxSeconds)
			if not ok then
				return false, "🌧️ La pluie de chance est déjà presque au maximum (" .. Config.fmtTime(left) .. "). Ton achat sera livré dès qu'il y aura de la place, rien n'est perdu."
			end
			Lot7.luckUntil, Lot7.luckBy, Lot7.luckById = os.time() + left, s.player.DisplayName, s.player.UserId
			announce("🌧️ " .. s.player.DisplayName .. " offre une pluie de chance : +" .. L.bonus .. " points d'amélioration pour tout le serveur pendant " .. math.floor(L.seconds / 60) .. " min !")
			return true
		end
		return nil
	end

	-- Bonus serveur et fermeture du serveur : la fin du tapis doré / de la pluie de chance est écrite (os.time) dans le profil du DERNIER donateur encore présent à la fermeture
	-- (BindToClose), puis rendue UNE fois (et effacée) à son arrivée sur un autre serveur. Un donateur déjà parti avant la fermeture n'a rien à restituer : limite documentée (CHANGELOG 7b).
	function Lot7.persistBuffs()
		local now = os.time()
		local gl = math.floor(Belt.goldenLeft(beltSt, os.clock()))
		local ll = math.floor(Lot7.luckUntil - now)
		for player, s in pairs(sessions) do
			if not s.noSave then
				if gl > 30 and Lot7.goldenById == player.UserId then
					s.data.srvBuff.g = now + gl
				end
				if ll > 30 and Lot7.luckById == player.UserId then
					s.data.srvBuff.l = now + ll
				end
			end
		end
	end
	function Lot7.restoreBuffs(s)
		local b, now = s.data.srvBuff, os.time()
		if type(b) ~= "table" then
			return
		end
		local G, L = Config.BELT.golden, Config.SERVER_LUCK
		local name, uid = s.player.DisplayName, s.player.UserId
		local gLeft, lLeft = (b.g or 0) - now, (b.l or 0) - now
		b.g, b.l = 0, 0 -- restitué une seule fois (jamais de duplication d'un serveur à l'autre)
		if gLeft > 30 then
			local add = math.min(gLeft, G.maxSeconds) - Belt.goldenLeft(beltSt, os.clock()) -- on ne cumule pas : le plus long des deux
			if add > 0 then
				goldenBeltAdd(add, name)
				Lot7.goldenById = uid
				announce("🌟 Le tapis doré de " .. name .. " est de retour : " .. Belt.clock(math.min(gLeft, G.maxSeconds)) .. " restantes pour tout le serveur !")
			end
		end
		if lLeft > 30 then
			local target = now + math.min(lLeft, L.maxSeconds)
			if target > Lot7.luckUntil then
				Lot7.luckUntil, Lot7.luckBy, Lot7.luckById = target, name, uid
				announce("🌧️ La pluie de chance de " .. name .. " est de retour : " .. Config.fmtTime(target - now) .. " restantes pour tout le serveur !")
			end
		end
	end

	---------------------------------------------------------------- PolicyService
	-- Passes à hasard : actives seulement si PolicyService a confirmé « non restreint » ET que le joueur les possède ; sinon forcées à faux (lot 7b).
	local function applyRandomPasses(s)
		for name, def in pairs(Config.PASSES) do
			if def.random == true then
				s.passes[name] = s.restricted == false and s.ownedRandom[name] == true
			end
		end
		Lot7.privRefresh(s)
		sync(s)
	end
	function Lot7.fetchPolicy(s)
		task.spawn(function()
			local ok, info = pcall(function()
				return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(s.player)
			end)
			if sessions[s.player] ~= s then
				return
			end
			if ok and type(info) == "table" then
				s.restricted = info.ArePaidRandomItemsRestricted ~= false -- seul « false » confirme que les offres à hasard sont permises
			elseif s.restricted == nil then
				s.restricted = true -- échec : repli prudent (offres à hasard masquées et refusées)
				warn("[Policy] " .. s.player.Name .. " : PolicyService indisponible, offres à hasard masquées")
			end
			applyRandomPasses(s)
		end)
		task.delay(8, function() -- délai dépassé : repli prudent (une réponse tardive pourra encore lever la restriction)
			if sessions[s.player] == s and s.restricted == nil then
				s.restricted = true
				applyRandomPasses(s)
			end
		end)
	end
	function Lot7.awaitPolicy(s) -- ProcessReceipt : attend (au plus 10 s) la réponse de PolicyService avant de décider
		local t0 = os.clock()
		while s.restricted == nil and os.clock() - t0 < 10 and sessions[s.player] == s do
			task.wait(0.25)
		end
		return s.restricted ~= false
	end

	---------------------------------------------------------------- Tapis privé (pass PrivateBelt)
	function Lot7.privRefresh(s)
		if passOn(s, "PrivateBelt") and s.plot and not s.leaving then
			Builder.privateBelt(s.plot, s.player.UserId, s.data.pb)
		elseif s.plot then
			Builder.clearPrivateBelt(s.plot)
		end
	end
	-- Un pas par seconde et par joueur (slowTick) : `active` = le joueur a agi ou bougé dans Config.IDLE.seconds. Joueur hors ligne = jamais appelé : aucune production hors ligne.
	function Lot7.privStep(s, dt, active)
		if not passOn(s, "PrivateBelt") then
			return
		end
		s.priv = s.priv or { acc = 0 }
		s.priv.pending = s.data.pb
		local tier = Belt.privateStep(Config, s.priv, dt, active, rnd())
		if tier then
			Lot7.privRefresh(s)
			notify(s.player, "🛤️ Un œuf " .. Config.TIERS[tier].name .. " t'attend sur ton tapis privé (gratuit).", "claim")
			sync(s)
		end
	end
	function Lot7.privTake(s, root, prompt)
		local now = os.clock()
		if now - (s.lastPriv or -10) < 0.25 then
			return
		end
		s.lastPriv = now
		if not passOn(s, "PrivateBelt") or prompt:GetAttribute("Owner") ~= s.player.UserId then
			return notify(s.player, "🛤️ Ce tapis n'est pas à toi.", "refuse")
		end
		local belt = s.plot and s.plot.privateBelt
		local strip = belt and belt:FindFirstChild("PrivateBeltStrip")
		if not strip or prompt.Parent ~= strip or (root.Position - strip.Position).Magnitude > 16 then
			return
		end
		local tier = s.data.pb[1]
		if not tier then
			return
		end
		local i = freeSlot(s)
		if not i then
			return notify(s.player, "Base pleine ! Libère un emplacement pour prendre l'œuf du tapis privé.", "refuse")
		end
		table.remove(s.data.pb, 1)
		s.data.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s), rv = true } -- gratuit : non indemnisable (lot 7b)
		refreshPad(s, i)
		Lot7.privRefresh(s)
		notify(s.player, "🥚 Œuf " .. Config.TIERS[tier].name .. " pris sur ton tapis privé !", "claim")
		sync(s)
	end

	-- Crochet INTERNE pour les tests (jamais exposé aux clients) : accès aux sessions et compteurs.
	Builder.lot7Hooks = { session = function(p)
		return sessions[p]
	end, logEnqueue = Lot7.logEnqueue, logPending = Lot7.logPending, logDropped = function()
		return Lot7.logDropped
	end, luckPoints = luckPoints, passOn = passOn, flights = Lot7.flightCount, serverBuffs = Lot7.serverBuffs, compPaid = function()
		return Lot7.compPaid
	end }
end

---------------------------------------------------------------- Game Passes
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local s = sessions[player]
	if not (s and purchased) then
		return
	end
	for name, def in pairs(Config.PASSES) do
		if Config.purchasable(def) and def.id == passId then
			if def.random == true and s.restricted ~= false then
				warn("[Policy] " .. player.Name .. " : achat du pass « " .. name .. " » refusé (offres à hasard restreintes)") -- jamais livré à un joueur restreint
				notify(player, "🛒 Cette offre n'est pas disponible pour ton compte.")
			else
				s.passes[name] = true
				if def.random == true then
					s.ownedRandom[name] = true
				end
				if name == "PrivateBelt" then
					Lot7.privRefresh(s)
				end
			end
		end
	end
	if passId == Config.PASSES.ExtraSlots.id and s.plot then
		refreshLocks(s) -- +4 emplacements : cadenas levés sans recréer les pads occupés
	end
	sync(s)
end)

---------------------------------------------------------------- Produits développeur (achats Robux ponctuels)
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local s = player and sessions[player]
	if not s then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local rid = tostring(info.PurchaseId)
	local function persist()
		-- PurchaseGranted seulement une fois la sauvegarde réussie ; sinon Roblox rappellera ProcessReceipt (le reçu en mémoire n'est
		-- compté « traité » qu'après une sauvegarde réussie, la livraison n'est donc jamais refaite : s.pendingReceipts).
		if not s.noSave and not Data.save(player, s.data, s.leaving == true) then -- joueur en train de partir : libère aussi le verrou (sinon ce reçu le reprendrait après sa sauvegarde de départ)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		s.pendingReceipts[rid] = nil
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if s.pendingReceipts[rid] then
		return persist() -- déjà livré en mémoire, il ne reste qu'à sauvegarder
	end
	if s.data.receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local granted = false
	for name, def in pairs(Config.PRODUCTS) do
		if Config.purchasable(def) and def.id == info.ProductId then
			if def.random == true and Lot7.awaitPolicy(s) then
				notify(player, "🛒 Cette offre n'est pas disponible pour ton compte.")
				return Enum.ProductPurchaseDecision.NotProcessedYet -- offre à hasard refusée côté serveur (PolicyService) : rien n'est livré
			end
			if s.pendingReceipts[rid] or s.data.receipts[rid] then
				return Enum.ProductPurchaseDecision.NotProcessedYet -- reçu livré pendant l'attente (appel concurrent du même reçu) : le deuxième appel ne livre rien
			end
			local l7ok, l7msg = Lot7.grant(s, name)
			if l7ok == false then
				notify(player, l7msg)
				return Enum.ProductPurchaseDecision.NotProcessedYet
			elseif l7ok == true then
				-- livré par le lot 7 (jetons, tapis doré, pluie de chance) ; le reçu est enregistré plus bas
			elseif name == "StarterPack" then
				if s.data.starter then
					return Enum.ProductPurchaseDecision.NotProcessedYet -- achat unique : déjà fait, rien n'est livré
				end
				s.data.starter = true
				s.data.coins += Config.STARTER_PACK.coins
				for _ = 1, Config.STARTER_PACK.eggs do
					giveEgg(s, Config.STARTER_PACK.eggTier)
				end
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
			elseif type(def.eggTier) == "number" then
				-- œufs de rareté FIXE (Mythique, et lot 9 : Secret, Exclusif, Divin) : refus SANS effet si la rareté n'a aucune espèce publiée
				-- (offre masquée, Config.offerVisible) ou si la base est pleine ; Roblox rappellera ProcessReceipt (rien n'est débité tant que non traité)
				if not Config.tierLive(def.eggTier) then
					notify(player, "🥚 Cet œuf n'est pas encore disponible : ton achat sera livré plus tard.")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				if not freeSlot(s) then
					notify(player, "Base pleine : libère une place, ton achat sera livré automatiquement.")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				giveEgg(s, def.eggTier)
				notify(player, "🥚 " .. def.name .. " placé dans ta base !", "claim")
			elseif name == "CalendarCatchup" then
				-- lot 9b : un jeton de rattrapage du calendrier (plafond Config.CALENDAR.catchupMax : au-delà, rien n'est débité, le reçu sera rejoué)
				if not Lot7.Calendar.addCatch(Config, s.data.cal) then
					notify(player, "📅 Tu as déjà " .. Config.CALENDAR.catchupMax .. " rattrapages : utilises-en avant de finaliser cet achat (il sera livré automatiquement, rien n'est perdu).")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				notify(player, "📅 +1 rattrapage du calendrier (" .. s.data.cal.catch .. "/" .. Config.CALENDAR.catchupMax .. ").", "buy")
			elseif name == "InstantHatch" then
				for i = 1, cap(s) do
					hatch(s, i)
				end
			elseif name == "Revive" then
				local rv = s.revive
				s.revive = nil
				player:SetAttribute("ReviveUntil", nil)
				local root = getRoot(player)
				if s.castle and not s.castle.finished and rv and os.clock() <= rv.expires + 5 and root then
					-- relance sur place : retour là où il est tombé, pv pleins, invulnérable un moment, la défaite n'est pas comptée
					root.CFrame = CFrame.new(rv.pos + Vector3.new(0, 3, 0))
					root.AssemblyLinearVelocity = Vector3.zero
					s.noCheckUntil = os.clock() + 2
					setHp(s, GC.maxHp)
					s.iframes = Config.REVIVE.iframes
					s.castle.deaths = math.max(0, s.castle.deaths - 1)
					notify(player, "💫 Relance ! Tu repars de là où tu es tombé.", "claim")
				else
					-- l'offre a expiré (ou il a quitté le château) : l'achat n'est jamais perdu, il est remplacé par une potion de chance
					s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
					notify(player, "💫 L'offre de relance avait expiré : une potion de chance t'est offerte à la place.", "claim")
				end
			elseif name == "LuckPotion" then
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
			elseif name == "CoinPack" then
				s.data.coins += math.max(Config.COIN_PACK_MIN, income(s) * Config.COIN_PACK_MINUTES * 60)
			end
			granted = true
			tele.log(player, "purchase_tier", def.robux, "_p" .. tele.priceTier(def.robux))
		end
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local now = os.time()
	for k, t in pairs(s.data.receipts) do
		if type(t) ~= "number" or now - t > 30 * 86400 then
			s.data.receipts[k] = nil
		end
	end
	s.data.receipts[rid] = now
	s.pendingReceipts[rid] = true
	sync(s)
	return persist()
end

---------------------------------------------------------------- Cycle de vie des joueurs
local function claimPlot(player)
	for _, pl in ipairs(world.plots) do
		if not pl.owner then
			pl.owner = player
			pl.nameLabel.Text = "🏠 Base de " .. player.DisplayName
			return pl
		end
	end
	return nil
end

local function releasePlot(s)
	setDoorBarrier(s, false)
	Builder.clearPrivateBelt(s.plot)
	if s.badge then
		s.badge:Destroy()
		s.badge = nil
	end
	for i = 1, Config.SLOTS_MAX do
		clearPad(s, i)
		s.plot.pads[i].lock.Enabled = true
		s.plot.pads[i].part.Transparency = 0.7
		s.plot.pads[i].frame.Color = Color3.fromRGB(50, 52, 58)
		s.plot.pads[i].frame.Material = Enum.Material.SmoothPlastic
	end
	s.plot.owner = nil
	s.plot.nameLabel.Text = "Base libre"
	Builder.clearBase(s.plot)
end

-- Partie pleine (5 joueurs au plus) ou lieu de jeu ouvert en trop : le joueur est renvoyé au hub (ou expulsé avec un message si le hub est injoignable).
local function bounceToHub(player, message)
	local hub = Config.Game.Places.hub
	local role = Config.Game.roleFor(game.PlaceId)
	if role == "game" and type(hub) == "number" and hub > 0 then
		local opts = Instance.new("TeleportOptions")
		opts:SetTeleportData({ from = "game", reason = "full" })
		local ok = pcall(function()
			TeleportService:TeleportAsync(hub, { player }, opts)
		end)
		if ok then
			return
		end
	end
	player:Kick(message)
end


local function onJoin(player)
	local okJ, joinData = pcall(function()
		return player:GetJoinData().TeleportData
	end)
	local admitted, why = Party.admitJoin(serverPartyId, okJ and joinData or nil, #Players:GetPlayers() - 1, Config.Game.MaxPlayers, Config.Game.roleFor(game.PlaceId))
	if not admitted then
		bounceToHub(player, why == "full" and ("Cette partie est pleine (" .. Config.Game.MaxPlayers .. " joueurs maximum). Réessaie avec une autre partie.") or "Tu ne fais pas partie de cette partie.")
		return
	end
	if serverPartyId == nil and okJ and type(joinData) == "table" and type(joinData.partyId) == "string" then
		serverPartyId = joinData.partyId
	end
	if okJ and type(joinData) == "table" and joinData.mode == "castle" and next(sessions) == nil then
		serverMode = "castle" -- le premier joueur détermine le mode du serveur réservé
	end
	local late = next(sessions) ~= nil -- arrivée dans une partie déjà commencée
	local waitedLeave = 0
	while leavingSave[player.UserId] and waitedLeave < 20 and player.Parent do -- il vient de partir : attendre la fin de sa sauvegarde (sinon on lirait un profil périmé puis on l'écraserait)
		task.wait(0.25)
		waitedLeave += 0.25
	end
	local d, noSave = Data.load(player)
	if not d then
		player:Kick("Impossible de charger tes données. Reconnecte-toi dans un instant.")
		return
	end
	if pendingSaves[player.UserId] and not noSave then
		d = pendingSaves[player.UserId] -- il revient avant que sa dernière sauvegarde ait réussi : ce profil (plus récent) fait foi
		pendingSaves[player.UserId] = nil
	end
	if not player.Parent then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session
		end
		return
	end
	local plot = claimPlot(player)
	if not plot then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session avant de refuser
		end
		player:Kick("Serveur plein. Réessaie dans un autre serveur.")
		return
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local function stat(name)
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
		return v
	end
	local rankStat = Instance.new("StringValue")
	rankStat.Name = "Rang"
	rankStat.Parent = ls
	local s = {
		species = speciesCount(d), lsRank = rankStat,
		player = player, data = d, plot = plot, carry = {}, carryParts = {}, labels = {}, passes = {},
		graceUntil = late and (os.time() + Config.Game.LateJoinGrace) or 0, hp = Config.GUARD.maxHp, iframes = 0, sinceHit = 99, stun = 0, lastAct = 0, lastActive = os.clock(), lastTap = 0, lastSteal = 0, lastFull = 0, noSave = noSave,
		followers = {}, ownedRandom = {}, pendingReceipts = {}, holdSeen = false, flags = 0, noCheckUntil = 0, syncT = 0, leaving = false, traps = {},
		runes = { 1, 1, 1, 1 }, lastRune = 0, runeLock = 0,
		lsCoins = stat("Pièces"), lsSpeed = stat("Vitesse"), lsRb = stat("Renaissances"),
	}
	ls.Parent = player
	player:SetAttribute("Hp", Config.GUARD.maxHp)
	player:SetAttribute("MaxHp", Config.GUARD.maxHp)
	sessions[player] = s
	do -- lot 9 (mesure de rétention) : jours UTC de première et de dernière connexion, aucune donnée personnelle
		local today = os.time() // 86400
		if d.firstSeen == 0 then
			d.firstSeen = today
		end
		local back = d.lastSeen ~= today and tele.retentionDay(d.firstSeen, today) or nil
		if back then
			tele.log(player, "retention_day" .. back)
		end
		d.lastSeen = today
		s.joinClock = os.clock()
	end
	if plot and plot.spawn then
		player:SetAttribute("BaseX", plot.spawn.Position.X) -- le client affiche la distance à la base sur la bannière de zone
		player:SetAttribute("BaseZ", plot.spawn.Position.Z)
	end
	if late then
		notify(player, "🛡 Tu arrives en cours de partie : tes œufs sont protégés " .. Config.Game.LateJoinGrace .. " s.")
	end

	for name, def in pairs(Config.PASSES) do
		s.passes[name] = false
		if Config.purchasable(def) then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if def.random == true then
				s.ownedRandom[name] = ok and owns == true -- passe à hasard : possédée mais INACTIVE tant que PolicyService n'a pas confirmé « non restreint » (voir fetchPolicy)
			else
				s.passes[name] = ok and owns == true
			end
		end
	end

	Lot7.restoreBuffs(s) -- tapis doré / pluie de chance offerts par ce joueur sur un serveur fermé depuis : le temps restant est rendu une fois
	Lot7.fetchPolicy(s) -- offres à hasard : masquées et refusées tant que PolicyService n'a pas confirmé qu'elles sont permises
	s.baseLevel = levelOf(s) -- le revenu (gains hors ligne compris) dépend du niveau de maison ; la base est construite plus bas par applyBase
	-- gains hors-ligne (les œufs éclosent seuls grâce aux horodatages)
	local away = math.clamp(os.time() - d.last, 0, Config.IDLE.offlineMaxSeconds)
	if away > 30 then
		local gain = income(s) * away * Config.IDLE.offlineRate
		d.pendingAway = math.min(d.pendingAway + gain, math.max(income(s), 1) * Config.IDLE.offlineMaxSeconds * Config.IDLE.offlineRate) -- mis de côté (plafonné) : se récupère d'un clic (claimAway)
	end
	if d.pendingAway >= 1 then
		notify(player, "💤 Gains pendant ton absence : " .. Config.fmt(d.pendingAway) .. " 🪙 : touche « Récupérer »")
	end

	ensureQuests(s)
	pvpState(s) -- nouvelle saison : récompense de la précédente et remise à zéro douce
	applyBase(s, false)
	updateSign(s)
	refreshAllPads(s)
	Lot7.privRefresh(s) -- tapis privé (pass) : œufs en attente sauvegardés
	s.welcome = "wait"
	task.delay(Config.BELT.welcome.delay, function()
		beltWelcome(player, s) -- œuf de bienvenue du tapis (une fois, 20 s après l'arrivée)
	end)
	player:SetAttribute("PlotCF", plot.cf) -- position de la base : sert aux caméras des cinématiques (réplication sûre)
	player.RespawnLocation = plot.spawn
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		s.stun = 0
		s.carry = {}
		s.carryParts = {}
		s.lastPos = nil
		s.followers = {}
		applySpeed(s)
		task.spawn(function()
			char:WaitForChild("HumanoidRootPart", 10)
			if player.Parent and sessions[player] == s then
				rebuildFollowers(s)
				if serverMode == "castle" and not s.castle then
					castleEnter(s) -- serveur de mode Château : arrivée directement à l'entrée du donjon
				end
			end
		end)
		hum.Died:Connect(function()
			dropCarry(s)
			clearFollowers(s)
			task.delay(3, function()
				if player.Parent and sessions[player] == s then
					pcall(function()
						player:LoadCharacterAsync()
					end)
				end
			end)
		end)
	end)
	if player.Parent then
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok then
			warn("[onJoin] LoadCharacterAsync : " .. tostring(err))
		end
		if player.Parent then
			sync(s)
		end
	end
end

Players.PlayerAdded:Connect(onJoin)
-- Filet de sécurité : personnage garanti dans la zone, replacement si chute (voir Spawn / SpawnGuard, traces [Spawn] en console serveur)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpawnGuard")).attach({
	role = "game",
	safeCFrame = function(p)
		local ss = sessions[p]
		local sp = ss and ss.plot and ss.plot.spawn
		if sp then
			return sp.CFrame + Vector3.new(0, 4, 0)
		end
		local pa = Config.Map2.plazaArrival
		return CFrame.new(pa.x, 8, pa.z) -- sur la place du marché, près de la rose des portails : toujours au sol
	end,
})
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

-- Profils dont la sauvegarde de départ a échoué : réessayée en arrière-plan (délais croissants, 10 essais), abandonnée si le joueur est revenu
-- (sa nouvelle session reprend ce profil au chargement) ; vidée aussi à la fermeture du serveur (BindToClose).
function saveLater(player, d)
	local uid = player.UserId
	pendingSaves[uid] = d
	task.spawn(function()
		local delay = 4
		for _ = 1, 10 do
			task.wait(delay)
			delay = math.min(delay * 2, 60)
			if pendingSaves[uid] ~= d then
				return
			end
			if Players:GetPlayerByUserId(uid) then
				return -- revenu : le chargement a repris pendingSaves, rien à écraser
			end
			if Data.save(player, d, true) then
				pendingSaves[uid] = nil
				return
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	local s = sessions[player]
	if not s then
		return
	end
	s.leaving = true -- l'autosave ne doit plus reprendre le verrou de session après ce point
	do -- lot 9b : une réclamation du calendrier en cours (sauvegarde puis octroi) se termine AVANT la sauvegarde de départ
		local t0 = os.clock()
		while s.calBusy and os.clock() - t0 < 15 do
			task.wait(0.1)
		end
	end
	tele.log(player, "session_length", os.clock() - (s.joinClock or os.clock()))
	tele.flush(player)
	Lot7.onLeave(s) -- annule tout vol de corbeau en cours (jeton rendu au voleur AVANT la sauvegarde), vide les états du joueur
	dropCarry(s)
	clearFollowers(s)
	holds[player] = nil
	if not s.noSave then
		leavingSave[player.UserId] = true
		local okSave = Data.save(player, s.data, true) -- libère le verrou
		if not okSave then
			saveLater(player, s.data) -- DataStore en panne ou lent : on réessaie en arrière-plan (la progression n'est pas perdue)
		end
		leavingSave[player.UserId] = nil
		Data.submit(player, s.data)
	end
	releasePlot(s)
	sessions[player] = nil
end)

-- sauvegarde automatique toutes les 60 s
task.spawn(function()
	while true do
		task.wait(60)
		for player, s in pairs(sessions) do
			if not s.noSave and not s.leaving then
				task.spawn(function()
					Data.save(player, s.data)
					Data.submit(player, s.data)
				end)
			end
		end
	end
end)

game:BindToClose(function()
	pcall(Lot7.abortAll) -- d'abord : tout vol de corbeau en cours est annulé et son jeton rendu dans le profil, AVANT les sauvegardes ci-dessous
	pcall(Lot7.persistBuffs) -- fin du tapis doré / de la pluie de chance écrite dans le profil du donateur présent
	local pending = 0
	for uid, d in pairs(pendingSaves) do -- profils de joueurs déjà partis dont la sauvegarde a échoué
		pending += 1
		task.spawn(function()
			local ghost = Players:GetPlayerByUserId(uid) or { UserId = uid, Name = "joueur " .. uid }
			if Data.save(ghost, d, true) then
				pendingSaves[uid] = nil
			end
			pending -= 1
		end)
	end
	for player, s in pairs(sessions) do
		if not s.noSave then
			pending += 1
			task.spawn(function()
				Data.save(player, s.data, true)
				pending -= 1
			end)
		end
	end
	local t0 = os.clock()
	while (pending > 0 or Lot7.logPending() > 0) and os.clock() - t0 < 25 do -- (le journal RavenLog est vidé dans la même limite de temps)
		task.wait()
	end
end)

-- classement global : rafraîchi toutes les 2 minutes
task.spawn(function()
	while true do
		topCache = Data.top(10)
		task.wait(120)
	end
end)

print("[Chipe-Œufs] serveur prêt")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Data
-- Sauvegarde DataStore avec VERROU DE SESSION (un joueur ne peut pas être chargé sur 2 serveurs à la fois :
-- empêche les pertes et duplications quand on change de serveur vite) + classement global.
-- Les emplacements vides valent `false` (un tableau JSON ne supporte pas les trous).
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Raven = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Raven")) -- règles pures du Corbeau (clés du journal RavenLog)
local Calendar = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Calendar")) -- lot 9b : règles pures du calendrier (assainissement du champ cal)
local Diag = require(script.Parent:WaitForChild("Diag"))

local STORE_NAME = "ChipeOeufs_v1"
local CASTLE_NAME = "ChipeOeufs_Castle_v1"
local BOARD_NAME = "ChipeOeufs_Board_v1"
local SLOT_COUNT = 20 -- v10 : 4 de base + 8 améliorations + 4 de maison + 4 du pass (Config.SLOTS_MAX)
local LOCK_TTL = 120 -- un verrou plus vieux que ça est considéré comme abandonné (crash serveur)
local SAVE_RETRIES = 3

-- Version du schéma des données sauvegardées. À incrémenter à chaque changement de structure, avec une étape dans migrate().
-- v1 : première version (sans champ ver). v2 : + equip, quests, qday, receipts, luckUntil, ver.
-- v3 : + story { ch, prog } (histoire) et pity (compteur de pitié).
-- v4 : + puzzle { day, solved } (énigmes), ach (succès) ; un chapitre d'histoire (énigme) est inséré en position 8.
-- v5 : + cine (cinématiques déjà vues).
-- v6 : + secrets (jour de la dernière fouille par secret de la carte).
-- v7 : + starter (pack de départ déjà acheté, achat unique).
-- v8 : + baseScore (progression de la base : points pondérés par la rareté des pets éclos).
-- v9c : + played (secondes de jeu cumulées) et newbieOff (protection débutant, lot 4) : champs facultatifs assainis, sans changement de version.
-- v9b : battle.pvp { season, trophies, wins, losses, defense = { {p,s,m} }, day, fights, claimed } (PvP asynchrone, sans changement de version : champs facultatifs assainis).
-- v10 (REFONTE lot 5) : SLOT_COUNT 12 -> 20 (les 8 nouveaux emplacements sont vides), + baseLevelFloor (plancher du niveau de maison : jamais de recul),
--   + tokens { remoteSteal }, + settings { blockFriendRavens }, puzzle étendu (step, feathers, hints, fragments) ; baseScore RECALCULÉ depuis dex avec Config.BASE_WEIGHTS2.
-- v9 : + battle { team, best, day, fights, repeats } (Arène des pets : équipe, meilleur étage de la tour, compteurs du jour).
-- v11 (LOT 9) : 10 raretés. Raretés d'œufs (slots, tapis privé, journal des vols, quêtes) remappées par Config.TIER_MIGRATE ; étage de la tour remappé
--   (5 étages par rareté de Config.TOWER.tiers) ; pets : espèce inchangée, + x = 0 (XP, lot 12) ; baseScore conservé (mêmes poids pour les raretés
--   migrées) et plancher de niveau = niveau atteint avec les seuils v10 (jamais de recul) ; + titles { oldCosmic } (Cosmique découvert),
--   + firstSeen / lastSeen (jours UTC, mesure de rétention). Pièces, reçus, jetons, énigme, temps de jeu, PvP : inchangés.
-- LOT 9b (calendrier de 30 jours) : SANS changement de version (v11 reste v11, aucun serveur ancien ne bascule en lecture seule). Champs facultatifs assainis par merge() :
--   cal (voir Calendar.sanitize : start, cycle, days, grace, catch, qc, dayD, dayN), calStreak (série), calLast (dernier jour UTC réclamé), scrolls (parchemins), plumes,
--   fightTokens (jetons de combat), cosm { id = true } (cosmétiques), titles.cal10 / cal25 / cal30. Un profil v11 sans ces champs reçoit les valeurs neuves ; un profil
--   plus ancien passe par la chaîne de migrations puis reçoit les mêmes valeurs neuves.
local VERSION = 11

-- Anciens poids et seuils de la progression de la base (profils v8 et v9) : servent UNIQUEMENT aux migrations (score de v8, plancher de niveau de v10).
local LEGACY_WEIGHTS = { 1, 3, 8, 20, 50, 150 }
local LEGACY_THRESHOLDS = { 0, 12, 40, 110, 260, 600, 1400, 3200 }
local function legacyLevel(score)
	local level = 1
	for i, t in ipairs(LEGACY_THRESHOLDS) do
		if score >= t then
			level = i
		end
	end
	return level
end
-- Score de base d'après la collection : somme (nombre obtenu par espèce x poids de la rareté) avec la table de poids donnée.
-- Ancien indice de rareté (1..6) d'une rareté du lot 9 (inverse de Config.TIER_MIGRATE ; une rareté nouvelle prend l'ancienne inférieure).
local oldTier = Config.oldTier
-- `legacy` : table de poids indexée par l'ANCIENNE rareté (1..6), pour les migrations antérieures à v11.
local function scoreFromDex(dex, weights, legacy)
	local score = 0
	if type(dex) == "table" then
		for k, e in pairs(dex) do
			local def = Config.PETS[tonumber(k) or 0]
			if def and type(e) == "table" and type(e.n) == "number" and e.n == e.n and e.n > 0 and e.n < 1e9 then
				local t = legacy and oldTier(def.tier) or def.tier
				score += math.floor(e.n) * weights[math.min(math.max(t, 1), #weights)]
			end
		end
	end
	return score
end
-- Seuils et conditions de rareté des niveaux de maison de la v10 (lot 5) : servent à garder le niveau atteint avant le recalibrage du lot 9.
local V10_LEVELS = { { score = 0 }, { score = 15 }, { score = 60 }, { score = 200 }, { score = 600 }, { score = 1000 }, { score = 5000, needOld = 4 }, { score = 14000, needOld = 5 } }
local V10_WEIGHTS = { 1, 4, 15, 50, 180, 700 }
local function v10Level(score, dex)
	score = (type(score) == "number" and score == score and score > 0) and score or 0
	local top = 0
	if type(dex) == "table" then
		for k, e in pairs(dex) do
			local def = Config.PETS[tonumber(k) or 0]
			if def and type(e) == "table" and type(e.n) == "number" and e.n == e.n and e.n > 0 then
				top = math.max(top, oldTier(def.tier))
			end
		end
	end
	local level = 1
	for i = 2, #V10_LEVELS do
		local lv = V10_LEVELS[i]
		if score < lv.score or (lv.needOld and top < lv.needOld) then
			break
		end
		level = i
	end
	return level
end
-- Remappe une ancienne rareté (1..6) ; nil si invalide.
local function remapTier(t)
	if type(t) == "number" and t == t and t % 1 == 0 and t >= 1 and t <= #Config.TIER_MIGRATE then
		return Config.TIER_MIGRATE[t]
	end
	return nil
end

-- Studio sans accès aux API (réglage « Enable Studio Access to API Services » désactivé) : détecté à la première erreur précise,
-- puis le jeu passe en mode mémoire (aucune sauvegarde, aucun classement) avec UN seul avertissement. Ne concerne pas les vrais serveurs.
local apiBlocked = false
local function markApiBlocked(err)
	if Diag.isStudioApiError(err) then
		if not apiBlocked then
			apiBlocked = true
			warn("[Data] Studio sans accès aux API : mode mémoire (rien n'est sauvegardé, pas de classement). Pour tester les sauvegardes : Game Settings > Security > Enable Studio Access to API Services.")
		end
		return true
	end
	return false
end

local Data = {}
Data.VERSION = VERSION
Data.oldTier = oldTier
Data.SERVER_ID = HttpService:GenerateGUID(false)

local store, board, castleBoard, pvpStore, pvpBoard
do
	pcall(function()
		pvpStore = DataStoreService:GetDataStore("ChipeOeufs_Pvp_v1")
		pvpBoard = DataStoreService:GetOrderedDataStore("ChipeOeufs_PvpBoard_v1")
	end)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	local ok2, result2 = pcall(function()
		return DataStoreService:GetOrderedDataStore(BOARD_NAME)
	end)
	if ok2 then
		board = result2
	end
	local ok3, result3 = pcall(function()
		return DataStoreService:GetOrderedDataStore(CASTLE_NAME)
	end)
	if ok3 then
		castleBoard = result3
	end
end

function Data.default()
	local d = {
		ver = VERSION,
		coins = Config.START_COINS,
		speed = 0,
		rb = 0,
		up = {},
		slots = {},
		dex = {}, -- clé = tostring(index d'espèce)
		daily = 0, -- dernier jour réclamé (os.time() // 86400)
		streak = 0,
		stolen = 0,
		hatched = 0,
		last = os.time(),
		equip = {}, -- indices d'emplacements dont le pet suit le joueur
		quests = {}, -- missions du jour
		qday = 0,
		receipts = {}, -- achats Robux déjà traités (anti-double crédit)
		luckUntil = 0,
		story = { ch = 0, prog = 0 }, -- ch = chapitres réussis, prog = progression du chapitre en cours
		pity = 0,
		puzzle = { day = 0, solved = 0, step = 0, feathers = 0, hints = 0, fragments = 0, pday = 0, met = false }, -- day = dernier jour résolu ; step 0..3 ; feathers = masque de bits des 4 plumes ; hints du jour ; fragments cumulés
		ach = {}, -- id de succès -> palier déjà réclamé
		cine = {}, -- id de cinématique -> true une fois vue ou passée
		baseScore = 0, -- progression de la base
		titles = { oldCosmic = false, cal10 = false, cal25 = false, cal30 = false }, -- lot 9 : titre permanent « Ancien Cosmique » ; lot 9b : titres du calendrier
		cal = Calendar.newState(Config), -- lot 9b : calendrier de 30 jours (voir Calendar.lua)
		calStreak = 0, -- lot 9b : série de jours consécutifs réclamés (cycle en cours)
		calLast = 0, -- lot 9b : dernier jour UTC où une récompense du calendrier a été réclamée
		scrolls = 0, -- lot 9b : parchemins
		plumes = 0, -- lot 9b : plumes (monnaie du calendrier, distinctes des plumes de l'énigme)
		fightTokens = 0, -- lot 9b : jetons de combat
		cosm = {}, -- lot 9b : cosmétiques obtenus { id = true }
		firstSeen = 0, -- lot 9 : jour UTC de la première connexion (mesure de rétention, aucune donnée personnelle)
		lastSeen = 0, -- lot 9 : jour UTC de la dernière connexion
		baseLevelFloor = 1, -- plancher du niveau de maison (migration v10 : le niveau atteint en v9 ne recule jamais)
		tokens = { remoteSteal = 0 }, -- jetons du Corbeau chipeur (vol à distance)
		settings = { blockFriendRavens = false }, -- réglages du joueur
		raven = { day = 0, n = 0, cd = 0, sh = 0, ic = 0, icDay = 0 }, -- lot 7b : ic = indemnités de corbeau reçues le jour UTC icDay (plafonnées) ; lot 7 : vols à distance réussis ce jour UTC (day, n), fin du délai de la victime (cd) et du bouclier post-vol (sh), en os.time()
		stealLog = {}, -- journal « Qui m'a volé ? » : 10 entrées { n = nom, t = rareté, at = os.time(), k = "p" (physique) | "r" (corbeau) }
		srvBuff = { g = 0, l = 0 }, -- lot 7b : fin (os.time) du tapis doré / de la pluie de chance offerts par ce joueur, écrite à la FERMETURE du serveur et rendue une fois à son retour
		pb = {}, -- œufs en attente sur le tapis privé (raretés), 3 au plus
		played = 0, -- temps de jeu cumulé en secondes (protection débutant, lot 4 : champ facultatif assaini, sans changement de version)
		newbieOff = false, -- fin anticipée de la protection débutant (action newbieOff)
		battle = { team = {}, best = 0, day = 0, fights = 0, repeats = 0, pvp = { season = 0, trophies = 0, wins = 0, losses = 0, defense = {}, day = 0, fights = 0 } }, -- Arène des pets
		pendingAway = 0, -- gains hors ligne à récupérer d'un clic (plafonnés à Config.IDLE.offlineMaxSeconds)
		starter = false, -- pack de départ déjà acheté (achat unique)
		secrets = {}, -- id de secret -> jour (os.time() // 86400) de la dernière fouille
	}
	for _, u in ipairs(Config.UPGRADES) do
		d.up[u.key] = 0
	end
	for i = 1, SLOT_COUNT do
		d.slots[i] = false
	end
	d.slots[1] = { k = "e", t = 1, ends = os.time() + Config.FIRST_EGG_SECONDS, shield = 0, rv = true } -- œuf de départ (gratuit : non indemnisable)
	return d
end

-- Garde-fou contre les valeurs corrompues (NaN, infini, négatif)
local function sane(v, default)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge or v < 0 then
		return default
	end
	return v
end

-- Migrations successives : chaque étape fait passer les données de la version n à n+1.
local MIGRATIONS = {
	[10] = function(saved)
		-- v10 -> v11 (lot 9) : voir l'en-tête. Aucun pet, œuf, pièce, reçu ni jeton n'est perdu ; le niveau de maison ne baisse jamais.
		if type(saved.slots) == "table" then
			for i, sl in pairs(saved.slots) do
				if type(sl) == "table" and sl.k == "e" then
					sl.t = remapTier(sl.t) or 1
				elseif type(sl) == "table" and sl.k == "p" then
					sl.x = 0
				end
				saved.slots[i] = sl
			end
		end
		if type(saved.pb) == "table" then
			for i, t in ipairs(saved.pb) do
				saved.pb[i] = remapTier(t) or 1
			end
		end
		if type(saved.stealLog) == "table" then
			for _, e in ipairs(saved.stealLog) do
				if type(e) == "table" then
					e.t = remapTier(e.t) or e.t
				end
			end
		end
		if type(saved.quests) == "table" then
			for _, q in ipairs(saved.quests) do
				if type(q) == "table" and type(q.re) == "number" and q.re > 0 then
					q.re = remapTier(math.floor(q.re)) or 0
				end
			end
		end
		if type(saved.battle) == "table" and type(saved.battle.best) == "number" and saved.battle.best == saved.battle.best and saved.battle.best >= 1 then
			local f = math.min(30, math.floor(saved.battle.best))
			local old, pos = 1 + (f - 1) // 5, (f - 1) % 5
			local idx = 1
			for i, t in ipairs(Config.TOWER.tiers) do
				if t == Config.TIER_MIGRATE[old] then
					idx = i
				end
			end
			saved.battle.best = (idx - 1) * 5 + pos + 1
		end
		-- score de maison CONSERVÉ (les poids des raretés migrées sont identiques) ; le niveau atteint avec les seuils v10 devient le plancher
		local floorBefore = math.floor(tonumber(saved.baseLevelFloor) or 1)
		saved.baseLevelFloor = math.max(floorBefore == floorBefore and floorBefore or 1, v10Level(saved.baseScore, saved.dex))
		local cosmic = false
		if type(saved.dex) == "table" then
			for k, e in pairs(saved.dex) do
				local def = Config.PETS[tonumber(k) or 0]
				if def and def.tier == Config.TIER_MIGRATE[6] and type(e) == "table" and type(e.n) == "number" and e.n > 0 then
					cosmic = true
				end
			end
		end
		saved.titles = { oldCosmic = cosmic }
	end,
	[1] = function(_saved)
		-- v1 -> v2 : les nouveaux champs reçoivent leurs valeurs par défaut dans merge(), rien à convertir.
	end,
	[2] = function(_saved)
		-- v2 -> v3 : story et pity reçoivent leurs valeurs par défaut (histoire à reprendre au chapitre 1).
	end,
	[9] = function(saved)
		-- v9 -> v10 : le niveau de maison atteint (anciens seuils) devient un plancher, puis le score est RECALCULÉ depuis la collection avec les
		-- nouveaux poids (1, 4, 15, 50, 180, 700). Aucun pet, œuf, pièce ni reçu n'est touché ; les 8 nouveaux emplacements sont créés vides par merge().
		local oldScore = (type(saved.baseScore) == "number" and saved.baseScore == saved.baseScore and saved.baseScore > 0) and saved.baseScore or 0
		saved.baseLevelFloor = math.max(legacyLevel(oldScore), math.floor(tonumber(saved.baseLevelFloor) or 1))
		saved.baseScore = scoreFromDex(saved.dex, V10_WEIGHTS, true)
	end,
	[7] = function(saved)
		-- v7 -> v8 : le score de base est reconstitué d'après la collection (nombre de pets obtenus par espèce x poids de leur rareté, ANCIENS poids :
		-- la migration v9 -> v10 le recalcule ensuite et en tire le plancher de niveau).
		saved.baseScore = scoreFromDex(saved.dex, LEGACY_WEIGHTS, true)
	end,
	[6] = function(saved)
		-- v6 -> v7 : starter vaut false (pack de départ jamais acheté).
		saved.starter = saved.starter == true
	end,
	[5] = function(_saved)
		-- v5 -> v6 : secrets reçoit sa valeur par défaut (rien fouillé).
	end,
	[4] = function(_saved)
		-- v4 -> v5 : cine reçoit sa valeur par défaut (aucune cinématique vue : l'intro se jouera une fois).
	end,
	[3] = function(saved)
		-- v3 -> v4 : un nouveau chapitre (énigme) est inséré en position 8. Qui avait déjà réussi 8 chapitres ou plus
		-- garde ses acquis : on décale d'un cran pour ne pas lui faire refaire les chapitres suivants.
		if type(saved.story) == "table" and type(saved.story.ch) == "number" and saved.story.ch >= 8 then
			saved.story.ch += 1
		end
	end,
}

local function migrate(saved)
	local ver = tonumber(saved.ver) or 1
	while ver < VERSION do
		local step = MIGRATIONS[ver]
		if step then
			step(saved)
		end
		ver += 1
	end
	saved.ver = VERSION
end

-- Retourne (données, venantDUneVersionPlusRecente)
local function merge(saved)
	local d = Data.default()
	if type(saved) ~= "table" then
		return d, false
	end
	local newer = (tonumber(saved.ver) or 1) > VERSION
	if not newer then
		migrate(saved)
	end
	for _, key in ipairs({ "coins", "speed", "rb", "daily", "streak", "stolen", "hatched", "last", "qday", "luckUntil" }) do
		d[key] = sane(saved[key], d[key])
	end
	if type(saved.up) == "table" then
		for k, v in pairs(saved.up) do
			if d.up[k] ~= nil and type(v) == "number" then
				local u = Config.upgrade(k)
				d.up[k] = math.min(u and u.max or 0, math.floor(sane(v, 0)))
			end
		end
	end
	if type(saved.dex) == "table" then
		for k, e in pairs(saved.dex) do
			local idx = tonumber(k)
			if idx and Config.PETS[idx] and type(e) == "table" then
				d.dex[tostring(idx)] = { n = math.floor(sane(e.n, 0)), b = sane(e.b, 0) }
			end
		end
	end
	if type(saved.story) == "table" then
		d.story.ch = math.min(#Config.STORY, math.floor(sane(saved.story.ch, 0)))
		d.story.prog = sane(saved.story.prog, 0)
	end
	d.pity = math.min(Config.PITY_EVERY, math.floor(sane(saved.pity, 0)))
	if type(saved.puzzle) == "table" then
		d.puzzle.day = math.floor(sane(saved.puzzle.day, 0))
		d.puzzle.solved = math.floor(sane(saved.puzzle.solved, 0))
		d.puzzle.step = math.min(3, math.floor(sane(saved.puzzle.step, 0)))
		d.puzzle.feathers = math.min(15, math.floor(sane(saved.puzzle.feathers, 0))) -- masque de bits : Nord 1, Est 2, Sud 4, Ouest 8
		d.puzzle.hints = math.min(99, math.floor(sane(saved.puzzle.hints, 0)))
		d.puzzle.fragments = math.min(9999, math.floor(sane(saved.puzzle.fragments, 0)))
		d.puzzle.pday = math.floor(sane(saved.puzzle.pday, 0)) -- jour de la progression intermédiaire (lot 6) : un autre jour = remise à zéro
		d.puzzle.met = saved.puzzle.met == true -- la Mère Poule a déjà fait sa présentation (une fois dans la vie du profil)
	end
	if type(saved.tokens) == "table" then
		d.tokens.remoteSteal = math.min(Config.REMOTE_STEAL.tokenMax, math.floor(sane(saved.tokens.remoteSteal, 0)))
	end
	if type(saved.raven) == "table" then
		local rv = saved.raven
		d.raven.day = math.max(0, math.floor(sane(rv.day, 0)))
		d.raven.n = math.min(Config.REMOTE_STEAL.dailyMax, math.max(0, math.floor(sane(rv.n, 0))))
		d.raven.cd = math.min(4e9, math.max(0, sane(rv.cd, 0)))
		d.raven.sh = math.min(4e9, math.max(0, sane(rv.sh, 0)))
		d.raven.icDay = math.max(0, math.floor(sane(rv.icDay, 0)))
		d.raven.ic = math.min(Config.EGG_PRICE[Config.REMOTE_STEAL.compensationCapTier], math.max(0, sane(rv.ic, 0)))
	end
	if type(saved.srvBuff) == "table" then -- champ facultatif assaini : une fin lointaine est ramenée au plafond cumulable
		local nowt = os.time()
		d.srvBuff.g = math.min(nowt + Config.BELT.golden.maxSeconds, math.floor(sane(saved.srvBuff.g, 0)))
		d.srvBuff.l = math.min(nowt + Config.SERVER_LUCK.maxSeconds, math.floor(sane(saved.srvBuff.l, 0)))
	end
	if type(saved.stealLog) == "table" then
		for _, e in ipairs(saved.stealLog) do
			if type(e) == "table" and type(e.n) == "string" and type(e.t) == "number" and e.t % 1 == 0 and e.t >= 1 and e.t <= #Config.TIERS and (e.k == "p" or e.k == "r") and #d.stealLog < Config.REMOTE_STEAL.logMax then
				d.stealLog[#d.stealLog + 1] = { n = string.sub(e.n, 1, 24), t = e.t, at = math.min(4e9, math.max(0, sane(e.at, 0))), k = e.k }
			end
		end
	end
	if type(saved.pb) == "table" then
		for _, t in ipairs(saved.pb) do
			if type(t) == "number" and t % 1 == 0 and t >= 1 and t <= #Config.TIERS and #d.pb < Config.BELT.private.pending then
				d.pb[#d.pb + 1] = t
			end
		end
	end
	if type(saved.settings) == "table" then
		d.settings.blockFriendRavens = saved.settings.blockFriendRavens == true
	end
	if type(saved.secrets) == "table" then
		for _, sct in ipairs(Config.SECRETS) do
			d.secrets[sct.id] = math.floor(sane(saved.secrets[sct.id], 0))
		end
	end
	if type(saved.cine) == "table" then
		for _, id in ipairs(Config.CINE_IDS) do
			d.cine[id] = saved.cine[id] == true
		end
	end
	if type(saved.ach) == "table" then
		for _, a in ipairs(Config.ACHIEVEMENTS) do
			d.ach[a.id] = math.min(#a.goals, math.floor(sane(saved.ach[a.id], 0)))
		end
	end
	d.starter = saved.starter == true
	d.baseScore = math.max(0, math.floor(sane(saved.baseScore, 0)))
	d.baseLevelFloor = math.min(#Config.BASE_LEVELS2, math.max(1, math.floor(sane(saved.baseLevelFloor, 1))))
	d.played = math.min(1e9, sane(saved.played, 0))
	d.titles.oldCosmic = type(saved.titles) == "table" and saved.titles.oldCosmic == true
	for id in pairs(Config.CALENDAR.titles) do -- lot 9b : titres du calendrier (assainis : booléens)
		d.titles[id] = type(saved.titles) == "table" and saved.titles[id] == true
	end
	d.cal = Calendar.sanitize(Config, saved.cal)
	d.calStreak = Calendar.int(saved.calStreak, 0, Config.CALENDAR.days, 0)
	d.calLast = Calendar.int(saved.calLast, 0, 1e6, 0)
	d.scrolls = Calendar.int(saved.scrolls, 0, Config.CALENDAR.caps.scrolls, 0)
	d.plumes = Calendar.int(saved.plumes, 0, Config.CALENDAR.caps.plumes, 0)
	d.fightTokens = Calendar.int(saved.fightTokens, 0, Config.CALENDAR.caps.tokens, 0)
	if type(saved.cosm) == "table" then
		for id in pairs(Config.CALENDAR.cosmetics) do
			d.cosm[id] = saved.cosm[id] == true or nil
		end
	end
	d.firstSeen = math.min(1e6, math.floor(sane(saved.firstSeen, 0)))
	d.lastSeen = math.min(1e6, math.floor(sane(saved.lastSeen, 0)))
	d.newbieOff = saved.newbieOff == true
	d.pendingAway = math.max(0, sane(saved.pendingAway, 0))
	if type(saved.battle) == "table" then
		local b = saved.battle
		local team, seen = {}, {}
		if type(b.team) == "table" then
			for _, v in ipairs(b.team) do
				if type(v) == "number" and v == v and v % 1 == 0 and v >= 1 and v <= SLOT_COUNT and not seen[v] and #team < 3 then
					seen[v] = true
					team[#team + 1] = v
				end
			end
		end
		local pv = type(b.pvp) == "table" and b.pvp or {}
		local defense = {}
		if type(pv.defense) == "table" then
			for _, e in ipairs(pv.defense) do
				if type(e) == "table" and Data.validPet(e) and #defense < 3 then
					defense[#defense + 1] = { p = e.p, s = e.s, m = e.m }
				end
			end
		end
		d.battle = {
			pvp = {
				season = math.floor(sane(pv.season, 0)), trophies = math.min(100000, math.floor(sane(pv.trophies, 0))), wins = math.min(1e7, math.floor(sane(pv.wins, 0))),
				losses = math.min(1e7, math.floor(sane(pv.losses, 0))), defense = defense, day = math.floor(sane(pv.day, 0)), fights = math.min(1000, math.floor(sane(pv.fights, 0))),
			},
			team = team,
			best = math.min(Config.TOWER.floors, math.floor(sane(b.best, 0))),
			day = math.floor(sane(b.day, 0)),
			fights = math.min(1000, math.floor(sane(b.fights, 0))),
			repeats = math.min(1000, math.floor(sane(b.repeats, 0))),
		}
	end
	if type(saved.receipts) == "table" then
		d.receipts = saved.receipts
	end
	if type(saved.equip) == "table" then
		for _, v in ipairs(saved.equip) do
			if type(v) == "number" and v >= 1 and v <= SLOT_COUNT and v % 1 == 0 and #d.equip < Config.MAX_FOLLOWERS then
				d.equip[#d.equip + 1] = v
			end
		end
	end
	if type(saved.quests) == "table" then
		for _, q in ipairs(saved.quests) do
			if type(q) == "table" and type(q.t) == "string" and type(q.goal) == "number" then
				d.quests[#d.quests + 1] = { t = q.t, goal = q.goal, prog = tonumber(q.prog) or 0, rew = tonumber(q.rew) or 0, re = math.floor(math.min(#Config.TIERS, math.max(0, tonumber(q.re) or 0))), rb = math.floor(math.min(3600, math.max(0, tonumber(q.rb) or 0))), claimed = q.claimed == true }
			end
		end
	end
	if type(saved.slots) == "table" then
		for i = 1, SLOT_COUNT do
			local sl = saved.slots[i]
			local okT = type(sl) == "table" and ((sl.k == "e" and type(sl.t) == "number" and sl.t == sl.t and sl.t % 1 == 0 and sl.t >= 1 and sl.t <= #Config.TIERS) or (sl.k == "p" and Data.validPet(sl)))
			if okT then
				if sl.k == "p" then
					sl.x = math.min(1e7, math.floor(sane(sl.x, 0))) -- lot 9 : XP du pet (lot 12)
				end
				-- champs facultatifs du lot 7b (assainis) : rv = œuf non indemnisable (volé par corbeau, tapis privé, bienvenue), rvAt = date du dernier vol par corbeau
				sl.rv = sl.rv == true or nil
				sl.rvAt = (type(sl.rvAt) == "number" and sl.rvAt == sl.rvAt) and math.min(4e9, math.max(0, sl.rvAt)) or nil
				d.slots[i] = sl
			else
				d.slots[i] = false
			end
		end
	end
	return d, newer
end

local function key(player)
	return "P_" .. player.UserId
end

-- Enregistrement stocké : { v = données, lock = idServeur, t = horodatage }. Les anciennes sauvegardes (données brutes) sont migrées.
local function unwrap(rec)
	if type(rec) ~= "table" then
		return nil
	end
	if rec.v ~= nil then
		return rec.v
	end
	return rec
end

local function lockedByOther(rec)
	return type(rec) == "table" and rec.lock ~= nil and rec.lock ~= Data.SERVER_ID and os.time() - (tonumber(rec.t) or 0) < LOCK_TTL
end

-- Retourne (données, nePasSauvegarder). Données = nil si impossible de charger sans risque.
function Data.load(player)
	if not store or apiBlocked then
		return Data.default(), true
	end
	for attempt = 1, 8 do
		local lockedElsewhere = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old)
				if lockedByOther(old) then
					lockedElsewhere = true
					return nil -- annule l'écriture
				end
				return { v = unwrap(old), lock = Data.SERVER_ID, t = os.time() }
			end)
		end)
		if ok and not lockedElsewhere then
			local d, newer = merge(unwrap(result))
			if newer then
				warn("[Data] " .. player.Name .. " : données d'une version plus récente du jeu, sauvegarde désactivée pour ne rien écraser")
			end
			return d, newer
		end
		if ok then
			warn("[Data] " .. player.Name .. " est encore verrouillé sur un autre serveur (" .. attempt .. "/8)")
			task.wait(4)
		elseif markApiBlocked(result) then
			return Data.default(), true
		else
			warn("[Data] Chargement échoué (" .. attempt .. "/8) : " .. tostring(result))
			task.wait(1.5)
		end
	end
	if RunService:IsStudio() then
		return Data.default(), true -- Studio sans accès API : on joue sans sauvegarder
	end
	return nil, true
end

local saving = {} -- clé -> true tant qu'une sauvegarde de cette clé est en cours (évite les écritures concurrentes)

-- release = true : libère le verrou (départ du joueur). Refuse d'écrire si un autre serveur a pris le verrou.
-- Réessaie jusqu'à SAVE_RETRIES fois. Retourne true si la sauvegarde a réussi.
function Data.save(player, d, release)
	if not store or not d or apiBlocked then
		return false
	end
	local k = key(player)
	local waited = 0
	while saving[k] and waited < 8 do
		task.wait(0.25)
		waited += 0.25
	end
	saving[k] = true
	d.last = os.time()
	d.ver = VERSION
	-- Le JSON ne supporte ni NaN ni l'infini : une seule valeur invalide rendrait la sauvegarde impossible pour toujours.
	for _, f in ipairs({ "coins", "speed" }) do
		local v = d[f]
		if type(v) ~= "number" or v ~= v or v < 0 then
			d[f] = 0
		elseif v > 1e300 then
			d[f] = 1e300
		end
	end
	local success = false
	for attempt = 1, SAVE_RETRIES do
		local abort = false
		local ok, err = pcall(function()
			store:UpdateAsync(k, function(old)
				if lockedByOther(old) then
					abort = true
					return nil
				end
				local rec = { v = d, t = os.time() }
				if not release then
					rec.lock = Data.SERVER_ID
				end
				return rec
			end)
		end)
		if ok and not abort then
			success = true
			break
		end
		if abort then
			warn("[Data] " .. player.Name .. " : verrou pris par un autre serveur, sauvegarde annulée")
			break
		end
		if markApiBlocked(err) then
			break
		end
		warn("[Data] Sauvegarde échouée pour " .. player.Name .. " (" .. attempt .. "/" .. SAVE_RETRIES .. ") : " .. tostring(err))
		task.wait(1.5 * attempt)
	end
	saving[k] = nil
	return success
end

---------------------------------------------------------------- Journal serveur du Corbeau (RavenLog)
-- Une clé par jour UTC ("D<jour>") contenant au plus RAVEN_LOG_MAX entrées { thief, victim, tier, result, at } ; les clés de plus de Config.REMOTE_STEAL.logDays jours
-- sont effacées (au mieux, une fois par serveur et par jour). Tout est dans un pcall : un échec ne bloque JAMAIS le jeu.
local RAVEN_LOG_MAX = 400
local ravenLogStore, ravenPruned, ravenPruneTry = nil, nil, -1000
-- Écrit un LOT d'entrées (liste) : UpdateAsync réessayé au plus Config.REMOTE_STEAL.logTries fois (attente 2 s, 4 s...), puis abandon (retourne false : l'appelant jette le lot et prévient).
-- Le nettoyage des vieilles clés (RemoveAsync) est SÉPARÉ : son échec ne remet jamais en cause (ni ne duplique) une écriture réussie, et il est retenté au plus toutes les 5 min.
function Data.logRavenBatch(entries)
	if apiBlocked or type(entries) ~= "table" or #entries == 0 then
		return false
	end
	if not ravenLogStore then
		local okS, st = pcall(function()
			return DataStoreService:GetDataStore("RavenLog")
		end)
		if not okS then
			return false
		end
		ravenLogStore = st
	end
	local now = os.time()
	local written = false
	for attempt = 1, Config.REMOTE_STEAL.logTries do
		local ok, err = pcall(function()
			ravenLogStore:UpdateAsync(Raven.dayKey(now), function(old)
				local list = type(old) == "table" and old or {}
				for _, e in ipairs(entries) do
					list[#list + 1] = e
				end
				while #list > RAVEN_LOG_MAX do
					table.remove(list, 1)
				end
				return list
			end)
		end)
		if ok then
			written = true
			break
		end
		if markApiBlocked(err) then
			return false
		end
		warn("[RavenLog] écriture échouée (" .. attempt .. "/" .. Config.REMOTE_STEAL.logTries .. ") : " .. tostring(err))
		if attempt < Config.REMOTE_STEAL.logTries then
			task.wait(2 * attempt)
		end
	end
	if not written then
		return false
	end
	local day = Raven.day(now)
	if ravenPruned ~= day and os.clock() - ravenPruneTry >= 300 then
		ravenPruneTry = os.clock()
		local okP, errP = pcall(function()
			ravenLogStore:RemoveAsync(Raven.expiredKey(now, Config.REMOTE_STEAL.logDays))
		end)
		if okP then
			ravenPruned = day
		else
			warn("[RavenLog] nettoyage des vieilles clés échoué (retenté plus tard, l'écriture est conservée) : " .. tostring(errP))
		end
	end
	return true
end
function Data.logRaven(entry)
	if type(entry) ~= "table" then
		return false
	end
	return Data.logRavenBatch({ entry })
end

---------------------------------------------------------------- Classement global
-- Un pet { p, s, m } est-il valide (espèce, taille et mutation existantes, entiers) ?
function Data.validPet(e)
	return type(e) == "table" and type(e.p) == "number" and type(e.s) == "number" and type(e.m) == "number" and e.p % 1 == 0 and e.s % 1 == 0 and e.m % 1 == 0
		and Config.PETS[e.p] ~= nil and Config.SIZES[e.s] ~= nil and Config.MUTS[e.m] ~= nil
end

function Data.score(d)
	return d.rb * Config.SCORE_UNIT + math.min(d.hatched, Config.SCORE_UNIT - 1)
end

function Data.submit(player, d)
	if not board or apiBlocked then
		return
	end
	local ok, err = pcall(function()
		board:SetAsync(tostring(player.UserId), math.floor(Data.score(d)))
	end)
	if not ok then
		markApiBlocked(err)
	end
end

-- Classement des temps du mode Château : valeur = centièmes de seconde, le plus petit est le meilleur ; seul le meilleur temps d'un joueur est gardé.
function Data.castleSubmit(player, seconds)
	if not castleBoard or apiBlocked or type(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 then
		return false
	end
	local value = math.max(1, math.floor(seconds * 100 + 0.5))
	local ok, err = pcall(function()
		castleBoard:UpdateAsync(tostring(player.UserId), function(old)
			if type(old) == "number" and old <= value then
				return nil
			end
			return value
		end)
	end)
	if not ok then
		markApiBlocked(err)
	end
	return ok
end

local nameCache = {}
local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and n or ("Joueur " .. userId)
	return nameCache[userId]
end

-- Meilleurs temps du Château : liste { {name=, time=secondes}, ... } triée (peut être vide).
function Data.castleTop(count)
	local out = {}
	if not castleBoard or apiBlocked then
		return out
	end
	local ok, page = pcall(function()
		return castleBoard:GetSortedAsync(true, count):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return out
	end
	for _, e in ipairs(page) do
		local v = type(e) == "table" and e.value
		-- entrées invalides (valeur non numérique, négative, nulle, NaN ou infinie) ignorées ; ex aequo : l'ordre du classement est conservé
		if type(v) == "number" and v == v and v > 0 and v < 1e9 then
			out[#out + 1] = { name = nameOf(tonumber(e.key) or 0), time = v / 100 }
		end
	end
	return out
end

-- Retourne une liste { {name=, rb=, hatched=}, ... } (peut être vide)
function Data.top(count)
	local out = {}
	if not board or apiBlocked then
		return out
	end
	local ok, page = pcall(function()
		return board:GetSortedAsync(false, count):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return out
	end
	for _, e in ipairs(page) do
		local score = tonumber(e.value) or 0
		out[#out + 1] = {
			name = nameOf(tonumber(e.key) or 0),
			rb = score // Config.SCORE_UNIT,
			hatched = score % Config.SCORE_UNIT,
		}
	end
	return out
end

-- PvP asynchrone : publie l'équipe de défense (écrite par le SERVEUR seul) et les trophées de la saison. Retourne true si enregistré.
function Data.pvpPublish(player, team, trophies, season)
	if not pvpStore or apiBlocked then
		return false
	end
	local ok, err = pcall(function()
		pvpStore:SetAsync("D_" .. player.UserId, { name = player.DisplayName, team = team, season = season, t = os.time() })
		if pvpBoard then
			pvpBoard:SetAsync(season .. "_" .. player.UserId, math.max(0, math.floor(trophies)))
		end
	end)
	if not ok then
		markApiBlocked(err)
	end
	return ok
end

-- Adversaire de la saison au plus près de `trophies` (hors `userId`) : { name, team = { {p,s,m} }, trophies } ou nil (le serveur prend alors un adversaire fantôme).
function Data.pvpOpponent(userId, trophies, season, salt)
	if not pvpStore or not pvpBoard or apiBlocked then
		return nil
	end
	local ok, page = pcall(function()
		return pvpBoard:GetSortedAsync(false, 100):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return nil
	end
	local cands = {}
	local prefix = season .. "_"
	for _, e in ipairs(page) do
		local key = type(e) == "table" and tostring(e.key) or ""
		local uid = key:sub(1, #prefix) == prefix and tonumber(key:sub(#prefix + 1)) or nil
		if uid and uid ~= userId and type(e.value) == "number" then
			cands[#cands + 1] = { uid = uid, trophies = e.value, d = math.abs(e.value - trophies) }
		end
	end
	table.sort(cands, function(a, b)
		if a.d ~= b.d then
			return a.d < b.d
		end
		return a.uid < b.uid
	end)
	for k = 0, math.min(#cands - 1, 4) do -- parmi les 5 plus proches, tournant selon `salt`
		local c = cands[((k + (salt or 0)) % math.min(#cands, 5)) + 1]
		local ok2, rec = pcall(function()
			return pvpStore:GetAsync("D_" .. c.uid)
		end)
		if ok2 and type(rec) == "table" and type(rec.team) == "table" then
			local team = {}
			for _, e in ipairs(rec.team) do
				if Data.validPet(e) and #team < 3 then
					team[#team + 1] = { p = e.p, s = e.s, m = e.m }
				end
			end
			if #team > 0 then
				return { name = tostring(rec.name or ("Joueur " .. c.uid)):sub(1, 24), team = team, trophies = c.trophies }
			end
		end
	end
	return nil
end

-- Classement de la saison : { {name, trophies} } (peut être vide).
function Data.pvpTop(season, count)
	local out = {}
	if not pvpBoard or apiBlocked then
		return out
	end
	local ok, page = pcall(function()
		return pvpBoard:GetSortedAsync(false, 100):GetCurrentPage()
	end)
	if not ok then
		markApiBlocked(page)
		return out
	end
	local prefix = season .. "_"
	for _, e in ipairs(page) do
		local key = type(e) == "table" and tostring(e.key) or ""
		if key:sub(1, #prefix) == prefix and type(e.value) == "number" and #out < count then
			out[#out + 1] = { name = nameOf(tonumber(key:sub(#prefix + 1)) or 0), trophies = e.value }
		end
	end
	return out
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Builder
-- Construit TOUT le visuel avec des Parts, matériaux et particules de base Roblox (aucun asset externe).
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Scenery = require(script.Parent:WaitForChild("Scenery"))
local Castle = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Castle"))
local GuardMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Guard")) -- pose de marche
local AssetsMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets")) -- fonctions pures (fitHeight)
local PlacementMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Placement")) -- pose planifiée du décor
local MapGeoMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("MapGeo")) -- géométrie de la carte 700 x 500 (REFONTE lot 2)
local TrapsMod = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Traps")) -- plan des pièges des territoires (REFONTE lot 4)
PlacementMod.MapGeo = MapGeoMod
PlacementMod.yield = function()
	task.wait()
end

local Builder = {}

local FONT = Enum.Font.GothamBold
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function ball(props, parent)
	props.Shape = Enum.PartType.Ball
	props.CanCollide = false
	return part(props, parent)
end

local function sign(adornee, text, color, offsetY, width)
	local g = Instance.new("BillboardGui")
	g.Name = "Label"
	g.Adornee = adornee
	g.Size = UDim2.fromOffset(width or 200, 56)
	g.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	g.MaxDistance = 70
	g.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = FONT
	t.TextSize = 18
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.2
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	t.Text = text
	t.Parent = g
	g.Parent = adornee
	return t
end
Builder.sign = sign

---------------------------------------------------------------- Œuf
-- Chargeur de modèles d'œufs (module Assets, branché par Main). Nil = apparence par défaut partout.
local eggAssets = nil
local builtPlots = {} -- bases des joueurs (Builder.build) pour le dallage
local builtCastle = nil -- monde du château (Scenery.castle) pour l'habillage Blender différé
local builtGuards = {} -- { model, rival } des gardiens construits (habillage Blender différé)
function Builder.setAssets(a)
	eggAssets = a
end

-- Habille l'œuf `p` avec une copie du modèle Roblox de sa rareté : la Part reste la racine (tags, prompts, soudure au joueur, animations),
-- elle devient invisible et le modèle y est soudé par des Weld enfants des parts du modèle (pas de Weld direct sur l'œuf : l'animation de
-- course cherche le Weld du joueur). Retourne true si le modèle est en place ; en cas d'erreur, tout est défait (apparence par défaut).
local function dressEgg(p, tier)
	local clone = eggAssets and eggAssets.cloneEgg(tier)
	if not clone then
		return false
	end
	local ok = pcall(function()
		if not clone:IsA("Model") then
			error("pas un Model")
		end
		-- lot 9 : échelle d'après la pièce `Coque` (couronne, auréole et ailes dépassent), repli sur le modèle entier
		local fitted, why = AssetsMod.fitByPart(clone, Config.Assets.eggShellPart or "Coque", Config.eggHeight(tier))
		if not fitted then
			error(why)
		end
		-- plafond relatif à l'emplacement et au joueur : un modèle très large ou trop haut est ramené à la borne (jamais d'œuf géant)
		local ext = clone:GetExtentsSize()
		local f = Config.fitScale({ X = ext.X, Y = ext.Y, Z = ext.Z }, Config.eggMaxSize())
		if f < 1 then
			clone:ScaleTo(clone:GetScale() * f)
		end
		local cf = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new() * cf:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				local w = Instance.new("Weld")
				w.Part0 = p
				w.Part1 = d
				w.C0 = d.CFrame
				w.Parent = d
			end
		end
		-- lot 9 : coques de verre (Ultra Rare, Divin) forcées par le code (pièce `Coque` non nommée « Verre » dans le modèle)
		local look = Config.eggLook(tier)
		if look and look.glass then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") and AssetsMod.baseName(d.Name) == (Config.Assets.eggShellPart or "Coque") then
					d.Material = Enum.Material.Glass
					d.Transparency = look.glass
				end
			end
		end
		clone.Name = "Skin"
		clone.Parent = p
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return false
	end
	p.Transparency = 1
	return true
end

-- Halo décoratif soudé à l'œuf (sphère translucide ou anneau). Le client le fait tourner / scintiller (tag EggHalo, attributs Spin / Flicker).
local function addHalo(p, h)
	local halo = Instance.new("Part")
	halo.Name = "Halo"
	halo.Material = Enum.Material.Neon
	halo.Color = h.color
	halo.Transparency = h.transparency
	halo.CanCollide = false
	halo.CanTouch = false
	halo.CanQuery = false
	halo.Massless = true
	halo.Anchored = false
	halo.CastShadow = false
	local rot = CFrame.new()
	if h.shape == "ring" then
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.14, 3.2 * h.scale, 3.2 * h.scale)
		rot = CFrame.Angles(0, 0, math.rad(90))
	else
		halo.Shape = Enum.PartType.Ball
		halo.Size = Vector3.new(3.2 * h.scale, 3.2 * h.scale, 3.2 * h.scale)
	end
	local w = Instance.new("Weld")
	w.Name = "HaloWeld"
	w.Part0 = p
	w.Part1 = halo
	w.C0 = rot
	w.Parent = halo
	halo:SetAttribute("Spin", h.spin or 0)
	halo:SetAttribute("Flicker", h.flicker == true)
	halo:SetAttribute("BaseT", h.transparency)
	CollectionService:AddTag(halo, "EggHalo")
	halo.Parent = p
end

-- Lot 9 (A.5) : détails procéduraux d'un œuf (pièces soudées, <= Config.EggFx.maxParts). L'emblème est une RUNE-ŒUF (losange creux à pointe
-- arrondie : 4 barres + 1 bille), jamais le logo Roblox. Retourne le nombre de Parts créées.
local function weldTo(p, part, cf)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	local w = Instance.new("Weld")
	w.Part0 = p
	w.Part1 = part
	w.C0 = cf
	w.Parent = part
	part.Parent = p
	return part
end
local function detailPart(name, size, color, material, shape)
	local d = Instance.new("Part")
	d.Name = name
	d.Size = size
	d.Color = color
	d.Material = material or Enum.Material.SmoothPlastic
	if shape then
		d.Shape = shape
	end
	d.TopSurface = Enum.SurfaceType.Smooth
	d.BottomSurface = Enum.SurfaceType.Smooth
	return d
end
function Builder.eggDetails(p, look)
	local n = 0
	local R, H = p.Size.X / 2, p.Size.Y / 2
	local function add(name, size, color, cf, material, shape)
		if n >= Config.EggFx.maxParts then
			return nil
		end
		n += 1
		return weldTo(p, detailPart(name, size, color, material, shape), cf)
	end
	-- emblème : rune-œuf sur la face avant (-Z)
	if look.emblem then
		local z = -R * 0.98
		for k, a in ipairs({ 35, -35, 145, -145 }) do
			local ang = math.rad(a)
			add("Embleme", Vector3.new(0.12, 0.5, 0.08), look.emblem, CFrame.new(math.sin(ang) * 0.18, 0.15 + math.cos(ang) * 0.22 * (k <= 2 and 1 or 0.7), z) * CFrame.Angles(0, 0, -ang), Enum.Material.Neon)
		end
		add("Embleme", Vector3.new(0.16, 0.16, 0.16), look.emblem, CFrame.new(0, 0.15, z), Enum.Material.Neon, Enum.PartType.Ball)
	end
	local d = look.details or {}
	local function around(count, radius, y, fn)
		for i = 1, count do
			local a = (i - 1) / count * math.pi * 2
			fn(i, CFrame.new(math.cos(a) * radius, y, math.sin(a) * radius) * CFrame.Angles(0, -a, 0))
		end
	end
	if d.spots then
		around(d.spots.n, R * 0.92, 0.5, function(_, cf)
			add("Motif", Vector3.new(0.5, 0.5, 0.5), d.spots.color, cf, nil, Enum.PartType.Ball)
		end)
	end
	if d.pixels then
		around(d.pixels.n, R * 0.95, -0.3, function(i, cf)
			add("Motif", Vector3.new(0.3, 0.3, 0.3), d.pixels.color, cf * CFrame.new(0, (i % 2) * 0.4, 0))
		end)
	end
	if d.stripes or d.cracks or d.shards then
		local sp = d.stripes or d.cracks or d.shards
		local mat = d.cracks and Enum.Material.Neon or nil
		around(sp.n, R * 0.97, 0.2, function(i, cf)
			add(d.cracks and "Fissure" or "Motif", Vector3.new(0.12, 1.2, 0.08), sp.color, cf * CFrame.Angles(0, 0, math.rad(25 * (i % 2 == 0 and 1 or -1))), mat)
		end)
	end
	if d.ring then
		add("Anneau", Vector3.new(0.12, R * 2.6, R * 2.6), d.ring.color, CFrame.Angles(0, 0, math.rad(90 + d.ring.tilt)), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
	if d.ring2 then
		add("Anneau", Vector3.new(0.12, R * 2.6, R * 2.6), d.ring2.color, CFrame.Angles(0, math.rad(90), math.rad(90 + d.ring2.tilt)), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
	if d.groundRing then
		add("Anneau", Vector3.new(0.1, R * 3, R * 3), d.groundRing.color, CFrame.new(0, -H + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
	if d.crystals then
		around(d.crystals.n, R * 1.15, -H + 0.4, function(i, cf)
			add("Cristaux", Vector3.new(0.3, 0.7 + (i % 2) * 0.3, 0.3), d.crystals.color, cf * CFrame.Angles(math.rad(15), 0, math.rad(15)), Enum.Material.Glass)
		end)
	end
	if d.crown then
		around(5, R * 0.45, H + 0.15, function(_, cf)
			add("Couronne", Vector3.new(0.18, 0.45, 0.18), d.crown.color, cf, Enum.Material.Metal)
		end)
	end
	if d.chain then
		for i = 1, d.chain.n do
			local t = (i - 0.5) / d.chain.n
			add("Chaine", Vector3.new(0.28, 0.12, 0.2), d.chain.color, CFrame.new((t - 0.5) * R * 2.1, (0.5 - t) * H * 1.6, -R * 0.9) * CFrame.Angles(0, 0, math.rad(40 + 90 * (i % 2))), Enum.Material.Metal)
		end
	end
	if d.stars then
		around(d.stars.n, R * 1.3, H * 0.6, function(_, cf)
			add("Etoiles", Vector3.new(0.3, 0.3, 0.3), d.stars.color, cf * CFrame.Angles(math.rad(45), 0, math.rad(45)), Enum.Material.Neon)
		end)
	end
	if d.wings then
		for _, sx in ipairs({ -1, 1 }) do
			add("Ailes", Vector3.new(1.4, 1, 0.1), d.wings.color, CFrame.new(sx * (R + 0.6), 0.3, 0.3) * CFrame.Angles(0, 0, math.rad(25 * sx)))
		end
	end
	if d.halo then
		add("Aureole", Vector3.new(0.1, R * 1.4, R * 1.4), d.halo.color, CFrame.new(0, H + 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
	return n
end

-- Cubes en orbite (A.5) : soudés à un pivot invisible tagué EggHalo que le client fait tourner (Spin = tours/s x 2 pi).
local function addOrbit(p, o, budget)
	if budget <= 0 then
		return 0
	end
	local pivot = Instance.new("Part")
	pivot.Name = "Halo"
	pivot.Size = Vector3.new(0.2, 0.2, 0.2)
	pivot.Transparency = 1
	weldTo(p, pivot, CFrame.new())
	local hw = pivot:FindFirstChildOfClass("Weld")
	if hw then
		hw.Name = "HaloWeld"
	end
	pivot:SetAttribute("Spin", o.rps * math.pi * 2)
	pivot:SetAttribute("Flicker", false)
	pivot:SetAttribute("BaseT", 1)
	CollectionService:AddTag(pivot, "EggHalo")
	local count = math.min(o.n, budget - 1)
	local R = p.Size.X / 2 + 0.7
	for i = 1, count do
		local a = (i - 1) / count * math.pi * 2
		local c = detailPart("Orbite", Vector3.new(0.3, 0.3, 0.3), o.color, Enum.Material.Neon)
		weldTo(pivot, c, CFrame.new(math.cos(a) * R, 0.3 * math.sin(a * 2), math.sin(a) * R))
	end
	return count + 1
end

local function addParticles(p, pa)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(pa.color)
	e.Rate = pa.rate
	e.Lifetime = NumberRange.new(pa.life * 0.7, pa.life)
	e.Speed = NumberRange.new(pa.speed * 0.5, pa.speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, pa.size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = 0.8
	e.Parent = p
end

function Builder.egg(tier, anchored)
	local look = Config.EggFx.Enabled and Config.eggLook(tier) or nil
	local c = look and look.light or Config.TIERS[tier].color
	local p = Instance.new("Part")
	p.Name = "Egg"
	p.Size = Vector3.new(2.4, 3.2, 2.4)
	if look then
		p.Color = look.color
		p.Material = Enum.Material[look.material]
	else
		p.Color = Color3.fromRGB(255, 244, 222):Lerp(c, 0.35)
		p.Material = Enum.Material.SmoothPlastic
	end
	p.Anchored = anchored ~= false
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	local l = Instance.new("PointLight")
	l.Color = c
	l.Range = 7
	l.Brightness = look and look.brightness or 1.2
	l.Parent = p
	if dressEgg(p, tier) then
		m:Destroy() -- la sphère n'est plus visible : inutile de la garder
		l.Brightness = 1.2
	elseif look then
		local used = Builder.eggDetails(p, look)
		if look.halo and used < Config.EggFx.maxParts then
			addHalo(p, look.halo)
			used += 1
		end
		if look.orbit then
			used += addOrbit(p, look.orbit, Config.EggFx.maxParts - used)
		end
		if look.particles then
			addParticles(p, look.particles)
		end
		p:SetAttribute("EggParts", used)
		if look.glass then
			p.Transparency = look.glass
		end
	end
	if look and look.orbit and p:FindFirstChild("Skin") then
		addOrbit(p, look.orbit, Config.EggFx.maxParts) -- les effets restent dans le code, même avec le modèle Blender
	end
	if look and look.particles and p:FindFirstChild("Skin") then
		addParticles(p, look.particles)
	end
	return p
end

---------------------------------------------------------------- Pet (modèle 3D en Parts)
-- Retourne (modèle, hauteur de levage). Le modèle regarde vers -Z.
-- Habille un pet avec le modèle Blender de Config.Assets.pets si disponible (même contrat que le pet procédural : Model, PrimaryPart, hauteur de
-- levage). Retourne (modèle, levage, hauteur d'étiquette) ou nil : l'appelant garde alors le pet procédural. Ne lève jamais d'erreur.
local function customPet(petIdx, size)
	local clone = eggAssets and eggAssets.clonePet and eggAssets.clonePet(petIdx)
	if not clone then
		return nil
	end
	local ok, lift, labelY = pcall(function()
		if not clone:IsA("Model") then
			error("pas un Model")
		end
		local height = Config.petTargetHeight(Config.PETS[petIdx].tier, size.scale)
		local fitted, why = AssetsMod.fitHeight(clone, height) -- mesure, mise à l'échelle sur la hauteur cible, vérification ±10 % (sinon pet procédural)
		if not fitted then
			error(why)
		end
		local first = nil
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				first = first or d
			end
		end
		if not first then
			error("aucune part")
		end
		clone.PrimaryPart = clone.PrimaryPart or first
		clone.Name = "Pet"
		return height / 2, height + 1.2
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return nil
	end
	return clone, lift, labelY
end

function Builder.pet(petIdx, sizeIdx, mutIdx)
	local def = Config.PETS[petIdx]
	local size = Config.SIZES[sizeIdx]
	local mut = Config.MUTS[mutIdx]
	local custom, customLift, customLabel = customPet(petIdx, size)
	if custom then
		custom:SetAttribute("Tier", def.tier)
		return custom, customLift, customLabel
	end
	local R = 0.9 * math.min(size.scale, 1.6) -- pet procédural : même échelle réduite que les modèles Blender
	local model = Instance.new("Model")
	model.Name = "Pet"

	local bodyColor = def.color
	local bodyMat = Enum.Material.SmoothPlastic
	if mut.color then
		bodyColor = mut.color
		bodyMat = Enum.Material.Neon
	elseif mut.rainbow then
		bodyColor = Color3.fromRGB(255, 120, 220)
		bodyMat = Enum.Material.Neon
	end

	local body = ball({ Name = "Body", Size = Vector3.new(2 * R, 2 * R, 2 * R), CFrame = CFrame.new(0, 0, 0), Color = bodyColor, Material = bodyMat }, model)
	model.PrimaryPart = body
	local dark = Color3.fromRGB(25, 25, 30)

	local function addBall(name, off, sz, col, mat)
		return ball({ Name = name, Size = Vector3.new(sz, sz, sz), CFrame = CFrame.new(off), Color = col, Material = mat or Enum.Material.SmoothPlastic }, model)
	end
	local function addBlock(name, off, sz, col, rotZ, mat)
		return part({ Name = name, CanCollide = false, Size = sz, CFrame = CFrame.new(off) * CFrame.Angles(0, 0, rotZ or 0), Color = col, Material = mat or Enum.Material.SmoothPlastic }, model)
	end

	-- yeux
	addBall("EyeL", Vector3.new(-0.42 * R, 0.25 * R, -0.86 * R), 0.36 * R, dark)
	addBall("EyeR", Vector3.new(0.42 * R, 0.25 * R, -0.86 * R), 0.36 * R, dark)

	-- paupières (invisibles, le client les affiche à chaque clignement) et bouche (animée côté client)
	for _, side in ipairs({ { "LidL", -0.42 }, { "LidR", 0.42 } }) do
		local lid = addBall(side[1], Vector3.new(side[2] * R, 0.25 * R, -0.88 * R), 0.42 * R, bodyColor)
		lid.Transparency = 1
	end
	addBlock("Mouth", Vector3.new(0, -0.18 * R, -0.93 * R), Vector3.new(0.34 * R, 0.06 * R, 0.1 * R), dark)

	-- reflets dans les yeux, joues et pieds
	addBall("ShineL", Vector3.new(-0.46 * R, 0.34 * R, -1.0 * R), 0.13 * R, Color3.new(1, 1, 1))
	addBall("ShineR", Vector3.new(0.38 * R, 0.34 * R, -1.0 * R), 0.13 * R, Color3.new(1, 1, 1))
	if not Config.tierAtLeast(def.tier, "announce") then -- joues roses jusqu'à Épique
		addBall("CheekL", Vector3.new(-0.72 * R, -0.05 * R, -0.68 * R), 0.26 * R, Color3.fromRGB(255, 150, 170))
		addBall("CheekR", Vector3.new(0.72 * R, -0.05 * R, -0.68 * R), 0.26 * R, Color3.fromRGB(255, 150, 170))
	end
	if def.extra ~= "tentacles" then
		local footCol = bodyColor:Lerp(Color3.new(0, 0, 0), 0.25)
		addBall("FootL", Vector3.new(-0.45 * R, -0.92 * R, -0.15 * R), 0.55 * R, footCol)
		addBall("FootR", Vector3.new(0.45 * R, -0.92 * R, -0.15 * R), 0.55 * R, footCol)
	end

	-- oreilles
	local ears = def.ears
	if ears == "round" then
		addBall("EarL", Vector3.new(-0.62 * R, 0.95 * R, -0.05 * R), 0.62 * R, bodyColor)
		addBall("EarR", Vector3.new(0.62 * R, 0.95 * R, -0.05 * R), 0.62 * R, bodyColor)
	elseif ears == "long" then
		addBlock("EarL", Vector3.new(-0.4 * R, 1.5 * R, 0), Vector3.new(0.36 * R, 1.3 * R, 0.3 * R), bodyColor, 0.15)
		addBlock("EarR", Vector3.new(0.4 * R, 1.5 * R, 0), Vector3.new(0.36 * R, 1.3 * R, 0.3 * R), bodyColor, -0.15)
	elseif ears == "point" then
		addBlock("EarL", Vector3.new(-0.6 * R, 1.05 * R, 0), Vector3.new(0.4 * R, 0.8 * R, 0.3 * R), bodyColor, 0.5)
		addBlock("EarR", Vector3.new(0.6 * R, 1.05 * R, 0), Vector3.new(0.4 * R, 0.8 * R, 0.3 * R), bodyColor, -0.5)
	elseif ears == "floppy" then
		addBlock("EarL", Vector3.new(-1.0 * R, 0.35 * R, 0), Vector3.new(0.35 * R, 0.9 * R, 0.5 * R), Color3.fromRGB(110, 70, 40), 0.2)
		addBlock("EarR", Vector3.new(1.0 * R, 0.35 * R, 0), Vector3.new(0.35 * R, 0.9 * R, 0.5 * R), Color3.fromRGB(110, 70, 40), -0.2)
	end

	-- extras
	local lift = R
	local extra = def.extra
	if extra == "beak" then
		addBlock("Beak", Vector3.new(0, -0.05 * R, -1.0 * R), Vector3.new(0.5 * R, 0.3 * R, 0.5 * R), Color3.fromRGB(255, 150, 30))
	elseif extra == "tail" then
		addBall("Tail", Vector3.new(0, -0.1 * R, 1.05 * R), 0.55 * R, bodyColor)
	elseif extra == "mane" then
		addBall("Mane", Vector3.new(0, 0, 0.3 * R), 2.5 * R, Color3.fromRGB(150, 90, 30))
		body.Size = Vector3.new(1.9 * R, 1.9 * R, 1.9 * R)
	elseif extra == "horn" then
		addBlock("Horn", Vector3.new(0, 1.2 * R, -0.45 * R), Vector3.new(0.25 * R, 0.9 * R, 0.25 * R), Color3.fromRGB(255, 215, 90), 0, Enum.Material.Neon)
	elseif extra == "wings" then
		addBlock("WingL", Vector3.new(-1.1 * R, 0.35 * R, 0.3 * R), Vector3.new(0.15 * R, 1.1 * R, 1.3 * R), bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), 0.6)
		addBlock("WingR", Vector3.new(1.1 * R, 0.35 * R, 0.3 * R), Vector3.new(0.15 * R, 1.1 * R, 1.3 * R), bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), -0.6)
		addBlock("Horn", Vector3.new(0, 1.05 * R, -0.5 * R), Vector3.new(0.22 * R, 0.6 * R, 0.22 * R), Color3.fromRGB(255, 240, 200))
	elseif extra == "tentacles" then
		for i, o in ipairs({ { -0.5, -0.5 }, { 0.5, -0.5 }, { -0.5, 0.5 }, { 0.5, 0.5 } }) do
			addBlock("Tent" .. i, Vector3.new(o[1] * R, -1.25 * R, o[2] * R), Vector3.new(0.3 * R, 1.1 * R, 0.3 * R), bodyColor)
		end
		lift = 1.8 * R
	elseif extra == "antenna" then
		addBlock("Ant", Vector3.new(0, 1.3 * R, 0), Vector3.new(0.12 * R, 0.8 * R, 0.12 * R), bodyColor)
		addBall("AntTip", Vector3.new(0, 1.8 * R, 0), 0.35 * R, Color3.fromRGB(255, 80, 200), Enum.Material.Neon)
	end

	-- étincelles dorées discrètes : le pet « produit » des pièces
	local coin = Instance.new("ParticleEmitter")
	coin.Texture = SPARK
	coin.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	coin.Rate = 0.7
	coin.Lifetime = NumberRange.new(1.2, 1.8)
	coin.Speed = NumberRange.new(1, 2)
	coin.Acceleration = Vector3.new(0, 3, 0)
	coin.SpreadAngle = Vector2.new(60, 60)
	coin.LightEmission = 1
	coin.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	coin.Parent = body

	-- mutation : particules
	if mut.color or mut.rainbow then
		local e = Instance.new("ParticleEmitter")
		e.Texture = SPARK
		e.Rate = 8
		e.Lifetime = NumberRange.new(1, 2)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(180, 180)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * R), NumberSequenceKeypoint.new(1, 0) })
		if mut.rainbow then
			e.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 60)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 255, 120)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 120, 255)),
			})
		else
			e.Color = ColorSequence.new(mut.color)
		end
		e.Parent = body
	end

	-- étiquette
	model:SetAttribute("Height", lift)
	CollectionService:AddTag(model, "PetFace") -- visage animé côté client (clignement, regard, bouche)
	model:SetAttribute("Tier", def.tier) -- états des pets (capacité des raretés élevées)
	return model, lift, 2.3 * R + 1.5
end

---------------------------------------------------------------- Gardien
-- Remplace l'apparence procédurale d'un gardien par un modèle Blender : le Body devient invisible (il porte l'étiquette et sert de repère),
-- les autres Parts procédurales sont détruites, le modèle est mis à l'échelle (hauteur en studs), posé au sol sous le Body et ancré.
-- Retourne true si remplacé ; sinon le gardien procédural est conservé. Ne lève jamais d'erreur.
local function fitGuard(model, clone, height)
	local ok = pcall(function()
		local body = model.PrimaryPart
		local fitted, why = AssetsMod.fitHeight(clone, height)
		if not fitted then
			error(why)
		end
		local bbox, size2 = clone:GetBoundingBox()
		clone:PivotTo(body.CFrame * CFrame.new(0, -2.4 + size2.Y / 2, 0) * bbox:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		for _, c in ipairs(model:GetChildren()) do
			if c:IsA("BasePart") and c ~= body then
				c:Destroy()
			end
		end
		body.Transparency = 1
		local label = body:FindFirstChild("Label")
		if label then
			label.StudsOffsetWorldSpace = Vector3.new(0, height + 1.2, 0)
		end
		clone.Name = "Blender"
		clone.Parent = model
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
	end
	return ok
end

-- Pièce d'un modèle Blender par son nom de base : « Pics » et « Pics__C0C0C0 » (suffixe de couleur) désignent la même pièce.
local function findNamed(model, base)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and (d.Name == base or d.Name:match("^(.-)__%x%x%x%x%x%x$") == base) then
			return d
		end
	end
	return nil
end

-- Pose un clone de modèle Blender centré en (x, z), posé sur le sol y0, mis à l'échelle pour que sa plus grande arête horizontale vaille `span`
-- (ou, sans span, pour que sa hauteur vaille `height`), ancré, sans collision. Retourne la table { model, center } ou nil (clone détruit).
local function setModel(clone, x, y0, z, span, height, parent, rotY)
	local ok = pcall(function()
		local _, size = clone:GetBoundingBox()
		if size.Y < 0.05 then
			error("hauteur nulle")
		end
		local longest = math.max(size.X, size.Z)
		if span and longest > 0.05 then
			clone:ScaleTo(span / longest)
		elseif height then
			local fitted, why = AssetsMod.fitHeight(clone, height)
			if not fitted then
				error(why)
			end
		end
		local bbox, size2 = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new(x, y0 + size2.Y / 2, z) * CFrame.Angles(0, rotY or 0, 0) * bbox:ToObjectSpace(clone:GetPivot()))
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		clone.Parent = parent
	end)
	if not ok then
		pcall(function()
			clone:Destroy()
		end)
		return false
	end
	return true
end

-- Habille les pièges du château (pics, lames, boulets) avec les modèles Blender (groupe `traps`). Les Parts procédurales restent les « pilotes » de la
-- logique (positions, couleurs) ; le modèle suit : Pics se lève/descend, Lame tourne autour de l'axe vertical du modèle, Boulet suit la sphère.
-- Un piège dont le modèle n'a pas la pièce animée attendue garde son apparence procédurale. Retourne le nombre de pièges habillés.
function Builder.dressTraps(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		if not builtCastle then
			return
		end
		local parent = builtCastle.rooms[1] and builtCastle.rooms[1].door and builtCastle.rooms[1].door.Parent
		if not parent then
			return
		end
		for _, rec in ipairs(builtCastle.rooms) do
			for _, v in ipairs(rec.spikes) do
				local clone = assets.cloneModel("traps", "spikes")
				if clone then
					clone.Name = "TrapSpikes"
				end
				if clone and findNamed(clone, "Pics") and setModel(clone, v.wx, 0, v.wz, 6.4, nil, parent) then
					local pics = findNamed(clone, "Pics")
					v.vis = { part = pics, base = pics.CFrame, last = "" }
					v.tip.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
			for _, v in ipairs(rec.blades) do
				local clone = assets.cloneModel("traps", "blade")
				if clone then
					clone.Name = "TrapBlade"
				end
				if clone and findNamed(clone, "Lame") and setModel(clone, v.wx, 0, v.wz, v.arm.Size.X, nil, parent) then
					local lame = findNamed(clone, "Lame")
					v.vis = { part = lame, base = lame.CFrame, center = Vector3.new(v.wx, 0, v.wz) }
					v.arm.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
			for _, v in ipairs(rec.balls) do
				local clone = assets.cloneModel("traps", "ball")
				if clone then
					clone.Name = "TrapBall"
				end
				local d = v.part.Size.X
				if clone and setModel(clone, v.part.Position.X, -10, v.wz, d, nil, parent) then
					v.vis = { model = clone, d = d }
					v.part.Transparency = 1
					n = n + 1
				elseif clone then
					clone:Destroy()
				end
			end
		end
	end)
	return n
end

-- Habille le château (murs, tours, herses, coffre, torches, drapeaux, bâtiment en fond) avec les modèles Blender (groupes `castle` et `props`), dans un
-- budget de Parts (Config.Assets.castleBudgetParts, pire cas = plafond de Parts de chaque modèle). Les Parts procédurales gardent la collision et la logique
-- (murs, portes, coffre) et deviennent invisibles seulement si leur modèle a été posé. Herse (porte) et Couvercle (coffre) sont animées par le code.
-- Retourne le nombre de modèles posés.
function Builder.dressCastle(assets)
	local n, spent = 0, 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		local w = builtCastle
		local parent = w and w.rooms[1] and w.rooms[1].door and w.rooms[1].door.Parent
		if not parent then
			return
		end
		local function put(group, key, x, y0, z, span, height, rotY, name)
			local cost = Config.Assets.modelsMaxParts[group .. "." .. key] or 60
			if spent + cost > Config.Assets.castleBudgetParts then
				return nil
			end
			local clone = assets.cloneModel(group, key)
			if not clone then
				return nil
			end
			clone.Name = name
			if setModel(clone, x, y0, z, span, height, parent, rotY) then
				spent = spent + cost
				n = n + 1
				return clone
			end
			return nil
		end
		local W, L = Castle.ROOM_WIDTH, Castle.ROOM_LENGTH
		-- murs : deux segments de L/2 par côté et par salle (les murs procéduraux restent les colliders)
		for r = 1, Castle.ROOMS do
			local placed = 0
			for _, sx in ipairs({ -1, 1 }) do
				for k = 0, 1 do
					local x, z = Castle.toWorld(r, sx * (W / 2 + 1), L / 4 + k * L / 2)
					if put("castle", "wall", x, 0, z, L / 2, nil, math.pi / 2, "CastleWallModel") then
						placed = placed + 1
					end
				end
			end
			if placed == 4 then
				local _, roomZ = Castle.toWorld(r, 0, L / 2)
				for _, c in ipairs(parent:GetChildren()) do
					if c.Name == "CastleWall" and c:IsA("BasePart") and math.abs(c.Position.Z - roomZ) < 1 then
						c.Transparency = 1
					end
				end
			end
		end
		-- tours de chaque côté de l'entrée
		local ex, ez = Castle.toWorld(1, 0, -6)
		for _, sx in ipairs({ -13, 13 }) do
			put("castle", "tower", ex + sx, 0, ez, nil, Config.Assets.targetHeights.tower, 0, "CastleTowerModel")
		end
		-- herses : la pièce Herse monte quand la porte s'ouvre (le pilote procédural garde la collision)
		for _, rec in ipairs(w.rooms) do
			local door = put("castle", "door", rec.doorX, 0, rec.doorZ, W, nil, 0, "CastleDoorModel")
			local herse = door and findNamed(door, "Herse")
			if herse then
				rec.vis = { part = herse, base = herse.CFrame, last = "" }
				rec.door.Transparency = 1
			elseif door then
				door:Destroy()
				n = n - 1
			end
		end
		-- coffre : le Couvercle s'ouvre quand le trésor est pris (Builder.openChest)
		if w.chest then
			local chest = put("props", "chest", w.chest.Position.X, 0, w.chest.Position.Z, nil, Config.Assets.targetHeights.chest, 0, "CastleChestModel")
			local lid = chest and findNamed(chest, "Couvercle")
			if lid then
				w.chestVis = { part = lid, base = lid.CFrame }
				w.chest.Transparency = 1
				local old = parent:FindFirstChild("CastleChestLid")
				if old then
					old.Transparency = 1
				end
			elseif chest then
				chest:Destroy()
				n = n - 1
			end
		end
		-- torches (la lumière du pilote reste) et drapeaux sur le portail
		for _, c in ipairs(parent:GetChildren()) do
			if c.Name == "CastleTorch" and c:IsA("BasePart") and put("props", "torch", c.Position.X, 4.4, c.Position.Z, nil, 3, 0, "CastleTorchModel") then
				c.Transparency = 1
			end
		end
		for _, sx in ipairs({ -8, 8 }) do
			put("props", "flag", ex + sx, 18.5, ez, nil, 7, 0, "CastleFlagModel")
		end
		-- bâtiment du château en fond, derrière la dernière salle
		local bx, bz = Castle.toWorld(Castle.ROOMS, 0, L + 45)
		put("props", "castle", bx, 0, bz, nil, 46, math.pi, "CastleBackdrop")
	end)
	return n
end

-- Habille l'arène : place pavée sous le monument (ground.plaza), bancs et lampadaires autour, moulin (pales animées) et enclos dans le domaine 1.
-- Budget `arenaBudgetParts` (pire cas) ; chaque modèle est facultatif (repli : rien n'est posé, la carte reste procédurale). Retourne le nombre posé.
local millVis = nil
function Builder.dressArena(assets)
	local n, spent = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderArena"
		folder.Parent = world
		local function put(group, key, x, y0, z, span, height, rotY, name)
			local cost = Config.Assets.modelsMaxParts[group .. "." .. key] or 60
			if spent + cost > Config.Assets.arenaBudgetParts then
				return nil
			end
			local clone = assets.cloneModel(group, key)
			if not clone then
				return nil
			end
			clone.Name = name
			if setModel(clone, x, y0, z, span, height, folder, rotY) then
				spent = spent + cost
				n = n + 1
				return clone
			end
			return nil
		end
		local E = Config.Map2.bigEgg
		put("ground", "plaza", E.x, 0.34, E.z, E.r * 2 - 4, nil, 0, "ArenaPlaza") -- dallage de la place du Grand Œuf
		-- bancs et lampadaires de la place du marché (positions libres : hors halle, étals, fontaine, piste et portails)
		for _, b in ipairs({ { -20, -28 }, { 20, 24 }, { -18, 26 }, { 48, 18 } }) do
			put("props", "bench", b[1], 0, b[2], nil, Config.Assets.targetHeights.bench, math.rad(PlacementMod.facing(-b[1], -b[2])), "ArenaBench") -- le banc regarde le centre de la place
		end
		for _, l in ipairs({ { 30, -22 }, { -12, -42 }, { -52, 22 }, { 54, 8 } }) do
			put("props", "lamp", l[1], 0, l[2], nil, Config.Assets.targetHeights.lamp, 0, "ArenaLamp")
		end
		local cx, cz = Config.rivalCenter(1)
		local mill = put("props", "mill", cx - 24, Config.rivalHeight(1), cz + 22, nil, Config.Assets.targetHeights.mill, math.pi / 6, "ArenaMill")
		if mill then
			local p1, p2 = findNamed(mill, "Pales"), findNamed(mill, "Pales2")
			if p1 then
				millVis = { p1 = p1, b1 = p1.CFrame, p2 = p2, b2 = p2 and p2.CFrame }
			end
		end
		put("props", "pen", cx + 30, Config.rivalHeight(1), cz + 4, 16, nil, 0, "ArenaPen")
	end)
	return n
end

-- Fait tourner les pales du moulin (appelé 10 fois par seconde ; tournent en sens contraires autour de leur axe avant).
function Builder.animProps(t)
	local m = millVis
	if m and m.p1.Parent then
		m.p1.CFrame = m.b1 * CFrame.Angles(0, 0, t * 0.5)
		if m.p2 then
			m.p2.CFrame = m.b2 * CFrame.Angles(0, 0, -t * 0.35)
		end
	end
end

-- Dallage du sol (ground.path : chemins du Grand Nid vers les domaines ; ground.grass : pelouses autour de chaque base). Le coût d'une tuile est
-- MESURÉ (nombre réel de Parts du modèle chargé, Assets.status) et le placement s'arrête dès que `groundBudgetParts` serait dépassé ou que
-- `groundMaxTiles` est atteint. Retourne (tuiles posées, Parts utilisées). Sans modèle : rien (sol procédural conservé).
function Builder.dressGround(assets)
	local tiles, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while (not world or #builtPlots == 0) and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderGround"
		folder.Parent = world
		local function cost(key)
			local st = assets.status and assets.status["m:ground." .. key]
			return st and st.ok and st.parts or nil
		end
		local function tile(key, x, z, span)
			local c = cost(key)
			if not c or used + c > Config.Assets.groundBudgetParts or tiles >= Config.Assets.groundMaxTiles then
				return false
			end
			local clone = assets.cloneModel("ground", key)
			if not clone then
				return false
			end
			clone.Name = "GroundTile"
			if setModel(clone, x, key == "path" and 0.12 or 0.06, z, span, nil, folder, 0) then -- les chemins sont posés 0,06 au-dessus des pelouses (jamais coplanaires)
				used = used + c
				tiles = tiles + 1
				return true
			end
			return false
		end
		-- routes pavées (Config.Map2.paths) hors de la place : une tuile tous les 12 studs, jamais dans l'eau
		local G = MapGeoMod.new(Config)
		local PL = Config.Map2.plaza
		for _, sg in ipairs(G.pathSegs) do
			if sg.half == Config.Map2.pathHalf and (sg.y or 0) == 0 then
				local dx, dz = sg[3] - sg[1], sg[4] - sg[2]
				local len = math.sqrt(dx * dx + dz * dz)
				local k = 0
				while k * 12 < len do
					local x, z = sg[1] + dx * k * 12 / len, sg[2] + dz * k * 12 / len
					if math.sqrt((x - PL.x) ^ 2 + (z - PL.z) ^ 2) > PL.r + 6 and G.waterEdgeDist(x, z, true) > 6 then
						tile("path", x, z, 12)
					end
					k = k + 1
				end
			end
		end
		-- pelouses : 3 x 3 tuiles de 20 studs devant chaque base
		for _, pl in ipairs(builtPlots) do
			local p = pl.spawn.Position
			for gx = -1, 1 do
				for gz = -1, 1 do
					tile("grass", p.X + gx * 20, p.Z + gz * 20, 20)
				end
			end
		end
	end)
	return tiles, used
end

-- Pose les textures tuilables (Config.Assets.textures) sur les grandes surfaces de la carte : herbe, eaux, sol et murs du château, planches, sable,
-- pavés. Une Texture par face listée, au plus `textureMaxCount` au total (priorité = `textureOrder`). Sans URL chargée pour une clé, la matière actuelle
-- reste. Retourne le nombre de Textures posées. Ne lève jamais d'erreur.
function Builder.dressTextures(assets)
	local count = 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local parts = {}
		for _, d in ipairs(world:GetDescendants()) do
			if d:IsA("BasePart") then
				parts[#parts + 1] = d
			end
		end
		local cfg = Config.Assets
		for _, key in ipairs(cfg.textureOrder) do
			local url = assets.textureUrls and assets.textureUrls[key]
			local def = cfg.textures[key]
			if url and def then
				for _, p in ipairs(parts) do
					for _, t in ipairs(def.targets) do
						if (t.name and p.Name == t.name) or (t.prefix and p.Name:sub(1, #t.prefix) == t.prefix) then
							for _, face in ipairs(t.faces) do
								if count >= cfg.textureMaxCount then
									return
								end
								local tx = Instance.new("Texture")
								tx.Name = "Tile_" .. key
								tx.Texture = url
								tx.Face = Enum.NormalId[face]
								tx.StudsPerTileU = def.tile
								tx.StudsPerTileV = def.tile
								tx.Transparency = def.transparency or 0
								tx.Parent = p
								count = count + 1
							end
						end
					end
				end
			end
		end
	end)
	return count
end

-- Publie les modèles d'effets (groupe `vfx`, déjà chargés par Assets) dans ReplicatedStorage.VfxTemplates : les clients les clonent pour VfxKit.play
-- (un client ne peut pas charger d'assets lui-même). Parts ancrées, sans collision, matière Neon d'origine conservée. Retourne le nombre publié.
function Builder.exportVfx(assets)
	local n = 0
	pcall(function()
		local RS = game:GetService("ReplicatedStorage")
		local folder = RS:FindFirstChild("VfxTemplates") or Instance.new("Folder")
		folder.Name = "VfxTemplates"
		for _, key in ipairs(AssetsMod.vfxKeys) do
			local clone = assets.cloneModel("vfx", key)
			if clone then
				clone.Name = key
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
					end
				end
				clone.Parent = folder
				n = n + 1
			end
		end
		folder.Parent = RS
	end)
	return n
end

-- Maison évolutive (REFONTE lot 5, D) : le niveau N remplace l'enclos par une maison (repère local de la base : façade -Z tournée vers la place, arrière +Z).
-- Niveau 1 : enclos de bois (modèle base.level1 ou rails procéduraux) ; niveaux 2 à 7 : modèles Blender house.l2..l7 (largeur = emprise du niveau - 4, bâtiment
-- à l'ARRIÈRE de la plateforme, façade vers la place) ou, à défaut, une maison procédurale simple ; niveau 8 : base.level8. La plateforme grandit avec le niveau
-- (dalle « BasePlate » sous les emplacements : côtés et arrière, l'avant et le spawn restent en place). Tout est dans le modèle « BaseUpgrade » (au plus
-- Config.Assets.houseBudgetPerBase Parts) : les emplacements (pads) ne sont JAMAIS touchés par un changement de niveau.
-- opts.animate : l'ancienne maison reste (« BaseUpgradeOld ») et la nouvelle attend sous le sol (attribut FinalPivot) jusqu'à Builder.finishUpgrade (animation client).
-- Retourne le nombre de Parts posées.
local function levelDef(level)
	local lv = Config.BASE_LEVELS[level]
	return {
		size = lv and lv.size or 52,
		name = lv and lv.name or "",
	}
end

-- Maison procédurale de repli (niveaux 2 à 8) : murs, toit, porte, fenêtres, cheminée, perron ; ~14 à 30 Parts selon le niveau. Posée à l'arrière.
local function proceduralHouse(level, box, backZ)
	local size = levelDef(level).size
	local golden = level >= 8
	local w = math.min(size - 8, 22 + level * 3.5) -- largeur de la façade
	local depth = 11 + level -- profondeur du bâtiment
	local h = 4.2 + level * 0.9 -- hauteur des murs
	local zc = backZ - 1 - depth / 2
	local wall = golden and Color3.fromRGB(240, 220, 150) or (level >= 6 and Color3.fromRGB(226, 228, 232) or (level >= 4 and Color3.fromRGB(214, 190, 150) or Color3.fromRGB(176, 128, 84)))
	local roof = golden and Color3.fromRGB(255, 205, 70) or Color3.fromRGB(176, 70, 60)
	local wood = Color3.fromRGB(110, 76, 46)
	box("HouseSocle", 0, 1.3, zc, w + 3, 0.6, depth + 3, Color3.fromRGB(150, 150, 158), Enum.Material.Cobblestone)
	box("HouseWall", 0, 1.6 + h / 2, zc, w, h, depth, wall, level >= 6 and Enum.Material.Concrete or Enum.Material.WoodPlanks)
	if level >= 6 then
		box("HouseRoof", 0, 1.6 + h + 0.4, zc, w + 1.6, 0.8, depth + 1.6, roof, Enum.Material.Metal) -- toit plat moderne
	else
		box("HouseRoof", 0, 1.6 + h + 0.7, zc, w + 2, 1.4, depth * 0.6, roof, Enum.Material.Slate) -- toit : dalle haute et large
		box("HouseRoofLow", 0, 1.6 + h + 0.2, zc, w + 2, 0.5, depth + 2, roof:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Slate)
	end
	box("HouseDoor", 0, 1.6 + 1.6, zc - depth / 2 - 0.1, 2.6, 3.2, 0.3, wood)
	for _, sx in ipairs({ -w * 0.3, w * 0.3 }) do
		box("HouseWindow", sx, 1.6 + h * 0.6, zc - depth / 2 - 0.1, 2.4, 2, 0.2, Color3.fromRGB(150, 205, 235), Enum.Material.Glass)
	end
	box("HouseChimney", w * 0.3, 1.6 + h + 2, zc + depth * 0.2, 1.6, 3, 1.6, Color3.fromRGB(120, 110, 108), Enum.Material.Brick)
	for k = 0, 2 do -- perron
		box("HouseStep", 0, 1.1 + k * 0.25, zc - depth / 2 - 1 - (2 - k) * 0.9, 4.2, 0.25, 0.9, Color3.fromRGB(170, 170, 176), Enum.Material.Slate)
	end
	if level >= 3 then
		for _, sx in ipairs({ -w / 2 - 1, w / 2 + 1 }) do
			local post = box("LampPost", sx, 2.8, zc - depth / 2 - 1, 0.5, 5.2, 0.5, Color3.fromRGB(50, 52, 60), Enum.Material.Metal)
			local lamp = box("Lantern", sx, 5.6, zc - depth / 2 - 1, 1.1, 1.1, 1.1, Color3.fromRGB(255, 232, 160), Enum.Material.Neon)
			local l = Instance.new("PointLight")
			l.Color, l.Range, l.Brightness = Color3.fromRGB(255, 224, 150), 14, 0.9
			l.Parent = lamp
			post.CanQuery = false
		end
	end
	if level >= 4 then -- auvent ou garage latéral
		box("HouseGarage", -w / 2 - 4, 1.6 + 2.2, zc, 7, 4.4, depth * 0.8, wall:Lerp(Color3.fromRGB(120, 120, 128), 0.3), Enum.Material.Concrete)
		box("HouseGarageDoor", -w / 2 - 4, 1.6 + 1.6, zc - depth * 0.4 - 0.1, 5, 3.2, 0.2, Color3.fromRGB(90, 92, 100), Enum.Material.Metal)
	end
	if level >= 5 then
		box("HouseTerrace", w / 2 + 3, 1.6 + 0.4, zc, 6, 0.4, depth * 0.8, wood, Enum.Material.WoodPlanks)
	end
	if golden then
		local glow = box("GoldGlow", 0, 1.6 + h + 4, zc, 3, 3, 3, Color3.fromRGB(255, 205, 70), Enum.Material.Neon)
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness = Color3.fromRGB(255, 205, 70), 26, 1.4
		l.Parent = glow
	end
end

function Builder.baseUpgrade(plot, level, opts)
	local made = 0
	pcall(function()
		if not (plot and plot.model and plot.cf) then
			return
		end
		local animate = opts ~= nil and opts.animate == true
		Builder.finishUpgrade(plot) -- une animation précédente encore en cours est terminée d'abord
		local old = plot.model:FindFirstChild("BaseUpgrade")
		if animate and old then
			old.Name = "BaseUpgradeOld"
			Builder.clearBase(plot, true)
		else
			Builder.clearBase(plot)
		end
		local folder = Instance.new("Model")
		folder.Name = "BaseUpgrade"
		local cf0 = plot.cf
		folder.WorldPivot = cf0
		local def = levelDef(level)
		local halfX, backZ = Config.baseExtent(level)
		-- dalle de la plateforme agrandie : couvre l'ancienne plateforme (dessus à 1,02 : jamais de scintillement) et déborde sur les côtés et l'arrière
		do
			local plat = plot.platform
			local zFront = -(Config.Map2.basePlatform / 2)
			made += 1
			part({ Name = "BasePlate", Size = Vector3.new(halfX * 2, 1, backZ - zFront), CFrame = cf0 * CFrame.new(0, 0.52, (backZ + zFront) / 2),
				Color = plat and plat.Color or Color3.fromRGB(70, 110, 90), Material = Enum.Material.Concrete, CanCollide = true }, folder)
		end
		local function box(name, x, y, z, sx, sy, sz, color, material, rot)
			made += 1
			return part({ Name = name, Size = Vector3.new(sx, sy, sz), CFrame = cf0 * CFrame.new(x, y, z) * CFrame.Angles(0, rot or 0, 0), Color = color, Material = material or Enum.Material.WoodPlanks, CanCollide = false }, folder)
		end
		-- modèle Blender : niveau 1 et 8 = base.levelN (emprise centrée, entrée -Z) ; niveaux 2 à 7 = house.lN (bâtiment à l'arrière, devant -Z)
		local placed = false
		do
			local isHouse = level >= 2 and level <= 7
			local clone = eggAssets and eggAssets.cloneModel and (isHouse and eggAssets.cloneModel("house", "l" .. level) or eggAssets.cloneModel("base", "level" .. level))
			if clone then
				local ok = pcall(function()
					local _, size = clone:GetBoundingBox()
					local longest = math.max(size.X, size.Z)
					if size.Y < 0.05 or longest < 0.05 then
						error("mesure impossible")
					end
					local target = isHouse and (def.size - 4) or 52 -- l'emprise la plus grande du modèle = emprise du niveau - 4 (niveau 1 : 52, comme avant)
					if level == 8 then
						target = def.size - 4
					end
					local k = target / longest
					if isHouse and size.Z * k > 26 then
						k = 26 / size.Z -- jamais plus profond que 26 studs : l'avant de la maison reste loin de l'entrée
					end
					clone:ScaleTo(clone:GetScale() * k)
					local bbox, size2 = clone:GetBoundingBox()
					local cx, cy, cz = 0, size2.Y / 2, 0
					if isHouse then
						cy = 1 + size2.Y / 2
						cz = backZ - 1 - size2.Z / 2 -- le fond du modèle touche le bord arrière de la dalle
					end
					clone:PivotTo(cf0 * CFrame.new(cx, cy, cz) * bbox:ToObjectSpace(clone:GetPivot()))
					for _, d in ipairs(clone:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Anchored = true
							d.CanCollide = false
							d.CanQuery = false
						end
					end
					clone.Name = "BaseModel"
					clone.Parent = folder
				end)
				if ok then
					made += Config.Assets.modelsMaxParts[(isHouse and "house.l" or "base.level") .. level] or 80
					placed = true
				else
					pcall(function()
						clone:Destroy()
					end)
				end
			end
		end
		if not placed then
			if level == 1 then
				-- enclos de bois procédural (niveau 1) : lisse et poteaux autour de la plateforme
				local wood, wood2 = Color3.fromRGB(150, 104, 62), Color3.fromRGB(110, 76, 46)
				local E = 28.5
				box("Rail", -E, 1.6, 0, 0.6, 0.5, 2 * E, wood)
				box("Rail", E, 1.6, 0, 0.6, 0.5, 2 * E, wood)
				box("Rail", 0, 1.6, E, 2 * E, 0.5, 0.6, wood)
				for k = -3, 3 do
					local t = k * (E / 3)
					box("Post", -E, 1.0, t, 0.8, 2.1, 0.8, wood2)
					box("Post", E, 1.0, t, 0.8, 2.1, 0.8, wood2)
					box("Post", t, 1.0, E, 0.8, 2.1, 0.8, wood2)
				end
			else
				proceduralHouse(level, box, backZ)
			end
		end
		folder.Parent = plot.model
		if animate then
			folder:SetAttribute("FinalPivot", cf0)
			folder:PivotTo(cf0 * CFrame.new(0, -Config.UPGRADE_FX.hide, 0)) -- la nouvelle maison attend sous le sol ; le client la fait monter
			plot.upgrading = true
		end
	end)
	return made
end

-- Fin de l'animation de montée de niveau : la nouvelle maison reprend sa place exacte, l'ancienne disparaît. Sans effet s'il n'y a rien à finir.
function Builder.finishUpgrade(plot)
	pcall(function()
		local model = plot and plot.model
		if not model then
			return
		end
		local new = model:FindFirstChild("BaseUpgrade")
		local final = new and new:GetAttribute("FinalPivot")
		if new and final then
			pcall(function()
				if new:GetScale() ~= 1 then
					new:ScaleTo(1)
				end
			end)
			new:PivotTo(final)
			new:SetAttribute("FinalPivot", nil)
		end
		local old = model:FindFirstChild("BaseUpgradeOld")
		if old then
			old:Destroy()
		end
		plot.upgrading = nil
	end)
end

function Builder.clearBase(plot, keepOld)
	pcall(function()
		local f = plot.model and plot.model:FindFirstChild("BaseUpgrade")
		if f then
			f:Destroy()
		end
		if not keepOld then
			local o = plot.model and plot.model:FindFirstChild("BaseUpgradeOld")
			if o then
				o:Destroy()
			end
			plot.upgrading = nil
		end
		plot.baseBlender = 0
	end)
end

-- Décor fin (fleurs, touffes, pierres, lanternes) : budget SÉPARÉ (decoBudgetParts) posé après la carte, coût mesuré d'après les Parts réelles des modèles ;
-- repli procédural limité (decoFallbackMax Parts de fleurs) si les modèles manquent. Retourne (objets posés, Parts utilisées, Parts de repli).
function Builder.dressDeco(assets)
	local placed, used, fallback = 0, 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderDeco"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local items = P.decor(P.plan().items)
		for _, it in ipairs(items) do
			local st = assets.status and assets.status["m:deco." .. it.kind]
			local cost = (st and st.ok and st.parts) or 0
			local clone = cost > 0 and assets.cloneModel("deco", it.kind) or nil
			if clone then
				if used + cost <= Config.Assets.decoBudgetParts then
					local ok = assets.place(clone, it.x, it.z, it.rot, Config.Assets.decoHeights[it.kind], folder, nil, it.y)
					if ok then
						used = used + cost
						placed = placed + 1
					end
				else
					clone:Destroy()
				end
			elseif it.kind:sub(1, 6) == "flower" and fallback + 2 <= Config.Assets.decoFallbackMax then
				local col = ({ flower_a = Color3.fromRGB(255, 120, 154), flower_b = Color3.fromRGB(255, 210, 63), flower_c = Color3.fromRGB(255, 255, 255) })[it.kind]
				part({ Name = "FlowerStem", Size = Vector3.new(0.2, 0.9, 0.2), Position = Vector3.new(it.x, 0.45 + (it.y or 0), it.z), Color = Color3.fromRGB(62, 142, 68), CanCollide = false, CanQuery = false }, folder)
				ball({ Name = "FlowerHead", Size = Vector3.new(0.7, 0.7, 0.7), Position = Vector3.new(it.x, 1 + (it.y or 0), it.z), Color = col, CanQuery = false }, folder)
				fallback = fallback + 2
			end
		end
	end)
	return placed, used, fallback
end

-- Chemins sinueux Blender (tuiles droites/virages bordés de pierres, touffes sur les bords) posés sur les polylignes de Config.Map2.paths ; les pavés
-- procéduraux (PathStone) proches d'une polyligne habillée sont retirés (jamais de superposition). Retourne (tuiles posées, Parts utilisées).
function Builder.dressPaths(assets)
	local tiles, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		local A = Config.Assets
		local straight = assets.status and assets.status["m:paths.path_straight"]
		if not (straight and straight.ok) then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderPaths"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local function cost(key)
			local st = assets.status["m:paths." .. key]
			return st and st.ok and st.parts or 0
		end
		local PL = Config.Map2.plaza
		for _, path in ipairs(Config.Map2.paths) do
			local poly = path.pts
			local plan = PlacementMod.pathTiles(poly, A.pathTile, A.pathWind)
			local placedHere, wanted = 0, 0
			for _, t in ipairs(plan.tiles) do
				local key = t.kind
				local c = cost(key)
				if c <= 0 and key == "path_curve" then
					key, c = "path_straight", cost("path_straight")
				end
				local onPlaza = math.sqrt((t.x - PL.x) ^ 2 + (t.z - PL.z) ^ 2) < PL.r -- la place est déjà pavée
				if not onPlaza and not (P.blocked(t.x, t.z, 2, { allowDomain = true, allowPlateau = true }) == "eau") then
					wanted = wanted + 1
					if c > 0 and used + c <= A.pathBudgetParts then
						local clone = assets.cloneModel("paths", key)
						if clone and assets.place(clone, t.x, t.z, t.rot, nil, folder, A.pathTile, (path.y or 0) + 0.2) then
							used, tiles, placedHere = used + c, tiles + 1, placedHere + 1
						end
					end
				end
			end
			local sc = cost("path_stones")
			for i, b in ipairs(plan.borders) do
				if sc > 0 and used + sc <= A.pathBudgetParts and i % 2 == 0 then -- une pierre sur deux : bordure aérée
					local clone = assets.cloneModel("paths", "path_stones")
					if clone and assets.place(clone, b.x, b.z, b.rot, A.pathBorderHeight, folder, nil, 0.08) then
						used = used + sc
					end
				end
			end
			if placedHere > 0 and placedHere == wanted then -- tout le tracé est habillé : les dalles procédurales de ce chemin sont retirées
				for _, d in ipairs(world:GetDescendants()) do
					if (d.Name == "PathStone" or d.Name == "PathJoint" or d.Name == "DirtPath") and d:IsA("BasePart") then
						for k = 1, #poly - 1 do
							if PlacementMod.distToSegment(d.Position.X, d.Position.Z, poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2]) < A.pathWind + 6 then
								d:Destroy()
								break
							end
						end
					end
				end
			end
		end
	end)
	return tiles, used
end

-- Décor de village Blender sur la carte (tour, maisons à colombages, puits, pins hauts, rochers) : planifié par Placement.scenery, budget séparé.
-- Retourne (objets posés, Parts utilisées).
function Builder.dressScenery(assets)
	local placed, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderVillage"
		folder.Parent = world
		local P = PlacementMod.new(Config)
		local dims = Config.Assets.sceneryDims
		for _, it in ipairs(P.scenery(P.plan().items)) do
			local st = assets.status and assets.status["m:scenery." .. it.kind]
			local cost = st and st.ok and st.parts or 0
			if cost > 0 and used + cost <= Config.Assets.sceneryBudgetParts then
				local clone = assets.cloneModel("scenery", it.kind)
				local d = dims[it.kind]
				if clone and assets.place(clone, it.x, it.z, it.rot, d.h, folder, d.len, it.y) then
					used, placed = used + cost, placed + 1
				end
			end
		end
	end)
	return placed, used
end

-- Panneaux de difficulté Blender (étoiles Etoile1..Etoile5 recolorées : or pour les étoiles acquises, gris sinon) à la place du panneau procédural.
function Builder.dressSigns(assets)
	local n = 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		if not world then
			return
		end
		for _, d in ipairs(world:GetDescendants()) do
			if d.Name == "DifficultyBoard" and d:IsA("BasePart") then
				local clone = assets.cloneModel("deco", "sign_stars")
				if clone then
					local stars = d:GetAttribute("Stars") or 1
					local pos = d.Position
					if setModel(clone, pos.X, pos.Y - 6.8, pos.Z, nil, Config.Assets.decoHeights.sign_stars, d.Parent, 0) then
						for _, q in ipairs(clone:GetDescendants()) do
							local idx = q:IsA("BasePart") and tonumber(AssetsMod.baseName(q.Name):match("^Etoile(%d)$"))
							if idx then
								q.Color = idx <= stars and Color3.fromRGB(255, 205, 70) or Color3.fromRGB(120, 120, 130)
							end
						end
						clone.Name = "StarSign"
						d.Transparency = 1
						n = n + 1
					end
				end
			end
		end
	end)
	return n
end

-- Relief en toile de fond (budget séparé reliefBudgetParts) : crête de falaises sur deux niveaux au nord de la carte (décor de fond, au-delà de la borne
-- nord), cascades, escaliers ; un mur invisible garde les joueurs hors de la crête. Retourne (pièces posées, Parts utilisées).
function Builder.dressRelief(assets)
	local n, used = 0, 0
	pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderRelief"
		folder.Parent = world
		local B = Config.Map2.bounds
		local budget = Config.Assets.reliefBudgetParts
		local function cost(key)
			local st = assets.status and assets.status["m:terrain." .. key]
			return (st and st.ok and st.parts) or nil
		end
		local function put(key, x, y0, z, span, height, rot)
			local c = cost(key)
			if not c or used + c > budget then
				return false
			end
			local clone = assets.cloneModel("terrain", key)
			if clone and setModel(clone, x, y0, z, span, height, folder, rot) then
				used = used + c
				n = n + 1
				return true
			end
			return false
		end
		if not cost("cliff_a") then
			return
		end
		local zRow = B.z0 - 22 -- crête au nord, dans le décor de fond (au-delà de la borne nord de la zone jouable)
		-- mur invisible : les joueurs ne montent pas sur la crête (doublé par la borne de la carte)
		part({ Name = "ReliefWall", Size = Vector3.new(B.x1 - B.x0, 14, 1.5), Position = Vector3.new(0, 7, zRow + 8), Transparency = 1, CanCollide = true, CanQuery = false, CanTouch = false }, folder)
		local x = B.x0 + 20
		local k = 0
		while x <= B.x1 - 20 do
			local key = k % 3 == 2 and "cliff_b" or "cliff_a"
			put(key, x, 0, zRow, 16, nil, 180)
			x = x + 16
			k = k + 1
		end
		put("cliff_corner", B.x0 + 4, 0, zRow, 12, nil, 180)
		put("cliff_corner", x, 0, zRow, 12, nil, 180)
		-- deuxième niveau (terrasse supérieure) sur la partie centrale, dans la limite du budget
		local x2 = -200
		while x2 <= 200 and put(k % 2 == 0 and "cliff_a" or "cliff_b", x2, 8, zRow - 5, 16, nil, 180) do
			x2 = x2 + 16
			k = k + 1
		end
		-- cascades devant la crête et escaliers (décor de fond)
		for _, wx in ipairs({ -260, 90 }) do
			put("waterfall", wx, 0, zRow + 4, nil, 8, 180)
		end
		for _, sx in ipairs({ -300, 260 }) do
			put("stairs", sx, 0, zRow + 8, 8, nil, 180)
		end
	end)
	return n, used
end

-- Anime la herse de la salle d'après l'état de la porte procédurale (appelé 10 fois par seconde, ne change que sur changement d'état).
function Builder.animDoor(rec, open)
	local vis = rec.vis
	if vis and vis.last ~= open then
		vis.last = open
		vis.part.CFrame = vis.base * CFrame.new(0, open and 9 or 0, 0)
	end
end

-- Ouvre le couvercle du coffre final quelques secondes.
function Builder.openChest()
	local cv = builtCastle and builtCastle.chestVis
	if cv then
		cv.part.CFrame = cv.base * CFrame.Angles(-1.2, 0, 0)
		task.delay(4, function()
			if cv.part.Parent then
				cv.part.CFrame = cv.base
			end
		end)
	end
end

-- Habille les chevaliers du château avec guards.knight (hauteur Config.Assets.guardHeights.knight). Le pilote procédural devient invisible.
function Builder.dressKnights(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while not builtCastle and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		local parent = builtCastle and builtCastle.rooms[1] and builtCastle.rooms[1].door and builtCastle.rooms[1].door.Parent
		if not parent then
			return
		end
		for _, rec in ipairs(builtCastle.rooms) do
			for _, v in ipairs(rec.knights) do
				local clone = assets.cloneModel("guards", "knight")
				if clone then
					clone.Name = "CastleKnightModel"
					if setModel(clone, v.part.Position.X, 0, v.wz, nil, Config.Assets.guardHeights.knight, parent, 0) then
						v.vis = { model = clone, off = CFrame.new(v.part.Position.X, 0, v.wz):ToObjectSpace(clone:GetPivot()) }
						v.part.Transparency = 1
						n = n + 1
					end
				end
			end
		end
	end)
	return n
end

-- Place le modèle du chevalier sur sa position et le tourne dans le sens de la marche (devant = -Z : vers +X = -90°).
function Builder.animKnight(v, x, z, dir, speed)
	local vis = v.vis
	if vis then
		local by, roll = GuardMod.walkPose(os.clock() + (v.wz or 0), speed or 8) -- rebond et roulis de marche
		vis.model:PivotTo(CFrame.new(x, by, z) * CFrame.Angles(0, dir > 0 and -math.pi / 2 or math.pi / 2, 0) * CFrame.Angles(0, 0, roll) * vis.off)
	end
end

-- Anime le modèle d'un piège d'après la position de son pilote procédural (appelé 10 fois par seconde par le château).
function Builder.animSpike(v, tipY, state)
	local vis = v.vis
	if vis and vis.last ~= state then
		vis.last = state
		vis.part.CFrame = vis.base * CFrame.new(0, tipY - 0.9, 0) -- le modèle est dessiné pics sortis
	end
end
function Builder.animBlade(v, angle)
	local vis = v.vis
	if vis then
		local c = vis.center
		vis.part.CFrame = CFrame.new(c) * CFrame.Angles(0, angle, 0) * CFrame.new(-c) * vis.base
	end
end
function Builder.animBall(v, x, y, z)
	local vis = v.vis
	if vis then
		vis.model:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, 0, -x / math.max(0.5, vis.d / 2)))
	end
end

-- Habille les gardiens des domaines avec les modèles Blender chargés (guards.dog / wolf / bear). Retourne le nombre de gardiens remplacés.
function Builder.dressGuards(assets)
	local n = 0
	pcall(function()
		local waited = 0
		while #builtGuards == 0 and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		for _, g in ipairs(builtGuards) do
			local kind = Config.Assets.guardKinds[g.rival]
			local clone = kind and assets.cloneModel("guards", kind)
			if clone and fitGuard(g.model, clone, Config.Assets.guardHeights[kind]) then
				n = n + 1
			end
		end
	end)
	return n
end

function Builder.guard(rivalIdx)
	local r = Config.RIVALS[rivalIdx]
	local col = r.color:Lerp(Color3.fromRGB(60, 40, 30), 0.6)
	local model = Instance.new("Model")
	model.Name = "Guard" .. rivalIdx
	local body = part({ Name = "Body", CanCollide = false, Size = Vector3.new(3, 2.4, 4.4), CFrame = CFrame.new(0, 0, 0), Color = col }, model)
	model.PrimaryPart = body
	ball({ Name = "Head", Size = Vector3.new(2.4, 2.4, 2.4), CFrame = CFrame.new(0, 0.7, -2.7), Color = col }, model)
	part({ Name = "Snout", CanCollide = false, Size = Vector3.new(1.2, 0.9, 1.2), CFrame = CFrame.new(0, 0.3, -3.7), Color = Color3.fromRGB(35, 30, 30) }, model)
	ball({ Name = "EyeL", Size = Vector3.new(0.45, 0.45, 0.45), CFrame = CFrame.new(-0.7, 1.2, -3.5), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon }, model)
	ball({ Name = "EyeR", Size = Vector3.new(0.45, 0.45, 0.45), CFrame = CFrame.new(0.7, 1.2, -3.5), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon }, model)
	part({ Name = "EarL", CanCollide = false, Size = Vector3.new(0.5, 1.1, 0.6), CFrame = CFrame.new(-1.0, 1.9, -2.5) * CFrame.Angles(0, 0, 0.3), Color = col }, model)
	part({ Name = "EarR", CanCollide = false, Size = Vector3.new(0.5, 1.1, 0.6), CFrame = CFrame.new(1.0, 1.9, -2.5) * CFrame.Angles(0, 0, -0.3), Color = col }, model)
	part({ Name = "Tail", CanCollide = false, Size = Vector3.new(0.6, 0.6, 2), CFrame = CFrame.new(0, 0.8, 3.0) * CFrame.Angles(0.5, 0, 0), Color = col }, model)
	for i, o in ipairs({ { -1, -1.4 }, { 1, -1.4 }, { -1, 1.4 }, { 1, 1.4 } }) do
		part({ Name = "Leg" .. i, CanCollide = false, Size = Vector3.new(0.7, 1.6, 0.7), CFrame = CFrame.new(o[1], -1.8, o[2]), Color = col }, model)
	end
	if r.gentle then -- anneau de vision au sol (disque jaune translucide de la portée de vue) : on voit jusqu'où Gus repère
		part({ Name = "VisionRing", Size = Vector3.new(0.1, r.viewDist * 2, r.viewDist * 2), CFrame = CFrame.new(0, -2.25, 0) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.SmoothPlastic, Transparency = 0.8, CanCollide = false, CanQuery = false }, model)
	end
	local s = sign(body, "🐕 Gardien de " .. r.name, Color3.fromRGB(255, 120, 120), 4, 220)
	s.TextSize = 14
	return model
end

---------------------------------------------------------------- Éclairage
-- Ambiance « jour doré » : soleil chaud, brume légère, bloom discret, étalonnage plus vif.
function Builder.setupLighting()
	Lighting.ClockTime = 15.3
	Lighting.Brightness = 2.2 -- plus doux
	Lighting.Ambient = Color3.fromRGB(110, 112, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(135, 140, 158)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 238, 205)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ShadowSoftness = 0.35
	Lighting.GlobalShadows = true

	local function effect(class, name, props)
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(class)
			e.Name = name
			e.Parent = Lighting
		end
		for k, v in pairs(props) do
			e[k] = v
		end
		return e
	end

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.32 -- brouillard léger : les lointains se fondent dans le ciel
	atm.Offset = 0.25
	atm.Color = Color3.fromRGB(199, 220, 255)
	atm.Decay = Color3.fromRGB(255, 214, 170)
	atm.Glare = 0.25
	atm.Haze = 1.7

	effect("BloomEffect", "ChipeBloom", { Intensity = 0.3, Size = 24, Threshold = 0.96 })
	effect("SunRaysEffect", "ChipeSunRays", { Intensity = 0.15, Spread = 0.8 })
	effect("ColorCorrectionEffect", "ChipeGrade", { Saturation = 0.1, Contrast = 0.06, Brightness = 0.02 }) -- couleurs plus harmonieuses, moins saturées
end

---------------------------------------------------------------- Grand Œuf de l'énigme (ancien Grand Nid ; REFONTE lot 2 : place à l'est de la place du marché)
-- Les noms (GrandNid, RuneStone, RiddleBoard), tags (RuneStone) et attributs (Kind, Idx) lus par le serveur et le client sont conservés.
function Builder.monument(parent)
	local gold = Color3.fromRGB(255, 214, 120)
	local E = Config.Map2.bigEgg
	local ox, oz = E.x, E.z
	part({ Name = "BigEggPlace", Size = Vector3.new(0.2, E.r * 2, E.r * 2), CFrame = CFrame.new(ox, 0.48, oz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(190, 176, 150), Material = Enum.Material.Cobblestone, CanCollide = false }, parent)
	part({ Name = "MonumentBase", Size = Vector3.new(1.4, 17, 17), CFrame = CFrame.new(ox, 0.8, oz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(176, 160, 128), Material = Enum.Material.Slate }, parent)
	part({ Name = "MonumentStep", Size = Vector3.new(0.8, 12, 12), CFrame = CFrame.new(ox, 1.7, oz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(130, 116, 92), Material = Enum.Material.Slate }, parent)
	local egg = Instance.new("Part")
	egg.Name = "GrandNid"
	egg.Anchored = true
	egg.Size = Vector3.new(E.h * 0.72, E.h, E.h * 0.72)
	local eggY = 2.1 + E.h / 2
	egg.CFrame = CFrame.new(ox, eggY, oz)
	egg.Color = gold
	egg.Material = Enum.Material.Metal
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = egg
	local glow = Instance.new("PointLight")
	glow.Color = gold
	glow.Range = 32
	glow.Brightness = 1.5
	glow.Parent = egg
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = SPARK
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 235, 160))
	sparks.Rate = 8
	sparks.Lifetime = NumberRange.new(2, 3.5)
	sparks.Speed = NumberRange.new(1, 3)
	sparks.Acceleration = Vector3.new(0, 2, 0)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	sparks.Parent = egg
	egg.Parent = parent
	local ew = E.h * 0.36
	for k, c in ipairs({ { 0, 0.42, -0.98, 0.3 }, { 0.15, 0.05, -1, -0.5 }, { -0.14, -0.28, -0.97, 0.6 } }) do -- fissures lumineuses (face nord)
		part({ Name = "Crack" .. k, Size = Vector3.new(0.35, 3.6, 0.35), CFrame = CFrame.new(ox + c[1] * ew, eggY + c[2] * E.h / 2, oz + c[3] * ew) * CFrame.Angles(0, 0, c[4]), Color = Color3.fromRGB(255, 248, 200), Material = Enum.Material.Neon, CanCollide = false }, parent)
	end
	-- Quatre runes cardinales (Nord = côté des rivaux). Chaque joueur règle ses propres runes : le symbole affiché est local au client
	-- (étiquette « Label » modifiée côté client), l'état est tenu par le serveur.
	for k, rs in ipairs(Config.Map2.runeStones) do -- ordre N, E, S, O (= Config.RUNE_DIRECTIONS)
		local x, z = rs.x, rs.z
		local stone = part({ Name = "RuneStone", Size = Vector3.new(2.4, 5, 1.2), CFrame = CFrame.lookAt(Vector3.new(x, 2.7, z), Vector3.new(ox, 2.7, oz)), Color = Color3.fromRGB(110, 104, 96), Material = Enum.Material.Slate }, parent)
		stone:SetAttribute("Idx", k)
		CollectionService:AddTag(stone, "RuneStone")
		part({ Name = "RuneGlow", Size = Vector3.new(1.1, 3.4, 0.2), CFrame = stone.CFrame * CFrame.new(0, 0.2, -0.65), Color = gold, Material = Enum.Material.Neon, CanCollide = false }, parent)
		local lbl = sign(stone, "?", Color3.fromRGB(255, 240, 190), 4.4, 120)
		lbl.TextSize = 44
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Tourner la rune"
		pr.ObjectText = "Rune du " .. Config.RUNE_DIRECTIONS[k]
		pr.HoldDuration = 0
		pr.MaxActivationDistance = 9
		pr.RequiresLineOfSight = false
		pr:SetAttribute("Kind", "Rune")
		pr:SetAttribute("Idx", k)
		pr.Parent = stone
	end
	-- Valider la combinaison en touchant le Grand Nid
	local confirm = Instance.new("ProximityPrompt")
	confirm.ActionText = "Poser la combinaison"
	confirm.ObjectText = "Grand Œuf"
	confirm.HoldDuration = 0.5
	confirm.MaxActivationDistance = 14
	confirm.RequiresLineOfSight = false
	confirm:SetAttribute("Kind", "RuneConfirm")
	confirm.Parent = egg
	-- Panneau de l'énigme de Mère Poule (texte mis à jour chaque jour par le serveur), lisible des deux côtés
	local bx, bz = ox + 16, oz + 14
	local board = part({ Name = "RiddleBoard", Size = Vector3.new(12, 4.6, 0.5), Position = Vector3.new(bx, 3.8, bz), Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.WoodPlanks }, parent)
	part({ Name = "RiddlePostL", Size = Vector3.new(0.7, 4, 0.7), Position = Vector3.new(bx - 5.4, 2, bz), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	part({ Name = "RiddlePostR", Size = Vector3.new(0.7, 4, 0.7), Position = Vector3.new(bx + 5.4, 2, bz), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	local labels = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.CanvasSize = Vector2.new(720, 300)
		sg.LightInfluence = 0
		sg.Adornee = board
		sg.Parent = board
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, 0, 0, 56)
		title.Font = FONT
		title.TextSize = 40
		title.TextColor3 = gold
		title.Text = "📜 La berceuse du Grand Œuf"
		title.Parent = sg
		local body = Instance.new("TextLabel")
		body.BackgroundTransparency = 1
		body.Position = UDim2.fromOffset(16, 60)
		body.Size = UDim2.new(1, -32, 1, -64)
		body.Font = Enum.Font.GothamMedium
		body.TextSize = 29
		body.TextWrapped = true
		body.TextColor3 = Color3.fromRGB(255, 244, 220)
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.Text = "Parle à la Mère Poule 🐔 : trouve ses 4 plumes dorées, règle les 4 runes, puis chante la berceuse. Un nouveau défi chaque jour !" -- texte fixe : les indices sont sur les plumes (lot 6)
		body.Parent = sg
		labels[#labels + 1] = body
	end
	local result = { labels = labels, center = Vector3.new(ox, eggY, oz) }
	local t = sign(egg, "✨ Le Grand Œuf ✨\nRéveille la Couvée, Chipeur !", gold, E.h / 2 + 3, 340)
	t.TextSize = 20
	return result
end

---------------------------------------------------------------- Mère Poule (gardienne du Grand Nid, guide de l'histoire)
-- Les parties de la tête portent un nom préfixé « Hen » : le client les fait picorer (Animations.client.lua) et la cinématique
-- d'introduction la met en scène (ancre « hen » = tag Hen).
function Builder.hen(parent)
	local white, red, orange, dark = Color3.fromRGB(250, 248, 240), Color3.fromRGB(235, 60, 60), Color3.fromRGB(255, 170, 40), Color3.fromRGB(30, 28, 32)
	local model = Instance.new("Model")
	model.Name = "MerePoule"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent -- cinématiques et énigme : toujours présente côté client
	local body = ball({ Name = "Body", Size = Vector3.new(4, 4, 4), CFrame = CFrame.new(0, 0, 0), Color = white }, model)
	model.PrimaryPart = body
	part({ Name = "Tail", Size = Vector3.new(1.2, 2.2, 0.6), CFrame = CFrame.new(0, 0.8, 2.1) * CFrame.Angles(-0.5, 0, 0), Color = white, CanCollide = false }, model)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Wing", Size = Vector3.new(0.3, 2, 2.2), CFrame = CFrame.new(side * 2.05, 0, 0.2) * CFrame.Angles(0, 0, side * 0.15), Color = Color3.fromRGB(238, 232, 220), CanCollide = false }, model)
		part({ Name = "Leg", Size = Vector3.new(0.3, 1.3, 0.3), CFrame = CFrame.new(side * 0.8, -2.5, 0), Color = orange, CanCollide = false }, model)
		part({ Name = "Foot", Size = Vector3.new(0.9, 0.2, 1.1), CFrame = CFrame.new(side * 0.8, -3.15, -0.3), Color = orange, CanCollide = false }, model)
		ball({ Name = "HenEye" .. (side < 0 and "L" or "R"), Size = Vector3.new(0.38, 0.38, 0.38), CFrame = CFrame.new(side * 0.6, 2.55, -2.6), Color = dark }, model)
	end
	ball({ Name = "HenHead", Size = Vector3.new(2.3, 2.3, 2.3), CFrame = CFrame.new(0, 2.3, -1.7), Color = white }, model)
	part({ Name = "HenComb", Size = Vector3.new(0.5, 0.9, 1.2), CFrame = CFrame.new(0, 3.6, -1.7), Color = red, CanCollide = false }, model)
	part({ Name = "HenBeak", Size = Vector3.new(0.8, 0.5, 0.9), CFrame = CFrame.new(0, 2.15, -3.0), Color = orange, CanCollide = false }, model)
	ball({ Name = "HenWattle", Size = Vector3.new(0.6, 0.8, 0.5), CFrame = CFrame.new(0, 1.6, -2.8), Color = red }, model)
	local label = sign(body, "🐔 Mère Poule\nGardienne du Grand Œuf", Color3.fromRGB(255, 220, 140), 5.5, 260)
	label.TextSize = 17
	-- Lot 6 : « Parler » ouvre le dialogue de l'énigme (le serveur choisit la réplique selon l'étape du joueur et envoie son identifiant).
	local talk = Instance.new("ProximityPrompt")
	talk.ActionText = "Parler"
	talk.ObjectText = "Mère Poule"
	talk.HoldDuration = 0
	talk.MaxActivationDistance = Config.HEN.talkDistance - 2
	talk.RequiresLineOfSight = false
	talk:SetAttribute("Kind", "HenTalk")
	talk.Parent = body
	model:SetAttribute("Seed", 3)
	CollectionService:AddTag(model, "Hen")
	local H, E = Config.Map2.hen, Config.Map2.bigEgg
	model:PivotTo(CFrame.lookAt(Vector3.new(H.x, 3.2, H.z), Vector3.new(E.x, 3.2, E.z))) -- regarde le Grand Œuf
	model.Parent = parent
	return model
end

-- Plume dorée de l'énigme (lot 6) : UNE Part néon (visible de tous), ramassée PAR JOUEUR (le serveur tient le masque `puzzle.feathers` ; le client cache la plume
-- de celui qui l'a prise). Déplacée chaque jour par le serveur (HenQuest) ; l'émetteur d'étincelles est coupé : le client l'allume à moins de 40 studs.
function Builder.feather(parent, dir)
	local f = part({ Name = "Feather", Size = Vector3.new(0.3, 3.4, 1.3), Color = Color3.fromRGB(255, 214, 90), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }, parent)
	f:SetAttribute("Dir", dir)
	CollectionService:AddTag(f, "Feather")
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparkle"
	sparks.Texture = SPARK
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 240, 170))
	sparks.Rate = 14
	sparks.Lifetime = NumberRange.new(1, 1.8)
	sparks.Speed = NumberRange.new(1, 3)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	sparks.Enabled = false
	sparks.Parent = f
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 214, 90)
	glow.Range = 10
	glow.Brightness = 1.2
	glow.Parent = f
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Ramasser"
	pr.ObjectText = "Plume dorée"
	pr.HoldDuration = 0.5
	pr.MaxActivationDistance = Config.HEN.pickupDistance
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", "Feather")
	pr:SetAttribute("Dir", dir)
	pr.Parent = f
	return f
end

---------------------------------------------------------------- Monde
local PLOT_COLORS = {
	Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 180, 80), Color3.fromRGB(255, 230, 90), Color3.fromRGB(140, 230, 110),
	Color3.fromRGB(80, 220, 200), Color3.fromRGB(90, 170, 255), Color3.fromRGB(170, 130, 255), Color3.fromRGB(255, 130, 220),
	Color3.fromRGB(235, 235, 235), Color3.fromRGB(170, 190, 160),
}
Builder.PLOT_COLORS = PLOT_COLORS

local function tree(pos, parent, rng)
	local s = rng:NextNumber(0.85, 1.3)
	part({ Name = "Trunk", Size = Vector3.new(2 * s, 8 * s, 2 * s), Position = pos + Vector3.new(0, 4 * s, 0), Color = Color3.fromRGB(110, 78, 50), Material = Enum.Material.Wood }, parent)
	local dark, light = Color3.fromRGB(62, 142, 68), Color3.fromRGB(92, 178, 86)
	ball({ Name = "Leaves", Size = Vector3.new(11 * s, 11 * s, 11 * s), Position = pos + Vector3.new(0, 11 * s, 0), Color = dark, Material = Enum.Material.Grass }, parent)
	ball({ Name = "Leaves", Size = Vector3.new(7 * s, 7 * s, 7 * s), Position = pos + Vector3.new(3.2 * s, 9.2 * s, 1.5 * s), Color = light, Material = Enum.Material.Grass }, parent)
	ball({ Name = "Leaves", Size = Vector3.new(6 * s, 6 * s, 6 * s), Position = pos + Vector3.new(-2.8 * s, 14 * s, -1 * s), Color = light, Material = Enum.Material.Grass }, parent)
end

local function torch(pos, parent)
	part({ Name = "TorchPost", Size = Vector3.new(0.8, 5, 0.8), Position = pos + Vector3.new(0, 2.5, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, parent)
	local head = ball({ Name = "TorchHead", Size = Vector3.new(1.3, 1.3, 1.3), Position = pos + Vector3.new(0, 5.4, 0), Color = Color3.fromRGB(255, 150, 60), Material = Enum.Material.Neon }, parent)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 170, 70)
	fire.SecondaryColor = Color3.fromRGB(255, 90, 30)
	fire.Parent = head
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 170, 90)
	l.Range = 18
	l.Brightness = 1.2
	l.Parent = head
end

-- Décale de dy toutes les Parts d'un dossier (contenu d'un territoire posé sur le plateau du château).
local function liftFolder(folder, dy)
	if dy == 0 then
		return
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + Vector3.new(0, dy, 0)
		end
	end
end

-- Retourne { plots, nests, treadmill, guards, treadmillContains, fastTravel, partCount, ... }
-- REFONTE (lot 2) : carte Config.Map2 (700 x 500) : place du marché au centre, 5 bases tournées vers la place, territoires de Config.TERR,
-- château sur plateau au nord-est, arène au sud-ouest, lacs, rivières en polylignes. Géométrie dérivée : MapGeo.
function Builder.build()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	for _, c in ipairs(workspace:GetChildren()) do
		if c:IsA("SpawnLocation") then
			c:Destroy()
		end
	end

	Builder.setupLighting()
	local M2 = Config.Map2
	local G = MapGeoMod.new(Config)
	local P = PlacementMod.new(Config, MapGeoMod)

	-- Sol (herbe : zone jouable + décor de fond), bornes, collines, forêts --------------------------
	part({ Name = "Ground", Size = Vector3.new(M2.backdrop.w, 2, M2.backdrop.d), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(92, 160, 82), Material = Enum.Material.Grass }, world)
	local sceneryHelpers = { part = part, ball = ball, tree = tree, torch = torch, sign = sign }
	local sceneryParts = 0
	local function deco(name, fn)
		local okS, countS = pcall(fn)
		if okS then
			sceneryParts += countS or 0
		else
			warn("[Builder] décor « " .. name .. " » : " .. tostring(countS))
		end
	end
	deco("relief", function()
		local savedYield = PlacementMod.yield -- la carte se construit d'un bloc (pas de pause) : le serveur n'est prêt qu'après
		PlacementMod.yield = nil
		local okF, forest = pcall(P.forest)
		PlacementMod.yield = savedYield
		return Scenery.relief(sceneryHelpers, world, Config, okF and forest or {})
	end)
	deco("plaza", function()
		return Scenery.plaza(sceneryHelpers, world, Config)
	end)

	local monument = Builder.monument(world)
	local henModel = Builder.hen(world)

	local result = { plots = {}, nests = {}, guards = {}, riddleLabels = monument.labels, monumentCenter = monument.center, geo = G, hen = henModel, folder = world }

	-- Territoires (Config.TERR) : nids, postes des gardiens, décor, barrière des zones verrouillées, panneau de difficulté ---------------
	local gIndex = {} -- numéro du gardien dans son rival (Guard<rival>_<j>)
	for _, t in ipairs(G.terrs) do
		local folder = Instance.new("Folder")
		local riv = t.rival > 0 and Config.RIVALS[t.rival] or nil
		folder.Name = Config.territoryFolder(t.key)
		folder:SetAttribute("Territory", t.key)
		folder.Parent = world
		local y0 = G.groundY(t.x, t.z)
		local nestRival = riv and t.rival or 1 -- enclos sauvage : rattaché au domaine de Gus (toujours ouvert), poids propres (Config.TERR.wild)
		local color = riv and riv.color or Color3.fromRGB(200, 170, 110)
		if riv then
			part({ Name = "Disc", Size = Vector3.new(0.2, t.r * 2, t.r * 2), CFrame = CFrame.new(t.x, 0.12, t.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = color:Lerp(Color3.fromRGB(70, 55, 40), 0.55), Material = Enum.Material.Ground, Transparency = 0.35, CanCollide = false, CanQuery = false }, folder)
			local ex, ez = t.entry.x, t.entry.z
			torch(Vector3.new(ex - 4, 0, ez), folder)
			torch(Vector3.new(ex + 4, 0, ez), folder)
			local pole = part({ Name = "Sign", Size = Vector3.new(1, 9, 1), Position = Vector3.new(t.x, 4.5, t.z - t.r + 6), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, folder)
			part({ Name = "Flag", Size = Vector3.new(0.2, 3, 5), Position = Vector3.new(t.x + 0.2, 8, t.z - t.r + 8.5), Color = riv.color, Material = Enum.Material.Fabric, CanCollide = false }, folder)
			local lbl = sign(pole, riv.emoji .. " " .. riv.name .. "  " .. string.rep("★", riv.stars), Color3.fromRGB(255, 220, 90), 7, 260)
			lbl.TextSize = 22
			-- panneau de difficulté à l'entrée du territoire : étoiles et nombre de gardiens du territoire
			local dx, dz = ex + 8, ez
			local count = #t.posts
			local post = part({ Name = "DifficultySign", Size = Vector3.new(0.8, 6, 0.8), Position = Vector3.new(dx, 3, dz), Color = Color3.fromRGB(110, 76, 46), Material = Enum.Material.Wood, CanCollide = false }, folder)
			local board = part({ Name = "DifficultyBoard", Size = Vector3.new(7, 3, 0.5), Position = Vector3.new(dx, 6.8, dz), Color = Color3.fromRGB(70, 50, 36), Material = Enum.Material.WoodPlanks, CanCollide = false }, folder)
			local dl = sign(board, string.rep("⭐", riv.stars) .. string.rep("☆", 5 - riv.stars) .. "\n" .. riv.name .. " : " .. count .. " gardien" .. (count > 1 and "s" or ""), Color3.fromRGB(255, 220, 120), 0, 200)
			dl.TextSize = 16
			post.Anchored = true
			board:SetAttribute("Stars", riv.stars)
			local theme = Scenery[Config.Map.zoneKeys[t.rival]]
			if theme then
				local okS, countS = pcall(theme, sceneryHelpers, t, folder, Random.new(100 + t.rival * 7 + #t.key), 0)
				if okS then
					sceneryParts += countS
				else
					warn("[Builder] décor du territoire " .. t.key .. " : " .. tostring(countS))
				end
			end
			local zone = Config.ZONES[t.rival]
			if zone and zone.chapter > 0 then
				-- Barrière du territoire verrouillé. Elle est solide pour tous ; le client la rend traversable (localement) dès que le
				-- joueur a réussi le chapitre requis. Le serveur refuse de toute façon tout vol dans une zone verrouillée.
				local gate = part({ Name = "ZoneGate", Size = Vector3.new(12, t.r * 2 + 2, t.r * 2 + 2), CFrame = CFrame.new(t.x, 6, t.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 70, 90), Material = Enum.Material.Neon, Transparency = 0.6 }, folder)
				gate:SetAttribute("Rival", t.rival)
				gate:SetAttribute("Chapter", zone.chapter)
				CollectionService:AddTag(gate, "ZoneGate")
				sign(gate, "🔒 " .. zone.name .. "\nHistoire : chapitre " .. zone.chapter, Color3.fromRGB(255, 210, 210), 10, 300)
			end
		else
			-- enclos sauvage : clôture basse ouverte au sud, sans gardien
			local W = M2.wildPen
			for _, r in ipairs({ { 0, -W.d / 2, W.w, 0.4 }, { -W.w / 2, 0, 0.4, W.d }, { W.w / 2, 0, 0.4, W.d } }) do
				part({ Name = "PenRail", Size = Vector3.new(r[3], 0.5, r[4]), Position = Vector3.new(t.x + r[1], 2, t.z + r[2]), Color = Color3.fromRGB(140, 104, 70), Material = Enum.Material.Wood }, folder)
			end
			for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
				part({ Name = "PenPost", Size = Vector3.new(0.7, 3, 0.7), Position = Vector3.new(t.x + c[1] * W.w / 2, 1.5, t.z + c[2] * W.d / 2), Color = Color3.fromRGB(120, 88, 58), Material = Enum.Material.Wood }, folder)
			end
			local pole = part({ Name = "Sign", Size = Vector3.new(0.8, 6, 0.8), Position = Vector3.new(t.x - W.w / 2 - 2, 3, t.z + W.d / 2), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, folder)
			sign(pole, "🧺 Enclos sauvage\nÀ chiper sans gardien !", Color3.fromRGB(255, 230, 150), 5, 240)
		end
		for ni, np in ipairs(t.nests or {}) do
			local nx, nz = np[1], np[2]
			local mound = part({ Name = "Nest", Size = Vector3.new(0.7, 6, 6), CFrame = CFrame.new(nx, 1, nz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.Wood, CanCollide = false }, folder)
			part({ Name = "NestStraw", Size = Vector3.new(0.3, 4.4, 4.4), CFrame = CFrame.new(nx, 1.32, nz) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(226, 196, 120), Material = Enum.Material.Fabric, CanCollide = false }, folder)
			Scenery.marker(sceneryHelpers, Vector3.new(nx, 0.5 + ni * 0.06, nz), folder, "✋", 8) -- hauteurs distinctes : nids proches (enclos sauvage) sans z-fighting
			sceneryParts += 1
			result.nests[#result.nests + 1] = { rival = nestRival, terr = t.key, weights = (not riv) and t.data.weights or nil, pos = Vector3.new(nx, 3.2 + y0, nz), mound = mound, folder = folder, egg = nil, rt = math.random() * 6 }
		end
		-- gardiens : un par poste ; territoire = disque du territoire (clampToDisc), patrouille de ± patrolHalf autour du poste
		for _, post in ipairs(t.posts) do
			gIndex[t.rival] = (gIndex[t.rival] or 0) + 1
			local j = gIndex[t.rival]
			local gx, gz = post[1], post[2]
			local g = Builder.guard(t.rival)
			g.Name = "Guard" .. t.rival .. "_" .. j
			g:SetAttribute("Territory", t.key)
			g.Parent = folder
			builtGuards[#builtGuards + 1] = { model = g, rival = t.rival }
			local inner = t.r - Config.GUARD.territoryMargin
			local dPost = math.sqrt((gx - t.x) ^ 2 + (gz - t.z) ^ 2)
			local patrolHalf = math.max(4, math.min(12, inner - dPost))
			result.guards[#result.guards + 1] = {
				model = g, rival = t.rival, terr = t.key, tx = t.x, tz = t.z, clampR = math.max(inner, dPost + patrolHalf + 0.5), patrolHalf = patrolHalf,
				cx = gx, patrolZ = gz, pos = Vector3.new(gx, 2.4, gz), dir = ((t.rival + j) % 2 == 0) and -1 or 1, state = "patrol", cd = 0, lost = 0,
			}
			g:PivotTo(CFrame.new(gx, 2.4, gz))
		end
		-- contenu posé sur le sol réel (plateau du château pour la cour de Zed)
		liftFolder(folder, y0)
		if y0 ~= 0 then
			for _, g in ipairs(result.guards) do
				if g.terr == t.key then
					g.pos = g.pos + Vector3.new(0, y0, 0)
				end
			end
		end
	end

	-- Piste d'entraînement (ancien « Treadmill » ; clé `train` inchangée) : les rayures sont animées côté client (tag BeltStripe) -----
	do
		local T = M2.track
		local belt = part({ Name = "TrainingTrack", Size = Vector3.new(T.w, 1, T.d), Position = Vector3.new(T.x, 0.6, T.z), Color = Color3.fromRGB(45, 48, 56), Material = Enum.Material.Metal }, world)
		belt.AssemblyLinearVelocity = Vector3.new(0, 0, -14) -- la piste pousse vers -Z : il faut courir vers +Z
		for k = 0, 7 do
			local stripe = part({ Name = "Stripe", Size = Vector3.new(T.w - 2, 0.1, 1.2), Position = Vector3.new(T.x, 1.16, T.z - 17.5 + k * 5), Color = Color3.fromRGB(255, 210, 63), Material = Enum.Material.Neon, CanCollide = false }, belt)
			stripe:SetAttribute("Z0", -17.5 + k * 5)
			stripe:SetAttribute("CenterZ", T.z)
			CollectionService:AddTag(stripe, "BeltStripe")
		end
		for _, sx in ipairs({ -T.w / 2 - 0.6, T.w / 2 + 0.6 }) do
			part({ Name = "Rail", Size = Vector3.new(0.8, 1.6, T.d), Position = Vector3.new(T.x + sx, 1.1, T.z), Color = Color3.fromRGB(255, 210, 63), Material = Enum.Material.Neon }, world)
		end
		local pole = part({ Name = "TreadSign", Size = Vector3.new(1, 8, 1), Position = Vector3.new(T.x + T.w / 2 + 3, 4, T.z + T.d / 2 - 2), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
		sign(pole, "🏃 PISTE D'ENTRAÎNEMENT\nCours dessus pour gagner en vitesse !", Color3.fromRGB(255, 220, 90), 6, 300)
		result.treadmill = { cf = belt.CFrame, size = belt.Size }
	end

	-- Tapis roulant central du marché (lot 3) : sort de la halle, avance vers +X, finit dans le bac. AUCUN effet de vitesse sur les joueurs :
	-- rien n'y est solide (on le traverse comme un décor), les œufs y sont posés par le serveur (Main, section « Tapis roulant central »). ---
	do
		local B = M2.belt
		local len = B.x1 - B.x0
		local mx = (B.x0 + B.x1) / 2
		local steel, amber = Color3.fromRGB(52, 56, 66), Color3.fromRGB(255, 196, 64)
		local body = part({ Name = "CentralBelt", Size = Vector3.new(len, 0.8, B.width), Position = Vector3.new(mx, 0.4, B.z), Color = steel, Material = Enum.Material.Metal, CanCollide = false }, world)
		for _, sz in ipairs({ -B.width / 2 - 0.4, B.width / 2 + 0.4 }) do
			part({ Name = "BeltRail", Size = Vector3.new(len, 1.2, 0.8), Position = Vector3.new(mx, 0.6, B.z + sz), Color = amber, Material = Enum.Material.Neon, CanCollide = false }, world)
		end
		for k = 0, math.floor(len / 6) - 1 do -- repères fixes (le mouvement vient des œufs)
			part({ Name = "BeltMark", Size = Vector3.new(1.2, 0.1, B.width - 2), Position = Vector3.new(B.x0 + 3 + k * 6, 0.85, B.z), Color = amber, Material = Enum.Material.Neon, CanCollide = false }, body)
		end
		-- le bac : l'œuf qui arrive au bout y tombe et disparaît
		local bx, bz = B.bin.x, B.bin.z
		part({ Name = "BeltBinFloor", Size = Vector3.new(7, 0.8, B.width + 2), Position = Vector3.new(bx, 0.4, bz), Color = Color3.fromRGB(70, 48, 36), Material = Enum.Material.Wood }, world)
		part({ Name = "BeltBinWall", Size = Vector3.new(1, 3, B.width + 2), Position = Vector3.new(bx + 3.5, 1.5, bz), Color = Color3.fromRGB(96, 66, 48), Material = Enum.Material.Wood }, world)
		part({ Name = "BeltBinBack", Size = Vector3.new(7, 2, 1), Position = Vector3.new(bx, 1.2, bz - B.width / 2 - 0.5), Color = Color3.fromRGB(96, 66, 48), Material = Enum.Material.Wood }, world)
		part({ Name = "BeltBinFront", Size = Vector3.new(7, 2, 1), Position = Vector3.new(bx, 1.2, bz + B.width / 2 + 0.5), Color = Color3.fromRGB(96, 66, 48), Material = Enum.Material.Wood }, world)
		-- panneau : deux tables de rareté (celle en vigueur en surbrillance) et compte à rebours du tapis doré ; mis à jour par Main
		local post = part({ Name = "BeltPanelPost", Size = Vector3.new(1, 9, 1), Position = Vector3.new(mx, 4.5, B.z - B.width / 2 - 5), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
		local g = Instance.new("BillboardGui")
		g.Name = "BeltPanel"
		g.Adornee = post
		g.Size = UDim2.fromOffset(440, 168)
		g.StudsOffsetWorldSpace = Vector3.new(0, 6.5, 0)
		g.MaxDistance = 80
		g.AlwaysOnTop = false
		local frame = Instance.new("Frame")
		frame.Name = "Card"
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
		frame.BackgroundTransparency = 0.15
		frame.BorderSizePixel = 0
		frame.Parent = g
		local function label(name, y, h, size, color)
			local t = Instance.new("TextLabel")
			t.Name = name
			t.BackgroundTransparency = 1
			t.Position = UDim2.new(0, 8, 0, y)
			t.Size = UDim2.new(1, -16, 0, h)
			t.Font = FONT
			t.TextSize = size
			t.TextColor3 = color
			t.TextWrapped = true
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.TextYAlignment = Enum.TextYAlignment.Top
			t.Text = ""
			t.Parent = frame
			return t
		end
		local panel = {
			title = label("Title", 4, 22, 18, Color3.fromRGB(255, 220, 90)),
			normal = label("Normal", 30, 40, 12, Color3.fromRGB(235, 235, 245)),
			golden = label("Golden", 74, 40, 12, Color3.fromRGB(235, 235, 245)),
			status = label("Status", 120, 40, 16, Color3.fromRGB(255, 220, 90)),
		}
		panel.title.Text = "🛤️ TAPIS DU MARCHÉ · raretés"
		g.Parent = post
		result.belt = { body = body, panel = panel, gui = g, post = post }
	end

	-- Bases des joueurs : façade (-Z local) tournée vers la place, spawn devant ---------------------------
	local N = Config.PLOT_COUNT
	local half = M2.basePlatform / 2
	for i = 1, N do
		local pc = PLOT_COLORS[(i - 1) % #PLOT_COLORS + 1]
		local b = G.bases[(i - 1) % #G.bases + 1]
		local pos = Vector3.new(b.x, 0, b.z)
		local cf = CFrame.lookAt(pos, Vector3.new(M2.plaza.x, 0, M2.plaza.z)) -- l'avant (-Z) regarde la place
		local model = Instance.new("Model")
		model.Name = "Plot" .. i
		model.Parent = world
		local plat = part({ Name = "Platform", Size = Vector3.new(half * 2, 1, half * 2), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(62, 112, 88):Lerp(pc, 0.15), Material = Enum.Material.Concrete }, model)
		for _, e in ipairs({ { 0, -half + 0.5, half * 2, 1 }, { 0, half - 0.5, half * 2, 1 }, { -half + 0.5, 0, 1, half * 2 }, { half - 0.5, 0, 1, half * 2 } }) do -- liseré néon aux couleurs de la base
			part({ Name = "Edge", Size = Vector3.new(e[3], 0.25, e[4]), CFrame = cf * CFrame.new(e[1], 1.1, e[2]), Color = pc, Material = Enum.Material.Neon, CanCollide = false }, model)
		end
		for _, c in ipairs({ { -half + 1, -half + 1 }, { half - 1, -half + 1 }, { -half + 1, half - 1 }, { half - 1, half - 1 } }) do -- lampadaires
			part({ Name = "LampPost", Size = Vector3.new(0.9, 7, 0.9), CFrame = cf * CFrame.new(c[1], 4.5, c[2]), Color = Color3.fromRGB(50, 52, 60), Material = Enum.Material.Metal }, model)
			ball({ Name = "Lamp", Size = Vector3.new(1.8, 1.8, 1.8), CFrame = cf * CFrame.new(c[1], 8.4, c[2]), Color = Color3.fromRGB(255, 235, 170), Material = Enum.Material.Neon }, model)
		end
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 235, 190)
		glow.Range = 45
		glow.Brightness = 0.7
		glow.Parent = plat

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 0.4, 6)
		spawn.CFrame = cf * CFrame.new(0, 1.2, -M2.spawnForward)
		spawn.Color = pc
		spawn.Material = Enum.Material.Neon
		spawn.Transparency = 0.4
		spawn.Parent = model

		local pads = {}
		for idx = 1, Config.SLOTS_MAX do
			local lx, lz = Config.padLocal(idx)
			local frame = part({ Name = "PadFrame" .. idx, Size = Vector3.new(8.8, 0.3, 8.8), CFrame = cf * CFrame.new(lx, 1.12, lz), Color = pc, Material = Enum.Material.Neon, CanCollide = false }, model)
			local pad = part({ Name = "Pad" .. idx, Size = Vector3.new(8, 0.4, 8), CFrame = cf * CFrame.new(lx, 1.2, lz), Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7, CanCollide = false }, model)
			local lockText = sign(pad, "🔒", Color3.new(1, 1, 1), 2.5, 80)
			pads[idx] = { part = pad, lock = lockText.Parent, frame = frame, content = nil }
			if Config.Map.pedestals then
				sceneryParts += Scenery.pedestal(sceneryHelpers, (cf * CFrame.new(lx, 0.62, lz)).Position, model, nil, 8.6, true)
			end
		end

		local board = part({ Name = "Board", Size = Vector3.new(1, 7, 1), CFrame = cf * CFrame.new(17, 4.5, -25), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, model) -- lot 5 : le panneau passe devant (les emplacements occupent désormais tout le centre)
		local plank = part({ Name = "Plank", Size = Vector3.new(18, 4.2, 0.7), CFrame = cf * CFrame.new(17, 8.6, -25.4), Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.WoodPlanks }, model)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front -- face -Z de la planche = côté place
		sg.CanvasSize = Vector2.new(720, 168)
		sg.LightInfluence = 0
		sg.Adornee = plank
		sg.Parent = plank
		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Size = UDim2.fromScale(1, 1)
		nameLabel.Font = FONT
		nameLabel.TextScaled = true
		nameLabel.TextColor3 = pc
		nameLabel.TextStrokeTransparency = 0.3
		nameLabel.Text = "Base libre"
		nameLabel.Parent = sg
		board.Name = "BoardPole"

		builtPlots[i] = { spawn = spawn }
		result.plots[i] = { model = model, cf = cf, pads = pads, spawn = spawn, nameLabel = nameLabel, owner = nil, platform = plat, color = pc, index = i }
	end

	-- Chemins, eau, château, arène, secrets (chaque bloc est isolé : une erreur de décor ne bloque jamais le jeu)
	deco("paths", function()
		return Scenery.paths(sceneryHelpers, world, Config, G)
	end)
	deco("rivers", function()
		return Scenery.rivers(sceneryHelpers, world, Config, G)
	end)
	deco("lakes", function()
		return Scenery.lakes(sceneryHelpers, world, Config, G)
	end)
	local doorPos = nil
	deco("castlePlateau", function()
		local count, door = Scenery.castlePlateau(sceneryHelpers, world, Config, G)
		doorPos = door
		return count
	end)
	deco("castle", function()
		local cw, cn = Scenery.castle(sceneryHelpers, world, Castle, doorPos)
		result.castle = cw
		builtCastle = cw
		return cn
	end)
	deco("arena", function()
		return Scenery.arena(sceneryHelpers, world, Config)
	end)
	deco("secrets", function()
		return Scenery.secrets(sceneryHelpers, world, Config)
	end)

	-- Voyage rapide (Config.TRAVEL2) : 4 portails sur la rose des portails, un tapis de retour vers la place près de chaque arrivée, une arche
	-- « Retour à la base » par base sur la place (prompt serveur, tag « FastTravel », attribut Dest ; le serveur valide tout)
	result.fastTravel = {}
	do
		local folder = Instance.new("Folder")
		folder.Name = "FastTravel"
		folder.Parent = world
		local function pad(x, z, dest, label, color, arch)
			local p = part({ Name = "TravelPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7, 7), CFrame = CFrame.new(x, 0.55, z) * CFrame.Angles(0, 0, math.pi / 2), Color = color, Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false }, folder)
			part({ Name = "TravelRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 8.4, 8.4), CFrame = CFrame.new(x, 0.52, z) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.5, CanCollide = false }, folder)
			if arch then -- arche : deux piliers et un linteau (on passe dessous)
				for _, sx in ipairs({ -4, 4 }) do
					part({ Name = "TravelArch", Size = Vector3.new(1, 9, 1), Position = Vector3.new(x + sx, 4.5, z), Color = color:Lerp(Color3.fromRGB(80, 70, 60), 0.4), Material = Enum.Material.Slate }, folder)
				end
				part({ Name = "TravelArch", Size = Vector3.new(9.6, 1.2, 1.2), Position = Vector3.new(x, 9.4, z), Color = color, Material = Enum.Material.Neon, CanCollide = false }, folder)
			end
			sign(p, label, color:Lerp(Color3.new(1, 1, 1), 0.4), arch and 11 or 4.5, 190)
			local pr = Instance.new("ProximityPrompt")
			pr.ActionText = dest < 0 and "Rentrer à la base" or "Voyage rapide"
			pr.ObjectText = label
			pr.HoldDuration = 0.6
			pr.MaxActivationDistance = 8
			pr.RequiresLineOfSight = false
			pr:SetAttribute("Dest", dest)
			pr.Parent = p
			CollectionService:AddTag(pr, "FastTravel")
			result.fastTravel[#result.fastTravel + 1] = { prompt = pr, dest = dest, pos = Vector3.new(x, 0.3, z) }
		end
		local cols = { Color3.fromRGB(255, 130, 90), Color3.fromRGB(170, 120, 230), Color3.fromRGB(110, 200, 120), Color3.fromRGB(90, 190, 255) }
		for k, pt in ipairs(G.portals) do
			pad(pt.pad.x, pt.pad.z, k, "🌀 " .. pt.name .. (pt.chapter > 0 and ("\n🔒 chapitre " .. pt.chapter) or ""), cols[(k - 1) % #cols + 1], true)
			pad(pt.back.x, pt.back.z, 0, "🌀 Place du marché", Color3.fromRGB(255, 214, 120), false)
		end
		for i, a in ipairs(G.homeArches) do
			if i <= N then
				pad(a.x, a.z, -i, "🏠 Retour à la base " .. i, PLOT_COLORS[(i - 1) % #PLOT_COLORS + 1], true)
			end
		end
	end

	-- Pièges des territoires (REFONTE lot 4) : le plan vient de Traps.layout (pur, dérivé de Config.TERR) ; < 40 Parts au total. Le serveur (Main) les anime.
	result.traps = { layouts = {}, lights = {}, plates = {}, gate = nil, parts = 0 }
	do
		local function addPart(props, parent)
			props.CanCollide = props.CanCollide == true
			result.traps.parts += 1
			return part(props, parent)
		end
		for _, key in ipairs(Config.TERR_ORDER) do
			local L = TrapsMod.layout(Config, key)
			if L then
				result.traps.layouts[key] = L
				local folder = Instance.new("Folder")
				folder.Name = "Traps_" .. key
				folder.Parent = world
				local gy = G.groundY(L.cx, L.cz)
				for _, b in ipairs(L.bells) do
					local len = math.sqrt((b.bx - b.ax) ^ 2 + (b.bz - b.az) ^ 2)
					for _, e in ipairs({ { b.ax, b.az }, { b.bx, b.bz } }) do
						addPart({ Name = "BellPost", Size = Vector3.new(0.5, 3.4, 0.5), Position = Vector3.new(e[1], gy + 1.7, e[2]), Color = Color3.fromRGB(110, 76, 46), Material = Enum.Material.Wood }, folder)
					end
					local wire = addPart({ Name = "BellWire", Size = Vector3.new(0.12, 0.12, len), CFrame = CFrame.lookAt(Vector3.new(b.x, gy + 2.7, b.z), Vector3.new(b.bx, gy + 2.7, b.bz)), Color = Color3.fromRGB(255, 214, 90), Material = Enum.Material.Metal }, folder)
					sign(wire, "🔔", Color3.fromRGB(255, 226, 120), 1.2, 60)
				end
				for _, m in ipairs(L.mud) do
					addPart({ Name = "MudPuddle", Size = Vector3.new(0.15, m.r * 2, m.r * 2), CFrame = CFrame.new(m.x, gy + 0.3, m.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(88, 62, 42), Material = Enum.Material.Mud }, folder)
				end
				for plIdx, pl in ipairs(L.plates) do
					local plate = addPart({ Name = "AlarmPlate", Size = Vector3.new(0.25, pl.r * 2, pl.r * 2), CFrame = CFrame.new(pl.x, gy + 0.32, pl.z) * CFrame.Angles(0, 0, math.pi / 2), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(150, 60, 60), Material = Enum.Material.Metal }, folder)
					result.traps.plates[#result.traps.plates + 1] = { part = plate, key = key, index = plIdx }
				end
				for liIdx, l in ipairs(L.lights) do
					addPart({ Name = "LanternPole", Size = Vector3.new(0.6, 5.2, 0.6), Position = Vector3.new(l.x, gy + 2.6, l.z), Color = Color3.fromRGB(70, 70, 78), Material = Enum.Material.Metal }, folder)
					local beam = addPart({ Name = "LanternBeam", Size = Vector3.new(0.5, 0.5, l.range), Position = Vector3.new(l.x, gy + 5.2, l.z + l.range / 2), Color = Color3.fromRGB(255, 240, 160), Material = Enum.Material.Neon, Transparency = 0.55 }, folder)
					result.traps.lights[#result.traps.lights + 1] = { part = beam, key = key, index = liIdx, light = l, y = gy + 5.2 }
				end
			end
		end
		-- herse de la cour de Zed : la Part CourtGate de Scenery (levée, sans collision) devient une vraie herse de la hauteur du mur, animée par le serveur
		for _, d in ipairs(world:GetDescendants()) do
			if d.Name == "CourtGate" and d:IsA("BasePart") then
				d.Size = Vector3.new(d.Size.X, 8, d.Size.Z)
				result.traps.gate = { part = d, baseCF = d.CFrame, lift = -1 }
				break
			end
		end
	end

	local total = 0
	for _, d in ipairs(world:GetDescendants()) do
		if d:IsA("BasePart") then
			total += 1
		end
	end
	result.partCount = total
	result.sceneryParts = sceneryParts
	if total > Config.Map.budgetParts then
		warn("[Builder] budget mobile dépassé : " .. total .. " Parts (budget " .. Config.Map.budgetParts .. "). Réduis le décor (Scenery) ou Config.Map.budgetParts.")
	else
		print("[Builder] carte construite : " .. total .. " Parts (budget " .. Config.Map.budgetParts .. ")")
	end

	result.treadmillContains = function(p)
		local rel = result.treadmill.cf:PointToObjectSpace(p)
		local s = result.treadmill.size
		return math.abs(rel.X) <= s.X / 2 and math.abs(rel.Z) <= s.Z / 2 and rel.Y > 0 and rel.Y < 8
	end

	return result
end

---------------------------------------------------------------- Effets
-- Explosion de particules + flash lumineux à l'éclosion (disparaît seule).
function Builder.burst(position, color, count, big)
	local anchor = Instance.new("Part")
	anchor.Name = "Burst"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = position
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.LightEmission = 1
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Speed = NumberRange.new(big and 14 or 8, big and 32 or 18)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, big and 1.8 or 1), NumberSequenceKeypoint.new(1, 0) })
	e.Rate = 0
	e.Parent = anchor
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = big and 26 or 14
	l.Brightness = big and 6 or 3
	l.Parent = anchor
	anchor.Parent = workspace
	e:Emit(count)
	local ring = Instance.new("Part")
	ring.Name = "Shockwave"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 3, 3)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = color
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.2
	ring:SetAttribute("Big", big == true)
	CollectionService:AddTag(ring, "Shockwave") -- animée côté client
	ring.Parent = workspace
	game:GetService("Debris"):AddItem(ring, 1.5)
	game:GetService("TweenService"):Create(l, TweenInfo.new(0.7), { Brightness = 0 }):Play()
	game:GetService("Debris"):AddItem(anchor, 2.5)
end

-- Œuf qui vole vers le joueur qui vient de le prendre (animé côté client grâce au tag FlyEgg).
function Builder.flyEgg(tier, fromPos, userId)
	local egg = Builder.egg(tier, true)
	egg.Name = "FlyEgg"
	egg.CFrame = CFrame.new(fromPos)
	egg:SetAttribute("Target", userId)
	egg:SetAttribute("Start", fromPos)
	CollectionService:AddTag(egg, "FlyEgg")
	egg.Parent = workspace
	game:GetService("Debris"):AddItem(egg, 1.2)
	return egg
end

-- Pet suiveur : version miniature d'un pet, sans étiquette.
-- Aura d'une rareté élevée : cercle runique, particules, pilier de lumière (voir Scenery.aura), détruite seule. Retourne true si créée.
function Builder.aura(position, color, tier, secret)
	local style = Config.auraStyle(tier, secret, false)
	if not style then
		return false
	end
	local ok, anchor = pcall(function()
		local a = Scenery.aura({ part = part, ball = ball }, position, workspace, style, color)
		CollectionService:AddTag(a, "AuraFx")
		return a
	end)
	if not ok then
		return false
	end
	game:GetService("Debris"):AddItem(anchor, style.seconds)
	return true
end

-- Nid sous un œuf (paille : plateau, bord, brins) ; remplacé par le modèle Blender NidOeufs si disponible. Retourne le nombre de Parts du repli.
-- Protection Blender de l'œuf d'un emplacement selon la rareté (nid à barrière, dôme de verre, cage, cristaux) : mise à la largeur cible, vitre du dôme
-- translucide, lumière proportionnelle à la rareté. `budget` = { used = n } (Parts de protection déjà posées dans la base). Retourne le nombre de Parts
-- posées ou nil (repli : nid procédural). Ne lève jamais d'erreur.
function Builder.eggGuard(position, parent, tier, budget)
	if not eggAssets or not eggAssets.cloneModel then
		return nil
	end
	local key = Config.eggGuardKey(tier)
	local st = eggAssets.status and eggAssets.status["m:eggguard." .. key]
	local cost = (st and st.ok and st.parts) or 0
	if cost <= 0 or (budget and budget.used + cost > Config.Assets.eggGuardBudgetPerBase) then
		return nil
	end
	local clone = eggAssets.cloneModel("eggguard", key)
	if not clone then
		return nil
	end
	local ok, count = eggAssets.place(clone, position.X, position.Z, 0, nil, parent, Config.Assets.eggGuardWidth[key], position.Y)
	if not ok then
		return nil
	end
	pcall(function()
		clone.Name = "EggGuard"
		local glow = Config.eggGuardGlow(tier)
		local tint = Config.TIERS[math.min(math.max(tier, 1), #Config.TIERS)].color
		local first
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				first = first or d
				if AssetsMod.baseName(d.Name) == "Dome_Verre" then
					d.Transparency = 0.7
					d.Material = Enum.Material.Glass
					d.Color = d.Color:Lerp(tint, 0.35)
					d.CastShadow = false
				end
			end
		end
		if first then
			local l = Instance.new("PointLight")
			l.Name = "RarityGlow"
			l.Color = tint
			l.Brightness = glow.brightness
			l.Range = glow.range
			l.Parent = first
		end
	end)
	if budget then
		budget.used = budget.used + (count or cost)
	end
	pcall(function()
		parent:SetAttribute("GuardParts", count or cost) -- relu par clearPad pour rendre le budget à la base
	end)
	return count or cost
end

function Builder.nest(position, parent, tier, budget)
	if tier and Builder.eggGuard(position, parent, tier, budget) then
		return 0
	end
	-- modèle Blender NidOeufs s'il est chargé (cloné, jamais rechargé), sinon nid de paille procédural
	local clone = eggAssets and eggAssets.cloneProp and eggAssets.cloneProp("nest")
	if clone then
		local ok = eggAssets.place(clone, position.X, position.Z, 0, Config.Assets.propsHeight.nest, parent, nil, position.Y)
		if ok then
			return 0
		end
	end
	local ok, n = pcall(Scenery.nest, { part = part, ball = ball }, position, parent)
	return ok and n or 0
end

-- Pose les accessoires Blender sur la carte une fois chargés (arbres, sapins, rochers, buissons, cabanes, barrières, ponts) avec un budget de Parts :
-- le placement s'arrête dès que Config.Assets.propsBudgetParts serait dépassé. Positions déterministes, hors domaines, secrets, rivières et bases.
-- Retourne le nombre de Parts posées. Ne lève jamais d'erreur (tout sous pcall) ; rien n'est posé si les modèles sont absents (la carte reste procédurale).
function Builder.dressWorld(assets)
	local total, placed = 0, 0
	local ok = pcall(function()
		local world = workspace:FindFirstChild("World")
		local waited = 0
		while not world and waited < 30 do -- la carte est construite en parallèle : on l'attend (30 s au plus)
			task.wait(0.25)
			waited = waited + 0.25
			world = workspace:FindFirstChild("World")
		end
		if not world then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "BlenderProps"
		folder.Parent = world
		-- Pose PLANIFIÉE (Placement) : grille, empreintes sans recouvrement, rien dans l'eau ni sur un chemin, cabanes face à leur domaine, barrières
		-- alignées, ponts centrés sur leurs rivières et plus longs qu'elles.
		local plan = PlacementMod.new(Config).plan()
		local huts, treeIdx, fences = 0, 0, 0
		local function put(key, x, z, rot, length, gy)
			if total + (Config.Assets.propsMaxParts[key] or 0) > Config.Assets.propsBudgetParts then
				return
			end
			local clone, height = nil, Config.Assets.propsHeight[key]
			if key == "bridge" then
				clone = assets.cloneModel("props", "bridge_rail") -- pont à rampes (repli : pont simple)
			elseif key == "hut" then
				huts = huts + 1
				local alt = huts % 2 == 1 and "hut_big" or "hut_small"
				clone = assets.cloneModel("props", alt)
				height = clone and Config.Assets.targetHeights[alt] or height
			end
			if key == "fence" then
				fences = fences + 1
				clone = assets.cloneModel("props", fences % 4 == 0 and "fence_gate" or "fence_corner") -- barrières Blender (le catalogue d'accessoires reste le repli)
			end
			if key == "tree" or key == "fir" then
				treeIdx = treeIdx + 1
				local variant = PlacementMod.treeVariant(Config, key, x, z, treeIdx)
				local st = assets.status and assets.status["m:trees." .. variant]
				local vc = st and st.ok and st.parts or Config.Assets.propsMaxParts[key]
				if st and st.ok and total + vc <= Config.Assets.propsBudgetParts then
					clone = assets.cloneModel("trees", variant)
					if clone then
						height = (Config.Assets.treeHeights[variant] or height) * PlacementMod.jitter(x, z, Config.Assets.treeScaleJitter)
					end
				end
			end
			clone = clone or assets.cloneProp(key)
			if not clone then
				return
			end
			local okPlace, count = assets.place(clone, x, z, rot, height, folder, length, gy)
			if okPlace then
				total = total + count
				placed = placed + 1
			end
		end
		for _, it in ipairs(plan.items) do
			put(it.kind, it.x, it.z, it.rot, nil, it.y)
		end
		for _, b in ipairs(plan.bridges) do
			put("bridge", b.x, b.z, b.rot, b.length)
		end
	end)
	return ok and total or 0, placed
end

function Builder.follower(petIdx, sizeIdx, mutIdx)
	local model = Builder.pet(petIdx, sizeIdx, mutIdx)
	model:ScaleTo(0.45)
	model:SetAttribute("Seed", petIdx * 31 + sizeIdx * 7 + mutIdx)
	return model
end

---------------------------------------------------------------- Corbeau chipeur et tapis privé (lot 7)
-- Corbeau du vol à distance : modèle Blender `npc.raven` s'il a été chargé (aucun ID pour l'instant : REPLI procédural), sinon 6 Parts minuscules (corps, tête, bec, 2 ailes,
-- queue), sans collision, TEMPORAIRES (détruites à la fin du vol ; au plus un par joueur voleur). Retourne le modèle (PrimaryPart = corps) ; `Builder.ravenFlap` bat des ailes.
function Builder.raven(parent)
	local ok, model = pcall(function()
		local clone = eggAssets and eggAssets.cloneModel and eggAssets.cloneModel("npc", "raven")
		if not (clone and clone:IsA("Model")) then
			if clone then
				clone:Destroy()
			end
			return nil
		end
		local first
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				first = first or d
			end
		end
		if not first then
			clone:Destroy()
			return nil
		end
		clone.PrimaryPart = clone.PrimaryPart or first
		clone.Name = "Raven"
		return clone
	end)
	if not (ok and model) then
		model = Instance.new("Model")
		model.Name = "Raven"
		local black, grey = Color3.fromRGB(28, 28, 36), Color3.fromRGB(52, 52, 64)
		local function bit(name, size, off, color)
			local p = part({ Name = name, Size = size, CFrame = CFrame.new(off.X, off.Y, off.Z), Color = color, CanCollide = false, CanTouch = false, CanQuery = false }, model)
			return p
		end
		local body = bit("Body", Vector3.new(1.6, 1.4, 2.6), Vector3.new(0, 0, 0), black)
		bit("Head", Vector3.new(1.1, 1.1, 1.1), Vector3.new(0, 0.5, -1.7), black)
		bit("Beak", Vector3.new(0.4, 0.4, 0.9), Vector3.new(0, 0.4, -2.5), Color3.fromRGB(235, 170, 50))
		bit("WingL", Vector3.new(2.6, 0.2, 1.6), Vector3.new(-2, 0.2, 0), grey)
		bit("WingR", Vector3.new(2.6, 0.2, 1.6), Vector3.new(2, 0.2, 0), grey)
		bit("Tail", Vector3.new(1, 0.2, 1.4), Vector3.new(0, 0, 1.9), grey)
		model.PrimaryPart = body
	end
	model:SetAttribute("Flap", false)
	model.Parent = parent
	return model
end

-- Bat des ailes (alterne deux poses : pas de rotation, simple décalage vertical) : appelée quelques fois par seconde par le serveur pendant le vol.
function Builder.ravenFlap(model, up)
	local body = model and model.PrimaryPart
	if not body then
		return
	end
	local dy = up and 0.55 or -0.2
	for name, dx in pairs({ WingL = -2, WingR = 2 }) do
		local w = model:FindFirstChild(name)
		if w then
			w.CFrame = body.CFrame * CFrame.new(dx, dy, 0)
		end
	end
end

-- Tapis privé d'une base (pass PrivateBelt) : un dossier « PrivateBelt » dans le modèle de la base, avec le tapis 10 x 3 (1 Part, prompt réservé au propriétaire) et un petit œuf
-- par œuf en attente (3 au plus) : 4 Parts au maximum, détruit avec le propriétaire. `tiers` = raretés en attente. Retourne le dossier.
function Builder.privateBelt(plot, ownerId, tiers)
	Builder.clearPrivateBelt(plot)
	local P = Config.BELT.private
	local folder = Instance.new("Folder")
	folder.Name = "PrivateBelt"
	local belt = part({ Name = "PrivateBeltStrip", Size = Vector3.new(P.width, 0.3, P.depth), CFrame = plot.cf * CFrame.new(P.x or 0, 1.3, P.z), Color = Color3.fromRGB(46, 50, 62), Material = Enum.Material.Metal, CanCollide = false }, folder)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Prendre l'œuf gratuit"
	pr.ObjectText = "Tapis privé"
	pr.HoldDuration = 0.3
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr.Enabled = #tiers > 0
	pr:SetAttribute("Kind", "PrivBelt")
	pr:SetAttribute("Owner", ownerId)
	pr.Parent = belt
	local label = #tiers > 0 and ("🥚 " .. #tiers .. " œuf(s) à prendre") or "🛤️ Tapis privé"
	sign(belt, label, Color3.fromRGB(255, 235, 170), 3.5, 220)
	for i, t in ipairs(tiers) do
		local def = Config.TIERS[t]
		if def then
			local egg = ball({ Name = "PrivateEgg" .. i, Size = Vector3.new(1.9, 1.9, 1.9), CFrame = plot.cf * CFrame.new((P.x or 0) + (i - 2) * 3.4, 2.4, P.z), Color = def.color, Material = Enum.Material.SmoothPlastic, CanTouch = false, CanQuery = false }, folder)
			sign(egg, def.name, def.color, 2, 120)
		end
	end
	folder.Parent = plot.model
	plot.privateBelt = folder
	return folder
end

function Builder.clearPrivateBelt(plot)
	local f = plot and plot.privateBelt
	plot.privateBelt = nil
	if f then
		pcall(function()
			f:Destroy()
		end)
	end
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">Rules</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Rules
-- Règles de jeu PURES (aucun service Roblox) : tirages, revenus, durées, capacités.
-- Config est injectée (Rules.new(Config)) pour que ces règles se testent hors de Roblox (Lune, voir tests/run.luau).
local Rules = {}

function Rules.new(Config)
	local R = {}

	-- Plafond (en %) de la part « rareté supérieure » : garantit que le poids « identique » ne devient jamais négatif
	-- (niveau 10 du Trèfle + événement + Pass Chance + Potion donnaient 87 % + 22 % de « plus bas » = poids négatif).
	R.MAX_UP = Config.UPGRADE.maxUp or 70

	-- Tirage pondéré. `rnd` retourne un nombre dans [0, 1). Les poids négatifs sont traités comme 0.
	-- Ne retourne jamais un index de poids nul (sauf si tous les poids sont nuls : dernier index).
	function R.wpick(weights, rnd)
		local total, last = 0, #weights
		for i, w in ipairs(weights) do
			if w > 0 then
				total += w
				last = i
			end
		end
		if total <= 0 then
			return #weights
		end
		local r = rnd() * total
		for i, w in ipairs(weights) do
			if w > 0 then
				r -= w
				if r < 0 then
					return i
				end
			end
		end
		return last
	end

	-- Points de « rareté supérieure » (en %) selon les bonus actifs.
	function R.upPoints(luckLevel, luckEvent, passLucky, potionActive, serverLuck)
		local up = Config.UPGRADE.base + luckLevel -- 5 % de base : UNE chance d'amélioration d'un cran (jamais de rétrogradation)
		if luckEvent then
			up += Config.UPGRADE.event
		end
		-- lot 9 (BOOST_CAP) : les bonus PAYANTS (pass Chance, potion, pluie de chance) sont plafonnés ensemble à Config.BOOST_CAP.paidUp points
		local paid = 0
		if passLucky then
			paid += Config.UPGRADE.pass
		end
		if potionActive then
			paid += Config.LUCK_POTION_BONUS
		end
		if serverLuck then
			paid += Config.SERVER_LUCK.bonus -- pluie de chance offerte au serveur (lot 7) : valeur fixe, jamais cumulée avec elle-même
		end
		local capPaid = Config.BOOST_CAP and Config.BOOST_CAP.paidUp
		if type(capPaid) == "number" then
			paid = math.min(paid, capPaid)
		end
		return up + paid
	end

	-- Poids { plus bas, identique, plus haut } pour un œuf de rareté `tier`. Lot 9 : « plus haut » = rareté PUBLIÉE suivante (Config.nextLiveTier),
	-- seulement pour un œuf <= Config.UPGRADE.maxEggTier (Mythique) : Ultra Rare, Secret, Exclusif et Divin ont une rareté fixe.
	function R.tierWeights(tier, upPoints)
		local down = 0 -- l'œuf annoncé fixe la rareté : jamais de rareté inférieure
		local up = Config.eggUpShare(tier, math.min(math.max(type(upPoints) == "number" and upPoints or 0, 0), R.MAX_UP))
		return { down, 100 - down - up, up }
	end

	function R.pickTier(tier, upPoints, rnd)
		local k = R.wpick(R.tierWeights(tier, upPoints), rnd)
		if k == 3 then
			return Config.nextLiveTier(tier) or tier
		end
		return tier
	end

	function R.mutWeights(alienBoost)
		local w = {}
		for i, m in ipairs(Config.MUTS) do
			w[i] = m.weight
			if alienBoost and m.name == "Alien" then
				w[i] = m.weight * 5
			end
		end
		return w
	end

	function R.sizeWeights()
		local w = {}
		for i, z in ipairs(Config.SIZES) do
			w[i] = z.weight
		end
		return w
	end

	-- Tire un pet : { p = index d'espèce, s = index de taille, m = index de mutation }.
	-- `guaranteed` : tirage de pitié, le pet est forcément d'une rareté au-dessus de l'œuf (sauf œuf de rareté maximale).
	function R.rollPet(eggTier, upPoints, alienBoost, rnd, guaranteed)
		local tier
		eggTier = Config.liveEggTier(eggTier) -- rareté sans espèce publiée : celle publiée juste en dessous (A.3)
		if guaranteed and eggTier <= Config.UPGRADE.maxEggTier and Config.nextLiveTier(eggTier) then
			tier = Config.nextLiveTier(eggTier)
		else
			tier = R.pickTier(eggTier, upPoints, rnd)
		end
		local ids = {}
		for i, p in ipairs(Config.PETS) do
			if p.tier == tier then
				ids[#ids + 1] = i
			end
		end
		local pick = ids[math.min(#ids, math.floor(rnd() * #ids) + 1)]
		return { p = pick, s = R.wpick(R.sizeWeights(), rnd), m = R.wpick(R.mutWeights(alienBoost), rnd), tier = tier }
	end

	function R.multiplier(rebirths, foodLevel, goldEvent, pass2x, collectionBonus)
		local m = (1 + 0.5 * rebirths) * (1 + 0.2 * foodLevel) * (collectionBonus or 1)
		if goldEvent then
			m *= 2
		end
		if pass2x then
			m *= 2
		end
		return m
	end

	-- Capacité d'une base (REFONTE lot 5) : 4 + améliorations (0..8) + bonus du niveau de maison (Config.levelSlots, 0..4) + pass ExtraSlots (4) = 20 au plus.
	-- `level` et `passExtra` sont facultatifs (appels historiques : 4 + améliorations).
	function R.capacity(up, level, passExtra)
		local n = 4 + up.slots + (level and Config.levelSlots(level) or 0) + (passExtra and Config.PASS_EXTRA_SLOTS or 0)
		return math.min(n, Config.SLOTS_MAX)
	end

	-- Multiplicateur de revenu de la maison (1 + bonus du niveau).
	function R.levelMul(level)
		return Config.levelIncomeMul(level or 1)
	end

	function R.carryCapacity(up)
		return 1 + up.bag
	end

	function R.hatchTime(tier, incLevel, fastPass)
		return Config.HATCH[tier] * 0.9 ^ incLevel * (fastPass and 0.75 or 1)
	end

	function R.shieldTime(lockLevel)
		return Config.SHIELD_BASE + Config.SHIELD_PER_LEVEL * lockLevel
	end

	-- Revenu par seconde : somme des pets présents sur les emplacements débloqués, multipliée par `mult`.
	function R.income(slots, capacity, mult)
		local total = 0
		for i = 1, capacity do
			local sl = slots[i]
			if sl and sl.k == "p" then
				total += Config.petIncome(sl.p, sl.s, sl.m)
			end
		end
		return total * mult
	end

	return R
end

return Rules
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">Diag</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Diag
-- Classement pur des erreurs de services Roblox (testé hors Roblox). Aucune dépendance.
local Diag = {}

-- Studio sans « Enable Studio Access to API Services » : DataStore refusé, inutile de réessayer.
function Diag.isStudioApiError(err)
	local s = tostring(err)
	return s:find("StudioAccessToApisNotAllowed", 1, true) ~= nil
		or s:find("API access is not enabled", 1, true) ~= nil
		or s:find("Studio access to APIs is not allowed", 1, true) ~= nil
end

return Diag
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">HenQuest</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/HenQuest
-- REFONTE lot 6 : énigme de la Mère Poule côté SERVEUR (étapes guidées : plumes, runes, berceuse). Toutes les règles sont dans ReplicatedStorage/Riddle (pur,
-- testé) ; ici : l'état par joueur, les prompts, les 4 plumes du jour, la récompense, l'effet collectif et le journal.
-- Principe : le client n'envoie que des INTENTIONS (« Parler », « Ramasser », toucher une pierre, 4 boutons du dialogue) ; chaque distance, chaque étape,
-- chaque cadence et la récompense (une fois par jour) sont revalidées ici. Les distances sont calculées sur les coordonnées de Config (jamais sur une
-- valeur fournie par le client). Les textes viennent de Config.HEN_LINES : le serveur n'envoie que l'identifiant de la réplique et ses paramètres.
local HenQuest = {}

function HenQuest.new(ctx)
	local Config, Riddle, Builder = ctx.Config, ctx.Riddle, ctx.Builder
	local notify, sync = ctx.notify, ctx.sync
	local RHen = ctx.RHen
	local H = Config.HEN
	local M = {}
	local day0 = function()
		return os.time() // 86400
	end
	local feathers = {} -- [dir] = Part (4 plumes, déplacées chaque jour)
	local spots, spotsDay = nil, -1
	local riddleDay, riddleToday = -1, nil -- énigme du jour mise en cache (Config.riddleFor est pure mais appelée à chaque synchronisation)
	local function riddle(day)
		if riddleDay ~= day then
			riddleDay, riddleToday = day, Config.riddleFor(day)
		end
		return riddleToday
	end
	local collective = { day = -1, count = 0, fired = false }
	local folder = ctx.world.folder
	local geo = ctx.world.geo

	local function say(s, id, params)
		if s.player and s.player.Parent then
			RHen:FireClient(s.player, "say", id, params)
		end
	end

	function M.newState()
		return { stepAt = os.clock(), startT = os.clock(), fails = 0, lullFails = 0, pos = 1, listenUntil = 0, lastPick = -99, lastTap = -99, lastAct = -99, lastTalk = -99, lastDay = -1 }
	end

	-- Journal : un relevé à chaque étape (abandon par étape, temps passé, indices) lisible dans la sortie du serveur.
	local function log(s, step)
		print(string.format("[Riddle] step=%d t=%d hints=%d", step, math.floor(os.clock() - s.hen.startT), s.data.puzzle.hints))
	end

	-- Passe à l'étape suivante : remet à zéro le chronomètre de l'étape (indice gratuit après 5 min DANS l'étape) et les échecs de l'étape.
	local function enter(s, step)
		s.hen.stepAt = os.clock()
		s.hen.fails = 0
		s.hen.pos = 1
		log(s, step)
	end

	---------------------------------------------------------------- Les 4 plumes du jour
	local function placeFeathers(day)
		spots, spotsDay = Riddle.featherSpots(Config, day), day
		for dir = 1, 4 do
			local sp = spots[dir]
			sp.y = geo.groundY(sp.x, sp.z) + 2.4
			local f = feathers[dir]
			if not f then
				f = Builder.feather(folder, dir)
				feathers[dir] = f
			end
			f.CFrame = CFrame.new(sp.x, sp.y, sp.z) * CFrame.Angles(0, dir * 1.3, 0.35)
		end
	end
	placeFeathers(day0())

	-- Remise à jour de ce joueur pour le jour courant. Retourne true si une progression d'un autre jour a été remise à zéro.
	local function refresh(s, day)
		if not s.hen then
			s.hen = M.newState()
		end
		if day ~= spotsDay then
			placeFeathers(day)
		end
		local reset, lost = Riddle.normalize(s.data.puzzle, day)
		if reset then
			s.runes = { 1, 1, 1, 1 }
			s.runeLock = 0
			s.hen.stepAt, s.hen.fails, s.hen.lullFails, s.hen.pos, s.hen.listenUntil = os.clock(), 0, 0, 1, 0
			if lost then
				log(s, 0)
				notify(s.player, "🌙 Le Grand Œuf s'est rendormi : nouvelle berceuse aujourd'hui !") -- l'avancement d'hier est remis à zéro
			end
		end
		return reset and lost
	end

	local function stepNow(s, day)
		return Riddle.stepOf(s.data.puzzle, day)
	end

	local function henDist(root)
		local h = Config.Map2.hen
		return math.sqrt((root.Position.X - h.x) ^ 2 + (root.Position.Z - h.z) ^ 2)
	end

	local function sayStep(s)
		local day = day0()
		local p = s.data.puzzle
		local step = stepNow(s, day)
		if not Riddle.available(s.data.story.ch) then
			say(s, "locked")
		elseif step == 4 then
			say(s, "done", Riddle.doneParams(os.time()))
		elseif step == 0 then
			if not p.met then
				p.met = true
				say(s, "first")
			else
				say(s, "again")
			end
		elseif step == 1 then
			say(s, "missing", Riddle.missingParams(p.feathers))
		elseif step == 2 then
			say(s, "allFeathers")
		else
			say(s, "runesRight")
			M.play(s)
		end
	end

	---------------------------------------------------------------- Dialogue
	function M.talk(s, root)
		if henDist(root) > H.talkDistance then
			return
		end
		local now = os.clock()
		if now - s.hen.lastTalk < 0.4 then
			return
		end
		s.hen.lastTalk = now
		refresh(s, day0())
		sayStep(s)
		sync(s)
	end

	local function near(s, maxDist)
		local root = ctx.getRoot(s.player)
		return root ~= nil and henDist(root) <= maxDist
	end

	local function throttle(s)
		local now = os.clock()
		if now - s.hen.lastAct < 0.5 then
			return false
		end
		s.hen.lastAct = now
		return true
	end

	-- « J'y vais ! » : accepte l'énigme du jour (étape 0 -> 1).
	function M.go(s)
		if not throttle(s) or not near(s, H.talkDistance + 16) then
			return
		end
		local day = day0()
		refresh(s, day)
		local ok, why = Riddle.start(s.data.puzzle, day, Riddle.available(s.data.story.ch))
		if ok then
			s.hen.startT = os.clock()
			s.data.puzzle.met = true
			enter(s, 1)
			notify(s.player, "📜 Berceuse du jour : étape 1/3 — trouve les 4 plumes dorées (suis la flèche jaune).", "claim")
			sync(s)
		elseif why == "started" then
			sayStep(s)
		elseif why == "locked" then
			say(s, "locked")
		else
			say(s, "done", Riddle.doneParams(os.time()))
		end
	end

	function M.explain(s)
		if not throttle(s) or not near(s, H.talkDistance + 16) then
			return
		end
		say(s, "explain")
	end

	-- « 💡 Un coup de bec » : 2 indices par jour (voir Riddle.hintStatus), jamais payants.
	function M.hint(s)
		if not throttle(s) or not near(s, H.talkDistance + 16) then
			return
		end
		local day = day0()
		refresh(s, day)
		local p = s.data.puzzle
		local ok, why, extra = Riddle.hintStatus(Config, p, day, os.clock() - s.hen.stepAt, s.hen.fails)
		if not ok then
			if why == "wait" then
				say(s, "hintWait", { mm = math.floor(extra / 60), ss = string.format("%02d", extra % 60) })
			elseif why == "fails" then
				say(s, "hintFails", { n = extra or H.failsForHint })
			elseif why == "max" then
				say(s, "hintMax")
			end
			return
		end
		local id, params = Riddle.hintFor(Config, p, day, s.runes)
		if not id then
			return
		end
		p.hints = p.hints + 1
		say(s, id, params)
		print(string.format("[Riddle] step=%d t=%d hints=%d (indice)", Riddle.stepOf(p, day), math.floor(os.clock() - s.hen.startT), p.hints))
		sync(s)
	end

	---------------------------------------------------------------- Plumes
	function M.pickFeather(s, root, prompt)
		local dir = prompt:GetAttribute("Dir")
		if type(dir) ~= "number" or dir % 1 ~= 0 or dir < 1 or dir > 4 or prompt.Parent ~= feathers[dir] then
			return
		end
		local day = day0()
		refresh(s, day)
		local p = s.data.puzzle
		if not Riddle.available(s.data.story.ch) then
			return
		end
		local sp = spots[dir]
		local dist = math.sqrt((root.Position.X - sp.x) ^ 2 + (root.Position.Z - sp.z) ^ 2)
		local now = os.clock()
		if not Riddle.pickupAllowed(Config, dist, now, s.hen.lastPick) then
			return
		end
		local step = stepNow(s, day)
		if step == 0 then
			say(s, "again") -- il faut d'abord parler à la Mère Poule
			return
		end
		local ok, n = Riddle.collect(p, day, dir)
		if not ok then
			return
		end
		s.hen.lastPick = now
		local line, clue = Riddle.featherLine(Config, day, dir)
		RHen:FireClient(s.player, "feather", dir, clue)
		notify(s.player, line, "plume_ramassee")
		if n == 4 then
			local moved = Riddle.toRunes(p, day)
			if moved then
				enter(s, 2)
				say(s, "allFeathers")
			end
		end
		sync(s)
	end

	---------------------------------------------------------------- Runes
	local function runeDistance(root, idx)
		local st = Config.Map2.runeStones[idx]
		return math.sqrt((root.Position.X - st.x) ^ 2 + (root.Position.Z - st.z) ^ 2)
	end

	function M.rotateRune(s, root, prompt)
		local idx = prompt:GetAttribute("Idx")
		if type(idx) ~= "number" or idx % 1 ~= 0 or idx < 1 or idx > #Config.RUNES then
			return
		end
		if runeDistance(root, idx) > H.singDistance then
			return
		end
		local day = day0()
		refresh(s, day)
		local now = os.clock()
		if now - s.lastRune < 0.12 then
			return
		end
		s.lastRune = now
		if not Riddle.runeUnlocked(s.data.puzzle, day, idx) then
			if Riddle.available(s.data.story.ch) and stepNow(s, day) ~= 4 and now - (s.hen.lastWait or -99) > 1.5 then
				s.hen.lastWait = now
				notify(s.player, Riddle.format(Config.HEN_LINES.runeWaits, { dir = Riddle.DIR_OF[idx] }))
			end
			return
		end
		s.runes[idx] = s.runes[idx] % #Config.RUNES + 1
		sync(s)
	end

	-- Écoute de la berceuse : les 4 pierres s'allument dans l'ordre (le client joue les notes et les lueurs). Le serveur refuse les touches pendant l'écoute.
	function M.play(s)
		local day = day0()
		local seq = Riddle.lullaby(Config, day)
		s.hen.pos = 1
		s.hen.listenUntil = os.clock() + Riddle.lullabyDuration(Config) + 0.2
		RHen:FireClient(s.player, "lullaby", seq, H.lullabyNote, H.lullabyGap)
	end

	function M.replay(s)
		if not throttle(s) then
			return
		end
		local root = ctx.getRoot(s.player)
		if not root then
			return
		end
		local e = Config.Map2.bigEgg
		if henDist(root) > 40 and math.sqrt((root.Position.X - e.x) ^ 2 + (root.Position.Z - e.z) ^ 2) > 40 then
			return
		end
		local day = day0()
		refresh(s, day)
		if stepNow(s, day) == 3 and os.clock() >= s.hen.listenUntil then
			M.play(s)
		end
	end

	-- Validation des runes sur le Grand Œuf : on ne dit QUE le nombre de runes justes. Pause RUNE_LOCK_SECONDS après une erreur (existante).
	function M.confirmRunes(s, root)
		local e = Config.Map2.bigEgg
		if math.sqrt((root.Position.X - e.x) ^ 2 + (root.Position.Z - e.z) ^ 2) > 20 then
			return
		end
		local day = day0()
		refresh(s, day)
		local p = s.data.puzzle
		local step = stepNow(s, day)
		if not Riddle.available(s.data.story.ch) then
			say(s, "locked")
			return
		elseif step == 4 then
			notify(s.player, "🔮 Tu as déjà chanté aujourd'hui. Reviens demain !")
			return
		elseif step == 0 then
			say(s, "again")
			return
		elseif step == 1 then
			say(s, "needFeathers", { dirs = Riddle.missingDirs(p.feathers) })
			return
		elseif step == 3 then
			M.play(s)
			return
		end
		local now = os.clock()
		if now < s.runeLock then
			notify(s.player, Config.HEN_LINES.runesLocked)
			return
		end
		local k = Riddle.runesCorrect(s.runes, riddle(day).answer)
		if k < 4 then
			s.runeLock = now + Config.RUNE_LOCK_SECONDS
			s.hen.fails = s.hen.fails + 1
			say(s, "runesWrong", { k = k })
			notify(s.player, Riddle.format(Config.HEN_LINES.runesWrong, { k = k }), "caught")
			return
		end
		if Riddle.toLullaby(p, day, k) then
			enter(s, 3)
			say(s, "runesRight")
			M.play(s)
			sync(s)
		end
	end

	---------------------------------------------------------------- Berceuse
	local function grant(s, tier)
		local i = ctx.freeSlot(s)
		if i then
			s.data.slots[i] = { k = "e", t = tier, ends = os.time() + ctx.hatchTime(s, tier), shield = os.time() + ctx.shieldTime(s) }
			ctx.refreshPad(s, i)
			return true
		end
		s.data.coins = s.data.coins + Config.eggCoinValue(tier) -- base pleine : l'œuf est converti en pièces (prix plein)
		return false
	end

	local function reward(s, day)
		local p = s.data.puzzle
		local ok, r = Riddle.complete(Config, p, day, true)
		if not ok then
			return
		end
		local d = s.data
		local coins = Config.puzzleCoins(ctx.income(s))
		if ctx.onSolved then
			pcall(ctx.onSolved, s) -- lot 9 : mesure « énigme du jour réussie »
		end
		local placed = grant(s, r.eggTier)
		d.coins = d.coins + coins
		local msg = "🔮 Le Grand Œuf s'éveille ! +" .. Config.fmt(coins) .. " 🪙 et " .. (placed and ("un œuf " .. Config.TIERS[r.eggTier].name .. " dans ta base") or "la valeur d'un œuf (base pleine)")
		msg = msg .. " · 🥚 Fragment du Grand Œuf " .. (r.fragments % H.fragmentsForEgg == 0 and H.fragmentsForEgg or r.fragments % H.fragmentsForEgg) .. "/" .. H.fragmentsForEgg
		notify(s.player, msg, "secret_decouvert") -- énigme réussie (lot 8A)
		if r.legendary > 0 then
			for _ = 1, r.legendary do
				local placedL = grant(s, 5) -- lot 9 : Légendaire = 5
				notify(s.player, "🌟 " .. H.fragmentsForEgg .. " fragments réunis : un œuf Légendaire" .. (placedL and " t'attend dans ta base !" or " (base pleine : converti en pièces)."), "legendary")
			end
		end
		if r.titleNew then
			notify(s.player, "🏷 Nouveau titre : " .. Config.TITLE_HEN.name, "claim")
		end
		s.runes = { 1, 1, 1, 1 }
		s.hen.pos = 1
		Builder.burst(ctx.world.monumentCenter, Color3.fromRGB(255, 214, 120), 140, true)
		say(s, "success")
		log(s, 4)
		ctx.story(s, "puzzle", 1)
		-- effet collectif : 3 énigmes résolues sur ce serveur aujourd'hui -> « Pluie de chance » gratuite pour tous (une fois par jour et par serveur)
		if Riddle.collectiveAdd(Config, collective, day) then
			for _, e in ipairs(Config.EVENTS) do
				if e.key == "luck" then
					ctx.setEvent(e, H.collectiveSeconds)
				end
			end
			for _, o in pairs(ctx.sessions) do
				notify(o.player, "🍀 " .. H.collectiveSolves .. " berceuses chantées aujourd'hui : Pluie de chance offerte à tout le serveur pendant " .. math.floor(H.collectiveSeconds / 60) .. " min !", "event")
			end
		end
		sync(s)
	end

	function M.sing(s, root, prompt)
		local idx = prompt:GetAttribute("Idx")
		if type(idx) ~= "number" or idx % 1 ~= 0 or idx < 1 or idx > 4 or runeDistance(root, idx) > H.singDistance then
			return
		end
		local day = day0()
		refresh(s, day)
		local now = os.clock()
		if now < s.hen.listenUntil then
			return -- écoute en cours : les touches sont ignorées
		end
		if not Riddle.tapAllowed(Config, now, s.hen.lastTap) then
			return -- trop rapide (< 0,25 s) : refusée, sans compter comme une erreur
		end
		s.hen.lastTap = now
		local seq = Riddle.lullaby(Config, day)
		local res, pos = Riddle.tap(seq, s.hen.pos, idx)
		s.hen.pos = pos
		if res == "wrong" then
			s.hen.lullFails = s.hen.lullFails + 1
			RHen:FireClient(s.player, "tap", idx, false)
			say(s, "lullabyWrong")
			M.play(s) -- la suite est rejouée, sans pause
			sync(s)
		else
			RHen:FireClient(s.player, "tap", idx, true)
			if res == "done" then
				reward(s, day)
			else
				sync(s)
			end
		end
	end

	-- Prompt d'une pierre runique : selon l'étape, tourner la rune (1 et 2) ou chanter (3).
	function M.stoneTap(s, root, prompt)
		local day = day0()
		refresh(s, day)
		if stepNow(s, day) == 3 then
			M.sing(s, root, prompt)
		else
			M.rotateRune(s, root, prompt)
		end
	end

	---------------------------------------------------------------- État publié au client
	function M.snapshot(s)
		local day = day0()
		refresh(s, day)
		local p = s.data.puzzle
		local avail = Riddle.available(s.data.story.ch)
		local step = stepNow(s, day)
		local out = {
			avail = avail, step = step, feathers = p.feathers, count = Riddle.featherCount(p.feathers), hints = p.hints, hintMax = H.hintsPerDay,
			fragments = p.fragments, nextAt = (day + 1) * 86400, alert = avail and step < 4, lullabyPos = step == 3 and (s.hen.pos - 1) or 0,
			spots = {}, clues = {}, solved = p.solved,
		}
		if step == 1 then
			for dir = 1, 4 do
				if not Riddle.hasFeather(p.feathers, dir) then
					out.spots[#out.spots + 1] = { dir = dir, x = spots[dir].x, z = spots[dir].z }
				end
			end
		end
		if step >= 1 and step <= 3 then
			for dir = 1, 4 do
				if Riddle.hasFeather(p.feathers, dir) then
					out.clues[dir] = riddle(day).clues[dir]
				end
			end
		end
		return out
	end

	-- Toutes les 5 s : changement de jour (plumes déplacées, progression de chacun remise à zéro et publiée).
	function M.tick()
		local day = day0()
		if day ~= spotsDay then
			placeFeathers(day)
		end
		for _, s in pairs(ctx.sessions) do
			if refresh(s, day) then
				sync(s)
			end
		end
	end

	M.feathers = feathers
	M.collective = collective
	task.spawn(function()
		while true do
			task.wait(5)
			local ok, err = pcall(M.tick)
			if not ok then
				warn("[HenQuest] " .. tostring(err))
			end
		end
	end)
	return M
end

return HenQuest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">Scenery</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Scenery
-- Décor de la carte (REFONTE lot 2 : carte 700 x 500, géométrie de MapGeo) : place du marché, territoires, chemins, eau, château, arène, relief,
-- secrets. Tout en Parts de base ; les outils de construction de Builder sont injectés (h.part, h.ball, h.tree, h.torch, h.sign). Chaque fonction
-- retourne le nombre de Parts créées (budget mobile).
local CollectionService = game:GetService("CollectionService")

local Scenery = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function cyl(h, props, parent, diameter, height, pos, rotY)
	-- cylindre à axe vertical : height = hauteur, diameter = diamètre
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(pos) * CFrame.Angles(0, rotY or 0, math.pi / 2)
	return h.part(props, parent)
end

local function light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
	return l
end

local function emitter(parent, color, rate, speed, life, size, accel)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.7, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(40, 40)
	e.Acceleration = accel or Vector3.new(0, 0, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 0.8
	e.Parent = parent
	return e
end

---------------------------------------------------------------- Château : 5 salles à pièges, entrée, coffre final, tableau des temps
-- Construit le donjon décrit par Castle (géométrie pure). Retourne (monde, nombre de Parts) : monde.rooms[r] = { spikes = { {base, spikes} }, blades = {...},
-- balls = {...}, door }, monde.chest (Part), monde.entry (Part), monde.board (TextLabel). Les pièges sont animés côté serveur (voir Main).
-- REFONTE (lot 2) : `entry` (facultatif, Vector3) = porte du donjon sur le plateau du château ; l'entrée et le tableau des temps y sont posés.
function Scenery.castle(h, parent, Castle, entry)
	local world = { rooms = {} }
	local n = 0
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	local W, L = Castle.ROOM_WIDTH, Castle.ROOM_LENGTH
	for r = 1, Castle.ROOMS do
		local room = Castle.room(r)
		local cx, cz = Castle.toWorld(r, 0, L / 2)
		local rec = { spikes = {}, blades = {}, balls = {}, knights = {} }
		world.rooms[r] = rec
		P({ Name = "CastleFloor" .. r, Size = Vector3.new(W, 1, L), Position = Vector3.new(cx, -0.5, cz), Color = r % 2 == 0 and rgb(122, 118, 132) or rgb(104, 100, 114), Material = Enum.Material.Slate })
		for _, sx in ipairs({ -1, 1 }) do
			P({ Name = "CastleWall", Size = Vector3.new(2, 14, L), Position = Vector3.new(cx + sx * (W / 2 + 1), 7, cz), Color = rgb(96, 92, 106), Material = Enum.Material.Slate })
		end
		-- liseré de salle (couleur de difficulté : de vert à rouge) et torches
		local heat = (r - 1) / (Castle.ROOMS - 1)
		local ex, ez = Castle.toWorld(r, 0, 0.6)
		P({ Name = "CastleStartLine", Size = Vector3.new(W, 0.15, 1.2), Position = Vector3.new(ex, 0.08, ez), Color = Color3.fromRGB(math.floor(80 + 175 * heat), math.floor(230 - 150 * heat), 90), Material = Enum.Material.Neon, CanCollide = false })
		for _, sx in ipairs({ -1, 1 }) do
			local tx, tz = Castle.toWorld(r, sx * (W / 2 - 1), 4)
			local torch = P({ Name = "CastleTorch", Size = Vector3.new(1, 1, 1), Position = Vector3.new(tx, 6, tz), Color = rgb(255, 150, 60), Material = Enum.Material.Neon, CanCollide = false })
			light(torch, rgb(255, 170, 90), 22, 1)
		end
		-- pics : plaque + pointes (la pointe monte quand le danger approche)
		for i, sp in ipairs(Castle.spikes(room)) do
			local wx, wz = Castle.toWorld(r, sp.lx, sp.lz)
			local base = P({ Name = "SpikePlate", Size = Vector3.new(6.4, 0.3, 6.4), Position = Vector3.new(wx, 0.15, wz), Color = rgb(70, 70, 80), Material = Enum.Material.Metal, CanCollide = false })
			local tip = P({ Name = "SpikeTips", Size = Vector3.new(5, 1.6, 5), Position = Vector3.new(wx, -1, wz), Color = rgb(210, 214, 222), Material = Enum.Material.Metal, CanCollide = false })
			rec.spikes[i] = { base = base, tip = tip, wx = wx, wz = wz }
		end
		-- lames : un bras traversant (deux demi-bras) autour d'un moyeu
		for i, bl in ipairs(Castle.blades(room)) do
			local wx, wz = Castle.toWorld(r, bl.lx, bl.lz)
			P({ Name = "BladeHub", Size = Vector3.new(2.4, 2.4, 2.4), Position = Vector3.new(wx, 1.4, wz), Color = rgb(60, 60, 70), Material = Enum.Material.Metal, CanCollide = false })
			local arm = P({ Name = "BladeArm", Size = Vector3.new(bl.arm * 2, 0.5, 1.4), Position = Vector3.new(wx, 1.4, wz), Color = rgb(215, 220, 232), Material = Enum.Material.Metal, CanCollide = false })
			CollectionService:AddTag(arm, "CastleBlade") -- le client joue la boucle de la lame selon la distance
			rec.blades[i] = { arm = arm, wx = wx, wz = wz }
		end
		-- boulets : sphère qui traverse la salle (cachée sous le sol pendant la pause)
		for i, ba in ipairs(Castle.balls(room)) do
			local wx, wz = Castle.toWorld(r, 0, ba.lz)
			local ball = h.ball({ Name = "Boulder", Size = Vector3.new(ba.radius * 2, ba.radius * 2, ba.radius * 2), Position = Vector3.new(wx, -10, wz), Color = rgb(122, 127, 140), Material = Enum.Material.Slate }, parent)
			n += 1
			CollectionService:AddTag(ball, "CastleBall")
			rec.balls[i] = { part = ball, wz = wz }
		end
		-- chevaliers : silhouette d'armure (pilote de la logique ; remplacée par le modèle Blender si chargé)
		for i, kn in ipairs(Castle.knights(room)) do
			local wx, wz = Castle.toWorld(r, 0, kn.lz)
			local k = P({ Name = "CastleKnight", Size = Vector3.new(3, 6, 3), Position = Vector3.new(wx, 3, wz), Color = rgb(150, 156, 170), Material = Enum.Material.Metal, CanCollide = false })
			rec.knights[i] = { part = k, wz = wz }
		end
		-- porte de fin de salle (s'ouvre par intervalles)
		local dx, dz = Castle.toWorld(r, 0, L - 1)
		rec.door = P({ Name = "CastleDoor" .. r, Size = Vector3.new(W, 9, 1.2), Position = Vector3.new(dx, 4.5, dz), Color = rgb(74, 74, 82), Material = Enum.Material.Metal })
		rec.doorClosedY, rec.doorX, rec.doorZ = 4.5, dx, dz
	end
	-- entrée (le joueur peut y entrer depuis l'arène) : arche et invite
	local ex, ez = Castle.toWorld(1, 0, -6)
	local ey = 0
	if entry then
		ex, ey, ez = entry.X, entry.Y, entry.Z
	end
	local entryPart = P({ Name = "CastleEntry", Size = Vector3.new(14, 1, 8), Position = Vector3.new(ex, ey + 0.5, ez), Color = rgb(255, 110, 60), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.3 })
	for _, sx in ipairs({ -8, 8 }) do
		P({ Name = "CastleGatePillar", Size = Vector3.new(3, 16, 3), Position = Vector3.new(ex + sx, ey + 8, ez), Color = rgb(112, 108, 120), Material = Enum.Material.Slate })
	end
	P({ Name = "CastleGateTop", Size = Vector3.new(19, 3, 3), Position = Vector3.new(ex, ey + 17, ez), Color = rgb(96, 92, 104), Material = Enum.Material.Slate })
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Entrer"
	pr.ObjectText = "🏰 Le Château"
	pr.HoldDuration = 0.8
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	CollectionService:AddTag(pr, "CastleEntry")
	pr.Parent = entryPart
	world.entry = entryPart
	-- coffre final au bout de la salle 5
	local cx2, cz2 = Castle.toWorld(Castle.ROOMS, 0, L - 5)
	local chest = P({ Name = "CastleChest", Size = Vector3.new(6, 4, 4), Position = Vector3.new(cx2, 2, cz2), Color = rgb(150, 98, 44), Material = Enum.Material.Wood })
	P({ Name = "CastleChestLid", Size = Vector3.new(6.4, 1.4, 4.4), Position = Vector3.new(cx2, 4.4, cz2), Color = rgb(232, 185, 35), Material = Enum.Material.Metal, CanCollide = false })
	light(chest, rgb(255, 215, 90), 26, 1.6)
	local cp = Instance.new("ProximityPrompt")
	cp.ActionText = "Ouvrir le coffre"
	cp.ObjectText = "🏆 Trésor du Château"
	cp.HoldDuration = 1
	cp.MaxActivationDistance = 12
	cp.RequiresLineOfSight = false
	CollectionService:AddTag(cp, "CastleChest")
	cp.Parent = chest
	world.chest = chest
	-- tableau des meilleurs temps, à l'entrée
	local bx, bz = Castle.toWorld(1, 18, -6)
	if entry then
		bx, bz = ex - 18, ez
	end
	local board = P({ Name = "CastleBoard", Size = Vector3.new(11, 7, 0.7), Position = Vector3.new(bx, ey + 6, bz), Color = rgb(40, 30, 34), Material = Enum.Material.WoodPlanks })
	local bb = Instance.new("BillboardGui")
	bb.Adornee = board
	bb.Size = UDim2.fromOffset(360, 200)
	bb.MaxDistance = 110
	bb.LightInfluence = 0
	bb.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextColor3 = rgb(255, 214, 120)
	label.Text = "🏰 Meilleurs temps\n(aucun pour l'instant)"
	label.Parent = bb
	world.board = label
	return world, n
end

---------------------------------------------------------------- Nid de paille sous un œuf (repli procédural de NidOeufs)
function Scenery.nest(h, position, parent)
	local n = 0
	cyl(h, { Name = "NestBase", Color = rgb(196, 150, 70), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent, 6, 0.5, position + Vector3.new(0, 0.3, 0))
	cyl(h, { Name = "NestRim", Color = rgb(150, 104, 44), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent, 6.8, 0.35, position + Vector3.new(0, 0.2, 0))
	n += 2
	for i = 1, 8 do -- brins de paille dépassant du bord
		local a = i / 8 * math.pi * 2
		h.part({ Name = "NestStraw", Size = Vector3.new(0.3, 0.25, 1.6), CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 3.2, 0.55, math.sin(a) * 3.2)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = rgb(226, 190, 100), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, parent)
		n += 1
	end
	return n
end

---------------------------------------------------------------- Piédestal hexagonal des emplacements (lumières chaudes)
-- Trois dalles croisées à 60° dessinent un hexagone ; liseré néon chaud. Retourne le nombre de Parts.
function Scenery.pedestal(h, position, parent, warm, diam, noGlow)
	-- diam / noGlow (lot 5) : les 20 emplacements d'une base sont espacés de 9 studs : dalle de 8,6 studs et pas d'anneau lumineux (budget de Parts, aucun chevauchement coplanaire)
	local d = diam or 9.6
	cyl(h, { Name = "PedestalSlab", Color = rgb(210, 200, 184), Material = Enum.Material.Marble, CanCollide = false }, parent, d, 0.5, position)
	if noGlow then
		return 1
	end
	cyl(h, { Name = "PedestalGlow", Color = warm or rgb(255, 190, 90), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.45 }, parent, d + 0.8, 0.15, position + Vector3.new(0, -0.15, 0))
	return 2
end

---------------------------------------------------------------- Aura des raretés élevées : cercle runique au sol, piliers, particules
-- style = Config.auraStyle(...) ; color = couleur de rareté. Disparaît seule après style.seconds (Debris côté appelant). Retourne (ancre, nombre de Parts).
function Scenery.aura(h, position, parent, style, color)
	local n = 0
	local anchor = h.part({ Name = "AuraAnchor", Size = Vector3.new(1, 1, 1), Position = position, Transparency = 1, CanCollide = false, CanQuery = false }, parent)
	n += 1
	-- lot 8A : toutes les pièces sont ENFANTS de l'ancre (le Debris de l'appelant détruit l'ancre seule : avant, anneaux, glyphes et sommet du pilier
	-- restaient dans le Workspace à chaque éclosion Légendaire+ ; fuite trouvée par le test de charge de 10 min)
	cyl(h, { Name = "RuneRing", Color = color, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, CanQuery = false }, anchor, 11, 0.15, position + Vector3.new(0, 0.2, 0))
	cyl(h, { Name = "RuneRingInner", Color = color, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, CanQuery = false }, anchor, 7, 0.15, position + Vector3.new(0, 0.25, 0))
	n += 2
	for i = 1, style.runes do -- glyphes : petits blocs néon répartis sur le cercle
		local a = i / style.runes * math.pi * 2
		h.part({ Name = "Rune", Size = Vector3.new(0.5, 0.2, 1.1), CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 4.6, 0.3, math.sin(a) * 4.6)) * CFrame.Angles(0, -a, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }, anchor)
		n += 1
	end
	local em = emitter(anchor, color, style.rate, 7, 1.6, 0.5, Vector3.new(0, 2, 0))
	em.SpreadAngle = Vector2.new(25, 25)
	light(anchor, color, 24, 1.6)
	if style.pillar then -- Beam : pilier de lumière
		local top = h.part({ Name = "AuraTop", Size = Vector3.new(1, 1, 1), Position = position + Vector3.new(0, 26, 0), Transparency = 1, CanCollide = false, CanQuery = false }, anchor)
		n += 1
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Parent = anchor
		a1.Parent = top
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1 = a0, a1
		beam.Width0, beam.Width1 = 3.2, 1.2
		beam.Color = ColorSequence.new(color)
		beam.Transparency = NumberSequence.new(0.3)
		beam.LightEmission = 1
		beam.FaceCamera = true
		beam.Parent = anchor
	end
	return anchor, n
end

---------------------------------------------------------------- Eau : rivières en polylignes, murs invisibles, ponts, lacs, pontons, cabane, cascade
-- REFONTE (lot 2). Hauteurs des dessus (jamais deux surfaces coplanaires qui se recouvrent, écart >= 0,06) : chemins de terre 0,04 / 0,10 (coudes 0,16),
-- disques des territoires 0,22, routes pavées 0,28 / 0,34 (coudes 0,40), bord de la place 0,46, place 0,52, place du Grand Œuf 0,58, rives des lacs 0,16,
-- rivière du Nord et ruisseau des Saules 0,64 / 0,70 (coudes 0,76), ruisseau du Moulin 0,88, lacs 0,94, douve 1,00, pontons 1,10, fontaine 1,30.
-- Une Part d'eau par segment (deux hauteurs alternées, disque aux sommets : jamais deux faces coplanaires), mur invisible le long
-- de la rivière du Nord SAUF aux ponts (G.riverWalls), pile sous le pont du château (on ne passe pas dessous), planches des ponts de bois.
local WATER = Color3.fromRGB(60, 150, 220)

local function flatSeg(h, props, parent, ax, az, bx, bz, width, y, thick)
	local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
	props.Size = Vector3.new(width, thick or 0.3, len)
	props.CFrame = CFrame.lookAt(Vector3.new((ax + bx) / 2, y, (az + bz) / 2), Vector3.new(bx, y, bz))
	return h.part(props, parent)
end
Scenery.flatSeg = flatSeg

function Scenery.rivers(h, parent, cfg, G)
	local n = 0
	local M2 = cfg.Map2
	for ri, rv in ipairs(M2.rivers) do
		local pts = rv.pts
		for k = 1, #pts - 1 do
			local segTop = ri == 2 and 0.88 or ((k % 2 == 1) and 0.64 or 0.70)
			flatSeg(h, { Name = rv.name, Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent, pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2], rv.width, segTop - 0.15)
			n += 1
			if k > 1 then
				cyl(h, { Name = rv.name, Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent, rv.width, 0.3, Vector3.new(pts[k][1], 0.76 - 0.15, pts[k][2]))
				n += 1
			end
		end
		if rv.ford then -- gué : trois pierres plates au milieu du ruisseau
			local m = math.floor(#pts / 2)
			local fx, fz = (pts[m][1] + pts[m + 1][1]) / 2, (pts[m][2] + pts[m + 1][2]) / 2
			for s = -1, 1 do
				cyl(h, { Name = "FordStone", Color = rgb(150, 146, 140), Material = Enum.Material.Slate }, parent, 2.6, 0.5, Vector3.new(fx + s * 0.4, 0.6, fz + s * 2.4))
				n += 1
			end
		end
	end
	-- murs invisibles de la rivière du Nord : le seul passage est un pont
	local WH = M2.wallHeight
	for _, w in ipairs(G.riverWalls(1)) do
		local len = math.sqrt((w[3] - w[1]) ^ 2 + (w[4] - w[2]) ^ 2)
		h.part({ Name = "RiverWall", Size = Vector3.new(1.5, WH, len + 0.5), CFrame = CFrame.lookAt(Vector3.new((w[1] + w[3]) / 2, WH / 2, (w[2] + w[4]) / 2), Vector3.new(w[3], WH / 2, w[4])), Transparency = 1, CanCollide = true, CanQuery = false, CanTouch = false }, parent)
		n += 1
	end
	-- ponts
	for _, b in ipairs(G.bridges) do
		local ns = b.axis == "NS"
		local dx, dz = ns and 0 or 1, ns and 1 or 0 -- axe du pont
		if b.stone then
			-- pont de pierre du château : rampe de 0 (rive sud) à la hauteur du plateau (rive nord), pile sous le tablier à la rivière
			local H = M2.castle.h
			local ax, az = b.x + dx * b.len / 2, b.z + dz * b.len / 2 -- extrémité sud (rive des joueurs)
			local bx, bz = b.x - dx * b.len / 2, b.z - dz * b.len / 2 -- extrémité nord (plateau)
			local mid = Vector3.new(b.x, H / 2 - 0.4, b.z)
			local len = math.sqrt(b.len * b.len + H * H)
			h.part({ Name = "CastleBridge", Size = Vector3.new(b.w, 1, len + 0.6), CFrame = CFrame.lookAt(mid, Vector3.new(bx, H - 0.4, bz)), Color = rgb(150, 146, 140), Material = Enum.Material.Slate }, parent)
			for _, side in ipairs({ -1, 1 }) do
				local ox, oz = dz * side * (b.w / 2 - 0.4), dx * side * (b.w / 2 - 0.4)
				h.part({ Name = "CastleBridgeRail", Size = Vector3.new(0.8, 1.6, len), CFrame = CFrame.lookAt(mid + Vector3.new(ox, 1.2, oz), Vector3.new(bx + ox, H + 0.8, bz + oz)), Color = rgb(120, 116, 112), Material = Enum.Material.Slate }, parent)
			end
			local rx, rz = b.cross.x, b.cross.z
			local tY = (az - rz) / b.len * H -- hauteur du tablier au-dessus de la rivière
			local pierH = math.max(1, tY - 1.6)
			h.part({ Name = "RiverWall", Size = Vector3.new(b.w + 2, pierH, 1.5), Position = Vector3.new(rx, pierH / 2, rz), Color = rgb(120, 116, 112), Material = Enum.Material.Slate, CanQuery = false }, parent)
			n += 4
		else
			local planks = 5
			local step = b.len / planks
			local py = b.river == 1 and 0.55 or 0.75 -- tablier au-dessus de l'eau du cours d'eau franchi
			for k = 0, planks - 1 do
				local off = (k - (planks - 1) / 2) * step
				h.part({ Name = "BridgePlank", Size = ns and Vector3.new(b.w, 0.45, step + 0.1) or Vector3.new(step + 0.1, 0.45, b.w), Position = Vector3.new(b.x + dx * off, py, b.z + dz * off), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks }, parent)
				n += 1
			end
			for _, side in ipairs({ -1, 1 }) do
				h.part({ Name = "BridgeRail", Size = ns and Vector3.new(0.35, 0.35, b.len) or Vector3.new(b.len, 0.35, 0.35), Position = Vector3.new(b.x + dz * side * (b.w / 2 - 0.2), py + 1.25, b.z + dx * side * (b.w / 2 - 0.2)), Color = rgb(120, 82, 48), Material = Enum.Material.Wood, CanCollide = false }, parent)
				n += 1
			end
		end
	end
	return n
end

-- Lacs (disque d'eau, rive de sable plus basse), pontons, cabane du pêcheur, cascade du château, douve.
function Scenery.lakes(h, parent, cfg, G)
	local n = 0
	local M2 = cfg.Map2
	for _, lk in ipairs(M2.lakes) do
		cyl(h, { Name = "LakeShore", Color = rgb(214, 190, 140), Material = Enum.Material.Sand, CanCollide = false }, parent, (lk.r + lk.shore) * 2, 0.3, Vector3.new(lk.x, 0.01, lk.z))
		cyl(h, { Name = lk.name, Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent, lk.r * 2, 0.3, Vector3.new(lk.x, 0.79, lk.z))
		n += 2
	end
	for _, dk in ipairs(G.docks) do
		flatSeg(h, { Name = "Dock", Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks }, parent, dk.ax, dk.az, dk.bx, dk.bz, dk.w, 0.9, 0.4)
		n += 1
	end
	local cab = M2.cabin
	h.part({ Name = "CabinWalls", Size = Vector3.new(cab.w, 7, cab.d), Position = Vector3.new(cab.x, 3.5, cab.z), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks }, parent)
	h.part({ Name = "CabinRoof", Size = Vector3.new(cab.w + 2, 1, cab.d + 2), Position = Vector3.new(cab.x, 7.5, cab.z), Color = rgb(150, 70, 52), Material = Enum.Material.Wood }, parent)
	h.part({ Name = "CabinDoor", Size = Vector3.new(2.4, 4.4, 0.3), Position = Vector3.new(cab.x, 2.2, cab.z - cab.d / 2 - 0.1), Color = rgb(96, 64, 40), Material = Enum.Material.Wood, CanCollide = false }, parent)
	n += 3
	-- cascade : du bord du plateau du château vers la douve, et bassin d'écume
	local wf = M2.waterfall
	local fall = h.part({ Name = "Waterfall", Size = Vector3.new(8, wf.h, 0.6), Position = Vector3.new(wf.x, wf.h / 2, M2.castle.z1 + 0.4), Color = rgb(170, 215, 245), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, CanQuery = false }, parent)
	emitter(fall, rgb(235, 248, 255), 10, 3, 1.4, 1.2, Vector3.new(0, -6, 0))
	local mo = G.moat
	h.part({ Name = "CastleMoat", Size = Vector3.new(mo.x1 - mo.x0, 0.3, mo.z1 - mo.z0), Position = Vector3.new((mo.x0 + mo.x1) / 2, 0.85, (mo.z0 + mo.z1) / 2), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, CanQuery = false }, parent)
	n += 2
	return n
end

---------------------------------------------------------------- Marqueur d'élément interactif
-- Tout ce avec quoi on peut agir (nids à chiper, secrets) porte un anneau doré pulsant (tag Interactive, animé côté client) et une icône :
-- les décors n'utilisent jamais ce doré, on distingue donc d'un coup d'œil ce qui est cliquable de ce qui est décoratif.
function Scenery.marker(h, position, parent, icon, diameter)
	local ring = cyl(h, { Name = "InteractiveMarker", Color = rgb(255, 214, 64), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, CanQuery = false }, parent, diameter or 7, 0.2, position + Vector3.new(0, 0.3, 0))
	ring:SetAttribute("BaseT", 0.35)
	CollectionService:AddTag(ring, "Interactive")
	local bb = Instance.new("BillboardGui")
	bb.Name = "InteractiveIcon"
	bb.Adornee = ring
	bb.Size = UDim2.fromOffset(40, 40)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = ring
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.TextScaled = true
	t.Text = icon or "✋"
	t.Parent = bb
	return ring
end

---------------------------------------------------------------- Territoires : décor identitaire (REFONTE lot 2 : centré sur le territoire, rayon r)
-- Chaque thème reste dans son disque (rayon r) et évite les nids et les postes des gardiens (5 studs). Retourne le nombre de Parts.
local function clearOf(t, x, z)
	for _, p in ipairs(t.nests or {}) do
		if math.sqrt((x - p[1]) ^ 2 + (z - p[2]) ^ 2) < 7 then
			return false
		end
	end
	for _, p in ipairs(t.posts or {}) do
		if math.sqrt((x - p[1]) ^ 2 + (z - p[2]) ^ 2) < 7 then
			return false
		end
	end
	return true
end

-- Ferme de Gus : grange (Nord-Ouest) ou meules et épouvantail (Sud-Ouest).
function Scenery.gus(h, t, parent, rng, y0)
	local n = 0
	y0 = y0 or 0
	local cx, cz = t.x, t.z
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	if t.key == "gusNW" then
		local bx, bz = cx - 22, cz + 18
		P({ Name = "BarnWalls", Size = Vector3.new(14, 8, 11), Position = Vector3.new(bx, y0 + 4, bz), Color = rgb(168, 52, 46), Material = Enum.Material.WoodPlanks })
		for _, side in ipairs({ -1, 1 }) do
			P({ Name = "BarnRoof", Size = Vector3.new(8, 0.8, 12.5), CFrame = CFrame.new(bx + side * 3.4, y0 + 9.6, bz) * CFrame.Angles(0, 0, -side * 0.62), Color = rgb(96, 70, 52), Material = Enum.Material.Wood })
		end
		P({ Name = "BarnDoor", Size = Vector3.new(4.6, 6, 0.5), Position = Vector3.new(bx + 7.2, y0 + 3, bz), Color = rgb(235, 225, 205), Material = Enum.Material.Wood, CanCollide = false })
	end
	for k = 1, 3 do
		local a = k * 2.1 + (t.key == "gusSW" and 0.7 or 0)
		local x, z = cx + math.cos(a) * 22, cz + math.sin(a) * 22
		if clearOf(t, x, z) then
			n += 1
			cyl(h, { Name = "HayBale", Color = rgb(226, 196, 98), Material = Enum.Material.Fabric }, parent, 3.6, 3.2, Vector3.new(x, y0 + 1.8, z), rng:NextNumber(0, 3))
		end
	end
	if t.key == "gusSW" then
		local sx, sz = cx + 16, cz - 16
		P({ Name = "ScarecrowPole", Size = Vector3.new(0.5, 5, 0.5), Position = Vector3.new(sx, y0 + 2.5, sz), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
		P({ Name = "ScarecrowArms", Size = Vector3.new(4.6, 0.5, 0.5), Position = Vector3.new(sx, y0 + 4, sz), Color = rgb(120, 88, 58), Material = Enum.Material.Wood })
		n += 1
		h.ball({ Name = "ScarecrowHead", Size = Vector3.new(1.6, 1.6, 1.6), Position = Vector3.new(sx, y0 + 5.6, sz), Color = rgb(235, 200, 120) }, parent)
	end
	return n
end

-- Bois ensorcelés de Mara : arbres morts, champignons lumineux, tombes, mare violette.
function Scenery.mara(h, t, parent, rng, y0)
	local n = 0
	y0 = y0 or 0
	local cx, cz = t.x, t.z
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	for k = 1, 4 do
		local a = k / 4 * math.pi * 2 + 0.4
		local x, z = cx + math.cos(a) * (t.r - 8), cz + math.sin(a) * (t.r - 8)
		if clearOf(t, x, z) then
			local s = rng:NextNumber(0.9, 1.3)
			P({ Name = "DeadTrunk", Size = Vector3.new(1.6 * s, 11 * s, 1.6 * s), CFrame = CFrame.new(x, y0 + 5.5 * s, z) * CFrame.Angles(rng:NextNumber(-0.1, 0.1), 0, rng:NextNumber(-0.12, 0.12)), Color = rgb(52, 40, 52), Material = Enum.Material.Slate })
			for b = 1, 2 do
				P({ Name = "DeadBranch", Size = Vector3.new(0.7, 5 * s, 0.7), CFrame = CFrame.new(x, y0 + (6 + b * 1.6) * s, z) * CFrame.Angles(0, b * 2.1, 0.9 + b * 0.1) * CFrame.new(0, 2.2 * s, 0), Color = rgb(52, 40, 52), Material = Enum.Material.Slate, CanCollide = false })
			end
		end
	end
	local colors = { rgb(190, 110, 255), rgb(90, 235, 235), rgb(255, 110, 200) }
	for k = 1, 6 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(8, t.r - 6)
		local x, z = cx + math.cos(a) * r, cz + math.sin(a) * r
		if clearOf(t, x, z) then
			local s = rng:NextNumber(0.8, 1.6)
			local col = colors[(k % #colors) + 1]
			P({ Name = "MushroomStem", Size = Vector3.new(0.7 * s, 1.8 * s, 0.7 * s), Position = Vector3.new(x, y0 + 0.9 * s, z), Color = rgb(230, 225, 235), CanCollide = false })
			n += 1
			local cap = h.ball({ Name = "MushroomCap", Size = Vector3.new(2.6 * s, 1.6 * s, 2.6 * s), Position = Vector3.new(x, y0 + 2 * s, z), Color = col, Material = Enum.Material.Neon }, parent)
			if k % 3 == 0 then
				light(cap, col, 14, 0.9)
			end
		end
	end
	for k = 1, 4 do
		local x, z = cx - 12 + k * 5, cz - t.r + 10
		if clearOf(t, x, z) then
			P({ Name = "Tombstone", Size = Vector3.new(2.4, 3.4, 0.7), CFrame = CFrame.new(x, y0 + 1.7, z) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.08, 0.08)), Color = rgb(120, 118, 130), Material = Enum.Material.Slate })
		end
	end
	n += 1
	local pond = cyl(h, { Name = "WitchPond", Color = rgb(150, 70, 230), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false }, parent, 10, 0.3, Vector3.new(cx, y0 + 0.4, cz - 4))
	emitter(pond, rgb(220, 255, 140), 6, 2, 3, 0.35, Vector3.new(0, 0.6, 0))
	light(pond, rgb(170, 90, 255), 28, 1.2)
	return n
end

-- Cour de Zed : aiguilles d'obsidienne et lacs de lave (sur le plateau, hauteur y0).
function Scenery.zed(h, t, parent, rng, y0)
	local n = 0
	y0 = y0 or 0
	local cx, cz = t.x, t.z
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2 + 0.3
		local x, z = cx + math.cos(a) * (t.r - 7), cz + math.sin(a) * (t.r - 7)
		if clearOf(t, x, z) then
			local hgt = rng:NextNumber(8, 16)
			h.part({ Name = "ObsidianSpire", Size = Vector3.new(3.5, hgt, 3.5), CFrame = CFrame.new(x, y0 + hgt / 2, z) * CFrame.Angles(rng:NextNumber(-0.1, 0.1), rng:NextNumber(0, 3), rng:NextNumber(-0.1, 0.1)), Color = rgb(36, 32, 44), Material = Enum.Material.Slate }, parent)
			n += 1
		end
	end
	for k = 1, 3 do
		local a = k * 2.2
		local x, z = cx + math.cos(a) * 12, cz + math.sin(a) * 12
		if clearOf(t, x, z) then
			n += 1
			local lava = cyl(h, { Name = "LavaPool", Color = rgb(255, 110, 30), Material = Enum.Material.Neon, CanCollide = false }, parent, 7, 0.3, Vector3.new(x, y0 + 0.22, z))
			light(lava, rgb(255, 120, 40), 22, 1.4)
			if k == 2 then
				emitter(lava, rgb(255, 160, 60), 10, 8, 2, 0.5, Vector3.new(0, 4, 0))
			end
		end
	end
	return n
end

---------------------------------------------------------------- Chemins : routes pavées et chemins de terre (une dalle par segment, un disque à chaque coude)
-- Hauteurs distinctes par segment (aucune face coplanaire, même aux croisements) ; la partie dans la place (déjà pavée) n'est pas dessinée.
function Scenery.paths(h, parent, cfg, G)
	local n = 0
	local M2 = cfg.Map2
	local px, pz, pr = M2.plaza.x, M2.plaza.z, M2.plaza.r - 2
	for _, p in ipairs(M2.paths) do
		local paved = p.kind ~= "dirt"
		local half = paved and M2.pathHalf or M2.dirtHalf
		local base = p.y or 0
		local col = paved and rgb(196, 180, 150) or rgb(150, 118, 80)
		local mat = paved and Enum.Material.Cobblestone or Enum.Material.Ground
		for k = 1, #p.pts - 1 do
			local ax, az, bx, bz = p.pts[k][1], p.pts[k][2], p.pts[k + 1][1], p.pts[k + 1][2]
			local inA = (ax - px) ^ 2 + (az - pz) ^ 2 < pr * pr
			local inB = (bx - px) ^ 2 + (bz - pz) ^ 2 < pr * pr
			if base == 0 and inA and not inB then -- départ dans la place : on commence au bord de la place
				local dx, dz = bx - ax, bz - az
				local qa, qb, qc = dx * dx + dz * dz, 2 * ((ax - px) * dx + (az - pz) * dz), (ax - px) ^ 2 + (az - pz) ^ 2 - pr * pr
				local t = (-qb + math.sqrt(qb * qb - 4 * qa * qc)) / (2 * qa)
				ax, az = ax + dx * t, az + dz * t
			end
			if not (base == 0 and inA and inB) then
				local top = base + (paved and ((k % 2 == 1) and 0.28 or 0.34) or ((k % 2 == 1) and 0.04 or 0.10))
				flatSeg(h, { Name = paved and "PathStone" or "DirtPath", Color = col, Material = mat, CanCollide = false }, parent, ax, az, bx, bz, half * 2, top - 0.1, 0.2)
				n += 1
				if k > 1 then
					cyl(h, { Name = paved and "PathJoint" or "DirtPath", Color = col, Material = mat, CanCollide = false }, parent, half * 2, 0.2, Vector3.new(ax, base + (paved and 0.40 or 0.16) - 0.1, az))
					n += 1
				end
			end
		end
	end
	return n
end

---------------------------------------------------------------- Place du marché : dallage, halle à dôme, fontaine, étals
function Scenery.plaza(h, parent, cfg)
	local n = 0
	local M2 = cfg.Map2
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	local pl = M2.plaza
	cyl(h, { Name = "PlazaRim", Color = rgb(150, 136, 110), Material = Enum.Material.Cobblestone, CanCollide = false }, parent, pl.r * 2 + 3, 0.2, Vector3.new(pl.x, 0.36, pl.z))
	cyl(h, { Name = "Plaza", Color = rgb(206, 192, 162), Material = Enum.Material.Cobblestone, CanCollide = false }, parent, pl.r * 2, 0.2, Vector3.new(pl.x, 0.42, pl.z))
	n += 2
	-- halle à dôme : 8 piliers, dôme en gradins (haut `hall.h`), comptoir de la boutique d'œufs
	local hl = M2.hall
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		P({ Name = "HallPillar", Size = Vector3.new(1.6, 15, 1.6), Position = Vector3.new(hl.x + math.cos(a) * (hl.r - 2), 7.5, hl.z + math.sin(a) * (hl.r - 2)), Color = rgb(226, 214, 190), Material = Enum.Material.Marble })
	end
	for k, tier in ipairs({ { hl.r * 2 + 2, 15.5 }, { hl.r * 1.5, 19.5 }, { hl.r, 23.5 } }) do
		n += 1
		cyl(h, { Name = "HallDome", Color = k == 1 and rgb(176, 96, 70) or rgb(196, 110, 80), Material = Enum.Material.Slate }, parent, tier[1], 4, Vector3.new(hl.x, tier[2] + 2, hl.z))
	end
	n += 1
	local top = h.ball({ Name = "HallDomeTop", Size = Vector3.new(hl.r * 0.7, hl.r * 0.7, hl.r * 0.7), Position = Vector3.new(hl.x, hl.h - hl.r * 0.35, hl.z), Color = rgb(255, 214, 120), Material = Enum.Material.Metal }, parent)
	light(top, rgb(255, 224, 160), 30, 0.8)
	local counter = P({ Name = "EggCounter", Size = Vector3.new(10, 3.4, 2.4), Position = Vector3.new(hl.x - 4, 1.7, hl.z), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks })
	h.sign(counter, "🥚 Boutique d'œufs", rgb(255, 220, 140), 4, 220)
	-- bassin-fontaine
	local f = M2.fountain
	cyl(h, { Name = "FountainRim", Color = rgb(190, 184, 176), Material = Enum.Material.Marble }, parent, f.r * 2, 1.4, Vector3.new(f.x, 0.7, f.z))
	cyl(h, { Name = "Fountain", Color = WATER, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, CanQuery = false }, parent, f.r * 2 - 1.4, 0.3, Vector3.new(f.x, 1.15, f.z))
	cyl(h, { Name = "FountainColumn", Color = rgb(206, 200, 190), Material = Enum.Material.Marble }, parent, 1.6, 5, Vector3.new(f.x, 2.5, f.z))
	n += 3
	local spout = h.ball({ Name = "FountainSpout", Size = Vector3.new(2.4, 2.4, 2.4), Position = Vector3.new(f.x, 5.4, f.z), Color = rgb(170, 215, 245), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false }, parent)
	n += 1
	emitter(spout, rgb(200, 235, 255), 18, 6, 1.2, 0.5, Vector3.new(0, -14, 0))
	-- étals : Améliorations, Pets / vente, Boutique Robux
	local labels = { "⬆️ Améliorations", "🐾 Pets / vente", "💎 Boutique" }
	local awn = { rgb(230, 80, 80), rgb(90, 170, 240), rgb(255, 190, 60) }
	for k, st in ipairs(M2.stalls) do
		P({ Name = "StallCounter", Size = Vector3.new(10, 3, 3), Position = Vector3.new(st.x, 1.5, st.z - 2.5), Color = rgb(150, 104, 62), Material = Enum.Material.WoodPlanks })
		for _, sx in ipairs({ -4.6, 4.6 }) do
			P({ Name = "StallPost", Size = Vector3.new(0.5, 7, 0.5), Position = Vector3.new(st.x + sx, 3.5, st.z + 2.5), Color = rgb(110, 76, 46), Material = Enum.Material.Wood })
		end
		local roof = P({ Name = "StallAwning", Size = Vector3.new(11, 0.4, 8.6), CFrame = CFrame.new(st.x, 7.2, st.z) * CFrame.Angles(0.18, 0, 0), Color = awn[k] or awn[1], Material = Enum.Material.Fabric, CanCollide = false })
		h.sign(roof, labels[k] or "", rgb(255, 240, 200), 2.5, 200)
	end
	return n
end

---------------------------------------------------------------- Château : plateau (h), palier du pont, cour fermée par des murs (herse), donjon
-- Retourne (nombre de Parts, position de la porte du donjon).
function Scenery.castlePlateau(h, parent, cfg, G)
	local n = 0
	local M2 = cfg.Map2
	local C = M2.castle
	local H = C.h
	local function P(props)
		n += 1
		return h.part(props, parent)
	end
	local w, d = C.x1 - C.x0, C.z1 - C.z0
	P({ Name = "CastleCliff", Size = Vector3.new(w, H + 1.5, d), Position = Vector3.new((C.x0 + C.x1) / 2, (H - 0.5 - 2) / 2, (C.z0 + C.z1) / 2), Color = rgb(128, 122, 118), Material = Enum.Material.Slate })
	P({ Name = "CastlePlateau", Size = Vector3.new(w - 1, 0.5, d - 1), Position = Vector3.new((C.x0 + C.x1) / 2, H - 0.25, (C.z0 + C.z1) / 2), Color = rgb(108, 150, 84), Material = Enum.Material.Grass })
	local L = G.landing
	P({ Name = "CastleLanding", Size = Vector3.new(L.x1 - L.x0 + 0.5, H, L.z1 - L.z0), Position = Vector3.new((L.x0 + L.x1) / 2 + 0.25, H / 2, (L.z0 + L.z1) / 2), Color = rgb(150, 146, 140), Material = Enum.Material.Slate })
	-- cour de Zed : disque pavé et mur circulaire (rayon r + 2), rabattu le long du bord sud du plateau ; herse à l'entrée (Map2/TERR : traps.gate)
	local zt = G.terr("zed")
	cyl(h, { Name = "CourtFloor", Color = rgb(96, 88, 92), Material = Enum.Material.Cobblestone, CanCollide = false }, parent, zt.r * 2, 0.2, Vector3.new(zt.x, H + 0.08, zt.z))
	n += 1
	local R = zt.r + 2
	local segs = 18
	local pts = {}
	for k = 0, segs - 1 do
		local a = k / segs * math.pi * 2
		pts[k + 1] = { zt.x + math.cos(a) * R, math.min(zt.z + math.sin(a) * R, C.z1 - 4) }
	end
	local gate = zt.entry
	local gateK, gd = 1, math.huge
	for k = 1, segs do
		local a, b = pts[k], pts[k % segs + 1]
		local mx, mz = (a[1] + b[1]) / 2, (a[2] + b[2]) / 2
		local dd = math.sqrt((mx - gate.x) ^ 2 + (mz - gate.z) ^ 2)
		if dd < gd then
			gateK, gd = k, dd
		end
	end
	for k = 1, segs do
		local a, b = pts[k], pts[k % segs + 1]
		local len = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
		if len > 0.5 then
			local mid = Vector3.new((a[1] + b[1]) / 2, H + 4, (a[2] + b[2]) / 2)
			if k == gateK then
				-- herse levée au-dessus du passage (le cycle ouvert/fermé est un piège du lot 4) et piliers
				P({ Name = "CourtGate", Size = Vector3.new(1, 3, len), CFrame = CFrame.lookAt(mid + Vector3.new(0, 5.5, 0), Vector3.new(b[1], H + 9.5, b[2])), Color = rgb(70, 70, 78), Material = Enum.Material.Metal, CanCollide = false })
			else
				P({ Name = "CourtWall", Size = Vector3.new(2, 8, len + 1.2), CFrame = CFrame.lookAt(mid, Vector3.new(b[1], H + 4, b[2])), Color = rgb(96, 92, 106), Material = Enum.Material.Slate })
			end
		end
	end
	-- donjon : bloc, quatre tours d'angle, toit ; la porte (Map2.castle.door) est l'entrée du mode Château
	local K = G.keep
	P({ Name = "Keep", Size = Vector3.new(K.half * 2, 22, K.half * 2), Position = Vector3.new(K.x, H + 11, K.z), Color = rgb(112, 108, 120), Material = Enum.Material.Slate })
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		n += 1
		cyl(h, { Name = "KeepTower", Color = rgb(104, 100, 114), Material = Enum.Material.Slate }, parent, 6, 28, Vector3.new(K.x + c[1] * K.half, H + 14, K.z + c[2] * K.half))
	end
	P({ Name = "KeepRoof", Size = Vector3.new(K.half * 2 - 2, 2, K.half * 2 - 2), Position = Vector3.new(K.x, H + 23, K.z), Color = rgb(150, 60, 52), Material = Enum.Material.Slate })
	local flag = P({ Name = "KeepFlag", Size = Vector3.new(0.3, 4, 6), Position = Vector3.new(K.x, H + 28, K.z), Color = rgb(224, 87, 90), Material = Enum.Material.Fabric, CanCollide = false })
	light(flag, rgb(255, 140, 100), 40, 0.8)
	return n, Vector3.new(C.door.x, H, C.door.z)
end

---------------------------------------------------------------- Arène (colisée procédural simple) : sable, gradins, mur extérieur ouvert vers l'entrée
function Scenery.arena(h, parent, cfg)
	local n = 0
	local A = cfg.Map2.arena
	cyl(h, { Name = "ArenaSand", Color = rgb(214, 190, 140), Material = Enum.Material.Sand, CanCollide = false }, parent, A.sand * 2, 0.3, Vector3.new(A.x, 0.12, A.z))
	n += 1
	local ex, ez = A.entry.x - A.x, A.entry.z - A.z
	local el = math.sqrt(ex * ex + ez * ez)
	local function ring(radius, segs, height, thick, name, col)
		for k = 0, segs - 1 do
			local a0, a1 = k / segs * math.pi * 2, (k + 1) / segs * math.pi * 2
			local am = (a0 + a1) / 2
			local mx, mz = math.cos(am), math.sin(am)
			if (mx * ex + mz * ez) / el < math.cos(math.pi / segs * 1.2) then -- pas de segment devant l'entrée
				local ax, az = A.x + math.cos(a0) * radius, A.z + math.sin(a0) * radius
				local bx, bz = A.x + math.cos(a1) * radius, A.z + math.sin(a1) * radius
				local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
				h.part({ Name = name, Size = Vector3.new(thick, height, len + 0.8), CFrame = CFrame.lookAt(Vector3.new((ax + bx) / 2, height / 2, (az + bz) / 2), Vector3.new(bx, height / 2, bz)), Color = col, Material = Enum.Material.Slate }, parent)
				n += 1
			end
		end
	end
	ring(A.sand + 3, 12, 2.4, 5, "ArenaSteps", rgb(196, 184, 164))
	ring(A.r - 2, 16, 9, 3, "ArenaWall", rgb(176, 160, 134))
	local post = h.part({ Name = "ArenaSign", Size = Vector3.new(1, 8, 1), Position = Vector3.new(A.entry.x + 6, 4, A.entry.z - 6), Color = rgb(90, 60, 40), Material = Enum.Material.Wood }, parent)
	n += 1
	h.sign(post, "⚔️ ARÈNE DES PETS\nDéfie la tour des Dresseurs", rgb(255, 220, 140), 6, 280)
	return n
end

---------------------------------------------------------------- Relief : sol, bornes, collines (calottes sphériques), montagnes de fond, forêts procédurales
-- `forest` = Placement.forest() : { {x, z, y} } (2 Parts par arbre : tronc et feuillage). Retourne le nombre de Parts.
function Scenery.relief(h, parent, cfg, forest)
	local n = 0
	local M2 = cfg.Map2
	local B = M2.bounds
	local WH = M2.wallHeight
	for _, w in ipairs({ { 0, B.z0 - 1, B.x1 - B.x0 + 4, 2 }, { 0, B.z1 + 1, B.x1 - B.x0 + 4, 2 }, { B.x0 - 1, 0, 2, B.z1 - B.z0 + 4 }, { B.x1 + 1, 0, 2, B.z1 - B.z0 + 4 } }) do
		h.part({ Name = "BoundWall", Size = Vector3.new(w[3], WH * 2.5, w[4]), Position = Vector3.new(w[1], WH * 1.25, w[2]), Transparency = 1, CanQuery = false, CanTouch = false }, parent)
		n += 1
	end
	for _, hl in ipairs(M2.hills) do -- collines praticables : calotte sphérique (pente < 50° au pied)
		local R = (hl.r * hl.r + hl.h * hl.h) / (2 * hl.h)
		n += 1
		local b = h.ball({ Name = "Hill", Size = Vector3.new(R * 2, R * 2, R * 2), Position = Vector3.new(hl.x, hl.h - R, hl.z), Color = rgb(96, 158, 84), Material = Enum.Material.Grass }, parent)
		b.CanCollide = true
		b.CastShadow = false
	end
	-- montagnes au nord, collines ailleurs : décor de fond hors des bornes, sans collision ni ombre
	local bw, bd = M2.backdrop.w / 2, M2.backdrop.d / 2
	for k, m in ipairs({ { -260, -bd + 10, 150, 70 }, { -60, -bd + 5, 170, 85 }, { 150, -bd + 8, 150, 75 }, { 330, -bd + 20, 130, 60 }, { -bw + 10, 60, 120, 40 }, { bw - 10, 90, 120, 40 }, { 0, bd - 5, 180, 35 } }) do
		n += 1
		local b = h.ball({ Name = "Backdrop", Size = Vector3.new(m[3], m[3], m[3]), Position = Vector3.new(m[1], m[4] - m[3] / 2, m[2]), Color = k <= 4 and rgb(116, 128, 120) or rgb(90, 150, 82), Material = k <= 4 and Enum.Material.Slate or Enum.Material.Grass, CanCollide = false }, parent)
		b.CastShadow = false
	end
	for _, t in ipairs(forest or {}) do -- arbres procéduraux : tronc et feuillage (2 Parts)
		local s = 0.9 + ((math.floor(t.x * 7 + t.z * 3) % 5) * 0.08)
		local y = t.y or 0
		h.part({ Name = "Trunk", Size = Vector3.new(1.8 * s, 8 * s, 1.8 * s), Position = Vector3.new(t.x, y + 4 * s, t.z), Color = rgb(110, 78, 50), Material = Enum.Material.Wood }, parent)
		h.ball({ Name = "Leaves", Size = Vector3.new(10 * s, 10 * s, 10 * s), Position = Vector3.new(t.x, y + 10.5 * s, t.z), Color = (t.z < -180 or t.grove) and rgb(54, 120, 70) or rgb(70, 146, 72), Material = Enum.Material.Grass }, parent)
		n += 2
	end
	return n
end

---------------------------------------------------------------- Secrets : un sanctuaire par domaine, fouillable une fois par jour
function Scenery.secrets(h, parent, cfg)
	local n = 0
	for _, sct in ipairs(cfg.SECRETS) do
		local base = Vector3.new(sct.x, 0, sct.z)
		n += 3
		cyl(h, { Name = "ShrineBase", Color = rgb(150, 146, 140), Material = Enum.Material.Marble }, parent, 12, 1.2, base + Vector3.new(0, 0.6, 0))
		h.part({ Name = "ShrinePillar", Size = Vector3.new(2.4, 7, 2.4), Position = base + Vector3.new(0, 4.7, 0), Color = rgb(190, 184, 176), Material = Enum.Material.Marble }, parent)
		local gem = h.ball({ Name = "Secret_" .. sct.id, Size = Vector3.new(3, 3, 3), Position = base + Vector3.new(0, 9.4, 0), Color = rgb(255, 214, 90), Material = Enum.Material.Neon }, parent)
		light(gem, rgb(255, 214, 120), 34, 1.4)
		emitter(gem, rgb(255, 230, 140), 5, 2, 2, 0.4, Vector3.new(0, 1, 0))
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Fouiller"
		pr.ObjectText = sct.emoji .. " " .. sct.name
		pr.HoldDuration = 1
		pr.MaxActivationDistance = 12
		pr.RequiresLineOfSight = false
		pr:SetAttribute("SecretId", sct.id)
		CollectionService:AddTag(pr, "SecretPrompt")
		pr.Parent = gem
		Scenery.marker(h, base + Vector3.new(0, 0.4, 0), parent, "🔍", 14)
		n += 1
	end
	return n
end

return Scenery
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Telemetry</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Telemetry
-- LOT 9 : 12 métriques de rythme envoyées à AnalyticsService (Creator Hub > Analytics), SANS donnée personnelle (aucun nom, aucun identifiant
-- en champ : AnalyticsService rattache lui-même l'événement au joueur). Tout appel est sous pcall ; service indisponible (Studio, panne) = rien.
-- Débit : au plus 1 événement par seconde et par joueur (file de 16 par joueur, la plus ancienne jetée au-delà), vidée par Telemetry.step.
-- Pur et testable : le service et l'horloge sont injectés (Telemetry.new(service, clock)).
local Telemetry = {}

-- Les 12 métriques du lot 9 + 4 du lot 9b (calendrier) (nom de l'événement -> description). `tier_first_reached`, `hatch_tier` et `house_level_reached` portent la rareté / le niveau
-- dans le nom (« _r5 », « _l3 ») pour être lisibles directement dans le tableau des événements personnalisés.
Telemetry.METRICS = {
	first_hatch_seconds = "temps de jeu cumulé (s) à la première éclosion",
	tier_first_reached = "première fois qu'une rareté de pet est obtenue (_rN), valeur = temps de jeu cumulé (s)",
	house_level_reached = "niveau de maison atteint (_lN), valeur = temps de jeu cumulé (s)",
	session_length = "durée de la session (s), envoyée au départ",
	retention_day1 = "retour le lendemain de la première connexion (jours UTC firstSeen / lastSeen)",
	retention_day7 = "retour 7 jours après la première connexion",
	daily_quest_completed = "mission du jour terminée (récompense réclamée)",
	purchase_tier = "achat Robux, par palier de prix (_p1 < 50 R$, _p2 < 200, _p3 < 500, _p4 < 1500, _p5 au-delà)",
	coins_spent_egg = "pièces dépensées en œufs (événement économique, puits)",
	hatch_tier = "éclosion par rareté (_rN)",
	puzzle_solved = "énigme du jour réussie",
	tower_floor_reached = "nouvel étage record de la tour, valeur = étage",
	-- Lot 9b : calendrier de 30 jours
	calendar_claim_day = "jour du calendrier réclamé (valeur = jour 1 à 30), suffixe _today pour le jour en cours",
	calendar_catchup = "jour manqué rattrapé (valeur = jour), suffixe _grace / _quest / _paid",
	calendar_cycle_complete = "30 jours réclamés dans un cycle (valeur = numéro du cycle)",
	calendar_streak = "série de jours consécutifs réclamés après une réclamation (valeur = série)",
}
Telemetry.QUEUE_MAX = 16
Telemetry.GAP = 1

function Telemetry.priceTier(robux)
	local r = type(robux) == "number" and robux == robux and robux or 0
	if r < 50 then
		return 1
	elseif r < 200 then
		return 2
	elseif r < 500 then
		return 3
	elseif r < 1500 then
		return 4
	end
	return 5
end

-- Retour du joueur : 1 (lendemain) ou 7 (une semaine) jours UTC après la première connexion, sinon nil. Valeurs incertaines : gardées par type.
function Telemetry.retentionDay(firstSeen, today)
	if type(firstSeen) ~= "number" or type(today) ~= "number" or firstSeen ~= firstSeen or today ~= today or firstSeen <= 0 then
		return nil
	end
	local d = math.floor(today) - math.floor(firstSeen)
	if d == 1 or d == 7 then
		return d
	end
	return nil
end

function Telemetry.new(service, clock)
	local T = { queues = {}, last = {}, sent = 0, dropped = 0, failed = 0, priceTier = Telemetry.priceTier, retentionDay = Telemetry.retentionDay }
	clock = clock or os.clock
	local function send(player, e)
		if not service then
			return
		end
		local ok = pcall(function()
			if e.kind == "economy" then
				service:LogEconomyEvent(player, e.flow, "Coins", e.value, e.balance or 0, e.tx or "Shop", e.sku)
			else
				service:LogCustomEvent(player, e.name, e.value)
			end
		end)
		if ok then
			T.sent = T.sent + 1
		else
			T.failed = T.failed + 1
		end
	end
	-- Met un événement en file (nom parmi Telemetry.METRICS, suffixe facultatif « _r5 »...). Nom inconnu : ignoré (évite les fautes de frappe).
	function T.log(player, name, value, suffix)
		if player == nil or Telemetry.METRICS[name] == nil then
			return false
		end
		local q = T.queues[player]
		if not q then
			q = {}
			T.queues[player] = q
		end
		if #q >= Telemetry.QUEUE_MAX then
			table.remove(q, 1)
			T.dropped = T.dropped + 1
		end
		local v = type(value) == "number" and value == value and value or nil
		q[#q + 1] = { name = name .. (suffix or ""), value = v }
		return true
	end
	function T.economy(player, amount, balance, sku)
		if player == nil or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
			return false
		end
		local q = T.queues[player] or {}
		T.queues[player] = q
		if #q >= Telemetry.QUEUE_MAX then
			table.remove(q, 1)
			T.dropped = T.dropped + 1
		end
		q[#q + 1] = { kind = "economy", name = "coins_spent_egg", flow = "Sink", value = math.floor(amount), balance = type(balance) == "number" and math.floor(balance) or 0, sku = sku }
		return true
	end
	-- Envoie au plus un événement par joueur et par seconde.
	function T.step()
		local now = clock()
		for player, q in pairs(T.queues) do
			if #q > 0 and now - (T.last[player] or -1e9) >= Telemetry.GAP then
				T.last[player] = now
				send(player, table.remove(q, 1))
			end
		end
	end
	-- Joueur parti : seul le DERNIER événement en file (la durée de session, mise en file juste avant) est envoyé, le reste est compté perdu
	-- (le débit de 1 événement / s est respecté), puis la file est oubliée.
	function T.flush(player)
		local q = T.queues[player]
		T.queues[player] = nil
		T.last[player] = nil
		if q and #q > 0 then
			T.dropped = T.dropped + #q - 1
			send(player, q[#q])
		end
	end
	return T
end

return Telemetry
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX56"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX55"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX40"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Client
-- Interface 100 % générée par code (aucune image à importer).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Layout"))
local Reveal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Reveal"))
local Easing = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Easing"))
local RevealFx = require(script.Parent:WaitForChild("RevealFx"))
local SlotFx = require(script.Parent:WaitForChild("SlotFx"))
local VfxKitMod = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VfxKit"))
local Vfx = VfxKitMod.new(Config, Easing)
local CoinIcon = require(script.Parent:WaitForChild("CoinIcon"))
local Riddle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Riddle")) -- énigme de la Mère Poule (règles pures, lot 6)
local HenUi = require(script.Parent:WaitForChild("HenUi")) -- dialogue, ❗, plumes, berceuse, cible du faisceau
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RState, RNotify, RHatch, RAction = Remotes:WaitForChild("State"), Remotes:WaitForChild("Notify"), Remotes:WaitForChild("Hatch"), Remotes:WaitForChild("Action")
local RTop = Remotes:WaitForChild("Top")
local RHen = Remotes:WaitForChild("Hen")
local RRaven = Remotes:WaitForChild("Raven") -- Corbeau chipeur (lot 7) : alerte de la victime, liste des cibles
local fmt = Config.fmt

local COL = {
	bg = Color3.fromRGB(15, 42, 27),
	panel = Color3.fromRGB(29, 77, 51),
	pill = Color3.fromRGB(10, 30, 20),
	yellow = Color3.fromRGB(255, 210, 63),
	text = Color3.fromRGB(244, 255, 246),
	muted = Color3.fromRGB(159, 199, 173),
	red = Color3.fromRGB(255, 107, 107),
	green = Color3.fromRGB(91, 227, 125),
	dis = Color3.fromRGB(75, 91, 81),
	dark = Color3.fromRGB(43, 34, 0),
}
local FONT = Enum.Font.GothamBold

local state = nil
local henUi = nil -- interface de l'énigme (créée après le HUD)
local tryOfferLater, lastMilestone = nil, nil -- offre d'achat (définie avec le HUD) ; dernier palier d'éclosions vu
local topData = nil
local panel = nil -- { name, tab, confirm }
local costBtns = {}

---------------------------------------------------------------- Helpers UI
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o)
end
-- Retour tactile : le bouton se rétrécit légèrement quand on appuie.
-- Sons : voir Config.SOUNDS (clé -> { id, speed, vol }). Un id vide ou introuvable reste silencieux.
-- Un seul objet Sound par type (réutilisé), volume = définition x réglage général (menu Plus), rien (hors clics) avant que la carte soit prête,
-- aucune erreur si un son ne se charge pas (tout sous pcall).
local soundPool = {}
local soundReady = false -- vrai à la première réception de l'état du joueur (carte et joueur prêts)
local volumeIdx = 1
local function masterVolume()
	return Config.VOLUME_STEPS[volumeIdx] or 1
end
local function getSound(key)
	local snd = soundPool[key]
	if snd and snd.Parent then
		return snd
	end
	local def = Config.SOUNDS[key]
	if not def or def.id == "" then
		return nil
	end
	local ok, made = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "Sfx_" .. key
		s.SoundId = def.id
		s.PlaybackSpeed = def.speed or 1
		s.Looped = def.loop == true
		s.Parent = game:GetService("SoundService")
		return s
	end)
	if ok then
		soundPool[key] = made
		return made
	end
	return nil
end
local function playSound(key)
	if not soundReady and key ~= "click" and key ~= "menu" then
		return
	end
	local vol = Config.soundVolume(key, masterVolume())
	if vol <= 0 then
		return
	end
	pcall(function()
		local snd = getSound(key)
		if snd then
			snd.Volume = vol
			snd.TimePosition = 0
			snd:Play()
		end
	end)
end
-- Boucle (ambiance, lame, boulet) : factor 0..1 = proximité ; en dessous de 1 % elle s'arrête.
local function setLoop(key, factor)
	pcall(function()
		local vol = Config.soundVolume(key, masterVolume()) * (factor or 1)
		local snd = vol > 0.005 and getSound(key) or soundPool[key]
		if not snd then
			return
		end
		if vol > 0.005 then
			snd.Volume = vol
			if not snd.IsPlaying then
				snd:Play()
			end
		elseif snd.IsPlaying then
			snd:Stop()
		end
	end)
end

local lastPress = 0 -- horodatage du dernier appui : sert à ne pas reconstruire un panneau sous le doigt du joueur
local function pressFx(btn)
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	local function to(v)
		TweenService:Create(sc, TweenInfo.new(0.08), { Scale = v }):Play()
	end
	btn.MouseButton1Down:Connect(function()
		lastPress = os.clock()
		playSound("click")
		to(0.93)
	end)
	btn.MouseButton1Up:Connect(function()
		to(1)
	end)
	btn.MouseLeave:Connect(function()
		to(1)
	end)
end

local function text(parent, props)
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or COL.text
	return make("TextLabel", props, parent)
end

-- Style « cartoon glossy » : contour foncé épais, dégradé, coins très arrondis, reflet. kind = fonction (Config.UI.kinds) : colore le bouton.
-- Sans kind, la couleur existante est gardée (boutons de coût, recolorés selon les pièces). Retourne le style ou nil.
local function glossy(obj, kind, radius, thickness)
	if not Config.UI.glossy then
		return nil
	end
	local st = kind and Config.btnStyle(kind) or nil
	if st then
		obj.BackgroundColor3 = st.base
		obj.BackgroundTransparency = 0
	end
	local cr = obj:FindFirstChildOfClass("UICorner") or make("UICorner", {}, obj)
	cr.CornerRadius = UDim.new(0, radius or 14)
	local stroke = obj:FindFirstChildOfClass("UIStroke") or make("UIStroke", {}, obj)
	stroke.Color = st and st.stroke or Color3.fromRGB(14, 24, 18)
	stroke.Thickness = thickness or 3
	make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(176, 176, 176)), Rotation = 90 }, obj)
	local shine = make("Frame", { Name = "Shine", Size = UDim2.new(1, -12, 0.26, 0), Position = UDim2.fromOffset(6, 3), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0, Active = false }, obj)
	make("UICorner", { CornerRadius = UDim.new(0, math.max(6, (radius or 14) - 4)) }, shine)
	return st
end

local gui = make("ScreenGui", { Name = "ChipeUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets }, player:WaitForChild("PlayerGui"))

-- HUD fixe : conteneur mis à l'échelle (téléphone, tablette, PC) dont tous les éléments sont ancrés aux bords (voir Layout.lua, testé).
-- Les menus (panneau, éclosion) restent hors du conteneur : ils sont temporaires et s'adaptent à l'écran en fractions.
local hudRoot = make("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromOffset(900, 520) }, gui)
local hudScale = make("UIScale", { Scale = 1 }, hudRoot)
local hudParts = {} -- nom de Layout -> objet à placer

local function pill(y, icon, tint)
	local f = make("Frame", { Size = UDim2.fromOffset(196, 52), BackgroundColor3 = COL.pill, BackgroundTransparency = 0.05 }, hudRoot)
	corner(f, 26)
	make("UIStroke", { Color = tint, Thickness = 2, Transparency = 0.15 }, f)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(34, 88, 58), Color3.fromRGB(10, 30, 20)), Rotation = 90 }, f)
	local scale = make("UIScale", { Scale = 1 }, f)
	text(f, { Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(38, 52), Text = icon, TextSize = 28 })
	local big = text(f, { Position = UDim2.fromOffset(50, 4), Size = UDim2.new(1, -56, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 24, Text = "0", TextStrokeTransparency = 0.6 })
	local small = text(f, { Position = UDim2.fromOffset(50, 31), Size = UDim2.new(1, -56, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, TextColor3 = COL.muted, Text = "" })
	return big, small, scale, f
end
local coinsBig, coinsSmall, coinsScale, coinsFrame = pill(8, "🪙", COL.yellow)
local speedBig, speedSmall, _, speedFrame = pill(66, "⚡", Color3.fromRGB(110, 190, 255))
hudParts.pillCoins, hudParts.pillSpeed = coinsFrame, speedFrame
speedSmall.Text = "VITESSE"

local carryLbl = text(hudRoot, { Size = UDim2.fromOffset(170, 26), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 16, Text = "", BackgroundTransparency = 0.2, BackgroundColor3 = COL.pill })
corner(carryLbl, 13)
carryLbl.Visible = false

local banner = text(hudRoot, { Size = UDim2.fromOffset(330, 40), TextWrapped = true, TextSize = 14, TextColor3 = COL.yellow, BackgroundTransparency = 0.12, BackgroundColor3 = COL.pill, Text = "", Visible = false })
corner(banner, 15)
make("UIStroke", { Color = COL.yellow, Thickness = 2 }, banner)

-- Barre de vie (visible seulement quand les pv sont entamés) : rouge dégradé, contour épais, texte « ❤ 86/100 ». Attributs Hp / MaxHp du joueur (serveur).
local hpFrame = make("Frame", { Size = UDim2.fromOffset(170, 22), BackgroundColor3 = Color3.fromRGB(40, 12, 14), Visible = false }, hudRoot)
corner(hpFrame, 11)
make("UIStroke", { Color = Color3.fromRGB(20, 8, 10), Thickness = 3 }, hpFrame)
local hpFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 82, 82) }, hpFrame)
corner(hpFill, 11)
make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)), Rotation = 90 }, hpFill)
local hpText = text(hpFrame, { Size = UDim2.fromScale(1, 1), TextSize = 12, Text = "", TextStrokeTransparency = 0.3, ZIndex = 3 })
hudParts.hp = hpFrame
local function refreshHp()
	local hp, maxHp = player:GetAttribute("Hp"), player:GetAttribute("MaxHp")
	if type(hp) ~= "number" or type(maxHp) ~= "number" or maxHp <= 0 then
		hpFrame.Visible = false
		return
	end
	hpFrame.Visible = hp < maxHp
	hpText.Text = "❤ " .. hp .. "/" .. maxHp
	TweenService:Create(hpFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1) }):Play()
end
player:GetAttributeChangedSignal("Hp"):Connect(refreshHp)
player:GetAttributeChangedSignal("MaxHp"):Connect(refreshHp)

local toasts = make("Frame", { Size = UDim2.fromOffset(240, 76), BackgroundTransparency = 1, ClipsDescendants = false }, hudRoot)
make("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, toasts)

local hint = text(hudRoot, { Size = UDim2.fromOffset(260, 44), TextSize = 14, TextColor3 = COL.dark, BackgroundColor3 = COL.yellow, BackgroundTransparency = 0, TextWrapped = true, Text = "", Visible = false })
corner(hint, 12)

local function toast(msg)
	for _, c in ipairs(toasts:GetChildren()) do
		if c:IsA("TextLabel") and #toasts:GetChildren() > 3 then
			c:Destroy()
			break
		end
	end
	local accent = COL.panel
	if msg:find("^🌟") then
		accent = COL.yellow
	elseif msg:find("^😡") or msg:find("^🐕") or msg:find("^🥷") or msg:find("Pas assez") or msg:find("Sac plein") or msg:find("Base pleine") then
		accent = COL.red
	elseif msg:find("^🎯") or msg:find("^🎁") or msg:find("^🌅") or msg:find("^⭐") then
		accent = COL.green
	end
	local t = text(toasts, { Size = UDim2.new(1, 0, 0, 30), TextSize = 14, Text = msg, BackgroundColor3 = COL.pill, BackgroundTransparency = 0.08, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y })
	corner(t, 10)
	make("UIStroke", { Color = accent, Thickness = 1.5 }, t)
	make("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, t)
	local sc = make("UIScale", { Scale = 0.6 }, t)
	TweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	Debris:AddItem(t, 3.2)
end

---------------------------------------------------------------- Pop d'éclosion
local pop = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.fromOffset(340, 240), BackgroundTransparency = 1, Visible = false, ZIndex = 10 }, gui)
local popScale = make("UIScale", { Scale = 1 }, pop)
local popRarity = text(pop, { Size = UDim2.new(1, 0, 0, 30), TextSize = 22, Text = "", TextStrokeTransparency = 0 })
local popEmoji = text(pop, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 110), TextSize = 96, Text = "" })
local popName = text(pop, { Position = UDim2.fromOffset(0, 142), Size = UDim2.new(1, 0, 0, 36), TextSize = 28, Text = "", TextStrokeTransparency = 0 })
local popInfo = text(pop, { Position = UDim2.fromOffset(0, 180), Size = UDim2.new(1, 0, 0, 28), TextSize = 20, Text = "", TextStrokeTransparency = 0 })
local popOdds = text(pop, { Position = UDim2.fromOffset(0, 208), Size = UDim2.new(1, 0, 0, 24), TextSize = 16, Text = "", TextColor3 = COL.muted, TextStrokeTransparency = 0.4 })
local popToken = 0
local flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 }, gui)

-- Effets 3D (VfxKit) : modèles d'effets publiés par le serveur dans ReplicatedStorage.VfxTemplates ; qualité Basse sur tactile (3 effets simultanés
-- au plus, 40 particules par émetteur, pas de faisceau) ; un modèle absent ou une erreur = l'effet est simplement sauté.
local function vfxEnv()
	return {
		clone = function(key)
			local folder = ReplicatedStorage:FindFirstChild("VfxTemplates")
			local t = folder and folder:FindFirstChild(key)
			return t and t:Clone() or nil
		end,
		tween = TweenService, debris = Debris, parent = workspace, delay = task.delay, color = Color3.fromRGB,
	}
end
local function padCFrame(slot)
	local pc = player:GetAttribute("PlotCF")
	if typeof(pc) == "CFrame" and type(slot) == "number" then
		local lx, lz = Config.padLocal(slot)
		return pc * CFrame.new(lx, 0.4, lz)
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and (root.CFrame * CFrame.new(0, -2.6, -6)) or nil
end
local function playVfxAt(names, tier, cf)
	if not Config.animEnabled("vfx3d") or not cf then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local q = VfxKitMod.quality(touch, Config.VFX.quality)
	for _, name in ipairs(names) do
		if not Vfx.admit(Vfx.active, q) then
			break
		end
		local plan = Vfx.plan(name, tier, q, 1)
		if plan then
			Vfx.play(vfxEnv(), plan, cf)
		end
	end
end
local function playHatchVfx(info, tier, secret)
	if not Config.animEnabled("vfx3d") then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local q = VfxKitMod.quality(touch, Config.VFX.quality)
	local cf = padCFrame(info.slot)
	if not cf then
		return
	end
	for _, plan in ipairs(Vfx.hatchPlans(tier, secret, q, Vfx.active)) do
		Vfx.play(vfxEnv(), plan, cf)
	end
end

-- Animations d'interface (Config.Animations.uiFx / pulse) : balayage de brillance sur le bandeau de rareté, flash de vignette coloré, pulsation légère de
-- ColorCorrection et Bloom. Tout sous pcall, nettoyé par Debris ; coupé sur demande.
local function shineSweep(label, tint)
	if not Config.animEnabled("uiFx") then
		return
	end
	pcall(function()
		label.ClipsDescendants = true
		local shine = make("Frame", { Name = "Shine", Size = UDim2.new(0.18, 0, 1.6, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(Easing.shineX(0), 0.5), Rotation = 18, BackgroundColor3 = tint or Color3.new(1, 1, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 5 }, label)
		TweenService:Create(shine, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(Easing.shineX(1), 0.5), BackgroundTransparency = 1 }):Play()
		Debris:AddItem(shine, 1.1)
	end)
end
local function vignetteFlash(color, strength)
	if not Config.animEnabled("uiFx") then
		return
	end
	pcall(function()
		local g = make("ScreenGui", { Name = "UiFxVignette", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 40 }, player:WaitForChild("PlayerGui"))
		local function edge(anchor, pos, size, rot)
			local f = make("Frame", { AnchorPoint = anchor, Position = pos, Size = size, BackgroundColor3 = color, BackgroundTransparency = 1 - 0.55 * strength, BorderSizePixel = 0, Active = false }, g)
			make("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
			TweenService:Create(f, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
		end
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.22), 90)
		edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.22), -90)
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.16, 1), 0)
		edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.16, 1), 180)
		Debris:AddItem(g, 1)
	end)
end
local function pulseLighting(strength)
	if not Config.animEnabled("pulse") then
		return
	end
	pcall(function()
		local Lighting = game:GetService("Lighting")
		local bloom, grade = Lighting:FindFirstChild("ChipeBloom"), Lighting:FindFirstChild("ChipeGrade")
		if bloom and bloom:IsA("BloomEffect") and not bloom:GetAttribute("Pulsing") then
			local base = bloom.Intensity
			bloom:SetAttribute("Pulsing", true)
			TweenService:Create(bloom, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Intensity = base + 0.5 * strength }):Play()
			task.delay(0.2, function()
				TweenService:Create(bloom, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Intensity = base }):Play()
				task.delay(1, function()
					bloom.Intensity = base
					bloom:SetAttribute("Pulsing", nil)
				end)
			end)
		end
		if grade and grade:IsA("ColorCorrectionEffect") and not grade:GetAttribute("Pulsing") then
			local base = grade.Brightness
			grade:SetAttribute("Pulsing", true)
			TweenService:Create(grade, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Brightness = base + 0.07 * strength }):Play()
			task.delay(0.2, function()
				TweenService:Create(grade, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Brightness = base }):Play()
				task.delay(1, function()
					grade.Brightness = base
					grade:SetAttribute("Pulsing", nil)
				end)
			end)
		end
	end)
end

-- Montée de niveau de la maison (D.4) : échafaudage, poussière + onde, ancienne maison qui s'enfonce, nouvelle qui monte (BaseUpgradeFx, toutes les bases
-- visibles) ; bannière, fanfare et confettis arrivent avec la notification « levelup » du serveur ; la caméra large est gérée par Cinematics.
do
	local skipEvent = Instance.new("BindableEvent")
	skipEvent.Name = "SkipBaseUpgrade"
	skipEvent.Parent = ReplicatedStorage
	local okFx, fxErr = pcall(function()
		local UpgradeMod = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Upgrade"))
		local BaseUpgradeFx = require(script.Parent:WaitForChild("BaseUpgradeFx"))
		BaseUpgradeFx.start({ Config = Config, Upgrade = UpgradeMod.new(Config, Easing), vfx = playVfxAt, skipEvent = skipEvent })
	end)
	if not okFx then
		warn("[BaseUpgradeFx] " .. tostring(fxErr))
	end
end

local function revealPop(info)
	local def = Config.PETS[info.p]
	if Config.tierAtLeast(def.tier, "announce") and tryOfferLater then
		tryOfferLater("rare")
	end
	local tier = Config.TIERS[def.tier]
	popToken += 1
	local token = popToken
	popEmoji.Text = def.emoji
	popEmoji.Rotation = -14
	TweenService:Create(popEmoji, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	popRarity.Text = Config.tierAtLeast(def.tier, "announce") and ("★ " .. string.upper(tier.name) .. " ★") or string.upper(tier.name)
	popRarity.TextColor3 = tier.color
	popRarity.TextSize = Config.tierAtLeast(def.tier, "announce") and 28 or 20
	popName.Text = Config.petName(info.p, info.s, info.m)
	popName.TextColor3 = tier.color
	popInfo.Text = tier.name .. "  ·  +" .. fmt(info.inc) .. "/s"
	pop.Visible = true
	popScale.Scale = 0.2
	-- Révélation par rareté : style calculé (Reveal.style) d'après la rareté et la probabilité réelle « 1 sur N » envoyée par le serveur.
	local oneIn = type(info.oneIn) == "number" and info.oneIn > 0 and info.oneIn or nil
	popOdds.Text = oneIn and Config.fmtOdds(oneIn) or ""
	local reduced = Config.REVEAL.forceReduced or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
	local st = Reveal.style(Config, def.tier, oneIn, reduced)
	if info.upgraded == true and Config.TIERS[info.egg] then
		popRarity.Text = "⬆ AMÉLIORÉ ! " .. Config.TIERS[info.egg].name .. " → " .. tier.name
		popRarity.TextSize = 22
	end
	if st.secret then
		popRarity.Text = "✦ " .. st.label .. " ✦"
		popRarity.TextColor3 = st.color
		popRarity.TextSize = 26
	end
	if Config.REVEAL.Enabled then
		RevealFx.play(gui, st, UDim2.new(0.5, 0, 0.3, -35))
	end
	local big = Config.tierAtLeast(def.tier, "announce") or info.m > 1 or info.s >= 4
	if st.flash > 0 then
		flash.BackgroundColor3 = Config.MUTS[info.m].color or st.color
		flash.BackgroundTransparency = 1 - 0.7 * st.flash
		TweenService:Create(flash, TweenInfo.new(0.35 + 0.5 * st.flash), { BackgroundTransparency = 1 }):Play()
	end
	playSound(Config.hatchSoundKey(def.tier, st.secret))
	pcall(playHatchVfx, info, def.tier, st.secret) -- effets 3D en plus de la révélation en interface, selon la qualité
	if Config.tierAtLeast(def.tier, "shine") then -- rareté croissante : brillance sur le bandeau dès Épique, vignette colorée et pulsation dès Légendaire
		shineSweep(popRarity, tier.color:Lerp(Color3.new(1, 1, 1), 0.6))
		if Config.tierAtLeast(def.tier, "announce") or st.secret then
			vignetteFlash(st.secret and st.color or tier.color, math.min(1, 0.4 + 0.15 * def.tier))
			pulseLighting(math.min(1.5, 0.5 + 0.2 * def.tier))
		end
	end
	if st.shake > 0.2 then -- secousse de la caméra proportionnelle à la rareté
		task.spawn(function()
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hum then
				return
			end
			local frames = math.floor(8 + 12 * st.shake)
			for k = 1, frames do
				local amp = 0.8 * st.shake * (1 - k / frames)
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0)
				task.wait(0.03)
			end
			hum.CameraOffset = Vector3.zero
		end)
	end
	TweenService:Create(popScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(st.secret and 3.4 or 2.6, function()
		if token == popToken then
			pop.Visible = false
		end
	end)
end

---------------------------------------------------------------- Promesse d'accueil : visible tout de suite, ne bloque rien
-- Une carte compacte (titre, promesse, bouton vert « Jouer ») en haut au centre pendant Config.PROMISE.seconds ; le joueur peut agir pendant ce temps
-- (l'œuf de départ éclot en quelques secondes). Une seule fois par session.
local function showPromise()
	local card = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -140), Size = UDim2.fromOffset(340, 104), BackgroundColor3 = COL.bg, ZIndex = 30 }, gui)
	corner(card, 20)
	make("UIStroke", { Color = Color3.fromRGB(14, 24, 18), Thickness = 4 }, card)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(70, 160, 110), Color3.fromRGB(20, 60, 40)), Rotation = 90 }, card)
	text(card, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 30), Text = "🥚 " .. Config.TITLE, TextSize = 24, TextColor3 = COL.yellow, TextStrokeTransparency = 0.3, ZIndex = 31 })
	text(card, { Position = UDim2.fromOffset(12, 36), Size = UDim2.new(1, -24, 0, 36), Text = Config.TAGLINE, TextSize = 14, TextWrapped = true, ZIndex = 31 })
	local play = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.fromOffset(120, 28), Text = Config.PROMISE.button, Font = FONT, TextSize = 15, ZIndex = 32 }, card)
	local st = glossy(play, "play", 12, 2)
	if st then
		play.TextColor3 = st.text
	end
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -140) }):Play()
		Debris:AddItem(card, 0.5)
	end
	play.Activated:Connect(close)
	TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 10) }):Play()
	task.delay(Config.PROMISE.seconds, close)
end

