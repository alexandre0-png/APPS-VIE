	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetReportUi")).start(Config, player, ReplicatedStorage, UserInputService)
end)

---------------------------------------------------------------- Compteur de debug (FPS, ping, Parts) : F3 l'affiche ou le masque ; coupé par défaut
do
	local dbg = Instance.new("ScreenGui")
	dbg.Name = "DebugStats"
	dbg.ResetOnSpawn = false
	dbg.DisplayOrder = 80
	dbg.Enabled = Config.HUD.debugStats == true
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundColor3 = Color3.new(0, 0, 0)
	lbl.BackgroundTransparency = 0.45
	lbl.AnchorPoint = Vector2.new(0.5, 0)
	lbl.Position = UDim2.new(0.5, 0, 0, 4)
	lbl.Size = UDim2.fromOffset(300, 22)
	lbl.Font = Enum.Font.Code
	lbl.TextSize = 14
	lbl.TextColor3 = Color3.fromRGB(180, 255, 190)
	lbl.Text = ""
	lbl.Active = false
	lbl.Parent = dbg
	pcall(function()
		dbg.Parent = player:WaitForChild("PlayerGui")
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F3 then
				dbg.Enabled = not dbg.Enabled
			end
		end)
	end)
	task.spawn(function()
		local frames, t0 = 0, os.clock()
		local conn = RunService.RenderStepped:Connect(function()
			frames += 1
		end)
		while conn.Connected do
			task.wait(0.5)
			if dbg.Enabled then
				local now = os.clock()
				local fps = frames / math.max(0.001, now - t0)
				frames, t0 = 0, now
				local ping = "?"
				pcall(function()
					ping = string.format("%d", game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
				end)
				lbl.Text = string.format("FPS %d · ping %s ms", math.floor(fps + 0.5), ping)
			else
				frames, t0 = 0, os.clock()
			end
		end
	end)
end
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX77"><Properties><string name="Name">Animations</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Animations
-- Animations locales (aucun coût réseau). Chaque animation est activable dans Config.Animations et exécutée par Easing.guard :
-- sous pcall, et désactivée pour la session si elle lève une erreur. Les valeurs (courbes, phases, confettis) viennent du module
-- pur Easing, testé hors de Roblox. Aucune animation n'est nécessaire au gameplay.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Easing = require(Shared:WaitForChild("Easing"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local failed = {}
local function run(name, fn)
	return Easing.guard(Config.animEnabled, failed, name, fn, function(n, err)
		warn("[Animations] « " .. n .. " » désactivée pour cette session après une erreur : " .. tostring(err))
	end)
end

local state = nil
Remotes:WaitForChild("State").OnClientEvent:Connect(function(snap)
	state = snap
end)

---------------------------------------------------------------- Œufs : tremblement, blanchissement, rebond, squash & stretch
-- Les œufs à animer (pads, nids) portent le tag EggShake ; l'attribut Ends (heure d'éclosion) n'existe que sur les pads.
local eggData = setmetatable({}, { __mode = "k" })

local function eggInfo(egg)
	local d = eggData[egg]
	if not d then
		d = {
			base = egg.CFrame,
			color = egg.Color,
			mesh = egg:FindFirstChildOfClass("SpecialMesh"),
			phase = (egg.Position.X * 0.37 + egg.Position.Z * 0.51) % 3.2, -- désynchronise les rebonds
		}
		eggData[egg] = d
	end
	return d
end

RunService.RenderStepped:Connect(function()
	if not (Config.animEnabled("eggShake") or Config.animEnabled("eggBounce") or Config.animEnabled("hatchSquash")) then
		return
	end
	local eggs = CollectionService:GetTagged("EggShake")
	if #eggs == 0 then
		return
	end
	local now, t = os.time(), os.clock()
	for _, egg in ipairs(eggs) do
		local d = eggInfo(egg)
		d.y, d.rx, d.rz, d.sx, d.sy, d.whiten = 0, 0, 0, 1, 1, 0
		local ends = egg:GetAttribute("Ends")
		d.left = ends and (ends - now) or 99
	end
	run("eggShake", function() -- tremble les 4 dernières secondes, blanchit dans la dernière seconde et demie
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left < 4 then
				local a = (4 - d.left) / 4
				d.rx = math.sin(t * 29) * 0.08 * a
				d.rz = math.sin(t * 35) * 0.12 * a
				d.whiten = d.left < 1.5 and (1.5 - d.left) / 1.5 * (0.5 + 0.5 * math.sin(t * 22)) or 0
			end
		end
	end)
	run("eggBounce", function() -- petit saut périodique tant que l'éclosion n'est pas imminente
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left >= 4 then
				d.y, d.sx, d.sy = Easing.eggHop(t, d.phase, 0.6)
			end
		end
	end)
	run("hatchSquash", function() -- l'œuf pulse (écrasé puis étiré) dans les 2 dernières secondes : vrai squash & stretch non uniforme
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left < 2 then
				local sx, sy = Easing.squashStretch((t * 1.6) % 1, 0.18 + 0.2 * (2 - d.left) / 2)
				d.sx, d.sy = d.sx * sx, d.sy * sy
			end
		end
	end)
	pcall(function()
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			egg.CFrame = d.base * CFrame.new(0, d.y, 0) * CFrame.Angles(d.rx, 0, d.rz)
			if d.mesh then
				d.mesh.Scale = Vector3.new(d.sx, d.sy, d.sx)
			end
			egg.Color = d.color:Lerp(Color3.new(1, 1, 1), d.whiten)
		end
	end)
end)

-- Halos des œufs (anneau du légendaire qui tourne, sphère du glitch qui scintille) : modification locale de la soudure et de la transparence.
local haloBase = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("eggHalo", function()
		local t = os.clock()
		for _, halo in ipairs(CollectionService:GetTagged("EggHalo")) do
			local weld = halo:FindFirstChild("HaloWeld")
			if weld then
				local base = haloBase[halo]
				if not base then
					base = weld.C0
					haloBase[halo] = base
				end
				local spin = halo:GetAttribute("Spin") or 0
				local off = CFrame.new()
				local trans = halo:GetAttribute("BaseT") or 0.5
				if spin ~= 0 then
					off = CFrame.Angles(0, t * spin, 0)
				end
				if halo:GetAttribute("Flicker") then
					local k = math.floor(t * 10)
					local r = (math.sin(k * 12.9898 + weld.Part0.Position.X) * 43758.5453) % 1
					if r > 0.8 then
						off = CFrame.new((r - 0.9) * 2.4, 0, 0)
					end
					if r > 0.65 then
						trans = math.min(1, trans + 0.3)
					end
				end
				weld.C0 = off * base
				halo.Transparency = trans
			end
		end
	end)
end)

-- Aura des raretés élevées : sur appareil tactile sans clavier (ou Config.REVEAL.forceReduced), le pilier de lumière et la moitié des particules sont coupés.
local UserInputService = game:GetService("UserInputService")
local auraTrimmed = setmetatable({}, { __mode = "k" })
task.spawn(function()
	while true do
		task.wait(0.5)
		run("auraReduced", function()
			if Config.REVEAL.forceReduced or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
				for _, a in ipairs(CollectionService:GetTagged("AuraFx")) do
					if not auraTrimmed[a] then
						auraTrimmed[a] = true
						for _, d in ipairs(a:GetChildren()) do
							if d:IsA("Beam") then
								d.Enabled = false
							elseif d:IsA("ParticleEmitter") then
								d.Rate = d.Rate / 2
							end
						end
					end
				end
			end
		end)
	end
end)

-- Marqueurs d'éléments interactifs (nids, secrets) : l'anneau doré pulse doucement.
RunService.RenderStepped:Connect(function()
	run("interactMarkers", function()
		local t = os.clock()
		for _, m in ipairs(CollectionService:GetTagged("Interactive")) do
			local base = m:GetAttribute("BaseT") or 0.35
			m.Transparency = math.clamp(base + math.sin(t * 3 + m.Position.X * 0.1) * 0.25, 0, 1)
		end
	end)
end)

-- Œufs portés : ils rebondissent pendant la course (modification locale de la soudure).
local carryBase = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("eggBounce", function()
		local t = os.clock()
		for _, egg in ipairs(CollectionService:GetTagged("CarryEgg")) do
			local weld = egg:FindFirstChildOfClass("Weld")
			if weld then
				local base = carryBase[egg]
				if not base then
					base = weld.C0
					carryBase[egg] = base
				end
				local hum = egg.Parent and egg.Parent:FindFirstChildOfClass("Humanoid")
				local moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
				weld.C0 = base * CFrame.new(0, Easing.runBounce(t + base.Y * 0.4, moving), 0)
			end
		end
	end)
end)

---------------------------------------------------------------- Pets : apparition (squash & stretch), onde de choc
-- Approximation : les modèles de pets sont faits de plusieurs Parts, on ne peut donc les mettre à l'échelle que de façon uniforme.
-- Le squash & stretch du pet est rendu par une échelle uniforme qui suit la courbe verticale ; celui de l'œuf (avant éclosion) est réel.
CollectionService:GetInstanceAddedSignal("PopIn"):Connect(function(model)
	local born = model:GetAttribute("Born")
	local serverNow = workspace:GetServerTimeNow()
	if not born or type(serverNow) ~= "number" or serverNow - born > 2 then
		return
	end
	local squash = Config.animEnabled("hatchSquash")
	if not (squash or Config.animEnabled("popIn")) then
		return
	end
	task.spawn(function()
		run(squash and "hatchSquash" or "popIn", function()
			local t0 = os.clock()
			local base = model:GetScale() -- échelle posée par le serveur (hauteur cible) : l'animation en est relative, jamais absolue
			while model.Parent do
				local a = math.min(1, (os.clock() - t0) / 0.7)
				model:ScaleTo(base * Easing.popScale(a, squash)) -- plafonné : le pet n'apparaît jamais plus gros que nature
				if a >= 1 then
					model:ScaleTo(base)
					break
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end)
end)

CollectionService:GetInstanceAddedSignal("Shockwave"):Connect(function(ring)
	run("shockwave", function()
		local big = ring:GetAttribute("Big")
		local d = big and 40 or 22
		TweenService:Create(ring, TweenInfo.new(big and 0.7 or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, d, d), Transparency = 1 }):Play()
	end)
end)

---------------------------------------------------------------- Récolte : l'œuf s'envole en arc vers le joueur
CollectionService:GetInstanceAddedSignal("FlyEgg"):Connect(function(egg)
	local target = Players:GetPlayerByUserId(egg:GetAttribute("Target") or 0)
	local start = egg:GetAttribute("Start")
	if not (target and start) then
		return
	end
	local baseSize = egg.Size
	task.spawn(function()
		run("harvest", function()
			local t0 = os.clock()
			while egg.Parent do
				local a = math.min(1, (os.clock() - t0) / 0.4)
				local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if not root then
					break
				end
				local e = a * a * (3 - 2 * a)
				local pos = start:Lerp(root.Position + Vector3.new(0, 4, 0), e) + Vector3.new(0, math.sin(a * math.pi) * 4, 0)
				egg.CFrame = CFrame.new(pos)
				egg.Size = baseSize * (1 - 0.6 * a)
				if a >= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
			if egg.Parent then
				egg.Transparency = 1
			end
		end)
	end)
end)

---------------------------------------------------------------- Visage des pets : clignement, regard, bouche
-- Paupières (LidL/LidR) et bouche (Mouth) sont des Parts du modèle ; les yeux se déplacent légèrement. Seuls les pets proches de la
-- caméra sont animés, au plus MAX_FACES par image (tourniquet), pour rester léger avec beaucoup de joueurs.
local MAX_FACES = 24
local FACE_RANGE = 70
local faceCache = setmetatable({}, { __mode = "k" })
local faceCursor = 0

local function facePart(body, model, name)
	local p = model:FindFirstChild(name)
	if p then
		return { part = p, rel = body.CFrame:ToObjectSpace(p.CFrame) }
	end
	return nil
end

local function faceOf(model)
	local c = faceCache[model]
	if c then
		return c
	end
	local body = model.PrimaryPart
	if not body then
		return nil
	end
	c = {
		body = body,
		R = body.Size.X / 2,
		seed = model:GetAttribute("Seed") or 0,
		eyeL = facePart(body, model, "EyeL"), eyeR = facePart(body, model, "EyeR"),
		shineL = facePart(body, model, "ShineL"), shineR = facePart(body, model, "ShineR"),
		lidL = facePart(body, model, "LidL"), lidR = facePart(body, model, "LidR"),
		mouth = facePart(body, model, "Mouth"),
		lidShown = false, lastMouth = 0,
	}
	if c.mouth then
		c.mouthSize = c.mouth.part.Size
	end
	faceCache[model] = c
	return c
end

RunService.RenderStepped:Connect(function()
	if not (Config.animEnabled("petBlink") or Config.animEnabled("petLook") or Config.animEnabled("petMouth")) then
		return
	end
	local cam = workspace.CurrentCamera
	local models = CollectionService:GetTagged("PetFace")
	if not cam or #models == 0 then
		return
	end
	local camPos, nowServer, t = cam.CFrame.Position, workspace:GetServerTimeNow(), os.clock()
	if type(nowServer) ~= "number" then
		nowServer = os.time()
	end
	local near = {}
	for _, m in ipairs(models) do
		local body = m.PrimaryPart
		if body and (body.Position - camPos).Magnitude < FACE_RANGE then
			local born = m:GetAttribute("Born")
			if not born or nowServer - born > 1.2 then -- pas pendant l'apparition (le modèle change d'échelle)
				near[#near + 1] = m
			end
		end
	end
	local list = near
	if #near > MAX_FACES then
		list = {}
		for k = 0, MAX_FACES - 1 do
			list[#list + 1] = near[(faceCursor + k) % #near + 1]
		end
		faceCursor = (faceCursor + MAX_FACES) % #near
	end
	run("petBlink", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c and c.lidL and c.lidR then
				local closed = Easing.blinkOpenness(t, c.seed) < 0.45
				if closed ~= c.lidShown then
					c.lidShown = closed
					c.lidL.part.Transparency = closed and 0 or 1
					c.lidR.part.Transparency = closed and 0 or 1
				end
			end
		end
	end)
	run("petLook", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c then
				local dx, dy = Easing.look(t, c.seed)
				local off = CFrame.new(dx * 0.06 * c.R, dy * 0.05 * c.R, 0)
				local base = c.body.CFrame
				for _, key in ipairs({ "eyeL", "eyeR", "shineL", "shineR" }) do
					local e = c[key]
					if e then
						e.part.CFrame = base * e.rel * off
					end
				end
			end
		end
	end)
	run("petMouth", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c and c.mouth then
				local open = Easing.mouthOpen(t, c.seed)
				if open ~= c.lastMouth then
					c.lastMouth = open
					local sz = c.mouthSize
					c.mouth.part.Size = Vector3.new(sz.X, sz.Y * (1 + open * 2.5), sz.Z)
					c.mouth.part.CFrame = c.body.CFrame * c.mouth.rel * CFrame.new(0, -open * 0.04 * c.R, 0)
				end
			end
		end
	end)
end)

---------------------------------------------------------------- Mère Poule : elle picore (la tête pivote autour du cou)
local henCache = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("hen", function()
		local t = os.clock()
		for _, model in ipairs(CollectionService:GetTagged("Hen")) do
			local body = model.PrimaryPart
			if body then
				local c = henCache[model]
				if not c then
					c = { parts = {}, seed = model:GetAttribute("Seed") or 0 }
					for _, name in ipairs({ "HenHead", "HenComb", "HenBeak", "HenWattle", "HenEyeL", "HenEyeR" }) do
						local p = model:FindFirstChild(name)
						if p then
							c.parts[#c.parts + 1] = { part = p, rel = body.CFrame:ToObjectSpace(p.CFrame) }
						end
					end
					henCache[model] = c
				end
				local neck = CFrame.new(0, 1.3, -1.2) -- pivot du cou (repère du corps)
				local rot = neck * CFrame.Angles(-Easing.peck(t, c.seed) * 0.7, 0, 0) * neck:Inverse()
				local base = body.CFrame
				for _, e in ipairs(c.parts) do
					e.part.CFrame = base * rot * e.rel
				end
			end
		end
	end)
end)

---------------------------------------------------------------- Barrières de zone (portails) : pulsation et dissolution à l'ouverture
local gateState = setmetatable({}, { __mode = "k" })

local function setGateOpen(gate)
	gate.CanCollide = false
	gate.Transparency = 1
	local lbl = gate:FindFirstChild("Label")
	if lbl then
		lbl.Enabled = false
	end
	gateState[gate] = "open"
end

local function openGateAnimated(gate)
	gateState[gate] = "opening"
	gate.CanCollide = false -- on peut passer pendant que la barrière se dissout
	local started = run("zones", function()
		local lbl = gate:FindFirstChild("Label")
		if lbl then
			lbl.Enabled = false
		end
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 255, 255))
		sparks.Rate = 0
		sparks.Lifetime = NumberRange.new(0.8, 1.6)
		sparks.Speed = NumberRange.new(10, 26)
		sparks.SpreadAngle = Vector2.new(180, 180)
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
		sparks.Parent = gate
		sparks:Emit(90)
		Debris:AddItem(sparks, 2.5)
		local tween = TweenService:Create(gate, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1, Size = gate.Size * 1.12 })
		tween.Completed:Connect(function()
			pcall(setGateOpen, gate)
		end)
		tween:Play()
	end)
	if not started then
		setGateOpen(gate) -- animation désactivée ou en erreur : ouverture immédiate
	end
end

RunService.RenderStepped:Connect(function()
	if not state then
		return
	end
	local gates = CollectionService:GetTagged("ZoneGate")
	if #gates == 0 then
		return
	end
	local t = os.clock()
	for _, gate in ipairs(gates) do
		local rival = gate:GetAttribute("Rival") or 0
		local gs = gateState[gate]
		if Config.zoneUnlocked(state.story.ch, rival) then
			if gs == nil or not Config.animEnabled("zones") then
				if gs ~= "open" then
					setGateOpen(gate) -- déjà ouverte à l'arrivée (ou animations coupées) : pas de mise en scène
				end
			elseif gs == "closed" then
				openGateAnimated(gate)
			end
		else
			if gs ~= "closed" then
				gate.CanCollide = true
				local lbl = gate:FindFirstChild("Label")
				if lbl then
					lbl.Enabled = true
				end
				gateState[gate] = "closed"
			end
			if not run("zones", function()
				gate.Transparency = 0.5 + 0.2 * Easing.gatePulse(t + rival, 2.2)
			end) then
				gate.Transparency = 0.6
			end
		end
	end
end)

---------------------------------------------------------------- Récompenses : confettis stylisés ; prise d'œuf / capture : secousse du champ de vision
local fx = Instance.new("ScreenGui")
fx.Name = "ChipeFX"
fx.ResetOnSpawn = false
fx.IgnoreGuiInset = true
fx.DisplayOrder = 50
fx.Parent = player:WaitForChild("PlayerGui")

local function uiConfetti(burst)
	for i = 1, burst.count do
		local p = Easing.confettiParticle(i, burst.count, burst)
		local f = Instance.new("Frame")
		f.Size = UDim2.fromOffset(p.w, p.h)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.4)
		f.BackgroundColor3 = Color3.fromHSV(p.hue, 0.75, 1)
		f.BorderSizePixel = 0
		f.Rotation = (i * 37) % 360
		f.Parent = fx
		local dx = math.cos(p.angle) * p.speed * burst.life * 0.5
		local dy = math.sin(p.angle) * p.speed * burst.life * 0.5 + 520 * burst.life * burst.life * 0.5 -- + gravité
		TweenService:Create(f, TweenInfo.new(burst.life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, dx, 0.4, dy),
			Rotation = f.Rotation + p.spin * burst.life,
			BackgroundTransparency = 1,
		}):Play()
		Debris:AddItem(f, burst.life + 0.1)
	end
end

local kicking = false
local function fovKick(kind)
	local k = Easing.FOV_KICK[kind]
	local cam = workspace.CurrentCamera
	if not k or not cam or kicking then
		return
	end
	kicking = true
	TweenService:Create(cam, TweenInfo.new(k.time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { FieldOfView = cam.FieldOfView + k.delta }):Play()
	task.delay(k.time * 2 + 0.05, function()
		kicking = false
	end)
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(_msg, sfx)
	local burst = Easing.rewardBurst(sfx)
	if burst then
		run("reward", function()
			uiConfetti(burst)
		end)
	end
	if sfx == "steal" or sfx == "caught" then
		run("characterPop", function()
			fovKick(sfx)
		end)
	end
end)

Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	local def = Config.PETS[info.p]
	if def and (Config.tierAtLeast(def.tier, "announce") or info.m > 1 or info.s >= 4) then
		run("reward", function()
			uiConfetti(Easing.REWARD.rare)
		end)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX78"><Properties><string name="Name">Cinematics</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Cinematics
-- Cinématiques courtes, aux moments clés seulement : intro (la ferme, Mère Poule, les œufs, le but) et mini tutoriel au premier lancement,
-- première zone débloquée, premier pet rare. Toutes skippables (bouton, Entrée, manette B), réglables dans Config.Cinematics, exécutées
-- sous pcall (Easing.guard), et JAMAIS bloquantes : le joueur garde le contrôle de son personnage, le jeu continue, la caméra est
-- restituée quoi qu'il arrive (fin, skip, mort, attaque, erreur, délai de sécurité). La logique (séquences, durées, skip, reprise, file)
-- est dans le module pur Cinema, testé hors de Roblox.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Easing = require(Shared:WaitForChild("Easing"))
local Cinema = require(Shared:WaitForChild("Cinema")).new(Easing)
local CinematicKitMod = require(Shared:WaitForChild("CinematicKit"))
local Kit = CinematicKitMod.new(Easing, Cinema)
local Castle = require(Shared:WaitForChild("Castle"))
local UpgradeMod = require(Shared:WaitForChild("Upgrade")).new(Config, Easing)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RAction = Remotes:WaitForChild("Action")

local BIND_NAME = "ChipeCine"
local director = Cinema.director()
local plans = {} -- id -> { seq, resolved = { CFrame par plan }, startedAt }
local activeId = nil
local saved = nil -- caméra du joueur avant la cinématique
local bound = false
local state = nil
local lastCh = nil
local failed = {}

---------------------------------------------------------------- Interface : barres de cinéma, légende, bouton Passer
local gui = Instance.new("ScreenGui")
gui.Name = "ChipeCine"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 60
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local function bar(anchorY, height)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0, anchorY)
	f.Position = UDim2.fromScale(0, anchorY)
	f.Size = UDim2.fromScale(1, height)
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.BackgroundTransparency = 0.1
	f.BorderSizePixel = 0
	f.Parent = gui
	return f
end
local topBar, bottomBar = bar(0, 0.09), bar(1, 0.2)

local caption = Instance.new("TextLabel")
caption.BackgroundTransparency = 1
caption.Size = UDim2.new(0.84, 0, 0.8, 0)
caption.AnchorPoint = Vector2.new(0.5, 0.5)
caption.Position = UDim2.fromScale(0.5, 0.5)
caption.Font = Enum.Font.GothamBold
caption.TextColor3 = Color3.fromRGB(255, 244, 220)
caption.TextStrokeTransparency = 0.5
caption.TextWrapped = true
caption.TextScaled = true
caption.Text = ""
caption.Parent = bottomBar
local limit = Instance.new("UITextSizeConstraint")
limit.MaxTextSize = 28
limit.MinTextSize = 12
limit.Parent = caption

local header = Instance.new("TextLabel")
header.BackgroundTransparency = 1
header.Position = UDim2.fromOffset(16, 0)
header.Size = UDim2.new(0.5, 0, 1, 0)
header.Font = Enum.Font.GothamBold
header.TextSize = 18
header.TextXAlignment = Enum.TextXAlignment.Left
header.TextColor3 = Color3.fromRGB(255, 214, 120)
header.Text = ""
header.Parent = topBar

local function button(text, xOffset, width)
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Position = UDim2.new(1, xOffset, 0.5, 0)
	b.Size = UDim2.fromOffset(width, 34)
	b.BackgroundColor3 = Color3.fromRGB(255, 210, 63)
	b.TextColor3 = Color3.fromRGB(43, 34, 0)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.Text = text
	b.Parent = topBar
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = b
	return b
end
local skipBtn = button("Passer ▶", -12, 110)
local skipAllBtn = button("Tout passer", -132, 120)
skipAllBtn.BackgroundColor3 = Color3.fromRGB(75, 91, 81)
skipAllBtn.TextColor3 = Color3.fromRGB(244, 255, 246)

-- Carton de titre au centre (cinématiques à titre : « 🏰 Le Château », « ✦ SECRET ✦ »), jamais cliquable.
local titleCard = Instance.new("TextLabel")
titleCard.BackgroundTransparency = 1
titleCard.AnchorPoint = Vector2.new(0.5, 0.5)
titleCard.Position = UDim2.fromScale(0.5, 0.42)
titleCard.Size = UDim2.fromScale(0.8, 0.14)
titleCard.Font = Enum.Font.GothamBlack
titleCard.TextScaled = true
titleCard.TextColor3 = Color3.fromRGB(255, 244, 220)
titleCard.TextStrokeTransparency = 0.3
titleCard.TextTransparency = 1
titleCard.Text = ""
titleCard.Active = false
titleCard.Parent = gui
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MaxTextSize = 54
titleLimit.MinTextSize = 18
titleLimit.Parent = titleCard

local TITLES = { intro = "🎬 Il était une fois…", tutorial = "🎓 Comment jouer", firstZone = "🔓 Nouveau domaine", firstRare = "✨ Pet rare !" }

---------------------------------------------------------------- Caméra : toujours restituée
local function takeCamera()
	local cam = workspace.CurrentCamera
	if cam and not saved then
		saved = { cameraType = cam.CameraType, subject = cam.CameraSubject, fov = cam.FieldOfView }
		cam.CameraType = Enum.CameraType.Scriptable
	end
end

local function giveCameraBack()
	local cam = workspace.CurrentCamera
	if cam and saved then
		cam.CameraType = (saved.cameraType == Enum.CameraType.Scriptable) and Enum.CameraType.Custom or saved.cameraType
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = hum or saved.subject
		if type(saved.fov) == "number" then
			cam.FieldOfView = saved.fov -- le champ de vision d'une cinématique n'est jamais gardé
		end
	end
	saved = nil
end

local function exitCinematic()
	if bound then
		bound = false
		pcall(function()
			RunService:UnbindFromRenderStep(BIND_NAME)
		end)
	end
	pcall(giveCameraBack)
	gui.Enabled = false
	activeId = nil
	plans = {}
end

-- Sortie de secours : quoi qu'il arrive, tout s'arrête et la caméra revient au joueur. Rien n'est considéré comme vu.
local function emergency(reason)
	director.abort()
	exitCinematic()
	if reason then
		warn("[Cinematics] arrêt : " .. tostring(reason))
	end
end

local function markSeen(id)
	pcall(function()
		RAction:FireServer("cineSeen", id)
	end)
end

---------------------------------------------------------------- Ancres de caméra
local function plotCFrame()
	local attr = player:GetAttribute("PlotCF")
	if typeof(attr) == "CFrame" then
		return attr
	end
	local spawn = player.RespawnLocation
	if spawn and spawn:IsA("BasePart") then
		return spawn.CFrame * CFrame.new(0, -1.2, 20) -- le spawn est à (0, 1.2, -20) dans le repère de la base
	end
	return nil
end

local function rivalCF(i)
	local x, z = Config.rivalCenter(i)
	return CFrame.new(x, Config.rivalHeight(i), z)
end

local anchors = {
	arena = function()
		return CFrame.new(0, 0, 0)
	end,
	hen = function()
		local m = CollectionService:GetTagged("Hen")[1]
		local body = m and m.PrimaryPart
		return body and CFrame.new(body.Position.X, 0, body.Position.Z) or nil
	end,
	rival1 = function()
		return rivalCF(1)
	end,
	rival2 = function()
		return rivalCF(2)
	end,
	rival3 = function()
		return rivalCF(3)
	end,
	base = plotCFrame,
	world = function(ctx)
		return ctx and ctx.cf or nil
	end,
	castle = function()
		local x, z = Castle.toWorld(1, 0, 0)
		return CFrame.new(x, 0, z)
	end,
	castle_chest = function()
		local x, z = Castle.toWorld(Castle.ROOMS, 0, Castle.ROOM_LENGTH - 5)
		return CFrame.new(x, 0, z)
	end,
	pad = function(ctx)
		local pc = plotCFrame()
		if not pc or not ctx or not ctx.slot then
			return nil
		end
		local lx, lz = Config.padLocal(ctx.slot)
		return pc * CFrame.new(lx, 1.4, lz)
	end,
}

local function toWorld(acf, v)
	return acf:PointToWorldSpace(Vector3.new(v[1], v[2], v[3]))
end

---------------------------------------------------------------- Mise en scène
local function sparkleAt(position)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = position
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 232, 150), Color3.fromRGB(255, 255, 255))
	e.Rate = 0
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(6, 18)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = p
	p.Parent = workspace
	e:Emit(50)
	Debris:AddItem(p, 3)
end

local function onShot(id, index)
	local plan = plans[id]
	local shot = plan.seq.shots[index]
	caption.Text = shot.text
	caption.TextTransparency = 1
	TweenService:Create(caption, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	header.Text = (TITLES[id] or "🎬") .. "   " .. index .. "/" .. #plan.seq.shots
	if shot.title then
		titleCard.Text = shot.title
		titleCard.TextTransparency = 1
		TweenService:Create(titleCard, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextTransparency = 0 }):Play()
		task.delay(math.max(0.8, shot.dur - 0.5), function()
			TweenService:Create(titleCard, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end)
	end
	if shot.fx == "sparkle" or shot.fx == "sparks" or shot.fx == "crack" or shot.fx == "flash" then
		pcall(sparkleAt, toWorld(plan.resolved[index], shot.look) + Vector3.new(0, 2, 0))
	end
end

local function step()
	local now = os.clock()
	local cur = director.current
	local curPlan = cur and plans[cur.id]
	local tnow = now
	if curPlan and curPlan.kit then
		tnow = curPlan.requestedAt + Kit.virtualElapsed(curPlan.def, now - curPlan.requestedAt) -- le ralenti fait avancer le temps des prises plus lentement
	end
	local id, ev = director.update(tnow)
	if not id then
		exitCinematic()
		return
	end
	if not ev then
		return
	end
	if ev.finished then
		markSeen(id)
		if not director.current then
			exitCinematic()
		end
		return
	end
	local plan = plans[id]
	if not plan then
		return emergency("plan inconnu : " .. tostring(id))
	end
	if activeId ~= id then
		activeId = id
		plan.startedAt = now
	end
	if now - plan.startedAt > (plan.kit and Kit.realTotal(plan.def) or plan.seq.total) + Config.Cinematics.watchdog then
		return emergency("délai de sécurité dépassé")
	end
	if ev.shotChanged then
		onShot(id, ev.shot)
	end
	local cam = workspace.CurrentCamera
	local acf = plan.resolved[ev.shot]
	if plan.kit then
		local shot = plan.seq.shots[ev.shot]
		local kpos, klook, kfov = Kit.cameraAt(shot, ev.progress)
		local off = Kit.shakeOffset(shot, ev.progress, now)
		cam.CFrame = CFrame.lookAt(toWorld(acf, kpos) + Vector3.new(off[1], off[2], off[3]), toWorld(acf, klook))
		cam.FieldOfView = kfov
	else
		local pos, look = Cinema.cameraAt(plan.seq.shots[ev.shot], ev.progress)
		cam.CFrame = CFrame.lookAt(toWorld(acf, pos), toWorld(acf, look))
	end
	skipAllBtn.Visible = #director.queue > 0
end

local function safeStep()
	local ok, err = pcall(step)
	if not ok then
		local id = activeId
		if id then
			failed[id] = true
		end
		emergency(err)
	end
end

local function enter()
	gui.Enabled = true
	skipAllBtn.Visible = false
	takeCamera()
	if not bound then
		bound = true
		RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, safeStep)
	end
end

---------------------------------------------------------------- Lancer, passer
local function warnOnce(name, err)
	warn("[Cinematics] « " .. name .. " » désactivée pour cette session après une erreur : " .. tostring(err))
	emergency()
end

-- Retourne true si la cinématique a démarré ou été mise en file. Ne lève jamais d'erreur.
local function begin(id, def, ctx, chain, kit)
	if failed[id] or not (kit and Config.Cinematics.enabled == true or Config.cineEnabled(id)) then
		return false
	end
	if kit then
		local built = Kit.build(def) -- 8 secondes réelles au plus, prises validées
		if not built then
			return false
		end
		def = built
	end
	local ok, seq = pcall(Cinema.sequence, def)
	if not ok or not seq then
		return false
	end
	local resolved = {}
	for i, shot in ipairs(seq.shots) do
		local f = anchors[shot.anchor]
		local okAnchor, cf = pcall(function()
			return f and f(ctx)
		end)
		if not (okAnchor and cf) then
			return false -- ancre pas encore prête (monde non chargé) : pas de cinématique plutôt qu'un plan cassé
		end
		resolved[i] = cf
	end
	local started = false
	Easing.guard(kit and function()
		return Config.Cinematics.enabled == true
	end or Config.cineEnabled, failed, id, function()
		local result = director.request(id, seq, os.clock(), chain)
		if result == "refused" then
			return
		end
		plans[id] = { seq = seq, resolved = resolved, startedAt = nil, kit = kit == true, def = def, requestedAt = os.clock(), skipOnTap = def.skipOnTap == true }
		started = true
		if result == "playing" then
			enter()
		end
	end, warnOnce)
	return started
end

local function skipCurrent()
	local id = director.skip(os.clock())
	if id then
		markSeen(id)
		if id == "base_niveau" then -- passer la caméra de la montée de niveau passe aussi l'animation de la maison (le serveur remet la maison en place seul)
			local ev = game:GetService("ReplicatedStorage"):FindFirstChild("SkipBaseUpgrade")
			if ev then
				ev:Fire()
			end
		end
	end
	if not director.current then
		exitCinematic()
	end
end

local function skipEverything()
	for _, id in ipairs(director.skipAll()) do
		markSeen(id)
	end
	exitCinematic()
end

skipBtn.Activated:Connect(skipCurrent)
skipAllBtn.Activated:Connect(skipEverything)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not director.isActive() then
		return
	end
	-- une cinématique d'éclosion se passe d'un simple tap dans le monde (un tap sur l'interface, par exemple l'inventaire, ne la passe pas et ne la bloque pas)
	local cp = director.current and plans[director.current.id]
	if cp and cp.skipOnTap and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		skipCurrent()
		return
	end
	if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonB then
		skipCurrent()
	end
end)

---------------------------------------------------------------- Abandon : le joueur est attaqué ou meurt
Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(_msg, sfx)
	if (sfx == "caught" or sfx == "hurt") and director.isActive() then
		emergency() -- un gardien ou un voleur s'en prend à lui : retour immédiat au jeu
	end
end)
local function watchCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			emergency()
		end)
	end
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	task.spawn(watchCharacter, player.Character)
end

---------------------------------------------------------------- Déclencheurs (moments clés uniquement)
-- Premier lancement : intro puis mini tutoriel (le tutoriel est mis en file derrière l'intro). Nouveaux joueurs seulement.
local function onFirstState()
	local t0 = os.clock()
	while os.clock() - t0 < 20 and not (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and plotCFrame()) do
		task.wait(0.25)
	end
	task.wait(1.5) -- laisse le jeu s'afficher
	if not state or state.story.ch ~= 0 or state.hatched ~= 0 then
		return
	end
	local playIntro = Config.cineEnabled("intro") and not state.cine.intro
	local playTutorial = Config.cineEnabled("tutorial") and not state.cine.tutorial
	if playIntro then
		begin("intro", Config.CINE.intro, {}, false)
		if playTutorial then
			begin("tutorial", Config.CINE.tutorial, {}, true)
		end
	elseif playTutorial then
		begin("tutorial", Config.CINE.tutorial, {}, false)
	end
end

Remotes:WaitForChild("State").OnClientEvent:Connect(function(snap)
	local first = state == nil
	state = snap
	if first then
		lastCh = snap.story.ch
		task.spawn(onFirstState)
		return
	end
	-- première zone débloquée : le chapitre vient d'atteindre le seuil d'un domaine
	if snap.story.ch > lastCh and not snap.cine.firstZone and snap.carry == 0 then
		for idx, zone in ipairs(Config.ZONES) do
			if zone.chapter > 0 and zone.chapter == snap.story.ch then
				begin("firstZone", Config.cineFirstZone(idx), {}, false)
			end
		end
	end
	lastCh = snap.story.ch
end)

-- Premier pet rare (même critère que les confettis) ; l'emplacement vient du serveur.
Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	if not state or state.cine.firstRare or state.carry > 0 then
		return
	end
	local def = Config.PETS[info.p]
	if not def or not (Config.tierAtLeast(def.tier, "rareCine") or info.m > 1 or info.s >= 4) then
		return
	end
	begin("firstRare", Config.cineFirstRare(Config.petName(info.p, info.s, info.m), Config.TIERS[def.tier].name, "+" .. Config.fmt(info.inc) .. "/s."), { slot = info.slot }, false)
end)

---------------------------------------------------------------- Plans du CinematicKit : éclosions, château, alerte des gardiens
-- Suivi du danger : dernier coup reçu, dernière alerte de gardien (poursuite). Aucune cinématique à caméra si le joueur est en danger.
local lastHurtAt, lastAlertAt, alertShown, lastAlertFx, lastHatchCine = -100, -100, 0, nil, -100
local function dangerCtx(ignoreTrapRoom)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local inRoom = false
	if root and not ignoreTrapRoom then
		inRoom = Castle.roomAt(root.Position.X, root.Position.Z) ~= nil
	end
	return {
		hp = player:GetAttribute("Hp"), maxHp = player:GetAttribute("MaxHp"), sinceHit = os.clock() - lastHurtAt,
		chased = os.clock() - lastAlertAt < 8, inTrapRoom = inRoom, dead = not (hum and hum.Health > 0),
	}
end

-- Alerte « ❗ » (gardien ou chevalier qui repère le joueur) : aucun mouvement de caméra ; un à-coup de champ de vision, un carton et un peu de tremblement.
local function alertPunch()
	if not Kit.canAlert(dangerCtx(true), os.clock(), lastAlertFx, alertShown) then
		return
	end
	lastAlertFx = os.clock()
	alertShown += 1
	local A = CinematicKitMod.ALERT
	pcall(function()
		local cam = workspace.CurrentCamera
		local baseFov = cam.FieldOfView
		TweenService:Create(cam, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { FieldOfView = baseFov - A.fovPunch }):Play()
		task.delay(0.12, function()
			TweenService:Create(cam, TweenInfo.new(A.seconds - 0.12, Enum.EasingStyle.Sine), { FieldOfView = baseFov }):Play()
		end)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.3)
		label.Size = UDim2.fromOffset(120, 100)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 80, 70)
		label.TextStrokeTransparency = 0.2
		label.Text = A.title
		label.Active = false
		local g = Instance.new("ScreenGui")
		g.Name = "ChipeAlert"
		g.ResetOnSpawn = false
		g.DisplayOrder = 55
		label.Parent = g
		g.Parent = player:WaitForChild("PlayerGui")
		TweenService:Create(label, TweenInfo.new(A.seconds, Enum.EasingStyle.Quint), { TextTransparency = 1, Size = UDim2.fromOffset(180, 150) }):Play()
		Debris:AddItem(g, A.seconds + 0.2)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then -- tremblement léger (décalage de caméra du personnage), remis à zéro quoi qu'il arrive
			task.spawn(function()
				local t0 = os.clock()
				while os.clock() - t0 < A.seconds and hum.Parent do
					local k = (1 - (os.clock() - t0) / A.seconds) * A.shake * 0.25
					hum.CameraOffset = Vector3.new(math.sin(os.clock() * 60) * k, math.cos(os.clock() * 53) * k, 0)
					task.wait()
				end
				hum.CameraOffset = Vector3.zero
			end)
		end
	end)
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(msg, sfx)
	if sfx == "hurt" or sfx == "caught" then
		lastHurtAt = os.clock()
	elseif sfx == "growl" or sfx == "bark" then
		lastAlertAt = os.clock()
		alertPunch()
	elseif sfx == "fanfare" and Config.cineEnabled("chateau") and Kit.canPlay(dangerCtx(true)) then
		begin("chateau_victoire", CinematicKitMod.PLANS.chateau_victoire, {}, false, true)
	elseif sfx == "event" and type(msg) == "string" and msg:find("Le Château", 1, true) and Config.cineEnabled("chateau") and Kit.canPlay(dangerCtx()) then
		begin("chateau_entree", CinematicKitMod.PLANS.chateau_entree, {}, false, true)
	end
end)

-- Éclosion : commun et rare sans cinématique ; épique court ; légendaire, mythique, cosmique et secret complets ; au plus une toutes les 20 s.
Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	local def = Config.PETS[info.p]
	if Config.HATCH_FX and Config.HATCH_FX.Enabled and Config.HATCH_FX.replaceCine then -- lot 10 : l'écran d'éclosion HatchFx remplace ce plan (zoom géré par HatchFx)
		return
	end
	if not def or not Config.cineEnabled("eclosion") or os.clock() - lastHatchCine < 20 or director.isActive() then
		return
	end
	local plan = CinematicKitMod.hatchPlan(def.tier, Config.tierAtLeast(def.tier, "fullCine"))
	if not plan or not Kit.canPlay(dangerCtx()) then
		return
	end
	if begin(plan.id .. "_" .. tostring(def.tier), plan, { slot = info.slot }, false, true) then
		lastHatchCine = os.clock()
	end
end)

-- Montée de niveau de la base : plan court en orbite autour de la base (jamais en danger ; le premier niveau reçu à la connexion ne déclenche rien).
do
	local lastLevel = nil
	local function onLevel()
		local lv = player:GetAttribute("BaseLevel")
		if type(lv) ~= "number" then
			return
		end
		local previous = lastLevel
		lastLevel = lv
		-- caméra large : propriétaire seul (cet attribut est celui du joueur local), sans œuf porté, pas poursuivi, pas de cinématique en cours
		local dctx = dangerCtx()
		if previous and lv > previous and Config.cineEnabled("base") and UpgradeMod.canFrame(true, player:GetAttribute("Carry"), dctx.chased, dctx.dead, director.isActive()) and Kit.canPlay(dctx) then
			begin("base_niveau", CinematicKitMod.PLANS.base_niveau, {}, false, true)
		end
	end
	player:GetAttributeChangedSignal("BaseLevel"):Connect(onLevel)
	onLevel()
end

-- Revoir (menu Plus) : événement local déclenché par l'interface.
local replay = Instance.new("BindableEvent")
replay.Name = "ReplayCinematic"
replay.Parent = ReplicatedStorage
replay.Event:Connect(function(kind)
	if not Config.Cinematics.replay then
		return
	end
	if kind == "intro" then
		if begin("intro", Config.CINE.intro, {}, false) then
			begin("tutorial", Config.CINE.tutorial, {}, true)
		end
	elseif kind == "tutorial" then
		begin("tutorial", Config.CINE.tutorial, {}, false)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX79"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayerScripts/Ambience
-- Ambiance propre à chaque zone : en entrant dans un domaine (ou en revenant à l'arène), l'éclairage, l'atmosphère et la teinte de l'image
-- glissent doucement vers les réglages de Config.LIGHTING (zone de lumière : Config.lightingZoneAt ; modification locale : n'affecte que ce joueur). Coupable avec
-- Config.Animations.zoneAmbience. Une erreur désactive l'ambiance pour la session sans gêner le jeu.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local player = Players.LocalPlayer

local current = nil
local TweenService2 = TweenService

-- Bannière de zone : glisse depuis le haut au passage d'un domaine (ou du retour à l'arène), puis disparaît. Pas au tout premier placement.
local bannerGui = Instance.new("ScreenGui")
bannerGui.Name = "ZoneBanner"
bannerGui.ResetOnSpawn = false
bannerGui.IgnoreGuiInset = false
bannerGui.DisplayOrder = 5
local bannerFrame = Instance.new("Frame")
bannerFrame.AnchorPoint = Vector2.new(0.5, 0)
bannerFrame.Position = UDim2.new(0.5, 0, 0, -120)
bannerFrame.Size = UDim2.fromOffset(340, 74)
bannerFrame.BackgroundColor3 = Color3.fromRGB(20, 40, 30)
bannerFrame.Active = false
bannerFrame.Parent = bannerGui
local bCorner = Instance.new("UICorner")
bCorner.CornerRadius = UDim.new(0, 18)
bCorner.Parent = bannerFrame
local bStroke = Instance.new("UIStroke")
bStroke.Thickness = 4
bStroke.Color = Color3.fromRGB(255, 210, 63)
bStroke.Parent = bannerFrame
local bGrad = Instance.new("UIGradient")
bGrad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(130, 130, 130))
bGrad.Rotation = 90
bGrad.Parent = bannerFrame
local bTitle = Instance.new("TextLabel")
bTitle.BackgroundTransparency = 1
bTitle.Position = UDim2.fromOffset(10, 6)
bTitle.Size = UDim2.new(1, -20, 0, 36)
bTitle.Font = Enum.Font.GothamBlack
bTitle.TextScaled = true
bTitle.TextStrokeTransparency = 0.2
bTitle.Parent = bannerFrame
local bSub = Instance.new("TextLabel")
bSub.BackgroundTransparency = 1
bSub.Position = UDim2.fromOffset(10, 44)
bSub.Size = UDim2.new(1, -20, 0, 24)
bSub.Font = Enum.Font.GothamBold
bSub.TextSize = 13
bSub.TextWrapped = true
bSub.TextColor3 = Color3.fromRGB(225, 240, 230)
bSub.Parent = bannerFrame
bannerGui.Parent = player:WaitForChild("PlayerGui")
local bannerToken = 0

local function showBanner(zone)
	local b = Config.zoneBanner(zone)
	if not b then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bTitle.Text = b.title
	bTitle.TextColor3 = b.color
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local bx, bz = player:GetAttribute("BaseX"), player:GetAttribute("BaseZ")
	local dist = (root and type(bx) == "number" and type(bz) == "number") and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(bx, 0, bz)).Magnitude or nil
	bSub.Text = (dist and Config.zoneLine(zone, dist)) or b.sub
	bStroke.Color = b.color
	TweenService2:Create(bannerFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 70) }):Play()
	task.delay(Config.ZONE_BANNER_SECONDS, function()
		if token == bannerToken then
			TweenService2:Create(bannerFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -120) }):Play()
		end
	end)
end
local failed = false
local L = Config.LIGHTING
local TWEEN = TweenInfo.new(L.transition, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local currentLight = nil

local function c3(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Lot graphismes : l'éclairage vient de Config.LIGHTING (une palette chaude pour toute la carte : hub, parcelles, arène, château) ; la zone de lumière est
-- Config.lightingZoneAt. Atmosphère, bloom léger et étalonnage glissent ensemble (même durée) : jamais de saut de teinte d'une zone à l'autre.
local function apply(zoneName)
	local z = L.zones[zoneName]
	if not z then
		return
	end
	TweenService:Create(Lighting, TWEEN, { ClockTime = z.clock, Ambient = c3(z.ambient), OutdoorAmbient = c3(z.outdoor) }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, TWEEN, { Color = c3(z.atmo), Decay = c3(z.decay), Density = z.density, Haze = z.haze, Glare = z.glare }):Play()
	end
	local grade = Lighting:FindFirstChild("ChipeGrade")
	if grade and grade:IsA("ColorCorrectionEffect") then
		local goal = { TintColor = c3(z.tint), Saturation = z.grade.saturation, Contrast = z.grade.contrast }
		if not grade:GetAttribute("Pulsing") then -- la pulsation d'éclosion (Client) rend sa luminosité d'origine : on n'y touche pas pendant qu'elle joue
			goal.Brightness = z.grade.brightness
		end
		TweenService:Create(grade, TWEEN, goal):Play()
	end
	local bloom = Lighting:FindFirstChild("ChipeBloom")
	if bloom and bloom:IsA("BloomEffect") and not bloom:GetAttribute("Pulsing") then -- pas pendant une pulsation d'éclosion (Client)
		TweenService:Create(bloom, TWEEN, { Intensity = z.bloom.intensity, Size = z.bloom.size, Threshold = z.bloom.threshold }):Play()
	end
end

task.spawn(function()
	while not failed do
		local ok = pcall(function()
			if Config.animEnabled("zoneAmbience") then
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local zoneLight = Config.lightingZoneAt(root.Position.X, root.Position.Z)
					if zoneLight ~= currentLight then
						currentLight = zoneLight
						apply(zoneLight)
					end
					local zone = Config.zoneAt(root.Position.X, root.Position.Z) -- bannière : domaine d'un rival ou retour à l'arène
					if zone ~= current then
						local first = current == nil
						current = zone
						if not first and Config.Animations.zoneBanner then
							showBanner(zone)
						end
					end
				end
			end
		end)
		if not ok then
			failed = true
			warn("[Ambience] désactivée pour cette session après une erreur")
		end
		task.wait(0.5)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX80"><Properties><string name="Name">Culling</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Culling
-- Masque les zones (territoires) éloignées du joueur : au-delà de Config.Culling.cullAt studs du bord d'une zone, ses Parts passent en transparence locale totale
-- (LocalTransparencyModifier = 1) et ses lumières, particules, faisceaux, feux et étiquettes sont coupés ; en dessous de showAt, tout revient. Rien n'est détruit ni
-- déplacé : les collisions et la réplication serveur ne changent pas. Découpé en lots par image, coupé par Config.Culling.enabled = false.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Culling = require(Shared:WaitForChild("Culling"))
if not Config.Culling.enabled then
	return
end
local player = Players.LocalPlayer

local zones = {} -- { x, z, radius, names = { dossiers }, culled, items = nil | { instances }, itemsAt }
for _, key in ipairs(Config.TERR_ORDER) do -- REFONTE (lot 2) : une zone par territoire (Config.TERR), rayon du territoire
	local t = Config.TERR[key]
	zones[#zones + 1] = { x = t.x, z = t.z, radius = t.r, names = { Config.territoryFolder(key) }, culled = false }
end

local SWITCHABLE = { PointLight = true, SpotLight = true, SurfaceLight = true, ParticleEmitter = true, Beam = true, Fire = true, Smoke = true, Sparkles = true, BillboardGui = true, SurfaceGui = true, Highlight = true }

local function collect(zone)
	local world = workspace:FindFirstChild("World")
	local items = {}
	if world then
		for _, name in ipairs(zone.names) do
			local folder = world:FindFirstChild(name)
			if folder then
				for _, d in ipairs(folder:GetDescendants()) do
					if d:IsA("BasePart") or SWITCHABLE[d.ClassName] then
						items[#items + 1] = d
					end
				end
			end
		end
	end
	zone.items, zone.itemsAt = items, os.clock()
	return items
end

-- Applique l'état (masqué ou visible) à tous les éléments d'une zone, lot par lot (jamais plus de Config.Culling.batch par image).
local function apply(zone, hide)
	local items = (zone.items and os.clock() - zone.itemsAt < Config.Culling.refresh) and zone.items or collect(zone)
	for _, lot in ipairs(Culling.chunks(items, Config.Culling.batch)) do
		for _, d in ipairs(lot) do
			pcall(function()
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = hide and 1 or 0
				else
					d.Enabled = not hide
				end
			end)
		end
		task.wait()
	end
end

task.spawn(function()
	while true do
		task.wait(Config.Culling.interval)
		local ok = pcall(function()
			local cam = workspace.CurrentCamera
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local pos = root and root.Position or (cam and cam.CFrame.Position)
			if not pos then
				return
			end
			for _, zone in ipairs(zones) do
				local d = Culling.distanceTo(pos.X, pos.Z, zone)
				local hide = Culling.decide(d, zone.culled, Config.Culling.cullAt, Config.Culling.showAt)
				if hide ~= zone.culled then
					zone.culled = hide
					apply(zone, hide)
				end
			end
		end)
		if not ok then
			warn("[Culling] désactivé pour cette session après une erreur")
			break
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX81"><Properties><string name="Name">LightLod</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/LightLod
-- Niveau de détail des effets (lot graphismes, budget mobile) : au plus Config.GRAPHICS.perf.maxPointLights PointLight de la carte sont allumées (les plus proches de la
-- caméra, à moins de lightRange studs, choix de Graphics.selectLights) ; les émetteurs de particules, faisceaux, feux, fumées et étincelles au-delà de fxCullAt studs sont
-- coupés et rallumés sous fxShowAt (hystérésis de Culling.decide). Rien n'est détruit ni déplacé ; seules les propriétés Enabled changent, et SEULEMENT pour les objets que ce
-- script a lui-même coupés (un effet éteint par le jeu n'est jamais rallumé). Local au joueur. Coupé par Config.GRAPHICS.enabled = false ; une erreur le désactive.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Graphics = require(Shared:WaitForChild("Graphics"))
local Culling = require(Shared:WaitForChild("Culling"))
if not Config.GRAPHICS.enabled then
	return
end
local perf = Config.GRAPHICS.perf

local FX = { ParticleEmitter = true, Beam = true, Fire = true, Smoke = true, Sparkles = true, Trail = true }
local lights, fx = {}, {} -- instances suivies (au plus quelques centaines)
local heldOff = {} -- instance -> true : coupée par ce script
local culled = {} -- instance d'effet -> true : au-delà de fxCullAt
local lastScan = -math.huge

local function position(inst)
	local par = inst.Parent
	while par and not par:IsA("BasePart") and not par:IsA("Attachment") do
		par = par.Parent
	end
	if par and par:IsA("Attachment") then
		return par.WorldPosition
	end
	return par and par.Position or nil
end

local function rescan()
	lastScan = os.clock()
	local world = workspace:FindFirstChild("World")
	lights, fx = {}, {}
	if not world then
		return
	end
	for _, d in ipairs(world:GetDescendants()) do
		if d:IsA("PointLight") then
			lights[#lights + 1] = d
		elseif FX[d.ClassName] then
			fx[#fx + 1] = d
		end
	end
	for inst in pairs(heldOff) do -- objets disparus : on les oublie (pas de fuite)
		if not inst.Parent then
			heldOff[inst] = nil
			culled[inst] = nil
		end
	end
end

local function setEnabled(inst, on)
	if on then
		if heldOff[inst] then
			heldOff[inst] = nil
			inst.Enabled = true
		end
	elseif inst.Enabled then
		heldOff[inst] = true
		inst.Enabled = false
	end
end

task.spawn(function()
	while true do
		task.wait(perf.interval)
		local ok = pcall(function()
			local cam = workspace.CurrentCamera
			if not cam then
				return
			end
			if os.clock() - lastScan > perf.rescan then
				rescan()
			end
			local cp = cam.CFrame.Position
			-- lumières : les plus proches seulement (celles coupées par le jeu sont ignorées, sauf si c'est ce script qui les a coupées)
			local pool, poolPos = {}, {}
			for _, l in ipairs(lights) do
				if l.Parent and (l.Enabled or heldOff[l]) then
					local pos = position(l)
					if pos then
						pool[#pool + 1] = l
						poolPos[#poolPos + 1] = { x = pos.X, y = pos.Y, z = pos.Z }
					end
				end
			end
			local on = Graphics.selectLights(poolPos, { x = cp.X, y = cp.Y, z = cp.Z }, perf.maxPointLights, perf.lightRange)
			for i, l in ipairs(pool) do
				setEnabled(l, on[i])
			end
			-- effets lointains
			for _, e in ipairs(fx) do
				if e.Parent and (e.Enabled or heldOff[e]) then
					local pos = position(e)
					if pos then
						local d = (pos - cp).Magnitude
						local hide = Culling.decide(d, culled[e] == true, perf.fxCullAt, perf.fxShowAt)
						culled[e] = hide or nil
						setEnabled(e, not hide)
					end
				end
			end
		end)
		if not ok then
			warn("[LightLod] désactivé pour cette session après une erreur")
			break
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX82"><Properties><string name="Name">EggAura</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/EggAura (lot graphismes 4 : halos d'œufs et bulles de protection).
-- Applique ReplicatedStorage/EggAura (pur, testé) : chaque œuf taggé « EggAura » par Builder.egg (tapis, portés, posés, nids) reçoit, s'il est parmi les plus
-- proches de la caméra, un halo néon de la couleur de sa rareté (pulsation lente) ; un œuf protégé (attribut ShieldUntil dans le futur : bouclier de base ;
-- attribut Guarded : nid surveillé par un gardien) reçoit en plus une bulle translucide. AUCUNE PointLight (budget de LightLod : <= 4 allumées).
-- Parts locales (jamais répliquées), sans collision ni requête, dans un dossier « EggAuraFx » ; réservoir borné (EggAura.newManager) : pas de fuite.
-- Mobile : plafonds et cadences réduits (EggAura.caps). Coupé par Config.EGG_AURA.enabled = false ; une erreur le désactive proprement.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local EggAura = require(Shared:WaitForChild("EggAura"))

local cfg = EggAura.cfg(Config)
if not cfg.enabled then
	return
end
local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local caps = EggAura.caps(Config, mobile)

local folder = Instance.new("Folder")
folder.Name = "EggAuraFx"
folder.Parent = workspace

local function newPart(kind)
	local p = Instance.new("Part")
	p.Name = kind == "halo" and "EggHaloFx" or "EggBubbleFx"
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Locked = true
	p.Material = kind == "halo" and Enum.Material.Neon or Enum.Material.ForceField
	p.Transparency = 1
	p.Parent = folder
	return p
end

local manager = EggAura.newManager({
	make = newPart,
	hide = function(p)
		p.Transparency = 1
		p.CFrame = CFrame.new(0, -500, 0)
	end,
	destroy = function(p)
		p:Destroy()
	end,
}, math.max(caps.halos, caps.bubbles))

local eggs = {} -- clé -> Part de l'œuf (sélection courante)
local styles = {} -- clé -> style de halo
local phases = {} -- clé -> déphasage
local keyOf = setmetatable({}, { __mode = "k" }) -- Part d'œuf -> clé stable
local nextKey = 0

local function stableKey(egg)
	local k = keyOf[egg]
	if not k then
		nextKey = nextKey + 1
		k = nextKey
		keyOf[egg] = k
	end
	return k
end

local function protectOf(egg)
	if egg:GetAttribute("Guarded") == true then
		return "guard"
	end
	local untilT = egg:GetAttribute("ShieldUntil")
	if type(untilT) == "number" and untilT > workspace:GetServerTimeNow() then
		return "shield"
	end
	return nil
end

local function reselect()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local cp = cam.CFrame.Position
	local items, byKey = {}, {}
	for _, egg in ipairs(CollectionService:GetTagged("EggAura")) do
		if egg:IsA("BasePart") and egg.Name ~= "FlyEgg" and egg:IsDescendantOf(workspace) then
			local tier = egg:GetAttribute("Tier")
			if type(tier) == "number" then
				local key = stableKey(egg)
				local pos = egg.Position
				items[#items + 1] = { key = key, x = pos.X, y = pos.Y, z = pos.Z, tier = tier, protect = protectOf(egg) }
				byKey[key] = egg
			end
		end
	end
	local sel = EggAura.select(items, { x = cp.X, y = cp.Y, z = cp.Z }, caps)
	eggs = byKey
	for _, it in ipairs(sel.halos) do
		if not styles[it.key] or styles[it.key].tier ~= it.tier then
			styles[it.key] = EggAura.halo(Config, it.tier)
			phases[it.key] = (it.key * 1.7) % (2 * math.pi)
		end
	end
	local live = manager.sync(sel)
	for key in pairs(styles) do
		if not live.halo[key] then
			styles[key], phases[key] = nil, nil
		end
	end
	for _, it in ipairs(sel.bubbles) do
		local b = live.bubble[it.key]
		local st = EggAura.bubble(Config, it.protect)
		if b then
			b.Color = Color3.fromRGB(st.color[1], st.color[2], st.color[3])
			b.Transparency = st.transparency
		end
	end
	for key, h in pairs(live.halo) do
		local st = styles[key]
		if st and st.color then
			h.Color = st.color
		end
	end
end

local function place(t)
	local live = manager.live
	for key, h in pairs(live.halo) do
		local egg, st = eggs[key], styles[key]
		if egg and egg.Parent and st then
			local s = egg.Size
			local d = EggAura.diameter(Config, st.tier, math.max(s.X, s.Y, s.Z), "halo")
			h.Size = Vector3.new(d, d, d)
			h.CFrame = egg.CFrame
			h.Transparency = EggAura.alpha(st, t, phases[key])
		else
			h.Transparency = 1
		end
	end
	for key, b in pairs(live.bubble) do
		local egg = eggs[key]
		if egg and egg.Parent then
			local s = egg.Size
			local d = EggAura.diameter(Config, egg:GetAttribute("Tier"), math.max(s.X, s.Y, s.Z), "bubble")
			b.Size = Vector3.new(d, d, d)
			b.CFrame = egg.CFrame
		else
			b.Transparency = 1
		end
	end
end

local lastSel, lastFrame = -math.huge, -math.huge
local conn
conn = RunService.RenderStepped:Connect(function()
	local ok, err = pcall(function()
		local now = os.clock()
		if now - lastSel >= caps.interval then
			lastSel = now
			reselect()
		end
		if now - lastFrame >= caps.frameStep then
			lastFrame = now
			place(now)
		end
	end)
	if not ok then
		warn("[EggAura] désactivé : " .. tostring(err))
		conn:Disconnect()
		manager.clear()
		folder:Destroy()
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX83"><Properties><string name="Name">Music</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Music (graphismes 9 : musique par zone). Applique ReplicatedStorage/Music (pur, testé).
-- Une piste par zone (hub, arène, château) d'après Config.lightingZoneAt, volume bas (Config.MUSIC.volume, plafond 0,3), fondus enchaînés, coupée pendant un combat
-- (panneau ArenaPanel de BattleGui visible : lu, jamais modifié), respect de Config.SOUNDS_ENABLED et du volume général du menu Plus (attribut local MasterVolume
-- posé par Client.client.lua ; 0 = muet). Sans aucune piste approuvée (ids vides), le script s'arrête aussitôt : prêt mais muet, aucun Sound créé.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Music = require(Shared:WaitForChild("Music"))

local cfg = Music.cfg(Config)
if not cfg.enabled or not Music.hasTracks(Config) then
	return -- prêt mais muet : aucune piste fournie (voir BLENDER_REQUESTS.md / A_FAIRE_UTILISATEUR.md « pistes à fournir »)
end
local player = Players.LocalPlayer

local sounds = {}
for _, zone in ipairs(Music.ZONES) do
	local id = cfg.tracks[zone]
	if id then
		local s = Instance.new("Sound")
		s.Name = "Music_" .. zone
		s.SoundId = id
		s.Looped = true
		s.Volume = 0
		s.Parent = SoundService
		sounds[zone] = s
	end
end

local function inBattle()
	local pg = player:FindFirstChild("PlayerGui")
	local bg = pg and pg:FindFirstChild("BattleGui")
	local panel = bg and bg:FindFirstChild("ArenaPanel")
	return panel ~= nil and panel.Visible == true
end

local function currentZone()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or type(Config.lightingZoneAt) ~= "function" then
		return "hub"
	end
	local ok, z = pcall(Config.lightingZoneAt, root.Position.X, root.Position.Z)
	return Music.zoneOf(ok and z or nil)
end

local last = os.clock()
while true do
	task.wait(cfg.interval)
	local ok, err = pcall(function()
		local now = os.clock()
		local dt = now - last
		last = now
		local master = player:GetAttribute("MasterVolume")
		local ctx = { zone = currentZone(), battle = inBattle(), master = type(master) == "number" and master or 1, soundsEnabled = Config.SOUNDS_ENABLED }
		for zone, s in pairs(sounds) do
			local v = Music.step(s.Volume, Music.target(Config, zone, ctx), dt, cfg.fade)
			s.Volume = v
			if v > 0 and not s.IsPlaying then
				s:Play()
			elseif v <= 0 and s.IsPlaying then
				s:Pause()
			end
		end
	end)
	if not ok then
		warn("[Music] arrêtée : " .. tostring(err))
		for _, s in pairs(sounds) do
			s:Destroy()
		end
		break
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX84"><Properties><string name="Name">RevealFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/RevealFx
-- Effet de révélation d'un œuf, 100 % dessiné par le code (Frames, UIGradient, UIStroke, UICorner, TweenService) : étoile lumineuse centrale
-- colorée selon la rareté, halo, rayons qui tournent, anneaux qui s'étendent, étincelles, libellé « ŒUF SECRET ». Aucun asset externe.
-- Le style (nombre de rayons, d'anneaux, de particules) vient de Reveal.style : l'option mobile le réduit. Aucune erreur ne sort d'ici.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local RevealFx = {}

local DURATION = 2.6

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function tween(obj, seconds, goal, style, dir)
	TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end

-- Nombre d'objets créés pour un style (plafond de performance, vérifié par les tests).
function RevealFx.cost(style)
	-- conteneur 1 + halo 3 (Frame, UICorner, UIGradient) + rayons 1 + 2 par rayon + 3 par anneau + étoile 1 + 1 par étincelle + libellé secret
	return 6 + 2 * style.rays + 3 * style.rings + style.particles + ((style.secret and style.label) and 1 or 0) + (style.banner and 5 or 0)
end

-- Joue l'effet au centre (position `center`, UDim2) de `parent` (ScreenGui). Retourne le conteneur (détruit tout seul), ou nil en cas d'erreur.
function RevealFx.play(parent, style, center)
	local ok, root = pcall(function()
		local color = style.color
		local box = make("Frame", {
			Name = "RevealFx", AnchorPoint = Vector2.new(0.5, 0.5), Position = center or UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1, ZIndex = 1, Active = false,
		}, parent)
		-- halo : disque dégradé (opaque au centre, transparent au bord)
		local glow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(60, 60), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 1 }, box)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glow)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.85) }), Rotation = 90 }, glow)
		tween(glow, 0.5, { Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 0.7 }, Enum.EasingStyle.Back)
		tween(glow, DURATION, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		-- rayons : conteneur tournant
		local spin = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = 2 }, box)
		for i = 1, style.rays do
			local ray = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(i % 2 == 0 and 7 or 4, i % 2 == 0 and 250 or 190),
				BackgroundColor3 = color, BackgroundTransparency = 0.15, Rotation = (i - 1) * 360 / style.rays, ZIndex = 2,
			}, spin)
			make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Rotation = 90 }, ray)
		end
		spin.Rotation = -20
		tween(spin, DURATION, { Rotation = 70 }, Enum.EasingStyle.Sine)
		-- anneaux
		for i = 1, style.rings do
			local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1, ZIndex = 3 }, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
			local stroke = make("UIStroke", { Color = color, Thickness = 5, Transparency = 0.1 }, ring)
			task.delay((i - 1) * 0.18, function()
				pcall(function()
					tween(ring, 0.9, { Size = UDim2.fromOffset(240 + i * 70, 240 + i * 70) }, Enum.EasingStyle.Quint)
					tween(stroke, 0.9, { Transparency = 1, Thickness = 1 })
				end)
			end)
		end
		-- étoile centrale : « ★ » avec contour sombre épais et reflet
		local star = make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, Text = "★", TextScaled = true, Font = Enum.Font.GothamBold,
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(30, 20, 40), ZIndex = 5, Rotation = -30,
		}, box)
		tween(star, 0.55, { Size = UDim2.fromOffset(150, 150), Rotation = 0 }, Enum.EasingStyle.Elastic)
		task.delay(DURATION - 0.7, function()
			pcall(function()
				tween(star, 0.7, { Size = UDim2.fromOffset(40, 40), TextTransparency = 1, TextStrokeTransparency = 1 })
			end)
		end)
		-- étincelles lancées dans toutes les directions
		for i = 1, style.particles do
			local a = (i / style.particles) * math.pi * 2 + (i % 3) * 0.3
			local dist = 150 + (i % 5) * 38
			local spark = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = i % 2 == 0 and "✦" or "✨",
				TextScaled = true, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3), Font = Enum.Font.GothamBold, ZIndex = 4,
			}, box)
			tween(spark, 0.9 + (i % 4) * 0.15, { Position = UDim2.fromOffset(math.cos(a) * dist, math.sin(a) * dist), TextTransparency = 1 })
		end
		if style.banner then -- bandeau de rareté coloré (commun jaune, rare vert, épique violet, légendaire rouge, mythique cyan, secret arc-en-ciel)
			local cols = style.banner.colors
			local keys = {}
			for i, c in ipairs(cols) do
				keys[i] = ColorSequenceKeypoint.new((i - 1) / math.max(#cols - 1, 1), c)
			end
			local band = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 120), Size = UDim2.fromOffset(40, 34), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 4 }, box)
			make("UICorner", { CornerRadius = UDim.new(0, 12) }, band)
			make("UIStroke", { Color = Color3.fromRGB(24, 16, 30), Thickness = 4 }, band)
			make("UIGradient", { Color = ColorSequence.new(keys), Rotation = #cols > 2 and 0 or 90 }, band)
			local bt = make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = style.banner.name, Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(24, 16, 30), ZIndex = 5 }, band)
			bt.Name = "BannerText"
			tween(band, 0.5, { Size = UDim2.fromOffset(250, 34) }, Enum.EasingStyle.Back)
		end
		if style.secret and style.label then
			make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, -150), Size = UDim2.fromOffset(360, 36), BackgroundTransparency = 1, Text = style.label,
				TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = color, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(50, 10, 0), ZIndex = 6,
			}, box)
		end
		Debris:AddItem(box, DURATION + 0.6)
		return box
	end)
	return ok and root or nil
end

return RevealFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX85"><Properties><string name="Name">SlotFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/SlotFx
-- Écran de tirage « machine à sous » (rareté / taille / mutation) avant la révélation d'un œuf : 3 colonnes qui défilent comme des rouleaux, ralentissent et
-- s'arrêtent une à une (secousse et étincelles à chaque arrêt), bannière « SECRET ! » sur un tirage secret, phénix lumineux avec cercle runique dès le
-- palier Légendaire. 100 % dessiné par le code ; le plan (positions, arrêts) vient de Reveal.slotPlan et le résultat affiché est TOUJOURS le tirage réel.
-- opts.slotPos = Reveal.slotPos (injecté). Un tap passe l'animation. `onDone` est appelé exactement une fois (fin, passage ou erreur). Aucune erreur ne sort d'ici.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local SlotFx = {}

local FONT = Enum.Font.GothamBold
local RUNES = { "ᚠ", "ᚢ", "ᚦ", "ᚨ", "ᚱ", "ᚲ", "ᚷ", "ᚹ" }

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function tween(obj, seconds, goal, style, dir)
	TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end

-- Nombre d'objets créés AVANT le début de l'animation (hors étincelles, bannière et phénix, créés à l'arrêt).
SlotFx.STATIC_COST = 3 + 1 + 3 * 11 -- conteneur + coins + contour, titre, 3 colonnes (cadre, coins, contour, titre, 5 cases, fenêtre, contour)

-- Joue l'écran au centre de `parent` (ScreenGui). opts : secret (bool), onDone (fonction). Retourne le conteneur ou nil.
function SlotFx.play(parent, plan, cell, opts)
	opts = opts or {}
	local finished = false
	local conn, root
	local function finish()
		if finished then
			return
		end
		finished = true
		if conn then
			pcall(function()
				conn:Disconnect()
			end)
		end
		if root then
			pcall(function()
				tween(root, 0.18, { BackgroundTransparency = 1 })
				Debris:AddItem(root, 0.3)
			end)
		end
		if opts.onDone then
			pcall(opts.onDone)
		end
	end
	local ok = pcall(function()
		local CH = cell or 34
		local W = 128
		root = make("TextButton", {
			Name = "SlotFx", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(3 * W + 4 * 12, 3 * CH + 70),
			BackgroundColor3 = Color3.fromRGB(24, 18, 40), BackgroundTransparency = 0.05, Text = "", AutoButtonColor = false, ZIndex = 40,
		}, parent)
		make("UICorner", { CornerRadius = UDim.new(0, 18) }, root)
		make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 4 }, root)
		make("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 26), Text = "🎰 TIRAGE EN COURS… (touche pour passer)", Font = FONT, TextSize = 14,
			TextColor3 = Color3.fromRGB(255, 232, 150), ZIndex = 41,
		}, root)
		local cols = {}
		for k, col in ipairs(plan.columns) do
			local frame = make("Frame", {
				Position = UDim2.fromOffset(12 + (k - 1) * (W + 12), 56), Size = UDim2.fromOffset(W, 3 * CH), BackgroundColor3 = Color3.fromRGB(12, 10, 24), ClipsDescendants = true, ZIndex = 41,
			}, root)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
			make("UIStroke", { Color = Color3.fromRGB(90, 80, 130), Thickness = 2 }, frame)
			make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12 + (k - 1) * (W + 12), 32), Size = UDim2.fromOffset(W, 20), Text = col.title, Font = FONT, TextSize = 14, TextColor3 = Color3.fromRGB(180, 170, 220), ZIndex = 41 }, root)
			local labels = {}
			for j = -2, 2 do
				labels[j] = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, CH), Position = UDim2.new(0.5, 0, 0, CH * 1.5), Text = "", Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), ZIndex = 42 }, frame)
			end
			local win = make("Frame", { Position = UDim2.fromOffset(0, CH), Size = UDim2.new(1, 0, 0, CH), BackgroundTransparency = 1, ZIndex = 43 }, frame)
			make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 2 }, win)
			cols[k] = { col = col, frame = frame, labels = labels, stopped = false, W = W, CH = CH }
		end
		local t0 = os.clock()
		local reduced = opts.reduced == true
		local function burst(k, color)
			local cx = 12 + (k - 1) * (W + 12) + W / 2
			for i = 1, (reduced and 3 or 6) do
				local spark = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, 56 + CH * 1.5), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = i % 2 == 0 and "✦" or "✨", TextScaled = true, TextColor3 = color, ZIndex = 45 }, root)
				local a = i / 6 * math.pi * 2
				tween(spark, 0.6, { Position = UDim2.fromOffset(cx + math.cos(a) * 60, 56 + CH * 1.5 + math.sin(a) * 50), TextTransparency = 1 })
				Debris:AddItem(spark, 0.7)
			end
			-- secousse du bloc à chaque arrêt
			local base = root.Position
			for s = 1, 4 do
				task.delay(s * 0.04, function()
					pcall(function()
						root.Position = s == 4 and base or UDim2.new(base.X.Scale, base.X.Offset + (s % 2 == 0 and 5 or -5), base.Y.Scale, base.Y.Offset)
					end)
				end)
			end
		end
		local ended = false
		local function ending()
			if ended then
				return
			end
			ended = true
			local tcol = plan.columns[1].symbols[plan.columns[1].final].color or Color3.new(1, 1, 1)
			if opts.secret then
				local ban = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(60, 20), BackgroundTransparency = 1, Text = "SECRET !", Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.fromRGB(255, 70, 20), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(50, 10, 0), ZIndex = 50 }, root)
				tween(ban, 0.45, { Size = UDim2.fromOffset(330, 80) }, Enum.EasingStyle.Back)
			end
			if plan.phoenix then
				local glow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = tcol, BackgroundTransparency = 0.3, ZIndex = 44 }, root)
				make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glow)
				make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.9) }), Rotation = 90 }, glow)
				tween(glow, 0.7, { Size = UDim2.fromOffset(360, 360), BackgroundTransparency = 0.85 }, Enum.EasingStyle.Quint)
				local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(240, 240), BackgroundTransparency = 1, ZIndex = 46 }, root)
				for i, r in ipairs(RUNES) do
					local a = (i - 1) / #RUNES * math.pi * 2
					make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.cos(a) * 110, 0.5, math.sin(a) * 110), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, Text = r, Font = FONT, TextScaled = true, TextColor3 = tcol, ZIndex = 46, Rotation = math.deg(a) + 90 }, ring)
				end
				tween(ring, plan.hold + 0.6, { Rotation = 120 }, Enum.EasingStyle.Sine)
				for _, side in ipairs({ -1, 1 }) do
					local wing = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "🪽", TextScaled = true, ZIndex = 47 }, root)
					tween(wing, 0.7, { Position = UDim2.new(0.5, side * 150, 0.5, -20), Size = UDim2.fromOffset(90, 90) }, Enum.EasingStyle.Back)
				end
				local bird = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "🔥", TextScaled = true, ZIndex = 48 }, root)
				tween(bird, 0.6, { Size = UDim2.fromOffset(110, 110) }, Enum.EasingStyle.Elastic)
				Debris:AddItem(glow, plan.hold + 0.7)
				Debris:AddItem(ring, plan.hold + 0.7)
			end
			task.delay(plan.hold, finish)
		end
		conn = RunService.Heartbeat:Connect(function()
			if finished then
				return
			end
			local ok2 = pcall(function()
				local t = os.clock() - t0
				local allStopped = true
				for k, c in ipairs(cols) do
					local col = c.col
					local pos = opts.slotPos(col, t)
					local n = #col.symbols
					local base = math.floor(pos + 0.5)
					local frac = pos - base
					for j = -2, 2 do
						local sym = col.symbols[(base + j - 1) % n + 1]
						local lab = c.labels[j]
						lab.Text = sym.text
						lab.TextColor3 = sym.color or Color3.new(1, 1, 1)
						lab.Position = UDim2.new(0.5, 0, 0, c.CH * (1.5 + j - frac))
						lab.TextTransparency = j == 0 and 0 or 0.45
					end
					if t >= col.stop then
						if not c.stopped then
							c.stopped = true
							if opts.onStop then
								pcall(opts.onStop, k) -- son à chaque rouleau qui s'arrête
							end
							burst(k, col.symbols[col.final].color or Color3.new(1, 1, 1))
						end
					else
						allStopped = false
					end
				end
				if allStopped then
					ending()
				end
			end)
			if not ok2 then
				finish()
			end
		end)
		root.Activated:Connect(finish)
		task.delay(plan.duration + 1.5, finish) -- garde-fou : jamais bloqué
	end)
	if not ok then
		finish()
		return nil
	end
	return root
end

return SlotFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX86"><Properties><string name="Name">MiniMapUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/MiniMapUi
-- Mini-carte ronde dessinée par le code : un cadre, des pastilles réutilisées (au plus Config.MINIMAP.maxDots, jamais créées en cours de route), mise à jour
-- Config.MINIMAP.hz fois par seconde. Points : toi (centre), ta base, les zones (grisées si verrouillées), les portails de voyage rapide, les gardiens proches.
-- Bouton 🗺 pour l'afficher ou la masquer. Tout sous pcall.
local MiniMapUi = {}

function MiniMapUi.start(Config, MiniMap, player, gui, getState, UserInputService, RunService)
	local C = Config.MINIMAP
	if not C.enabled then
		return nil
	end
	local ok, objs = pcall(function()
		local cam = workspace.CurrentCamera
		local small = cam ~= nil and cam.ViewportSize.X < 500
		local size = small and C.sizeSmall or C.size
		local half = size / 2
		local btn = Instance.new("TextButton")
		btn.Name = "MiniMapToggle"
		btn.AnchorPoint = Vector2.new(1, 0)
		btn.Position = UDim2.new(1, -8, 0.3, 0)
		btn.Size = UDim2.fromOffset(34, 34)
		btn.Text = "🗺"
		btn.TextSize = 18
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(30, 36, 48)
		btn.BackgroundTransparency = 0.2
		btn.TextColor3 = Color3.new(1, 1, 1)
		btn.Parent = gui
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0.5, 0)
		bc.Parent = btn
		local frame = Instance.new("Frame")
		frame.Name = "MiniMap"
		frame.AnchorPoint = Vector2.new(1, 0)
		frame.Position = UDim2.new(1, -8, 0.3, 40)
		frame.Size = UDim2.fromOffset(size, size)
		frame.BackgroundColor3 = Color3.fromRGB(34, 60, 44)
		frame.BackgroundTransparency = 0.25
		frame.ClipsDescendants = true
		frame.Parent = gui
		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(0.5, 0)
		fc.Parent = frame
		local fs = Instance.new("UIStroke")
		fs.Color = Color3.fromRGB(255, 232, 150)
		fs.Thickness = 2
		fs.Parent = frame
		local dots = {}
		for i = 1, C.maxDots do
			local d = Instance.new("TextLabel")
			d.AnchorPoint = Vector2.new(0.5, 0.5)
			d.BackgroundTransparency = 1
			d.Size = UDim2.fromOffset(16, 16)
			d.TextSize = 14
			d.Font = Enum.Font.GothamBold
			d.Text = ""
			d.Visible = false
			d.Parent = frame
			dots[i] = d
		end
		local me = Instance.new("TextLabel")
		me.AnchorPoint = Vector2.new(0.5, 0.5)
		me.Position = UDim2.fromOffset(half, half)
		me.BackgroundTransparency = 1
		me.Size = UDim2.fromOffset(18, 18)
		me.TextSize = 16
		me.Text = "🔹"
		me.Parent = frame
		return { btn = btn, frame = frame, dots = dots, half = half }
	end)
	if not ok then
		return nil
	end
	local visible = true
	objs.btn.Activated:Connect(function()
		visible = not visible
		objs.frame.Visible = visible
	end)
	pcall(function()
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.M then
				visible = not visible
				objs.frame.Visible = visible
			end
		end)
	end)
	local guardCache, cacheAt = {}, -99
	task.spawn(function()
		while true do
			task.wait(1 / math.max(1, C.hz))
			pcall(function()
				if not visible then
					return
				end
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local state = getState()
				if not root or not state then
					return
				end
				local px, pz = root.Position.X, root.Position.Z
				local plot = player:GetAttribute("PlotCF")
				local pts = MiniMap.landmarks(Config, typeof(plot) == "CFrame" and plot.Position.X or nil, typeof(plot) == "CFrame" and plot.Position.Z or nil, state.story and state.story.ch)
				if type(state.hen) == "table" and MiniMap.featherMarks then -- plumes non ramassées à moins de 90 studs (🪶)
					for _, mk in ipairs(MiniMap.featherMarks(state.hen.spots, px, pz, Config.HEN.markerRange)) do
						pts[#pts + 1] = mk
					end
				end
				if os.clock() - cacheAt > 2 then -- gardiens : liste relue toutes les 2 s seulement
					cacheAt = os.clock()
					guardCache = {}
					local w = workspace:FindFirstChild("World")
					if w then
						for _, d in ipairs(w:GetDescendants()) do
							if d:IsA("Model") and d.Name:match("^Guard%d+_%d+$") then
								guardCache[#guardCache + 1] = d
							end
						end
					end
				end
				for _, g in ipairs(guardCache) do
					local ok2, cf = pcall(function()
						return g:GetPivot()
					end)
					if ok2 and cf then
						local dx, dz = cf.Position.X - px, cf.Position.Z - pz
						if dx * dx + dz * dz <= C.guardRange * C.guardRange then
							pts[#pts + 1] = { kind = "guard", x = cf.Position.X, z = cf.Position.Z, label = "🔴" }
						end
					end
				end
				local used = 0
				for _, p in ipairs(pts) do
					if used >= #objs.dots then
						break
					end
					local u, v = MiniMap.place(px, pz, p.x, p.z, C.radius, objs.half - 8, p.kind ~= "guard")
					if u then
						used = used + 1
						local d = objs.dots[used]
						d.Visible = true
						d.Position = UDim2.fromOffset(objs.half + u, objs.half + v)
						d.Text = p.label
						d.TextTransparency = p.locked and 0.6 or 0
					end
				end
				for i = used + 1, #objs.dots do
					objs.dots[i].Visible = false
				end
			end)
		end
	end)
	return objs
end

return MiniMapUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX87"><Properties><string name="Name">BattleUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/BattleUi
-- Arène des pets (PvE) : écran d'équipe (3 pets de la collection, type affiché), choix de l'étage de la tour, écran de combat (barres de PV, icônes de type,
-- flèche d'avantage, journal court, minuteur de tour), écran de résultat avec récompenses. 100 % code. Le client N'ENVOIE QU'UNE INTENTION par tour
-- (« attack », « skill », « swapN ») : tout le résultat vient du serveur (événements rejoués ici). Aucune erreur ne sort d'ici.
local BattleUi = {}

local TweenService = game:GetService("TweenService")
local FONT = Enum.Font.GothamBold

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function label(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.TextSize = props.TextSize or 14
	return make("TextLabel", props, parent)
end

local function button(parent, props)
	props.Font = FONT
	props.TextSize = props.TextSize or 14
	props.TextColor3 = props.TextColor3 or Color3.fromRGB(10, 30, 15)
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(91, 227, 125)
	props.AutoButtonColor = true
	local b = make("TextButton", props, parent)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
	make("UIStroke", { Color = Color3.fromRGB(20, 80, 40), Thickness = 2 }, b)
	return b
end

-- Avantage de type de MON pet actif sur l'adversaire : « ⬆ » (x1,5), « ⬇ » (x0,67) ou « ➡ ».
function BattleUi.advantage(Battle, myType, foeType)
	local m = Battle.typeMul(myType, foeType)
	return m > 1 and "⬆ avantage" or (m < 1 and "⬇ désavantage" or "➡ neutre")
end

-- LOT 12 B : état du bouton Spécial et pastilles de charge. `u.charge` (0..max) vient du moteur du lot 12 (Battle.CHARGE_MAX, 5 par défaut) ; si le moteur est
-- encore celui du lot 8 (pas de `charge`), on retombe sur la recharge `cd` : l'écran reste correct dans les deux cas. Pur (testé).
function BattleUi.specialState(Config, Battle, u)
	local sk = Battle.SKILLS and Battle.SKILLS[u.skill] or { name = "Spécial" }
	local name = (Config.TYPE_SPECIAL_NAME and Config.TYPE_SPECIAL_NAME[u.type]) or (Battle.SPECIAL_NAME and Battle.SPECIAL_NAME[u.type]) or sk.name or "Spécial" -- FUSION 12A : nom du spécial par type (Battle.SPECIAL_NAME)
	if type(u.charge) == "number" then
		local max = Battle.CHARGE_MAX or 5
		local c = math.max(0, math.min(max, math.floor(u.charge)))
		local ready = c >= max and not (type(u.stun) == "number" and u.stun > 0)
		return { charge = c, max = max, ready = ready, text = (c >= max) and ("✨ " .. name) or ("Spécial " .. c .. "/" .. max) }
	end
	local cd = type(u.cd) == "number" and u.cd or 0
	return { charge = nil, max = 0, ready = cd == 0, text = cd > 0 and (name .. " (" .. cd .. ")") or ("✨ " .. name) }
end

-- Texte d'efficacité (B.6), repli local si le module TypeFx de données n'est pas fourni : texte, couleur RGB ; nil si neutre.
BattleUi.EFFICACY = {
	{ min = 1.5, text = "Super efficace !", rgb = { 70, 220, 90 } },
	{ min = 1.2, text = "Efficace", rgb = { 150, 230, 120 } },
	{ max = 0.7, text = "Pas très efficace…", rgb = { 230, 70, 70 } },
	{ max = 0.95, text = "Peu efficace", rgb = { 255, 160, 50 } },
}
function BattleUi.efficacy(mult)
	if type(mult) ~= "number" or mult ~= mult or mult <= 0 then
		return nil
	end
	for _, e in ipairs(BattleUi.EFFICACY) do
		if (e.min ~= nil and mult >= e.min - 1e-9) or (e.max ~= nil and mult <= e.max + 1e-9) then
			return e.text, e.rgb
		end
	end
	return nil
end

-- REFONTE DU COMBAT (vue face à face) : si `fx.BattleScene` et `fx.BattleLayout` sont fournis (et `Config.BATTLE_FX.scene ~= false`), le combat s'affiche dans une scène
-- plein écran (BattleScene : créatures sur socles lumineux, carte adverse en haut à droite, carte du joueur en bas à gauche, journal et boutons en bas) ; sinon, ou si la
-- construction échoue, l'ancien panneau compact (lot 8) est utilisé tel quel. Remotes, payloads et protocole inchangés : ce module n'envoie que les mêmes intentions.
-- Lot 10 : `fx` (optionnel) = { Odds, IntroPlan, BattleIntro, TypeFx (client), TypeFxData (données), sound = fn(clé), reduced = mobile, iconUrl = fn(clé) -> url|nil }.
-- Intro avant le premier tour (BattleIntro, passable), effet par type à chaque attaque (spécial pour une compétence ou tous les `specialEvery` coups), texte
-- d'efficacité flottant, sons battle_start / atk_<type> / special_hit / special_ready / battle_win / battle_lose. Sans `fx` : écran du lot 8 inchangé.
function BattleUi.start(Config, Battle, player, gui, getState, fire, RBattle, fx)
	local TW = Config.TOWER
	local ok, ui = pcall(function()
		local open = button(gui, { Name = "ArenaButton", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0.3, -42), Size = UDim2.fromOffset(34, 34), Text = "⚔️", BackgroundColor3 = Color3.fromRGB(255, 159, 28) })
		local panel = make("Frame", { Name = "ArenaPanel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -16, 0, 330), BackgroundColor3 = Color3.fromRGB(28, 26, 44), Visible = false, ZIndex = 30 }, gui)
		make("UISizeConstraint", { MaxSize = Vector2.new(360, 330) }, panel) -- 360 px au plus, jamais plus large que l'écran (téléphone de 360 px : 8 px de marge de chaque côté)
		make("UICorner", { CornerRadius = UDim.new(0, 16) }, panel)
		make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 3 }, panel)
		local title = label(panel, { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -60, 0, 26), TextSize = 18, Text = "⚔️ Arène des pets", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31 })
		local close = button(panel, { Position = UDim2.new(1, -40, 0, 6), Size = UDim2.fromOffset(30, 26), Text = "✕", BackgroundColor3 = Color3.fromRGB(255, 99, 99), ZIndex = 32 })
		local info = label(panel, { Position = UDim2.fromOffset(10, 34), Size = UDim2.new(1, -20, 0, 36), TextSize = 14, TextWrapped = true, Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 31 })
		local body = make("Frame", { Position = UDim2.fromOffset(10, 74), Size = UDim2.new(1, -20, 1, -84), BackgroundTransparency = 1, ZIndex = 31 }, panel)
		return { open = open, panel = panel, title = title, close = close, info = info, body = body }
	end)
	if not ok then
		return nil
	end
	local floor, team, mode = 1, {}, "team"
	local FX = { on = type(fx) == "table" and Config.BATTLE_FX ~= nil and Config.BATTLE_FX.Enabled == true, hits = { 0, 0 } }
	function FX.sound(key)
		if type(fx) == "table" and type(fx.sound) == "function" and key then
			pcall(fx.sound, key)
		end
	end
	function FX.icon(parent, key, x, y, size)
		local url = type(fx) == "table" and type(fx.iconUrl) == "function" and fx.iconUrl(key) or nil
		if url then
			return make("ImageLabel", { BackgroundTransparency = 1, Image = url, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), ZIndex = 34 }, parent)
		end
		return nil
	end
	local view, seconds, deadline, foeName, lastFloor = nil, 0, 0, "", 1
	local pick, pickDeadline, pickSent, lastReady = nil, 0, false, false -- lot 12 B : écran de choix des 3 cartes (D.5)
	local logLines = {}
	local widgets = {}
	local DU = { on = false, cam = nil, ask = nil, watch = nil, watchAt = 0, chosen = false } -- lot 13 : duel local (caméra, demande reçue, bandeau des spectateurs)
	local LV = { queued = false, note = nil } -- lot 14 : classé en direct (file d'attente ; fermée = le serveur lance directement le classé enregistré)
	-- Réglages locaux du combat (durée de la session : vitesse 1x / 2x / 3x, nombre de combats déjà vus pour proposer « Passer l'animation » dès le 2e). `fx.prefs`
	-- (table facultative fournie par le client) les conserve entre deux écrans ; rien n'est envoyé au serveur.
	local PREFS = type(fx) == "table" and type(fx.prefs) == "table" and fx.prefs or {}
	PREFS.speed, PREFS.seen = PREFS.speed or 1, PREFS.seen or 0
	local SC = { scene = nil, delay = 0, events = nil } -- refonte : scène face à face (nil = ancien panneau compact)
	local function clear()
		for _, w in ipairs(widgets) do
			pcall(function()
				w:Destroy()
			end)
		end
		widgets = {}
	end
	local function add(w)
		widgets[#widgets + 1] = w
		return w
	end
	local render

	local function unitText(u)
		local def = Config.PETS[u.p]
		return (Battle.TYPE_EMOJI[u.type] or "") .. " " .. def.emoji .. " " .. def.name
	end

	-- Lot 10 : intro de combat (plan pur IntroPlan, exécuté par BattleIntro) ; sans module : son de début seulement.
	function FX.intro(p)
		if not (FX.on and Config.BATTLE_FX.intro and fx.IntroPlan and fx.BattleIntro and type(p.view) == "table") then
			FX.sound("battle_start")
			return
		end
		local st = getState()
		local pv = (st and st.battle and st.battle.pvp) or {}
		local function pets(sd)
			local out = {}
			for _, u in ipairs(sd.units or {}) do
				local def = Config.PETS[u.p]
				out[#out + 1] = { type = u.type, odds = fx.Odds and fx.Odds.forPet(Config, u.p, u.s, u.m) or nil, tier = def and def.tier or nil }
			end
			return out
		end
		local me, foe = p.view.sides[1], p.view.sides[2]
		local mu, fu = me.units[me.active], foe.units[foe.active]
		local meInfo = { name = player.DisplayName, userId = player.UserId, wins = pv.wins, losses = pv.losses, trophies = pv.trophies, league = st and st.battle and st.battle.league or nil, pets = pets(me) }
		local foeInfo = { name = p.foe, pets = pets(foe) }
		if p.duel and type(p.intro) == "table" and type(p.intro.me) == "table" and type(p.intro.foe) == "table" then -- lot 13 (B.4) : ratios de duel, ligues et trophées envoyés par le serveur
			meInfo = { name = p.intro.me.name, userId = p.intro.me.userId, wins = p.intro.me.wins, losses = p.intro.me.losses, trophies = p.intro.me.trophies, league = p.intro.me.league, pets = pets(me) }
			foeInfo = { name = p.intro.foe.name, userId = p.intro.foe.userId, wins = p.intro.foe.wins, losses = p.intro.foe.losses, trophies = p.intro.foe.trophies, league = p.intro.foe.league, pets = pets(foe) }
		end
		local plan = fx.IntroPlan.plan({
			mode = p.duel and "duel" or (p.pvp and "pvp" or (p.npc and "npc" or "tower")), countdown = false, advantage = (mu and fu) and Battle.typeMul(mu.type, fu.type) or 1,
			me = meInfo, foe = foeInfo,
		}, { fmtOdds = fx.Odds and fx.Odds.label or nil })
		fx.BattleIntro.play(gui, plan, {
			thumbnail = function(uid)
				return "rbxthumb://type=AvatarHeadShot&id=" .. tostring(uid) .. "&w=150&h=150"
			end,
			sound = function()
				FX.sound("battle_start")
			end,
		})
	end

	-- Lot 10 : effets d'attaque par type pour les coups d'un tour (décalés de 0,6 s), texte d'efficacité sur la cible.
	function FX.hits(events)
		if not (FX.on and Config.BATTLE_FX.typeFx and fx.TypeFx and fx.TypeFxData) then
			return
		end
		local k = 0
		for _, ev in ipairs(events or {}) do
			if type(ev) == "table" and ev.t == "hit" and (ev.side == 1 or ev.side == 2) then
				FX.hits[ev.side] = FX.hits[ev.side] + 1
				local special = ev.special == true -- FUSION 12A : le spécial est porté par l'événement du moteur (charge 5/5), plus un coup sur 5
				local typ = Battle.SPECIES_TYPE[ev.p]
				local data = fx.TypeFxData.get(typ)
				local readySoon = ev.side == 1 and ev.charge == 4 -- FUSION 12A : prêt au prochain coup
				local mul = ev.mul
				task.delay(0.6 * k, function()
					pcall(function()
						local mine, theirs, shakeFrame
						if SC.scene then -- scène face à face : positions projetées au-dessus des deux créatures
							local mx, my = SC.scene.anchor(1)
							local tx, ty = SC.scene.anchor(2)
							mine, theirs, shakeFrame = Vector2.new(mx, my), Vector2.new(tx, ty), SC.scene.shake
						else
							local ap, sz = ui.panel.AbsolutePosition, ui.panel.AbsoluteSize
							local bodyY = ap.Y + 74
							mine = Vector2.new(ap.X + sz.X * 0.25, bodyY + 50)
							theirs = Vector2.new(ap.X + sz.X * 0.75, bodyY + 10)
							shakeFrame = ui.panel
						end
						local from, to = mine, theirs
						if ev.side == 2 then
							from, to = theirs, mine
						end
						fx.TypeFx.play(gui, data, special, {
							from = from, to = to, reduced = fx.reduced == true, shakeFrame = shakeFrame,
							sound = function(key)
								FX.sound(key == "special" and "special_hit" or Config.ATK_SOUND[typ])
							end,
						})
						local text, rgb = fx.TypeFxData.efficacy(mul)
						if text and not SC.scene then -- en scène face à face, le message de type est affiché par la scène (avant le nombre)
							fx.TypeFx.floatText(gui, text, rgb, to.X, to.Y - 28)
						end
						if readySoon and not SC.scene then -- en scène face à face, le flash du bouton Spécial joue « special_ready » quand la charge est pleine
							FX.sound("special_ready")
						end
					end)
				end)
				k = k + 1
			end
		end
	end

	local function renderTeam()
		local st = getState()
		local b = st and st.battle or { team = {}, best = 0, fightsLeft = TW.dailyFights, repeatsLeft = TW.dailyRepeats }
		if #team == 0 then
			for _, v in ipairs(b.team or {}) do
				team[#team + 1] = v
			end
		end
		floor = math.min(math.max(1, floor), math.min(TW.floors, b.best + 1))
		ui.title.Text = "⚔️ Tour des Dresseurs"
		ui.info.Text = "Meilleur étage : " .. b.best .. "/" .. TW.floors .. " · combats restants aujourd'hui : " .. b.fightsLeft .. "\nChoisis jusqu'à " .. TW.teamSize .. " pets (touche pour ajouter / retirer)."
		local y = 0
		local n = 0
		for i = 1, Config.SLOTS_MAX do
			local sl = st and st.slots and st.slots[i]
			if sl and sl.k == "p" then
				n = n + 1
				local col = (n - 1) % 2
				local row = (n - 1) // 2
				local selected = false
				for _, v in ipairs(team) do
					if v == i then
						selected = true
					end
				end
				local def = Config.PETS[sl.p]
				local btn = add(button(ui.body, { Position = UDim2.new(col * 0.5, col * 4, 0, row * 28), Size = UDim2.new(0.5, -4, 0, 26), Text = (selected and "✅ " or "") .. Battle.TYPE_EMOJI[Battle.SPECIES_TYPE[sl.p]] .. " " .. def.emoji .. " " .. def.name, TextSize = 14, BackgroundColor3 = selected and Color3.fromRGB(255, 210, 63) or Color3.fromRGB(70, 74, 110), TextColor3 = selected and Color3.fromRGB(40, 30, 0) or Color3.new(1, 1, 1), ZIndex = 32 }))
				btn.Activated:Connect(function()
					local at
					for k, v in ipairs(team) do
						if v == i then
							at = k
						end
					end
					if at then
						table.remove(team, at)
					elseif #team < TW.teamSize then
						team[#team + 1] = i
					end
					fire("setTeam", team)
					render()
				end)
				y = math.max(y, row * 28 + 28)
			end
		end
		if n == 0 then
			add(label(ui.body, { Size = UDim2.new(1, 0, 0, 40), Text = "Fais d'abord éclore des pets !", ZIndex = 32 }))
		end
		local prev = add(button(ui.body, { Position = UDim2.new(0, 0, 1, -34), Size = UDim2.fromOffset(34, 30), Text = "‹", ZIndex = 32 }))
		local nxt = add(button(ui.body, { Position = UDim2.new(0, 130, 1, -34), Size = UDim2.fromOffset(34, 30), Text = "›", ZIndex = 32 }))
		add(label(ui.body, { Position = UDim2.new(0, 36, 1, -34), Size = UDim2.fromOffset(94, 30), Text = "Étage " .. floor .. (TW.bosses[floor] and " 👑" or ""), ZIndex = 32 }))
		prev.Activated:Connect(function()
			floor = math.max(1, floor - 1)
			render()
		end)
		nxt.Activated:Connect(function()
			floor = math.min(math.min(TW.floors, b.best + 1), floor + 1)
			render()
		end)
		local pv = b.pvp or { trophies = 0, wins = 0, losses = 0, fightsLeft = Config.PVP.dailyFights, hasDefense = false }
		add(label(ui.body, { Position = UDim2.new(0, 0, 1, -68), Size = UDim2.new(1, 0, 0, 14), TextSize = 12, Text = "🏆 " .. pv.trophies .. " trophées · " .. pv.wins .. " V / " .. pv.losses .. " D · classés restants : " .. pv.fightsLeft, ZIndex = 32 }))
		local def = add(button(ui.body, { Position = UDim2.new(0, 0, 1, -106), Size = UDim2.new(0.5, -3, 0, 28), Text = pv.hasDefense and "🛡 Défense ✔" or "🛡 Défense", BackgroundColor3 = Color3.fromRGB(74, 163, 255), ZIndex = 32 }))
		def.Activated:Connect(function()
			fire("setTeam", team)
			fire("pvpDefense")
		end)
		local rk = add(button(ui.body, { Position = UDim2.new(0.5, 3, 1, -106), Size = UDim2.new(0.5, -3, 0, 28), Text = LV.queued and "✖ Annuler la recherche" or "🏆 Combat classé", BackgroundColor3 = LV.queued and Color3.fromRGB(255, 99, 99) or Color3.fromRGB(184, 120, 255), ZIndex = 32 }))
		rk.Activated:Connect(function()
			if LV.queued then -- lot 14 : annulation pendant l'attente (refusée par le serveur une fois la téléportation lancée)
				fire("liveCancel")
				return
			end
			fire("setTeam", team)
			fire("liveQueue") -- lot 14 : file en direct si elle est ouverte, sinon le serveur lance le classé enregistré (pvpStart)
		end)
		if LV.note then
			ui.info.Text = LV.note
		end
		local go = add(button(ui.body, { Position = UDim2.new(1, -150, 1, -34), Size = UDim2.fromOffset(150, 30), Text = "⚔️ Combattre", ZIndex = 32 }))
		go.Activated:Connect(function()
			lastFloor = floor
			fire("setTeam", team)
			fire("towerStart", floor)
		end)
	end

	local function renderBattle()
		if not view then
			return
		end
		ui.title.Text = "⚔️ " .. foeName .. ((lastFloor or 0) > 0 and (" · étage " .. lastFloor) or "")
		local me, foe = view.sides[1], view.sides[2]
		local mu, fu = me.units[me.active], foe.units[foe.active]
		ui.info.Text = BattleUi.advantage(Battle, mu.type, fu.type) .. " · tour " .. view.turn .. "/" .. Battle.MAX_TURNS .. (DU.on and (DU.chosen and " · ✅ choix envoyé, attente de l'adversaire" or " · duel : choisis ton action") or "")
		local function bar(y, u, left)
			add(label(ui.body, { Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 20), Text = unitText(u) .. "   " .. u.hp .. "/" .. u.maxHp .. (u.guard and " 🛡" or "") .. (u.stun > 0 and " 💫" or "") .. (u.focus > 0 and " ⚡" or ""), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 32 }))
			local bg = add(make("Frame", { Position = UDim2.fromOffset(0, y + 22), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = Color3.fromRGB(50, 30, 40), ZIndex = 32 }, ui.body))
			make("UICorner", { CornerRadius = UDim.new(0, 5) }, bg)
			local frac = u.maxHp > 0 and math.max(0, u.hp / u.maxHp) or 0
			make("Frame", { Size = UDim2.fromScale(frac, 1), BackgroundColor3 = frac > 0.5 and Color3.fromRGB(91, 227, 125) or (frac > 0.25 and Color3.fromRGB(255, 210, 63) or Color3.fromRGB(255, 99, 99)), ZIndex = 33 }, bg)
		end
		-- lot 12 B : 5 pastilles de charge sous la barre de vie (la dernière pulse quand le spécial est prêt)
		local function pips(y, u)
			local st = BattleUi.specialState(Config, Battle, u)
			if not st.charge then
				return st
			end
			for i = 1, st.max do
				local on = i <= st.charge
				local pip = add(make("Frame", { Position = UDim2.fromOffset((i - 1) * 14, y + 35), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = on and Color3.fromRGB(255, 210, 63) or Color3.fromRGB(60, 56, 80), ZIndex = 33 }, ui.body))
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, pip)
				make("UIStroke", { Color = Color3.fromRGB(20, 20, 30), Thickness = 1 }, pip)
				if on and st.ready and i == st.max then
					pcall(function()
						TweenService:Create(pip, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = UDim2.fromOffset(14, 14) }):Play()
					end)
				end
			end
			return st
		end
		bar(0, fu, false)
		pips(0, fu)
		bar(48, mu, true)
		local myState = pips(48, mu)
		if myState.ready and not lastReady then
			FX.sound("special_ready")
		end
		lastReady = myState.ready
		for _, e in ipairs({ { fu, 0 }, { mu, 48 } }) do -- lot 10 : icône de type (Decal) à droite de la barre, si elle est chargée
			local w = FX.icon(ui.body, Config.TYPE_ICON[e[1].type], 0, e[2], 20)
			if w then
				w.AnchorPoint = Vector2.new(1, 0)
				w.Position = UDim2.new(1, 0, 0, e[2])
				add(w)
			end
		end
		local log = add(label(ui.body, { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 52), TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = table.concat(logLines, "\n"), ZIndex = 32 }))
		local b1 = add(button(ui.body, { Position = UDim2.new(0, 0, 1, -66), Size = UDim2.new(0.5, -3, 0, 28), Text = "⚔ Attaque", ZIndex = 32 }))
		b1.Activated:Connect(function()
			fire("battleAct", "attack")
			DU.picked()
		end)
		local b2 = add(button(ui.body, { Position = UDim2.new(0.5, 3, 1, -66), Size = UDim2.new(0.5, -3, 0, 28), Text = myState.text, AutoButtonColor = myState.ready, BackgroundColor3 = myState.ready and Color3.fromRGB(74, 163, 255) or Color3.fromRGB(110, 110, 120), TextColor3 = myState.ready and Color3.fromRGB(10, 30, 15) or Color3.fromRGB(200, 200, 210), ZIndex = 32 }))
		b2.Activated:Connect(function()
			if myState.ready then -- le serveur revalide (« spécial pas prêt (x/5) ») : ce test n'est que du confort
				fire("battleAct", "skill")
				DU.picked()
			end
		end)
		local k = 0
		for i, u in ipairs(me.units) do
			if i ~= me.active then
				k = k + 1
				local alive = u.hp > 0
				local sb = add(button(ui.body, { Position = UDim2.new((k - 1) * 0.34, 0, 1, -34), Size = UDim2.new(0.33, -2, 0, 28), Text = alive and ("🔁 " .. Config.PETS[u.p].emoji .. " " .. u.hp) or ("💀 " .. Config.PETS[u.p].emoji), BackgroundColor3 = alive and Color3.fromRGB(255, 159, 28) or Color3.fromRGB(70, 70, 80), ZIndex = 32 }))
				sb.Activated:Connect(function()
					if alive then
						fire("battleAct", "swap" .. i)
						DU.picked()
					end
				end)
			end
		end
		local quit = add(button(ui.body, { Position = UDim2.new(1, -60, 0, 96), Size = UDim2.fromOffset(60, 22), Text = "Abandon", TextSize = 12, BackgroundColor3 = Color3.fromRGB(255, 99, 99), ZIndex = 33 }))
		quit.Activated:Connect(function()
			fire("battleQuit")
		end)
		return log
	end

	-- Refonte : scène de combat face à face. Le serveur n'envoie rien de plus : tout vient de la vue (Battle.view) et du message « start ».
	local function sceneOn()
		return type(fx) == "table" and fx.BattleScene ~= nil and fx.BattleLayout ~= nil and not (Config.BATTLE_FX and Config.BATTLE_FX.scene == false)
	end
	function SC.close()
		if SC.scene then
			pcall(SC.scene.destroy)
			SC.scene = nil
		end
		pcall(function()
			ui.open.Visible = true
		end)
	end
	function SC.statusText()
		if not view then
			return ""
		end
		local me, foe = view.sides[1], view.sides[2]
		local mu, fu = me.units[me.active], foe.units[foe.active]
		local left = math.max(0, math.ceil(deadline - os.clock()))
		return (mu and fu and (BattleUi.advantage(Battle, mu.type, fu.type) .. " · ") or "") .. "tour " .. tostring(view.turn) .. "/" .. Battle.MAX_TURNS .. (view.over and "" or (" · ⏱ " .. left .. " s")) .. (DU.on and (DU.chosen and " · ✅ choix envoyé, attente de l'adversaire" or " · duel : choisis ton action") or "")
	end
	function SC.refresh()
		if not (SC.scene and view) then
			return
		end
		local d = SC.delay
		SC.delay = 0
		SC.scene.update(view, { delay = d, events = SC.events })
		SC.events = nil
		SC.scene.setContext(tostring(foeName or "") .. ((lastFloor or 0) > 0 and (" · étage " .. lastFloor) or ""))
		SC.scene.setLog(logLines)
		SC.scene.setStatus(SC.statusText())
	end
	function SC.open(p)
		SC.close()
		if not sceneOn() then
			return false
		end
		local ok, sc = pcall(fx.BattleScene.create, {
			gui = gui, Config = Config, Battle = Battle, Layout = fx.BattleLayout, player = player, payload = p, view = view, foeName = foeName, floor = lastFloor,
			reduced = fx.reduced == true, iconUrl = fx.iconUrl, sound = FX.sound,
			attackSounds = not (FX.on and Config.BATTLE_FX.typeFx and fx.TypeFx and fx.TypeFxData), -- sinon les effets de type jouent déjà le son d'attaque (jamais deux fois)
			speed = PREFS.speed, canSkip = fx.BattleLayout.skipAvailable(PREFS.seen),
			onSpeed = function(v)
				PREFS.speed = v
			end,
			specialState = function(u)
				return BattleUi.specialState(Config, Battle, u)
			end,
			fire = fire,
			onChosen = function()
				DU.picked()
			end,
		})
		if ok and sc then
			SC.scene = sc
			ui.panel.Visible = false
			pcall(function()
				ui.open.Visible = false
			end)
			return true
		end
		return false
	end

	function render()
		clear()
		if mode == "battle" then
			if SC.scene then
				SC.refresh()
			else
				renderBattle()
			end
		elseif mode == "end" then
			-- l'écran de résultat est construit par `finish`
		else
			renderTeam()
		end
	end

	local function pushLog(events)
		for _, ev in ipairs(events or {}) do
			local t = Battle.describe(Config, ev)
			if t ~= "" and ev.t == "hit" then -- lot 12 B : texte d'efficacité aussi dans le journal (utile sans effets visuels), sans doublon
				local eff = BattleUi.efficacy(ev.mul)
				if eff and not string.find(t, eff, 1, true) then
					t = t .. " (" .. eff .. ")"
				end
			end
			if t ~= "" and ev.t ~= "turn" then
				logLines[#logLines + 1] = t
			end
		end
		while #logLines > 4 do
			table.remove(logLines, 1)
		end
	end

	local function showResult(msg, waitPick)
		mode = "end"
		clear()
		ui.panel.Visible = true
		ui.info.Text = ""
		add(label(ui.body, { Size = UDim2.new(1, 0, 1, -52), TextSize = 16, TextWrapped = true, Text = msg, ZIndex = 32 }))
		if waitPick then
			return -- le serveur envoie ensuite { k = "pick" } ; « Continuer » n'apparaît qu'après le choix
		end
		local ok2 = add(button(ui.body, { Position = UDim2.new(0.5, -70, 1, -46), Size = UDim2.fromOffset(140, 44), Text = "Continuer", ZIndex = 32 }))
		ok2.Activated:Connect(function()
			SC.close() -- refonte : la scène de combat est détruite (aucune instance ne reste)
			mode = "team"
			team = {}
			logLines = {}
			render()
		end)
	end

	-- LOT 12 B (D.5) : écran de choix. `p` = { id, cards = { { kind, icon, title, desc, boss } x3 }, seconds } reçu du serveur (BattleRewards.view). Le client n'envoie
	-- que { id, i } ; le serveur valide l'id et l'index, tire au sort rien, et donne la première carte si le délai est écoulé. Reconnexion : le serveur renvoie la même vue.
	local function showPick(p)
		mode = "pick"
		pick, pickSent = p, false
		pickDeadline = os.clock() + (tonumber(p.seconds) or 15)
		clear()
		ui.panel.Visible = true
		ui.title.Text = "🎁 Choisis ta récompense"
		ui.info.Text = "Une seule carte ! (sinon la première te sera donnée)"
		local n = #p.cards
		for i, c in ipairs(p.cards) do
			local w = 1 / n
			local btn = add(button(ui.body, { Position = UDim2.new((i - 1) * w, 3, 0, 0), Size = UDim2.new(w, -6, 1, -50), Text = "", BackgroundColor3 = c.boss and Color3.fromRGB(255, 210, 63) or Color3.fromRGB(70, 74, 110), ZIndex = 32 }))
			label(btn, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 40), Text = tostring(c.icon or "?"), TextSize = 32, TextColor3 = Color3.new(1, 1, 1), ZIndex = 33 })
			label(btn, { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 20), Text = tostring(c.title or ""), TextSize = 15, TextColor3 = c.boss and Color3.fromRGB(40, 30, 0) or Color3.new(1, 1, 1), ZIndex = 33 })
			label(btn, { Position = UDim2.fromOffset(4, 78), Size = UDim2.new(1, -8, 1, -84), Text = tostring(c.desc or ""), TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = c.boss and Color3.fromRGB(40, 30, 0) or Color3.fromRGB(220, 220, 235), ZIndex = 33 })
			btn.Activated:Connect(function()
				if pickSent or mode ~= "pick" then
					return
				end
				pickSent = true
				btn.Text = "✅"
				fire("battlePick", { id = p.id, i = i })
			end)
		end
		add(label(ui.body, { Name = "PickTimer", Position = UDim2.new(0, 0, 1, -44), Size = UDim2.new(1, 0, 0, 36), Text = "", TextSize = 14, ZIndex = 32 }))
	end

	local function showPicked(p)
		mode = "end"
		pick = nil
		local lines = { "🎁 Récompense reçue !" }
		if type(p.text) == "string" then
			lines[#lines + 1] = p.text
		end
		if p.auto then
			lines[#lines + 1] = "(choix automatique : première carte)"
		end
		showResult(table.concat(lines, "\n"))
	end

	-- LOT 13 : duel local. Demande reçue (Accepter / Refuser, 20 s), caméra de duel sur le sable, bandeau des spectateurs. Le serveur revalide tout.
	function DU.picked()
		if DU.on and not DU.chosen then
			DU.chosen = true
			if mode == "battle" then
				render()
			end
		end
	end
	function DU.camera(p)
		local cam = workspace.CurrentCamera
		if not cam or type(p.arena) ~= "table" or type(p.arena.x) ~= "number" or type(p.arena.z) ~= "number" then
			return
		end
		DU.cam = { type = cam.CameraType, subject = cam.CameraSubject }
		local dir = p.arena.side == 2 and -1 or 1
		local center = Vector3.new(p.arena.x, 4, p.arena.z)
		local eye = center + Vector3.new(-dir * 6, 16, 30)
		cam.CameraType = Enum.CameraType.Scriptable
		local goal = { CFrame = CFrame.lookAt(eye, center) }
		pcall(function()
			TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), goal):Play()
		end)
	end
	function DU.restore()
		local cam = workspace.CurrentCamera
		if DU.cam and cam then
			cam.CameraType = Enum.CameraType.Custom
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			cam.CameraSubject = hum or DU.cam.subject
		end
		DU.cam, DU.on, DU.chosen = nil, false, false
	end
	function DU.closeAsk()
		if DU.ask then
			pcall(function()
				DU.ask.frame:Destroy()
			end)
			DU.ask = nil
		end
	end
	function DU.showAsk(p)
		if type(p.fromId) ~= "number" or type(p.from) ~= "string" then
			return
		end
		DU.closeAsk()
		local fr = make("Frame", { Name = "DuelAsk", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 90), Size = UDim2.fromOffset(300, 104), BackgroundColor3 = Color3.fromRGB(28, 26, 44), ZIndex = 40 }, gui)
		make("UICorner", { CornerRadius = UDim.new(0, 14) }, fr)
		make("UIStroke", { Color = Color3.fromRGB(255, 159, 28), Thickness = 3 }, fr)
		label(fr, { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 40), TextSize = 16, TextWrapped = true, Text = "⚔️ " .. p.from:sub(1, 20) .. " te défie en duel !\nAmical : aucun trophée en jeu.", ZIndex = 41 })
		local timer = label(fr, { Position = UDim2.fromOffset(10, 46), Size = UDim2.new(1, -20, 0, 16), TextSize = 12, TextColor3 = Color3.fromRGB(220, 220, 235), Text = "", ZIndex = 41 })
		local yes = button(fr, { Position = UDim2.new(0, 10, 1, -36), Size = UDim2.new(0.5, -15, 0, 28), Text = "✅ Accepter", ZIndex = 41 })
		local no = button(fr, { Position = UDim2.new(0.5, 5, 1, -36), Size = UDim2.new(0.5, -15, 0, 28), Text = "✖ Refuser", BackgroundColor3 = Color3.fromRGB(255, 99, 99), ZIndex = 41 })
		DU.ask = { frame = fr, fromId = p.fromId, deadline = os.clock() + (tonumber(p.seconds) or 20), timer = timer }
		yes.Activated:Connect(function()
			fire("duelAnswer", { from = p.fromId, accept = true })
			DU.closeAsk()
		end)
		no.Activated:Connect(function()
			fire("duelAnswer", { from = p.fromId, accept = false })
			DU.closeAsk()
		end)
		pcall(function()
			fr.Position = UDim2.new(0.5, 0, 0, 60)
			TweenService:Create(fr, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 90) }):Play()
		end)
		FX.sound("battle_start")
	end
	function DU.showWatch(p) -- bandeau des spectateurs : noms, PV restants des deux équipes, tour, vainqueur
		if type(p.view) ~= "table" or type(p.view.sides) ~= "table" then
			return
		end
		if not DU.watch then
			local fr = make("Frame", { Name = "DuelWatch", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 52), Size = UDim2.fromOffset(320, 50), BackgroundColor3 = Color3.fromRGB(28, 26, 44), BackgroundTransparency = 0.15, ZIndex = 25 }, gui)
			make("UICorner", { CornerRadius = UDim.new(0, 12) }, fr)
			make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 2 }, fr)
			local title = label(fr, { Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 20), TextSize = 14, Text = "", ZIndex = 26 })
			local bars = {}
			for i = 1, 2 do
				local bg = make("Frame", { Position = UDim2.new((i - 1) * 0.5, 8, 0, 28), Size = UDim2.new(0.5, -16, 0, 12), BackgroundColor3 = Color3.fromRGB(50, 30, 40), ZIndex = 26 }, fr)
				make("UICorner", { CornerRadius = UDim.new(0, 6) }, bg)
				bars[i] = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = i == 1 and Color3.fromRGB(74, 163, 255) or Color3.fromRGB(255, 99, 99), ZIndex = 27 }, bg)
			end
			DU.watch = { frame = fr, title = title, bars = bars }
		end
		local w = DU.watch
		for i = 1, 2 do
			local hp, max = 0, 0
			for _, u in ipairs(p.view.sides[i] and p.view.sides[i].units or {}) do
				hp, max = hp + math.max(0, tonumber(u.hp) or 0), max + math.max(0, tonumber(u.maxHp) or 0)
			end
			w.bars[i].Size = UDim2.fromScale(max > 0 and hp / max or 0, 1)
		end
		local a, b = tostring(p.a or "?"):sub(1, 16), tostring(p.b or "?"):sub(1, 16)
		w.title.Text = p.over and ("🏆 " .. (p.winner and tostring(p.winner):sub(1, 16) .. " gagne le duel !" or "Duel terminé")) or ("⚔️ Duel au colisée : " .. a .. " 🆚 " .. b .. " · tour " .. tostring(p.view.turn or 0))
		DU.watchAt = os.clock() + (p.over and 5 or 25)
	end

	RBattle.OnClientEvent:Connect(function(p)
		pcall(function()
			if type(p) ~= "table" then
				return
			end
			if p.k == "duelAsk" then
				DU.showAsk(p)
				return
			elseif p.k == "duelAskEnd" then
				if DU.ask and DU.ask.fromId == p.fromId then
					DU.closeAsk()
				end
				return
			elseif p.k == "duelWatch" then
				DU.showWatch(p)
				return
			elseif p.k == "liveQueued" then -- lot 14 : classé en direct
				LV.queued, LV.note = true, "🔎 Recherche d'un adversaire en ligne de ton niveau…" .. (tonumber(p.seconds) and (" (au plus " .. math.floor(p.seconds) .. " s)") or "")
				if mode == "team" then
					render()
				end
				return
			elseif p.k == "liveCancel" then
				LV.queued, LV.note = false, nil
				if mode == "team" then
					render()
				end
				return
			elseif p.k == "liveFound" then
				LV.queued, LV.note = false, "⚔️ Adversaire trouvé : " .. tostring(p.opp or "?"):sub(1, 20) .. " ! Téléportation vers l'arène…"
				ui.panel.Visible = true
				if mode == "team" then
					render()
				end
				FX.sound("battle_start")
				return
			elseif p.k == "liveFallback" then
				LV.queued, LV.note = false, nil
				mode = "end"
				clear()
				ui.panel.Visible = true
				ui.title.Text = "🏆 Combat classé"
				ui.info.Text = ""
				add(label(ui.body, { Size = UDim2.new(1, 0, 1, -52), TextSize = 16, TextWrapped = true, Text = "Aucun adversaire en ligne de ton niveau.\nCombattre une équipe enregistrée ?", ZIndex = 32 }))
				local yes = add(button(ui.body, { Position = UDim2.new(0, 0, 1, -46), Size = UDim2.new(0.5, -3, 0, 44), Text = "🏆 Oui", ZIndex = 32 }))
				local no = add(button(ui.body, { Position = UDim2.new(0.5, 3, 1, -46), Size = UDim2.new(0.5, -3, 0, 44), Text = "Non", BackgroundColor3 = Color3.fromRGB(255, 99, 99), ZIndex = 32 }))
				yes.Activated:Connect(function()
					fire("pvpStart")
				end)
				no.Activated:Connect(function()
					mode = "team"
					render()
				end)
				return
			elseif p.k == "liveArena" then
				LV.queued, LV.note = false, nil
				mode = "end"
				clear()
				ui.panel.Visible = true
				ui.title.Text = "🏆 Arène classée"
				ui.info.Text = ""
				add(label(ui.body, { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextWrapped = true, Text = "En attente de ton adversaire…" .. (tonumber(p.seconds) and ("\n(au plus " .. math.floor(p.seconds) .. " s ; s'il n'arrive pas, aucun trophée ne bouge)") or ""), ZIndex = 32 }))
				return
			elseif p.k == "liveVoid" then
				LV.queued, LV.note = false, nil
				ui.panel.Visible = true
				showResult("⚔️ Combat annulé : aucun trophée gagné ni perdu.\nRetour à ta partie…")
				return
			end
			if p.k == "start" then
				DU.on, DU.chosen = p.duel == true, false
				LV.queued, LV.note = false, nil
				if p.duel then
					DU.closeAsk()
					pcall(DU.camera, p)
				end
				mode, view, foeName, lastFloor, logLines, pick, lastReady = "battle", p.view, p.foe, p.floor, {}, nil, false
				deadline = os.clock() + (p.seconds or TW.turnSeconds)
				if SC.open(p) then -- refonte : scène face à face plein écran (le panneau compact reste caché)
					SC.refresh()
				else
					ui.panel.Visible = true
					render()
				end
				FX.hits = { 0, 0 }
				pcall(FX.intro, p)
			elseif p.k == "turn" then
				DU.chosen = false
				view = p.view
				deadline = os.clock() + (p.seconds or TW.turnSeconds)
				pushLog(p.events)
				SC.events = p.events
				if SC.scene then -- animations de la scène (élan, recul, nombres flottants) ; le remplacement d'une créature attend la fin des coups
					local okc, d = pcall(SC.scene.cues, p.events)
					SC.delay = okc and tonumber(d) or 0
				end
				pcall(FX.hits, p.events)
				if mode == "battle" then
					render()
				end
			elseif p.k == "pick" then
				if type(p.cards) == "table" and #p.cards >= 1 and #p.cards <= 5 then
					showPick(p)
				end
			elseif p.k == "picked" then
				showPicked(p)
			elseif p.k == "end" then
				PREFS.seen = PREFS.seen + 1 -- un combat de plus vu : « Passer l'animation » est proposé dès le suivant
				local r = p.rewards or {}
				local lines = { p.win and "🏆 Victoire !" or "💀 Défaite…" }
				if p.duel then -- lot 13 : texte du serveur (forfait, quotas, pièces), caméra rendue
					pcall(DU.restore)
					lines = { r.cancelled and "⚔️ Duel annulé" or (p.win and "🏆 Duel gagné !" or "💀 Duel perdu…"), type(r.duelText) == "string" and r.duelText or "" }
					r = {}
				end
				if p.win and r.coins then
					lines[#lines + 1] = "+" .. Config.fmt(r.coins) .. " 🪙" .. (r.first and " (première victoire de l'étage)" or "")
				end
				if p.pvp and r.trophies then
					lines[#lines + 1] = (r.trophies >= 0 and "+" or "") .. r.trophies .. " 🏆 trophées (total " .. r.total .. ")"
					if type(fx) == "table" and fx.BattleLayout and type(Config.LEAGUES) == "table" then -- récap : progression vers le palier suivant (calculée ici d'après le total envoyé)
						local pr = fx.BattleLayout.leagueProgress(r.total, Config.LEAGUES)
						if pr.name ~= "" then
							lines[#lines + 1] = "🏅 " .. pr.name .. (pr.next and (" · prochain palier : " .. tostring(pr.nextName) .. " à " .. pr.next .. " 🏆 (" .. pr.percent .. " %)") or " · palier maximal")
						end
					end
				end
				if p.live then -- lot 14 : classé en direct
					if r.forfeit then
						lines[#lines + 1] = p.win and "(forfait de l'adversaire)" or "(forfait)"
					end
					if r.capped then
						lines[#lines + 1] = "Plafond de trophées du jour atteint en direct."
					end
				end
				if type(fx) == "table" and fx.BattleLayout and not p.duel then -- XP des pets : seulement si le message « end » du serveur la contient (aucune estimation côté client)
					for _, l in ipairs(fx.BattleLayout.xpLines(p, Config, Battle.PetXp)) do
						lines[#lines + 1] = l
					end
				end
				if r.egg then
					lines[#lines + 1] = "🥚 Œuf " .. Config.TIERS[r.egg].name
				end
				if r.potion then
					lines[#lines + 1] = "🧪 Potion de chance"
				end
				if p.pick then
					lines[#lines + 1] = "🎁 Choisis ta récompense…"
				end
				if r.limited then
					lines[#lines + 1] = "Limite de récompenses de répétition atteinte aujourd'hui."
				end
				if SC.scene then -- la scène reste en fond, assombrie, derrière l'écran de résultat et les cartes de récompense
					if type(p.view) == "table" and type(p.view.sides) == "table" then
						pcall(SC.scene.update, p.view, { delay = 0.8 })
					end
					pcall(SC.scene.setDim, true)
				end
				showResult(table.concat(lines, "\n"), p.pick == true)
				FX.sound(p.win and "battle_win" or "battle_lose")
				local trophy = FX.icon(ui.body, p.win and "ui_trophee" or "ui_victoire_defaite", 4, 4, 40)
				if trophy then
					add(trophy)
				end
			end
		end)
	end)
	ui.open.Activated:Connect(function()
		ui.panel.Visible = not ui.panel.Visible
		if ui.panel.Visible and mode ~= "battle" and mode ~= "end" and mode ~= "pick" then
			mode = "team"
			render()
		end
	end)
	ui.close.Activated:Connect(function()
		ui.panel.Visible = false
		if SC.scene and (mode == "end" or mode == "team") then -- refonte : fermer le résultat libère la scène (jamais d'écran de combat orphelin)
			SC.close()
			mode = "team"
		end
	end)
	task.spawn(function() -- minuteur du tour
		while true do
			task.wait(0.5)
			pcall(function()
				if mode == "pick" and pick and ui.panel.Visible then
					local left = math.max(0, math.ceil(pickDeadline - os.clock()))
					for _, w in ipairs(widgets) do
						if w.Name == "PickTimer" then
							w.Text = left > 0 and ("⏱ " .. left .. " s") or "Choix automatique…"
						end
					end
					if left <= 0 and os.clock() > pickDeadline + 20 then -- le serveur n'a rien renvoyé : on rend la main (la carte reste attribuée côté serveur)
						mode, pick = "team", nil
						render()
					end
				end
				if DU.ask then
					local left = math.ceil(DU.ask.deadline - os.clock())
					DU.ask.timer.Text = "⏱ " .. math.max(0, left) .. " s pour répondre"
					if left < -1 then
						DU.closeAsk()
					end
				end
				if DU.watch and os.clock() > DU.watchAt then
					DU.watch.frame:Destroy()
					DU.watch = nil
				end
				if DU.on and mode ~= "battle" then
					DU.restore()
				end
				if mode == "battle" and SC.scene and view then
					SC.scene.setStatus(SC.statusText())
				elseif SC.scene and mode ~= "battle" and mode ~= "end" and mode ~= "pick" then -- plus de combat : la scène ne reste jamais seule à l'écran
					SC.close()
				end
				if mode == "battle" and ui.panel.Visible and view and not view.over then
					local left = math.max(0, math.ceil(deadline - os.clock()))
					ui.title.Text = "⚔️ " .. foeName .. ((lastFloor or 0) > 0 and (" · étage " .. lastFloor) or "") .. " · ⏱ " .. left .. " s"
				end
			end)
		end
	end)
	return ui
end

return BattleUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX88"><Properties><string name="Name">BattleIntro</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/BattleIntro   (lot 10, B.4)
-- Intro de combat, 3 s au maximum, passable (tap après 1 s) : deux bandeaux glissent depuis les bords (joueur à gauche, adversaire à droite) avec portrait, nom, ligue,
-- trophées, ratio « 124 V / 37 D (77 %) » et 3 vignettes de pets (type + compteur de rareté) ; « VS » qui frappe (échelle 2 -> 1, secousse 0,3 s, son « fanfare » à 0,5) ;
-- flèche d'avantage de type ; décompte 3-2-1 si demandé. 100 % code. Le plan vient de ReplicatedStorage/IntroPlan (pur). Rien ne s'exécute à l'import, aucun require.
--
-- BRANCHER (client, avant de démarrer l'écran de combat) :
--   local plan = IntroPlan.plan({ mode = "pvp", countdown = true, advantage = 1.5,
--       me = { name = player.Name, userId = player.UserId, wins = 124, losses = 37, league = "Or", trophies = 812, pets = { { type = "Feu", odds = 38494, tier = 5 }, ... } },
--       foe = { ... } }, { fmtOdds = Odds.label })
--   BattleIntro.play(screenGui, plan, {
--       thumbnail = function(userId) return "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150" end, -- optionnel (ou Players:GetUserThumbnailAsync, hors de ce module)
--       sound = function(key, volume) ... end,   -- appelé avec "fanfare", 0.5
--       onDone = function() ... end })           -- UNE fois, à la fin, au passage ou en cas d'erreur
-- Retourne { skip, stop, isDone, created, root } ou nil (onDone est alors appelé quand même). Pas de += ni de continue (lanceur lupa).
local BattleIntro = {}

BattleIntro.MAX_INSTANCES = 120
BattleIntro.WATCHDOG_MARGIN = 0.5

local FONT = Enum.Font.GothamBold
local TYPE_EMOJI = { Feu = "🔥", Eau = "💧", Plante = "🌿", Nature = "🌿", Glace = "❄️", Foudre = "⚡", Terre = "⛰️", Ciel = "☁️", Ombre = "🌑", ["Lumière"] = "✨" }

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

function BattleIntro.play(parent, plan, opts)
	opts = type(opts) == "table" and opts or {}
	local created, done, alive = 0, false, false
	local root, stage, vs
	local startClock = os.clock()
	local TweenService
	pcall(function()
		TweenService = game:GetService("TweenService")
	end)

	local function make(class, props, par)
		if created >= BattleIntro.MAX_INSTANCES then
			error("plafond d'instances")
		end
		created = created + 1
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = par
		return o
	end
	local function tween(obj, seconds, goal, style, dir)
		if TweenService == nil then
			return
		end
		pcall(function()
			TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
		end)
	end
	local function finish()
		if done then
			return
		end
		done = true
		alive = false
		if root ~= nil then
			pcall(function()
				root:Destroy()
			end)
		end
		if type(opts.onDone) == "function" then
			pcall(opts.onDone)
		end
	end

	local function label(par, props)
		props.BackgroundTransparency = 1
		props.Font = props.Font or FONT
		props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
		props.TextStrokeTransparency = props.TextStrokeTransparency or 0.4
		props.ZIndex = props.ZIndex or 84
		return make("TextLabel", props, par)
	end

	-- bandeau d'un joueur ; right = true : côté droit
	local function buildSide(data, right)
		local x = right and 1 or 0
		local band = make("Frame", {
			AnchorPoint = Vector2.new(x, 0.5), Position = UDim2.new(x + (right and 0.6 or -0.6), 0, 0.32, 0), Size = UDim2.new(0.46, 0, 0, 168), BorderSizePixel = 0, ZIndex = 82,
			BackgroundColor3 = right and Color3.fromRGB(120, 36, 44) or Color3.fromRGB(34, 70, 130),
		}, stage)
		make("UICorner", { CornerRadius = UDim.new(0, 14) }, band)
		make("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Thickness = 2, Transparency = 0.5 }, band)
		local thumb = nil
		if type(opts.thumbnail) == "function" and data.userId ~= 0 then
			local ok, img = pcall(opts.thumbnail, data.userId)
			thumb = ok and type(img) == "string" and img or nil
		end
		local portrait = make("ImageLabel", {
			Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(64, 64), BackgroundColor3 = Color3.fromRGB(20, 20, 30), Image = thumb or "", BorderSizePixel = 0, ZIndex = 84,
		}, band)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, portrait)
		label(band, { Position = UDim2.fromOffset(82, 8), Size = UDim2.new(1, -92, 0, 26), Text = data.name, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left })
		local sub = (data.league ~= "" and (data.league .. " · ") or "") .. "🏆 " .. data.trophies
		label(band, { Position = UDim2.fromOffset(82, 34), Size = UDim2.new(1, -92, 0, 18), Text = sub, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 232, 150) })
		label(band, { Position = UDim2.fromOffset(82, 54), Size = UDim2.new(1, -92, 0, 22), Text = data.record, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left })
		for i = 1, #data.pets do
			local p = data.pets[i]
			local card = make("Frame", {
				Position = UDim2.new((i - 1) / 3, i == 1 and 8 or 4, 0, 88), Size = UDim2.new(1 / 3, -8, 0, 70), BackgroundColor3 = Color3.fromRGB(16, 16, 28), BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 83,
			}, band)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, card)
			label(card, { Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 34), Text = TYPE_EMOJI[p.type] or "❔", TextSize = 28 })
			label(card, { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 22), Text = p.oddsText, TextSize = 12, TextColor3 = Color3.fromRGB(255, 255, 255) })
		end
		return band
	end

	local ok = pcall(function()
		if type(plan) ~= "table" or type(plan.left) ~= "table" or type(plan.right) ~= "table" then
			error("plan invalide")
		end
		local duration = math.max(0.3, math.min(3, num(plan.duration, 2.2)))
		alive = true
		root = make("TextButton", { Name = "BattleIntro", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Text = "", AutoButtonColor = false, ZIndex = 80, BorderSizePixel = 0 }, parent)
		stage = make("Frame", { Name = "Stage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 81, BorderSizePixel = 0 }, root)
		local left, right = buildSide(plan.left, false), buildSide(plan.right, true)
		tween(left, 0.4, { Position = UDim2.new(0, 0, 0.32, 0) }, Enum.EasingStyle.Back)
		tween(right, 0.4, { Position = UDim2.new(1, 0, 0.32, 0) }, Enum.EasingStyle.Back)
		vs = make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Text = "VS", TextScaled = true, Font = Enum.Font.GothamBlack,
			TextColor3 = Color3.fromRGB(255, 210, 63), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(30, 10, 10), Visible = false, ZIndex = 90,
		}, stage)
		task.delay(num(plan.vs and plan.vs.t, 0.5), function()
			if not alive then
				return
			end
			pcall(function()
				vs.Visible = true
				vs.Size = UDim2.fromOffset(200, 120)
				tween(vs, 0.3, { Size = UDim2.fromOffset(100, 60) }, Enum.EasingStyle.Back)
				if type(opts.sound) == "function" then
					pcall(opts.sound, "fanfare", 0.5)
				end
			end)
			-- secousse de 0,3 s
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < 0.3 do
					local k = (1 - (os.clock() - t0) / 0.3) * 6
					pcall(function()
						stage.Position = UDim2.fromOffset(math.sin((os.clock() - t0) * 90) * k, 0)
					end)
					task.wait(0.03)
				end
				pcall(function()
					stage.Position = UDim2.fromOffset(0, 0)
				end)
			end)
		end)
		if type(plan.arrow) == "table" then
			task.delay(num(plan.arrow.t, 1), function()
				if not alive then
					return
				end
				pcall(function()
					local good = plan.arrow.good == true
					local a = label(stage, {
						AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0.02, 0, 0.32, 100), Size = UDim2.fromOffset(240, 30), Text = (good and "⬆ " or "⬇ ") .. tostring(plan.arrow.text or ""),
						TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = good and Color3.fromRGB(90, 235, 110) or Color3.fromRGB(255, 90, 90), ZIndex = 90,
					})
					a.TextTransparency = 1
					tween(a, 0.25, { TextTransparency = 0 })
				end)
			end)
		end
		if type(plan.count) == "table" then
			for i = 1, #plan.count do
				local c = plan.count[i]
				task.delay(num(c.t, 1.6), function()
					if not alive then
						return
					end
					pcall(function()
						local l = label(stage, {
							AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.7), Size = UDim2.fromOffset(120, 120), Text = tostring(c.text or ""), TextScaled = true,
							Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, ZIndex = 90,
						})
						tween(l, 0.38, { Size = UDim2.fromOffset(60, 60), TextTransparency = 1, TextStrokeTransparency = 1 })
					end)
				end)
			end
		end
		local skipAfter = num(plan.skipAfter, 1)
		root.Activated:Connect(function()
			if alive and os.clock() - startClock >= skipAfter then
				finish()
			end
		end)
		task.delay(duration, finish)
		task.delay(duration + BattleIntro.WATCHDOG_MARGIN, finish)
	end)

	if not ok then
		finish()
		return nil
	end
	return {
		root = root,
		skip = function()
			if alive and os.clock() - startClock >= num(plan.skipAfter, 1) then
				finish()
			end
		end,
		stop = finish,
		isDone = function()
			return done
		end,
		created = function()
			return created
		end,
	}
end

return BattleIntro
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX89"><Properties><string name="Name">BattleScene</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/BattleScene   (refonte de la présentation du combat, vue face à face)
-- Construit l'écran de combat : une scène 3D dans un ViewportFrame (fond de ciel, sol de sable ou d'herbe, décor en arc, deux socles circulaires lumineux, une créature
-- par camp : copie du modèle Blender du pet publiée par le serveur dans ReplicatedStorage.PetModels si elle tient dans le budget, sinon créature procédurale ;
-- caméra fixe en léger angle), la carte de l'adversaire (haut à droite : nom, niveau, barre de PV verte, points d'état de l'équipe), la carte du
-- joueur (bas à gauche : nom, niveau, PV chiffrés, points d'état, pastilles de charge), le bandeau de journal (bas) et les boutons d'action (bas à droite : Attaque,
-- Spécial n/5, Changer, Fuir). TOUTE la disposition vient du module pur ReplicatedStorage/BattleLayout (testé) ; ici : uniquement des instances.
-- Le client N'ENVOIE QU'UNE INTENTION (« attack », « skill », « swapN », abandon) : le serveur revalide tout, rien ne change dans le protocole.
-- Plafond : BattleLayout.MAX_INSTANCES (220) instances vivantes pour la scène ; tout est détruit par destroy() (aucune fuite : boucles arrêtées, racine détruite).
-- Sur mobile (`reduced`) : moitié du décor, ni colonne de lumière ni balancement. Aucune erreur ne sort d'ici (create retourne nil si la construction échoue).
-- Pas de += ni de continue (lanceur lupa).
local BattleScene = {}

local FONT = Enum.Font.GothamBold

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- o = { gui, Config, Battle, Layout, player, payload (message « start »), view, foeName, floor, reduced, iconUrl = fn(clé) -> url|nil, specialState = fn(unité) -> état,
--       fire = fn(action, arg), onChosen = fn() (un choix vient d'être envoyé), onFlee = fn(), safe = { l, t, r, b } (optionnel) }
function BattleScene.create(o)
	if type(o) ~= "table" or type(o.view) ~= "table" or type(o.view.sides) ~= "table" or type(o.view.sides[1]) ~= "table" or type(o.view.sides[2]) ~= "table" or type(o.view.sides[1].units) ~= "table" or type(o.view.sides[2].units) ~= "table" then
		return nil, "vue invalide"
	end
	local L, Config, Battle = o.Layout, o.Config, o.Battle
	local S = { alive = true, used = 0, peak = 0, conns = {}, puppets = {}, cur = {}, swapToken = { 0, 0 }, popups = 0, lastView = nil, fleeToken = 0, dimmed = false, speed = 1, skipGen = 0, seen = 0 }
	if type(o.speed) == "number" then
		S.speed = math.max(1, math.min(3, math.floor(o.speed)))
	end
	local cap = L.MAX_INSTANCES
	local TweenService
	pcall(function()
		TweenService = game:GetService("TweenService")
	end)

	local function make(class, props, parent)
		if S.used >= cap then
			error("plafond d'instances")
		end
		S.used = S.used + 1
		if S.used > S.peak then
			S.peak = S.used
		end
		local inst = Instance.new(class)
		for k, v in pairs(props) do
			inst[k] = v
		end
		inst.Parent = parent
		return inst
	end
	local function release(n)
		S.used = math.max(0, S.used - n)
	end
	local function tween(inst, seconds, goal, style, dir)
		if TweenService == nil then
			for k, v in pairs(goal) do
				pcall(function()
					inst[k] = v
				end)
			end
			return nil
		end
		local ok, tw = pcall(function()
			local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
			t:Play()
			return t
		end)
		return ok and tw or nil
	end
	-- appelle step(a) de 0 à 1 puis s'arrête ; durée bornée à 1,2 s et divisée par la vitesse (1x / 2x / 3x) ; « Passer » termine tout de suite ; s'arrête à la destruction
	local function animate(duration, step)
		local dur = math.max(0.02, o.Layout.animSeconds(duration, S.speed))
		local gen = S.skipGen
		task.spawn(function()
			local t0 = os.clock()
			while S.alive do
				if S.skipGen ~= gen then
					pcall(step, 1)
					return
				end
				local a = (os.clock() - t0) / dur
				if a >= 1 then
					pcall(step, 1)
					return
				end
				pcall(step, a)
				task.wait(0.03)
			end
		end)
	end

	local function viewportSize()
		local ok, w, h = pcall(function()
			local a = o.gui.AbsoluteSize
			return a.X, a.Y
		end)
		if ok and type(w) == "number" and type(h) == "number" and w > 0 and h > 0 then
			return w, h
		end
		ok, w, h = pcall(function()
			local v = workspace.CurrentCamera.ViewportSize
			return v.X, v.Y
		end)
		if ok and type(w) == "number" and type(h) == "number" and w > 0 and h > 0 then
			return w, h
		end
		return nil, nil
	end

	local st0 = o.payload or {}
	local mode = L.mode(st0)
	local ground = L.ground(mode)
	local pal = L.palette(ground)
	local view0 = o.view
	local nMe = #(view0.sides[1].units or {})
	local nFoe = #(view0.sides[2].units or {})
	local plan = L.plan({ reduced = o.reduced == true, units1 = nMe, units2 = nFoe })
	S.plan, S.mode, S.ground = plan, mode, ground
	local U = L.UI

	local okBuild, err = pcall(function()
		---------------------------------------------------------------- racine, fond, viewport
		local root = make("Frame", { Name = "BattleScene", Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(pal.skyTop), BorderSizePixel = 0, Active = true, ZIndex = 1 }, o.gui)
		S.root = root
		make("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(pal.skyTop), rgb(pal.skyBottom)) }, root)
		local vp = make("ViewportFrame", {
			Name = "World", BackgroundTransparency = 1, Position = UDim2.fromOffset(-5, -5), Size = UDim2.new(1, 10, 1, 10), ZIndex = 2,
			Ambient = rgb(pal.ambient), LightColor = rgb(pal.light), LightDirection = Vector3.new(-0.4, -1, -0.6),
		}, root)
		S.vp = vp
		local cam = make("Camera", { FieldOfView = 40 }, vp)
		vp.CurrentCamera = cam
		S.cam = cam
		S.dim = make("Frame", { Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 12, 16), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 3 }, root)

		---------------------------------------------------------------- monde : sol, décor, socles
		local function part(props)
			props.Anchored = true
			props.CanCollide = false
			props.TopSurface = Enum.SurfaceType.Smooth
			props.BottomSurface = Enum.SurfaceType.Smooth
			return make("Part", props, vp)
		end
		local function flatCylinder(name, x, y, z, diameter, height, color, material, transparency)
			return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, diameter, diameter), CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)), Color = rgb(color), Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
		end
		flatCylinder("Ground", 0, -0.5, -2, 92, 1, pal.ground)
		flatCylinder("Rim", 0, -0.9, -2, 100, 0.8, pal.rim)
		local spots = L.decorSpots(plan.decor)
		for i, sp in ipairs(spots) do
			if ground == "sand" then -- colonnade du colisée
				part({ Name = "Pillar" .. i, Size = Vector3.new(2.4, sp.h * 2, 2.4), CFrame = CFrame.new(sp.x, sp.h, sp.z), Color = rgb(pal.deco), Material = Enum.Material.Sandstone })
			else -- haies et buissons de l'arène
				part({ Name = "Hedge" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(sp.h * 0.5, 4.5, 4.5), CFrame = CFrame.new(sp.x, sp.h * 0.25, sp.z) * CFrame.Angles(0, 0, math.rad(90)), Color = rgb(pal.deco), Material = Enum.Material.Grass })
			end
		end
		S.pedestals = {}
		for side = 1, 2 do
			local u = view0.sides[side].units[view0.sides[side].active]
			local tcol = L.typeColor(u and u.type)
			S.pedestals[side] = { pos = { x = 0, z = 0 }, base = nil, glow = nil, column = nil, color = tcol }
		end

		---------------------------------------------------------------- éléments d'interface (cartes, bandeau, boutons)
		local function label(parent, props)
			props.BackgroundTransparency = 1
			props.Font = props.Font or FONT
			props.TextColor3 = props.TextColor3 or rgb(U.text)
			props.TextSize = props.TextSize or 14
			props.ZIndex = props.ZIndex or 8
			return make("TextLabel", props, parent)
		end
		local function button(name, text, color, textColor)
			local b = make("TextButton", { Name = name, Font = FONT, TextSize = 15, TextWrapped = true, Text = text, AutoButtonColor = true, BackgroundColor3 = rgb(color), TextColor3 = textColor or rgb(U.darkText), ZIndex = 10 }, root)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
			make("UIStroke", { Color = Color3.fromRGB(10, 18, 22), Thickness = 2 }, b)
			return b
		end
		local function place(inst, r)
			inst.Position = UDim2.fromOffset(r.x, r.y)
			inst.Size = UDim2.fromOffset(r.w, r.h)
		end

		local function buildCard(isMe, name)
			local c = { isMe = isMe, dots = {}, pips = {} }
			c.frame = make("Frame", { Name = name, BackgroundColor3 = rgb(U.card), BackgroundTransparency = 0.06, BorderSizePixel = 0, ZIndex = 6 }, root)
			make("UICorner", { CornerRadius = UDim.new(0, 12) }, c.frame)
			make("UIStroke", { Color = rgb(U.cardStroke), Thickness = 2 }, c.frame)
			c.accent = make("Frame", { Name = "Accent", BackgroundColor3 = rgb(L.NEUTRAL_COLOR), BorderSizePixel = 0, ZIndex = 7 }, c.frame)
			c.iconText = label(c.frame, { Name = "IconText", TextSize = 18, Text = "" })
			c.iconImage = nil
			c.name = label(c.frame, { Name = "Name", TextSize = 16, Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
			c.level = label(c.frame, { Name = "Level", TextSize = 13, Text = "", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = rgb(U.muted) })
			c.barBg = make("Frame", { Name = "HpBack", BackgroundColor3 = rgb(U.hpBack), BorderSizePixel = 0, ZIndex = 7 }, c.frame)
			make("UICorner", { CornerRadius = UDim.new(0, 6) }, c.barBg)
			c.fill = make("Frame", { Name = "HpFill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(U.hp), BorderSizePixel = 0, ZIndex = 8 }, c.barBg)
			make("UICorner", { CornerRadius = UDim.new(0, 6) }, c.fill)
			if isMe then
				c.hp = label(c.frame, { Name = "HpText", TextSize = 14, Text = "", TextXAlignment = Enum.TextXAlignment.Left })
			else
				c.ctx = label(c.frame, { Name = "Context", TextSize = 12, Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rgb(U.muted), TextTruncate = Enum.TextTruncate.AtEnd })
			end
			return c
		end
		S.foeCard = buildCard(false, "FoeCard")
		S.meCard = buildCard(true, "MeCard")
		local function ensureDots(c, n)
			while #c.dots < math.min(n, L.MAX_DOTS) do
				local d = make("Frame", { Name = "TeamDot", Size = UDim2.fromOffset(10, 10), BackgroundColor3 = rgb(U.dotOff), BorderSizePixel = 0, ZIndex = 8 }, c.frame)
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, d)
				c.dots[#c.dots + 1] = d
			end
		end
		ensureDots(S.foeCard, nFoe)
		ensureDots(S.meCard, nMe)
		for i = 1, L.CHARGE_MAX do
			local p = make("Frame", { Name = "ChargePip", Size = UDim2.fromOffset(10, 10), BackgroundColor3 = rgb(U.pipOff), BorderSizePixel = 0, ZIndex = 8 }, S.meCard.frame)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, p)
			S.meCard.pips[i] = p
		end

		S.logFrame = make("Frame", { Name = "LogBar", BackgroundColor3 = rgb(U.log), BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = 6 }, root)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.logFrame)
		make("UIStroke", { Color = rgb(U.cardStroke), Thickness = 1 }, S.logFrame)
		S.status = label(S.logFrame, { Name = "Status", TextSize = 12, Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rgb(U.status), TextTruncate = Enum.TextTruncate.AtEnd })
		S.log = label(S.logFrame, { Name = "LogText", TextSize = 13, Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd })

		S.btn = {
			attack = button("Attack", "⚔ Attaque", U.attack),
			special = button("Special", "Spécial", U.special),
			swap = button("Swap", "🔁 Changer", U.swap, rgb(U.swapText)),
			flee = button("Flee", "🏃 Fuir", U.flee, rgb(U.fleeText)),
		}
		-- bouton Spécial : barre de charge DERRIÈRE le bouton (un dégradé sur le bouton teinterait aussi son texte), échelle et voile du flash quand la charge devient pleine
		S.chargeBar = make("Frame", { Name = "ChargeBar", BackgroundColor3 = rgb(U.specialFill), BorderSizePixel = 0, Visible = false, ZIndex = 9 }, root)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.chargeBar)
		S.sGrad = make("UIGradient", { Name = "ChargeGradient", Rotation = 0 }, S.chargeBar)
		S.sScale = make("UIScale", { Name = "SpecialScale", Scale = 1 }, S.btn.special)
		S.sVeil = make("Frame", { Name = "SpecialFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 12 }, S.btn.special)
		-- pastilles d'état sous les cartes (3 par camp au plus : étourdi, garde, concentration) : chacune est aussi sa zone tactile (>= 44 px de haut) et ouvre une info-bulle
		S.pills = { {}, {} }
		S.pillCount = { 0, 0 }
		S.pillList = { {}, {} }
		for side = 1, 2 do
			for i = 1, L.MAX_PILLS do
				local b = make("TextButton", { Name = "StatePill", Font = FONT, TextSize = 15, Text = "", AutoButtonColor = true, Visible = false, BackgroundColor3 = rgb(U.card), TextColor3 = rgb(U.text), ZIndex = 9 }, root)
				make("UICorner", { CornerRadius = UDim.new(0, 12) }, b)
				S.pills[side][i] = { btn = b, data = nil }
			end
		end
		S.tip = make("TextLabel", { Name = "StateTip", Font = FONT, TextSize = 13, TextWrapped = true, Text = "", BackgroundColor3 = rgb(U.log), BackgroundTransparency = 0.05, TextColor3 = rgb(U.text), Visible = false, ZIndex = 13 }, root)
		function S.layoutPills() -- place les pastilles d'après la disposition courante (sans superposition, voir BattleLayout.pillLayout) ; appelée à chaque mise en page et à chaque mise à jour
			if not S.rects then
				return
			end
			local lay = L.pillLayout(S.rects, S.pillCount[2], S.pillCount[1])
			S.pillLay = lay
			for side = 1, 2 do
				local chips = L.pillChips(S.pillList[side], lay[side].shown, Battle)
				for i, p in ipairs(S.pills[side]) do
					local c = chips[i]
					p.data = c
					p.btn.Visible = c ~= nil and not S.dimmed
					if c then
						p.btn.Text = c.text
						p.btn.BackgroundColor3 = rgb(c.bg)
						p.btn.TextColor3 = rgb(c.fg)
						place(p.btn, lay[side].rects[i])
					end
				end
			end
		end

		-- vitesse (1x / 2x / 3x), « Passer l'animation » (dès le 2e combat vu) et ordre du tour (3 pastilles sous la carte adverse)
		S.btn.speed = button("Speed", o.Layout.speedLabel(S.speed), { 255, 226, 140 })
		S.btn.skip = button("Skip", "⏭ Passer", { 255, 226, 140 })
		S.btn.skip.TextSize = 13
		S.btn.skip.Visible = o.canSkip == true
		S.queueLabel = label(root, { Name = "QueueLabel", TextSize = 12, Text = "Ordre ▸", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = rgb(U.text), ZIndex = 8 })
		S.queue = {}
		for i = 1, 3 do
			local f = make("Frame", { Name = "QueueChip" .. i, BackgroundColor3 = rgb(U.card), BorderSizePixel = 0, ZIndex = 8 }, root)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
			local e = label(f, { Name = "QueueEmoji", TextSize = 16, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 9 })
			S.queue[i] = { frame = f, emoji = e }
		end

		---------------------------------------------------------------- mise en page (appelée à la création et à chaque changement de taille)
		local function layoutCard(c, r)
			place(c.frame, r)
			local inner = L.cardInner(r.w, c.isMe)
			c.accent.Position = UDim2.fromOffset(3, 8)
			c.accent.Size = UDim2.fromOffset(4, r.h - 16)
			place(c.iconText, inner.icon)
			if c.iconImage then
				place(c.iconImage, inner.icon)
			end
			place(c.name, inner.name)
			place(c.level, inner.level)
			place(c.barBg, inner.bar)
			if c.hp then
				place(c.hp, inner.hp)
			end
			if c.ctx then
				place(c.ctx, inner.ctx)
			end
			local n = #c.dots
			for i, d in ipairs(c.dots) do
				local x = c.isMe and (inner.dots.x + inner.dots.w - n * 14 + (i - 1) * 14) or (inner.dots.x + (i - 1) * 14)
				d.Position = UDim2.fromOffset(x, inner.dots.y)
			end
			for i, p in ipairs(c.pips) do
				p.Position = UDim2.fromOffset(inner.pips.x + (i - 1) * 14, inner.pips.y)
			end
		end
		local function relayout()
			local vw, vh = viewportSize()
			local R = L.rects(vw, vh, o.safe)
			S.rects = R
			layoutCard(S.foeCard, R.foeCard)
			layoutCard(S.meCard, R.meCard)
			place(S.logFrame, R.log)
			place(S.status, { x = 10, y = 3, w = R.log.w - 20, h = 16 })
			place(S.log, { x = 10, y = 19, w = R.log.w - 20, h = R.log.h - 22 })
			for _, k in ipairs({ "attack", "special", "swap", "flee" }) do
				place(S.btn[k], R.actions[k])
			end
			place(S.chargeBar, R.actions.special)
			S.layoutPills()
			if S.closeSwap then -- changement de taille : l'écran « Changer » se referme (il se reconstruit à la bonne taille à la réouverture)
				S.closeSwap()
			end
			place(S.btn.speed, R.speed)
			place(S.btn.skip, R.skip)
			place(S.queueLabel, { x = R.queue.x - 62, y = R.queue.y, w = 58, h = R.queue.h })
			for i, q in ipairs(S.queue) do
				local d = R.queue.h
				q.frame.Position = UDim2.fromOffset(R.queue.x + R.queue.w - 3 * d - 2 * 4 + (i - 1) * (d + 4), R.queue.y)
				q.frame.Size = UDim2.fromOffset(d, d)
			end
			local sc = L.scene(vw, vh, o.safe, ground)
			S.sc = sc
			S.cam.FieldOfView = sc.fov
			S.cam.CFrame = CFrame.lookAt(Vector3.new(sc.eye.x, sc.eye.y, sc.eye.z), Vector3.new(sc.target.x, sc.target.y, sc.target.z))
			-- socles : créés une fois, replacés à chaque mise en page
			for side = 1, 2 do
				local pd = S.pedestals[side]
				local pos = side == 1 and sc.me or sc.foe
				pd.pos = pos
				if pd.base == nil then
					pd.base = flatCylinder("PedestalBase" .. side, pos.x, 0.4, pos.z, sc.pedestal * 2, 0.8, pal.deco)
					pd.glow = flatCylinder("PedestalGlow" .. side, pos.x, 0.86, pos.z, sc.pedestal * 1.75, 0.14, pd.color, Enum.Material.Neon)
					if plan.beams then
						pd.column = flatCylinder("PedestalLight" .. side, pos.x, 3.4, pos.z, sc.pedestal * 1.6, 5.2, pd.color, Enum.Material.Neon, 0.85)
					end
				else
					pd.base.CFrame = CFrame.new(pos.x, 0.4, pos.z) * CFrame.Angles(0, 0, math.rad(90))
					pd.glow.CFrame = CFrame.new(pos.x, 0.86, pos.z) * CFrame.Angles(0, 0, math.rad(90))
					if pd.column then
						pd.column.Position = Vector3.new(pos.x, 3.4, pos.z)
					end
				end
				local pz = S.puppets[side]
				if pz and pz.model then
					pz.base = S.faceCF(side, pz.lift)
					pcall(function()
						pz.model:PivotTo(pz.base)
					end)
				end
			end
		end

		---------------------------------------------------------------- créatures procédurales (corps, yeux, oreilles, queue ou bec : 7 instances)
		function S.faceCF(side, y) -- position du pivot (centre du corps, hauteur y) et regard vers l'autre socle
			local sc = S.sc
			local me, foe = sc.me, sc.foe
			local from, to = me, foe
			if side == 2 then
				from, to = foe, me
			end
			return CFrame.lookAt(Vector3.new(from.x, y, from.z), Vector3.new(to.x, y, to.z))
		end
		-- Modèle Blender du pet (mobs, étape 1) : copie légère publiée par le serveur dans ReplicatedStorage.PetModels (ou o.petModels, tests), clonée,
		-- comptée dans le plafond (Model + descendants), mise à la hauteur de combat (BattleLayout.modelHeight), pivot au centre posé sur le socle.
		-- Nil (repli procédural) si absent, trop lourd, hors budget ou illisible.
		local function modelPuppet(side, u, def, sizeScale)
			if type(L.modelFits) ~= "function" then
				return nil
			end
			local made = nil
			local ok, res = pcall(function()
				local folder = o.petModels
				if folder == nil then
					folder = game:GetService("ReplicatedStorage"):FindFirstChild("PetModels")
				end
				local tpl = folder and folder:FindFirstChild(tostring(u.p))
				if tpl == nil then
					return nil
				end
				local n = #tpl:GetDescendants() + 1
				if not L.modelFits(n, S.used, cap) then
					return nil
				end
				local model = tpl:Clone()
				made = model
				local target = L.modelHeight(def.tier, sizeScale, Config.petTargetHeight, Config.TIER_COUNT)
				local f = L.modelScale(model:GetExtentsSize().Y, target)
				if f == nil then
					return nil
				end
				model:ScaleTo(model:GetScale() * f)
				local body, best = nil, -1
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored, d.CanCollide = true, false
						local okV, v = pcall(function()
							return d.Size.X * d.Size.Y * d.Size.Z
						end)
						if okV and type(v) == "number" and v > best then
							body, best = d, v
						end
					end
				end
				if body == nil then
					return nil
				end
				model.Name = "Puppet" .. side
				model:SetAttribute("Source", "model")
				local lift = 0.9 + target / 2
				local base = S.faceCF(side, lift)
				model:PivotTo(base)
				local color = body.Color
				model.Parent = vp
				S.used = S.used + n
				if S.used > S.peak then
					S.peak = S.used
				end
				made = nil
				return { model = model, body = body, base = base, lift = lift, count = n, busy = 0, color = color, source = "model" }
			end)
			if made ~= nil then -- refusé ou erreur après la copie : la copie (jamais comptée) est détruite
				pcall(function()
					made:Destroy()
				end)
			end
			if ok then
				return res
			end
			return nil
		end
		S.modelPuppet = modelPuppet
		local function buildPuppet(side, u)
			local def = Config.PETS[u.p] or { color = Color3.fromRGB(200, 200, 200), ears = "round", extra = "none" }
			local scale = 1
			local sz = Config.SIZES and Config.SIZES[u.s]
			if sz and type(sz.scale) == "number" then
				scale = math.max(0.8, math.min(1.4, sz.scale))
			end
			local fromModel = modelPuppet(side, u, def, sz and sz.scale)
			if fromModel then
				return fromModel
			end
			local R = 1.5 * scale
			local before = S.used
			local model = make("Model", { Name = "Puppet" .. side }, vp)
			local col = def.color
			local function ball(nm, ox, oy, oz, d, c)
				return make("Part", { Name = nm, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), Anchored = true, CanCollide = false, Color = c, Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(ox, oy, oz) }, model)
			end
			local function block(nm, ox, oy, oz, sx, sy, sz2, c, rotZ)
				return make("Part", { Name = nm, Size = Vector3.new(sx, sy, sz2), Anchored = true, CanCollide = false, Color = c, Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(ox, oy, oz) * CFrame.Angles(0, 0, rotZ or 0) }, model)
			end
			local lift = 0.9 + R
			local body = ball("Body", 0, 0, 0, 2 * R, col)
			model.PrimaryPart = body
			local dark = Color3.fromRGB(25, 25, 30)
			ball("EyeL", -0.42 * R, 0.25 * R, -0.86 * R, 0.36 * R, dark)
			ball("EyeR", 0.42 * R, 0.25 * R, -0.86 * R, 0.36 * R, dark)
			local ears = def.ears or "round"
			if ears == "point" then
				block("EarL", -0.55 * R, 1.0 * R, 0, 0.5 * R, 0.9 * R, 0.2 * R, col, math.rad(15))
				block("EarR", 0.55 * R, 1.0 * R, 0, 0.5 * R, 0.9 * R, 0.2 * R, col, math.rad(-15))
			elseif ears == "long" then
				block("EarL", -0.4 * R, 1.35 * R, 0, 0.35 * R, 1.4 * R, 0.2 * R, col, math.rad(8))
				block("EarR", 0.4 * R, 1.35 * R, 0, 0.35 * R, 1.4 * R, 0.2 * R, col, math.rad(-8))
			elseif ears == "floppy" then
				block("EarL", -0.95 * R, 0.55 * R, 0, 0.5 * R, 0.9 * R, 0.2 * R, col, math.rad(40))
				block("EarR", 0.95 * R, 0.55 * R, 0, 0.5 * R, 0.9 * R, 0.2 * R, col, math.rad(-40))
			elseif ears ~= "none" then
				ball("EarL", -0.7 * R, 0.85 * R, 0, 0.5 * R, col)
				ball("EarR", 0.7 * R, 0.85 * R, 0, 0.5 * R, col)
			end
			local extra = def.extra or "none"
			if extra == "beak" then
				block("Beak", 0, -0.05 * R, -1.05 * R, 0.4 * R, 0.25 * R, 0.5 * R, Color3.fromRGB(255, 160, 40), 0)
			elseif extra == "tail" then
				ball("Tail", 0, -0.1 * R, 1.0 * R, 0.5 * R, col)
			end
			local base = S.faceCF(side, lift)
			model:PivotTo(base)
			return { model = model, body = body, base = base, lift = lift, count = S.used - before, busy = 0, color = col, source = "procedural" }
		end
		local function destroyPuppet(pz)
			if pz and pz.model then
				pcall(function()
					pz.model:Destroy()
				end)
				release(pz.count or 0)
			end
		end
		S.destroyPuppet = destroyPuppet
		function S.setPuppet(side, u, animateIn)
			local old = S.puppets[side]
			S.puppets[side] = nil
			destroyPuppet(old) -- l'ancienne créature part AVANT la construction (jamais trois créatures en même temps : budget libéré pour un modèle)
			local newp = buildPuppet(side, u)
			S.puppets[side] = newp
			if animateIn then
				newp.busy = newp.busy + 1
				animate(0.3, function(a)
					if newp.model then
						newp.model:PivotTo(newp.base * CFrame.new(0, 6 * (1 - a) * (1 - a), 0))
					end
					if a >= 1 then
						newp.busy = math.max(0, newp.busy - 1)
					end
				end)
			end
		end
		S.build = buildPuppet

		relayout()
		S.relayout = relayout
		for side = 1, 2 do
			local sd = view0.sides[side]
			local u = sd.units[sd.active]
			if u then
				S.puppets[side] = nil
				S.setPuppet(side, u, false)
				S.cur[side] = tostring(u.p) .. ":" .. tostring(sd.active)
			end
		end
	end)
	if not okBuild then
		S.alive = false
		if S.root then
			pcall(function()
				S.root:Destroy()
			end)
		end
		return nil, err
	end

	---------------------------------------------------------------- API
	local scene = { root = S.root, viewport = S.vp, shake = S.vp, plan = plan, mode = mode, ground = ground }

	function scene.count()
		return S.used
	end
	function scene.peak()
		return S.peak
	end
	function scene.alive()
		return S.alive
	end

	-- PV : la barre se vide (ou se remplit) en ~0,5 s et le chiffre défile, sans saut ; une nouvelle valeur reprend là où le défilement en est
	local function showHp(c, v, max)
		local frac = max > 0 and math.max(0, math.min(1, v / max)) or 0
		c.fill.Size = UDim2.fromScale(frac, 1)
		c.fill.BackgroundColor3 = rgb(L.hpColor(frac))
		if c.hp then
			c.hp.Text = math.max(0, math.floor(v + 0.0001)) .. "/" .. math.floor(max) .. (c.hpExtra or "")
		end
	end
	local function rollHp(c, u, instant, delay)
		local max = u and type(u.maxHp) == "number" and u.maxHp or 0
		local to = u and type(u.hp) == "number" and math.max(0, math.min(max, u.hp)) or 0
		local from = c.shownHp
		c.rollToken = (c.rollToken or 0) + 1
		local token = c.rollToken
		if instant or from == nil or c.shownMax ~= max then
			c.shownHp, c.shownMax = to, max
			showHp(c, to, max)
			return
		end
		c.shownMax = max
		if from == to then
			showHp(c, to, max)
			return
		end
		local function run()
			if c.rollToken ~= token or not S.alive then
				return
			end
			animate(L.HP_ROLL_SECONDS, function(a)
			if c.rollToken ~= token then
				return
			end
				local v = L.hpRoll(from, to, a)
				c.shownHp = v
				showHp(c, a >= 1 and to or L.hpRollInt(from, to, a), max)
				if a >= 1 then
					c.shownHp = to
				end
			end)
		end
		if type(delay) == "number" and delay > 0 then -- la barre se vide à l'impact du coup, pas avant
			task.delay(delay, run)
		else
			run()
		end
	end
	local function setIcon(c, u)
		local typ = u and u.type
		c.accent.BackgroundColor3 = rgb(L.typeColor(typ))
		local key = Config.TYPE_ICON and Config.TYPE_ICON[typ]
		local url = key and type(o.iconUrl) == "function" and o.iconUrl(key) or nil
		if url and c.iconImage == nil and S.used < cap then
			c.iconImage = make("ImageLabel", { Name = "TypeIcon", BackgroundTransparency = 1, Image = url, ZIndex = 9 }, c.frame)
			local r = S.rects and (c.isMe and S.rects.meCard or S.rects.foeCard)
			if r then
				local inner = L.cardInner(r.w, c.isMe)
				place(c.iconImage, inner.icon)
			end
		elseif url and c.iconImage then
			c.iconImage.Image = url
		end
		c.iconText.Text = c.iconImage and "" or ((Battle.TYPE_EMOJI and Battle.TYPE_EMOJI[typ]) or "")
	end
	local function unitName(u)
		local def = u and Config.PETS[u.p]
		return def and (def.emoji .. " " .. def.name) or "?"
	end
	local function updateCard(c, side, animateIt, hpDelay)
		local u = side.units[side.active]
		c.name.Text = unitName(u)
		c.level.Text = L.levelText(u)
		local key = u and (tostring(u.p) .. ":" .. tostring(side.active)) or nil
		c.hpExtra = (u and u.guard and " 🛡" or "") .. (u and type(u.stun) == "number" and u.stun > 0 and " 💫" or "") .. (u and type(u.focus) == "number" and u.focus > 0 and " ⚡" or "")
		rollHp(c, u, animateIt ~= true or key ~= c.unitKey, hpDelay)
		c.unitKey = key
		setIcon(c, u)
		local dots = L.teamDots(side)
		for i, d in ipairs(c.dots) do
			local info = dots[i]
			d.BackgroundColor3 = rgb(info and info.alive and U.dotOn or U.dotOff)
			d.Size = UDim2.fromOffset(info and info.active and 11 or 10, info and info.active and 11 or 10)
		end
	end

	function scene.setContext(text)
		S.foeCard.ctx.Text = tostring(text or "")
	end
	function scene.setStatus(text)
		S.status.Text = tostring(text or "")
	end
	function scene.setLog(lines)
		S.log.Text = type(lines) == "table" and table.concat(lines, "\n") or tostring(lines or "")
	end

	-- Bouton Spécial : texte, prêt ou non, et animation de charge (la partie chargée du fond est claire, le reste sombre ; coupure nette à charge / max).
	local function setSpecialButton(sb)
		local b = S.btn.special
		b.Text = sb.text
		b.AutoButtonColor = sb.ready
		b.BackgroundColor3 = rgb(U.special)
		b.BackgroundTransparency = sb.ready and 0 or 1 -- pas prêt : le fond est la barre de charge placée derrière
		b.TextColor3 = sb.ready and rgb(U.darkText) or rgb(U.offText)
		local frac = sb.ready and 1 or L.chargeFill(sb.charge, sb.max)
		S.chargeFrac = frac
		S.specialReady = sb.ready == true
		S.chargeBar.Visible = not sb.ready and not S.dimmed
		pcall(function()
			local pts = {}
			for _, p in ipairs(L.chargeStops(frac, 0.55)) do
				pts[#pts + 1] = ColorSequenceKeypoint.new(p.t, Color3.new(p.m, p.m, p.m))
			end
			S.sGrad.Color = ColorSequence.new(pts)
		end)
	end
	-- Flash du spécial (charge pleine pour le MÊME pet) : voile blanc qui s'éteint, bouton qui gonfle de 12 % puis revient, son « special_ready ». Au plus 1,5 s (0,35 s en
	-- effets réduits), divisé par la vitesse ; « Passer » le termine ; un seul flash à la fois ; arrêté à la destruction.
	function S.flashSpecial()
		S.flashToken = (S.flashToken or 0) + 1
		local token = S.flashToken
		local dur = L.flashSeconds(o.reduced == true, S.speed)
		if type(o.sound) == "function" then
			pcall(o.sound, "special_ready")
		end
		S.sVeil.Visible = true
		local gen = S.skipGen
		task.spawn(function()
			local t0 = os.clock()
			while S.alive and S.flashToken == token do
				local a = (os.clock() - t0) / math.max(0.02, dur)
				if S.skipGen ~= gen then
					a = 1
				end
				local f = L.specialFlash(a)
				pcall(function()
					S.sVeil.BackgroundTransparency = f.veilTransparency
					S.sScale.Scale = o.reduced == true and 1 or f.scale
				end)
				if a >= 1 then
					break
				end
				task.wait(0.03)
			end
			if S.alive and S.flashToken == token then
				pcall(function()
					S.sVeil.Visible = false
					S.sVeil.BackgroundTransparency = 1
					S.sScale.Scale = 1
				end)
			end
		end)
	end
	local function setPips(c, mu)
		local info = L.chargePips(mu and mu.charge, mu and mu.chargeMax)
		if c.pulseTween then
			pcall(function()
				c.pulseTween:Cancel()
			end)
			c.pulseTween = nil
		end
		for i, p in ipairs(c.pips) do
			p.BackgroundColor3 = rgb(info.pips[i] and U.pipOn or U.pipOff)
			p.Size = UDim2.fromOffset(10, 10)
		end
		local last = c.pips[#c.pips]
		if info.ready and last and mu and type(mu.charge) == "number" and not o.reduced then
			c.pulseTween = tween(last, 0.45, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		end
	end
	-- Le bouton « Changer » n'est actif que s'il reste au moins un pet vivant en réserve.
	local function updateSwapButton(sd)
		local any = false
		for _, e in ipairs(L.bench(sd)) do
			if e.alive then
				any = true
			end
		end
		S.swapAny = any
		S.btn.swap.AutoButtonColor = any
		S.btn.swap.BackgroundColor3 = rgb(any and U.swap or U.specialOff)
		S.btn.swap.TextColor3 = rgb(any and U.swapText or U.offText)
	end

	-- Pastilles d'état d'un camp (1 = joueur, 2 = adversaire) : icône + durée, couleur propre à chaque état, rien pour un pet K.O.
	local function setPills(sideIdx, u)
		local list = L.statusPills(u)
		S.pillCount[sideIdx] = #list
		S.pillList[sideIdx] = list
		S.layoutPills()
		if S.tipSide == sideIdx and #list == 0 then
			S.hideTip()
		end
	end
	function S.hideTip()
		S.tipToken = (S.tipToken or 0) + 1
		S.tipSide = nil
		S.tip.Visible = false
	end
	-- Info-bulle d'une pastille : icône, nom et durée (BattleLayout.pillDetail) ; disparaît seule après TIP_SECONDS ou au toucher suivant.
	function S.showTip(sideIdx, i)
		local p = S.pills[sideIdx][i]
		if not (p and p.data and S.alive and not S.dimmed) then
			return
		end
		S.tipToken = (S.tipToken or 0) + 1
		local token = S.tipToken
		local vw, vh = viewportSize()
		vw, vh = L.viewport(vw, vh)
		local r = S.pillLay and S.pillLay[sideIdx].rects[i] or nil
		local lines = 1
		for _ in string.gmatch(p.data.detail, "\n") do
			lines = lines + 1
		end
		local w, h = math.min(300, vw - 16), 20 + 24 * lines
		S.tip.Text = p.data.detail
		S.tip.Size = UDim2.fromOffset(w, h)
		local x = math.max(8, math.min(vw - 8 - w, (r and r.x or 8) - 8))
		local y = sideIdx == 2 and ((r and (r.y + r.h) or 0) + 4) or ((r and r.y or 0) - 4 - h)
		S.tip.Position = UDim2.fromOffset(x, math.max(0, math.min(vh - h, y)))
		S.tip.Visible = true
		S.tipSide = sideIdx
		task.delay(L.TIP_SECONDS, function()
			if S.alive and S.tipToken == token then
				S.hideTip()
			end
		end)
	end

	-- Écran dédié « Changer » : une ligne par pet de l'équipe (nom, niveau, PV chiffrés et barre, charge du spécial, état). Pet K.O. : grisé, non cliquable ; pet au combat :
	-- affiché, non cliquable ; les autres envoient « swapN » (intention seule, le serveur revalide). Construit à l'ouverture, détruit à la fermeture (aucune instance qui traîne).
	function S.closeSwap()
		local ui = S.swapUi
		if not ui then
			return
		end
		S.swapUi = nil
		for _, c in ipairs(ui.conns or {}) do
			pcall(function()
				c:Disconnect()
			end)
		end
		pcall(function()
			ui.frame:Destroy()
		end)
		release(ui.count)
	end
	function S.openSwap()
		if S.swapUi or S.dimmed or not S.alive or not S.lastView or not S.swapAny then
			return
		end
		local rows = L.swapRows(S.lastView.sides[1])
		if #rows == 0 then
			return
		end
		S.hideTip()
		local vw, vh = viewportSize()
		local Rs = L.swapRects(vw, vh, o.safe, #rows)
		local before = S.used
		local okOpen, ui = pcall(function()
			local px, py = Rs.panel.x, Rs.panel.y
			local function rel(r)
				return { x = r.x - px, y = r.y - py, w = r.w, h = r.h }
			end
			local function place(inst, r)
				inst.Position = UDim2.fromOffset(r.x, r.y)
				inst.Size = UDim2.fromOffset(r.w, r.h)
			end
			local function label(parent, props)
				props.BackgroundTransparency = 1
				props.Font = FONT
				props.TextColor3 = props.TextColor3 or rgb(U.text)
				return make("TextLabel", props, parent)
			end
			local frame = make("Frame", { Name = "SwapScreen", BackgroundColor3 = rgb(U.card), BackgroundTransparency = 0.04, BorderSizePixel = 0, ZIndex = 14, Active = true }, S.root)
			place(frame, Rs.panel)
			S.swapTmp = frame
			local u = { frame = frame, rows = {}, conns = {} }
			local function conn(sig, fn)
				u.conns[#u.conns + 1] = sig:Connect(fn)
			end
			local title = label(frame, { Name = "SwapTitle", TextSize = 18, Text = "🔁 Changer de pet", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 15 })
			place(title, rel(Rs.title))
			local note = label(frame, { Name = "SwapNote", TextSize = 12, Text = "Changer remplace ton action et passe en premier.", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rgb(U.muted), ZIndex = 15 })
			place(note, rel(Rs.note))
			for i, row in ipairs(rows) do
				local def = Config.PETS[row.p]
				local bg = row.state == "ready" and U.swap or (row.state == "active" and U.rowActive or U.specialOff)
				local fg = row.state == "ready" and U.swapText or (row.state == "active" and U.text or U.offText)
				local b = make("TextButton", { Name = "SwapRow" .. row.index, Font = FONT, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutoButtonColor = row.clickable, Active = row.clickable, BackgroundColor3 = rgb(bg), TextColor3 = rgb(fg), ZIndex = 15,
					Text = " " .. (def and (def.emoji .. " " .. def.name) or "?") .. " · " .. row.level .. " · " .. row.tag .. "\n " .. row.hpText .. " PV · " .. row.chargeText .. " " .. row.pipsText }, frame)
				make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
				local rr = rel(Rs.rows[i])
				place(b, rr)
				local barBg = make("Frame", { Name = "SwapHpBack", BackgroundColor3 = rgb(U.hpBack), BorderSizePixel = 0, Position = UDim2.fromOffset(8, rr.h - 9), Size = UDim2.fromOffset(rr.w - 16, 5), ZIndex = 16 }, b)
				make("Frame", { Name = "SwapHpFill", BackgroundColor3 = rgb(L.hpColor(row.frac)), BorderSizePixel = 0, Size = UDim2.fromScale(row.frac, 1), ZIndex = 17 }, barBg)
				u.rows[i] = b
				local index, clickable = row.index, row.clickable
				conn(b.Activated, function()
					if clickable and S.swapUi == u then -- jamais un pet K.O. ni le pet déjà au combat
						S.closeSwap()
						if type(o.sound) == "function" then
							pcall(o.sound, "click")
						end
						o.fire("battleAct", "swap" .. index)
						if type(o.onChosen) == "function" then
							o.onChosen()
						end
					elseif S.swapUi == u and type(o.sound) == "function" then
						pcall(o.sound, "refuse")
					end
				end)
			end
			local back = make("TextButton", { Name = "SwapBack", Font = FONT, TextSize = 15, Text = "↩ Retour", AutoButtonColor = true, BackgroundColor3 = rgb(U.flee), TextColor3 = rgb(U.fleeText), ZIndex = 15 }, frame)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, back)
			place(back, rel(Rs.back))
			conn(back.Activated, function()
				S.closeSwap()
			end)
			return u
		end)
		if okOpen and ui then
			ui.count = S.used - before
			S.swapUi = ui
		else
			pcall(function()
				S.swapTmp:Destroy()
			end)
			release(S.used - before)
		end
		S.swapTmp = nil
	end

	-- Applique la vue du serveur (PV, niveaux, points d'état, charge, créatures). `info.delay` : retard (s) du remplacement d'une créature (laisse jouer les coups).
	function scene.update(view, info)
		if not S.alive or type(view) ~= "table" or type(view.sides) ~= "table" then
			return
		end
		local delay = type(info) == "table" and type(info.delay) == "number" and info.delay or 0
		S.lastView = view
		local me, foe = view.sides[1], view.sides[2]
		if not (me and foe and me.units and foe.units) then
			return
		end
		pcall(function()
			local hit = S.hitAt or {}
			S.hitAt = {}
			updateCard(S.foeCard, foe, true, hit[2])
			updateCard(S.meCard, me, true, hit[1])
			scene.setQueue(L.turnQueue(info and info.events, view, 3), me.units[me.active], foe.units[foe.active])
			local mu = me.units[me.active]
			setPips(S.meCard, mu)
			local ss = o.specialState and mu and o.specialState(mu) or { text = "Spécial", ready = true }
			local sb = L.specialButton(ss)
			setSpecialButton(sb)
			-- flash : seulement quand la charge du MÊME pet devient pleine (jamais au changement de pet ni à la 1re vue)
			local curKey = mu and (tostring(mu.p) .. ":" .. tostring(me.active)) or nil
			local cur = { key = curKey, full = type(mu) == "table" and L.chargePips(mu.charge, mu.chargeMax).ready == true }
			local trans = L.specialTransition(S.specialPrev, cur)
			S.specialPrev = cur
			if trans == "flash" and not view.over then
				if delay > 0 then -- le flash attend la fin des coups du tour
					task.delay(delay, function()
						if S.alive and not S.dimmed then
							S.flashSpecial()
						end
					end)
				else
					S.flashSpecial()
				end
			end
			updateSwapButton(me)
			S.setTray(false)
			setPills(1, mu)
			setPills(2, foe.units[foe.active])
			for side = 1, 2 do
				local sd = view.sides[side]
				local u = sd.units[sd.active]
				local pd = S.pedestals[side]
				if u and pd then
					local tcol = L.typeColor(u.type)
					pd.glow.Color = rgb(tcol)
					if pd.column then
						pd.column.Color = rgb(tcol)
					end
				end
				local key = u and (tostring(u.p) .. ":" .. tostring(sd.active)) or nil
				if u and key ~= S.cur[side] then
					S.cur[side] = key
					S.swapToken[side] = S.swapToken[side] + 1
					local token = S.swapToken[side]
					local old = S.puppets[side]
					local function swapIn()
						if S.alive and S.swapToken[side] == token then
							S.setPuppet(side, u, true)
						end
					end
					if old and old.model and delay > 0 then
						task.delay(delay, function()
							if S.alive and S.swapToken[side] == token then
								old.busy = old.busy + 1
								animate(0.22, function(a)
									if old.model and old.model.Parent then
										old.model:PivotTo(old.base * CFrame.new(0, -3 * a, 0))
									end
									if a >= 1 then
										swapIn()
									end
								end)
							end
						end)
					else
						swapIn()
					end
				end
			end
			if view.over then
				for _, b in pairs(S.btn) do
					b.AutoButtonColor = false
				end
			end
		end)
	end

	-- Position de l'écran (coordonnées de l'interface) au-dessus d'une créature : projection par la caméra de la scène, sinon estimation pure de BattleLayout.
	function scene.anchor(side)
		local sc = S.sc
		local ok, x, y = pcall(function()
			local pos = side == 1 and sc.me or sc.foe
			local v = S.cam:WorldToViewportPoint(Vector3.new(pos.x, 3.2, pos.z))
			return v.X - 5, v.Y - 5
		end)
		if ok and type(x) == "number" and type(y) == "number" and x == x and y == y then
			return x, y
		end
		local vw, vh = viewportSize()
		local a = L.anchor(side, vw, vh, o.safe)
		return a.x, a.y
	end

	-- Étiquette flottante au-dessus d'une créature (nombre de dégâts ou message de type) ; au plus MAX_POPUPS à la fois, détruite après 0,8 s au plus
	local function popup(side, text, color, size, rise, lift)
		if S.popups >= L.MAX_POPUPS or not S.alive then
			return
		end
		S.popups = S.popups + 1
		local x, y = scene.anchor(side)
		local ok, lbl = pcall(function()
			return make("TextLabel", { Name = "Popup", BackgroundTransparency = 1, Font = FONT, TextSize = size or 24, Text = text, TextColor3 = rgb(color), TextStrokeTransparency = 0.2, TextStrokeColor3 = Color3.fromRGB(10, 14, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y - (lift or 14)), Size = UDim2.fromOffset(200, 32), ZIndex = 9 }, S.root)
		end)
		if not ok then
			S.popups = S.popups - 1
			return
		end
		local dur = L.animSeconds(0.8, S.speed)
		tween(lbl, dur, { Position = UDim2.fromOffset(x, y - (lift or 14) - (rise or 40)), TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(dur + 0.05, function()
			pcall(function()
				lbl:Destroy()
			end)
			release(1)
			S.popups = math.max(0, S.popups - 1)
		end)
	end

	local function lunge(side)
		local pz = S.puppets[side]
		if not (pz and pz.model) then
			return
		end
		pz.busy = pz.busy + 1
		animate(0.32, function(a)
			if pz.model and pz.model.Parent then
				pz.model:PivotTo(pz.base * CFrame.new(0, 0.6 * math.sin(math.pi * a), -3.2 * math.sin(math.pi * a)))
			end
			if a >= 1 then
				pz.busy = math.max(0, pz.busy - 1)
			end
		end)
	end
	local function recoil(side)
		local pz = S.puppets[side]
		if not (pz and pz.model) then
			return
		end
		pz.busy = pz.busy + 1
		pcall(function()
			pz.body.Color = Color3.fromRGB(255, 255, 255)
		end)
		animate(0.3, function(a)
			if pz.model and pz.model.Parent then
				pz.model:PivotTo(pz.base * CFrame.new(math.sin(a * 28) * 0.4 * (1 - a), 0, 0))
			end
			if a >= 0.35 then
				pcall(function()
					pz.body.Color = pz.color
				end)
			end
			if a >= 1 then
				pz.busy = math.max(0, pz.busy - 1)
			end
		end)
	end
	local function hop(side)
		local pz = S.puppets[side]
		if not (pz and pz.model) then
			return
		end
		pz.busy = pz.busy + 1
		animate(0.35, function(a)
			if pz.model and pz.model.Parent then
				pz.model:PivotTo(pz.base * CFrame.new(0, 1.2 * math.sin(math.pi * a), 0))
			end
			if a >= 1 then
				pz.busy = math.max(0, pz.busy - 1)
			end
		end)
	end

	-- Animations des événements d'un tour, dans l'ordre : élan de l'attaquant, MESSAGE DE TYPE tout de suite (avant le résultat), puis à l'impact (0,16 s) recul de la
	-- cible, nombre de dégâts coloré par efficacité avec icône et début du défilement des PV. Coups décalés (cadence de BattleLayout, divisée par la vitesse). « Passer »
	-- annule ce qui n'a pas démarré. Retourne la durée totale (s) pour différer le remplacement d'une créature. Ne touche JAMAIS au serveur ni au minuteur du tour.
	function scene.cues(events)
		local k = 0
		local gen = S.skipGen
		S.hitAt = {}
		local step = L.animSeconds(0.6, S.speed)
		-- sons du tour (Config.SOUNDS seulement) : attaque = son du type, spécial = special_hit, changement voulu = click ; BattleUi laisse les effets de type jouer les attaques (attackSounds = false)
		for _, sn in ipairs(L.soundPlan(Config, events, { typeOf = function(p) return Battle.SPECIES_TYPE and Battle.SPECIES_TYPE[p] or nil end, speed = S.speed, attackSounds = o.attackSounds ~= false })) do
			task.delay(sn.at, function()
				if S.alive and S.skipGen == gen and type(o.sound) == "function" then
					pcall(o.sound, sn.key)
				end
			end)
		end
		for _, ev in ipairs(events or {}) do
			local cue = L.cue(ev)
			if cue then
				local at = step * k
				local impact = at + L.animSeconds(0.16, S.speed)
				if cue.anim == "attack" and S.hitAt[cue.target] == nil then
					S.hitAt[cue.target] = impact
				end
				task.delay(at, function()
					if not S.alive or S.skipGen ~= gen then
						return
					end
					pcall(function()
						if cue.anim == "attack" then
							lunge(cue.actor)
							if cue.message then
								popup(cue.target, cue.message.icon .. " " .. cue.message.text, cue.message.rgb, 18, 26, 54)
							end
							task.delay(L.animSeconds(0.16, S.speed), function()
								if S.alive and S.skipGen == gen then
									pcall(recoil, cue.target)
									if cue.popup then
										pcall(popup, cue.popup.side, cue.popup.text, cue.popup.rgb, cue.special and 28 or 24, 40, 14)
									end
								end
							end)
						elseif cue.anim == "heal" or cue.anim == "guard" then
							hop(cue.actor)
							if cue.popup then
								popup(cue.popup.side, cue.popup.text, cue.popup.rgb, 22, 36, 14)
							end
						end
					end)
				end)
				if cue.anim == "attack" or cue.anim == "heal" then
					k = k + 1
				end
			end
		end
		return step * k + L.animSeconds(0.2, S.speed)
	end

	-- Ordre du tour : 3 pastilles (emoji du pet qui agit) sous la carte adverse ; la première est mise en avant.
	function scene.setQueue(sides, mu, fu)
		local function emoji(u)
			local def = u and Config.PETS[u.p]
			return def and def.emoji or "?"
		end
		for i, q in ipairs(S.queue) do
			local side = sides[i]
			q.frame.Visible = side ~= nil
			if side then
				q.frame.BackgroundColor3 = rgb(side == 1 and U.meChip or U.foeChip)
				q.emoji.Text = emoji(side == 1 and mu or fu)
				q.frame.BackgroundTransparency = i == 1 and 0 or 0.35
			end
		end
	end

	function scene.setSpeed(v)
		S.speed = math.max(1, math.min(3, math.floor(v or 1)))
		S.btn.speed.Text = L.speedLabel(S.speed)
	end
	function scene.skip() -- termine immédiatement les animations en cours (le jeu et le serveur ne sont pas concernés)
		S.skipGen = S.skipGen + 1
	end
	function scene.setCanSkip(v)
		S.canSkip = v == true
		S.btn.skip.Visible = S.canSkip and not S.dimmed
	end
	S.canSkip = o.canSkip == true

	function scene.setDim(on)
		S.dimmed = on == true
		S.dim.Visible = true
		if on then
			S.dim.BackgroundTransparency = 1
			tween(S.dim, 0.8, { BackgroundTransparency = 0.45 })
		else
			S.dim.BackgroundTransparency = 1
			S.dim.Visible = false
		end
		for _, b in pairs(S.btn) do
			b.Visible = not on
		end
		S.btn.skip.Visible = not on and S.canSkip
		S.logFrame.Visible = not on
		S.closeSwap()
		S.hideTip()
		S.chargeBar.Visible = not on and S.specialReady ~= true
		for side = 1, 2 do
			for _, p in ipairs(S.pills[side]) do
				p.btn.Visible = not on and p.data ~= nil
			end
		end
	end

	function S.setTray(v) -- ouvre (true) ou ferme (false) l'écran « Changer »
		if v == true then
			S.openSwap()
		else
			S.closeSwap()
		end
	end
	local function act(action)
		if not S.alive or S.dimmed then
			return
		end
		if type(o.sound) == "function" then -- un son par action (Config.SOUNDS, coupé si SOUNDS_ENABLED = false : géré par l'appelant)
			pcall(o.sound, "click")
		end
		o.fire("battleAct", action)
		if type(o.onChosen) == "function" then
			o.onChosen()
		end
	end
	local function conn(sig, fn)
		local c = sig:Connect(fn)
		S.conns[#S.conns + 1] = c
	end
	conn(S.btn.attack.Activated, function()
		S.setTray(false)
		act("attack")
	end)
	conn(S.btn.special.Activated, function()
		S.setTray(false)
		local mu = S.lastView and S.lastView.sides[1].units[S.lastView.sides[1].active]
		local ss = mu and o.specialState and o.specialState(mu)
		if ss and ss.ready then -- le serveur revalide (« spécial pas prêt (x/5) ») : ce test n'est que du confort
			act("skill")
		elseif ss then
			if type(o.sound) == "function" then
				pcall(o.sound, "refuse")
			end
			scene.setStatus("Spécial pas prêt (" .. tostring(ss.charge or 0) .. "/" .. tostring(ss.max or L.CHARGE_MAX) .. ") : attaque pour charger !")
		end
	end)
	conn(S.btn.swap.Activated, function()
		if S.dimmed then
			return
		end
		if S.swapUi then
			S.closeSwap()
		elseif S.swapAny then
			if type(o.sound) == "function" then
				pcall(o.sound, "click")
			end
			S.openSwap()
		elseif type(o.sound) == "function" then -- plus aucun pet vivant en réserve : rien à ouvrir
			pcall(o.sound, "refuse")
		end
	end)
	for side = 1, 2 do -- toucher une pastille d'état : info-bulle (icône, nom, durée) ; la même pastille la referme
		for i, p in ipairs(S.pills[side]) do
			conn(p.btn.Activated, function()
				if S.tip.Visible and S.tipSide == side and S.tipIndex == i then
					S.hideTip()
				else
					S.showTip(side, i)
					S.tipIndex = i
				end
			end)
		end
	end
	conn(S.btn.speed.Activated, function() -- 1x -> 2x -> 3x -> 1x ; mémorisé par l'appelant (réglage local)
		local v = L.speedNext(S.speed)
		scene.setSpeed(v)
		if type(o.sound) == "function" then
			pcall(o.sound, "click")
		end
		if type(o.onSpeed) == "function" then
			pcall(o.onSpeed, v)
		end
	end)
	conn(S.btn.skip.Activated, function() -- « Passer l'animation » : les animations en cours se terminent aussitôt
		scene.skip()
		if type(o.onSkip) == "function" then
			pcall(o.onSkip)
		end
	end)
	local fleeConfirm = true -- deux appuis seulement si l'abandon coûte (duel, classé) ; un seul en tour / PNJ (L.fleeNeedsConfirm)
	if type(L.fleeNeedsConfirm) == "function" then
		fleeConfirm = L.fleeNeedsConfirm(mode) ~= false
	end
	conn(S.btn.flee.Activated, function()
		if S.dimmed then
			return
		end
		S.setTray(false)
		if S.fleeToken > 0 or not fleeConfirm then
			S.fleeToken = 0
			S.btn.flee.Text = "🏃 Fuir"
			if type(o.onFlee) == "function" then
				o.onFlee()
			else
				o.fire("battleQuit")
			end
			return
		end
		S.fleeToken = S.fleeToken + 1
		local token = S.fleeToken
		S.btn.flee.Text = "Sûr ?"
		task.delay(3, function()
			if S.alive and S.fleeToken == token then
				S.fleeToken = 0
				S.btn.flee.Text = "🏃 Fuir"
			end
		end)
	end)
	pcall(function()
		conn(o.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
			if S.alive then
				pcall(S.relayout)
			end
		end)
	end)

	if plan.bob then -- balancement au repos (une seule boucle, 15 Hz) ; arrêtée à la destruction
		task.spawn(function()
			while S.alive do
				task.wait(0.07)
				local t = os.clock()
				for side = 1, 2 do
					local pz = S.puppets[side]
					if pz and pz.busy == 0 and pz.model and pz.base then
						pcall(function()
							pz.model:PivotTo(pz.base * CFrame.new(0, math.sin(t * 2.2 + side) * 0.12, 0))
						end)
					end
				end
			end
		end)
	end

	-- Destruction complète : boucles arrêtées, connexions coupées, racine (donc tout le monde 3D et l'interface) détruite.
	function scene.destroy()
		if not S.alive then
			return
		end
		pcall(S.closeSwap) -- coupe les connexions de l'écran « Changer » s'il est ouvert
		S.alive = false
		for _, c in ipairs(S.conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		S.conns = {}
		pcall(function()
			S.root:Destroy()
		end)
		S.used = 0
		S.puppets = {}
	end

	scene.update(view0, nil)
	return scene
end

return BattleScene
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX90"><Properties><string name="Name">HatchFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/HatchFx   (lot 10, B.3)
-- Exécute le plan d'éclosion calculé par ReplicatedStorage/HatchPlan (10 animations, une par rareté). 100 % dessiné par le code : Frames, TextLabels, UICorner,
-- UIGradient, UIStroke, TweenService, plus un ColorCorrectionEffect temporaire (teinte / désaturation) et le champ de vision de la caméra (zoom). Aucun asset.
-- Tout est sous pcall ; durée <= 8 s ; l'œuf, la caméra et l'interface sont TOUJOURS restitués (fin normale, passage par un tap, erreur, ou chien de garde à durée + 0,6 s).
-- Rien ne s'exécute à l'import (le module ne fait que définir des fonctions ; aucun require : tout est injecté).
--
-- BRANCHER (client, à la place de CinematicKit.hatchPlan / RevealFx pour l'éclosion) :
--   local plan = HatchPlan.plan(slot.r, slot.o, { reduced = isMobile, firstTime = firstTimeThisTier, still = carryingEgg })
--   local h = HatchFx.play(screenGui, plan, {
--       colors = { main = tier.color, second = tier.color2 },     -- Color3 de la rareté (Config.TIERS)
--       rarityName = "Légendaire", petText = "🐉",                -- bandeau et pet affiché à la révélation (petText = nil : rien, l'appelant dessine sa carte)
--       slot = { rarity = "Légendaire", size = "Grand", mut = "Doré", pools = { rarity = {...}, size = {...}, mut = {...} } }, -- machine à sous de la rareté 4
--       fmtOdds = Odds.label,                                      -- « 1 sur N » (défaut : « 1 sur N » brut)
--       sound = function(key, volume) ... end,                     -- clés : plan.sound.key, "fanfare" (r >= 8), "secret" (N >= 1 000 000), "divine" (r10)
--       onReveal = function() ... end,                             -- appelé UNE fois au moment de la révélation (ou au passage), affichez la carte du pet ici
--       onDone = function() ... end,                               -- appelé UNE fois à la fin, quoi qu'il arrive
--       hide = { otherScreenGui, ... },                            -- interfaces masquées pendant l'animation puis restituées
--   })
--   h.skip() (passer, ignoré avant plan.skipAfter ou si plan.noSkip), h.stop() (arrêt forcé, tout est restitué), h.isDone(), h.created() (instances créées).
-- Retour : poignée { skip, stop, isDone, created, root } ou nil si la construction a échoué (onReveal puis onDone sont alors appelés quand même).
-- Pas de += ni de continue (lanceur lupa).
local HatchFx = {}

HatchFx.MAX_INSTANCES = 220 -- plafond dur d'instances créées par éclosion (échafaudage, décors compris)
HatchFx.WATCHDOG_MARGIN = 0.6

-- Zoom de la caméra partagé entre éclosions qui se chevauchent : la valeur d'origine est mémorisée par le PREMIER zoom actif et restituée quand le dernier se termine
-- (sinon une éclosion lancée pendant une autre figerait le champ de vision zoomé).
local zoomShared = { base = nil, users = 0 }

local FONT = Enum.Font.GothamBold
local RUNES = { "ᚠ", "ᚢ", "ᚦ", "ᚨ", "ᚱ", "ᚲ", "ᚷ", "ᚹ", "ᛁ", "ᛃ", "ᛇ", "ᛉ" }

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

-- Courbes (0..1 -> 0..1)
local function easeOut(t)
	return 1 - (1 - t) ^ 3
end

-- Paliers du compteur animé (identiques à Odds.countSteps : de 1 à N, ralentissement final, dernier = N).
local function countSteps(target, steps)
	local out = {}
	local prev = 1
	for i = 1, steps do
		local v = 1 + (target - 1) * easeOut(i / steps)
		if target >= 10 then
			v = math.floor(v + 0.5)
		else
			v = math.floor(v * 10 + 0.5) / 10
		end
		if v < prev then
			v = prev
		end
		if i == steps then
			v = target
		end
		out[i] = v
		prev = v
	end
	return out
end

local function defaultOdds(n)
	return "1 sur " .. string.format("%.0f", n)
end

function HatchFx.play(parent, plan, opts)
	opts = type(opts) == "table" and opts or {}
	local done, alive, revealed = false, false, false
	local created = 0
	local root, stage, box, egg, pet, counter, hint, flashF, blackF, cc
	local cam, baseFov, hidden, zoomed = nil, nil, {}, false
	local startClock = os.clock()

	local TweenService, Lighting
	pcall(function()
		TweenService = game:GetService("TweenService")
		Lighting = game:GetService("Lighting")
	end)

	local function make(class, props, par)
		if created >= HatchFx.MAX_INSTANCES then
			error("plafond d'instances")
		end
		created = created + 1
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = par
		return o
	end
	local function tween(obj, seconds, goal, style, dir)
		if TweenService == nil then
			return
		end
		pcall(function()
			TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
		end)
	end
	local function safe(fn, ...)
		if type(fn) == "function" then
			pcall(fn, ...)
		end
	end

	local function restore()
		-- caméra
		if zoomed then
			zoomed = false
			zoomShared.users = math.max(0, zoomShared.users - 1)
			if zoomShared.users == 0 and cam ~= nil and zoomShared.base ~= nil then
				local base = zoomShared.base
				zoomShared.base = nil
				pcall(function()
					cam.FieldOfView = base
				end)
			end
		end
		-- teinte de l'image
		if cc ~= nil then
			pcall(function()
				cc:Destroy()
			end)
			cc = nil
		end
		-- interfaces masquées
		for i = 1, #hidden do
			local h = hidden[i]
			pcall(function()
				h.gui.Enabled = h.was
			end)
		end
		hidden = {}
		if root ~= nil then
			pcall(function()
				root:Destroy()
			end)
		end
	end

	local function reveal()
		if revealed then
			return
		end
		revealed = true
		safe(opts.onReveal)
	end

	local function finish(skipped)
		if done then
			return
		end
		done = true
		alive = false
		if skipped then
			reveal()
		end
		restore()
		reveal() -- garantie : la révélation a toujours lieu avant la fin
		safe(opts.onDone)
	end

	local function colorOf(key, i, n)
		local colors = type(opts.colors) == "table" and opts.colors or {}
		if key == "rainbow" then
			return Color3.fromHSV(((i or 1) - 1) / math.max(n or 1, 1), 0.65, 1)
		elseif key == "second" then
			return colors.second or Color3.fromRGB(184, 134, 11)
		elseif key == "white" then
			return Color3.new(1, 1, 1)
		elseif key == "black" then
			return Color3.fromRGB(16, 16, 20)
		elseif key == "gold" then
			return Color3.fromRGB(255, 205, 60)
		elseif key == "red" then
			return Color3.fromRGB(255, 70, 40)
		end
		return colors.main or Color3.fromRGB(255, 205, 60)
	end

	-- boucle bornée : fn(progression 0..1) tant que l'animation vit
	local function every(dur, fn)
		task.spawn(function()
			local t0 = os.clock()
			while alive do
				local p = (os.clock() - t0) / math.max(dur, 0.05)
				if p >= 1 then
					break
				end
				pcall(fn, p)
				task.wait(0.03)
			end
			if alive then
				pcall(fn, 1)
			end
		end)
	end

	local function cc3()
		if cc == nil and Lighting ~= nil then
			cc = make("ColorCorrectionEffect", { Name = "HatchTint" }, Lighting)
		end
		return cc
	end

	-- graphismes 5 : taille (px) des objets de particules = max(défaut historique, b.size du plan : HatchPlan.particleSize, >= 18 px)
	local function px(b, default)
		return math.max(default, num(b.size, 0))
	end

	-- ------------------------------------------------------------------ prises
	local K = {}
	function K.shake(b)
		local amp = num(b.amp, 4)
		every(b.d, function(p)
			local a = b.grow and amp * (0.3 + p) or amp
			egg.Rotation = math.sin(p * b.d * 38) * a
		end)
	end
	function K.pop(b)
		tween(egg, math.max(b.d, 0.1), { Size = UDim2.fromOffset(170, 170), TextTransparency = 1 })
		task.delay(math.max(b.d, 0.1), function()
			pcall(function()
				egg.Visible = false
			end)
		end)
	end
	function K.burst(b)
		local dist = num(b.dist, 100)
		for i = 1, b.n do
			local a = (i / b.n) * math.pi * 2
			if b.arc == "crown" then
				a = -math.pi + (i / (b.n + 1)) * math.pi -- éventail vers le haut
			end
			local col = colorOf(b.color, i, b.n)
			local o
			local sz = px(b, 16)
			if b.glyph == "cube" or b.glyph == "shard" then
				local w = b.glyph == "cube" and sz or math.max(8, math.floor(sz * 0.45))
				local h = b.glyph == "cube" and sz or math.max(24, math.floor(sz * 1.3))
				o = make("Frame", {
					Name = "Particle", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(w, h), BackgroundColor3 = col,
					Rotation = (i * 37) % 90, BorderSizePixel = 0, ZIndex = 4,
				}, box)
			else
				local g = px(b, 22)
				o = make("TextLabel", {
					Name = "Particle", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(g, g), BackgroundTransparency = 1, Text = b.glyph == "petal" and "✿" or "✦", TextScaled = true,
					TextColor3 = col, Font = FONT, ZIndex = 4,
				}, box)
				if b.color == "gold" then
					make("UIStroke", { Color = Color3.fromRGB(120, 70, 0), Thickness = 1, Transparency = 0.3 }, o) -- contour : l'or reste lisible sur fond clair
				end
			end
			local dx, dy = math.cos(a) * dist, math.sin(a) * dist
			if b.arc == "fall" then
				dx, dy = math.cos(a) * dist * 0.6, math.abs(math.sin(a)) * dist
			end
			tween(o, b.d, { Position = UDim2.fromOffset(dx, dy), BackgroundTransparency = 1, TextTransparency = 1, Rotation = 120 })
		end
	end
	function K.rays(b)
		local len = num(b.len, 200)
		for i = 1, b.n do
			local ray = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(i % 2 == 0 and 7 or 4, 10), BackgroundColor3 = colorOf(b.color, i, b.n),
				BackgroundTransparency = 0.1, Rotation = (i - 1) * 360 / b.n, BorderSizePixel = 0, ZIndex = 3,
			}, box)
			tween(ray, b.d, { Size = UDim2.fromOffset(i % 2 == 0 and 7 or 4, len * (i % 2 == 0 and 1 or 0.75)), BackgroundTransparency = 1 })
		end
	end
	function K.ring(b)
		for i = 1, b.n do
			local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, ZIndex = 3 }, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
			local stroke = make("UIStroke", { Color = colorOf(b.color, i, b.n), Thickness = 5, Transparency = 0.1 }, ring)
			local delay = (i - 1) * 0.18
			task.delay(delay, function()
				if not alive then
					return
				end
				pcall(function()
					if b.mode == "converge" then
						ring.Size = UDim2.fromOffset(300, 300)
						tween(ring, b.d, { Size = UDim2.fromOffset(60, 60) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
						tween(stroke, b.d, { Thickness = 9 })
					elseif b.mode == "ground" then
						ring.Position = UDim2.fromOffset(0, 70)
						ring.Size = UDim2.fromOffset(60, 20)
						tween(ring, b.d, { Size = UDim2.fromOffset(300 + i * 40, 90 + i * 12) }, Enum.EasingStyle.Quint)
						tween(stroke, b.d, { Transparency = 1 })
					elseif b.mode == "rise" then
						ring.Position = UDim2.fromOffset(0, 10)
						ring.Size = UDim2.fromOffset(130, 36)
						tween(ring, b.d, { Position = UDim2.fromOffset(0, -150) }, Enum.EasingStyle.Quad)
						tween(stroke, b.d, { Transparency = 0.6 })
					else
						tween(ring, b.d, { Size = UDim2.fromOffset(300 + i * 60, 300 + i * 60) }, Enum.EasingStyle.Quint)
						tween(stroke, b.d, { Transparency = 1, Thickness = 1 })
					end
				end)
			end)
		end
	end
	function K.flash(b)
		flashF.BackgroundColor3 = colorOf(b.color)
		flashF.BackgroundTransparency = 1 - num(b.a, 0.6)
		flashF.Visible = true
		tween(flashF, math.max(b.d, 0.1), { BackgroundTransparency = 1 })
	end
	function K.shakeScreen(b)
		local amp = num(b.amp, 6)
		every(b.d, function(p)
			local k = (1 - p) * amp
			stage.Position = UDim2.fromOffset(math.sin(p * 90) * k, math.cos(p * 70) * k)
		end)
		task.delay(b.d + 0.05, function()
			pcall(function()
				stage.Position = UDim2.fromOffset(0, 0)
			end)
		end)
	end
	function K.text(b)
		local glyph, size, y = b.glyph, 60, -120
		local text = glyph
		if glyph == "crown" then
			text, size = "👑", 70
		elseif glyph == "exceptional" then
			text, size, y = "✨ Tirage exceptionnel ✨", 26, 135
		end
		local lab = make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, b.fall and -300 or y), Size = UDim2.fromOffset(glyph == "exceptional" and 340 or 120, size), BackgroundTransparency = 1,
			Text = text, TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = colorOf(b.color), TextStrokeTransparency = 0,
			TextStrokeColor3 = b.color == "black" and Color3.new(1, 1, 1) or Color3.fromRGB(30, 20, 40), ZIndex = 8,
		}, box)
		if b.fall then
			tween(lab, 0.9, { Position = UDim2.fromOffset(0, y) }, Enum.EasingStyle.Bounce)
		end
		task.delay(math.max(b.d - 0.3, 0.1), function()
			if alive then
				tween(lab, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
			end
		end)
	end
	function K.banner(b)
		local colors = type(opts.colors) == "table" and opts.colors or {}
		local band = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 150), Size = UDim2.fromOffset(40, 36), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 8,
		}, box)
		make("UICorner", { CornerRadius = UDim.new(0, 12) }, band)
		make("UIStroke", { Color = Color3.fromRGB(24, 16, 30), Thickness = 4 }, band)
		if b.color == "rainbow" then
			make("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 60)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 235, 110)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 110, 255)),
				}),
			}, band)
		elseif b.color == "white" then
			make("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 20)) }), Rotation = 0 }, band)
		else
			make("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, colorOf(b.color)), ColorSequenceKeypoint.new(1, colors.second or colorOf(b.color)) }), Rotation = 90 }, band)
		end
		make("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = type(opts.rarityName) == "string" and opts.rarityName:upper() or "", Font = Enum.Font.GothamBlack, TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(24, 16, 30), ZIndex = 9,
		}, band)
		tween(band, 0.5, { Size = UDim2.fromOffset(260, 36) }, Enum.EasingStyle.Back)
	end
	function K.zoom(b)
		if cam == nil or baseFov == nil or plan.camera == false or zoomed or zoomShared.users > 0 then
			return -- pas de caméra, caméra immobile demandée, ou une autre éclosion zoome déjà
		end
		local fov = cam.FieldOfView
		if type(fov) ~= "number" then
			return
		end
		zoomShared.base, zoomShared.users, zoomed = fov, zoomShared.users + 1, true
		local target = fov / math.max(num(b.k, 1.1), 1)
		every(b.d, function(p)
			local k = p < 0.3 and easeOut(p / 0.3) or (p > 0.8 and easeOut((1 - p) / 0.2) or 1)
			cam.FieldOfView = fov + (target - fov) * k
		end)
	end
	function K.tint(b)
		local fx = cc3()
		if fx == nil then
			return
		end
		if b.sat ~= nil then -- désaturation : maintenue jusqu'à la fin
			every(b.d, function(p)
				fx.Saturation = num(b.sat, -1) * p
			end)
		else
			local col = colorOf(b.color)
			fx.TintColor = Color3.new(1, 1, 1):Lerp(col, num(b.a, 0.5))
			task.delay(b.d, function()
				if alive then
					pcall(function()
						fx.TintColor = Color3.new(1, 1, 1)
					end)
				end
			end)
		end
	end
	function K.black(b)
		blackF.BackgroundTransparency = 0
		blackF.Visible = true
		task.delay(b.d, function()
			if alive then
				tween(blackF, 0.3, { BackgroundTransparency = 1 })
			end
		end)
	end
	function K.slot(b)
		local sl = type(opts.slot) == "table" and opts.slot or {}
		local pools = type(sl.pools) == "table" and sl.pools or {}
		local frame = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 120), Size = UDim2.fromOffset(330, 34), BackgroundColor3 = Color3.fromRGB(24, 18, 40), BorderSizePixel = 0, ZIndex = 7,
		}, box)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
		local labs, finals, pool = {}, { sl.rarity, sl.size, sl.mut }, { pools.rarity, pools.size, pools.mut }
		for i = 1, 3 do
			labs[i] = make("TextLabel", {
				Position = UDim2.new((i - 1) / 3, 0, 0, 0), Size = UDim2.new(1 / 3, 0, 1, 0), BackgroundTransparency = 1, Text = "?", Font = FONT, TextSize = 16,
				TextColor3 = Color3.new(1, 1, 1), ZIndex = 8,
			}, frame)
		end
		every(b.d, function(p)
			for i = 1, 3 do
				local stopAt = 0.4 + 0.25 * (i - 1)
				local final = type(finals[i]) == "string" and finals[i] or "?"
				if p >= stopAt then
					labs[i].Text = final
					labs[i].TextColor3 = colorOf("main")
				else
					local list = type(pool[i]) == "table" and pool[i] or nil
					if list ~= nil and #list > 0 then
						labs[i].Text = tostring(list[(math.floor(p * 40) + i * 3) % #list + 1])
					end
				end
			end
		end)
		task.delay(b.d + 0.4, function()
			if alive then
				tween(frame, 0.3, { BackgroundTransparency = 1 })
			end
		end)
	end
	function K.crystals(b)
		for i = 1, b.n do
			local a = (i / b.n) * math.pi * 2
			local x = b.from == "around" and math.cos(a) * 90 or ((i - (b.n + 1) / 2) * 34)
			local y = b.from == "around" and math.sin(a) * 40 + 40 or 90
			local c = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(14, 4), BackgroundColor3 = colorOf(b.color), BorderSizePixel = 0,
				Rotation = ((i % 3) - 1) * 12, ZIndex = 3,
			}, box)
			make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, c)
			tween(c, b.d, { Size = UDim2.fromOffset(18 + (i % 3) * 6, 70 + (i % 4) * 14) }, Enum.EasingStyle.Back)
		end
	end
	function K.frost(b)
		for i = 1, b.n do
			local f = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((i - 2) * 40, 80), Size = UDim2.fromOffset(20, 8), BackgroundColor3 = colorOf(b.color), BackgroundTransparency = 0.4,
				BorderSizePixel = 0, ZIndex = 2,
			}, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
			tween(f, b.d, { Size = UDim2.fromOffset(200 + i * 40, 50 + i * 8), BackgroundTransparency = 0.8 })
		end
	end
	function K.cracks(b)
		for i = 1, b.n do
			local c = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(3, 4), BackgroundColor3 = colorOf(b.color), BorderSizePixel = 0,
				Rotation = (i - 1) * (360 / b.n) + 20, ZIndex = 5,
			}, box)
			tween(c, b.d, { Size = UDim2.fromOffset(4, 90 + (i % 2) * 30) })
		end
	end
	function K.chains(b)
		local links = {}
		for i = 1, b.n do
			local a = (i / b.n) * math.pi * 2
			local link = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(math.cos(a) * 70, math.sin(a) * 70), Size = UDim2.fromOffset(18, 28), BackgroundTransparency = 1,
				Rotation = math.deg(a), ZIndex = 5,
			}, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, link)
			make("UIStroke", { Color = Color3.fromRGB(70, 70, 80), Thickness = 4 }, link)
			links[i] = { obj = link, a = a }
		end
		task.delay(math.max(num(b.breakAt, b.d) - 0.4, 0.1), function()
			if not alive then
				return
			end
			for i = 1, #links do
				tween(links[i].obj, 0.4, { Position = UDim2.fromOffset(math.cos(links[i].a) * 260, math.sin(links[i].a) * 260), Rotation = 400 })
			end
		end)
	end
	function K.runes(b)
		for i = 1, b.n do
			local a = (i / b.n) * math.pi * 2
			local r = make("TextLabel", {
				Name = "Particle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(math.cos(a) * 130, 80 + math.sin(a) * 34), Size = UDim2.fromOffset(px(b, 24), px(b, 24)), BackgroundTransparency = 1,
				Text = RUNES[(i - 1) % #RUNES + 1], TextScaled = true, Font = FONT, TextColor3 = colorOf(b.color, i, b.n), TextTransparency = 1, ZIndex = 2,
			}, box)
			tween(r, 0.3, { TextTransparency = 0.1 })
			task.delay(math.max(b.d - 0.3, 0.1), function()
				if alive then
					tween(r, 0.3, { TextTransparency = 1 })
				end
			end)
		end
	end
	function K.smoke(b)
		for i = 1, b.n do
			local s = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((i - (b.n + 1) / 2) * 36, 40), Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1, Text = "☁",
				TextScaled = true, Font = FONT, TextColor3 = Color3.fromRGB(70, 70, 80), TextTransparency = 0.2, ZIndex = 4,
			}, box)
			tween(s, b.d, { Position = UDim2.fromOffset((i - (b.n + 1) / 2) * 60, -120), TextTransparency = 1, Size = UDim2.fromOffset(90, 90) })
		end
	end
	function K.stars(b)
		for i = 1, b.n do
			local a = (i / b.n) * math.pi * 2 + 0.4
			local s = make("TextLabel", {
				Name = "Particle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(px(b, 26), px(b, 26)), BackgroundTransparency = 1, Text = "★", TextScaled = true, Font = FONT,
				TextColor3 = colorOf(b.color, i, b.n), ZIndex = 4,
			}, box)
			tween(s, b.d, { Position = UDim2.fromOffset(math.cos(a) * (120 + (i % 3) * 40), math.sin(a) * (90 + (i % 3) * 30)), TextTransparency = 1 })
		end
	end
	function K.wings(b)
		for i = 1, 2 do
			local dir = i == 1 and -1 or 1
			local w = make("Frame", {
				AnchorPoint = Vector2.new(dir == -1 and 1 or 0, 0.5), Position = UDim2.fromOffset(dir * 20, -10), Size = UDim2.fromOffset(10, 20), BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.15, Rotation = dir * 5, BorderSizePixel = 0, ZIndex = 3,
			}, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, w)
			make("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, colorOf(b.color)), ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)) }), Rotation = dir == -1 and 0 or 180 }, w)
			tween(w, b.d, { Size = UDim2.fromOffset(150, 90), Rotation = dir * 28 }, Enum.EasingStyle.Back)
		end
	end
	function K.pillar(b)
		local p = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(0, 70), Size = UDim2.fromOffset(60, 10), BackgroundColor3 = colorOf(b.color), BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 1,
		}, box)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.8) }), Rotation = 90 }, p)
		tween(p, 1.0, { Size = UDim2.fromOffset(90, 900) })
		task.delay(math.max(b.d - 0.6, 0.2), function()
			if alive then
				tween(p, 0.6, { BackgroundTransparency = 1 })
			end
		end)
	end
	function K.split(b)
		for i = 1, 2 do
			local dir = i == 1 and -1 or 1
			local h = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(dir * 6, 0), Size = UDim2.fromOffset(40, 80), BackgroundColor3 = colorOf(b.color), BackgroundTransparency = 0.2,
				BorderSizePixel = 0, ZIndex = 3,
			}, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, h)
			tween(h, b.d, { Position = UDim2.fromOffset(dir * 110, 20), Rotation = dir * 40, BackgroundTransparency = 1 })
		end
	end

	-- compteur « 1 sur N » : monte de 1 à N en 0,8 s (12 paliers), puis rebondit
	local function runCounter(c)
		local to = num(c.to, nil)
		if to == nil or to < 1 or counter == nil then
			return
		end
		local fmt = type(opts.fmtOdds) == "function" and opts.fmtOdds or defaultOdds
		local steps = math.max(1, math.min(60, math.floor(num(c.steps, 12))))
		local list = countSteps(to, steps)
		counter.Visible = true
		if plan.special then
			counter.TextColor3 = Color3.fromRGB(255, 220, 90)
		end
		task.spawn(function()
			for i = 1, #list do
				if not alive then
					return
				end
				local ok, txt = pcall(fmt, list[i])
				counter.Text = ok and type(txt) == "string" and txt or defaultOdds(list[i])
				task.wait(math.max(num(c.d, 0.8) / #list, 0.02))
			end
			if alive then
				tween(counter, 0.15, { TextSize = 34 }, Enum.EasingStyle.Back)
				task.delay(0.15, function()
					if alive then
						tween(counter, 0.2, { TextSize = 26 })
					end
				end)
			end
		end)
	end

	local function doReveal()
		reveal()
		safe(opts.sound, plan.sound.fanfare and "fanfare" or plan.sound.key, 0.8)
		if plan.sound.fanfare then
			safe(opts.sound, plan.sound.key, 0.8)
		end
		if plan.secretSound then
			safe(opts.sound, "secret", 0.9)
		end
		if pet ~= nil then
			pet.Visible = true
			tween(pet, 0.5, { Size = UDim2.fromOffset(110, 110), Position = UDim2.fromOffset(0, -20) }, Enum.EasingStyle.Elastic)
		end
		if type(plan.counter) == "table" then
			runCounter(plan.counter)
		end
	end

	local okSetup = pcall(function()
		if type(plan) ~= "table" or type(plan.beats) ~= "table" or type(plan.sound) ~= "table" then
			error("plan invalide")
		end
		local duration = math.max(0.2, math.min(8, num(plan.duration, 2)))
		alive = true
		root = make("TextButton", {
			Name = "HatchFx", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 50, Active = true, BorderSizePixel = 0,
		}, parent)
		stage = make("Frame", { Name = "Stage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 51 }, root)
		box = make("Frame", { Name = "Center", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, ZIndex = 52 }, stage)
		flashF = make("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0, ZIndex = 60 }, stage)
		blackF = make("Frame", { Name = "Black", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0, ZIndex = 53 }, stage)
		egg = make("TextLabel", {
			Name = "Egg", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(96, 96), BackgroundTransparency = 1, Text = "🥚", TextScaled = true, Font = FONT, ZIndex = 56,
		}, box)
		counter = make("TextLabel", {
			Name = "Odds", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 100), Size = UDim2.fromOffset(300, 34), BackgroundTransparency = 1, Text = "", TextSize = 26, Font = FONT,
			TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(24, 16, 30), Visible = false, ZIndex = 70,
		}, box)
		hint = make("TextLabel", {
			Name = "Hint", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(240, 22), BackgroundTransparency = 1, Text = "Touche pour passer",
			TextSize = 14, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1, ZIndex = 71,
		}, stage)
		if type(opts.petText) == "string" and opts.petText ~= "" then
			pet = make("TextLabel", {
				Name = "Pet", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 20), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = opts.petText, TextScaled = true,
				Font = FONT, Visible = false, ZIndex = 65,
			}, box)
		end
		-- caméra (zoom) : seulement si la valeur d'origine est un nombre
		pcall(function()
			local c = workspace.CurrentCamera
			local fov = c and c.FieldOfView
			if plan.camera ~= false and type(fov) == "number" then
				cam, baseFov = c, fov
			end
		end)
		-- interfaces masquées
		if type(opts.hide) == "table" then
			for i = 1, #opts.hide do
				local g = opts.hide[i]
				pcall(function()
					local was = g.Enabled
					if type(was) == "boolean" then
						hidden[#hidden + 1] = { gui = g, was = was }
						g.Enabled = false
					end
				end)
			end
		end
		-- passage par un tap
		local noSkip = plan.noSkip == true
		local skipAfter = num(plan.skipAfter, 1.5)
		local function trySkip()
			if alive and not noSkip and os.clock() - startClock >= skipAfter then
				finish(true)
			end
		end
		root.Activated:Connect(trySkip)
		if not noSkip then
			task.delay(skipAfter, function()
				if alive then
					tween(hint, 0.3, { TextTransparency = 0.2 })
				end
			end)
		end
		-- sons de départ
		safe(opts.sound, plan.sound.key == "hatchSecret" and "hatchSecret" or "hatch", 0.6)
		if plan.sound.divine then
			safe(opts.sound, "divine", 0.8)
		end
		-- prises
		for i = 1, #plan.beats do
			local b = plan.beats[i]
			if type(b) == "table" and type(b.kind) == "string" and K[b.kind] ~= nil then
				local nb = {}
				for k, v in pairs(b) do
					nb[k] = v
				end
				nb.t, nb.d, nb.n = math.max(0, num(b.t, 0)), math.max(0, num(b.d, 0.3)), math.max(0, math.min(30, math.floor(num(b.n, 0))))
				local function run()
					if alive then
						pcall(K[nb.kind], nb)
					end
				end
				if nb.t <= 0 then
					run()
				else
					task.delay(nb.t, run)
				end
			end
		end
		task.delay(math.max(0, num(plan.revealAt, 0.5)), function()
			if alive then
				pcall(doReveal)
			end
		end)
		task.delay(duration, function()
			finish(false)
		end)
		task.delay(duration + HatchFx.WATCHDOG_MARGIN, function()
			finish(false) -- chien de garde : tout est restitué même si une prise a échoué
		end)
	end)

	if not okSetup then
		finish(true)
		return nil
	end
	return {
		root = root,
		skip = function()
			if alive and plan.noSkip ~= true and os.clock() - startClock >= num(plan.skipAfter, 1.5) then
				finish(true)
			end
		end,
		stop = function()
			finish(true)
		end,
		isDone = function()
			return done
		end,
		created = function()
			return created
		end,
	}
end

return HatchFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91"><Properties><string name="Name">TypeFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/TypeFx   (lot 10, B.6)
-- Effets d'attaque par type (Feu, Eau, Plante, Glace, Foudre, Terre, Ciel, Ombre, Lumière) pour l'écran de combat : attaque de base (0,5 s) et spécial (1,2 s, cercle runique sous
-- l'attaquant + secousse 0,4 s), plus le texte d'efficacité flottant. 100 % dessiné par le code (Frames, TextLabels, UICorner, UIGradient, UIStroke, TweenService), aucun asset.
-- Les DONNÉES viennent de ReplicatedStorage/TypeFx (table DATA, exposée plus tard comme Config.TYPE_FX) et sont PASSÉES en paramètre : ce module n'a aucun require et
-- ne fait rien à l'import. Chaque couche d'une donnée crée exactement `n` objets : coût d'un effet = 1 + somme des n (ReplicatedStorage/TypeFx.cost), plafond dur 80 instances.
--
-- BRANCHER (dans l'écran de combat, à chaque événement d'attaque rejoué) :
--   local def = Config.TYPE_FX[attackerType]            -- ou TypeFxData.get(type) ; nil -> aucun effet
--   local h = TypeFx.play(battleGui, def, isSpecial, {
--       from = Vector2.new(x1, y1), to = Vector2.new(x2, y2),   -- positions en pixels dans `battleGui` (attaquant, cible) ; défaut : 25 % / 75 % de la largeur
--       reduced = isMobile,                                      -- moitié des objets
--       shakeFrame = battlePanel,                                -- (optionnel) cadre secoué par le spécial
--       sound = function(key) ... end, onDone = function() ... end })
--   TypeFx.floatText(battleGui, "Super efficace !", rgb, x, y)  -- texte d'efficacité (TypeFxData.efficacy(mult) donne texte et couleur RGB)
-- Retour de play : { stop, isDone, created, root } ou nil (def invalide). Tout est détruit tout seul (durée + persistance au sol + marge). Pas de += ni de continue.
local TypeFx = {}

TypeFx.MAX_INSTANCES = 80
TypeFx.MARGIN = 0.4

local FONT = Enum.Font.GothamBold
local RUNES = { "ᚠ", "ᚢ", "ᚦ", "ᚨ", "ᚱ", "ᚲ", "ᚷ", "ᚹ" }

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

local function pt(v, dx, dy)
	if type(v) == "table" then
		local x, y = v.X, v.Y
		if type(x) == "number" and type(y) == "number" then
			return x, y
		end
	end
	return dx, dy
end

function TypeFx.play(parent, def, special, opts)
	opts = type(opts) == "table" and opts or {}
	if type(def) ~= "table" or type(def.rgb) ~= "table" then
		return nil
	end
	local fx = special and def.special or def.basic
	if type(fx) ~= "table" or type(fx.layers) ~= "table" then
		return nil
	end
	local created, done, alive = 0, false, true
	local root
	local TweenService
	pcall(function()
		TweenService = game:GetService("TweenService")
	end)
	local main = Color3.fromRGB(num(def.rgb[1], 255), num(def.rgb[2], 255), num(def.rgb[3], 255))
	local function colorOf(key)
		if key == "dark" then
			return Color3.fromRGB(30, 22, 24)
		elseif key == "white" then
			return Color3.new(1, 1, 1)
		end
		return main
	end
	local function tween(obj, seconds, goal, style, dir)
		if TweenService == nil then
			return
		end
		pcall(function()
			TweenService:Create(obj, TweenInfo.new(math.max(seconds, 0.05), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
		end)
	end
	-- objet compté (1 par n) ; décorations non comptées
	local function ob(class, props)
		if created >= TypeFx.MAX_INSTANCES then
			error("plafond d'instances")
		end
		created = created + 1
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = root
		return o
	end
	local function deco(class, props, par)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = par
		return o
	end
	local function glyph(g, size, x, y, extra)
		local props = {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Text = g, TextScaled = true,
			Font = FONT, TextColor3 = main, ZIndex = 95,
		}
		if extra then
			for k, v in pairs(extra) do
				props[k] = v
			end
		end
		return ob("TextLabel", props)
	end

	local W, H = 800, 450
	pcall(function()
		local s = parent.AbsoluteSize
		if type(s.X) == "number" and type(s.Y) == "number" and s.X > 0 and s.Y > 0 then
			W, H = s.X, s.Y
		end
	end)
	local x1, y1 = pt(opts.from, W * 0.25, H * 0.5)
	local x2, y2 = pt(opts.to, W * 0.75, H * 0.5)
	local dx, dy = x2 - x1, y2 - y1
	local reduced = opts.reduced == true

	local P = {} -- primitives : chacune crée exactement L.n objets
	function P.shoot(L, n)
		for i = 1, n do
			local o = glyph(L.glyph or "●", num(L.size, 24), x1, y1, { Rotation = 0 })
			local spread = (i - (n + 1) / 2) * 14
			task.delay((i - 1) * 0.05, function()
				if alive then
					tween(o, math.max(L.d - (i - 1) * 0.05, 0.1), { Position = UDim2.fromOffset(x2, y2 + spread), Rotation = L.spin and 360 or 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					task.delay(math.max(L.d - (i - 1) * 0.05, 0.1), function()
						if alive then
							tween(o, 0.1, { TextTransparency = 1 })
						end
					end)
				end
			end)
		end
	end
	function P.burst(L, n)
		for i = 1, n do
			local a = (i / n) * math.pi * 2 + 0.5
			local o = glyph(L.glyph or "✦", 18, x2, y2)
			tween(o, L.d, { Position = UDim2.fromOffset(x2 + math.cos(a) * num(L.dist, 50), y2 + math.sin(a) * num(L.dist, 50)), TextTransparency = 1, Rotation = 90 })
		end
	end
	function P.cone(L, n)
		for i = 1, n do
			local spreadAngle = (i - (n + 1) / 2) * 0.09
			local len = math.sqrt(dx * dx + dy * dy)
			local base = math.atan(dy / (dx == 0 and 1e-6 or dx)) + (dx < 0 and math.pi or 0)
			local a = base + spreadAngle
			local o = glyph(L.glyph or "●", num(L.size, 24), x1, y1, { TextTransparency = 0.1 })
			task.delay((i - 1) * 0.04, function()
				if alive then
					tween(o, math.max(L.d - (i - 1) * 0.04, 0.1), { Position = UDim2.fromOffset(x1 + math.cos(a) * len * 0.9, y1 + math.sin(a) * len * 0.9), TextTransparency = 1, Size = UDim2.fromOffset(46, 46) })
				end
			end)
		end
	end
	function P.bolt(L, n)
		local px, py = x1, y1
		for i = 1, n do
			local k = i / n
			local nx = x1 + dx * k
			local ny = y1 + dy * k + (i == n and 0 or ((i % 2 == 0) and 1 or -1) * (14 + (i * 7) % 12))
			local sdx, sdy = nx - px, ny - py
			local len = math.sqrt(sdx * sdx + sdy * sdy)
			local seg = ob("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((px + nx) / 2, (py + ny) / 2), Size = UDim2.fromOffset(len + 2, 4), BackgroundColor3 = L.color == "dark" and colorOf("dark") or main,
				Rotation = math.deg(math.atan(sdy / (sdx == 0 and 1e-6 or sdx))), BorderSizePixel = 0, ZIndex = 95, BackgroundTransparency = 1,
			})
			task.delay((i - 1) * (L.d / n) * 0.6, function()
				if alive then
					seg.BackgroundTransparency = 0
					tween(seg, math.max(L.d * 0.5, 0.1), { BackgroundTransparency = 1 })
				end
			end)
			px, py = nx, ny
		end
	end
	function P.column(L, n)
		for i = 1, n do
			local x = x2 + (i - (n + 1) / 2) * (n == 1 and 0 or 26)
			local width = num(L.size, 20)
			local height, color = 90, main
			if L.glyph == "pillar" then
				height, color = 260, Color3.fromRGB(255, 240, 170)
			elseif L.glyph == "rock" then
				height, color = 40 + (i % 2) * 14, Color3.fromRGB(130, 96, 66)
			elseif L.glyph == "vine" then
				width, height = 8, 80 + (i % 3) * 14
			end
			local c = ob("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(x, y2 + 40), Size = UDim2.fromOffset(width, 6), BackgroundColor3 = color, BorderSizePixel = 0,
				Rotation = L.glyph == "rock" and 0 or ((i % 3) - 1) * 8, ZIndex = 94,
			})
			deco("UICorner", { CornerRadius = UDim.new(L.glyph == "spike" and 0.1 or 0.4, 0) }, c)
			tween(c, L.d * 0.5, { Size = UDim2.fromOffset(width, height) }, Enum.EasingStyle.Back)
			task.delay(L.d, function()
				if alive then
					tween(c, 0.25, { BackgroundTransparency = 1 })
				end
			end)
		end
	end
	function P.ring(L, n)
		for i = 1, n do
			local r = ob("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x2, y2 + 30), Size = UDim2.fromOffset(30, 10), BackgroundTransparency = 1, ZIndex = 93 })
			deco("UICorner", { CornerRadius = UDim.new(0.5, 0) }, r)
			local stroke = deco("UIStroke", { Color = main, Thickness = 5, Transparency = 0.1 }, r)
			task.delay((i - 1) * 0.22, function()
				if alive then
					tween(r, math.max(L.d - (i - 1) * 0.22, 0.2), { Size = UDim2.fromOffset(280 + i * 50, 90 + i * 16) }, Enum.EasingStyle.Quint)
					tween(stroke, math.max(L.d - (i - 1) * 0.22, 0.2), { Transparency = 1 })
				end
			end)
		end
	end
	function P.flash(L, n)
		local f = ob("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = main:Lerp(Color3.new(1, 1, 1), 0.5), BackgroundTransparency = 1 - num(L.alpha, 0.4), BorderSizePixel = 0, ZIndex = 99 })
		tween(f, math.max(L.d, 0.1), { BackgroundTransparency = 1 })
	end
	function P.runes(L, n)
		for i = 1, n do
			local a = (i / n) * math.pi * 2
			local r = glyph(RUNES[(i - 1) % #RUNES + 1], 22, x1 + math.cos(a) * 70, y1 + 36 + math.sin(a) * 22, { TextTransparency = 1, ZIndex = 90 })
			tween(r, 0.25, { TextTransparency = 0.05 })
			task.delay(math.max(L.d - 0.25, 0.1), function()
				if alive then
					tween(r, 0.25, { TextTransparency = 1 })
				end
			end)
		end
	end
	function P.decal(L, n)
		local d = ob("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x2, y2 + 40), Size = UDim2.fromOffset(20, 8), BackgroundColor3 = colorOf(L.color), BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = 88,
		})
		deco("UICorner", { CornerRadius = UDim.new(0.5, 0) }, d)
		tween(d, L.d, { Size = UDim2.fromOffset(160, 50), BackgroundTransparency = 0.5 })
		task.delay(num(fx.linger, 0) + L.d, function()
			if alive then
				tween(d, 0.3, { BackgroundTransparency = 1 })
			end
		end)
	end
	function P.spiral(L, n)
		for i = 1, n do
			local k = i / n
			local o = glyph(L.glyph or "☁", num(L.size, 24), x2, y2 + 40, { TextTransparency = 0.2 })
			local a = k * math.pi * 4
			tween(o, L.d, { Position = UDim2.fromOffset(x2 + math.cos(a) * 55, y2 + 40 - k * 120), Rotation = 360, TextTransparency = 0.8 })
		end
	end
	function P.chainring(L, n)
		for i = 1, n do
			local a = (i / n) * math.pi * 2
			local link = ob("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x2 + math.cos(a) * 120, y2 + math.sin(a) * 70), Size = UDim2.fromOffset(16, 26), BackgroundTransparency = 1,
				Rotation = math.deg(a), ZIndex = 94,
			})
			deco("UICorner", { CornerRadius = UDim.new(0.5, 0) }, link)
			deco("UIStroke", { Color = main, Thickness = 4 }, link)
			tween(link, L.d * 0.7, { Position = UDim2.fromOffset(x2 + math.cos(a) * 30, y2 + math.sin(a) * 20) }, Enum.EasingStyle.Back)
			task.delay(L.d, function()
				if alive then
					tween(link, 0.25, { Rotation = 300 })
				end
			end)
		end
	end
	function P.beam(L, n)
		local len = math.sqrt(dx * dx + dy * dy)
		local b = ob("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2), Size = UDim2.fromOffset(len, 4), BackgroundColor3 = Color3.fromRGB(255, 240, 170),
			Rotation = math.deg(math.atan(dy / (dx == 0 and 1e-6 or dx))), BorderSizePixel = 0, ZIndex = 95,
		})
		deco("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, b)
		tween(b, L.d, { Size = UDim2.fromOffset(len, 22), BackgroundTransparency = 1 })
	end

	local total = num(fx.d, 0.5) + num(fx.linger, 0)
	local function finish()
		if done then
			return
		end
		done = true
		alive = false
		if root ~= nil then
			pcall(function()
				root:Destroy()
			end)
		end
		if type(opts.onDone) == "function" then
			pcall(opts.onDone)
		end
	end

	local ok = pcall(function()
		root = Instance.new("Frame")
		created = created + 1
		root.Name = "TypeFx"
		root.Size = UDim2.fromScale(1, 1)
		root.BackgroundTransparency = 1
		root.BorderSizePixel = 0
		root.Active = false
		root.ZIndex = 90
		root.Parent = parent
		for i = 1, #fx.layers do
			local L = fx.layers[i]
			local run = type(L) == "table" and P[L.prim] or nil
			if run ~= nil then
				local n = math.max(1, math.min(30, math.floor(num(L.n, 1))))
				if reduced then
					n = math.max(1, math.floor(n / 2))
				end
				local layer = { glyph = L.glyph, size = L.size, dist = L.dist, color = L.color, spin = L.spin, alpha = L.alpha, d = math.max(0.1, num(L.d, 0.3)) }
				local t = math.max(0, num(L.t, 0))
				local function go()
					if alive then
						pcall(run, layer, n)
					end
				end
				if t <= 0 then
					go()
				else
					task.delay(t, go)
				end
			end
		end
		-- secousse du cadre de combat pendant le spécial
		local shakeT = num(fx.shake, 0)
		if shakeT > 0 and opts.shakeFrame ~= nil then
			local f = opts.shakeFrame
			local okPos, orig = pcall(function()
				return f.Position
			end)
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < shakeT do
					local k = (1 - (os.clock() - t0) / shakeT) * 5
					pcall(function()
						f.Position = orig + UDim2.fromOffset(math.sin((os.clock() - t0) * 80) * k, math.cos((os.clock() - t0) * 60) * k)
					end)
					task.wait(0.03)
				end
				if okPos then
					pcall(function()
						f.Position = orig
					end)
				end
			end)
		end
		if type(opts.sound) == "function" then
			pcall(opts.sound, special and "special" or "attack")
		end
		task.delay(total + TypeFx.MARGIN, finish)
	end)
	if not ok then
		finish()
		return nil
	end
	return {
		root = root,
		stop = finish,
		isDone = function()
			return done
		end,
		created = function()
			return created
		end,
	}
end

-- Texte d'efficacité flottant (« Super efficace ! ») : monte de 40 px en 0,9 s puis disparaît ; rgb = { r, g, b }. Retourne le TextLabel ou nil.
function TypeFx.floatText(parent, text, rgb, x, y)
	local ok, lab = pcall(function()
		local c = type(rgb) == "table" and Color3.fromRGB(num(rgb[1], 255), num(rgb[2], 255), num(rgb[3], 255)) or Color3.new(1, 1, 1)
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromOffset(num(x, 400), num(y, 200))
		l.Size = UDim2.fromOffset(260, 30)
		l.BackgroundTransparency = 1
		l.Text = tostring(text)
		l.Font = Enum.Font.GothamBlack
		l.TextSize = 24
		l.TextColor3 = c
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.fromRGB(20, 14, 24)
		l.ZIndex = 100
		l.Parent = parent
		local ts = game:GetService("TweenService")
		ts:Create(l, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(num(x, 400), num(y, 200) - 40), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		game:GetService("Debris"):AddItem(l, 1.1)
		return l
	end)
	if ok then
		return lab
	end
	return nil
end

return TypeFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX92"><Properties><string name="Name">BaseUpgradeFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayer/StarterPlayerScripts/BaseUpgradeFx
-- Montée de niveau de la maison (REFONTE lot 5, D.4), côté client : échafaudage de bois (Parts temporaires locales), nuage de poussière + onde (VfxKit),
-- l'ancienne maison s'enfonce, la nouvelle monte avec squash & stretch. Le calendrier vient du module pur Upgrade (4,5 s) ; la bannière, la fanfare et les
-- confettis viennent de la notification serveur « levelup » (au début de la fête). Le serveur garde la nouvelle maison sous le sol puis la remet en place
-- après 4,5 s quoi qu'il arrive : si cet effet échoue ou est passé, la maison apparaît quand même. Tout sous pcall, tout est nettoyé, aucune cinématique ici
-- (la caméra large est celle de Cinematics). Les Parts de l'échafaudage sont locales : aucun autre joueur ne les voit comme des objets du serveur.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local BaseUpgradeFx = {}

-- env = { Config, Upgrade (instance du module Upgrade), vfx = function(names, tier, cframe), skipEvent (BindableEvent facultatif) }
-- Retourne { run = function(p, from, to), skip = function(), active = function() }
-- Nuage de poussière : une salve de fumée (Part invisible locale, supprimée par Debris).
local function puff(position)
	pcall(function()
		local anchor = Instance.new("Part")
		anchor.Name = "UpgradeDust"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.Position = position
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/smoke_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(214, 200, 176), Color3.fromRGB(176, 164, 146))
		e.Rate = 0
		e.Lifetime = NumberRange.new(1.2, 2.2)
		e.Speed = NumberRange.new(8, 22)
		e.SpreadAngle = Vector2.new(180, 60)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		e.Parent = anchor
		anchor.Parent = workspace
		e:Emit(40)
		Debris:AddItem(anchor, 3)
	end)
end

function BaseUpgradeFx.start(env)
	local Config, U = env.Config, env.Upgrade
	local F = Config.UPGRADE_FX
	local current = nil -- animation en cours (une seule à la fois, la plus récente remplace la précédente)
	local api = {}

	local function cleanup(run)
		if run.conn then
			pcall(function()
				run.conn:Disconnect()
			end)
			run.conn = nil
		end
		for _, part in ipairs(run.scaffold) do
			pcall(function()
				part:Destroy()
			end)
		end
		run.scaffold = {}
		-- l'état local est restitué exactement : la nouvelle maison à sa place et à l'échelle 1, la dalle de nouveau solide
		pcall(function()
			if run.new and run.new.Parent and run.final then
				run.new:ScaleTo(1)
				run.new:PivotTo(run.final)
			end
		end)
		for _, plate in ipairs(run.plates) do
			pcall(function()
				if plate.Parent then
					plate.CanCollide = true
				end
			end)
		end
		run.plates = {}
		if current == run then
			current = nil
		end
	end

	local function findHouse(cf)
		local world = workspace:FindFirstChild("World")
		if not world then
			return nil
		end
		for _, m in ipairs(world:GetChildren()) do
			local nu = m:FindFirstChild("BaseUpgrade")
			local final = nu and nu:GetAttribute("FinalPivot")
			if nu and typeof(final) == "CFrame" and (final.Position - cf.Position).Magnitude < 4 then
				return m, nu, final
			end
		end
		return nil
	end

	-- Une animation pour le joueur p dont le niveau passe de `from` à `to`.
	function api.run(p, from, to)
		local ok, err = pcall(function()
			if current then
				cleanup(current)
			end
			local cf = p:GetAttribute("PlotCF")
			if typeof(cf) ~= "CFrame" then
				return
			end
			local cam = workspace.CurrentCamera
			local dist = cam and (cam.CFrame.Position - cf.Position).Magnitude
			if type(dist) == "number" and dist > 260 then
				return -- trop loin pour voir : le serveur remet la maison en place seul
			end
			local run = { scaffold = {}, plates = {}, t0 = os.clock(), p = p, dust1 = false, dust2 = false }
			current = run
			local halfX, backZ = Config.baseExtent(to)
			local wait0 = os.clock()
			local waited = false
			run.conn = RunService.Heartbeat:Connect(function()
				local okStep, errStep = pcall(function()
					if current ~= run then
						return
					end
					if not run.new then -- la nouvelle maison peut arriver un peu après l'attribut : on réessaie ~1 s
						local _, nu, final = findHouse(cf)
						if nu then
							local plotModel = nu.Parent
							run.new, run.final, run.old = nu, final, plotModel:FindFirstChild("BaseUpgradeOld")
							run.oldFinal = run.old and run.old:GetPivot() or nil
							run.t0 = os.clock()
							for _, d in ipairs(nu:GetChildren()) do
								if d.Name == "BasePlate" then
									d.CanCollide = false
									run.plates[#run.plates + 1] = d
								end
							end
							if run.old then
								for _, d in ipairs(run.old:GetChildren()) do
									if d.Name == "BasePlate" then
										d.CanCollide = false
									end
								end
							end
							-- échafaudage : 4 poteaux et 2 niveaux de traverses autour de l'emprise de la maison (à l'arrière de la plateforme)
							local x0, x1, z0, z1 = -halfX * 0.62, halfX * 0.62, backZ - 24, backZ - 3
							local function plank(name, material)
								local part = Instance.new("Part")
								part.Name = name
								part.Anchored = true
								part.CanCollide = false
								part.CanQuery = false
								part.Material = material or Enum.Material.WoodPlanks
								part.Color = Color3.fromRGB(150, 104, 62)
								part.Size = Vector3.new(0.6, 0.6, 0.6)
								part.Parent = workspace
								run.scaffold[#run.scaffold + 1] = part
								return part
							end
							run.posts, run.rails = {}, {}
							for _, c in ipairs({ { x0, z0 }, { x1, z0 }, { x0, z1 }, { x1, z1 } }) do
								run.posts[#run.posts + 1] = { part = plank("ScaffoldPost"), x = c[1], z = c[2] }
							end
							for level = 1, 2 do
								for _, e in ipairs({ { 0, z0, x1 - x0, true }, { 0, z1, x1 - x0, true }, { x0, 0, z1 - z0, false }, { x1, 0, z1 - z0, false } }) do
									run.rails[#run.rails + 1] = { part = plank("ScaffoldRail"), level = level, cx = e[1], cz = e[2], len = e[3], alongX = e[4], mid = (z0 + z1) / 2 }
								end
							end
						elseif os.clock() - wait0 > 1 then
							waited = true
						end
						if waited or not run.new then
							if waited then
								cleanup(run)
							end
							return
						end
					end
					local st = U.state(os.clock() - run.t0)
					-- échafaudage
					local height = 12 * st.scaffold * (1 - st.strip)
					for _, e in ipairs(run.posts) do
						e.part.Size = Vector3.new(0.6, math.max(0.05, height), 0.6)
						e.part.CFrame = cf * CFrame.new(e.x, 1 + height / 2, e.z)
					end
					for _, e in ipairs(run.rails) do
						local y = 1 + height * (e.level == 1 and 0.5 or 1)
						local cx, cz = e.cx, e.cz
						if e.alongX then
							e.part.Size = Vector3.new(e.len, 0.5, 0.5)
						else
							e.part.Size = Vector3.new(0.5, 0.5, e.len)
							cz = e.mid
						end
						e.part.CFrame = cf * CFrame.new(cx, y, cz)
						e.part.Transparency = height < 0.5 and 1 or 0
					end
					-- poussière et onde
					if st.t >= U.dustAt and not run.dust1 then
						run.dust1 = true
						local at = cf * CFrame.new(0, 2, backZ - 12)
						if env.vfx then
							env.vfx({ "onde_de_choc" }, math.min(6, math.max(2, to - 1)), at)
						end
						puff(at.Position)
					end
					-- échange : l'ancienne maison s'enfonce, la nouvelle monte avec squash & stretch
					if st.t >= U.swapAt then
						if run.old and run.old.Parent and run.oldFinal then
							run.old:PivotTo(run.oldFinal * CFrame.new(0, -30 * st.drop, 0))
						end
						if run.new.Parent then
							run.new:PivotTo(run.final * CFrame.new(0, -F.hide * (1 - math.min(st.rise, 1.02)), 0))
							run.new:ScaleTo(1 + (st.sy - 1) * 0.4)
						end
						if not run.dust2 then
							run.dust2 = true
							puff((cf * CFrame.new(0, 2, backZ - 12)).Position)
						end
					end
					if st.done then
						cleanup(run)
					end
				end)
				if not okStep then
					warn("[BaseUpgradeFx] " .. tostring(errStep))
					cleanup(run)
				end
			end)
		end)
		if not ok then
			warn("[BaseUpgradeFx] " .. tostring(err))
			if current then
				cleanup(current)
			end
		end
	end

	-- Passer : la nouvelle maison reprend sa place tout de suite (le serveur fait de même à 4,5 s).
	function api.skip()
		if current then
			cleanup(current)
		end
	end
	function api.active()
		return current ~= nil
	end

	-- Écoute des montées de niveau de tous les joueurs (chacun voit la transformation des autres bases, sans caméra).
	local last, hooked = {}, {}
	local function hook(p)
		if hooked[p] then
			return
		end
		hooked[p] = true
		local lv = p:GetAttribute("BaseLevel")
		last[p] = type(lv) == "number" and lv or nil
		p:GetAttributeChangedSignal("BaseLevel"):Connect(function()
			local now = p:GetAttribute("BaseLevel")
			if type(now) ~= "number" then
				return
			end
			local before = last[p]
			last[p] = now
			if before and now > before then
				api.run(p, before, now)
			end
		end)
	end
	if Players.LocalPlayer then
		hook(Players.LocalPlayer)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(p)
		last[p] = nil
		hooked[p] = nil
	end)
	if env.skipEvent then
		env.skipEvent.Event:Connect(api.skip)
	end
	return api
end

return BaseUpgradeFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX93"><Properties><string name="Name">HenUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/HenUi
-- REFONTE lot 6 : interface de l'énigme de la Mère Poule. Tout est local au joueur et sous pcall ; le serveur reste autoritaire (le client n'envoie que
-- des intentions : « henGo », « henExplain », « henHint », « henReplay »).
--  - bulle de dialogue en bas (texte écrit à Config.HEN.bubbleCps caractères/s, « Suivant », boutons selon le contexte, passable) ;
--  - « ❗ » doré au-dessus de la Mère Poule (visible à Config.HEN.alertRange studs) tant que l'énigme est disponible et non faite ;
--  - plumes dorées : cachées localement chez qui les a ramassées, scintillement + son « secret » à moins de 40 studs ;
--  - berceuse : les pierres brillent dans l'ordre (une note par pierre), retour des touches, bouton « 🔁 Réécouter » ;
--  - cible du faisceau jaune (Riddle.guide) et texte de la carte d'objectif.
-- Léger pour mobile : une boucle à 2,5 Hz sur 4 plumes, une seule bulle réutilisée, un seul Highlight par pierre.
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local HenUi = {}

local function num(v)
	return type(v) == "number" and v == v
end

function HenUi.start(ctx)
	local Config, Riddle, player, make, corner, COL, FONT = ctx.Config, ctx.Riddle, ctx.player, ctx.make, ctx.corner, ctx.COL, ctx.FONT
	local H = Config.HEN
	local RAction, RHen, playSound = ctx.RAction, ctx.RHen, ctx.playSound
	local self = {}
	local state = nil
	local dlg = nil -- { pages, buttons, i, typing, token }
	local token = 0

	local function henState()
		return state and type(state.hen) == "table" and state.hen or nil
	end
	local function myRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	---------------------------------------------------------------- Bulle de dialogue
	local frame, nameLbl, textLbl, nextBtn, btnRow, overlay, pill, pillLbl, replayBtn
	local okBuild = pcall(function()
		frame = make("Frame", { Name = "HenBubble", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -96), Size = UDim2.new(0.94, 0, 0, 150), BackgroundColor3 = COL.bg, BackgroundTransparency = 0.05, Visible = false, ZIndex = 20 }, ctx.gui)
		corner(frame, 16)
		make("UIStroke", { Color = COL.yellow, Thickness = 2 }, frame)
		make("UISizeConstraint", { MaxSize = Vector2.new(620, 170) }, frame)
		overlay = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 21 }, frame)
		make("TextLabel", { Position = UDim2.fromOffset(8, 10), Size = UDim2.fromOffset(52, 52), BackgroundTransparency = 1, Text = "🐔", TextSize = 40, Font = FONT, ZIndex = 22 }, frame)
		nameLbl = make("TextLabel", { Position = UDim2.fromOffset(66, 6), Size = UDim2.new(1, -76, 0, 20), BackgroundTransparency = 1, Text = "Mère Poule", TextSize = 15, Font = FONT, TextColor3 = COL.yellow, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22 }, frame)
		textLbl = make("TextLabel", { Position = UDim2.fromOffset(66, 28), Size = UDim2.new(1, -78, 0, 76), BackgroundTransparency = 1, Text = "", TextSize = 17, Font = Enum.Font.GothamMedium, TextColor3 = COL.text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 22 }, frame)
		nextBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -8), Size = UDim2.fromOffset(100, 32), BackgroundColor3 = COL.yellow, Text = "Suivant ▶", TextSize = 15, Font = FONT, TextColor3 = COL.dark, ZIndex = 23 }, frame)
		corner(nextBtn, 16)
		btnRow = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -8), Size = UDim2.new(1, -120, 0, 34), BackgroundTransparency = 1, ZIndex = 23 }, frame)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, btnRow)
		-- pastille de la berceuse (étape 3) : consigne + « 🔁 Réécouter »
		pill = make("Frame", { Name = "HenLullaby", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -104), Size = UDim2.fromOffset(330, 40), BackgroundColor3 = COL.bg, BackgroundTransparency = 0.1, Visible = false, ZIndex = 18 }, ctx.gui)
		corner(pill, 20)
		make("UIStroke", { Color = COL.yellow, Thickness = 2 }, pill)
		pillLbl = make("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -130, 1, 0), BackgroundTransparency = 1, Text = "", TextSize = 13, Font = FONT, TextColor3 = COL.text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 19 }, pill)
		replayBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(112, 30), BackgroundColor3 = COL.yellow, Text = "🔁 Réécouter", TextSize = 13, Font = FONT, TextColor3 = COL.dark, ZIndex = 19 }, pill)
		corner(replayBtn, 15)
	end)

	local function clearButtons()
		if not btnRow then
			return
		end
		for _, c in ipairs(btnRow:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
	end

	local function close()
		token = token + 1
		dlg = nil
		if frame then
			frame.Visible = false
		end
	end
	self.close = close

	local function controls()
		if not dlg or not frame then
			return
		end
		local last = dlg.i >= #dlg.pages
		nextBtn.Visible = not last or #dlg.buttons == 0
		nextBtn.Text = last and "OK" or "Suivant ▶"
		btnRow.Visible = last and #dlg.buttons > 0
	end

	local function typePage()
		if not dlg then
			return
		end
		local d = dlg
		local mine = token
		local full = d.pages[d.i] or ""
		textLbl.Text = full
		if full ~= "" then
			playSound("poule_glousse") -- la Mère Poule glousse à chaque ligne de dialogue (volume bas)
		end
		d.typing = true
		textLbl.MaxVisibleGraphemes = 0
		controls()
		task.spawn(function()
			local t0 = os.clock()
			local total = utf8.len(full) or #full
			while dlg == d and token == mine and d.typing do
				local n = math.floor((os.clock() - t0) * H.bubbleCps)
				if n >= total then
					break
				end
				textLbl.MaxVisibleGraphemes = n
				task.wait(0.05)
			end
			if dlg == d and token == mine then
				d.typing = false
				textLbl.MaxVisibleGraphemes = -1
				controls()
				if #d.buttons == 0 and d.i >= #d.pages then -- réplique sans bouton : se referme seule
					task.delay(7, function()
						if dlg == d and token == mine then
							close()
						end
					end)
				end
			end
		end)
	end

	local function advance()
		if not dlg then
			return
		end
		if dlg.typing then
			dlg.typing = false
			textLbl.MaxVisibleGraphemes = -1
			controls()
		elseif dlg.i < #dlg.pages then
			dlg.i = dlg.i + 1
			typePage()
		elseif #dlg.buttons == 0 then
			close()
		end
	end

	local function onButton(id)
		if id == "go" then
			RAction:FireServer("henGo")
			close()
		elseif id == "again" then
			RAction:FireServer("henExplain")
		elseif id == "later" then
			close()
		elseif id == "hint" then
			RAction:FireServer("henHint")
		elseif id == "replay" then
			RAction:FireServer("henReplay")
			close()
		end
	end

	-- Affiche une réplique (identifiant de Config.HEN_LINES + paramètres envoyés par le serveur).
	local function show(id, params)
		if not okBuild or type(id) ~= "string" then
			return
		end
		local hen = henState()
		local d = Riddle.say(Config, id, type(params) == "table" and params or {}, hen and num(hen.step) and hen.step or 0)
		if #d.pages == 0 then
			return
		end
		token = token + 1
		clearButtons()
		dlg = { pages = d.pages, buttons = d.buttons, i = 1, typing = true }
		for k, b in ipairs(d.buttons) do
			local btn = make("TextButton", { LayoutOrder = k, Size = UDim2.fromOffset(b.id == "go" and 104 or 126, 34), BackgroundColor3 = (b.id == "go" or b.id == "hint") and COL.green or COL.panel, Text = b.text, TextSize = 14, Font = FONT, TextColor3 = (b.id == "go" or b.id == "hint") and COL.dark or COL.text, TextScaled = true, ZIndex = 24 }, btnRow)
			corner(btn, 17)
			make("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 9 }, btn)
			btn.Activated:Connect(function()
				onButton(b.id)
			end)
		end
		frame.Visible = true
		typePage()
	end
	self.show = show

	if okBuild then
		overlay.Activated:Connect(advance)
		nextBtn.Activated:Connect(advance)
		replayBtn.Activated:Connect(function()
			RAction:FireServer("henReplay")
		end)
	end

	---------------------------------------------------------------- Pierres : lueur et notes
	local highlights = {}
	local function stonePart(idx)
		for _, st in ipairs(CollectionService:GetTagged("RuneStone")) do
			if st:GetAttribute("Idx") == idx then
				return st
			end
		end
		return nil
	end
	local function glow(idx, seconds, good)
		pcall(function()
			local st = stonePart(idx)
			if not st then
				return
			end
			local h = highlights[idx]
			if not h or not h.Parent then
				h = Instance.new("Highlight")
				h.Name = "HenGlow"
				h.FillTransparency = 0.25
				h.OutlineTransparency = 0
				h.Parent = st
				highlights[idx] = h
			end
			h.Adornee = st
			h.FillColor = good == false and COL.red or Color3.fromRGB(255, 232, 140)
			h.OutlineColor = Color3.fromRGB(255, 255, 255)
			h.Enabled = true
			local mine = os.clock()
			h:SetAttribute("At", mine)
			task.delay(seconds, function()
				if h.Parent and h:GetAttribute("At") == mine then
					h.Enabled = false
				end
			end)
		end)
	end
	local playToken = 0
	local playing = false
	local function playLullaby(seq, note, gap)
		if type(seq) ~= "table" or not num(note) or not num(gap) then
			return
		end
		playToken = playToken + 1
		local mine = playToken
		playing = true
		task.spawn(function()
			for i, stone in ipairs(seq) do
				if playToken ~= mine then
					return
				end
				if type(stone) == "number" then
					glow(stone, note, true)
					playSound("berceuse_note" .. tostring(stone))
				end
				task.wait(note + gap)
			end
			if playToken == mine then
				playing = false
			end
		end)
	end

	---------------------------------------------------------------- ❗ au-dessus de la Mère Poule
	local alertGui, henBody
	local function ensureAlert(want)
		pcall(function()
			if not henBody or not henBody.Parent then
				local model = CollectionService:GetTagged("Hen")[1]
				henBody = model and (model.PrimaryPart or model:FindFirstChild("Body")) or nil
			end
			if not henBody then
				return
			end
			if not alertGui or not alertGui.Parent then
				alertGui = Instance.new("BillboardGui")
				alertGui.Name = "HenAlert"
				alertGui.Adornee = henBody
				alertGui.Size = UDim2.fromOffset(46, 52)
				alertGui.StudsOffsetWorldSpace = Vector3.new(0, 8.5, 0)
				alertGui.MaxDistance = H.alertRange
				alertGui.AlwaysOnTop = true
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.BackgroundTransparency = 1
				lbl.Text = "❗"
				lbl.TextSize = 44
				lbl.Font = FONT
				lbl.TextColor3 = Color3.fromRGB(255, 205, 40)
				lbl.TextStrokeTransparency = 0.3
				lbl.Parent = alertGui
				alertGui.Parent = player:WaitForChild("PlayerGui")
				TweenService:Create(alertGui, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { StudsOffsetWorldSpace = Vector3.new(0, 9.6, 0) }):Play()
			end
			alertGui.Enabled = want
		end)
	end

	---------------------------------------------------------------- Plumes : visibilité locale, scintillement
	local armed = {}
	local function updateFeathers()
		local hen = henState()
		local root = myRoot()
		local rx, rz = root and root.Position.X or 0, root and root.Position.Z or 0
		for _, f in ipairs(CollectionService:GetTagged("Feather")) do
			pcall(function()
				local dir = f:GetAttribute("Dir")
				local visible = hen ~= nil and hen.avail == true and num(hen.step) and hen.step <= 1 and not Riddle.hasFeather(num(hen.feathers) and hen.feathers or 0, dir)
				f.Transparency = visible and 0 or 1
				local pr = f:FindFirstChildOfClass("ProximityPrompt")
				if pr then
					pr.Enabled = visible
				end
				local em = f:FindFirstChildOfClass("ParticleEmitter")
				local d = math.sqrt((f.Position.X - rx) ^ 2 + (f.Position.Z - rz) ^ 2)
				local close = visible and root ~= nil and d <= H.sparkleDistance
				if em then
					em.Enabled = close
				end
				if close and armed[dir] ~= false then
					armed[dir] = false
					playSound("secret_decouvert") -- une plume cachée tout près (lot 8A : son approuvé)
				elseif not close and d > H.sparkleDistance + 20 then
					armed[dir] = nil
				end
			end)
		end
	end

	---------------------------------------------------------------- Pierres : texte de l'action selon l'étape ; pastille de la berceuse
	local function updateStones()
		local hen = henState()
		local sing = hen ~= nil and hen.step == 3
		for _, st in ipairs(CollectionService:GetTagged("RuneStone")) do
			pcall(function()
				local pr = st:FindFirstChildOfClass("ProximityPrompt")
				if pr then
					pr.ActionText = sing and "Chanter" or "Tourner la rune"
				end
			end)
		end
		if okBuild then
			local show3 = sing and not frame.Visible
			pill.Visible = show3
			if show3 then
				local n = num(hen.lullabyPos) and hen.lullabyPos or 0
				pillLbl.Text = playing and "🎵 Écoute la berceuse…" or ("🎵 Touche les pierres dans le même ordre (" .. n .. "/" .. H.lullabyLength .. ")")
			end
		end
	end

	---------------------------------------------------------------- Cible du faisceau et carte d'objectif
	local marker
	local function getMarker()
		if marker and marker.Parent then
			return marker
		end
		marker = Instance.new("Part")
		marker.Name = "HenGuide"
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = false
		marker.Transparency = 1
		marker.Size = Vector3.new(1, 1, 1)
		marker.Parent = workspace
		return marker
	end

	-- Partie sur laquelle le faisceau jaune se pose (ou nil quand l'énigme ne demande rien). root = HumanoidRootPart du joueur.
	function self.guideTarget(root)
		local hen = henState()
		if not hen or not root then
			return nil
		end
		local g = Riddle.guide(Config, hen, root.Position.X, root.Position.Z)
		if not g then
			return nil
		end
		if g.kind == "hen" then
			ensureAlert(hen.alert == true) -- retrouve aussi le corps de la Mère Poule
			if henBody and henBody.Parent then
				return henBody
			end
		elseif g.kind == "feather" then
			for _, f in ipairs(CollectionService:GetTagged("Feather")) do
				if f:GetAttribute("Dir") == g.dir and f.Parent then
					return f
				end
			end
		end
		local m = getMarker()
		m.Position = Vector3.new(g.x, 4, g.z)
		return m
	end

	-- Carte d'objectif : { title, text, frac } ou nil (énigme indisponible ou faite).
	function self.objective(st)
		local hen = type(st) == "table" and type(st.hen) == "table" and st.hen or nil
		if not hen or hen.avail ~= true or not num(hen.step) or hen.step >= 4 then
			return nil
		end
		local step, k = hen.step, num(hen.count) and hen.count or 0
		if step == 0 then
			return { title = "🐔 La Mère Poule t'appelle", text = "Va lui parler près du Grand Œuf : suis la flèche jaune.", frac = 0 }
		elseif step == 1 then
			return { title = "📜 Berceuse du jour", text = "Étape 1/3 · Plumes " .. k .. "/4 — suis la flèche jaune.", frac = k / 12 }
		elseif step == 2 then
			return { title = "📜 Berceuse du jour", text = "Étape 2/3 · Plumes 4/4 — règle les 4 runes.", frac = 1 / 3 + 0.15 }
		end
		local n = num(hen.lullabyPos) and hen.lullabyPos or 0
		return { title = "📜 Berceuse du jour", text = "Étape 3/3 · Plumes 4/4 — répète la berceuse (" .. n .. "/" .. H.lullabyLength .. ").", frac = 2 / 3 + n / H.lullabyLength / 3 }
	end

	function self.onState(st)
		state = st
		local hen = henState()
		ensureAlert(hen ~= nil and hen.alert == true)
		updateStones()
		updateFeathers()
	end

	---------------------------------------------------------------- Événements du serveur
	RHen.OnClientEvent:Connect(function(kind, a, b, c)
		local ok, err = pcall(function()
			if kind == "say" then
				show(a, b)
			elseif kind == "lullaby" then
				playLullaby(a, b, c)
			elseif kind == "tap" then
				if type(a) == "number" then
					glow(a, 0.5, b == true)
					if b == true then
						playSound("berceuse_note" .. tostring(a))
					else
						playSound("refuse")
					end
				end
			end
		end)
		if not ok then
			warn("[HenUi] " .. tostring(err)) -- jamais bloquant : l'énigme reste jouable avec les notifications
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.4)
			pcall(function()
				updateFeathers()
				updateStones()
				local root = myRoot()
				local hen = henState()
				if dlg and root and frame.Visible then -- la bulle se ferme si on s'éloigne
					local h = Config.Map2.hen
					if math.sqrt((root.Position.X - h.x) ^ 2 + (root.Position.Z - h.z) ^ 2) > 60 then
						close()
					end
				end
				ensureAlert(hen ~= nil and hen.alert == true)
			end)
		end
	end)
	return self
end

return HenUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX94"><Properties><string name="Name">EvolveUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/EvolveUi   (écran « ✨ Évoluer » des pets)
-- Construit l'écran d'évolution : bouton ✨ à droite, panneau avec la liste des pets de la base (prêt / doublons manquants / interdit / forme 2), détail du pet choisi
-- (gains de revenu et de force, les 3 doublons que le SERVEUR sacrifiera), confirmation en DEUX appuis (« Évoluer » puis « Confirmer », la 2e étape expire en 4 s),
-- retour visuel de 1 s au plus. TOUTE la logique (états, textes, disposition) vient du module pur EvolveLayout (testé) ; ici : uniquement des instances.
-- Le client n'envoie que « evoPreview » (indice) et « evolve » ({ i, maxCost = prix vu }) : le serveur décide doublons, coût et interdits (Evolution.plan) et répond sur
-- « Evo » ({ k = "preview", view } ou { k = "done" }). Config.EVOLUTION.enabled = false : l'écran affiche « bientôt », aucun bouton actif, AUCUN message envoyé.
-- Aucune erreur ne sort d'ici (start retourne nil si la construction échoue). Pas de += ni de continue (lanceur lupa).
local EvolveUi = {}

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- ctx = { Config, Evolution, Layout (EvolveLayout), player, gui, FONT, RAction, REvo, playSound, getState = fn() -> état du client, reduced }
function EvolveUi.start(ctx)
	if type(ctx) ~= "table" or type(ctx.Layout) ~= "table" or type(ctx.Evolution) ~= "table" or ctx.gui == nil or ctx.REvo == nil or ctx.RAction == nil then
		return nil
	end
	local Config, E, EL, FONT = ctx.Config, ctx.Evolution, ctx.Layout, ctx.FONT or Enum.Font.GothamBold
	local U = EL.UI
	local S = { alive = true, flow = EL.newFlow(), sig = nil, rowBtns = {}, conns = {}, fxToken = 0, lastPhase = "idle" }

	local function make(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = parent
		return o
	end
	local function snd(key)
		if type(ctx.playSound) == "function" then
			pcall(ctx.playSound, key)
		end
	end
	local function getState()
		local ok, st = pcall(ctx.getState)
		return ok and type(st) == "table" and st or nil
	end
	local function enabled()
		return EL.enabled(Config)
	end
	local function conn(sig, fn)
		S.conns[#S.conns + 1] = sig:Connect(fn)
	end

	local ok, err = pcall(function()
		S.open = make("TextButton", { Name = "EvolveButton", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0.3, -82), Size = UDim2.fromOffset(34, 34), Text = "✨", Font = FONT, TextSize = 18, BackgroundColor3 = rgb(U.btnOn), TextColor3 = rgb(U.darkText), AutoButtonColor = true }, ctx.gui)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.open)
		make("UIStroke", { Color = Color3.fromRGB(20, 80, 40), Thickness = 2 }, S.open)
		S.dot = make("Frame", { Name = "ReadyDot", Size = UDim2.fromOffset(10, 10), Position = UDim2.new(1, -9, 0, -1), BackgroundColor3 = rgb(U.ok), BorderSizePixel = 0, Visible = false }, S.open) -- pastille « un pet est prêt »
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, S.dot)

		S.root = make("Frame", { Name = "EvolvePanel", BackgroundColor3 = rgb(U.panel), Visible = false, ZIndex = 30, Active = true }, ctx.gui)
		make("UICorner", { CornerRadius = UDim.new(0, 16) }, S.root)
		make("UIStroke", { Color = rgb(U.panelStroke), Thickness = 3 }, S.root)
		S.title = make("TextLabel", { Name = "Title", BackgroundTransparency = 1, Font = FONT, TextSize = 20, Text = "✨ Évolution", TextColor3 = rgb(U.text), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31 }, S.root)
		S.sub = make("TextLabel", { Name = "Subtitle", BackgroundTransparency = 1, Font = FONT, TextSize = 13, Text = "", TextWrapped = true, TextColor3 = rgb(U.muted), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 31 }, S.root)
		S.close = make("TextButton", { Name = "Close", Font = FONT, TextSize = 18, Text = "✕", BackgroundColor3 = rgb(U.btnCancel), TextColor3 = rgb(U.cancelText), AutoButtonColor = true, ZIndex = 32 }, S.root)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.close)
		S.list = make("ScrollingFrame", { Name = "PetList", BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 31 }, S.root)
		make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, S.list)
		S.detail = make("Frame", { Name = "Detail", BackgroundTransparency = 1, ZIndex = 31 }, S.root)
		S.detailText = make("TextLabel", { Name = "DetailText", BackgroundTransparency = 1, Font = FONT, TextSize = 13, Text = "", TextWrapped = true, TextColor3 = rgb(U.text), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.fromScale(1, 1), ZIndex = 32 }, S.detail)
		S.primary = make("TextButton", { Name = "Primary", Font = FONT, TextSize = 15, TextWrapped = true, Text = "", BackgroundColor3 = rgb(U.btnOff), TextColor3 = rgb(U.offText), AutoButtonColor = false, ZIndex = 32 }, S.root)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.primary)
		S.cancel = make("TextButton", { Name = "Cancel", Font = FONT, TextSize = 15, Text = "Annuler", BackgroundColor3 = rgb(U.btnCancel), TextColor3 = rgb(U.cancelText), AutoButtonColor = true, Visible = false, ZIndex = 32 }, S.root)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, S.cancel)
		-- retour visuel : halo + pet + « ★2 » (créé à la demande, détruit après 1 s)
		S.fx = make("Frame", { Name = "EvolveFx", BackgroundTransparency = 1, Visible = false, ZIndex = 40, Size = UDim2.fromScale(1, 1) }, S.root)
	end)
	if not ok then
		if S.root then
			pcall(function()
				S.root:Destroy()
			end)
		end
		if S.open then
			pcall(function()
				S.open:Destroy()
			end)
		end
		return nil, err
	end

	local function place(inst, r)
		inst.Position = UDim2.fromOffset(r.x, r.y)
		inst.Size = UDim2.fromOffset(r.w, r.h)
	end
	local function guiSize()
		local okS, w, h = pcall(function()
			local a = ctx.gui.AbsoluteSize
			return a.X, a.Y
		end)
		if okS and type(w) == "number" and type(h) == "number" and w > 0 and h > 0 then
			return w, h
		end
		return nil, nil
	end
	local function relayout()
		local vw, vh = guiSize()
		local R = EL.rects(vw, vh, nil)
		S.rects = R
		-- le panneau est positionné en absolu dans l'écran : les rectangles des enfants sont relatifs au panneau
		local px, py = R.panel.x, R.panel.y
		local function rel(r)
			return { x = r.x - px, y = r.y - py, w = r.w, h = r.h }
		end
		place(S.root, R.panel)
		place(S.title, rel(R.header))
		place(S.sub, rel(R.subtitle))
		place(S.close, rel(R.close))
		place(S.list, rel(R.list))
		place(S.detail, rel(R.detail))
		place(S.primary, rel(R.primary))
		place(S.cancel, rel(R.cancel))
	end

	local function rowText(r)
		local form = r.form == 2 and " ★2" or ""
		return r.emoji .. " " .. r.name .. form .. "\n" .. r.tierName .. " · " .. r.tag
	end
	local function rowColor(status)
		if status == "ready" then
			return U.ok
		elseif status == "dupes" then
			return U.warn
		elseif status == "locked" then
			return U.bad
		end
		return U.muted
	end

	local function rebuildRows(rows)
		for _, b in ipairs(S.rowBtns) do
			pcall(function()
				b:Destroy()
			end)
		end
		S.rowBtns = {}
		for n, r in ipairs(rows) do
			local selected = S.flow.i == r.i
			local b = make("TextButton", { Name = "Row" .. r.i, LayoutOrder = n, Size = UDim2.new(1, -8, 0, EL.ROW_H), Font = FONT, TextSize = 14, TextWrapped = true, Text = rowText(r), TextColor3 = rgb(rowColor(r.status)), BackgroundColor3 = rgb(selected and U.rowSel or U.row), AutoButtonColor = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 32 }, S.list)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
			make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, b)
			if selected then
				make("UIStroke", { Color = rgb(U.panelStroke), Thickness = 2 }, b)
			end
			local idx = r.i
			conn(b.Activated, function()
				if not S.alive then
					return
				end
				snd("click")
				local _, act = EL.select(S.flow, idx, os.clock(), enabled())
				if act and act.kind == "preview" then
					pcall(function()
						ctx.RAction:FireServer("evoPreview", act.i)
					end)
				end
				S.refresh(true)
			end)
			S.rowBtns[#S.rowBtns + 1] = b
		end
	end

	-- Mise à jour complète de l'écran d'après l'état du joueur et la machine d'états.
	function S.refresh(forceRows)
		if not S.alive then
			return
		end
		pcall(function()
			local st = getState()
			local rows = st and EL.list(Config, E, st) or {}
			local on = enabled()
			S.dot.Visible = on and EL.countReady(rows) > 0
			if not S.root.Visible then
				return
			end
			local head = EL.header(Config, rows)
			S.title.Text = head.title
			S.sub.Text = head.subtitle .. (head.rule ~= "" and ("\nCoût : " .. head.rule .. ".") or "")
			S.sub.TextColor3 = rgb(head.soon and U.soon or U.muted)
			-- le pet choisi doit toujours exister et ne pas être en forme 2 : sinon retour au repos
			if S.flow.i ~= nil then
				local found = false
				for _, r in ipairs(rows) do
					if r.i == S.flow.i and (r.form ~= 2 or S.flow.phase == "done") then
						found = true
					end
				end
				if not found then
					EL.reset(S.flow)
				end
			end
			local parts = { on and "1" or "0", tostring(S.flow.i) }
			for _, r in ipairs(rows) do
				parts[#parts + 1] = r.i .. r.status .. r.form
			end
			local sig = table.concat(parts, ",")
			if forceRows or sig ~= S.sig then
				S.sig = sig
				if head.soon then
					rebuildRows({})
				else
					rebuildRows(rows)
				end
			end
			local btn = EL.button(S.flow, on, E)
			S.primary.Text = btn.text
			S.primary.Active = btn.active
			S.primary.AutoButtonColor = btn.active
			local confirm = btn.kind == "confirm"
			S.primary.BackgroundColor3 = rgb(btn.active and (confirm and U.btnConfirm or U.btnOn) or U.btnOff)
			S.primary.TextColor3 = rgb(btn.active and U.darkText or U.offText)
			S.cancel.Visible = btn.cancel
			local d = st and EL.detail(Config, st, S.flow) or nil
			if on and d then
				local chips = {}
				for _, c in ipairs(d.chips) do
					chips[#chips + 1] = c.emoji .. " #" .. c.i
				end
				local sac = #chips > 0 and ("Sacrifiés : " .. table.concat(chips, "  ")) or ""
				S.detailText.Text = d.emoji .. " " .. d.name .. " → forme 2\n" .. table.concat(d.lines, "\n") .. (sac ~= "" and ("\n" .. sac) or "")
			elseif head.soon then
				S.detailText.Text = "Revenu +" .. EL.pct(Config.EVOLUTION and Config.EVOLUTION.incomeMul) .. " %, force +" .. EL.pct(Config.EVOLUTION and Config.EVOLUTION.powerMul) .. " % : bientôt disponible.\nAucune forme payante : seulement des doublons et des pièces gagnées en jouant."
			else
				S.detailText.Text = "Touche un pet pour voir ce qu'il gagnerait."
			end
			if S.lastPhase ~= S.flow.phase then
				if S.flow.phase == "refused" then
					snd("refuse")
				end
				S.lastPhase = S.flow.phase
			end
		end)
	end

	-- Retour visuel (au plus EL.MAX_FX secondes) : halo qui s'éteint, pet qui rebondit, « ★2 » ; une seule animation à la fois, arrêtée à la destruction.
	function S.playFx(msg)
		S.fxToken = S.fxToken + 1
		local token = S.fxToken
		local def = type(msg) == "table" and Config.PETS and Config.PETS[msg.p] or nil
		pcall(function()
			for _, c in ipairs(S.fx:GetChildren()) do
				c:Destroy()
			end
			local halo = make("Frame", { Name = "Halo", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(150, 150), BackgroundColor3 = Color3.fromRGB(255, 236, 140), BorderSizePixel = 0, ZIndex = 41 }, S.fx)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, halo)
			local pet = make("TextLabel", { Name = "Pet", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(120, 100), BackgroundTransparency = 1, Font = FONT, TextSize = 72, Text = def and tostring(def.emoji) or "✨", ZIndex = 42 }, S.fx)
			local star = make("TextLabel", { Name = "Star", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 40), Size = UDim2.fromOffset(160, 36), BackgroundTransparency = 1, Font = FONT, TextSize = 28, Text = "★2", TextColor3 = Color3.fromRGB(255, 236, 140), TextStrokeTransparency = 0.3, ZIndex = 42 }, S.fx)
			local sc = make("UIScale", { Scale = 1 }, pet)
			S.fx.Visible = true
			local dur = math.min(EL.MAX_FX, EL.fxSeconds(ctx.reduced == true))
			task.spawn(function()
				local t0 = os.clock()
				while S.alive and S.fxToken == token do
					local a = (os.clock() - t0) / dur
					local f = EL.fx(a)
					pcall(function()
						sc.Scale = f.scale
						halo.BackgroundTransparency = f.haloTransparency
						star.TextTransparency = 1 - f.starAlpha
					end)
					if a >= 1 then
						break
					end
					task.wait(0.03)
				end
				if S.fxToken == token then
					pcall(function()
						S.fx.Visible = false
						for _, c in ipairs(S.fx:GetChildren()) do
							c:Destroy()
						end
					end)
				end
			end)
		end)
	end

	conn(S.open.Activated, function()
		snd("click")
		S.root.Visible = not S.root.Visible
		if S.root.Visible then
			pcall(relayout)
			S.sig = nil
			S.refresh(true)
		else
			EL.reset(S.flow)
		end
	end)
	conn(S.close.Activated, function()
		snd("click")
		S.root.Visible = false
		EL.reset(S.flow)
	end)
	conn(S.primary.Activated, function()
		if not S.alive then
			return
		end
		local _, act = EL.press(S.flow, os.clock(), enabled())
		if act and act.kind == "evolve" then
			snd("click")
			pcall(function()
				ctx.RAction:FireServer("evolve", { i = act.i, maxCost = act.maxCost })
			end)
		elseif S.flow.phase == "confirm" then
			snd("click")
		end
		S.refresh(false)
	end)
	conn(S.cancel.Activated, function()
		snd("click")
		EL.cancel(S.flow)
		S.refresh(false)
	end)
	conn(ctx.REvo.OnClientEvent, function(m)
		if not S.alive or type(m) ~= "table" then
			return
		end
		pcall(function()
			if m.k == "preview" and type(m.view) == "table" then
				EL.onPreview(S.flow, m.view, os.clock())
			elseif m.k == "done" then
				EL.onDone(S.flow, m, os.clock())
				if S.flow.phase == "done" then
					snd("levelup")
					S.playFx(m)
				end
			end
			S.refresh(false)
		end)
	end)
	pcall(function()
		conn(ctx.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
			if S.alive then
				pcall(relayout)
			end
		end)
	end)
	pcall(relayout)

	-- Horloge de l'écran : expiration de la 2e étape, délai de l'envoi, fin du retour visuel, aperçu différé ; ne fait rien tant que l'écran est fermé.
	task.spawn(function()
		local n = 0
		while S.alive do
			task.wait(0.25)
			n = n + 1
			pcall(function()
				if not S.root.Visible then
					if n % 8 == 0 then -- écran fermé : seule la pastille « un pet est prêt » est remise à jour (toutes les 2 s)
						S.refresh(false)
					end
					return
				end
				local now = os.clock()
				local _, act = EL.tick(S.flow, now)
				local due = EL.due(S.flow, now)
				local a = act or due
				if a and a.kind == "preview" and enabled() then
					pcall(function()
						ctx.RAction:FireServer("evoPreview", a.i)
					end)
				end
				S.refresh(false)
			end)
		end
	end)

	local self = { gui = S.root, button = S.open }
	function self.state()
		return S.flow.phase
	end
	function self.onState()
		S.refresh(false)
	end
	function self.destroy()
		if not S.alive then
			return
		end
		S.alive = false
		for _, c in ipairs(S.conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		S.conns = {}
		pcall(function()
			S.root:Destroy()
		end)
		pcall(function()
			S.open:Destroy()
		end)
	end
	S.refresh(false)
	return self
end

return EvolveUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX95"><Properties><string name="Name">CoinIcon</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/CoinIcon
-- Icônes de richesse dessinées par le code (Frames, UICorner, UIStroke, UIGradient) : 1 pièce, petite pile, grosse pile, coffre.
-- Aucune image ni identifiant. Retourne le conteneur ; aucune erreur ne sort d'ici (pcall) : nil si la construction échoue.
local CoinIcon = {}

local GOLD_TOP, GOLD_BOTTOM, DARK = Color3.fromRGB(255, 232, 120), Color3.fromRGB(224, 150, 20), Color3.fromRGB(78, 46, 6)

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function disc(parent, cx, cy, d)
	local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(d, d), BackgroundColor3 = Color3.new(1, 1, 1) }, parent)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
	make("UIStroke", { Color = DARK, Thickness = math.max(2, d * 0.1) }, f)
	make("UIGradient", { Color = ColorSequence.new(GOLD_TOP, GOLD_BOTTOM), Rotation = 90 }, f)
	return f
end

-- tier : 1 pièce, 2 petite pile, 3 grosse pile, 4 coffre. size : côté du conteneur en pixels.
function CoinIcon.build(parent, tier, size)
	local ok, root = pcall(function()
		local box = make("Frame", { Name = "CoinIcon", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
		local d = size * 0.34
		if tier <= 1 then
			disc(box, size / 2, size / 2, size * 0.62)
		elseif tier == 2 then
			for i = 0, 2 do
				disc(box, size * 0.22 + i * d * 0.9, size * 0.72, d)
			end
			for i = 0, 1 do
				disc(box, size * 0.34 + i * d * 0.9, size * 0.72 - d * 0.62, d)
			end
		elseif tier == 3 then
			local rows = { 4, 3, 2, 1 }
			for r, n in ipairs(rows) do
				for i = 0, n - 1 do
					disc(box, size / 2 + (i - (n - 1) / 2) * d * 0.88, size * 0.8 - (r - 1) * d * 0.62, d)
				end
			end
		else
			local body = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(size / 2, size * 0.42), Size = UDim2.fromOffset(size * 0.8, size * 0.46), BackgroundColor3 = Color3.fromRGB(150, 92, 44) }, box)
			make("UICorner", { CornerRadius = UDim.new(0.12, 0) }, body)
			make("UIStroke", { Color = DARK, Thickness = math.max(2, size * 0.05) }, body)
			make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)), Rotation = 90 }, body)
			local lid = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(size / 2, size * 0.46), Size = UDim2.fromOffset(size * 0.84, size * 0.24), BackgroundColor3 = Color3.fromRGB(190, 122, 56) }, box)
			make("UICorner", { CornerRadius = UDim.new(0.45, 0) }, lid)
			make("UIStroke", { Color = DARK, Thickness = math.max(2, size * 0.05) }, lid)
			make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(size / 2, size * 0.42), Size = UDim2.fromOffset(size * 0.1, size * 0.46), BackgroundColor3 = GOLD_BOTTOM, BorderSizePixel = 0 }, box)
			disc(box, size / 2, size * 0.62, size * 0.2)
			disc(box, size * 0.3, size * 0.3, d * 0.5)
			disc(box, size * 0.7, size * 0.26, d * 0.45)
		end
		return box
	end)
	return ok and root or nil
end

return CoinIcon
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
