-- Rend la liste des indices d'espèces d'une rareté (ordre croissant d'indice).
function Bestiary.speciesOfTier(tier)
	local out = {}
	for i, d in ipairs(Bestiary.PETS) do
		if d.tier == tier then
			out[#out + 1] = i
		end
	end
	return out
end

-- Description normalisée du repli procédural d'une espèce (jamais nil pour un indice valide) : sert au Builder et aux tests « chaque modèle a un repli ».
function Bestiary.fallback(idx)
	local d = Bestiary.PETS[idx]
	if not d then
		return nil
	end
	return { color = d.color, ears = d.ears, extra = d.extra, extra2 = d.extra2, accent = d.accent, glow = d.glow == true, scale = d.scale or 1 }
end

return Bestiary
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">PetXp</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/PetXp   (LOT 12 partie B, D.6)
-- Expérience et niveaux des pets : module PUR (aucun service Roblox, aucun require). L'XP est stockée sur l'emplacement du pet : `slot.x` = XP CUMULÉE (entier, champ déjà
-- créé à 0 par la migration v11 et assaini par Data.merge). Niveau 1 à 20 ; chaque niveau donne +1,5 % de pv et d'attaque (Battle.unit : stat x PetXp.statMul(niveau)).
-- RÈGLE FERME : l'XP de pet ne s'obtient QU'EN JOUANT (combat PvE/PvP/PNJ, carte Expérience D.5). Aucun produit, aucun pass, aucun reçu ne donne d'XP de pet
-- (PetXp.award refuse toute source hors liste blanche). L'effet « XP x2 » (série jour 5 = data.xp2Until, carte Effet = data.boosts.xp2) ne se gagne qu'en jouant.
-- Style : pas de `+=`, pas de `continue`, valeurs douteuses gardées par type avant toute comparaison.
local PetXp = {}

PetXp.MAX_LEVEL = 20
PetXp.PER_LEVEL = 0.015 -- +1,5 % pv / attaque par niveau au-dessus de 1
PetXp.MAX_AWARD = 100000 -- plafond d'un gain unique (anti-valeurs absurdes)
PetXp.TRAINER_MAX_LEVEL = 100
PetXp.TRAINER_MAX_XP = 1e9

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- XP à gagner pour passer du niveau L au niveau L+1 (D.6) : floor(40 x L^1,1). nil au niveau max ou pour un niveau invalide.
function PetXp.xpTo(L)
	if not isnum(L) or L < 1 or L >= PetXp.MAX_LEVEL then
		return nil
	end
	L = math.floor(L)
	return math.floor(40 * L ^ 1.1)
end

-- Seuils cumulés : CUM[L] = XP totale nécessaire pour ATTEINDRE le niveau L (CUM[1] = 0).
local CUM = { 0 }
for L = 1, PetXp.MAX_LEVEL - 1 do
	CUM[L + 1] = CUM[L] + PetXp.xpTo(L)
end
PetXp.CUM = CUM
PetXp.MAX_XP = CUM[PetXp.MAX_LEVEL] -- XP cumulée au niveau max : l'XP stockée ne dépasse jamais cette valeur

-- XP stockée saine (entier 0..MAX_XP). Idempotent.
function PetXp.sanitize(x)
	if not isnum(x) or x < 0 then
		return 0
	end
	x = math.floor(x)
	if x > PetXp.MAX_XP then
		return PetXp.MAX_XP
	end
	return x
end

-- (niveau, XP dans le niveau, XP requise pour le suivant | nil au max).
function PetXp.levelOf(x)
	x = PetXp.sanitize(x)
	local lv = 1
	while lv < PetXp.MAX_LEVEL and x >= CUM[lv + 1] do
		lv = lv + 1
	end
	if lv >= PetXp.MAX_LEVEL then
		return lv, 0, nil
	end
	return lv, x - CUM[lv], PetXp.xpTo(lv)
end

function PetXp.level(x)
	local lv = PetXp.levelOf(x)
	return lv
end

-- Multiplicateur de pv / attaque d'un niveau : 1 + 0,015 x (niveau - 1). Niveau invalide -> 1 ; plafonné au niveau max.
function PetXp.statMul(level)
	if not isnum(level) then
		return 1
	end
	level = math.min(PetXp.MAX_LEVEL, math.max(1, math.floor(level)))
	return 1 + PetXp.PER_LEVEL * (level - 1)
end

-- Ajoute `amount` (entier >= 0, plafonné) à l'XP cumulée `x`. Retourne (nouvelle XP, gain réel, niveau avant, niveau après).
function PetXp.add(x, amount)
	x = PetXp.sanitize(x)
	local before = PetXp.level(x)
	local a = 0
	if isnum(amount) and amount > 0 then
		a = math.min(PetXp.MAX_AWARD, math.floor(amount))
	end
	local nx = math.min(PetXp.MAX_XP, x + a)
	return nx, nx - x, before, PetXp.level(nx)
end

-- Vue pour l'interface : { level, into, need, frac, max }.
function PetXp.view(x)
	local lv, into, need = PetXp.levelOf(x)
	return { level = lv, into = into, need = need, frac = need and (into / need) or 1, max = lv >= PetXp.MAX_LEVEL }
end

---------------------------------------------------------------- Sources d'XP (D.6)
-- Liste blanche : on ne gagne de l'XP de pet qu'en jouant. Toute autre source (produit, pass, reçu, cadeau, don) vaut 0.
PetXp.SOURCES = { pve = true, pvp = true, npc = true, card = true }
PetXp.NPC_MUL = 0.6 -- D.5 : combats de PNJ, valeurs x0,6

function PetXp.sourceAllowed(source)
	return type(source) == "string" and PetXp.SOURCES[source] == true
end

-- XP de base par pet pour un combat terminé (D.6) : PvE gagné = 20 + 5 x étage, perdu = 5 ; PvP gagné 15, perdu 5 ; PNJ = formule PvE (étage 0) x 0,6.
function PetXp.combat(kind, win, floor)
	if kind == "pvp" then
		return win and 15 or 5
	end
	if kind == "npc" then
		return win and math.floor(20 * PetXp.NPC_MUL) or math.floor(5 * PetXp.NPC_MUL)
	end
	if kind ~= "pve" then
		return 0
	end
	if not win then
		return 5
	end
	local f = isnum(floor) and math.min(45, math.max(0, math.floor(floor))) or 0
	return 20 + 5 * f
end

-- Multiplicateur d'XP de COMBAT : x2 si l'effet « XP x2 » est actif (série : data.xp2Until ; carte Effet : data.boosts.xp2). Jamais vendu. Les cartes Expérience ne sont pas multipliées.
function PetXp.boostMul(data, now)
	if type(data) ~= "table" or not isnum(now) then
		return 1
	end
	if isnum(data.xp2Until) and data.xp2Until > now then
		return 2
	end
	if type(data.boosts) == "table" and isnum(data.boosts.xp2) and data.boosts.xp2 > now then
		return 2
	end
	return 1
end

-- Montant final d'un gain d'XP pour une source donnée : 0 pour toute source non autorisée (produit, Robux...). `mul` (>= 0) ne s'applique qu'aux combats.
function PetXp.award(source, base, mul)
	if not PetXp.sourceAllowed(source) or not isnum(base) or base <= 0 then
		return 0
	end
	local m = (source ~= "card" and isnum(mul) and mul > 0) and mul or 1
	return math.min(PetXp.MAX_AWARD, math.floor(base * m))
end

-- Donne `amount` d'XP à chacun des emplacements `team` (indices) de `slots` qui contiennent un pet (k == "p"). Retourne la liste { slot, gained, from, to } (niveaux).
function PetXp.addToTeam(slots, team, amount)
	local out = {}
	if type(slots) ~= "table" or type(team) ~= "table" then
		return out
	end
	local seen = {}
	for _, idx in ipairs(team) do
		local sl = isnum(idx) and slots[idx] or nil
		if type(sl) == "table" and sl.k == "p" and not seen[idx] then
			seen[idx] = true
			local nx, gained, from, to = PetXp.add(sl.x, amount)
			sl.x = nx
			out[#out + 1] = { slot = idx, gained = gained, from = from, to = to }
		end
	end
	return out
end

-- Vol / vente : un pet vendu ou volé perd son XP chez le propriétaire d'origine ; le voleur garde l'XP du pet volé (D.6). Retourne l'XP à reporter sur le nouvel emplacement.
function PetXp.carry(slot)
	if type(slot) == "table" and slot.k == "p" then
		return PetXp.sanitize(slot.x)
	end
	return 0
end

---------------------------------------------------------------- Niveau de Dresseur (D.6)
-- trainer = { xp } : total des XP gagnés (tous pets confondus) ; niveau = floor(sqrt(xp / 50)) + 1, max 100. Sert au matchmaking et aux titres : aucun effet sur la force.
function PetXp.sanitizeTrainer(saved)
	local xp = 0
	if type(saved) == "table" and isnum(saved.xp) and saved.xp > 0 then
		xp = math.min(PetXp.TRAINER_MAX_XP, math.floor(saved.xp))
	end
	return { xp = xp }
end

function PetXp.trainerLevel(xp)
	if not isnum(xp) or xp < 0 then
		return 1
	end
	return math.min(PetXp.TRAINER_MAX_LEVEL, math.floor(math.sqrt(xp / 50)) + 1)
end

function PetXp.trainerAdd(trainer, amount)
	local t = PetXp.sanitizeTrainer(trainer)
	if isnum(amount) and amount > 0 then
		t.xp = math.min(PetXp.TRAINER_MAX_XP, t.xp + math.min(PetXp.MAX_AWARD, math.floor(amount)))
	end
	return t
end

return PetXp
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">BattleRewards</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/BattleRewards   (LOT 12 partie B, D.5)
-- Récompense AU CHOIX après une victoire PvE (tour des Dresseurs, combats de PNJ) : module PUR (aucun service Roblox). Ne remplace pas Rewards.lua (série / calendrier du lot 15).
-- Le SERVEUR tire 3 cartes de 3 catégories DIFFÉRENTES (poids : Pièces 30, Expérience 25, Œuf 15, Vitesse 15, Effet 15 ; aux boss, une des 3 est toujours l'Œuf), les enregistre dans
-- `data.battle.pendingPick = { id, cards, expires, floor, mode }` puis les envoie au client ; le joueur en choisit une en 15 s, sinon la première. Se déconnecter ou relancer ne
-- retire pas la récompense et n'en retire pas de nouvelle : BattleRewards.offer renvoie le tirage existant.
-- Aucune carte ne donne de force payante : pièces, XP de pet (PetXp, jamais vendu), un œuf, de la vitesse de piste GAGNÉE, un boost temporaire gagné en jouant (aucun Robux).
-- Aléa : Park-Miller (48271 mod 2^31-1) en double précision, graine INJECTABLE (le serveur passe une graine issue de Random ; les tests passent une graine fixe).
-- Config attendu (existant) : towerTier, liveEggTier, nextLiveTier, eggCoinValue (optionnel), TIERS, fmt (optionnel). Pas de += ni de continue (lanceur lupa).
local BattleRewards = {}

BattleRewards.PICK_SECONDS = 15
BattleRewards.CARD_COUNT = 3
-- Poids de tirage (D.5), dans l'ordre de tirage stable.
BattleRewards.KINDS = { "coins", "xp", "egg", "speed", "effect" }
BattleRewards.WEIGHTS = { coins = 30, xp = 25, egg = 15, speed = 15, effect = 15 }
-- Multiplicateurs de valeur : première victoire de l'étage x2, victoire répétée x0,5, combat de PNJ x0,6 (D.5).
BattleRewards.MODE_MUL = { first = 2, ["repeat"] = 0.5, npc = 0.6, normal = 1 }
BattleRewards.COINS_MIN = 500
BattleRewards.COINS_SECONDS = 90 -- « revenus de 1,5 min »
BattleRewards.MAX_FLOOR = 45
-- Effets (boosts temporaires) : durée en secondes, non cumulables avec eux-mêmes (prolongent), plafond 30 min. `name` : libellé affiché.
BattleRewards.EFFECTS = {
	income2 = { name = "Revenus ×2", seconds = 300, order = 1 },
	luck10 = { name = "Chance +10 points", seconds = 300, order = 2 },
	xp2 = { name = "XP ×2", seconds = 600, order = 3 },
	speed15 = { name = "Vitesse +15 %", seconds = 300, order = 4 },
}
BattleRewards.EFFECT_KEYS = { "income2", "luck10", "xp2", "speed15" }
BattleRewards.BOOST_CAP_SECONDS = 1800

local COINS_CAP, XP_CAP, SPEED_CAP = 1e15, 100000, 1000

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function int(v, lo, hi, def)
	if not isnum(v) then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

---------------------------------------------------------------- Aléa : Park-Miller 48271 mod 2^31-1
local M = 2147483647
local A = 48271 -- état < 2^31, produit < 2^47 : exact en double précision (pas de 1103515245)
BattleRewards.MODULUS, BattleRewards.MULTIPLIER = M, A

-- Générateur à graine injectable. Toute graine (même NaN, négative, énorme) devient un état valide 1..M-1.
function BattleRewards.rng(seed)
	local s = 1
	if isnum(seed) then
		s = math.floor(math.abs(seed)) % (M - 1)
		if s == 0 then
			s = 1
		end
	end
	local r = {}
	function r.next() -- flottant dans ]0 ; 1[
		s = (s * A) % M
		return s / M
	end
	function r.int(lo, hi) -- entier dans [lo ; hi]
		return lo + math.floor(r.next() * (hi - lo + 1))
	end
	function r.state()
		return s
	end
	return r
end

---------------------------------------------------------------- Valeurs des cartes (D.5)
local function modeOf(ctx)
	local m = type(ctx) == "table" and ctx.mode or nil
	if m ~= nil and BattleRewards.MODE_MUL[m] then
		return m
	end
	return "normal"
end

local function scaled(base, mul, lo)
	return math.max(lo, math.floor(base * mul + 1e-9))
end

-- Rareté de l'étage ; l'œuf d'un BOSS est d'un cran au-dessus (règle existante, jamais au-delà de 8 : ni Exclusif ni Divin), toujours une rareté publiée.
function BattleRewards.eggTierFor(Config, floor, boss)
	local rt = Config.towerTier(math.max(1, floor))
	local t = rt
	if boss then
		t = math.min(8, Config.nextLiveTier(rt) or rt)
	end
	return Config.liveEggTier(t)
end

-- ctx = { floor (0 pour un PNJ), income (revenu par seconde), mode ("first" | "repeat" | "npc" | "normal") }. Retourne une carte { kind, ... } sans état caché.
function BattleRewards.makeCard(Config, kind, ctx, rnd)
	local f = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0)
	local mul = BattleRewards.MODE_MUL[modeOf(ctx)]
	local boss = f >= 5 and f % 5 == 0 and modeOf(ctx) ~= "npc"
	if kind == "coins" then
		local income = isnum(ctx.income) and math.max(0, ctx.income) or 0
		local base = math.max(BattleRewards.COINS_MIN, income * BattleRewards.COINS_SECONDS * (1 + f / 10))
		return { kind = "coins", amount = math.min(COINS_CAP, scaled(base, mul, 1)) }
	elseif kind == "xp" then
		return { kind = "xp", amount = math.min(XP_CAP, scaled(30 + 10 * f, mul, 1)) }
	elseif kind == "egg" then
		return { kind = "egg", tier = BattleRewards.eggTierFor(Config, f, boss) }
	elseif kind == "speed" then
		return { kind = "speed", amount = math.min(SPEED_CAP, scaled(2 + f // 5, mul, 1)) }
	end
	local key = BattleRewards.EFFECT_KEYS[rnd.int(1, #BattleRewards.EFFECT_KEYS)]
	return { kind = "effect", key = key, seconds = BattleRewards.EFFECTS[key].seconds }
end

---------------------------------------------------------------- Tirage de 3 cartes
-- Tirage pondéré SANS remise sur les catégories : 3 catégories distinctes. `boss` : l'Œuf est d'office l'une des 3. L'ordre final est mélangé (Fisher-Yates).
function BattleRewards.draw(Config, ctx, seed)
	local rnd = BattleRewards.rng(seed)
	local f = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0)
	local boss = f >= 5 and f % 5 == 0 and modeOf(ctx) ~= "npc"
	local pool, kinds = {}, {}
	for _, k in ipairs(BattleRewards.KINDS) do
		pool[#pool + 1] = k
	end
	local function take(k)
		for i, v in ipairs(pool) do
			if v == k then
				table.remove(pool, i)
				break
			end
		end
		kinds[#kinds + 1] = k
	end
	if boss then
		take("egg")
	end
	while #kinds < BattleRewards.CARD_COUNT do
		local total = 0
		for _, k in ipairs(pool) do
			total = total + BattleRewards.WEIGHTS[k]
		end
		local roll, pick = rnd.next() * total, pool[#pool]
		for _, k in ipairs(pool) do
			roll = roll - BattleRewards.WEIGHTS[k]
			if roll < 0 then
				pick = k
				break
			end
		end
		take(pick)
	end
	for i = #kinds, 2, -1 do
		local j = rnd.int(1, i)
		kinds[i], kinds[j] = kinds[j], kinds[i]
	end
	local cards = {}
	for _, k in ipairs(kinds) do
		cards[#cards + 1] = BattleRewards.makeCard(Config, k, ctx, rnd)
	end
	return cards
end

---------------------------------------------------------------- pendingPick : enregistrement serveur
-- Crée un tirage enregistrable : { id, cards, expires, floor, mode }. `id` est fourni par le serveur (compteur ou chaîne) ; `now` = os.time().
function BattleRewards.newPick(Config, ctx, seed, now, id)
	return {
		id = id,
		cards = BattleRewards.draw(Config, ctx, seed),
		expires = (isnum(now) and now or 0) + BattleRewards.PICK_SECONDS,
		floor = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0),
		mode = modeOf(ctx),
	}
end

-- Point d'entrée serveur après une victoire : s'il existe déjà un pendingPick (assaini), il est RENDU TEL QUEL (pas de nouveau tirage : se reconnecter ou enchaîner
-- ne fait ni perdre ni refaire la récompense). Retourne (pick, estNouveau). Le serveur doit stocker `pick` dans data.battle.pendingPick quand estNouveau.
function BattleRewards.offer(Config, pending, ctx, seed, now, id)
	local clean = BattleRewards.sanitizePending(Config, pending)
	if clean then
		return clean, false
	end
	return BattleRewards.newPick(Config, ctx, seed, now, id), true
end

function BattleRewards.expired(pick, now)
	return type(pick) == "table" and isnum(pick.expires) and isnum(now) and now >= pick.expires
end

-- Choix du joueur : retourne (carte, auto). Index invalide avant expiration -> nil, "bad_index" (le serveur ignore et NE consomme pas) ; après expiration, la première carte
-- est donnée d'office (auto = true), quel que soit l'index. id différent -> nil, "bad_id". Le serveur met data.battle.pendingPick = nil AVANT d'attribuer (pas de double gain).
function BattleRewards.claim(pick, id, index, now)
	if type(pick) ~= "table" or type(pick.cards) ~= "table" or #pick.cards == 0 then
		return nil, "no_pick"
	end
	if id ~= nil and pick.id ~= id then
		return nil, "bad_id"
	end
	if BattleRewards.expired(pick, now) then
		return pick.cards[1], true
	end
	if isnum(index) and index % 1 == 0 and index >= 1 and index <= #pick.cards then
		return pick.cards[index], false
	end
	return nil, "bad_index"
end

-- Secondes restantes (>= 0) pour l'affichage client ; à la reconnexion un tirage échu est résolu par claim (auto), un tirage vivant est renvoyé avec son temps restant.
function BattleRewards.remaining(pick, now)
	if type(pick) ~= "table" or not isnum(pick.expires) or not isnum(now) then
		return 0
	end
	return math.max(0, pick.expires - now)
end

---------------------------------------------------------------- Assainissement (profil)
local function cleanCard(Config, c)
	if type(c) ~= "table" then
		return nil
	end
	local kind = c.kind
	if kind == "coins" and isnum(c.amount) then
		return { kind = "coins", amount = int(c.amount, 1, COINS_CAP, 1) }
	elseif kind == "xp" and isnum(c.amount) then
		return { kind = "xp", amount = int(c.amount, 1, XP_CAP, 1) }
	elseif kind == "speed" and isnum(c.amount) then
		return { kind = "speed", amount = int(c.amount, 1, SPEED_CAP, 1) }
	elseif kind == "egg" and isnum(c.tier) then
		local n = type(Config.TIERS) == "table" and #Config.TIERS or 10
		return { kind = "egg", tier = int(c.tier, 1, n, 1) }
	elseif kind == "effect" and type(c.key) == "string" and BattleRewards.EFFECTS[c.key] then
		return { kind = "effect", key = c.key, seconds = BattleRewards.EFFECTS[c.key].seconds }
	end
	return nil
end

-- Assainit un pendingPick lu dans un profil : table valide (3 cartes de catégories distinctes, expires numérique) ou nil. IDEMPOTENT : sanitize(sanitize(x)) == sanitize(x).
function BattleRewards.sanitizePending(Config, saved)
	if type(saved) ~= "table" or type(saved.cards) ~= "table" or not isnum(saved.expires) then
		return nil
	end
	if not (type(saved.id) == "string" or isnum(saved.id)) then
		return nil
	end
	local cards, seen = {}, {}
	for _, c in ipairs(saved.cards) do
		local cc = cleanCard(Config, c)
		if cc and not seen[cc.kind] and #cards < BattleRewards.CARD_COUNT then
			seen[cc.kind] = true
			cards[#cards + 1] = cc
		end
	end
	if #cards ~= BattleRewards.CARD_COUNT then
		return nil
	end
	local mode = type(saved.mode) == "string" and BattleRewards.MODE_MUL[saved.mode] and saved.mode or "normal"
	return { id = saved.id, cards = cards, expires = int(saved.expires, 0, 4e9, 0), floor = int(saved.floor, 0, BattleRewards.MAX_FLOOR, 0), mode = mode }
end

-- Boosts temporaires : { income2, luck10, xp2, speed15 } = os.time() de fin (entier). Clés inconnues supprimées, valeurs <= 0 supprimées. IDEMPOTENT.
function BattleRewards.sanitizeBoosts(saved)
	local out = {}
	if type(saved) == "table" then
		for _, key in ipairs(BattleRewards.EFFECT_KEYS) do
			local v = saved[key]
			if isnum(v) and v > 0 then
				out[key] = int(v, 1, 4e9, 1)
			end
		end
	end
	return out
end

function BattleRewards.boostActive(boosts, key, now)
	return type(boosts) == "table" and isnum(boosts[key]) and isnum(now) and boosts[key] > now
end

-- Applique (ou prolonge) un boost : jamais cumulé avec lui-même, fin plafonnée à now + 30 min. Retourne la nouvelle fin.
function BattleRewards.applyBoost(boosts, key, seconds, now)
	local def = BattleRewards.EFFECTS[key]
	if type(boosts) ~= "table" or not def or not isnum(now) then
		return nil
	end
	local sec = isnum(seconds) and math.max(0, math.min(BattleRewards.BOOST_CAP_SECONDS, seconds)) or def.seconds
	local cur = isnum(boosts[key]) and boosts[key] or 0
	local ends = math.min(now + BattleRewards.BOOST_CAP_SECONDS, math.max(now, cur) + sec)
	boosts[key] = math.floor(ends)
	return boosts[key]
end

---------------------------------------------------------------- Attribution (serveur)
-- data = profil { coins, speed, boosts, slots, battle = { team } } ; hooks.giveEgg(tier) -> true si l'œuf est placé (base pleine -> false : son prix en pièces).
-- Retourne un résumé { kind, coins?, xp?, speed?, egg?, effect?, converted?, levelUps? } pour l'écran de résultat. N'effleure JAMAIS data.rb ni un champ payant.
function BattleRewards.grant(Config, data, card, hooks, now, PetXp)
	local c = cleanCard(Config, card)
	if not c or type(data) ~= "table" then
		return nil
	end
	local out = { kind = c.kind }
	if c.kind == "coins" then
		data.coins = (isnum(data.coins) and data.coins or 0) + c.amount
		out.coins = c.amount
	elseif c.kind == "xp" then
		out.xp = c.amount
		out.pets = {}
		if PetXp and type(data.battle) == "table" then
			out.pets = PetXp.addToTeam(data.slots, data.battle.team, c.amount)
		end
	elseif c.kind == "speed" then
		data.speed = (isnum(data.speed) and data.speed or 0) + c.amount
		out.speed = c.amount
	elseif c.kind == "egg" then
		local placed = type(hooks) == "table" and type(hooks.giveEgg) == "function" and hooks.giveEgg(c.tier) == true
		if placed then
			out.egg = c.tier
		else
			local price = type(Config.eggCoinValue) == "function" and Config.eggCoinValue(c.tier) or 0
			data.coins = (isnum(data.coins) and data.coins or 0) + price
			out.coins, out.converted, out.egg = price, true, c.tier
		end
	else
		if type(data.boosts) ~= "table" then
			data.boosts = {}
		end
		out.effect = c.key
		out.endsAt = BattleRewards.applyBoost(data.boosts, c.key, c.seconds, now)
	end
	return out
end

---------------------------------------------------------------- Affichage (texte sans état, utilisable par le serveur pour la vue)
function BattleRewards.cardText(Config, card)
	local fmt = type(Config) == "table" and type(Config.fmt) == "function" and Config.fmt or tostring
	local c = type(card) == "table" and card or {}
	if c.kind == "coins" then
		return "🪙", "Pièces", "+" .. fmt(c.amount or 0) .. " 🪙"
	elseif c.kind == "xp" then
		return "⭐", "Expérience", "+" .. tostring(c.amount or 0) .. " XP à chaque pet de l'équipe"
	elseif c.kind == "egg" then
		local t = type(Config) == "table" and type(Config.TIERS) == "table" and Config.TIERS[c.tier or 0] or nil
		return "🥚", "Œuf", "1 œuf " .. (t and t.name or "?")
	elseif c.kind == "speed" then
		return "👟", "Vitesse", "+" .. tostring(c.amount or 0) .. " de vitesse permanente"
	elseif c.kind == "effect" then
		local e = BattleRewards.EFFECTS[c.key or ""]
		return "✨", "Effet", e and (e.name .. " · " .. math.floor(e.seconds / 60) .. " min") or "?"
	end
	return "?", "?", ""
end

-- Vue envoyée au client : AUCUNE donnée de tirage (graine) ; juste de quoi afficher et renvoyer l'index choisi.
function BattleRewards.view(Config, pick, now)
	local cards = {}
	for i, c in ipairs(pick.cards) do
		local icon, title, desc = BattleRewards.cardText(Config, c)
		cards[i] = { kind = c.kind, icon = icon, title = title, desc = desc, boss = c.kind == "egg" and pick.floor % 5 == 0 and pick.floor > 0 and pick.mode ~= "npc" or nil }
	end
	return { id = pick.id, cards = cards, seconds = BattleRewards.remaining(pick, now), floor = pick.floor }
end

return BattleRewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Duel</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Duel   (lot 13, E.1 E.2 E.4, B.4)
-- Règles PURES du duel local et des ligues (aucun service Roblox, aucun require, horloge injectée, jamais d'erreur sur entrée invalide). Pas de += ni de continue (lanceur lupa).
-- Le serveur (Main.server.lua) fait les effets (placement sur le sable, Battle.turn, notifications) ; ce module décide.
--   Duel.canChallenge(ctx, cfg)        -> ok, raison, côté ("a" défieur | "b" défié)   [6 refus de E.2 + soi-même + occupé]
--   Duel.newBook() / request / answer / decline / expire / finish   -> carnet des défis (délai 20 s, un seul accepté)
--   Duel.newMatch / noteTurn            -> compteur d'inactivité : 2 tours sans action = forfait
--   Duel.settle(duelA, duelB, ...)      -> récompenses (10/jour, 3/paire/jour), ratio V/D ; AUCUN trophée
--   Duel.percent / record / recordFor   -> ratio « 124 V / 37 D (77 %) » (même formule que IntroPlan)
--   Duel.league / seasonReset / seasonReward / introSide -> ligues, saison, données d'intro B.4
local Duel = {}

Duel.CAP = 10000000
Duel.REASONS = { "self", "range", "egg", "chased", "dialogue", "castle", "newbie", "busy", "flying", "cinematic" }

local DEFAULT = { range = 30, requestTimeout = 20, sameTargetCooldown = 120, rewardedPerDay = 10, samePairRewardedPerDay = 3, turnSeconds = 10, afkTurnsToForfeit = 2, coinsWinMins = 1, coinsLoseMins = 0.25, maxPendingPerTarget = 3, maxCoins = 1e12 }

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function cfgOf(cfg)
	local c = {}
	for k, v in pairs(DEFAULT) do
		c[k] = v
	end
	if type(cfg) == "table" then
		for k, v in pairs(cfg) do
			if DEFAULT[k] ~= nil and isNum(v) then
				c[k] = v
			end
		end
	end
	return c
end

local function count(v)
	if not isNum(v) or v < 0 then
		return 0
	end
	return math.min(Duel.CAP, math.floor(v))
end

-- ---------------------------------------------------------------- Ratio
function Duel.percent(wins, losses)
	local w, l = count(wins), count(losses)
	return math.floor(100 * w / math.max(1, w + l) + 0.5)
end

function Duel.record(wins, losses)
	local w, l = count(wins), count(losses)
	return w .. " V / " .. l .. " D (" .. Duel.percent(w, l) .. " %)"
end

-- Victoires/défaites selon le mode (B.4). profile = battle (données du joueur) ; PNJ : passer { wins, losses } fixes au lieu d'un profil.
-- pvp = battle.pvp.wins/losses + battle.live.w/l ; duel = battle.duel.w/l ; pve = battle.pve.w/l ; tower = étage atteint (V = étages franchis, D = 0).
function Duel.recordFor(mode, battle)
	local b = type(battle) == "table" and battle or {}
	if mode == "duel" then
		local d = type(b.duel) == "table" and b.duel or {}
		return count(d.w), count(d.l)
	elseif mode == "pvp" then
		local p = type(b.pvp) == "table" and b.pvp or {}
		local lv = type(b.live) == "table" and b.live or {}
		return math.min(Duel.CAP, count(p.wins) + count(lv.w)), math.min(Duel.CAP, count(p.losses) + count(lv.l))
	elseif mode == "pve" then
		local d = type(b.pve) == "table" and b.pve or {}
		return count(d.w), count(d.l)
	elseif mode == "tower" then
		return count(b.best), 0
	elseif mode == "npc" then
		return count(b.wins), count(b.losses)
	end
	return 0, 0
end

-- ---------------------------------------------------------------- Ligues
-- leagues = Config.LEAGUES (liste triée par min croissant). Retourne l'entrée de la ligue (la plus haute dont min <= trophées), jamais nil si la liste est valide.
function Duel.league(leagues, trophies)
	local t = isNum(trophies) and math.max(0, math.floor(trophies)) or 0
	local best, idx
	if type(leagues) ~= "table" then
		return nil, 0
	end
	for i = 1, #leagues do
		local L = leagues[i]
		if type(L) == "table" and isNum(L.min) and t >= L.min and (best == nil or L.min >= best.min) then
			best, idx = L, i
		end
	end
	return best, idx or 0
end

-- Texte de ligue pour l'intro (IntroPlan : 16 caractères max) : « 🥇 Or ».
function Duel.leagueText(leagues, trophies)
	local L = Duel.league(leagues, trophies)
	if not L then
		return ""
	end
	return ((type(L.icon) == "string" and L.icon ~= "") and (L.icon .. " ") or "") .. tostring(L.name)
end

-- Remise partielle de saison (E.4) : sous 300 inchangé ; au-delà trophées = max(300, floor(trophées x 0,6)).
function Duel.seasonReset(trophies, from, factor)
	local t = isNum(trophies) and math.max(0, math.floor(trophies)) or 0
	local f = isNum(from) and from or 300
	local k = isNum(factor) and factor or 0.6
	if t <= f then
		return t
	end
	return math.max(f, math.floor(t * k))
end

-- Meilleure récompense dont le seuil est atteint (rewards triées par trophées croissants).
function Duel.seasonReward(rewards, trophies)
	local t = isNum(trophies) and trophies or 0
	local best
	if type(rewards) ~= "table" then
		return nil
	end
	for i = 1, #rewards do
		local r = rewards[i]
		if type(r) == "table" and isNum(r.trophies) and t >= r.trophies and (best == nil or r.trophies >= best.trophies) then
			best = r
		end
	end
	return best
end

-- Un côté de l'intro (B.4) à passer à IntroPlan.plan : { name, userId, wins, losses, league, trophies, pets }.
function Duel.introSide(mode, battle, base, leagues)
	local w, l = Duel.recordFor(mode, battle)
	local b = type(base) == "table" and base or {}
	local tr = count(b.trophies)
	return { name = b.name, userId = b.userId, wins = w, losses = l, league = Duel.leagueText(leagues, tr), trophies = tr, pets = b.pets }
end

-- ---------------------------------------------------------------- Défi : 6 cas de refus (E.2) + soi-même + occupé
-- ctx = { a = { userId, carryingEgg, chased, inDialogue, inCastle, newbie, busy, flying, inCinematic }, b = { même forme }, distance = studs }
-- Intégration lot 13 : `flying` (vol d'œuf en cours) et `inCinematic` (grande éclosion) ajoutés après les 6 cas de E.2.
-- newbie = protection débutant ACTIVE (déjà non désactivée). Retourne true | false, raison, "a"|"b".
function Duel.canChallenge(ctx, cfg)
	local c = cfgOf(cfg)
	if type(ctx) ~= "table" or type(ctx.a) ~= "table" or type(ctx.b) ~= "table" then
		return false, "busy", "a"
	end
	if ctx.a.userId ~= nil and ctx.a.userId == ctx.b.userId then
		return false, "self", "a"
	end
	if not isNum(ctx.distance) or ctx.distance > c.range or ctx.distance < 0 then
		return false, "range", "b"
	end
	local keys = { { "carryingEgg", "egg" }, { "chased", "chased" }, { "inDialogue", "dialogue" }, { "inCastle", "castle" }, { "newbie", "newbie" }, { "busy", "busy" }, { "flying", "flying" }, { "inCinematic", "cinematic" } }
	local sides = { { "a", ctx.a }, { "b", ctx.b } }
	for k = 1, #keys do
		for s = 1, 2 do
			if sides[s][2][keys[k][1]] == true then
				return false, keys[k][2], sides[s][1]
			end
		end
	end
	return true, "", ""
end

-- ---------------------------------------------------------------- Carnet des défis
-- book = { pending = { [challengerId] = { from, to, t } }, last = { ["from>to"] = t }, active = { [userId] = duelId }, nextId }
function Duel.newBook()
	return { pending = {}, last = {}, active = {}, nextId = 1 }
end

local function pendingFor(book, to)
	local n = 0
	for _, p in pairs(book.pending) do
		if p.to == to then
			n = n + 1
		end
	end
	return n
end

-- Envoie un défi. ctx comme canChallenge (+ ctx.a.userId, ctx.b.userId nombres). Retourne true | false, raison.
function Duel.request(book, ctx, now, cfg)
	local c = cfgOf(cfg)
	if type(book) ~= "table" or type(ctx) ~= "table" or type(ctx.a) ~= "table" or type(ctx.b) ~= "table" or not isNum(ctx.a.userId) or not isNum(ctx.b.userId) or not isNum(now) then
		return false, "busy"
	end
	local from, to = ctx.a.userId, ctx.b.userId
	if book.active[from] or book.active[to] then
		return false, "busy"
	end
	local ok, why = Duel.canChallenge(ctx, c)
	if not ok then
		return false, why
	end
	local last = book.last[from .. ">" .. to]
	if last and now - last < c.sameTargetCooldown then
		return false, "cooldown"
	end
	local mine = book.pending[from]
	if mine and now - mine.t < c.requestTimeout then
		return false, "pendingOut"
	end
	if pendingFor(book, to) >= c.maxPendingPerTarget then
		return false, "crowded"
	end
	book.pending[from] = { from = from, to = to, t = now }
	book.last[from .. ">" .. to] = now
	return true, ""
end

-- Le défié accepte le défi de `from`. Un seul défi accepté : tous les autres défis qui touchent l'un des deux sont annulés (retournés).
-- Retourne true, duelId, annulés | false, raison.
function Duel.answer(book, to, from, accept, now, cfg, ctx)
	local c = cfgOf(cfg)
	local p = type(book) == "table" and isNum(from) and book.pending[from] or nil
	if not p or p.to ~= to or not isNum(now) then
		return false, "none"
	end
	if now - p.t > c.requestTimeout then
		book.pending[from] = nil
		return false, "expired"
	end
	if not accept then
		book.pending[from] = nil
		return false, "declined"
	end
	if book.active[from] or book.active[to] then
		book.pending[from] = nil
		return false, "busy"
	end
	if ctx ~= nil then
		local ok, why = Duel.canChallenge(ctx, c) -- états relus à l'acceptation
		if not ok then
			book.pending[from] = nil
			return false, why
		end
	end
	book.pending[from] = nil
	local id = book.nextId
	book.nextId = id + 1
	book.active[from], book.active[to] = id, id
	local cancelled = {}
	for k, q in pairs(book.pending) do
		if q.from == from or q.to == from or q.from == to or q.to == to then
			cancelled[#cancelled + 1] = { from = q.from, to = q.to }
			book.pending[k] = nil
		end
	end
	return true, id, cancelled
end

function Duel.decline(book, to, from, now, cfg)
	return Duel.answer(book, to, from, false, now, cfg)
end

-- Défis expirés (à appeler toutes les secondes) : retourne la liste { from, to } retirée.
function Duel.expire(book, now, cfg)
	local c = cfgOf(cfg)
	local out = {}
	if type(book) ~= "table" or not isNum(now) then
		return out
	end
	for k, p in pairs(book.pending) do
		if now - p.t > c.requestTimeout then
			out[#out + 1] = { from = p.from, to = p.to }
			book.pending[k] = nil
		end
	end
	return out
end

-- Fin ou départ : libère les deux joueurs et retire leurs défis en attente (joueur qui quitte).
function Duel.finish(book, userId)
	if type(book) ~= "table" then
		return
	end
	local id = book.active[userId]
	if id then
		for u, v in pairs(book.active) do
			if v == id then
				book.active[u] = nil
			end
		end
	end
	for k, p in pairs(book.pending) do
		if p.from == userId or p.to == userId then
			book.pending[k] = nil
		end
	end
end

-- Purge les anciennes dates de cooldown (évite la croissance de la table).
function Duel.prune(book, now, cfg)
	local c = cfgOf(cfg)
	if type(book) ~= "table" or not isNum(now) then
		return
	end
	for k, t in pairs(book.last) do
		if now - t >= c.sameTargetCooldown then
			book.last[k] = nil
		end
	end
end

-- ---------------------------------------------------------------- Tours et forfait
function Duel.newMatch(idA, idB)
	return { a = idA, b = idB, afkA = 0, afkB = 0, turns = 0, over = false, winner = nil, reason = "" }
end

-- Enregistre un tour : actedA/actedB = le joueur a choisi une action avant la fin des 10 s. Une action remet le compteur à 0.
-- Retourne "continue" | "forfeitA" | "forfeitB" | "cancelled" (les deux inactifs en même temps : duel annulé, ni vainqueur ni récompense).
function Duel.noteTurn(m, actedA, actedB, cfg)
	local c = cfgOf(cfg)
	if type(m) ~= "table" or m.over then
		return "continue"
	end
	m.turns = m.turns + 1
	m.afkA = actedA and 0 or (m.afkA + 1)
	m.afkB = actedB and 0 or (m.afkB + 1)
	local fa, fb = m.afkA >= c.afkTurnsToForfeit, m.afkB >= c.afkTurnsToForfeit
	if fa and fb then
		m.over, m.reason = true, "cancelled"
		return "cancelled"
	elseif fa then
		m.over, m.winner, m.reason = true, "b", "forfeit"
		return "forfeitA"
	elseif fb then
		m.over, m.winner, m.reason = true, "a", "forfeit"
		return "forfeitB"
	end
	return "continue"
end

-- ---------------------------------------------------------------- Récompenses et ratio
-- Profil de duel assaini : { w, l, day, n, pairs = { [idAdversaire texte] = nombre } }. Les paires ne contiennent que des duels récompensés (<= rewardedPerDay clés).
function Duel.cleanState(raw, today)
	local d = type(raw) == "table" and raw or {}
	local day = isNum(d.day) and math.floor(d.day) or 0
	local out = { w = count(d.w), l = count(d.l), day = day, n = 0, pairs = {} }
	if day == today then
		out.n = math.min(1000, count(d.n))
		if type(d.pairs) == "table" then
			local k = 0
			for key, v in pairs(d.pairs) do
				if type(key) == "string" and isNum(v) and v >= 1 and k < 20 then
					out.pairs[key] = math.min(1000, math.floor(v))
					k = k + 1
				end
			end
		end
	else
		out.day = isNum(today) and today or day
	end
	return out
end

function Duel.coins(incomePerSec, minutes, cfg)
	local c = cfgOf(cfg)
	if not isNum(incomePerSec) or incomePerSec <= 0 or not isNum(minutes) or minutes <= 0 then
		return 0
	end
	return math.min(c.maxCoins, math.floor(incomePerSec * 60 * minutes))
end

-- Solde un duel pour UN joueur. state = battle.duel (modifié), oppId = userId adversaire, outcome = "win" | "loss" | "draw", now, incomePerSec.
-- Le ratio (w/l) est toujours compté (sauf annulé) ; les pièces seulement si quota du jour (10) ET quota de la paire (3) non atteints.
-- Retourne { rewarded, coins, reason, won }. NE TOUCHE JAMAIS aux trophées (aucun champ trophée n'existe ici).
function Duel.settle(state, oppId, outcome, now, incomePerSec, cfg)
	local c = cfgOf(cfg)
	local today = isNum(now) and math.floor(now / 86400) or 0
	local clean = Duel.cleanState(state, today)
	if type(state) == "table" then
		state.w, state.l, state.day, state.n, state.pairs = clean.w, clean.l, clean.day, clean.n, clean.pairs
	else
		state = clean
	end
	if outcome ~= "win" and outcome ~= "loss" then
		return { rewarded = false, coins = 0, reason = "draw", won = false }
	end
	local won = outcome == "win"
	if won then
		state.w = math.min(Duel.CAP, state.w + 1)
	else
		state.l = math.min(Duel.CAP, state.l + 1)
	end
	local key = tostring(isNum(oppId) and math.floor(oppId) or 0)
	local pair = state.pairs[key] or 0
	if state.n >= c.rewardedPerDay then
		return { rewarded = false, coins = 0, reason = "dayCap", won = won }
	end
	if pair >= c.samePairRewardedPerDay then
		return { rewarded = false, coins = 0, reason = "pairCap", won = won }
	end
	state.n = state.n + 1
	state.pairs[key] = pair + 1
	return { rewarded = true, coins = Duel.coins(incomePerSec, won and c.coinsWinMins or c.coinsLoseMins, c), reason = "", won = won }
end

-- ---------------------------------------------------------------- Vues en miroir (intégration lot 13)
-- Battle.view et les événements sont écrits du point de vue du camp 1 (le défieur) ; le défié reçoit la vue inversée (son équipe en camp 1).
function Duel.mirrorView(v)
	if type(v) ~= "table" or type(v.sides) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = x
	end
	out.sides = { v.sides[2], v.sides[1] }
	if v.winner == 1 or v.winner == 2 then
		out.winner = 3 - v.winner
	end
	return out
end

function Duel.mirrorEvents(events)
	local out = {}
	if type(events) ~= "table" then
		return out
	end
	for i, ev in ipairs(events) do
		local c = {}
		if type(ev) == "table" then
			for k, x in pairs(ev) do
				c[k] = x
			end
			if c.side == 1 or c.side == 2 then
				c.side = 3 - c.side
			end
		end
		out[i] = c
	end
	return out
end

-- Intention reçue du client (texte) -> action Battle, ou nil (« attack », « skill », « swap1 » à « swap3 »).
function Duel.parseAction(arg)
	if arg == "attack" or arg == "skill" then
		return { kind = arg }
	end
	if type(arg) == "string" and #arg <= 8 then
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			return { kind = "swap", to = n }
		end
	end
	return nil
end

-- Pièces réellement versées : un duel terminé par départ ou abandon avant `minTurns` tours ne paie personne (anti-collusion : un complice qui quitte
-- tout de suite n'offre rien). Le ratio V/D et les quotas restent comptés par Duel.settle.
function Duel.payable(res, turns, early, minTurns)
	if type(res) ~= "table" or not res.rewarded or not isNum(res.coins) or res.coins <= 0 then
		return 0
	end
	if early == true and (not isNum(turns) or turns < (isNum(minTurns) and minTurns or 3)) then
		return 0
	end
	return res.coins
end

-- Aide : issue d'un match vue de chaque côté ("win"/"loss"/"draw").
function Duel.outcomes(m)
	if type(m) ~= "table" or not m.over or m.winner == nil then
		return "draw", "draw"
	end
	if m.winner == "a" then
		return "win", "loss"
	end
	return "loss", "win"
end

return Duel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">Ranked</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Ranked
-- LOT 14 : classé EN DIRECT (file MemoryStore, serveur réservé « ranked »). Logique PURE : aucune API Roblox, aucun yield, aucune erreur levée
-- sur une entrée invalide (valeurs de retour). Testé par tests/lot14.luau (Lune ou lupa). Le transport (MemoryStore, TeleportService) est dans
-- ServerScriptService/PvpLive.lua, qui n'appelle ces règles qu'à travers des fonctions de transformation (UpdateAsync) et des décisions.
--
-- Décisions (cahier LOTS_9_PLUS E.3 / E.4 / K « Lot 14 », décision utilisateur) :
--   * la file en direct est FERMÉE tant que les joueurs simultanés de l'expérience sont < cfg.minCCU (60) ou que cfg.enabled = false ;
--     elle est aussi fermée si le comptage est inconnu ou périmé (échec = fermé) : le classé reste alors sur le mode asynchrone existant ;
--   * aucun trophée ne bouge si les deux joueurs ne sont pas présents dans le serveur d'arène au départ (match annulé, quota rendu) ;
--   * déconnexion ou abandon pendant le combat = FORFAIT : le partant perd ; le restant gagne, sauf forfait avant cfg.minTurnsForGain tours
--     (anti-« nourrissage » entre deux comptes : 0 trophée pour le gagnant, le partant perd quand même) ;
--   * jamais le même adversaire deux fois en cfg.rematchCooldown secondes, jamais deux comptes ayant partagé un serveur dans les cfg.peerWindow
--     dernières secondes, jamais deux entrées du même serveur ;
--   * gains plafonnés à cfg.dailyTrophyCap trophées par jour UTC (pertes non plafonnées, bornées par le solde), cfg.dailyFights combats par jour ;
--   * rien d'achetable n'entre ici : ni Robux, ni pass, ni boost (la puissance d'équipe vient des stats brutes de Battle.unit).
local Ranked = {}

local function num(v, default)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function int(v, default, lo, hi)
	local n = math.floor(num(v, default))
	if lo and n < lo then
		n = lo
	end
	if hi and n > hi then
		n = hi
	end
	return n
end

local function isUid(v)
	return type(v) == "number" and v == v and v % 1 == 0 and v > 0 and v < 2 ^ 53
end
Ranked.isUid = isUid

local function contains(list, v)
	if type(list) ~= "table" then
		return false
	end
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

---------------------------------------------------------------- jour, ligues
function Ranked.day(now)
	return math.floor(num(now, 0) / 86400)
end

-- Ligue d'un nombre de trophées (Config.LEAGUES trié par `min` croissant) : retourne (ligue, indice). Valeur invalide = première ligue.
function Ranked.league(leagues, trophies)
	local t = num(trophies, 0)
	local best, idx = leagues[1], 1
	for i, l in ipairs(leagues) do
		if t >= l.min then
			best, idx = l, i
		end
	end
	return best, idx
end

-- Remise partielle de saison (E.4, OPTIONNELLE : non branchée par les patchs, le jeu garde `trophées // 4`) : au-delà de `floorAt`,
-- trophées = floor(trophées × keep), sans jamais redescendre sous `floorAt`.
function Ranked.seasonReset(trophies, keep, floorAt)
	local t = math.max(0, math.floor(num(trophies, 0)))
	floorAt = floorAt or 300
	if t <= floorAt then
		return t
	end
	return math.max(floorAt, math.floor(t * (keep or 0.6)))
end

---------------------------------------------------------------- ouverture de la file (seuil de joueurs simultanés)
-- Somme des comptes publiés par les serveurs (SortedMap PvpCcu_v1 : { n, t }) encore frais. Entrées invalides ignorées.
function Ranked.ccuSum(entries, now, ttl)
	local total, servers = 0, 0
	if type(entries) ~= "table" then
		return 0, 0
	end
	for _, e in ipairs(entries) do
		local v = type(e) == "table" and (e.value or e) or nil
		if type(v) == "table" and type(v.n) == "number" and type(v.t) == "number" and now - v.t <= ttl and v.n >= 0 and v.n <= 200 then
			total = total + math.floor(v.n)
			servers = servers + 1
		end
	end
	return total, servers
end

-- La file en direct est-elle ouverte ? rec = { n = joueurs simultanés, t = date du comptage } écrit par l'apparieur. Retourne (bool, raison).
function Ranked.liveOpen(cfg, rec, now)
	if not cfg or cfg.enabled ~= true then
		return false, "disabled"
	end
	if type(rec) ~= "table" or type(rec.n) ~= "number" or type(rec.t) ~= "number" or now - rec.t > cfg.ccuTtl or rec.t > now + 5 then
		return false, "unknown" -- comptage absent ou périmé : fermé (jamais de file vide qui frustre)
	end
	if rec.n < cfg.minCCU then
		return false, "low_ccu"
	end
	return true, "open"
end

---------------------------------------------------------------- profil : champ battle.live
-- battle.live = { day, fights, gained, w, l, recent = { { u = userId, t = date } } } : compteurs du jour UTC et derniers adversaires.
function Ranked.sanitizeLive(v, cfg)
	local maxRecent = (cfg and cfg.recentMax) or 20
	local out = { day = 0, fights = 0, gained = 0, w = 0, l = 0, recent = {} }
	if type(v) ~= "table" then
		return out
	end
	out.day = int(v.day, 0, 0, 1e7)
	out.fights = int(v.fights, 0, 0, 1000)
	out.gained = int(v.gained, 0, 0, 1e6)
	out.w = int(v.w, 0, 0, 1e7)
	out.l = int(v.l, 0, 0, 1e7)
	if type(v.recent) == "table" then
		for _, r in ipairs(v.recent) do
			if #out.recent >= maxRecent then
				break
			end
			if type(r) == "table" and isUid(r.u) and type(r.t) == "number" and r.t == r.t then
				out.recent[#out.recent + 1] = { u = r.u, t = math.floor(r.t) }
			end
		end
	end
	return out
end

-- Remet les compteurs du jour à zéro si le jour UTC a changé. Retourne live (modifié en place).
function Ranked.liveDay(live, now)
	local d = Ranked.day(now)
	if live.day ~= d then
		live.day, live.fights, live.gained = d, 0, 0
	end
	return live
end

-- Adversaires récents encore bloqués (liste d'userId) ; nettoie la liste au passage.
function Ranked.recentOpponents(cfg, live, now)
	local keep, out = {}, {}
	for _, r in ipairs(live.recent or {}) do
		if now - r.t < cfg.rematchCooldown then
			keep[#keep + 1] = r
			out[#out + 1] = r.u
		end
	end
	live.recent = keep
	return out
end

function Ranked.recordOpponent(cfg, live, uid, now)
	if not isUid(uid) then
		return
	end
	Ranked.recentOpponents(cfg, live, now)
	local keep = {}
	for _, r in ipairs(live.recent) do
		if r.u ~= uid then
			keep[#keep + 1] = r
		end
	end
	keep[#keep + 1] = { u = uid, t = math.floor(now) }
	while #keep > cfg.recentMax do
		table.remove(keep, 1)
	end
	live.recent = keep
end

---------------------------------------------------------------- équipe figée et puissance
-- Équipe { {p,s,m} } assainie contre Config.PETS (espèce connue, 3 pets au plus). Seuls p, s, m sont gardés : aucun bonus ne passe.
function Ranked.sanitizeTeam(Config, team, size)
	local out = {}
	size = size or 3
	if type(team) ~= "table" then
		return out
	end
	for _, e in ipairs(team) do
		if #out >= size then
			break
		end
		if type(e) == "table" and type(e.p) == "number" and e.p % 1 == 0 and Config.PETS[e.p] then
			local s = (type(e.s) == "string" and #e.s <= 16) and e.s or nil
			local m = (type(e.m) == "string" and #e.m <= 16) and e.m or nil
			out[#out + 1] = { p = e.p, s = s, m = m }
		end
	end
	return out
end

-- Puissance d'équipe : somme de Battle.power des unités BRUTES (Battle.unit sans échelle ni boost hebdomadaire).
function Ranked.teamPower(Battle, Config, team)
	local total = 0
	for _, e in ipairs(team) do
		local u = Battle.unit(Config, e)
		total = total + Battle.power({ hp = u.maxHp, atk = u.atk, spd = u.spd })
	end
	return total
end

---------------------------------------------------------------- entrée en file
-- Le joueur peut-il entrer en file en direct ? ctx (calculé par le SERVEUR) :
--   { open, busy, serverMode, team (assainie), live (assaini, jour courant), trophies, hasDefense }
-- Retourne (true) ou (false, raison) ; raison = "closed" | "busy" | "mode" | "team" | "fights" | "cap".
function Ranked.canQueue(cfg, ctx)
	if not ctx.open then
		return false, "closed"
	end
	if ctx.busy then
		return false, "busy"
	end
	if ctx.serverMode == "ranked" or ctx.serverMode == "castle" then
		return false, "mode"
	end
	if type(ctx.team) ~= "table" or #ctx.team == 0 then
		return false, "team"
	end
	if ctx.live.fights >= cfg.dailyFights then
		return false, "fights"
	end
	if ctx.live.gained >= cfg.dailyTrophyCap then
		return false, "cap"
	end
	return true
end

-- Entrée écrite dans la SortedMap (clé "u"..uid, clé de tri = trophées). `since` = première entrée (gardée lors d'une remise en file).
function Ranked.makeEntry(cfg, a)
	local function ids(list, max)
		local out = {}
		for _, v in ipairs(type(list) == "table" and list or {}) do
			if isUid(v) and #out < max then
				out[#out + 1] = v
			end
		end
		return out
	end
	return {
		u = a.uid,
		tr = int(a.trophies, 0, 0, 100000),
		pow = math.max(1, num(a.power, 1)),
		job = tostring(a.job or ""),
		party = type(a.party) == "string" and a.party or nil,
		t = a.since,
		r = a.now,
		team = a.team,
		peers = ids(a.peers, cfg.peersMax),
		opp = ids(a.opp, cfg.recentMax),
		name = tostring(a.name or "?"):sub(1, 24),
	}
end

-- Entrée lue depuis la file : forme minimale vérifiée (le contenu est écrit par nos serveurs, mais la file est partagée : on reste prudent).
-- Une entrée non rafraîchie depuis 3 rafraîchissements (30 s) est ignorée même si le MemoryStore ne l'a pas encore effacée (90 s) :
-- un joueur parti, déjà en téléportation ou dont le serveur est tombé n'est plus proposé.
function Ranked.validEntry(cfg, e, now)
	return type(e) == "table"
		and isUid(e.u)
		and type(e.tr) == "number"
		and type(e.pow) == "number"
		and e.pow > 0
		and type(e.t) == "number"
		and type(e.r) == "number"
		and now - e.r <= math.min(cfg.queueTtl, 3 * cfg.refresh)
		and type(e.job) == "string"
		and type(e.team) == "table"
		and #e.team > 0
end

---------------------------------------------------------------- appariement
-- Fenêtre de trophées après `waited` secondes : base + step × floor(waited / every), plafonnée à max.
function Ranked.trophyWindow(cfg, waited)
	local w = cfg.trophyWindow
	return math.min(w.max, w.base + w.step * math.floor(math.max(0, waited) / w.every))
end

-- Bornes du rapport de puissance (élargies après power.wideAfter secondes).
function Ranked.powerBounds(cfg, waited)
	local p = cfg.power
	if waited >= p.wideAfter then
		return p.wideLo, p.wideHi
	end
	return p.lo, p.hi
end

-- Deux entrées peuvent-elles s'affronter ? Les DEUX doivent accepter : on prend la plus courte attente (la fenêtre la plus étroite).
-- Retourne (bool, raison).
function Ranked.compatible(cfg, a, b, now)
	if a.u == b.u then
		return false, "self"
	end
	if a.m or b.m then
		return false, "taken"
	end
	if a.job ~= "" and a.job == b.job then
		return false, "same_server"
	end
	if contains(a.peers, b.u) or contains(b.peers, a.u) then
		return false, "peers"
	end
	if contains(a.opp, b.u) or contains(b.opp, a.u) then
		return false, "rematch"
	end
	local waited = math.min(now - a.t, now - b.t)
	if math.abs(a.tr - b.tr) > Ranked.trophyWindow(cfg, waited) then
		return false, "trophies"
	end
	local lo, hi = Ranked.powerBounds(cfg, waited)
	local ratio = a.pow / b.pow
	if ratio < lo or ratio > hi then
		return false, "power"
	end
	return true
end

-- Paires { {a, b} } depuis une liste d'entrées : le plus ancien en file d'abord ; pour lui, l'adversaire compatible le plus proche en trophées
-- (égalité : le plus ancien, puis le plus petit userId). Chaque joueur apparaît au plus UNE fois. Entrées invalides ou périmées ignorées.
function Ranked.pairUp(cfg, entries, now)
	local list, seen = {}, {}
	for _, e in ipairs(entries) do
		if Ranked.validEntry(cfg, e, now) and not e.m and not seen[e.u] then
			seen[e.u] = true
			list[#list + 1] = e
		end
	end
	table.sort(list, function(x, y)
		if x.t ~= y.t then
			return x.t < y.t
		end
		return x.u < y.u
	end)
	local used, pairs_ = {}, {}
	for i, a in ipairs(list) do
		if not used[a.u] then
			local best, bestD
			for j = i + 1, #list do
				local b = list[j]
				if not used[b.u] and Ranked.compatible(cfg, a, b, now) then
					local d = math.abs(a.tr - b.tr)
					if not best or d < bestD then
						best, bestD = b, d
					end
				end
			end
			if best then
				used[a.u], used[best.u] = true, true
				pairs_[#pairs_ + 1] = { a = a, b = best }
			end
		end
	end
	return pairs_
end

---------------------------------------------------------------- transformations UpdateAsync (atomiques côté MemoryStore)
-- Bail de l'apparieur : pris si libre, expiré ou déjà à nous. Retourne la nouvelle valeur, ou nil (= ne rien écrire).
function Ranked.leaderTransform(old, job, now, ttl)
	if type(old) ~= "table" or type(old.exp) ~= "number" or old.exp <= now or old.job == job then
		return { job = job, exp = now + ttl }
	end
	return nil
end

function Ranked.isLeader(value, job, now)
	return type(value) == "table" and value.job == job and type(value.exp) == "number" and value.exp > now
end

-- Réserve une entrée de file pour un match : échoue (nil) si l'entrée a disparu (annulée, expirée) ou est déjà prise.
function Ranked.claimTransform(old, matchId)
	if type(old) ~= "table" or old.m ~= nil then
		return nil
	end
	local new = table.clone(old)
	new.m = matchId
	return new
end

-- Annule la réservation (réservation de serveur ratée, second joueur indisponible) : seulement si c'est la nôtre.
function Ranked.releaseTransform(old, matchId)
	if type(old) ~= "table" or old.m ~= matchId then
		return nil
	end
	local new = table.clone(old)
	new.m = nil
	return new
end

-- Rafraîchissement par le serveur du joueur : ne réécrit JAMAIS une entrée déjà réservée par l'apparieur (le ticket arrive).
function Ranked.refreshTransform(old, entry, now)
	if type(old) == "table" and old.m ~= nil then
		return nil
	end
	local new = table.clone(entry)
	new.r = now
	return new
end

---------------------------------------------------------------- match, ticket, serveur d'arène
-- Enregistrement de match (HashMap PvpMatch_v1[id]) : seule source de vérité du serveur d'arène (le TeleportData n'est qu'un indice).
function Ranked.newMatch(cfg, id, a, b, code, psid, seed, now)
	return {
		id = id,
		a = a.u,
		b = b.u,
		na = a.name,
		nb = b.name,
		ta = a.team,
		tb = b.team,
		pa = a.party,
		pb = b.party,
		code = code,
		psid = psid,
		seed = seed,
		t = now,
		exp = now + cfg.matchTtl,
	}
end

function Ranked.newTicket(cfg, match, side, now)
	local mine = side == "a"
	return { match = match.id, code = match.code, opp = mine and match.nb or match.na, side = side, exp = now + cfg.ticketTtl }
end

-- Ticket utilisable par ce serveur pour ce joueur ? (forme, expiration).
function Ranked.ticketValid(t, now)
	return type(t) == "table"
		and type(t.match) == "string"
		and #t.match > 0
		and #t.match <= 64
		and type(t.code) == "string"
		and #t.code > 0
		and type(t.exp) == "number"
		and t.exp > now
		and (t.side == "a" or t.side == "b")
end

-- Admission dans le serveur d'arène : le match existe, n'a pas expiré, a été réservé pour CE serveur (PrivateServerId) et le joueur en fait partie.
-- Retourne (side "a"|"b") ou (nil, raison).
function Ranked.arenaAdmit(match, uid, psid, now)
	if type(match) ~= "table" or type(match.exp) ~= "number" then
		return nil, "no_match"
	end
	if match.exp <= now then
		return nil, "expired"
	end
	if type(match.psid) == "string" and match.psid ~= "" and match.psid ~= psid then
		return nil, "wrong_server"
	end
	if uid == match.a then
		return "a"
	elseif uid == match.b then
		return "b"
	end
	return nil, "not_member"
end

-- État du serveur d'arène. phase : "wait" (attente des deux joueurs) -> "fight" -> "done" ; ou "void" (annulé : personne ne gagne ni ne perd).
function Ranked.arenaNew(match, now)
	return { match = match, phase = "wait", t0 = now, present = {}, turns = 0 }
end

function Ranked.arenaArrive(A, side)
	if A.phase ~= "wait" or (side ~= "a" and side ~= "b") then
		return false
	end
	A.present[side] = true
	return true
end

-- Décision : "start" (les deux là), "void" (délai dépassé avec un absent), "wait" ; hors attente : "fight" pendant le combat, sinon "idle"
-- (un match annulé ou terminé ne redéclenche jamais rien).
function Ranked.arenaTick(cfg, A, now)
	if A.phase ~= "wait" then
		return A.phase == "fight" and "fight" or "idle"
	end
	if A.present.a and A.present.b then
		return "start"
	end
	if now - A.t0 >= cfg.waitArena then
		return "void"
	end
	return "wait"
end

-- Un joueur part. Pendant l'attente : il n'est plus présent (le match sera annulé au délai). Pendant le combat : forfait.
-- Retourne "absent" | "forfeit" | "none".
function Ranked.arenaLeave(A, side)
	if A.phase == "wait" then
		A.present[side] = nil
		return "absent"
	elseif A.phase == "fight" then
		return "forfeit"
	end
	return "none"
end

---------------------------------------------------------------- résultat et trophées
-- Résultat d'un match en direct (les deux joueurs étaient présents au départ, sinon cette fonction n'est jamais appelée).
-- r = { winner = "a"|"b", forfeit = bool, turns = n, a = { trophies, live }, b = { trophies, live } } ; gainFn = Config.pvpGain ; loss = Config.PVP.loss.
-- Retourne { a = delta, b = delta, capped = { a = bool, b = bool }, fed = bool } sans rien modifier.
function Ranked.outcome(cfg, gainFn, loss, r)
	local w, l = r.winner, (r.winner == "a" and "b" or "a")
	local out = { capped = {} }
	local gain = gainFn(r[w].trophies, r[l].trophies)
	if r.forfeit and (r.turns or 0) < cfg.minTurnsForGain then
		gain = 0
		out.fed = true -- forfait trop tôt : rien pour le gagnant (deux comptes ne peuvent pas se « nourrir »)
	end
	local room = math.max(0, cfg.dailyTrophyCap - r[w].live.gained)
	if gain > room then
		gain = room
		out.capped[w] = true
	end
	out[w] = gain
	out[l] = -math.min(math.max(0, r[l].trophies), loss)
	return out
end

-- Applique un delta à pv (battle.pvp) et live (battle.live) d'un joueur. win = bool.
function Ranked.apply(pv, live, delta, win)
	pv.trophies = math.max(0, pv.trophies + delta)
	if win then
		pv.wins = pv.wins + 1
		live.w = live.w + 1
		if delta > 0 then
			live.gained = live.gained + delta
		end
	else
		pv.losses = pv.losses + 1
		live.l = live.l + 1
	end
end

-- Combat consommé au départ (les deux présents) ; un match annulé ne consomme rien.
function Ranked.canFight(cfg, live)
	return live.fights < cfg.dailyFights
end

---------------------------------------------------------------- téléportation, repli, retour
-- Après `attempts` échecs : { retry = délai } tant que attempts <= cfg.teleportRetries, sinon { requeue = true }.
function Ranked.teleportPlan(cfg, attempts)
	if attempts <= cfg.teleportRetries then
		return { retry = cfg.teleportRetryDelay }
	end
	return { requeue = true }
end

-- Repli vers l'asynchrone après cfg.fallbackAfter secondes sans adversaire.
function Ranked.shouldFallback(cfg, since, now)
	return now - since >= cfg.fallbackAfter
end

-- Destination du retour : la partie d'origine si son entrée du registre ChipeParties existe encore (le MemoryStore l'efface à expiration),
-- est ouverte et compte encore le joueur parmi ses membres (le hub ne le retire qu'à son arrivée au hub) ; sinon le hub.
-- (createdAt du registre est un os.clock() du HUB : non comparable depuis un autre serveur, donc non utilisé ici.)
-- Retourne { place = "party", code, partyId } ou { place = "hub", partyId }.
function Ranked.returnPlan(Game, partyId, entry, uid)
	if
		type(partyId) == "string"
		and type(entry) == "table"
		and entry.open
		and type(entry.code) == "string"
		and contains(entry.members, uid)
		and type(entry.count) == "number"
		and entry.count <= math.min(entry.size or Game.MaxPlayers, Game.MaxPlayers)
	then
		return { place = "party", code = entry.code, partyId = partyId }
	end
	return { place = "hub", partyId = type(partyId) == "string" and partyId or nil }
end

---------------------------------------------------------------- combat à deux joueurs : vues en miroir
-- Battle.view et les événements sont écrits du point de vue du camp 1 (camp A) ; le joueur B reçoit la vue inversée.
function Ranked.mirrorView(v)
	local out = table.clone(v)
	out.sides = { v.sides[2], v.sides[1] }
	if v.winner then
		out.winner = 3 - v.winner
	end
	return out
end

function Ranked.mirrorEvents(events)
	local out = {}
	for i, ev in ipairs(events) do
		local c = table.clone(ev)
		if c.side == 1 or c.side == 2 then
			c.side = 3 - c.side
		end
		out[i] = c
	end
	return out
end

-- Action reçue du client (chaîne) -> action Battle, ou nil.
function Ranked.parseAction(arg)
	if arg == "attack" or arg == "skill" then
		return { kind = arg }
	end
	if type(arg) == "string" and #arg <= 8 then
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			return { kind = "swap", to = n }
		end
	end
	return nil
end

---------------------------------------------------------------- quotas MemoryStore (E.3)
-- Requêtes par minute estimées : chaque serveur publie son compte et lit l'ouverture (2 × 60/ccuPublish) et tente le bail (60/leaderEvery) ;
-- le leader lit la file (60/leaderEvery) et somme puis écrit les comptes (2 × 60/ccuPublish) ; chaque joueur en file rafraîchit (60/refresh) et
-- interroge son ticket (60/pollTicket) ; chaque match coûte ~8 requêtes (2 réservations, match, 2 tickets, 2 retraits, 1 lecture à l'arène).
-- Limite Roblox : 1000 + 100 × joueurs par minute.
function Ranked.quotaPerMinute(cfg, servers, queued, matchesPerMin)
	local perServer = 2 * 60 / cfg.ccuPublish + 60 / cfg.leaderEvery
	local leader = 60 / cfg.leaderEvery + 2 * 60 / cfg.ccuPublish
	local perQueued = 60 / cfg.refresh + 60 / cfg.pollTicket
	return servers * perServer + leader + queued * perQueued + (matchesPerMin or 0) * 8
end

function Ranked.quotaLimit(players)
	return 1000 + 100 * players
end

return Ranked
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">BattleLayout</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/BattleLayout   (refonte de la présentation du combat, vue face à face)
-- Module PUR (aucune instance Roblox, aucun require) : calcule la disposition de l'écran de combat à partir de la taille de la fenêtre et de la zone sûre :
--   * rectangles en pixels (et en échelle) de la carte de l'adversaire (haut à droite), de la carte du joueur (bas à gauche), du bandeau de journal (bas),
--     des 4 boutons d'action (bas à droite : Attaque, Spécial, Changer, Fuir), tous >= 44 px, jamais en dehors de la zone sûre, jamais superposés ;
--   * composition interne des cartes (nom, niveau, barre de PV, texte de PV, points d'état de l'équipe, pastilles de charge du spécial) ;
--   * scène 3D : positions des deux socles lumineux, caméra fixe en léger angle cadrée sur la zone libre entre les cartes, sable ou herbe selon le lieu ;
--   * textes et couleurs (PV « 260/260 », points d'état, charge du spécial 0..5, couleur de barre) et signaux d'animation tirés des événements du moteur ;
--   * plafond d'instances : estimation du coût de la scène, décor réduit pour rester sous MAX_INSTANCES (mobile : moins d'effets) ;
--   * états sous les cartes (pastilles), écran « Changer », flash du spécial, sons par action (Config.SOUNDS seulement), XP de fin (message du serveur seulement).
-- Ne lit que ce que le serveur envoie déjà (vue Battle.view, événements, payload « start »). Pas de += / -= / continue, pas de math.atan2 (lanceur lupa).
local BattleLayout = {}

BattleLayout.MAX_INSTANCES = 220 -- plafond de la scène (même plafond que HatchFx) ; l'intro (120) et les effets de type (80) ont leurs propres plafonds
BattleLayout.MIN_TOUCH = 44 -- cible tactile minimale (pixels)
BattleLayout.MARGIN = 8
BattleLayout.GAP = 6
BattleLayout.SPEED_BUTTON = 52 -- largeur des boutons de vitesse et de saut (hauteur 48)
BattleLayout.QUEUE_W, BattleLayout.QUEUE_H = 104, 28
BattleLayout.MAX_DOTS = 6 -- points d'état d'équipe par camp
BattleLayout.CHARGE_MAX = 5
BattleLayout.WIDE_MIN_WIDTH = 520 -- en dessous : disposition étroite (téléphone en portrait)
BattleLayout.DEFAULT_VIEWPORT = { w = 640, h = 360 }
BattleLayout.MIN_VIEWPORT = { w = 240, h = 320 }

-- Couleurs propres à Chipe-Œufs (aucune reprise d'un autre jeu).
BattleLayout.PALETTE = {
	sand = { ground = { 226, 196, 132 }, rim = { 168, 134, 84 }, skyTop = { 255, 206, 150 }, skyBottom = { 255, 238, 205 }, deco = { 214, 196, 160 }, ambient = { 190, 170, 140 }, light = { 255, 240, 215 } },
	grass = { ground = { 112, 192, 94 }, rim = { 70, 140, 72 }, skyTop = { 136, 202, 255 }, skyBottom = { 218, 242, 255 }, deco = { 66, 158, 76 }, ambient = { 150, 175, 160 }, light = { 255, 252, 235 } },
}
BattleLayout.UI = {
	card = { 24, 38, 46 }, cardStroke = { 244, 232, 196 }, text = { 250, 247, 238 }, muted = { 176, 196, 200 },
	hp = { 91, 227, 125 }, hpWarn = { 255, 196, 60 }, hpLow = { 255, 99, 99 }, hpBack = { 52, 36, 44 },
	dotOn = { 91, 227, 125 }, dotOff = { 70, 78, 84 }, pipOn = { 255, 210, 63 }, pipOff = { 62, 58, 84 },
	attack = { 255, 159, 28 }, special = { 74, 163, 255 }, specialOff = { 70, 74, 86 }, swap = { 184, 120, 255 }, flee = { 255, 99, 99 },
	log = { 16, 26, 32 }, status = { 255, 226, 140 },
	darkText = { 14, 28, 18 }, lightText = { 244, 244, 252 }, fleeText = { 40, 8, 8 }, swapText = { 14, 20, 30 }, offText = { 220, 222, 232 },
	meChip = { 74, 163, 255 }, foeChip = { 255, 107, 107 },
	rowActive = { 58, 72, 86 }, specialFill = { 78, 88, 124 },
}
-- Couleur du socle lumineux par type (le type est « Nature » ou « Plante » selon la source).
BattleLayout.TYPE_COLOR = {
	Feu = { 255, 122, 61 }, Eau = { 66, 170, 255 }, Nature = { 96, 214, 98 }, Plante = { 96, 214, 98 }, Glace = { 150, 228, 255 }, Foudre = { 255, 224, 64 },
	Terre = { 196, 146, 90 }, Ciel = { 170, 190, 255 }, Ombre = { 160, 110, 210 }, ["Lumière"] = { 255, 244, 170 },
}
BattleLayout.NEUTRAL_COLOR = { 220, 220, 230 }

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

local function int(v, default)
	if isNum(v) then
		return math.floor(v)
	end
	return default
end

local function rect(x, y, w, h)
	return { x = x, y = y, w = w, h = h }
end

function BattleLayout.typeColor(typ)
	return BattleLayout.TYPE_COLOR[typ] or BattleLayout.NEUTRAL_COLOR
end

---------------------------------------------------------------- fenêtre, zone sûre

-- Taille de fenêtre assainie (valeurs invalides -> 640 x 360 ; minimum 240 x 320 : sous cette taille rien ne tient de toute façon).
function BattleLayout.viewport(vw, vh)
	local d, m = BattleLayout.DEFAULT_VIEWPORT, BattleLayout.MIN_VIEWPORT
	local w = isNum(vw) and vw > 0 and vw or d.w
	local h = isNum(vh) and vh > 0 and vh or d.h
	return math.floor(math.max(m.w, w)), math.floor(math.max(m.h, h))
end

-- Zone sûre { l, t, r, b } (pixels) assainie ; jamais plus de 25 % de la fenêtre par bord.
function BattleLayout.safe(raw, vw, vh)
	local s = type(raw) == "table" and raw or {}
	return {
		l = clamp(isNum(s.l) and s.l or 0, 0, vw * 0.25),
		t = clamp(isNum(s.t) and s.t or 0, 0, vh * 0.25),
		r = clamp(isNum(s.r) and s.r or 0, 0, vw * 0.25),
		b = clamp(isNum(s.b) and s.b or 0, 0, vh * 0.25),
	}
end

-- Composition interne d'une carte de largeur w : retourne des rectangles RELATIFS à la carte.
--   adversaire : ligne de contexte (étage / dresseur), ligne nom + niveau, barre de PV, points d'état.
--   joueur : ligne nom + niveau, barre de PV, texte « PV » + points d'état à droite, pastilles de charge.
function BattleLayout.cardInner(w, isMe)
	local pad = 8
	local iw = math.max(40, w - 2 * pad)
	local out = { pad = pad }
	if isMe then
		out.h = 82
		out.icon = rect(pad, 6, 22, 22)
		out.name = rect(pad + 26, 6, iw - 26 - 62, 22)
		out.level = rect(w - pad - 60, 6, 60, 22)
		out.bar = rect(pad, 32, iw, 12)
		out.hp = rect(pad, 47, iw - 90, 16)
		out.dots = rect(w - pad - 84, 49, 84, 12)
		out.pips = rect(pad, 66, iw, 10)
	else
		out.h = 76
		out.ctx = rect(pad, 4, iw, 14)
		out.icon = rect(pad, 20, 22, 22)
		out.name = rect(pad + 26, 20, iw - 26 - 62, 22)
		out.level = rect(w - pad - 60, 20, 60, 22)
		out.bar = rect(pad, 46, iw, 12)
		out.dots = rect(pad, 62, iw, 10)
		out.pips = nil
	end
	return out
end

---------------------------------------------------------------- disposition de l'écran

-- Disposition en pixels pour une fenêtre vw x vh et une zone sûre (optionnelle). Retourne :
--   { mode = "wide"|"narrow", vw, vh, safe, area = zone utile, foeCard, meCard, log, actions = { attack, special, swap, flee }, stage = zone libre pour les
--     créatures, swapTray = plateau des pets de réserve (au-dessus des boutons), cardW }
-- Le plateau de réserve (swapTray) recouvre le journal pendant qu'il est ouvert.
-- Garanties (testées sur une matrice d'appareils) : rectangles dans la zone utile, sans superposition, boutons >= MIN_TOUCH, coin haut gauche libre (boutons
-- natifs de Roblox : menu, discussion), carte adverse en haut à droite, carte du joueur en bas à gauche.
function BattleLayout.rects(vw, vh, safeIn)
	vw, vh = BattleLayout.viewport(vw, vh)
	local sf = BattleLayout.safe(safeIn, vw, vh)
	local m, gap = BattleLayout.MARGIN, BattleLayout.GAP
	local ax0, ay0 = sf.l + m, sf.t + m
	local ax1, ay1 = vw - sf.r - m, vh - sf.b - m
	local aw, ah = ax1 - ax0, ay1 - ay0
	local wide = vw >= BattleLayout.WIDE_MIN_WIDTH and vw > vh
	local meI = BattleLayout.cardInner(100, true)
	local foeI = BattleLayout.cardInner(100, false)
	local out = { mode = wide and "wide" or "narrow", vw = vw, vh = vh, safe = sf, area = rect(ax0, ay0, aw, ah), actions = {} }
	local bh = BattleLayout.MIN_TOUCH + 4 -- boutons de 48 px de haut
	if wide then
		local cardW = math.floor(clamp(vw * 0.36, 200, 300))
		local bw = math.floor(clamp(vw * 0.16, 88, 132))
		local gw, gh = 2 * bw + gap, 2 * bh + gap
		local logH = 56
		out.cardW = cardW
		out.foeCard = rect(ax1 - cardW, ay0, cardW, foeI.h)
		out.fullLog = rect(ax0, ay1 - logH, aw - gw - gap, logH)
		local gx, gy = ax1 - gw, ay1 - gh
		out.log = out.fullLog
		out.actions.attack = rect(gx, gy, bw, bh)
		out.actions.special = rect(gx + bw + gap, gy, bw, bh)
		out.actions.swap = rect(gx, gy + bh + gap, bw, bh)
		out.actions.flee = rect(gx + bw + gap, gy + bh + gap, bw, bh)
		out.meCard = rect(ax0, out.fullLog.y - gap - meI.h, cardW, meI.h)
	else
		local cardW = math.floor(clamp(aw * 0.7, 200, 260))
		local bw = math.floor((aw - 3 * gap) / 4)
		local logH = 60
		out.cardW = cardW
		out.foeCard = rect(ax1 - cardW, ay0, cardW, foeI.h)
		out.fullLog = rect(ax0, ay1 - logH, aw, logH)
		out.log = out.fullLog
		local ay = out.fullLog.y - gap - bh
		out.actions.attack = rect(ax0, ay, bw, bh)
		out.actions.special = rect(ax0 + (bw + gap), ay, bw, bh)
		out.actions.swap = rect(ax0 + 2 * (bw + gap), ay, bw, bh)
		out.actions.flee = rect(ax0 + 3 * (bw + gap), ay, bw, bh)
		out.meCard = rect(ax0, ay - gap - meI.h, cardW, meI.h)
	end
	-- plateau de réserve (3 boutons) : il remplace le journal tant qu'il est ouvert (le journal est alors masqué) ; jamais sur les cartes ni sur les boutons
	local fl = out.fullLog
	out.swapTray = rect(fl.x, fl.y + math.floor((fl.h - bh) / 2), fl.w, bh)
	local sb = BattleLayout.SPEED_BUTTON
	local by = fl.y + math.floor((fl.h - bh) / 2)
	out.skip = rect(fl.x + fl.w - sb, by, sb, bh) -- « Passer l'animation » (visible dès le 2e combat vu)
	out.speed = rect(fl.x + fl.w - 2 * sb - gap, by, sb, bh) -- vitesse 1x / 2x / 3x
	out.log = rect(fl.x, fl.y, fl.w - 2 * sb - 2 * gap, fl.h)
	out.queue = rect(out.foeCard.x + out.foeCard.w - BattleLayout.QUEUE_W, out.foeCard.y + out.foeCard.h + 4, BattleLayout.QUEUE_W, BattleLayout.QUEUE_H) -- ordre du tour : 3 pastilles sous la carte adverse
	if wide then -- les cartes sont dans les coins : la scène occupe toute la hauteur utile (la carte du joueur peut mordre sur les 36 derniers pixels du socle)
		out.stage = rect(0, ay0, vw, math.max(40, out.meCard.y + 36 - ay0))
	else -- cartes empilées : la scène occupe l'espace libre entre elles
		local top = out.queue.y + out.queue.h + 4
		out.stage = rect(0, top, vw, math.max(40, out.meCard.y - top))
	end
	return out
end

-- Rectangle en fractions de la fenêtre : { sx, sy, sw, sh } (pour les positions et tailles en échelle).
function BattleLayout.toScale(r, vw, vh)
	vw, vh = BattleLayout.viewport(vw, vh)
	return { sx = r.x / vw, sy = r.y / vh, sw = r.w / vw, sh = r.h / vh }
end

-- Deux rectangles se recouvrent-ils ? (bords qui se touchent = non)
function BattleLayout.overlap(a, b)
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

---------------------------------------------------------------- scène 3D (socles, caméra, décor)

local function vec(x, y, z)
	return { x = x, y = y, z = z }
end

-- Lieu du combat -> « sand » (colisée : duel, classé enregistré, classé en direct) ou « grass » (arène PvE : tour, PNJ). Inconnu -> herbe.
function BattleLayout.mode(p)
	local t = type(p) == "table" and p or {}
	if t.duel == true then
		return "duel"
	elseif t.live == true then
		return "live"
	elseif t.pvp == true then
		return "pvp"
	elseif t.npc == true then
		return "npc"
	end
	return "tower"
end

-- « Fuir » : un appui là où l'abandon ne coûte rien (tour, PNJ : simple défaite sans perte), deux appuis là où il coûte (duel : forfait ; classé
-- enregistré : trophées perdus ; classé en direct : forfait). Mode inconnu -> deux appuis (prudence). Accepte un mode ou un message « start ».
function BattleLayout.fleeNeedsConfirm(modeOrPayload)
	local mode = modeOrPayload
	if type(modeOrPayload) == "table" then
		mode = BattleLayout.mode(modeOrPayload)
	end
	if mode == "tower" or mode == "npc" then
		return false
	end
	return true
end

function BattleLayout.ground(modeOrPayload)
	local mode = modeOrPayload
	if type(modeOrPayload) == "table" then
		mode = BattleLayout.mode(modeOrPayload)
	end
	if mode == "duel" or mode == "live" or mode == "pvp" or mode == "colisee" then
		return "sand"
	end
	return "grass"
end

function BattleLayout.palette(ground)
	return BattleLayout.PALETTE[ground] or BattleLayout.PALETTE.grass
end

-- Scène : socles (rayon `pedestal`), caméra fixe en léger angle (16°), champ de vision vertical 40°. La distance de la caméra est calculée pour que les deux
-- socles et leurs créatures tiennent dans la zone libre (`stage` de rects) ; la cible est décalée pour que cette zone soit le centre visuel. Coordonnées en studs.
function BattleLayout.scene(vw, vh, safeIn, ground)
	local r = BattleLayout.rects(vw, vh, safeIn)
	local narrow = r.mode == "narrow"
	local sc = { ground = ground == "sand" and "sand" or "grass", fov = 40, pedestal = 3.2, elevation = 16 }
	local spread, depth = narrow and 5 or 6.5, narrow and 4 or 3
	sc.me = vec(-spread, 0, depth)
	sc.foe = vec(spread, 0, -depth)
	sc.center = vec(0, 2.5, 0)
	local tanHalf = math.tan(math.rad(sc.fov / 2))
	local aspect = r.vw / r.vh
	local needX = spread + sc.pedestal + 2
	local fitW = narrow and 1 or 0.62 -- largeur écran utilisable par les créatures (les cartes occupent les coins en disposition large)
	local dH = needX / (tanHalf * aspect * fitW)
	local stageFrac = r.stage.h / r.vh
	local dV = 6.5 / (tanHalf * math.max(0.15, stageFrac))
	local d = clamp(math.max(dH, dV), 20, 120)
	local el = math.rad(sc.elevation)
	local cy = (r.stage.y + r.stage.h / 2) / r.vh -- ordonnée écran voulue pour le centre de la scène (0 = haut)
	local halfH = d * tanHalf
	local up = (cy - 0.5) * 2 * halfH -- cible au-dessus du centre de la scène si la zone libre est sous le milieu de l'écran
	sc.target = vec(0, sc.center.y + up, 0)
	sc.eye = vec(0, sc.target.y + d * math.sin(el), d * math.cos(el))
	sc.distance = d
	sc.stage = r.stage
	return sc
end

-- Point de l'écran (pixels, approximation pour les effets lorsque la caméra ne sait pas projeter) au-dessus de chaque socle : 1 = joueur, 2 = adversaire.
function BattleLayout.anchor(side, vw, vh, safeIn)
	local r = BattleLayout.rects(vw, vh, safeIn)
	local st = r.stage
	if side == 1 then
		return { x = st.x + st.w * 0.3, y = st.y + st.h * 0.62 }
	end
	return { x = st.x + st.w * 0.7, y = st.y + st.h * 0.4 }
end

---------------------------------------------------------------- textes, couleurs, états

function BattleLayout.hpFraction(u)
	if type(u) ~= "table" or not isNum(u.hp) or not isNum(u.maxHp) or u.maxHp <= 0 then
		return 0
	end
	return clamp(u.hp / u.maxHp, 0, 1)
end

-- « 260/260 » (entiers, jamais négatif, jamais au-dessus du maximum).
function BattleLayout.hpText(u)
	if type(u) ~= "table" then
		return "0/0"
	end
	local max = math.max(0, int(u.maxHp, 0))
	local hp = clamp(int(u.hp, 0), 0, max)
	return hp .. "/" .. max
end

-- Vert au-dessus de 50 %, ambre jusqu'à 25 %, rouge en dessous.
function BattleLayout.hpColor(frac)
	local U = BattleLayout.UI
	local f = isNum(frac) and frac or 0
	if f > 0.5 then
		return U.hp
	elseif f > 0.25 then
		return U.hpWarn
	end
	return U.hpLow
end

-- Niveau affiché : « Niv. 7 » (au moins 1 ; 1 si le serveur ne l'envoie pas).
function BattleLayout.levelText(u)
	local lv = 1
	if type(u) == "table" and isNum(u.level) then
		lv = clamp(math.floor(u.level), 1, 999)
	end
	return "Niv. " .. lv
end

-- Points d'état de l'équipe : un point par pet (plein = vivant), au plus MAX_DOTS. `active` (indice du pet au combat) est marqué pour l'affichage.
function BattleLayout.teamDots(side)
	local dots = {}
	local units = type(side) == "table" and type(side.units) == "table" and side.units or {}
	local active = type(side) == "table" and isNum(side.active) and math.floor(side.active) or 1
	for i = 1, math.min(#units, BattleLayout.MAX_DOTS) do
		local u = units[i]
		local alive = type(u) == "table" and isNum(u.hp) and u.hp > 0
		dots[i] = { alive = alive == true, active = i == active }
	end
	return dots
end

function BattleLayout.aliveCount(side)
	local n = 0
	for _, d in ipairs(BattleLayout.teamDots(side)) do
		if d.alive then
			n = n + 1
		end
	end
	return n
end

-- Pastilles de charge du spécial : { true, true, false, false, false } pour 2/5 ; `ready` à 5/5.
function BattleLayout.chargePips(charge, max)
	local mx = isNum(max) and clamp(math.floor(max), 1, 10) or BattleLayout.CHARGE_MAX
	local c = isNum(charge) and clamp(math.floor(charge), 0, mx) or 0
	local pips = {}
	for i = 1, mx do
		pips[i] = i <= c
	end
	return { pips = pips, charge = c, max = mx, ready = c >= mx }
end

-- Bouton « Spécial » : texte « Spécial 3/5 », prêt ou non. `ss` = BattleUi.specialState (module existant, réutilisé : jamais dupliqué) ; sans charge (moteur du lot 8) :
-- le texte de recharge de `ss` est conservé.
function BattleLayout.specialButton(ss)
	local s = type(ss) == "table" and ss or {}
	local info = BattleLayout.chargePips(s.charge, s.max)
	return { text = type(s.text) == "string" and s.text or ("Spécial " .. info.charge .. "/" .. info.max), ready = s.ready == true, charge = info.charge, max = info.max }
end

-- Réserve : pets du camp (hors actif) avec PV, pour le plateau « Changer » : { { index, alive, hp, maxHp, p } }.
function BattleLayout.bench(side)
	local out = {}
	local units = type(side) == "table" and type(side.units) == "table" and side.units or {}
	local active = type(side) == "table" and isNum(side.active) and math.floor(side.active) or 1
	for i, u in ipairs(units) do
		if i ~= active and type(u) == "table" then
			out[#out + 1] = { index = i, alive = isNum(u.hp) and u.hp > 0, hp = clamp(int(u.hp, 0), 0, 9999999), maxHp = int(u.maxHp, 0), p = u.p }
		end
	end
	return out
end

-- Efficacité de type : texte court, icône (jamais la couleur seule), couleur du nombre de dégâts. Seuils identiques à BattleUi.EFFICACY / TypeFx.efficacy.
--   super (x1,5 et plus) : vert + « ▲ » ; bon (x1,2) : vert clair + « ▲ » ; neutre : gris clair, aucun texte ; peu efficace (x0,95 et moins) : rouge pâle + « ▼ ».
function BattleLayout.efficacy(mul)
	local U = BattleLayout.UI
	local neutral = { kind = "neutral", text = nil, icon = "", rgb = { 214, 218, 224 } }
	if not isNum(mul) or mul <= 0 then
		return neutral
	end
	if mul >= 1.5 - 1e-9 then
		return { kind = "super", text = "Super efficace !", icon = "▲", rgb = { 96, 232, 120 } }
	elseif mul >= 1.2 - 1e-9 then
		return { kind = "good", text = "Efficace", icon = "▲", rgb = { 160, 236, 130 } }
	elseif mul <= 0.7 + 1e-9 then
		return { kind = "resist", text = "Pas très efficace…", icon = "▼", rgb = { 255, 150, 150 } }
	elseif mul <= 0.95 + 1e-9 then
		return { kind = "weak", text = "Peu efficace", icon = "▼", rgb = { 255, 176, 160 } }
	end
	return neutral
end

-- Signal d'animation tiré d'un événement du moteur (côté 1 = joueur, y compris en duel : la vue miroir est déjà appliquée par le serveur) :
--   { anim = "attack"|"heal"|"guard"|"swap"|"ko"|nil, actor = 1|2, target = 1|2, message = { text, rgb, icon } | nil (type : affiché AVANT le nombre),
--     popup = { text, rgb, side } | nil (nombre de dégâts : couleur par efficacité + icône) }
function BattleLayout.cue(ev)
	if type(ev) ~= "table" or (ev.side ~= 1 and ev.side ~= 2) then
		return nil
	end
	local actor = ev.side
	local foe = actor == 1 and 2 or 1
	local U = BattleLayout.UI
	if ev.t == "hit" then
		local dmg = isNum(ev.dmg) and math.max(0, math.floor(ev.dmg)) or 0
		local ef = BattleLayout.efficacy(ev.mul)
		local sp = ev.special == true
		local msg = ef.text and { text = ef.text, rgb = ef.rgb, icon = ef.icon } or nil
		return { anim = "attack", actor = actor, target = foe, special = sp, message = msg, kind = ef.kind,
			popup = { text = "-" .. dmg .. (ef.icon ~= "" and (" " .. ef.icon) or "") .. (sp and " ✨" or ""), rgb = ef.rgb, side = foe } }
	elseif ev.t == "heal" then
		local amount = isNum(ev.amount) and math.max(0, math.floor(ev.amount)) or 0
		return { anim = "heal", actor = actor, target = actor, popup = { text = "+" .. amount .. " ♥", rgb = U.hp, side = actor } }
	elseif ev.t == "guard" then
		return { anim = "guard", actor = actor, target = actor }
	elseif ev.t == "swap" then
		return { anim = "swap", actor = actor, target = actor }
	elseif ev.t == "ko" then
		return { anim = "ko", actor = actor, target = actor }
	elseif ev.t == "splash" then
		local dmg = isNum(ev.dmg) and math.max(0, math.floor(ev.dmg)) or 0
		return { anim = "attack", actor = actor, target = foe, popup = { text = "-" .. dmg .. " ⚡", rgb = { 255, 224, 64 }, side = foe } }
	end
	return nil
end

---------------------------------------------------------------- animations : PV qui défilent, cadence, vitesse, ordre du tour

BattleLayout.HP_ROLL_SECONDS = 0.5
BattleLayout.MAX_ANIM = 1.2 -- aucune animation ne dépasse 1,2 s (à vitesse 1x) : jamais de temps mort
BattleLayout.SPEEDS = { 1, 2, 3 }

-- Valeur de PV affichée à l'instant a (0..1) d'un défilement de `from` vers `to` : ralentissement progressif (cubique), extrémités exactes, jamais de dépassement.
function BattleLayout.hpRoll(from, to, a)
	local f = isNum(from) and from or 0
	local t = isNum(to) and to or f
	local k = isNum(a) and clamp(a, 0, 1) or 1
	local e = 1 - (1 - k) * (1 - k) * (1 - k)
	return f + (t - f) * e
end

-- Entier affiché pendant le défilement (arrondi vers le bas en descente, vers le haut en montée : le chiffre n'atteint la cible qu'à la fin).
function BattleLayout.hpRollInt(from, to, a)
	local v = BattleLayout.hpRoll(from, to, a)
	local f = isNum(from) and from or 0
	local t = isNum(to) and to or f
	if t < f then
		return math.max(math.floor(t), math.ceil(v - 1e-9))
	end
	return math.min(math.floor(t), math.floor(v + 1e-9))
end

function BattleLayout.speedNext(cur)
	local n = isNum(cur) and math.floor(cur) or 1
	if n >= 3 then
		return 1
	elseif n < 1 then
		return 1
	end
	return n + 1
end
function BattleLayout.speedLabel(speed)
	return (isNum(speed) and clamp(math.floor(speed), 1, 3) or 1) .. "×"
end

-- Durée réelle d'une animation de base `seconds` (secondes) à la vitesse `speed` : jamais plus de MAX_ANIM, divisée par la vitesse (1x, 2x, 3x).
function BattleLayout.animSeconds(seconds, speed)
	local sp = isNum(speed) and clamp(speed, 1, 3) or 1
	local base = isNum(seconds) and clamp(seconds, 0, BattleLayout.MAX_ANIM) or 0
	return base / sp
end

-- « Passer l'animation » : jamais au premier combat vu ; proposé dès que le joueur en a déjà vu `seen` >= 1 (donc à partir du 2e).
function BattleLayout.skipAvailable(seen)
	return isNum(seen) and seen >= 1
end

-- Cadence d'un tour : instants (s) de chacun des `n` coups d'un tour (0,6 s d'écart à 1x), la durée totale reste <= 3 coups x 0,6 + MAX_ANIM.
function BattleLayout.cadence(n, speed)
	local count = isNum(n) and clamp(math.floor(n), 0, 8) or 0
	local out = {}
	for i = 1, count do
		out[i] = BattleLayout.animSeconds(0.6, speed) * (i - 1)
	end
	return out, (count > 0 and (BattleLayout.animSeconds(0.6, speed) * (count - 1) + BattleLayout.animSeconds(BattleLayout.MAX_ANIM, speed)) or 0)
end

-- Ordre du tour : qui agit en premier d'après les événements du dernier tour (premier événement d'action), sinon d'après la vitesse des créatures actives si la
-- vue la fournit, sinon le joueur. Retourne `n` côtés (1 = joueur, 2 = adversaire) en alternant : { 1, 2, 1 } ou { 2, 1, 2 }.
function BattleLayout.firstActor(events, view)
	if type(events) == "table" then
		for _, ev in ipairs(events) do
			if type(ev) == "table" and (ev.side == 1 or ev.side == 2) and (ev.t == "hit" or ev.t == "heal" or ev.t == "guard" or ev.t == "swap" or ev.t == "stunned" or ev.t == "discharge") then
				return ev.side
			end
		end
	end
	if type(view) == "table" and type(view.sides) == "table" then
		local a, b = view.sides[1], view.sides[2]
		local ua = type(a) == "table" and type(a.units) == "table" and a.units[a.active or 1] or nil
		local ub = type(b) == "table" and type(b.units) == "table" and b.units[b.active or 1] or nil
		if type(ua) == "table" and type(ub) == "table" and isNum(ua.spd) and isNum(ub.spd) and ub.spd > ua.spd then
			return 2
		end
	end
	return 1
end
function BattleLayout.turnQueue(events, view, n)
	local first = BattleLayout.firstActor(events, view)
	local other = first == 1 and 2 or 1
	local out = {}
	for i = 1, clamp(isNum(n) and math.floor(n) or 3, 1, 6) do
		out[i] = i % 2 == 1 and first or other
	end
	return out
end

---------------------------------------------------------------- fin de combat : progression, contraste

-- Progression vers le palier suivant : { name, next, nextName, percent } d'après le total de trophées et la liste triée Config.LEAGUES ({ name, min }).
function BattleLayout.leagueProgress(total, leagues)
	local t = isNum(total) and math.max(0, math.floor(total)) or 0
	local list = type(leagues) == "table" and leagues or {}
	local cur, nxt
	for _, lg in ipairs(list) do
		if type(lg) == "table" and isNum(lg.min) then
			if t >= lg.min then
				cur = lg
			elseif nxt == nil then
				nxt = lg
			end
		end
	end
	local pct = 100
	if nxt then
		local base = cur and cur.min or 0
		pct = math.floor(clamp((t - base) / math.max(1, nxt.min - base), 0, 1) * 100)
	end
	return { name = cur and cur.name or "", next = nxt and nxt.min or nil, nextName = nxt and nxt.name or nil, percent = pct, total = t }
end

local function lin(c)
	local v = c / 255
	if v <= 0.03928 then
		return v / 12.92
	end
	return ((v + 0.055) / 1.055) ^ 2.4
end
function BattleLayout.luminance(rgb)
	return 0.2126 * lin(rgb[1]) + 0.7152 * lin(rgb[2]) + 0.0722 * lin(rgb[3])
end
-- Rapport de contraste WCAG (1..21) entre deux couleurs { r, g, b }.
function BattleLayout.contrast(a, b)
	local la, lb = BattleLayout.luminance(a), BattleLayout.luminance(b)
	local hi, lo = math.max(la, lb), math.min(la, lb)
	return (hi + 0.05) / (lo + 0.05)
end
-- Couples (texte, fond) réellement affichés par la scène ; chacun doit atteindre 4,5:1 (testé).
function BattleLayout.textPairs()
	local U = BattleLayout.UI
	return {
		{ "nom, PV", U.text, U.card }, { "niveau, contexte", U.muted, U.card }, { "bandeau d'état", U.status, U.log }, { "journal", U.text, U.log },
		{ "Attaque", U.darkText, U.attack }, { "Spécial prêt", U.darkText, U.special }, { "Spécial en charge", U.offText, U.specialOff },
		{ "Changer", U.swapText, U.swap }, { "Fuir", U.fleeText, U.flee }, { "pet K.O.", U.offText, U.specialOff },
		{ "vitesse / saut", U.darkText, { 255, 226, 140 } },
		{ "super efficace", BattleLayout.efficacy(1.5).rgb, U.log }, { "efficace", BattleLayout.efficacy(1.25).rgb, U.log },
		{ "peu efficace", BattleLayout.efficacy(0.8).rgb, U.log }, { "pas très efficace", BattleLayout.efficacy(0.6).rgb, U.log }, { "neutre", BattleLayout.efficacy(1).rgb, U.log },
		{ "soin", U.hp, U.log },
		{ "pastille étourdi", BattleLayout.STATUS_UI.stun.fg, BattleLayout.STATUS_UI.stun.bg }, { "pastille garde", BattleLayout.STATUS_UI.guard.fg, BattleLayout.STATUS_UI.guard.bg },
		{ "pastille concentration", BattleLayout.STATUS_UI.focus.fg, BattleLayout.STATUS_UI.focus.bg }, { "info-bulle d'état", U.text, U.log }, { "pastille +n", BattleLayout.STATUS_MORE.fg, BattleLayout.STATUS_MORE.bg },
		{ "Changer : pet disponible", U.swapText, U.swap }, { "Changer : pet au combat", U.text, U.rowActive }, { "Changer : pet K.O.", U.offText, U.specialOff },
		{ "Spécial en charge (remplie)", U.offText, U.specialFill }, { "Changer : titre", U.text, U.card }, { "Changer : note", U.muted, U.card },
	}
end

---------------------------------------------------------------- états sous les cartes, écran « Changer », flash du spécial, sons, XP de fin

-- États que le moteur (Battle.view, lot 12A) expose réellement : `stun` (nombre de tours à passer), `guard` (booléen : les prochains coups reçus sont réduits ; le
-- nombre de coups restants n'est PAS dans la vue) et `focus` (nombre de tours d'attaque +40 %). Le moteur n'a ni brûlure, ni gel d'état (le spécial « Gel » retire
-- seulement de la charge), ni autre état : AUCUN n'est inventé ici. Chaque pastille porte une icône et un chiffre, jamais la couleur seule ; la durée est lue au toucher.
BattleLayout.STATUS_ORDER = { "stun", "guard", "focus" }
BattleLayout.STATUS_UI = {
	stun = { icon = "💫", label = "Étourdi", bg = { 255, 226, 140 }, fg = { 30, 24, 0 } },
	guard = { icon = "🛡", label = "Garde", bg = { 120, 190, 255 }, fg = { 8, 20, 38 } },
	focus = { icon = "⚡", label = "Concentration", bg = { 255, 170, 70 }, fg = { 38, 20, 0 } },
}
BattleLayout.PILL_W, BattleLayout.PILL_H = 46, 44 -- chaque pastille est aussi sa zone tactile (44 px de haut)
BattleLayout.STATUS_MORE = { bg = { 230, 230, 238 }, fg = { 20, 20, 30 } } -- pastille « +n » (états regroupés faute de place)
BattleLayout.PILL_GAP = 4
BattleLayout.MAX_PILLS = 3
BattleLayout.TIP_SECONDS = 3 -- l'info-bulle d'une pastille disparaît seule après 3 s

-- Pastilles d'une unité de la vue : { { key, icon, label, turns (nombre ou nil), text, bg, fg } }, dans l'ordre stun, guard, focus ; unité KO ou invalide : aucune.
function BattleLayout.statusPills(u)
	local out = {}
	if type(u) ~= "table" or not isNum(u.hp) or u.hp <= 0 then
		return out
	end
	local U = BattleLayout.STATUS_UI
	local function add(key, turns)
		local d = U[key]
		out[#out + 1] = { key = key, icon = d.icon, label = d.label, turns = turns, text = d.icon .. (turns and (" " .. turns) or ""), bg = d.bg, fg = d.fg }
	end
	if isNum(u.stun) and u.stun > 0 then
		add("stun", clamp(math.floor(u.stun), 1, 99))
	end
	if u.guard == true then
		add("guard", nil)
	end
	if isNum(u.focus) and u.focus > 0 then
		add("focus", clamp(math.floor(u.focus), 1, 99))
	end
	return out
end

local function plural(n, one, many)
	return n .. " " .. (n > 1 and many or one)
end

-- Texte affiché au toucher d'une pastille : icône, nom, durée. `Battle` (facultatif) fournit le bonus de concentration réel (Battle.SKILLS.focus.boost).
function BattleLayout.pillDetail(pill, Battle)
	if type(pill) ~= "table" then
		return ""
	end
	if pill.key == "stun" then
		local n = isNum(pill.turns) and pill.turns or 1
		return pill.icon .. " Étourdi : passe " .. (n > 1 and ("ses " .. n .. " prochains tours") or "son prochain tour")
	elseif pill.key == "guard" then
		return pill.icon .. " Garde : les prochains coups reçus font moins de dégâts"
	elseif pill.key == "focus" then
		local n = isNum(pill.turns) and pill.turns or 1
		local boost = type(Battle) == "table" and type(Battle.SKILLS) == "table" and type(Battle.SKILLS.focus) == "table" and Battle.SKILLS.focus.boost or 1.4
		return pill.icon .. " Concentration : attaque +" .. math.floor((boost - 1) * 100 + 0.5) .. " % pendant " .. plural(n, "tour", "tours")
	end
	return ""
end

-- Rectangles des `n` pastilles (au plus MAX_PILLS) d'un camp : camp 2 (adversaire) sous l'ordre du tour, alignées à droite sous la carte ; camp 1 (joueur) au-dessus de
-- sa carte, alignées à gauche. `R` = BattleLayout.rects(...). Chaque rectangle fait PILL_W x PILL_H (>= 44 px de haut) et sert aussi de zone tactile.
function BattleLayout.pillRects(side, R, n)
	local count = clamp(int(n, 0), 0, BattleLayout.MAX_PILLS)
	local W, H, G = BattleLayout.PILL_W, BattleLayout.PILL_H, BattleLayout.PILL_GAP
	local out = {}
	for i = 1, count do
		if side == 2 then
			local right = R.foeCard.x + R.foeCard.w
			out[i] = rect(right - i * W - (i - 1) * G, R.queue.y + R.queue.h + G, W, H)
		else
			out[i] = rect(R.meCard.x + (i - 1) * (W + G), R.meCard.y - G - H, W, H)
		end
	end
	return out
end

-- Placement des pastilles des deux camps sans AUCUNE superposition : pour chaque camp (adversaire d'abord) on garde les premiers emplacements de pillRects qui sont dans la zone
-- utile et libres (ni carte, ni journal, ni bouton, ni vitesse, ni « Passer », ni ordre du tour, ni pastille déjà posée). S'il y a plus d'états que de place, la dernière pastille
-- devient une pastille « +n » qui regroupe le reste (son info-bulle les détaille tous) : aucun état n'est perdu tant qu'une place existe. nFoe / nMe = nombre d'états de chaque camp.
-- Retourne { [1] = { rects, cap, shown, overflow }, [2] = { ... } } ; `shown` pastilles à afficher, `overflow` > 0 si la dernière est une pastille « +n ».
function BattleLayout.pillLayout(R, nFoe, nMe)
	local obstacles = { R.foeCard, R.meCard, R.log, R.actions.attack, R.actions.special, R.actions.swap, R.actions.flee, R.speed, R.skip, R.queue }
	local placed = {}
	local out = {}
	local function free(r)
		local a = R.area
		if r.x < a.x - 1e-6 or r.y < a.y - 1e-6 or r.x + r.w > a.x + a.w + 1e-6 or r.y + r.h > a.y + a.h + 1e-6 then
			return false
		end
		for _, o in ipairs(obstacles) do
			if BattleLayout.overlap(r, o) then
				return false
			end
		end
		for _, o in ipairs(placed) do
			if BattleLayout.overlap(r, o) then
				return false
			end
		end
		return true
	end
	for _, side in ipairs({ 2, 1 }) do
		local n = clamp(int(side == 2 and nFoe or nMe, 0), 0, BattleLayout.MAX_PILLS)
		local all = BattleLayout.pillRects(side, R, BattleLayout.MAX_PILLS)
		local cap = 0
		for i = 1, BattleLayout.MAX_PILLS do
			if free(all[i]) then
				cap = i
			else
				break
			end
		end
		local shown = math.min(n, cap)
		local rects = {}
		for i = 1, shown do
			rects[i] = all[i]
			placed[#placed + 1] = all[i]
		end
		out[side] = { rects = rects, cap = cap, shown = shown, overflow = (n > cap and cap >= 1) and (n - cap + 1) or 0 }
	end
	return out
end

-- Contenu des `shown` pastilles à afficher pour la liste `pills` (BattleLayout.statusPills) : une pastille par état, ou, en cas de manque de place, les premières puis une
-- pastille « +n » qui regroupe les états restants. Chaque élément : { text, bg, fg, detail, merged }.
function BattleLayout.pillChips(pills, shown, Battle)
	local list = type(pills) == "table" and pills or {}
	local n = #list
	local show = clamp(int(shown, 0), 0, n)
	local chips = {}
	if show >= n then
		for i = 1, n do
			chips[i] = { text = list[i].text, bg = list[i].bg, fg = list[i].fg, detail = BattleLayout.pillDetail(list[i], Battle), merged = false }
		end
	elseif show >= 1 then
		for i = 1, show - 1 do
			chips[i] = { text = list[i].text, bg = list[i].bg, fg = list[i].fg, detail = BattleLayout.pillDetail(list[i], Battle), merged = false }
		end
		local details = {}
		for i = show, n do
			details[#details + 1] = BattleLayout.pillDetail(list[i], Battle)
		end
		chips[show] = { text = "+" .. (n - show + 1), bg = BattleLayout.STATUS_MORE.bg, fg = BattleLayout.STATUS_MORE.fg, detail = table.concat(details, "\n"), merged = true }
	end
	return chips
end

-- Fil des PV de toute l'équipe pour l'écran « Changer » : une ligne par pet (au plus MAX_DOTS) avec indice, PV, charge du spécial, état. Un pet à 0 PV est « ko » (grisé,
-- jamais cliquable) ; le pet au combat est « active » (affiché, non cliquable : on ne change pas pour soi-même) ; les autres sont « ready » (cliquables).
function BattleLayout.swapRows(side)
	local rows = {}
	local units = type(side) == "table" and type(side.units) == "table" and side.units or {}
	local active = type(side) == "table" and isNum(side.active) and math.floor(side.active) or 1
	for i = 1, math.min(#units, BattleLayout.MAX_DOTS) do
		local u = units[i]
		if type(u) == "table" then
			local alive = isNum(u.hp) and u.hp > 0
			local info = BattleLayout.chargePips(u.charge, u.chargeMax)
			local state = (not alive) and "ko" or (i == active and "active" or "ready")
			local pipsText = ""
			for k = 1, info.max do
				pipsText = pipsText .. (info.pips[k] and "●" or "○")
			end
			local tag = state == "ko" and "💀 K.O." or (state == "active" and "▶ Au combat" or "🔁 Changer")
			rows[#rows + 1] = {
				index = i, p = u.p, alive = alive, active = state == "active", state = state, clickable = state == "ready", tag = tag,
				hp = clamp(int(u.hp, 0), 0, 9999999), maxHp = math.max(0, int(u.maxHp, 0)), frac = BattleLayout.hpFraction(u), hpText = BattleLayout.hpText(u),
				level = BattleLayout.levelText(u), charge = info.charge, chargeMax = info.max, chargeReady = info.ready, pipsText = pipsText,
				chargeText = "Charge " .. info.charge .. "/" .. info.max, statuses = BattleLayout.statusPills(u),
			}
		end
	end
	return rows
end

BattleLayout.SWAP_ROW_MIN = 44 -- une ligne de l'écran « Changer » est un bouton : 44 px de haut au moins
BattleLayout.SWAP_ROW_MAX = 64

-- Écran « Changer » : panneau centré (titre, note, lignes, bouton « Retour »). Les lignes passent sur 2 colonnes quand la fenêtre est trop basse pour 44 px chacune.
-- Retourne { panel, title, note, back, cols, rowH, rows = { rect } } ; tout est dans la zone utile, aucune superposition, boutons >= 44 px (testé sur la matrice d'appareils).
function BattleLayout.swapRects(vw, vh, safeIn, n)
	local R = BattleLayout.rects(vw, vh, safeIn)
	local count = clamp(int(n, 3), 1, BattleLayout.MAX_DOTS)
	local a = R.area
	local pw = math.floor(math.min(a.w, 440))
	local pad, gap = 10, 6
	local titleH, noteH, backH = 28, 18, BattleLayout.MIN_TOUCH + 4
	local fixed = pad + titleH + noteH + gap * 2 + backH + pad
	local ph = math.floor(a.h)
	local panel = rect(math.floor(a.x + (a.w - pw) / 2), math.floor(a.y), pw, ph)
	local avail = ph - fixed
	local cols = 1
	local rowsPerCol = count
	local rowH = math.floor((avail - (rowsPerCol - 1) * gap) / rowsPerCol)
	if rowH < BattleLayout.SWAP_ROW_MIN and count > 1 then
		cols = 2
		rowsPerCol = math.ceil(count / 2)
		rowH = math.floor((avail - (rowsPerCol - 1) * gap) / rowsPerCol)
	end
	rowH = clamp(rowH, BattleLayout.SWAP_ROW_MIN, BattleLayout.SWAP_ROW_MAX)
	local out = { panel = panel, cols = cols, rowH = rowH, rows = {} }
	out.title = rect(panel.x + pad, panel.y + pad, pw - 2 * pad, titleH)
	out.note = rect(panel.x + pad, out.title.y + titleH, pw - 2 * pad, noteH)
	local rowsY = out.note.y + noteH + gap
	local colW = math.floor((pw - 2 * pad - (cols - 1) * gap) / cols)
	for i = 1, count do
		local col = (i - 1) // rowsPerCol
		local row = (i - 1) % rowsPerCol
		out.rows[i] = rect(panel.x + pad + col * (colW + gap), rowsY + row * (rowH + gap), colW, rowH)
	end
	out.back = rect(panel.x + pad, panel.y + ph - pad - backH, pw - 2 * pad, backH)
	return out
end

-- Flash du spécial : déclenché UNIQUEMENT quand la charge du MÊME pet passe de « pas pleine » à « pleine » (jamais au changement de pet ni à la 1re vue).
-- prev / cur = { key = identité du pet, full = charge pleine ? } (ou nil). Retourne "flash" ou "set" (mise à jour silencieuse).
function BattleLayout.specialTransition(prev, cur)
	if type(prev) == "table" and type(cur) == "table" and prev.key ~= nil and prev.key == cur.key and prev.full ~= true and cur.full == true then
		return "flash"
	end
	return "set"
end

BattleLayout.FLASH_SECONDS = 0.7
BattleLayout.MAX_FLASH = 1.5 -- aucun flash ne dure plus de 1,5 s, quelle que soit la vitesse choisie

-- Durée réelle du flash : 0,7 s (0,35 s en effets réduits), divisée par la vitesse du combat, jamais au-dessus de MAX_FLASH.
function BattleLayout.flashSeconds(reduced, speed)
	local base = reduced == true and BattleLayout.FLASH_SECONDS / 2 or BattleLayout.FLASH_SECONDS
	return math.min(BattleLayout.MAX_FLASH, BattleLayout.animSeconds(base, speed))
end

-- Image du flash à l'instant a (0..1) : voile blanc qui s'éteint, bouton qui gonfle de 1 à 1,12 puis revient, contour qui s'estompe ; extrémités exactes.
function BattleLayout.specialFlash(a)
	local k = isNum(a) and clamp(a, 0, 1) or 1
	local pulse = math.sin(math.pi * k)
	return { veilTransparency = 1 - 0.75 * (1 - k) * (1 - k), scale = 1 + 0.12 * pulse, strokeAlpha = 1 - k }
end

-- Remplissage du bouton Spécial selon la charge (animation de charge) : fraction 0..1.
function BattleLayout.chargeFill(charge, max)
	local info = BattleLayout.chargePips(charge, max)
	return info.charge / info.max
end

-- Points de dégradé du bouton Spécial (animation de charge) : le fond multiplie sa couleur par `m` (1 = clair) sur la partie chargée et par `dim` sur le reste, avec une
-- coupure nette à la fraction de charge. Retourne { { t, m } } avec t strictement croissant de 0 à 1 (exigence de ColorSequence).
function BattleLayout.chargeStops(frac, dim)
	local f = isNum(frac) and clamp(frac, 0, 1) or 0
	local d = isNum(dim) and clamp(dim, 0, 1) or 0.55
	if f <= 0 then
		return { { t = 0, m = d }, { t = 1, m = d } }
	elseif f >= 1 then
		return { { t = 0, m = 1 }, { t = 1, m = 1 } }
	end
	local cut = math.min(0.999, f)
	return { { t = 0, m = 1 }, { t = cut, m = 1 }, { t = math.min(1, cut + 0.001), m = d }, { t = 1, m = d } }
end

-- Sons : clés de Config.SOUNDS seulement (aucun identifiant inventé). Une clé est jouable si Config.SOUNDS_ENABLED n'est pas faux et si sa définition a un id non vide.
function BattleLayout.soundKey(Config, key)
	if type(Config) ~= "table" or type(key) ~= "string" or Config.SOUNDS_ENABLED == false or type(Config.SOUNDS) ~= "table" then
		return nil
	end
	local def = Config.SOUNDS[key]
	if type(def) ~= "table" or type(def.id) ~= "string" or def.id == "" then
		return nil
	end
	return key
end

-- Son de chaque action d'un tour : attaque = son du type de l'attaquant (Config.ATK_SOUND), spécial = special_hit, changement de pet = click. Soin, garde, K.O., étourdissement :
-- aucun son n'existe dans Config.SOUNDS, donc silence (rien d'inventé). opts = { typeOf = fn(espèce) -> type, speed, attackSounds = false pour laisser les effets de type jouer
-- les attaques }. Retourne { { at = secondes, key, kind } } aux mêmes instants que les animations de BattleScene.cues (un coup ou un soin tous les 0,6 s à 1x).
function BattleLayout.soundPlan(Config, events, opts)
	local o = type(opts) == "table" and opts or {}
	local out = {}
	local step = BattleLayout.animSeconds(0.6, o.speed)
	local k = 0
	for _, ev in ipairs(type(events) == "table" and events or {}) do
		local cue = BattleLayout.cue(ev)
		if cue then
			local at = step * k
			local key, kind
			if cue.anim == "attack" and cue.special == true then
				key, kind = BattleLayout.soundKey(Config, "special_hit"), "special"
			elseif cue.anim == "attack" and ev.t == "hit" and o.attackSounds ~= false then
				local typ = type(o.typeOf) == "function" and o.typeOf(ev.p) or nil
				key, kind = BattleLayout.soundKey(Config, type(Config) == "table" and type(Config.ATK_SOUND) == "table" and Config.ATK_SOUND[typ] or nil), "attack"
			elseif cue.anim == "swap" and ev.forced ~= true then
				key, kind = BattleLayout.soundKey(Config, "click"), "swap"
			end
			if key then
				out[#out + 1] = { at = at, key = key, kind = kind }
			end
			if cue.anim == "attack" or cue.anim == "heal" then
				k = k + 1
			end
		end
	end
	return out
end

-- XP du pet à l'écran de fin : lue UNIQUEMENT dans le message « end » du serveur (`xp` ou `rewards.xp`) ; le client ne la calcule pas (le serveur n'envoie ni l'XP avant
-- le combat ni le détail du barème). Formes acceptées : un nombre (gain par pet de l'équipe) ou une liste { { p = espèce, gain = nombre, total = XP cumulée (facultatif) } }
-- avec PetXp (facultatif) pour détecter la montée de niveau. Retourne au plus 4 lignes ; valeurs invalides ignorées ; aucune ligne si le serveur n'envoie rien.
function BattleLayout.xpLines(msg, Config, PetXp)
	local lines = {}
	if type(msg) ~= "table" then
		return lines
	end
	local src = msg.xp
	if src == nil and type(msg.rewards) == "table" then
		src = msg.rewards.xp
	end
	if isNum(src) then
		if src >= 1 then
			lines[1] = "⭐ +" .. math.floor(math.min(src, 100000)) .. " XP pour chaque pet de l'équipe"
		end
		return lines
	end
	if type(src) ~= "table" then
		return lines
	end
	for _, e in ipairs(src) do
		if #lines >= 4 then
			break
		end
		if type(e) == "table" and isNum(e.gain) and e.gain >= 1 then
			local def = type(Config) == "table" and type(Config.PETS) == "table" and Config.PETS[e.p] or nil
			local who = def and (tostring(def.emoji or "") .. " " .. tostring(def.name or "?")) or "⭐ Pet"
			local line = who .. " : +" .. math.floor(math.min(e.gain, 100000)) .. " XP"
			if isNum(e.total) and type(PetXp) == "table" and type(PetXp.levelOf) == "function" then
				local after = PetXp.levelOf(e.total)
				local before = PetXp.levelOf(math.max(0, e.total - e.gain))
				if isNum(after) and isNum(before) and after > before then
					line = line .. " · ⬆ Niv. " .. before .. " → " .. after
				end
			end
			lines[#lines + 1] = line
		end
	end
	return lines
end

---------------------------------------------------------------- plafond d'instances

-- Coût estimé (instances) de la scène : interface + monde. Les constantes suivent BattleScene (un test compare à la construction réelle).
BattleLayout.COST = {
	gui = 6, -- racine, fond de ciel, dégradé, viewport, filtre d'assombrissement, caméra
	card = 14, -- cadre, coin, contour, bandeau de couleur, icône (texte + image), nom, niveau, barre (4), texte de PV ou contexte
	dot = 2, -- point + coin
	pip = 2,
	button = 4, -- bouton, coin, contour, étiquette de charge
	log = 5,
	swapPanel = 6, -- écran « Changer » (construit à l'ouverture, détruit à la fermeture) : cadre, titre, note, bouton Retour (+ coin, contour)
	swapRow = 4, -- une ligne par pet : bouton, coin, fond et remplissage de la barre de PV
	pill = 2, -- pastille d'état : bouton + coin (3 par camp au plus)
	tip = 1, -- info-bulle d'une pastille : une étiquette
	flash = 5, -- flash et charge du spécial : barre derrière le bouton (cadre, coin, dégradé), échelle, voile
	ground = 2, -- sol, anneau
	pedestal = 2, -- socle de pierre, disque néon
	beam = 1, -- colonne de lumière translucide (néon)
	puppet = 13, -- créature procédurale : corps, tête, yeux, oreilles, queue, ombre, modèle
	pillar = 1,
	popup = 1, -- nombre flottant ou message de type (une étiquette), au plus MAX_POPUPS simultanés
	queue = 11, -- ordre du tour : étiquette + 3 pastilles (cadre, coin, emoji)
	speedBtns = 6, -- vitesse et saut (bouton, coin, contour chacun)
}
BattleLayout.MAX_POPUPS = 6

---------------------------------------------------------------- modèles Blender des pets en combat (mobs, étape 1)
-- Le combat clone la copie légère publiée par le serveur (ReplicatedStorage.PetModels, au plus 40 Parts). Le plan ci-dessus reste calculé pour la créature
-- procédurale (COST.puppet) : un modèle n'est posé que s'il tient dans ce qui RESTE sous le plafond à cet instant, réserve gardée pour ce qui peut encore
-- apparaître (étiquettes flottantes, écran « Changer » complet, info-bulle, flash du spécial) ; sinon, repli procédural.
BattleLayout.MODEL_MAX_INSTANCES = 48 -- instances d'un modèle cloné (Model + 40 Parts + quelques maillages)
BattleLayout.MODEL_RESERVE = BattleLayout.MAX_POPUPS * BattleLayout.COST.popup + BattleLayout.COST.swapPanel + BattleLayout.MAX_DOTS * BattleLayout.COST.swapRow + BattleLayout.COST.tip + BattleLayout.COST.flash
BattleLayout.MODEL_K = 3 / 1.7 -- hauteur de combat = hauteur au monde (Config.petTargetHeight) x MODEL_K : un pet Commun « Normal » mesure 3 studs, comme la créature procédurale
BattleLayout.MODEL_MIN_H = 2.2
BattleLayout.MODEL_MAX_H = 4.5 -- jamais plus large que le socle

-- Vrai si un modèle de `n` instances peut être posé : n valide, n <= MODEL_MAX_INSTANCES et used + n + MODEL_RESERVE <= cap.
function BattleLayout.modelFits(n, used, cap)
	if not (isNum(n) and isNum(used) and isNum(cap)) or n < 1 then
		return false
	end
	return n <= BattleLayout.MODEL_MAX_INSTANCES and used + n + BattleLayout.MODEL_RESERVE <= cap
end

-- Hauteur de combat (studs) du modèle d'un pet : même règle que le monde (rareté, échelle de taille bornée 0,8 à 1,4 comme la créature procédurale),
-- x MODEL_K, bornée [MODEL_MIN_H, MODEL_MAX_H]. `targetHeight` = Config.petTargetHeight (absente : 1,7 à 2,5 selon la rareté sur 10).
function BattleLayout.modelHeight(tier, sizeScale, targetHeight, tierCount)
	local s = isNum(sizeScale) and clamp(sizeScale, 0.8, 1.4) or 1
	local h
	if type(targetHeight) == "function" then
		local ok, v = pcall(targetHeight, tier, s)
		h = (ok and isNum(v) and v > 0) and v or nil
	end
	if h == nil then
		local n = isNum(tierCount) and tierCount > 1 and tierCount or 10
		local t = isNum(tier) and clamp(tier, 1, n) or 1
		h = (1.7 + 0.8 * (t - 1) / (n - 1)) * s
	end
	return clamp(h * BattleLayout.MODEL_K, BattleLayout.MODEL_MIN_H, BattleLayout.MODEL_MAX_H)
end

-- Facteur d'échelle pour passer de la hauteur mesurée `measured` à `target`, ou nil si la mesure est absurde (le combat garde alors le repli).
function BattleLayout.modelScale(measured, target)
	if not (isNum(measured) and isNum(target)) or measured < 0.05 or target <= 0 then
		return nil
	end
	local f = target / measured
	if f < 0.02 or f > 100 then
		return nil
	end
	return f
end

-- Plan de la scène selon l'appareil : { pillars, beams, bob, decor, estimate }. `reduced` (mobile) : moitié du décor, ni faisceaux ni balancement.
-- Le décor (piliers ou touffes) est réduit jusqu'à tenir sous MAX_INSTANCES, avec une marge de 20 instances pour les remplacements de créature.
function BattleLayout.plan(opts)
	local o = type(opts) == "table" and opts or {}
	local reduced = o.reduced == true
	local nMe = clamp(int(o.units1, 3), 1, BattleLayout.MAX_DOTS)
	local nFoe = clamp(int(o.units2, 3), 1, BattleLayout.MAX_DOTS)
	local C = BattleLayout.COST
	local beams = not reduced
	local decor = reduced and 6 or 12
	local function estimate(n)
		local e = C.gui + 2 * C.card + (nMe + nFoe) * C.dot + BattleLayout.CHARGE_MAX * C.pip + 4 * C.button + C.log + C.swapPanel + nMe * C.swapRow + 2 * BattleLayout.MAX_PILLS * C.pill + C.tip + C.flash + C.queue + C.speedBtns + C.ground + 2 * C.pedestal + 2 * C.puppet + n * C.pillar + BattleLayout.MAX_POPUPS * C.popup
		if beams then
			e = e + 2 * C.beam
		end
		return e
	end
	local budget = BattleLayout.MAX_INSTANCES - 20
	while decor > 0 and estimate(decor) > budget do
		decor = decor - 1
	end
	if estimate(decor) > budget then
		beams = false
	end
	return { pillars = decor, beams = beams, bob = not reduced, decor = decor, reduced = reduced, estimate = estimate(decor), cap = BattleLayout.MAX_INSTANCES }
end

-- Positions des éléments de décor (piliers du colisée ou touffes d'herbe) en arc derrière les socles : { { x, z, h } } (studs), déterministe.
function BattleLayout.decorSpots(n)
	local spots = {}
	local count = clamp(int(n, 0), 0, 24)
	for i = 1, count do
		local t = count == 1 and 0.5 or (i - 1) / (count - 1)
		local ang = math.rad(200 + 140 * t) -- demi-cercle derrière
		local R = 30
		spots[i] = { x = math.floor(math.cos(ang) * R * 100 + 0.5) / 100, z = math.floor(math.sin(ang) * R * 100 + 0.5) / 100 - 4, h = 7 + (i % 3) * 1.5 }
	end
	return spots
end

return BattleLayout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">Graphics</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Graphics
-- Lot GRAPHISMES (monde) : logique PURE, déterministe, testée hors de Roblox. Aucun Instance, aucun tirage libre (Park-Miller 48271).
--   Graphics.checkLighting(L)                 : cohérence des palettes de lumière entre zones (teinte, saturation, valeur, heure, densité, brume).
--   Graphics.assignStyles(items, poolOf, d)   : style de chaque arbre, jamais deux styles identiques à moins de `d` studs si le choix le permet.
--   Graphics.blenderStyle(key) / procStyle    : décodage d'un style d'arbre (modèle + classe de taille ; forme + taille + teinte).
--   Graphics.groundPlan(Config, P, planItems) : variations de chemins, bordures d'herbe irrégulières, touffes et grappes de fleurs (plafonds de Parts).
--   Graphics.selectLights(lights, cam, n, r)  : les `n` lumières les plus proches (à moins de `r`) restent allumées, les autres sont coupées (LOD).
-- Compatible lupa : pas de += ni de continue, pas de math.atan2.
local Graphics = {}

local function dist(ax, az, bx, bz)
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Pause coopérative facultative (Builder la règle sur task.wait, comme Placement.yield) : le calcul du sol cède la main tous les 25 essais ; les tests purs la laissent à nil.
Graphics.yield = nil
local pauseCount = 0
local function pause()
	pauseCount = pauseCount + 1
	if Graphics.yield and pauseCount % 25 == 0 then
		Graphics.yield()
	end
end

-- Générateur déterministe Park-Miller (48271 mod 2^31-1) : les produits restent sous 2^53.
local function newRng(seed)
	local s = math.floor(seed) % 2147483647
	if s <= 0 then
		s = 1
	end
	return function()
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end
Graphics.newRng = newRng

---------------------------------------------------------------- Couleurs
-- RGB 0..255 -> teinte (degrés 0..360), saturation et valeur (0..1).
function Graphics.rgbToHsv(r, g, b)
	local rr, gg, bb = r / 255, g / 255, b / 255
	local mx, mn = math.max(rr, gg, bb), math.min(rr, gg, bb)
	local d = mx - mn
	local h = 0
	if d > 0 then
		if mx == rr then
			h = 60 * (((gg - bb) / d) % 6)
		elseif mx == gg then
			h = 60 * ((bb - rr) / d + 2)
		else
			h = 60 * ((rr - gg) / d + 4)
		end
	end
	local s = mx > 0 and d / mx or 0
	return h, s, mx
end

-- Écart angulaire de teinte (0..180).
function Graphics.hueDelta(a, b)
	local d = math.abs(a - b) % 360
	return d > 180 and 360 - d or d
end

---------------------------------------------------------------- Lumière
local COLOR_ROLES = { "ambient", "outdoor", "tint", "atmo", "decay" }
local SCALARS = { "clock", "density", "haze", "glare" }

local function isColor(c)
	return type(c) == "table" and type(c[1]) == "number" and type(c[2]) == "number" and type(c[3]) == "number" and c[1] >= 0 and c[1] <= 255 and c[2] >= 0 and c[2] <= 255 and c[3] >= 0 and c[3] <= 255
end

-- Vérifie la cohérence des palettes de Config.LIGHTING. Retourne { ok, problems = { texte }, stats = { hue, sat, val, clock, density, haze } } où stats donne le
-- plus grand écart mesuré entre deux zones (tous rôles confondus). Les couleurs très peu saturées (< minSatForHue) n'ont pas de teinte comparée.
function Graphics.checkLighting(L)
	local problems, stats = {}, { hue = 0, sat = 0, val = 0, clock = 0, density = 0, haze = 0, bloom = 0 }
	if type(L) ~= "table" or type(L.zones) ~= "table" or type(L.limits) ~= "table" then
		return { ok = false, problems = { "LIGHTING absent ou incomplet" }, stats = stats }
	end
	local lim = L.limits
	local names = {}
	for _, n in ipairs(L.zoneOrder or {}) do
		names[#names + 1] = n
	end
	if #names < 4 then
		problems[#problems + 1] = "au moins 4 zones attendues (hub, parcelles, arène, château)"
	end
	local seen = {}
	for _, n in ipairs(names) do
		seen[n] = true
		local z = L.zones[n]
		if type(z) ~= "table" then
			problems[#problems + 1] = "zone " .. n .. " absente"
		else
			for _, role in ipairs(COLOR_ROLES) do
				local c = z[role]
				if not isColor(c) then
					problems[#problems + 1] = n .. "." .. role .. " : couleur invalide"
				else
					local h, s = Graphics.rgbToHsv(c[1], c[2], c[3])
					if s >= lim.minSatForHue and (h < lim.warmHueMin or h > lim.warmHueMax) then
						problems[#problems + 1] = n .. "." .. role .. " : teinte " .. math.floor(h) .. " hors de la bande chaude " .. lim.warmHueMin .. "-" .. lim.warmHueMax
					end
				end
			end
			for _, k in ipairs(SCALARS) do
				if type(z[k]) ~= "number" or z[k] ~= z[k] then
					problems[#problems + 1] = n .. "." .. k .. " : nombre attendu"
				end
			end
			if type(z.bloom) ~= "table" or type(z.bloom.intensity) ~= "number" or z.bloom.intensity > lim.bloomMax or z.bloom.intensity < 0 then
				problems[#problems + 1] = n .. ".bloom : intensité absente ou au-delà de " .. tostring(lim.bloomMax)
			end
			if type(z.grade) ~= "table" or type(z.grade.saturation) ~= "number" or z.grade.saturation < lim.gradeSatMin or z.grade.saturation > lim.gradeSatMax then
				problems[#problems + 1] = n .. ".grade : saturation hors de " .. lim.gradeSatMin .. ".." .. lim.gradeSatMax
			end
			if type(z.density) == "number" and z.density > lim.densityMax then
				problems[#problems + 1] = n .. ".density : brume trop dense"
			end
		end
	end
	if #problems == 0 then
		for i = 1, #names do
			for j = i + 1, #names do
				local a, b = L.zones[names[i]], L.zones[names[j]]
				for _, role in ipairs(COLOR_ROLES) do
					local ha, sa, va = Graphics.rgbToHsv(a[role][1], a[role][2], a[role][3])
					local hb, sb, vb = Graphics.rgbToHsv(b[role][1], b[role][2], b[role][3])
					if sa >= lim.minSatForHue and sb >= lim.minSatForHue then
						stats.hue = math.max(stats.hue, Graphics.hueDelta(ha, hb))
					end
					stats.sat = math.max(stats.sat, math.abs(sa - sb))
					stats.val = math.max(stats.val, math.abs(va - vb))
				end
				stats.clock = math.max(stats.clock, math.abs(a.clock - b.clock))
				stats.density = math.max(stats.density, math.abs(a.density - b.density))
				stats.haze = math.max(stats.haze, math.abs(a.haze - b.haze))
				stats.bloom = math.max(stats.bloom, math.abs(a.bloom.intensity - b.bloom.intensity))
			end
		end
		local function over(name, v, limit)
			if v > limit then
				problems[#problems + 1] = "écart de " .. name .. " entre zones : " .. string.format("%.3f", v) .. " > " .. limit
			end
		end
		over("teinte", stats.hue, lim.hueSpread)
		over("saturation", stats.sat, lim.satSpread)
		over("valeur", stats.val, lim.valSpread)
		over("heure", stats.clock, lim.clockSpread)
		over("densité", stats.density, lim.densitySpread)
		over("brume", stats.haze, lim.hazeSpread)
	end
	return { ok = #problems == 0, problems = problems, stats = stats }
end

---------------------------------------------------------------- Styles d'arbres
-- items = { {x, z, ...} } dans l'ordre de pose ; poolOf(item, index) -> liste de clés de style. Choisit pour chaque arbre le style dont l'exemplaire le plus proche
-- est le plus loin (égalité : style le moins employé, puis ordre du pool décalé par le rang : pas de motif répété). Retourne (clés, stats) ; stats.minSame = plus petite
-- distance entre deux arbres de même style (math.huge si aucun), stats.violations = paires plus proches que `minDist`, stats.styles = nombre de styles employés.
function Graphics.assignStyles(items, poolOf, minDist)
	local keys, usage = {}, {}
	local byKey = {}
	for i, it in ipairs(items) do
		local pool = poolOf(it, i)
		local best, bestD, bestU = nil, -1, math.huge
		local n = #pool
		for off = 0, n - 1 do
			local key = pool[(off + i) % n + 1]
			local nearest = math.huge
			for _, o in ipairs(byKey[key] or {}) do
				local d = dist(it.x, it.z, o.x, o.z)
				if d < nearest then
					nearest = d
				end
			end
			local u = usage[key] or 0
			if nearest > bestD or (nearest == bestD and u < bestU) then
				best, bestD, bestU = key, nearest, u
			end
		end
		keys[i] = best
		usage[best] = (usage[best] or 0) + 1
		byKey[best] = byKey[best] or {}
		byKey[best][#byKey[best] + 1] = it
	end
	return keys, Graphics.styleStats(items, keys, minDist)
end

-- Mesure : plus petite distance entre deux arbres de même clé, paires sous `minDist`, nombre de styles distincts.
function Graphics.styleStats(items, keys, minDist)
	local minSame, violations, used, count = math.huge, 0, {}, 0
	for i = 1, #items do
		if not used[keys[i]] then
			used[keys[i]] = true
			count = count + 1
		end
		for j = i + 1, #items do
			if keys[i] == keys[j] then
				local d = dist(items[i].x, items[i].z, items[j].x, items[j].z)
				if d < minSame then
					minSame = d
				end
				if d < (minDist or 0) then
					violations = violations + 1
				end
			end
		end
	end
	return { minSame = minSame, violations = violations, styles = count, trees = #items }
end

-- Clé de style des arbres Blender : « modèle@classe » (classe = rang dans Config.GRAPHICS.trees.sizeClasses).
function Graphics.blenderKeys(models, classCount)
	local out = {}
	for _, m in ipairs(models) do
		for c = 1, classCount do
			out[#out + 1] = m .. "@" .. c
		end
	end
	return out
end

function Graphics.blenderStyle(Config, key)
	local model, c = tostring(key):match("^(.-)@(%d+)$")
	local classes = Config.GRAPHICS.trees.sizeClasses
	local scale = classes[tonumber(c) or 1] or 1
	return { model = model, scale = scale }
end

-- Clé de style des arbres procéduraux : « forme:taille:teinte » (rangs dans Config.GRAPHICS.trees).
function Graphics.procKeys(Config, north)
	local T = Config.GRAPHICS.trees
	local leaves = north and T.procLeavesNorth or T.procLeavesMeadow
	local out = {}
	for sh = 1, #T.procShapes do
		for sz = 1, #T.procSizes do
			for lf = 1, #leaves do
				out[#out + 1] = sh .. ":" .. sz .. ":" .. lf
			end
		end
	end
	return out
end

function Graphics.procStyle(Config, key, north)
	local T = Config.GRAPHICS.trees
	local sh, sz, lf = tostring(key):match("^(%d+):(%d+):(%d+)$")
	local leaves = north and T.procLeavesNorth or T.procLeavesMeadow
	return { shape = T.procShapes[tonumber(sh) or 1], scale = T.procSizes[tonumber(sz) or 1], leaf = leaves[tonumber(lf) or 1], key = key }
end

-- Styles d'une liste d'arbres procéduraux ({x, z, grove?}) : retourne { {shape, scale, leaf, key} } dans l'ordre + statistiques. Les arbres du nord (z < -180) et
-- des bosquets prennent la palette « nord » (plus sombre).
function Graphics.styleForest(Config, forest)
	local function isNorth(t)
		return t.grove ~= nil or t.z < -180
	end
	local meadow, north = Graphics.procKeys(Config, false), Graphics.procKeys(Config, true)
	local keys, stats = Graphics.assignStyles(forest, function(t)
		return isNorth(t) and north or meadow
	end, Config.GRAPHICS.trees.procMinSameDist)
	-- une clé « nord » et une clé « prairie » ont la même écriture : on les sépare pour la mesure d'unicité
	local out = {}
	for i, t in ipairs(forest) do
		out[i] = Graphics.procStyle(Config, keys[i], isNorth(t))
	end
	local tagged = {}
	for i, t in ipairs(forest) do
		tagged[i] = (isNorth(t) and "n" or "m") .. keys[i]
	end
	return out, Graphics.styleStats(forest, tagged, Config.GRAPHICS.trees.procMinSameDist)
end

---------------------------------------------------------------- LOD des lumières
-- lights = { {x, y, z} } ; cam = {x, y, z}. Retourne un tableau booléen : vrai pour les `maxOn` lumières les plus proches (à moins de `range`), faux ailleurs.
-- Distances invalides (nil, NaN) : lumière coupée. Ordre stable (égalité : rang).
function Graphics.selectLights(lights, cam, maxOn, range)
	local on = {}
	local cand = {}
	for i, l in ipairs(lights) do
		on[i] = false
		if type(l) == "table" and type(l.x) == "number" and type(l.y) == "number" and type(l.z) == "number" and type(cam) == "table" then
			local d = math.sqrt((l.x - cam.x) ^ 2 + (l.y - cam.y) ^ 2 + (l.z - cam.z) ^ 2)
			if d == d and d <= range then
				cand[#cand + 1] = { i = i, d = d }
			end
		end
	end
	table.sort(cand, function(a, b)
		if a.d ~= b.d then
			return a.d < b.d
		end
		return a.i < b.i
	end)
	for k = 1, math.min(maxOn, #cand) do
		on[cand[k].i] = true
	end
	return on
end

---------------------------------------------------------------- Sol : chemins, bordures d'herbe, touffes et fleurs
local function pick(list, r)
	return list[1 + math.floor(r * #list) % #list]
end

-- Plan du sol, déterministe. P = Placement.new(Config, MapGeo) (blocked, groundY, forest, pathSegments), planItems = P.plan().items (objets déjà posés).
-- Retourne { pathPatches, edges, tufts, clusters, parts, stats } :
--   pathPatches : { x, z, y, w, d, rot, color, material, path } — petites dalles posées SUR un chemin (variation de couleur et de matière) ;
--   edges       : { x, z, r, color } — taches d'herbe irrégulières au bord des chemins (jamais en travers d'un autre interdit que le chemin lui-même) ;
--   tufts       : { x, z, y, size, color } — touffes isolées ; clusters : { x, z, y, size, color, flowers = { {dx, dz, color} } } (1 touffe + fleurs).
-- Règles : touffes et grappes sur du sol LIBRE (MapGeo.blocked == nil, hors empreintes d'arbres et d'objets), à moins de scatterRange d'un chemin ou de la place ;
-- densité plafonnée par cellule ; au plus budgetParts Parts au total.
function Graphics.groundPlan(Config, P, planItems)
	local GR = Config.GRAPHICS.ground
	local M2 = Config.Map2
	local G = P.G
	local B = M2.bounds
	local out = { pathPatches = {}, edges = {}, tufts = {}, clusters = {}, stats = {} }
	local rng = newRng(90210)
	local forest = P.forest()
	local blocking = {}
	for _, it in ipairs(planItems or {}) do
		blocking[#blocking + 1] = { it.x, it.z, it.r or 2 }
	end
	for _, it in ipairs(forest) do
		blocking[#blocking + 1] = { it.x, it.z, it.r or 3.5 }
	end
	local function freeOfObjects(x, z, r)
		for _, q in ipairs(blocking) do
			if dist(x, z, q[1], q[2]) < q[3] + r + 0.5 then
				return false
			end
		end
		return true
	end
	local function nearBridge(x, z, r)
		for _, b in ipairs(G.bridges) do
			if dist(x, z, b.x, b.z) < b.len / 2 + r + 1 then
				return true
			end
		end
		return false
	end
	-- 1. segments de chemin au sol (même découpage que Scenery.paths : rang k du segment dans sa polyligne)
	local segs, totalLen = {}, 0
	for _, p in ipairs(M2.paths) do
		if (p.y or 0) == 0 then
			local paved = p.kind ~= "dirt"
			local half = paved and M2.pathHalf or M2.dirtHalf
			for k = 1, #p.pts - 1 do
				local ax, az, bx, bz = p.pts[k][1], p.pts[k][2], p.pts[k + 1][1], p.pts[k + 1][2]
				local len = dist(ax, az, bx, bz)
				segs[#segs + 1] = { ax = ax, az = az, bx = bx, bz = bz, len = len, half = half, paved = paved, k = k, name = p.name, last = k == #p.pts - 1 }
				totalLen = totalLen + len
			end
		end
	end
	-- 2. variations posées sur les chemins : pas élargi pour respecter le plafond
	local spacing = math.max(GR.pathPatchSpacing, totalLen / GR.pathPatchCap)
	local roadsideSpacing = math.max(GR.edgeSpacing, 2 * totalLen / GR.edgeCap)
	for _, s in ipairs(segs) do
		local dx, dz = (s.bx - s.ax) / s.len, (s.bz - s.az) / s.len
		local nx, nz = -dz, dx
		-- hauteur de la dalle de ce segment (Scenery.paths : dalles alternées, épaisseur de 0,2) ; joints aux sommets : on s'en écarte
		local top = s.paved and ((s.k % 2 == 1) and 0.28 or 0.34) or ((s.k % 2 == 1) and 0.04 or 0.10)
		local t = spacing * (0.3 + 0.5 * rng())
		local n = 0
		while t < s.len - s.half - 0.5 do
			if t > s.half + 0.5 and #out.pathPatches < GR.pathPatchCap then
				local lat = (rng() * 2 - 1) * (s.half - 2.1)
				local x, z = s.ax + dx * t + nx * lat, s.az + dz * t + nz * lat
				local w, d = 1.2 + rng() * 2.2, 0.9 + rng() * 1.5
				pause()
				local why = G.blocked(x, z, 1.2, {})
				if (why == nil or why == "chemin") and not nearBridge(x, z, 1.2) and G.pathEdgeDist(x, z) < -0.5 then
					n = n + 1
					local pal = s.paved and GR.pathPalettePaved or GR.pathPaletteDirt
					local mat = s.paved and (n % 3 == 0 and "Slate" or (n % 3 == 1 and "Cobblestone" or "Pebble")) or (n % 2 == 0 and "Ground" or "Mud")
					out.pathPatches[#out.pathPatches + 1] = { x = x, z = z, y = top - 0.005 + (n % 3) * 0.01, w = w, d = d, rot = rng() * 180, color = pick(pal, rng()), material = mat, path = s.name }
				end
			end
			t = t + spacing * (0.7 + 0.6 * rng())
		end
		-- bordures d'herbe irrégulières : taches de rayon variable, des deux côtés, à cheval sur le bord du chemin
		local t2 = roadsideSpacing * (0.2 + 0.6 * rng())
		while t2 < s.len - 1 do
			for side = -1, 1, 2 do
				if rng() < 0.7 and #out.edges < GR.edgeCap then
					local off = s.half + (rng() * 2 - 0.6) * 1.2
					local r = 0.8 + rng() * 1.2
					local x, z = s.ax + dx * t2 + nx * off * side, s.az + dz * t2 + nz * off * side
					pause()
					local why = G.blocked(x, z, r, {})
					if (why == nil or why == "chemin") and not nearBridge(x, z, r) and G.pathEdgeDist(x, z) > -0.2 and freeOfObjects(x, z, r) then
						out.edges[#out.edges + 1] = { x = x, z = z, r = r, y = (P.groundY(x, z) or 0) + 0.03 + (#out.edges % 4) * 0.01, color = pick(GR.edgePalette, rng()) }
					end
				end
			end
			t2 = t2 + roadsideSpacing * (0.6 + 0.8 * rng())
		end
	end
	-- 3. touffes isolées et grappes de fleurs : cellules mélangées près des chemins et de la place, densité plafonnée
	local function nearAnchor(x, z)
		pause()
		if dist(x, z, M2.plaza.x, M2.plaza.z) < M2.plaza.r + GR.scatterRange then
			return true
		end
		return G.pathEdgeDist(x, z) < GR.scatterRange
	end
	local cellSize = GR.cell
	local cells = {}
	for gx = B.x0 + cellSize / 2, B.x1 - cellSize / 2, cellSize do
		for gz = B.z0 + cellSize / 2, B.z1 - cellSize / 2, cellSize do
			if nearAnchor(gx, gz) then
				cells[#cells + 1] = { gx, gz }
			end
		end
	end
	for i = #cells, 2, -1 do
		local j = 1 + math.floor(rng() * i)
		cells[i], cells[j] = cells[j], cells[i]
	end
	local perCell = {}
	local function cellKey(x, z)
		return math.floor((x - B.x0) / cellSize) .. ":" .. math.floor((z - B.z0) / cellSize)
	end
	local function room(x, z, n)
		return (perCell[cellKey(x, z)] or 0) + n <= GR.maxPerCell
	end
	local function take(x, z, n)
		local k = cellKey(x, z)
		perCell[k] = (perCell[k] or 0) + n
	end
	local flowerCount = 0
	local function partsLeft()
		return Config.GRAPHICS.budgetParts - (#out.pathPatches + #out.edges + #out.tufts + #out.clusters + flowerCount)
	end
	local fl = GR.flowersPerCluster
	for idx, c in ipairs(cells) do
		pause()
		local x, z = c[1] + (rng() - 0.5) * (cellSize - 4), c[2] + (rng() - 0.5) * (cellSize - 4)
		local wantCluster = (idx % 3 == 0) and #out.clusters < GR.clusterCap
		local wantTuft = (not wantCluster) and #out.tufts < GR.tuftCap
		if (wantCluster or wantTuft) and nearAnchor(x, z) and G.blocked(x, z, 1.2, {}) == nil and freeOfObjects(x, z, 1.2) then
			if wantCluster then
				local nf = fl[1] + math.floor(rng() * (fl[2] - fl[1] + 1))
				if room(x, z, nf + 1) and partsLeft() >= nf + 1 then
					local flowers = {}
					for f = 1, nf do
						local a = (f / nf + rng() * 0.2) * math.pi * 2
						local rr = 0.2 + rng() * 0.55
						flowers[f] = { dx = math.cos(a) * rr, dz = math.sin(a) * rr, color = pick(GR.flowerPalette, rng()) }
					end
					out.clusters[#out.clusters + 1] = { x = x, z = z, y = P.groundY(x, z) or 0, size = 1.4 + rng() * 0.6, color = pick(GR.tuftPalette, rng()), flowers = flowers }
					flowerCount = flowerCount + nf
					take(x, z, nf + 1)
				end
			elseif room(x, z, 1) and partsLeft() >= 1 then
				out.tufts[#out.tufts + 1] = { x = x, z = z, y = P.groundY(x, z) or 0, size = 0.9 + rng() * 0.9, color = pick(GR.tuftPalette, rng()) }
				take(x, z, 1)
			end
		end
	end
	-- boucle de complément : si les cellules n'ont pas suffi à atteindre les plafonds, on retente une fois avec d'autres décalages (déterministe)
	local maxCell = 0
	for _, v in pairs(perCell) do
		if v > maxCell then
			maxCell = v
		end
	end
	local parts = #out.pathPatches + #out.edges + #out.tufts + #out.clusters + flowerCount
	out.parts = parts
	out.stats = { parts = parts, pathPatches = #out.pathPatches, edges = #out.edges, tufts = #out.tufts, clusters = #out.clusters, flowers = flowerCount, maxPerCell = maxCell, pathLength = totalLen, cells = #cells }
	return out
end

-- Contrôle d'une fiche de plan : retourne la liste des violations (vide = conforme). Utilisé par les tests et par le serveur (journal de démarrage).
function Graphics.auditGround(Config, P, plan)
	local bad = {}
	local G = P.G
	local GR = Config.GRAPHICS.ground
	for i, t in ipairs(plan.tufts) do
		local why = G.blocked(t.x, t.z, 1.2, {})
		if why then
			bad[#bad + 1] = "touffe " .. i .. " sur zone bloquée (" .. why .. ")"
		end
	end
	for i, c in ipairs(plan.clusters) do
		local why = G.blocked(c.x, c.z, 1.2, {})
		if why then
			bad[#bad + 1] = "grappe " .. i .. " sur zone bloquée (" .. why .. ")"
		end
	end
	for i, e in ipairs(plan.edges) do
		local why = G.blocked(e.x, e.z, e.r, {})
		if why and why ~= "chemin" then
			bad[#bad + 1] = "bordure " .. i .. " sur zone bloquée (" .. why .. ")"
		end
	end
	for i, p in ipairs(plan.pathPatches) do
		local why = G.blocked(p.x, p.z, 1.2, {})
		if why and why ~= "chemin" then
			bad[#bad + 1] = "dalle " .. i .. " sur zone bloquée (" .. why .. ")"
		end
		if G.pathEdgeDist(p.x, p.z) >= 0 then
			bad[#bad + 1] = "dalle " .. i .. " hors du chemin"
		end
	end
	if plan.parts > Config.GRAPHICS.budgetParts then
		bad[#bad + 1] = "budget de Parts dépassé : " .. plan.parts
	end
	if plan.stats.maxPerCell > GR.maxPerCell then
		bad[#bad + 1] = "densité par cellule dépassée : " .. plan.stats.maxPerCell
	end
	return bad
end

return Graphics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">Onboarding</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Onboarding
-- LOT 17 (idée 1 « Premières 5 minutes guidées ») : logique PURE de l'onboarding (aucun service Roblox, aucun os.time : le SERVEUR passe `now` en secondes).
-- Usage : local O = Onboarding.new(Config.ONBOARDING)   (cfg facultative : les valeurs absentes ou invalides prennent Onboarding.DEFAULTS)
-- Séquence FIXE de 5 étapes, une seule action attendue par étape :
--   1 gift   : « voici ton œuf offert » : validée quand le SERVEUR voit le joueur dans sa base (fait `near`)
--   2 hatch  : « éclosion commentée »   : validée quand le profil a au moins 1 éclosion (fait `hatched`, lu dans le profil)
--   3 income : « premier revenu »       : validée quand le revenu réellement versé atteint earnGoal pièces (événement `earn`)
--   4 house  : « première maison »      : validée quand la maison atteint le niveau houseLevel (fait `level`, lu côté serveur)
--   5 arena  : « premier pet à l'arène » : validée quand le serveur démarre un combat de tour (événement `arena`)
-- Garde-fous : une étape ne se valide QUE par le type d'événement qui lui correspond (les autres sont ignorés), avec des valeurs numériques saines ; on ne saute jamais
-- d'étape ; une étape reste affichée au moins minDwell secondes ; le client n'envoie jamais de fait : seul « Passer » (onbSkip) existe côté client, et il ne fait
-- que terminer le tutoriel. Après stepSeconds sans progrès, l'étape affiche son texte d'aide (jamais de validation automatique).
-- Champ de profil `onb` = { v, step, at, prog, skip } : step 1..5 = étape en cours, 6 = terminé ; at = début de l'étape (secondes, 0 = pas encore démarrée) ;
-- prog = pièces de revenu comptées pour l'étape 3 ; skip = passé par le joueur. Un tutoriel terminé ou passé ne se rejoue JAMAIS (rebirth compris : le serveur reporte `onb`).
-- Migration : `migrate(saved, now)` est idempotente. Profil sans `onb` (v13 actuel) : un profil neuf (0 éclosion et moins de legacyPlayedSeconds de jeu) démarre la séquence ;
-- tout autre profil existant est marqué terminé (legacy), SANS rien modifier d'autre. Un `onb` présent est seulement assaini, jamais réinitialisé.
-- Style : pas de `+=`, pas de `continue`, valeurs douteuses gardées par type avant toute comparaison.
local Onboarding = {}

Onboarding.VERSION = 1

Onboarding.DEFAULTS = {
	enabled = true,
	stepSeconds = 45, -- durée visée par étape : au-delà, le texte d'aide remplace le texte normal
	minDwell = 3, -- secondes minimales d'affichage d'une étape avant qu'elle puisse être validée (le texte est lu, pas d'enchaînement instantané)
	earnGoal = 10, -- étape 3 : pièces de revenu à voir tomber
	houseLevel = 2, -- étape 4 : niveau de maison à atteindre
	legacyPlayedSeconds = 120, -- profil sans `onb`, 0 éclosion et moins de temps de jeu que ça : considéré neuf
}

-- Étapes : kind = type d'événement accepté, text = consigne, hint = aide après stepSeconds, target = cible de la flèche du client (home / arena).
Onboarding.STEPS = {
	{ id = "gift", kind = "tick", target = "home", text = "🥚 Ton œuf offert est prêt ! Reste près de lui.", hint = "🥚 Retourne dans ta base : ton œuf offert t'attend." },
	{ id = "hatch", kind = "tick", target = "home", text = "🐣 Il va éclore : regarde bien ce que tu obtiens !", hint = "🐣 Patience : l'éclosion arrive dans quelques secondes." },
	{
		id = "income",
		kind = "earn",
		target = "home",
		text = "🪙 Ton pet gagne des pièces tout seul : attends d'en voir tomber.",
		hint = "💤 Bouge un peu : les pièces ne tombent que si tu es actif.",
	},
	{ id = "house", kind = "tick", target = "home", text = "🏠 Éclos d'autres œufs pour agrandir ta maison.", hint = "🛒 Achète un œuf au marché et pose-le dans ta base." },
	{
		id = "arena",
		kind = "arena",
		target = "arena",
		text = "⚔️ Envoie ton pet à l'Arène : choisis ton équipe puis lance l'étage 1.",
		hint = "⚔️ Va au portail de l'Arène, compose une équipe et lance l'étage 1.",
	},
}

local N = #Onboarding.STEPS
local MAX_TIME = 4e9
local MAX_PROG = 1e6

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function int(v, lo, hi, def)
	if not isnum(v) then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

function Onboarding.new(cfgIn)
	local O = {}
	local cfg = {}
	local src = type(cfgIn) == "table" and cfgIn or {}
	local def = Onboarding.DEFAULTS
	cfg.enabled = src.enabled ~= false
	cfg.stepSeconds = isnum(src.stepSeconds) and src.stepSeconds > 0 and src.stepSeconds or def.stepSeconds
	cfg.minDwell = isnum(src.minDwell) and src.minDwell >= 0 and src.minDwell or def.minDwell
	cfg.earnGoal = isnum(src.earnGoal) and src.earnGoal > 0 and src.earnGoal or def.earnGoal
	cfg.houseLevel = isnum(src.houseLevel) and src.houseLevel >= 2 and math.floor(src.houseLevel) or def.houseLevel
	cfg.legacyPlayedSeconds = isnum(src.legacyPlayedSeconds) and src.legacyPlayedSeconds >= 0 and src.legacyPlayedSeconds or def.legacyPlayedSeconds
	O.cfg = cfg
	O.STEPS = Onboarding.STEPS
	O.TOTAL = N

	-- Séquence neuve : étape 1, pas encore démarrée (at = 0 : le premier appel avec `now` la démarre).
	function O.default()
		return { v = Onboarding.VERSION, step = 1, at = 0, prog = 0, skip = false }
	end

	-- Séquence terminée d'office (profil existant avant le lot 17 : jamais de tutoriel rejoué).
	local function finished()
		return { v = Onboarding.VERSION, step = N + 1, at = 0, prog = 0, skip = false }
	end

	-- Retourne une copie assainie ; ne modifie jamais `raw`. Une valeur absente ou corrompue prend la valeur neuve, jamais celle d'un autre champ.
	function O.sanitize(raw)
		if type(raw) ~= "table" then
			return nil
		end
		return {
			v = Onboarding.VERSION,
			step = int(raw.step, 1, N + 1, 1),
			at = int(raw.at, 0, MAX_TIME, 0),
			prog = isnum(raw.prog) and math.min(MAX_PROG, math.max(0, raw.prog)) or 0,
			skip = raw.skip == true,
		}
	end

	-- Migration idempotente depuis un profil sauvegardé (nil ou table). Retourne le champ `onb` à poser ; ne touche à rien d'autre.
	function O.migrate(saved)
		if type(saved) == "table" and type(saved.onb) == "table" then
			return O.sanitize(saved.onb)
		end
		if type(saved) ~= "table" then
			return O.default()
		end
		local hatched = isnum(saved.hatched) and saved.hatched or 0
		local played = isnum(saved.played) and saved.played or 0
		if hatched <= 0 and played < cfg.legacyPlayedSeconds then
			return O.default()
		end
		return finished()
	end

	-- "active" | "skipped" | "done" (un état absent ou invalide compte pour "done" : on ne rejoue rien).
	function O.status(st)
		if type(st) ~= "table" or not isnum(st.step) then
			return "done"
		end
		if st.step > N then
			return "done"
		end
		if st.skip == true then
			return "skipped"
		end
		return "active"
	end

	function O.active(st)
		return cfg.enabled and O.status(st) == "active"
	end

	-- Reprise à la connexion : l'étape en cours repart de maintenant (aucun texte d'aide immédiat après une absence).
	function O.resume(st, now)
		if O.active(st) and isnum(now) and now >= 0 then
			st.at = math.floor(now)
		end
	end

	-- Le joueur passe le tutoriel : définitif. Retourne vrai si l'état a changé.
	function O.skip(st)
		if not O.active(st) then
			return false
		end
		st.skip = true
		return true
	end

	-- Vue pour le client (nil si rien à afficher).
	function O.view(st, now)
		if not O.active(st) then
			return nil
		end
		local step = Onboarding.STEPS[st.step]
		if not step then
			return nil
		end
		local stalled = isnum(now) and st.at > 0 and now - st.at > cfg.stepSeconds
		local goal = step.id == "income" and cfg.earnGoal or 0
		return {
			index = st.step,
			total = N,
			id = step.id,
			text = stalled and step.hint or step.text,
			target = step.target,
			stalled = stalled == true,
			prog = goal > 0 and math.min(goal, math.floor(st.prog)) or 0,
			goal = goal,
			seconds = cfg.stepSeconds,
		}
	end

	-- Événement serveur. kind : "tick" (arg = faits { near, hatched, level }), "earn" (arg = pièces versées), "arena" (arg ignoré).
	-- Retourne (avancé, info) : info = "step" | "done" si avancé, sinon la raison ("inactive", "wrong_step", "bad_arg", "bad_now", "dwell", "unmet").
	function O.event(st, kind, arg, now)
		if not O.active(st) then
			return false, "inactive"
		end
		if not isnum(now) or now < 0 then
			return false, "bad_now"
		end
		now = math.floor(now)
		local step = Onboarding.STEPS[st.step]
		if not step or type(kind) ~= "string" or step.kind ~= kind then
			return false, "wrong_step"
		end
		if not isnum(st.at) or st.at <= 0 then
			st.at = now -- première observation : l'étape démarre maintenant
		end
		local met = false
		if kind == "tick" then
			if type(arg) ~= "table" then
				return false, "bad_arg"
			end
			if step.id == "gift" then
				met = arg.near == true
			elseif step.id == "hatch" then
				met = isnum(arg.hatched) and arg.hatched >= 1
			elseif step.id == "house" then
				met = isnum(arg.level) and arg.level >= cfg.houseLevel
			end
		elseif kind == "earn" then
			if not isnum(arg) or arg <= 0 then
				return false, "bad_arg"
			end
			st.prog = math.min(cfg.earnGoal, (isnum(st.prog) and st.prog or 0) + arg)
			met = st.prog >= cfg.earnGoal
		else -- arena : le serveur n'appelle cet événement qu'après avoir accepté le combat
			met = true
		end
		if not met then
			return false, "unmet"
		end
		if now - st.at < cfg.minDwell then
			return false, "dwell"
		end
		st.step = st.step + 1
		st.at = now
		st.prog = 0
		if st.step > N then
			return true, "done"
		end
		return true, "step"
	end

	return O
end

return Onboarding
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">Showcase</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Showcase (idée 3 « Vitrine pet du jour »). Logique PURE, sans service Roblox : le DataStore est injecté.
-- Chaque jour UTC, une espèce de rareté >= minTier (publiée dans Config.PETS) est mise en vitrine, de façon déterministe (même jour = même espèce partout).
-- Le premier joueur qui fait ÉCLORE cette espèce ce jour-là la « possède » : enregistrement DEDIE par jour (UpdateAsync, premier écrit gagne), puis +5 % de
-- revenus pendant 24 h. Garde-fous : un seul bonus actif (jamais cumulé ni prolongé), une vitrine par jour, une par semaine et par joueur, bonus perdu si le
-- propriétaire ne se connecte pas le jour même. Gratuit : aucune monnaie payante, aucun achat. Le nom affiché est assaini ; l'identifiant (userId) reste côté serveur (publicView).
-- Champ de profil : showcase = { last = jour UTC de la dernière vitrine possédée (0 = jamais), ends = fin du bonus en os.time() (0 = aucun) }.
-- Décision utilisateur (2026-11-28) : un œuf ACHETÉ ne peut jamais faire gagner la vitrine. Chaque œuf porte une origine figée à l'octroi (slot.og, voir
-- Showcase.ORIGINS) ; seules les origines listées dans cfg.origins comptent. Origine absente (ancien slot, sac d'œufs, coffre de débordement, boutique payante,
-- offres, packs) = inconnue = exclue. tryClaim refuse toute éclosion dont l'origine n'est pas admise (« notEarned ») AVANT tout appel DataStore.
local Showcase = {}

Showcase.DEFAULTS = {
	minTier = 6, -- rareté minimale d'une espèce de vitrine (Épique)
	bonusPct = 0.05, -- +5 % de revenus
	bonusSeconds = 86400, -- 24 h
	cooldownDays = 7, -- un joueur ne peut être en vitrine qu'une fois par semaine
	nameMax = 20, -- caractères du nom affiché
	retries = 3, -- tentatives DataStore (avec attente croissante)
	storeName = "ChipeOeufs_Showcase_v1",
	fallbackName = "Un dresseur",
	origins = { g = true, c = true }, -- origines admises : g = gagné en jouant (tapis, nids, calendrier, PNJ, quêtes, château, combats), c = boutique en pièces
}

-- Origines d'un œuf (champ slot.og, posé par le serveur au moment de l'octroi, jamais par le client). Absent = inconnu (exclu).
Showcase.ORIGINS = { g = "gagné en jouant", c = "acheté en pièces", r = "payé (argent réel : produit, passe ou rattrapage payant)" }

function Showcase.validOrigin(og)
	return type(og) == "string" and Showcase.ORIGINS[og] ~= nil
end

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function num(v, default)
	if finite(v) and v >= 0 then
		return math.floor(v)
	end
	return default
end

function Showcase.new(Config)
	local cfg = {}
	for k, v in pairs(Showcase.DEFAULTS) do
		cfg[k] = v
	end
	if type(Config) == "table" and type(Config.SHOWCASE) == "table" then
		for k, v in pairs(Config.SHOWCASE) do
			cfg[k] = v
		end
	end
	local M = { cfg = cfg, cache = { day = -1, owner = nil, view = nil }, busy = {} }

	-- L'origine d'un œuf permet-elle de gagner la vitrine ? (jamais un œuf payé ni d'origine inconnue)
	function M.originOk(og)
		return og ~= "r" and Showcase.validOrigin(og) and type(cfg.origins) == "table" and cfg.origins[og] == true
	end

	function M.dayOf(t)
		return math.floor(t / 86400)
	end

	-- Espèces éligibles : index dans Config.PETS, rareté >= minTier, ordre croissant (stable).
	-- Intégration (audit A5) : les espèces d'événement / de saison (champ event) sont exclues : hors de leur fenêtre elles ne sortent d'aucun œuf,
	-- la vitrine serait alors impossible à gagner (et le choix du jour ne dépend pas de la date d'un événement : même résultat partout).
	function M.eligible()
		local list = {}
		local pets = type(Config) == "table" and Config.PETS or {}
		for i, p in ipairs(pets) do
			if type(p) == "table" and finite(p.tier) and p.tier >= cfg.minTier and p.event == nil then
				list[#list + 1] = i
			end
		end
		return list
	end

	-- Générateur de Park-Miller sur un entier (produits < 2^53 : même résultat sous Luau et Lua 5.x).
	local function rawIndex(day, n)
		local x = (math.floor(day) % 2147483646) + 1
		for _ = 1, 3 do
			x = (x * 48271) % 2147483647
		end
		return x % n + 1
	end

	-- Espèce du jour (index dans Config.PETS) ou nil s'il n'y en a aucune. Jamais deux jours de suite la même (si >= 2 espèces).
	function M.pick(day)
		local list = M.eligible()
		local n = #list
		if n == 0 or not finite(day) then
			return nil
		end
		local idx = rawIndex(day, n)
		if n > 1 and idx == rawIndex(day - 1, n) then
			idx = idx % n + 1
		end
		return list[idx]
	end

	-- L'espèce p est-elle en vitrine à l'instant now ?
	function M.featured(p, now)
		if not finite(now) then
			return false
		end
		local sp = M.pick(M.dayOf(now))
		return sp ~= nil and p == sp
	end

	-- Nom affichable : caractères de contrôle retirés, espaces réduits, tronqué proprement (UTF-8), sinon nom de secours.
	function M.sanitizeName(name)
		if type(name) ~= "string" then
			return cfg.fallbackName
		end
		local s = string.gsub(name, "[%c]", "")
		s = string.gsub(s, "%s+", " ")
		s = string.match(s, "^%s*(.-)%s*$") or ""
		if not utf8.len(s) then
			s = string.gsub(s, "[\128-\255]", "")
		end
		local len = utf8.len(s)
		if len and len > cfg.nameMax then
			s = string.sub(s, 1, (utf8.offset(s, cfg.nameMax + 1) or (#s + 1)) - 1)
		end
		if s == "" then
			return cfg.fallbackName
		end
		return s
	end

	-- Assainit le champ de profil (idempotent : relire un profil assaini ne change rien). Valeurs neuves si absent ou corrompu ; jamais de réinitialisation d'un champ valide.
	function M.sanitize(saved, now)
		local sc = type(saved) == "table" and saved or {}
		local today = M.dayOf(now)
		return {
			last = math.min(num(sc.last, 0), today),
			ends = math.min(num(sc.ends, 0), math.floor(now) + cfg.bonusSeconds), -- une fin trop lointaine (horloge ou donnée altérée) est ramenée à 24 h
		}
	end

	function M.multiplier(sc, now)
		if type(sc) == "table" and finite(sc.ends) and now < sc.ends and sc.ends - now <= cfg.bonusSeconds then
			return 1 + cfg.bonusPct
		end
		return 1
	end

	-- Le joueur peut-il posséder la vitrine de ce jour ? (ok, raison) ; raisons : active, sameDay, cooldown.
	function M.canOwn(sc, day, now)
		if type(sc) ~= "table" then
			return false, "invalid"
		end
		if finite(sc.ends) and now < sc.ends then
			return false, "active"
		end
		local last = num(sc.last, 0)
		if last == day then
			return false, "sameDay"
		end
		if last > 0 and day - last < cfg.cooldownDays then
			return false, "cooldown"
		end
		return true, nil
	end

	-- Accorde le bonus (24 h à partir de maintenant, jamais prolongé ni cumulé). Retourne true si accordé.
	function M.grant(sc, day, now)
		if not M.canOwn(sc, day, now) then
			return false
		end
		sc.last = day
		sc.ends = math.floor(now) + cfg.bonusSeconds
		return true
	end

	function M.key(day)
		return "Showcase_" .. tostring(math.floor(day))
	end

	-- Fonction de transformation de UpdateAsync : premier écrit gagne. nil = annuler (une vitrine valide existe déjà pour ce jour).
	function M.claimTransform(rec, day, sp, userId, name)
		if type(rec) == "table" and rec.d == day and finite(rec.u) and finite(rec.sp) then
			return nil
		end
		return { v = 1, d = day, sp = sp, u = userId, n = M.sanitizeName(name) }
	end

	-- Vue publique pour l'affichage du hub : espèce et nom SEULEMENT (jamais d'identifiant).
	function M.publicView(rec, day)
		local sp = M.pick(day)
		local view = { day = day, species = sp, claimed = false, name = nil }
		if type(rec) == "table" and rec.d == day and rec.sp == sp and type(rec.n) == "string" then
			view.claimed = true
			view.name = M.sanitizeName(rec.n)
		end
		return view
	end

	local function retry(fn, pause)
		local lastErr = nil
		for attempt = 1, cfg.retries do
			local ok, res = pcall(fn)
			if ok then
				return true, res
			end
			lastErr = res
			if attempt < cfg.retries and pause then
				pause(attempt * 2)
			end
		end
		return false, lastErr
	end

	-- Réclamation à l'éclosion de l'espèce p. store = DataStore (UpdateAsync/GetAsync). player = { userId, name, og } (og = origine figée de l'œuf éclos).
	-- Retourne : "notEarned" (œuf acheté ou d'origine inconnue : aucun appel DataStore) | "notFeatured" | "blocked:<raison>" | "taken" | "busy" | "error" | "won" (le bonus est alors déjà accordé dans sc).
	function M.tryClaim(store, sc, p, player, now, pause)
		if type(player) ~= "table" or not M.originOk(player.og) then
			return "notEarned"
		end
		local day = M.dayOf(now)
		local sp = M.pick(day)
		if sp == nil or p ~= sp then
			return "notFeatured"
		end
		local ok, why = M.canOwn(sc, day, now)
		if not ok then
			return "blocked:" .. tostring(why)
		end
		if M.cache.day == day and M.cache.owner ~= nil and M.cache.owner ~= player.userId then
			return "taken" -- déjà connu sur ce serveur : aucun appel DataStore de plus
		end
		if M.busy[player.userId] then
			return "busy"
		end
		M.busy[player.userId] = true
		local done, res = retry(function()
			return store:UpdateAsync(M.key(day), function(rec)
				return M.claimTransform(rec, day, sp, player.userId, player.name)
			end)
		end, pause)
		M.busy[player.userId] = nil
		if not done then
			return "error" -- aucun bonus sans confirmation du DataStore
		end
		-- UpdateAsync renvoie la valeur finale ; si la transformation a annulé, on relit l'enregistrement gagnant.
		local rec = res
		if rec == nil then
			local got, cur = retry(function()
				return store:GetAsync(M.key(day))
			end, pause)
			rec = got and cur or nil
		end
		if type(rec) ~= "table" or rec.d ~= day then
			return "error"
		end
		M.cache = { day = day, owner = rec.u, view = M.publicView(rec, day) }
		if rec.u ~= player.userId then
			return "taken"
		end
		if not M.grant(sc, day, now) then
			return "blocked:race" -- le profil a changé pendant l'appel (autre bonus accordé entre-temps) : rien n'est accordé
		end
		return "won"
	end

	-- À la connexion : si ce joueur a gagné la vitrine du jour sans que son profil l'ait enregistrée (arrêt serveur), le bonus est accordé UNE fois, ce jour-là seulement.
	function M.onLogin(store, sc, player, now, pause)
		local day = M.dayOf(now)
		local done, rec = retry(function()
			return store:GetAsync(M.key(day))
		end, pause)
		if not done then
			return "error"
		end
		if type(rec) ~= "table" or rec.d ~= day then
			return "none"
		end
		M.cache = { day = day, owner = rec.u, view = M.publicView(rec, day) }
		if rec.u ~= player.userId then
			return "none"
		end
		if M.grant(sc, day, now) then
			return "granted"
		end
		return "none"
	end

	return M
end

return Showcase
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">UiStyle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/UiStyle (graphismes 6 : style d'interface commun). Données et calculs PURS, sans service Roblox ni Color3 :
-- rayons des coins, ombre légère, polices, tailles de texte, espacements, palette (triplets RGB 0-255) et couples texte / fond dont le contraste WCAG
-- doit rester >= 4,5:1 (vérifié par les tests). Les panneaux (boutique, calendrier, bestiaire, bonus, kiosque, menu : tous dans le même cadre de
-- Client.client.lua) lisent ces constantes ; leur logique et leurs remotes ne changent pas. Icônes : une seule famille, celle du lot 27 (Config.ICONS).
-- Style : compatible lupa (affectations composées et saut de boucle évités), gardes de type avant comparaison.
local UiStyle = {}

-- Coins arrondis (px).
UiStyle.RADIUS = { panel = 18, card = 14, button = 10, icon = 12, chip = 8, pill = 26 }

-- Ombre légère portée sous les cartes et le cadre des panneaux : bandes décalées (bas et droite), noires, très transparentes.
UiStyle.SHADOW = { offset = 4, transparency = 0.72, color = { 0, 0, 0 } }

-- Polices (noms d'Enum.Font) : titres, texte courant, descriptions.
UiStyle.FONTS = { title = "GothamBlack", body = "GothamBold", desc = "Gotham" }

-- Tailles de texte (px), du plus grand au plus petit.
UiStyle.TEXT = { title = 22, heading = 18, tab = 14, rowTitle = 15, button = 14, body = 13, desc = 12, small = 11 }

-- Espacements (px).
UiStyle.SPACING = { xs = 4, sm = 6, md = 10, lg = 16 }

-- Bordures.
UiStyle.STROKE = { panel = 2, button = 2, glossy = 3 }

-- Palette commune (RGB 0-255). Les valeurs historiques de Client.client.lua sont gardées ; seul le texte des boutons désactivés est éclairci (contraste).
UiStyle.COLORS = {
	bg = { 15, 42, 27 },
	panel = { 29, 77, 51 },
	pill = { 10, 30, 20 },
	yellow = { 255, 210, 63 },
	text = { 244, 255, 246 },
	muted = { 159, 199, 173 },
	red = { 255, 107, 107 },
	green = { 91, 227, 125 },
	dis = { 75, 91, 81 },
	dark = { 43, 34, 0 },
	disText = { 205, 218, 210 },
}

-- Couples (texte, fond) réellement utilisés par les panneaux : contraste >= MIN_CONTRAST exigé.
UiStyle.MIN_CONTRAST = 4.5
UiStyle.PAIRS = {
	{ "text", "bg" }, { "text", "panel" }, { "text", "pill" }, { "text", "dis" },
	{ "muted", "bg" }, { "muted", "panel" }, { "muted", "pill" },
	{ "yellow", "bg" }, { "yellow", "panel" }, { "yellow", "pill" },
	{ "green", "bg" }, { "green", "panel" }, { "green", "pill" },
	{ "dark", "yellow" }, { "dark", "green" }, { "dark", "red" },
	{ "disText", "dis" },
}

local function isRgb(c)
	return type(c) == "table" and type(c[1]) == "number" and type(c[2]) == "number" and type(c[3]) == "number"
end

-- Luminance relative WCAG d'un triplet RGB 0-255.
function UiStyle.luminance(c)
	if not isRgb(c) then
		return 0
	end
	local function lin(v)
		local x = math.min(255, math.max(0, v)) / 255
		if x <= 0.03928 then
			return x / 12.92
		end
		return ((x + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * lin(c[1]) + 0.7152 * lin(c[2]) + 0.0722 * lin(c[3])
end

-- Rapport de contraste WCAG (1 à 21) entre deux triplets.
function UiStyle.contrast(a, b)
	local la, lb = UiStyle.luminance(a), UiStyle.luminance(b)
	return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
end

-- Couples sous le seuil : liste { fg, bg, ratio } (vide = conforme).
function UiStyle.failingPairs()
	local bad = {}
	for _, p in ipairs(UiStyle.PAIRS) do
		local fg, bg = UiStyle.COLORS[p[1]], UiStyle.COLORS[p[2]]
		local r = (isRgb(fg) and isRgb(bg)) and UiStyle.contrast(fg, bg) or 0
		if r < UiStyle.MIN_CONTRAST then
			bad[#bad + 1] = { p[1], p[2], r }
		end
	end
	return bad
end

-- Palette convertie (Color3 injecté : Color3.fromRGB). Retourne { nom = Color3 }.
function UiStyle.palette(Color3)
	local out = {}
	for k, c in pairs(UiStyle.COLORS) do
		out[k] = Color3.fromRGB(c[1], c[2], c[3])
	end
	return out
end

-- Police d'un rôle (Enum injecté) : Enum.Font[nom], repli GothamBold.
function UiStyle.font(Enum, role)
	local name = UiStyle.FONTS[role] or UiStyle.FONTS.body
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return Enum.Font.GothamBold
end

-- Famille d'icônes unique : une clé n'est acceptée que si elle appartient à Config.ICONS (lot 27). Retourne la clé ou nil (l'appelant garde son emoji).
function UiStyle.icon(Config, key)
	if type(key) == "string" and type(Config) == "table" and type(Config.ICONS) == "table" and Config.ICONS[key] ~= nil then
		return key
	end
	return nil
end

-- Description de l'ombre d'un cadre (bandes à poser comme enfants, hors de la surface du cadre) : liste { position = {sx, ox, sy, oy}, size = {sx, ox, sy, oy} }.
-- kind = "panel" (bas et droite) ou "card" (bas seulement : la liste verticale laisse SPACING.sm entre deux cartes).
function UiStyle.shadowStrips(kind)
	local o = UiStyle.SHADOW.offset
	local strips = { { position = { 0, o, 1, 0 }, size = { 1, -o, 0, o } } }
	if kind == "panel" then
		strips[2] = { position = { 1, 0, 0, o }, size = { 0, o, 1, 0 } }
	end
	return strips
end

return UiStyle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">Music</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Music (graphismes 9 : musique par zone). Logique PURE, sans service Roblox.
-- Une piste par zone (hub = village et parcelles, arène, château), volume bas, coupée pendant un combat (interface de combat ouverte), fondus enchaînés,
-- respect de Config.SOUNDS_ENABLED et du volume général du menu Plus (0 = muet). Les identifiants de Config.MUSIC sont VIDES tant qu'aucune piste approuvée
-- n'existe : le système est prêt mais muet (aucun Sound créé). On n'invente aucun identifiant : une piste doit être de la forme « rbxassetid://<chiffres> ».
-- Style : compatible lupa (affectations composées et saut de boucle évités), gardes de type avant comparaison.
local Music = {}

Music.ZONES = { "hub", "arena", "castle" }
-- Zone d'éclairage (Config.lightingZoneAt) -> zone musicale.
Music.FROM_LIGHTING = { hub = "hub", plots = "hub", lobby = "hub", arena = "arena", castle = "castle" }
Music.MAX_VOLUME = 0.3 -- plafond dur : la musique reste en fond

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Identifiant de piste valide (rbxassetid://<chiffres>, pas 0) ou nil.
function Music.trackId(id)
	if type(id) ~= "string" then
		return nil
	end
	local digits = string.match(id, "^rbxassetid://(%d+)$")
	if digits and digits ~= "0" and not string.match(digits, "^0+$") then
		return id
	end
	return nil
end

-- Réglages assainis : { enabled, fade, volume, tracks = { zone = id|nil }, interval }.
function Music.cfg(Config)
	local m = type(Config) == "table" and type(Config.MUSIC) == "table" and Config.MUSIC or {}
	local tracks = {}
	local src = type(m.tracks) == "table" and m.tracks or {}
	for _, z in ipairs(Music.ZONES) do
		tracks[z] = Music.trackId(src[z])
	end
	local vol = finite(m.volume) and m.volume or 0.15
	return {
		enabled = m.enabled ~= false,
		fade = finite(m.fade) and m.fade > 0 and m.fade or 2.5,
		volume = math.min(Music.MAX_VOLUME, math.max(0, vol)),
		interval = finite(m.interval) and m.interval > 0 and m.interval or 0.5,
		tracks = tracks,
	}
end

-- Zone musicale d'une zone d'éclairage (repli hub).
function Music.zoneOf(lightingZone)
	return Music.FROM_LIGHTING[lightingZone] or "hub"
end

-- Le système a-t-il au moins une piste ? (sinon : prêt mais muet, aucun Sound créé)
function Music.hasTracks(Config)
	local c = Music.cfg(Config)
	for _, z in ipairs(Music.ZONES) do
		if c.tracks[z] then
			return true
		end
	end
	return false
end

-- Volume cible de la piste `zone` : ctx = { zone (zone courante), battle (bool), master (0..1), soundsEnabled (bool) }.
function Music.target(Config, zone, ctx)
	local c = Music.cfg(Config)
	if not c.enabled or type(ctx) ~= "table" or ctx.soundsEnabled == false or ctx.battle == true then
		return 0
	end
	if zone ~= ctx.zone or not c.tracks[zone] then
		return 0
	end
	local master = finite(ctx.master) and math.min(1, math.max(0, ctx.master)) or 1
	return c.volume * master
end

-- Un pas de fondu : rapproche `current` de `target` d'au plus (plafond / fade) x dt. Jamais de dépassement, valeurs bornées à [0, MAX_VOLUME].
function Music.step(current, target, dt, fade)
	local cur = finite(current) and current or 0
	local tg = finite(target) and math.min(Music.MAX_VOLUME, math.max(0, target)) or 0
	local d = finite(dt) and dt > 0 and dt or 0
	local f = finite(fade) and fade > 0 and fade or 2.5
	local maxStep = Music.MAX_VOLUME / f * d
	if cur < tg then
		return math.min(tg, cur + maxStep)
	end
	return math.max(tg, cur - maxStep)
end

return Music
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">EggAura</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/EggAura (lot graphismes 4 : halos d'œufs et bulles de protection). Logique PURE, sans service Roblox.
-- Un halo lumineux par rareté (couleur = Config.TIERS[tier].color, pulsation lente, plus visible quand la rareté monte) sur les œufs du tapis, portés et posés,
-- et une bulle transparente sur les œufs protégés (bouclier d'une base, nid surveillé par un gardien). AUCUNE PointLight : une Part néon (halo) ou champ de
-- force (bulle) par œuf retenu, au plus `maxHalos` / `maxBubbles` (plafonds réduits sur mobile), les plus proches de la caméra à moins de `range` studs.
-- Le script client EggAura.client.lua ne fait qu'appliquer : sélection, styles et gestion du réservoir d'objets (sans fuite) sont ici et testés.
-- Style : compatible lupa (affectations composées et saut de boucle évités), aucune comparaison sans garde de type.
local EggAura = {}

EggAura.DEFAULTS = {
	enabled = true,
	range = 110, -- studs : au-delà, ni halo ni bulle
	maxHalos = 24,
	maxHalosMobile = 10,
	maxBubbles = 12,
	maxBubblesMobile = 6,
	interval = 0.25, -- s entre deux sélections (mobile : intervalMobile)
	intervalMobile = 0.5,
	frameStep = 1 / 30, -- s entre deux mises à jour de pulsation (mobile : frameStepMobile)
	frameStepMobile = 1 / 10,
	halo = {
		scaleMin = 1.22, -- taille du halo / taille de l'œuf, rareté 1 -> rareté max
		scaleMax = 1.7,
		transparencyMax = 0.9, -- rareté 1 : à peine visible
		transparencyMin = 0.6, -- rareté max : bien visible
		amplitudeMin = 0.03, -- amplitude de pulsation (transparence)
		amplitudeMax = 0.16,
		periodMax = 3.6, -- s : pulsation lente (rareté 1) -> un peu plus vive (rareté max), jamais sous 2 s
		periodMin = 2.4,
		material = "Neon",
	},
	bubble = {
		scale = 2.0, -- diamètre de la bulle / plus grande dimension de l'œuf
		transparency = 0.2,
		material = "ForceField", -- champ de force animé : bien visible, translucide
		shieldColor = { 140, 215, 255 }, -- bouclier d'une base
		guardColor = { 255, 214, 120 }, -- nid surveillé par un gardien
	},
}

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function lerp(a, b, k)
	return a + (b - a) * k
end

-- Config fusionné (Config.EGG_AURA par-dessus DEFAULTS, sous-tables comprises).
function EggAura.cfg(Config)
	local out = {}
	for k, v in pairs(EggAura.DEFAULTS) do
		if type(v) == "table" then
			local sub = {}
			for k2, v2 in pairs(v) do
				sub[k2] = v2
			end
			out[k] = sub
		else
			out[k] = v
		end
	end
	local src = type(Config) == "table" and Config.EGG_AURA or nil
	if type(src) == "table" then
		for k, v in pairs(src) do
			if type(v) == "table" and type(out[k]) == "table" then
				for k2, v2 in pairs(v) do
					out[k][k2] = v2
				end
			else
				out[k] = v
			end
		end
	end
	return out
end

local function tierCount(Config)
	return (type(Config) == "table" and type(Config.TIERS) == "table" and #Config.TIERS > 0) and #Config.TIERS or 10
end

-- Position de la rareté entre 0 (rareté 1) et 1 (rareté max).
function EggAura.rank(Config, tier)
	local n = tierCount(Config)
	if not finite(tier) or n <= 1 then
		return 0
	end
	local t = math.min(n, math.max(1, math.floor(tier)))
	return (t - 1) / (n - 1)
end

-- Style du halo d'un œuf de rareté `tier` : { color, scale, transparency, amplitude, period, material }.
function EggAura.halo(Config, tier)
	local c = EggAura.cfg(Config)
	local h = c.halo
	local k = EggAura.rank(Config, tier)
	local n = tierCount(Config)
	local t = finite(tier) and math.min(n, math.max(1, math.floor(tier))) or 1
	local def = type(Config) == "table" and type(Config.TIERS) == "table" and Config.TIERS[t] or nil
	return {
		tier = t,
		color = def and def.color or nil,
		scale = lerp(h.scaleMin, h.scaleMax, k),
		transparency = lerp(h.transparencyMax, h.transparencyMin, k),
		amplitude = lerp(h.amplitudeMin, h.amplitudeMax, k),
		period = math.max(2, lerp(h.periodMax, h.periodMin, k)),
		material = h.material,
	}
end

-- Transparence du halo à l'instant `t` (s) : base + amplitude x (0,5 + 0,5 sin), bornée à [0, 1]. `phase` désynchronise les œufs.
function EggAura.alpha(style, t, phase)
	if type(style) ~= "table" or not finite(t) then
		return 1
	end
	local ph = finite(phase) and phase or 0
	local v = style.transparency + style.amplitude * (0.5 + 0.5 * math.sin(2 * math.pi * t / style.period + ph))
	return math.min(1, math.max(0, v))
end

-- Style de la bulle : kind = "shield" (bouclier de base) ou "guard" (nid surveillé). { color = {r, g, b}, scale, transparency, material }.
function EggAura.bubble(Config, kind)
	local b = EggAura.cfg(Config).bubble
	return { color = kind == "guard" and b.guardColor or b.shieldColor, scale = b.scale, transparency = b.transparency, material = b.material, kind = kind == "guard" and "guard" or "shield" }
end

-- Diamètre (studs) du halo ou de la bulle d'un œuf : plus grande dimension (Part racine, ou hauteur du modèle de la rareté via Config.eggHeight) x échelle.
function EggAura.diameter(Config, tier, sizeMax, kind)
	local base = finite(sizeMax) and sizeMax > 0 and sizeMax or 3.2
	if type(Config) == "table" and type(Config.eggHeight) == "function" then
		local ok, h = pcall(Config.eggHeight, tier)
		if ok and finite(h) and h > base then
			base = h
		end
	end
	if kind == "bubble" then
		return base * EggAura.cfg(Config).bubble.scale
	end
	return base * EggAura.halo(Config, tier).scale
end

-- Plafonds et cadences selon l'appareil.
function EggAura.caps(Config, mobile)
	local c = EggAura.cfg(Config)
	if mobile then
		return { halos = c.maxHalosMobile, bubbles = c.maxBubblesMobile, interval = c.intervalMobile, frameStep = c.frameStepMobile, range = c.range }
	end
	return { halos = c.maxHalos, bubbles = c.maxBubbles, interval = c.interval, frameStep = c.frameStep, range = c.range }
end

-- Sélection : items = { { key, x, y, z, tier, protect = nil | "shield" | "guard" } }, cam = { x, y, z }.
-- Retourne { halos = { item... }, bubbles = { item... } } : les plus proches d'abord, à moins de caps.range, au plus caps.halos / caps.bubbles.
function EggAura.select(items, cam, caps)
	local out = { halos = {}, bubbles = {} }
	if type(items) ~= "table" or type(cam) ~= "table" or type(caps) ~= "table" then
		return out
	end
	local cx, cy, cz = cam.x, cam.y, cam.z
	if not (finite(cx) and finite(cy) and finite(cz)) then
		return out
	end
	local range = finite(caps.range) and caps.range or 0
	local near = {}
	for _, it in ipairs(items) do
		if type(it) == "table" and finite(it.x) and finite(it.y) and finite(it.z) and finite(it.tier) then
			local dx, dy, dz = it.x - cx, it.y - cy, it.z - cz
			local d2 = dx * dx + dy * dy + dz * dz
			if d2 <= range * range then
				near[#near + 1] = { it = it, d2 = d2 }
			end
		end
	end
	table.sort(near, function(a, b)
		if a.d2 ~= b.d2 then
			return a.d2 < b.d2
		end
		return tostring(a.it.key) < tostring(b.it.key)
	end)
	local maxH = finite(caps.halos) and caps.halos or 0
	local maxB = finite(caps.bubbles) and caps.bubbles or 0
	for _, e in ipairs(near) do
		if #out.halos < maxH then
			out.halos[#out.halos + 1] = e.it
		end
		if (e.it.protect == "shield" or e.it.protect == "guard") and #out.bubbles < maxB then
			out.bubbles[#out.bubbles + 1] = e.it
		end
	end
	return out
end

-- Gestionnaire d'objets (réservoir) : factory = { make(kind) -> obj, hide(obj), destroy(obj) }. kind = "halo" | "bubble".
-- sync(sel) attache un objet à chaque œuf retenu (réutilisé si l'œuf l'avait déjà), rend au réservoir ceux des œufs disparus, et détruit l'excédent du
-- réservoir au-delà de `poolMax` (pas de fuite : objets vivants <= plafonds, réservoir <= poolMax). Retourne { [kind] = { [key] = obj } }.
function EggAura.newManager(factory, poolMax)
	local M = { live = { halo = {}, bubble = {} }, pool = { halo = {}, bubble = {} }, created = 0, destroyed = 0, poolMax = finite(poolMax) and poolMax or 8 }
	local function take(kind)
		local p = M.pool[kind]
		local n = #p
		if n > 0 then
			local obj = p[n]
			p[n] = nil
			return obj
		end
		M.created = M.created + 1
		return factory.make(kind)
	end
	local function give(kind, obj)
		local p = M.pool[kind]
		if #p < M.poolMax then
			factory.hide(obj)
			p[#p + 1] = obj
		else
			M.destroyed = M.destroyed + 1
			factory.destroy(obj)
		end
	end
	local function syncKind(kind, list)
		local want = {}
		for _, it in ipairs(list or {}) do
			want[it.key] = it
		end
		local live = M.live[kind]
		for key, obj in pairs(live) do
			if not want[key] then
				live[key] = nil
				give(kind, obj)
			end
		end
		for key in pairs(want) do
			if not live[key] then
				live[key] = take(kind)
			end
		end
	end
	function M.sync(sel)
		syncKind("halo", type(sel) == "table" and sel.halos or nil)
		syncKind("bubble", type(sel) == "table" and sel.bubbles or nil)
		return M.live
	end
	function M.count(kind)
		local n = 0
		for _ in pairs(M.live[kind]) do
			n = n + 1
		end
		return n
	end
	-- Tout rendre (désactivation) : objets vivants détruits, réservoir vidé.
	function M.clear()
		for _, kind in ipairs({ "halo", "bubble" }) do
			for key, obj in pairs(M.live[kind]) do
				M.live[kind][key] = nil
				M.destroyed = M.destroyed + 1
				factory.destroy(obj)
			end
			for i = #M.pool[kind], 1, -1 do
				M.destroyed = M.destroyed + 1
				factory.destroy(M.pool[kind][i])
				M.pool[kind][i] = nil
			end
		end
	end
	return M
end

return EggAura
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX58"><Properties><string name="Name">EvolveLayout</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/EvolveLayout   (interface « ✨ Évoluer » : logique PURE, testée par tests/evolveui.luau)
-- Module pur (aucune instance Roblox, aucun require ; `Evolution` est INJECTÉ en argument) : liste des pets évoluables, aperçu des gains, doublons
-- sacrifiés, machine d'états de la confirmation en DEUX étapes, retour visuel court (<= 1,2 s), états refusés, disposition (cibles >= 44 px), contrastes.
-- Le client N'ENVOIE QUE l'emplacement (evoPreview) puis { i, maxCost } (evolve) : doublons, coût et interdits restent décidés par le SERVEUR
-- (Evolution.plan). Ici : estimation de confort (même règle pure qu'Evolution), jamais une autorité. Config.EVOLUTION.enabled = false => « bientôt »,
-- aucune action possible, aucun message envoyé. Pas de += / -= / continue, pas de math.atan2 (lanceur lupa).
local EvolveLayout = {}

EvolveLayout.MIN_TOUCH = 44
EvolveLayout.ROW_H = 52
EvolveLayout.CONFIRM_SECONDS = 4 -- la 2e étape expire : un appui isolé ne fait jamais évoluer
EvolveLayout.SEND_TIMEOUT = 6 -- sans réponse du serveur : retour à l'état « prêt » (aperçu redemandé)
EvolveLayout.FX_SECONDS = 1.0
EvolveLayout.MAX_FX = 1.2
EvolveLayout.PREVIEW_COOLDOWN = 0.35 -- au plus une demande d'aperçu toutes les 0,35 s côté client
EvolveLayout.MAX_ROWS = 40
EvolveLayout.DEFAULT_VIEWPORT = { w = 640, h = 360 }
EvolveLayout.MIN_VIEWPORT = { w = 240, h = 320 }

EvolveLayout.UI = {
	panel = { 24, 38, 46 }, panelStroke = { 255, 210, 63 }, row = { 44, 60, 70 }, rowSel = { 70, 94, 110 }, text = { 250, 247, 238 }, muted = { 188, 204, 208 },
	ok = { 96, 232, 120 }, warn = { 255, 196, 60 }, bad = { 255, 140, 140 }, soon = { 255, 226, 140 },
	btnOn = { 255, 210, 63 }, btnOff = { 70, 78, 86 }, btnConfirm = { 255, 159, 28 }, btnCancel = { 255, 99, 99 },
	darkText = { 30, 24, 0 }, offText = { 226, 228, 236 }, cancelText = { 40, 8, 8 },
}

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

local function rect(x, y, w, h)
	return { x = x, y = y, w = w, h = h }
end

---------------------------------------------------------------- configuration et gains

local function cfgOf(Config)
	return type(Config) == "table" and type(Config.EVOLUTION) == "table" and Config.EVOLUTION or nil
end

function EvolveLayout.enabled(Config)
	local cfg = cfgOf(Config)
	return cfg ~= nil and cfg.enabled == true
end

-- Pourcentage entier d'un multiplicateur : 1,15 -> 15 ; invalide -> 0.
function EvolveLayout.pct(mul)
	if not isNum(mul) then
		return 0
	end
	return math.floor((mul - 1) * 100 + 0.5)
end

-- Gains affichés de la forme 2 d'un pet { p, s, m, f } : revenu avant / après (par seconde) et pourcentages. nil si le pet est inconnu.
function EvolveLayout.gains(Config, sl)
	local cfg = cfgOf(Config)
	if not cfg or type(sl) ~= "table" or type(Config.PETS) ~= "table" or Config.PETS[sl.p] == nil or type(Config.petIncome) ~= "function" then
		return nil
	end
	local before = Config.petIncome(sl.p, sl.s, sl.m)
	local after = Config.petIncome(sl.p, sl.s, sl.m, 2)
	return { incomeBefore = before, incomeAfter = after, incomePct = EvolveLayout.pct(cfg.incomeMul), powerPct = EvolveLayout.pct(cfg.powerMul) }
end

---------------------------------------------------------------- liste des pets évoluables

local function tierOf(Config, sl)
	local def = type(Config.PETS) == "table" and Config.PETS[sl.p] or nil
	return def and def.tier or 1
end

local function tierName(Config, tier)
	local t = type(Config.TIERS) == "table" and Config.TIERS[tier] or nil
	return t and t.name or ("Rareté " .. tostring(tier))
end

-- Vue de l'état du joueur pour les règles pures d'Evolution : { slots, equip, battle = { team } } ; la défense PvP n'est pas envoyée au client (le serveur tranche).
local function dataOf(state)
	local st = type(state) == "table" and state or {}
	local team = type(st.battle) == "table" and type(st.battle.team) == "table" and st.battle.team or {}
	return { slots = type(st.slots) == "table" and st.slots or {}, equip = type(st.equip) == "table" and st.equip or {}, battle = { team = team } }
end

local function capOf(state)
	local c = type(state) == "table" and state.cap
	if isNum(c) and c >= 1 then
		return math.floor(c)
	end
	return 0
end

-- Estimation (même règle pure que le serveur, sans la défense PvP ni les pièces) pour l'emplacement i : { ok, code, found, need, sac }.
function EvolveLayout.estimate(Config, E, state, i)
	local cfg = cfgOf(Config)
	local need = cfg and cfg.sacrifices or 3
	if type(E) ~= "table" or not cfg then
		return { ok = false, code = "disabled", need = need }
	end
	local d, cap = dataOf(state), capOf(state)
	local ok, code = E.targetCheck(Config, d, i, cap)
	if not ok then
		return { ok = false, code = code, need = need }
	end
	local sac, found = E.pickSacrifices(Config, d, i, cap)
	if not sac then
		return { ok = false, code = "dupes", found = found or 0, need = need }
	end
	return { ok = true, code = nil, sac = sac, need = need }
end

-- Liste des pets de la base : { i, p, name, emoji, tier, tierName, form, status, code, found, need, income, incomeAfter, tag }.
--   status : "ready" (évolution possible d'après l'estimation), "dupes" (pas assez de doublons), "locked" (interdit : suiveur, équipe, taille, mutation...),
--   "done" (déjà en forme 2). Ordre : prêts d'abord, puis doublons manquants, interdits, forme 2 ; à égalité rareté décroissante puis indice.
function EvolveLayout.list(Config, E, state)
	local rows = {}
	local st = type(state) == "table" and state or {}
	local slots = type(st.slots) == "table" and st.slots or {}
	local cap = capOf(st)
	for i = 1, math.min(cap, EvolveLayout.MAX_ROWS) do
		local sl = slots[i]
		if type(sl) == "table" and sl.k == "p" and type(Config.PETS) == "table" and Config.PETS[sl.p] ~= nil then
			local def = Config.PETS[sl.p]
			local form = (sl.f == 2) and 2 or 1
			local row = { i = i, p = sl.p, name = tostring(def.name or "?"), emoji = tostring(def.emoji or "?"), tier = tierOf(Config, sl), form = form, size = sl.s, mut = sl.m }
			row.tierName = tierName(Config, row.tier)
			local g = EvolveLayout.gains(Config, sl)
			row.income = g and g.incomeBefore or 0
			row.incomeAfter = g and g.incomeAfter or 0
			if form == 2 then
				row.status, row.code, row.tag = "done", "already", "★2"
				row.income = g and g.incomeAfter or 0
			else
				local est = EvolveLayout.estimate(Config, E, st, i)
				row.need, row.found = est.need, est.found
				if est.ok then
					row.status, row.tag = "ready", "✨ Prêt"
				elseif est.code == "dupes" then
					row.status, row.code, row.tag = "dupes", "dupes", "Doublons " .. tostring(est.found or 0) .. "/" .. tostring(est.need)
				else
					row.status, row.code, row.tag = "locked", est.code, "🔒"
				end
			end
			rows[#rows + 1] = row
		end
	end
	local rank = { ready = 1, dupes = 2, locked = 3, done = 4 }
	table.sort(rows, function(a, b)
		if rank[a.status] ~= rank[b.status] then
			return rank[a.status] < rank[b.status]
		end
		if a.tier ~= b.tier then
			return a.tier > b.tier
		end
		return a.i < b.i
	end)
	return rows
end

function EvolveLayout.countReady(rows)
	local n = 0
	for _, r in ipairs(type(rows) == "table" and rows or {}) do
		if r.status == "ready" then
			n = n + 1
		end
	end
	return n
end

-- Texte d'en-tête : « bientôt » quand la fonction est coupée ; sinon règle courte et nombre de pets prêts.
function EvolveLayout.header(Config, rows)
	local cfg = cfgOf(Config)
	if not cfg or cfg.enabled ~= true then
		return { soon = true, title = "✨ Évolution", subtitle = "Bientôt disponible : fais évoluer tes pets en forme 2.", rule = "" }
	end
	local ready = EvolveLayout.countReady(rows)
	local rule = (cfg.sacrifices or 3) .. " doublons de même rareté + " .. math.floor((cfg.costSeconds or 300) / 60 + 0.5) .. " min de revenus"
	local sub
	if #(rows or {}) == 0 then
		sub = "Fais d'abord éclore des pets."
	elseif ready == 0 then
		sub = "Aucun pet prêt : il te faut " .. (cfg.sacrifices or 3) .. " doublons de la même rareté."
	else
		sub = ready == 1 and "1 pet prêt à évoluer." or (ready .. " pets prêts à évoluer.")
	end
	return { soon = false, title = "✨ Évolution", subtitle = sub, rule = rule }
end

---------------------------------------------------------------- textes de refus

-- Message d'un code de refus (celui du serveur : Evolution.REFUSE) ; `view` ajoute le nombre de doublons trouvés ou le prix.
function EvolveLayout.refuseText(E, code, view)
	local R = type(E) == "table" and type(E.REFUSE) == "table" and E.REFUSE or {}
	if code == "dupes" and type(view) == "table" and isNum(view.found) and isNum(view.need) then
		return "Doublons : " .. math.floor(view.found) .. "/" .. math.floor(view.need) .. ". Il faut " .. math.floor(view.need) .. " doublons de la même rareté (jamais le dernier exemplaire d'une espèce)."
	elseif code == "coins" and type(view) == "table" and isNum(view.cost) then
		return "Pas assez de pièces : il en faut " .. math.floor(view.cost) .. " (5 min de revenus)."
	end
	return R[code] or R.slot or "Choisis un pet de ta base."
end

---------------------------------------------------------------- doublons sacrifiés (choix du serveur, affichage et vérification côté client)

-- Pastilles des doublons : { { i, emoji, name, tierName } } pour la liste `sac` de l'aperçu du serveur.
function EvolveLayout.sacChips(Config, state, sac)
	local out = {}
	local slots = type(state) == "table" and type(state.slots) == "table" and state.slots or {}
	for _, j in ipairs(type(sac) == "table" and sac or {}) do
		local sl = slots[j]
		local def = type(sl) == "table" and type(Config.PETS) == "table" and Config.PETS[sl.p] or nil
		if def then
			out[#out + 1] = { i = j, emoji = tostring(def.emoji or "?"), name = tostring(def.name or "?"), tierName = tierName(Config, def.tier or 1) }
		else
			out[#out + 1] = { i = j, emoji = "?", name = "?", tierName = "" }
		end
	end
	return out
end

-- Vérification de confort de la liste de doublons proposée par le serveur (jamais une autorité) : exactement `need` emplacements distincts, tous des pets de
-- la même rareté que le pet visé, jamais le pet visé lui-même. Retourne (true) ou (false, motif).
function EvolveLayout.validateSelection(Config, state, i, sac, need)
	local slots = type(state) == "table" and type(state.slots) == "table" and state.slots or {}
	local target = slots[i]
	if type(target) ~= "table" or target.k ~= "p" or type(Config.PETS) ~= "table" or Config.PETS[target.p] == nil then
		return false, "target"
	end
	if type(sac) ~= "table" or not isNum(need) or #sac ~= need then
		return false, "count"
	end
	local tier = Config.PETS[target.p].tier
	local seen = {}
	for _, j in ipairs(sac) do
		if not isNum(j) or j % 1 ~= 0 or j == i or seen[j] then
			return false, "dup"
		end
		seen[j] = true
		local sl = slots[j]
		if type(sl) ~= "table" or sl.k ~= "p" or type(Config.PETS[sl.p]) ~= "table" or Config.PETS[sl.p].tier ~= tier then
			return false, "tier"
		end
	end
	return true
end

---------------------------------------------------------------- machine d'états : sélection -> aperçu -> confirmation en deux étapes -> envoi -> retour visuel

function EvolveLayout.newFlow()
	return { phase = "idle", i = nil, view = nil, armedAt = nil, sentAt = nil, doneAt = nil, previewAt = nil, msg = nil, done = nil }
end

-- Appui sur une ligne : (re)demande l'aperçu. Pas pendant l'envoi ni le retour visuel. Retourne (flow, action) ; action = { kind = "preview", i } ou nil
-- (nil si la fonction est coupée, si l'emplacement est invalide ou si la dernière demande est trop récente).
function EvolveLayout.select(flow, i, now, enabled)
	if enabled ~= true or not isNum(i) or i % 1 ~= 0 or i < 1 or flow.phase == "sending" or flow.phase == "done" then
		return flow, nil
	end
	local t = isNum(now) and now or 0
	if flow.i == i and (flow.phase == "loading" or flow.phase == "ready" or flow.phase == "confirm") then
		return flow, nil
	end
	if isNum(flow.previewAt) and t - flow.previewAt < EvolveLayout.PREVIEW_COOLDOWN and flow.i ~= i then
		flow.i, flow.view, flow.phase, flow.armedAt, flow.msg = i, nil, "loading", nil, nil
		flow.pending = true -- demande différée : le client la relance après le délai (voir EvolveLayout.due)
		return flow, nil
	end
	flow.i, flow.view, flow.phase, flow.armedAt, flow.msg, flow.pending = i, nil, "loading", nil, nil, nil
	flow.previewAt = t
	return flow, { kind = "preview", i = i }
end

-- Demande d'aperçu différée à relancer ? Retourne l'action ou nil.
function EvolveLayout.due(flow, now)
	if flow.pending and flow.phase == "loading" and flow.i and isNum(now) and isNum(flow.previewAt) and now - flow.previewAt >= EvolveLayout.PREVIEW_COOLDOWN then
		flow.pending = nil
		flow.previewAt = now
		return { kind = "preview", i = flow.i }
	end
	return nil
end

-- Aperçu reçu du serveur ({ ok, i, sac, cost, need } ou { ok = false, code, ... }) : ignoré s'il ne concerne pas le pet choisi ou si la phase ne l'attend pas.
function EvolveLayout.onPreview(flow, view, now)
	if type(view) ~= "table" or flow.i == nil or view.i ~= flow.i then
		return flow
	end
	if flow.phase ~= "loading" and flow.phase ~= "ready" and flow.phase ~= "confirm" and flow.phase ~= "sending" and flow.phase ~= "refused" then
		return flow
	end
	flow.view = view
	flow.armedAt, flow.sentAt = nil, nil
	if view.ok == true and type(view.sac) == "table" and isNum(view.cost) then
		flow.phase, flow.msg = "ready", nil
	else
		flow.phase, flow.msg = "refused", view.code or "slot"
	end
	return flow
end

-- Appui sur le bouton principal. ready -> confirm (1re étape) ; confirm -> sending (2e étape, action evolve avec le prix vu) ; sinon rien.
-- Retourne (flow, action) ; action = { kind = "evolve", i, maxCost } ou nil.
function EvolveLayout.press(flow, now, enabled)
	if enabled ~= true then
		return flow, nil
	end
	local t = isNum(now) and now or 0
	if flow.phase == "ready" and type(flow.view) == "table" then
		flow.phase, flow.armedAt = "confirm", t
		return flow, nil
	elseif flow.phase == "confirm" and type(flow.view) == "table" then
		if isNum(flow.armedAt) and t - flow.armedAt <= EvolveLayout.CONFIRM_SECONDS then
			flow.phase, flow.sentAt = "sending", t
			return flow, { kind = "evolve", i = flow.i, maxCost = flow.view.cost }
		end
		flow.phase, flow.armedAt = "ready", nil
	end
	return flow, nil
end

-- Annule la confirmation (bouton « Annuler ») : retour à « prêt ». Sans effet pendant l'envoi.
function EvolveLayout.cancel(flow)
	if flow.phase == "confirm" then
		flow.phase, flow.armedAt = "ready", nil
	end
	return flow
end

-- Remise à zéro complète (fermeture de l'écran, pet disparu).
function EvolveLayout.reset(flow)
	flow.phase, flow.i, flow.view, flow.armedAt, flow.sentAt, flow.doneAt, flow.msg, flow.pending, flow.done = "idle", nil, nil, nil, nil, nil, nil, nil, nil
	return flow
end

-- Écoulement du temps : la 2e étape expire (confirm -> ready), l'envoi sans réponse revient à « prêt » avec un message, le retour visuel prend fin.
-- Retourne (flow, action) : action = { kind = "preview", i } quand l'envoi expire (l'aperçu est redemandé pour resynchroniser).
function EvolveLayout.tick(flow, now)
	local t = isNum(now) and now or 0
	if flow.phase == "confirm" and isNum(flow.armedAt) and t - flow.armedAt > EvolveLayout.CONFIRM_SECONDS then
		flow.phase, flow.armedAt = "ready", nil
	elseif flow.phase == "sending" and isNum(flow.sentAt) and t - flow.sentAt > EvolveLayout.SEND_TIMEOUT then
		flow.phase, flow.sentAt, flow.msg = "loading", nil, "timeout"
		flow.previewAt = t
		return flow, { kind = "preview", i = flow.i }
	elseif flow.phase == "done" and isNum(flow.doneAt) and t - flow.doneAt >= EvolveLayout.FX_SECONDS then
		EvolveLayout.reset(flow)
	end
	return flow, nil
end

-- Réponse « done » du serveur ({ k = "done", i, p, n }) : retour visuel (<= 1,2 s) puis retour au repos.
function EvolveLayout.onDone(flow, msg, now)
	if type(msg) ~= "table" or flow.i == nil or msg.i ~= flow.i or flow.phase ~= "sending" then
		return flow
	end
	flow.phase, flow.doneAt, flow.done, flow.armedAt, flow.sentAt = "done", isNum(now) and now or 0, { i = msg.i, p = msg.p, n = msg.n }, nil, nil
	return flow
end

-- Bouton principal : { text, active, kind } d'après la phase, le coût de l'aperçu et l'interrupteur. Jamais actif si la fonction est coupée.
function EvolveLayout.button(flow, enabled, E)
	local view = flow.view
	if enabled ~= true then
		return { text = "Bientôt disponible", active = false, kind = "soon", cancel = false }
	end
	local ph = flow.phase
	if ph == "ready" and type(view) == "table" then
		return { text = "✨ Évoluer (" .. math.floor(view.cost or 0) .. " 🪙)", active = true, kind = "ready", cancel = false }
	elseif ph == "confirm" and type(view) == "table" then
		return { text = "Confirmer : " .. math.floor(view.need or 3) .. " doublons + " .. math.floor(view.cost or 0) .. " 🪙", active = true, kind = "confirm", cancel = true }
	elseif ph == "loading" then
		return { text = "Vérification…", active = false, kind = "loading", cancel = false }
	elseif ph == "sending" then
		return { text = "Évolution…", active = false, kind = "sending", cancel = false }
	elseif ph == "done" then
		return { text = "✨ Évolué !", active = false, kind = "done", cancel = false }
	elseif ph == "refused" then
		return { text = "✖ " .. EvolveLayout.refuseText(E, flow.msg, view), active = false, kind = "refused", cancel = false }
	end
	return { text = "Choisis un pet", active = false, kind = "idle", cancel = false }
end

-- Résumé du pet choisi : { gains, sac chips, lignes de texte } pour le panneau de détail (nil si aucun pet choisi).
function EvolveLayout.detail(Config, state, flow)
	if flow.i == nil then
		return nil
	end
	local slots = type(state) == "table" and type(state.slots) == "table" and state.slots or {}
	local sl = slots[flow.i]
	if type(sl) ~= "table" or sl.k ~= "p" then
		return nil
	end
	local g = EvolveLayout.gains(Config, sl)
	if not g then
		return nil
	end
	local def = Config.PETS[sl.p]
	local lines = {
		"Revenu : +" .. g.incomePct .. " % (" .. string.format("%.1f", g.incomeBefore) .. " → " .. string.format("%.1f", g.incomeAfter) .. " /s)",
		"Force en combat : +" .. g.powerPct .. " % (pv et attaque)",
	}
	local chips = {}
	if type(flow.view) == "table" and type(flow.view.sac) == "table" then
		chips = EvolveLayout.sacChips(Config, state, flow.view.sac)
	end
	return { name = tostring(def.name or "?"), emoji = tostring(def.emoji or "?"), gains = g, lines = lines, chips = chips }
end

---------------------------------------------------------------- retour visuel court (propriétés mesurables)

-- Image du retour d'évolution à l'instant a (0..1) : échelle 1 -> 1,25 -> 1 (rebond), halo qui s'éteint, texte « ★2 » qui apparaît ; extrémités exactes.
function EvolveLayout.fx(a)
	local k = isNum(a) and clamp(a, 0, 1) or 1
	local pulse = math.sin(math.pi * k)
	local halo = 1 - k
	local starA = clamp(k * 3, 0, 1)
	return { scale = 1 + 0.25 * pulse, haloAlpha = halo, haloTransparency = 1 - halo * 0.7, starAlpha = starA }
end

function EvolveLayout.fxSeconds(reduced)
	return reduced == true and 0.5 or EvolveLayout.FX_SECONDS
end

---------------------------------------------------------------- disposition

function EvolveLayout.viewport(vw, vh)
	local d, m = EvolveLayout.DEFAULT_VIEWPORT, EvolveLayout.MIN_VIEWPORT
	local w = isNum(vw) and vw > 0 and vw or d.w
	local h = isNum(vh) and vh > 0 and vh or d.h
	return math.floor(math.max(m.w, w)), math.floor(math.max(m.h, h))
end

-- Rectangles (pixels, relatifs à la fenêtre) : panneau centré, en-tête, fermeture, liste défilante, détail, bouton principal, bouton annuler.
-- Garanties testées : tout dans la fenêtre moins la zone sûre, boutons >= 44 px, aucune superposition entre liste, détail et boutons.
function EvolveLayout.rects(vw, vh, safeIn)
	vw, vh = EvolveLayout.viewport(vw, vh)
	local s = type(safeIn) == "table" and safeIn or {}
	local sl, st, sr, sb = clamp(isNum(s.l) and s.l or 0, 0, vw * 0.25), clamp(isNum(s.t) and s.t or 0, 0, vh * 0.25), clamp(isNum(s.r) and s.r or 0, 0, vw * 0.25), clamp(isNum(s.b) and s.b or 0, 0, vh * 0.25)
	local m = 8
	local ax0, ay0, ax1, ay1 = sl + m, st + m, vw - sr - m, vh - sb - m
	local aw, ah = ax1 - ax0, ay1 - ay0
	local pw = math.floor(math.min(aw, 440))
	local ph = math.floor(math.min(ah, 520))
	local px = math.floor(ax0 + (aw - pw) / 2)
	local py = math.floor(ay0 + (ah - ph) / 2)
	local pad, gap, T = 10, 6, EvolveLayout.MIN_TOUCH
	local out = { vw = vw, vh = vh, panel = rect(px, py, pw, ph) }
	out.close = rect(px + pw - pad - T, py + pad, T, T)
	out.header = rect(px + pad, py + pad, pw - 2 * pad - T - gap, T)
	out.subtitle = rect(px + pad, py + pad + T + 2, pw - 2 * pad, 34)
	local footerH = T + 4
	local detailH = ph >= 420 and 118 or 86
	local topH = pad + T + 2 + 34 + gap -- en-tête et sous-titre
	detailH = math.max(52, math.min(detailH, ph - topH - pad - footerH - 2 * gap - EvolveLayout.ROW_H)) -- fenêtre basse : le détail cède de la place, la liste garde une ligne entière
	local by = py + ph - pad - footerH
	out.cancel = rect(px + pad, by, math.floor((pw - 2 * pad - gap) * 0.32), footerH)
	out.primary = rect(out.cancel.x + out.cancel.w + gap, by, pw - 2 * pad - gap - out.cancel.w, footerH)
	out.detail = rect(px + pad, by - gap - detailH, pw - 2 * pad, detailH)
	local ly = out.subtitle.y + out.subtitle.h + gap
	out.list = rect(px + pad, ly, pw - 2 * pad, math.max(EvolveLayout.ROW_H, out.detail.y - gap - ly))
	out.rowH = EvolveLayout.ROW_H
	out.area = rect(ax0, ay0, aw, ah)
	return out
end

function EvolveLayout.overlap(a, b)
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

-- Nombre de lignes entièrement visibles dans la liste ; la liste défile au-delà.
function EvolveLayout.visibleRows(r)
	return math.max(1, math.floor(r.list.h / r.rowH))
end

---------------------------------------------------------------- contraste (accessibilité : jamais la couleur seule, texte >= 4,5:1)

local function lin(c)
	local v = c / 255
	if v <= 0.03928 then
		return v / 12.92
	end
	return ((v + 0.055) / 1.055) ^ 2.4
end
function EvolveLayout.luminance(rgb)
	return 0.2126 * lin(rgb[1]) + 0.7152 * lin(rgb[2]) + 0.0722 * lin(rgb[3])
end
function EvolveLayout.contrast(a, b)
	local la, lb = EvolveLayout.luminance(a), EvolveLayout.luminance(b)
	return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
end
-- Couples (texte, fond) réellement affichés ; chacun doit atteindre 4,5:1 (testé).
function EvolveLayout.textPairs()
	local U = EvolveLayout.UI
	return {
		{ "titre", U.text, U.panel }, { "sous-titre", U.muted, U.panel }, { "ligne", U.text, U.row }, { "ligne choisie", U.text, U.rowSel },
		{ "prêt", U.ok, U.row }, { "doublons manquants", U.warn, U.row }, { "interdit", U.bad, U.row }, { "bientôt", U.soon, U.panel },
		{ "bouton actif", U.darkText, U.btnOn }, { "bouton inactif", U.offText, U.btnOff }, { "confirmer", U.darkText, U.btnConfirm }, { "annuler", U.cancelText, U.btnCancel },
		{ "détail", U.text, U.panel },
	}
end

return EvolveLayout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">Evolution</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Evolution
-- IDÉE 2 (coffre IDEES_CHIPE_OEUFS) : évolution d'un pet en « forme 2 ». Logique PURE : aucune API Roblox, aucun yield, aucune erreur levée sur une
-- entrée invalide (valeurs de retour). Testé par tests/evolution.luau (Lune ou lupa). Le serveur (Main) n'appelle que plan / stage / stillValid / apply.
--
-- Règles (Config.EVOLUTION, valeurs uniques) :
--   * coût : `sacrifices` (3) DOUBLONS de la même rareté que le pet visé + `costSeconds` (300 s = 5 min) du revenu ACTUEL du joueur, en pièces.
--     Aucune forme payante : rien ici ne lit un produit, un pass ou des Robux ; le coût en pièces est calculé par le serveur (le client n'envoie que
--     l'emplacement et le prix maximal qu'il accepte, `maxCost`, pour ne jamais payer plus que ce qu'il a vu) ;
--   * doublon : pet dont l'espèce garde au moins UN exemplaire dans la base après l'évolution (le pet visé compte). On ne sacrifie jamais le dernier
--     exemplaire d'une espèce. Choix AUTOMATIQUE par le serveur : les doublons qui rapportent le moins d'abord (puis l'indice le plus bas) ;
--   * forme 2 : même espèce (sl.p inchangé), `sl.f = 2`, revenu x incomeMul (1,15), pv et attaque x powerMul (1,10) en combat (Battle.unit, échelle),
--     silhouette x visualScale et halo (Builder) ;
--   * interdits : pet visé ou sacrifié qui suit le joueur (equip), qui est dans l'équipe de combat (battle.team) ou dont la copie (p, s, m) est dans la
--     défense PvP enregistrée ; taille Géant / Colossal ; mutation Arc-en-ciel et au-delà (Alien, Céleste) ; pet déjà en forme 2 ; combat en cours ;
--   * force : la forme 2 d'une rareté r reste STRICTEMENT sous la forme 1 de la rareté r + 1 (mêmes taille, mutation, niveau) : vérifié par les tests
--     sur les 10 raretés (Battle.STATS) et sur chaque espèce du bestiaire ;
--   * profil : `evo = { ["indice d'espèce"] = nombre d'évolutions }` (compteur par espèce), assaini, jamais remis à zéro (migration v13 -> v14 idempotente).
-- Atomicité (même schéma que le calendrier et les cartes : sauvegarde PUIS octroi) : `stage` construit une COPIE du profil après l'évolution, le
-- serveur la sauvegarde ; seulement si la sauvegarde réussit, `stillValid` puis `apply` modifient le profil vivant. Échec = profil vivant intact.
local Evolution = {}

Evolution.FORM2 = 2

local function num(v, default)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function isInt(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge and v % 1 == 0
end

local function cfgOf(Config)
	return type(Config) == "table" and type(Config.EVOLUTION) == "table" and Config.EVOLUTION or nil
end

-- Forme d'un emplacement : 2 si `f == 2`, sinon 1 (pets plus anciens, œufs, vides).
function Evolution.form(sl)
	if type(sl) == "table" and sl.k == "p" and sl.f == Evolution.FORM2 then
		return 2
	end
	return 1
end

-- Assainit le champ facultatif `f` d'un pet (merge) : 2 ou absent. Idempotent.
function Evolution.sanitizeForm(sl)
	if type(sl) == "table" then
		if sl.k == "p" and sl.f == Evolution.FORM2 then
			sl.f = Evolution.FORM2
		else
			sl.f = nil
		end
	end
	return sl
end

-- Multiplicateur de revenu d'une forme (Config.petIncome) : 1 ou cfg.incomeMul.
function Evolution.incomeMulOf(Config, f)
	local cfg = cfgOf(Config)
	if f == Evolution.FORM2 and cfg then
		return num(cfg.incomeMul, 1)
	end
	return 1
end

-- Échelle de combat d'un pet (3e argument de Battle.unit) : nil pour la forme 1 (aucun changement), cfg.powerMul pour la forme 2.
function Evolution.powerScale(Config, sl)
	local cfg = cfgOf(Config)
	if cfg and Evolution.form(sl) == 2 then
		return num(cfg.powerMul, 1)
	end
	return nil
end

-- Échelle visuelle (Builder) : 1 ou cfg.visualScale.
function Evolution.visualScale(Config, f)
	local cfg = cfgOf(Config)
	if cfg and f == Evolution.FORM2 then
		return num(cfg.visualScale, 1)
	end
	return 1
end

-- Compteur d'évolutions par espèce : clés = tostring(indice d'espèce existante), valeurs entières 1..1e6. Absent ou corrompu = {}.
-- Idempotent : relire un compteur déjà assaini le rend identique.
function Evolution.sanitizeCounts(Config, v)
	local out = {}
	if type(v) ~= "table" or type(Config) ~= "table" or type(Config.PETS) ~= "table" then
		return out
	end
	for k, n in pairs(v) do
		local idx = tonumber(k)
		if idx and isInt(idx) and Config.PETS[idx] ~= nil and type(n) == "number" and n == n and n >= 1 then
			out[tostring(idx)] = math.min(1e6, math.floor(n))
		end
	end
	return out
end

-- Migration v13 -> v14 : pose `evo = {}` si absent ou d'un autre type ; un compteur existant n'est JAMAIS remis à zéro (assaini ensuite par merge).
function Evolution.migrate(saved)
	if type(saved) == "table" and type(saved.evo) ~= "table" then
		saved.evo = {}
	end
	return saved
end

local function blocked(cfg, sl)
	return (cfg.blockedSizes and cfg.blockedSizes[sl.s]) or (cfg.blockedMuts and cfg.blockedMuts[sl.m])
end

local function inList(list, v)
	if type(list) == "table" then
		for _, x in ipairs(list) do
			if x == v then
				return true
			end
		end
	end
	return false
end

-- Raison pour laquelle l'emplacement `i` est protégé (suiveur, équipe, défense PvP), ou nil.
function Evolution.protected(d, i)
	if type(d) ~= "table" or type(d.slots) ~= "table" then
		return "slot"
	end
	if inList(d.equip, i) then
		return "follower"
	end
	local b = type(d.battle) == "table" and d.battle or {}
	if inList(b.team, i) then
		return "team"
	end
	local sl = d.slots[i]
	local pv = type(b.pvp) == "table" and b.pvp or {}
	if type(sl) == "table" and type(pv.defense) == "table" then
		for _, e in ipairs(pv.defense) do
			if type(e) == "table" and e.p == sl.p and e.s == sl.s and e.m == sl.m and e.f ~= Evolution.FORM2 then
				return "defense"
			end
		end
	end
	return nil
end

-- Le pet de l'emplacement `i` peut-il être visé ? Retourne (true) ou (false, code). Ne regarde ni le coût ni les doublons.
function Evolution.targetCheck(Config, d, i, capacity)
	local cfg = cfgOf(Config)
	if not cfg or cfg.enabled ~= true then
		return false, "disabled"
	end
	if type(d) ~= "table" or type(d.slots) ~= "table" or not isInt(i) or i < 1 or i > (capacity or 0) then
		return false, "slot"
	end
	local sl = d.slots[i]
	if type(sl) ~= "table" or sl.k ~= "p" or type(Config.PETS) ~= "table" or Config.PETS[sl.p] == nil then
		return false, "slot"
	end
	if Evolution.form(sl) >= (cfg.maxForm or 2) then
		return false, "already"
	end
	if blocked(cfg, sl) then
		return false, "special"
	end
	local why = Evolution.protected(d, i)
	if why then
		return false, why
	end
	return true
end

-- Doublons sacrifiables pour le pet visé `i` : `cfg.sacrifices` emplacements, ou (nil, nombre trouvé). Ordre : revenu croissant, puis indice.
function Evolution.pickSacrifices(Config, d, i, capacity)
	local cfg = cfgOf(Config)
	local target = d.slots[i]
	local tier = Config.PETS[target.p].tier
	local counts = {}
	for j = 1, capacity do
		local sl = d.slots[j]
		if type(sl) == "table" and sl.k == "p" and Config.PETS[sl.p] then
			counts[sl.p] = (counts[sl.p] or 0) + 1
		end
	end
	local cands = {}
	for j = 1, capacity do
		local sl = d.slots[j]
		if
			j ~= i
			and type(sl) == "table"
			and sl.k == "p"
			and Config.PETS[sl.p]
			and Config.PETS[sl.p].tier == tier
			and Evolution.form(sl) == 1
			and not blocked(cfg, sl)
			and Evolution.protected(d, j) == nil
		then
			cands[#cands + 1] = { j = j, p = sl.p, inc = Config.petIncome(sl.p, sl.s, sl.m) }
		end
	end
	table.sort(cands, function(a, b)
		if a.inc ~= b.inc then
			return a.inc < b.inc
		end
		return a.j < b.j
	end)
	local need = cfg.sacrifices or 3
	local out = {}
	for _, c in ipairs(cands) do
		if #out < need and counts[c.p] > 1 then -- jamais le dernier exemplaire d'une espèce (le pet visé compte comme exemplaire restant)
			out[#out + 1] = c.j
			counts[c.p] = counts[c.p] - 1
		end
	end
	if #out < need then
		return nil, #out
	end
	table.sort(out)
	return out
end

-- Coût en pièces : cfg.costSeconds x revenu actuel par seconde (arrondi au supérieur, >= 0).
function Evolution.cost(Config, incomePerSec)
	local cfg = cfgOf(Config)
	local inc = math.max(0, num(incomePerSec, 0))
	return math.max(0, math.ceil((cfg and cfg.costSeconds or 300) * inc - 1e-9))
end

-- Plan d'évolution complet. ctx (calculé par le SERVEUR) = { capacity, income, coins?, busy?, maxCost? }.
-- Retourne (plan) ou (nil, code, détail). plan = { i, p, tier, sac = { j, ... }, pets = { [j] = table du pet }, target = table du pet, cost }.
-- `pets` et `target` gardent les RÉFÉRENCES des tables du profil : stillValid vérifie que ce sont toujours les mêmes pets.
function Evolution.plan(Config, d, i, ctx)
	ctx = type(ctx) == "table" and ctx or {}
	if ctx.busy then
		return nil, "busy"
	end
	local capacity = isInt(ctx.capacity) and ctx.capacity or 0
	local ok, code = Evolution.targetCheck(Config, d, i, capacity)
	if not ok then
		return nil, code
	end
	local sac, found = Evolution.pickSacrifices(Config, d, i, capacity)
	if not sac then
		return nil, "dupes", found
	end
	local cost = Evolution.cost(Config, ctx.income)
	if ctx.maxCost ~= nil and (type(ctx.maxCost) ~= "number" or ctx.maxCost ~= ctx.maxCost or cost > ctx.maxCost) then
		return nil, "price", cost
	end
	if num(d.coins, 0) < cost then
		return nil, "coins", cost
	end
	local target = d.slots[i]
	local pets = {}
	for _, j in ipairs(sac) do
		pets[j] = d.slots[j]
	end
	return { i = i, p = target.p, tier = Config.PETS[target.p].tier, sac = sac, pets = pets, target = target, cost = cost }
end

-- Aperçu pour le client : { ok, code, sac, cost, need, found } (aucune référence de table du profil).
function Evolution.view(Config, d, i, ctx)
	local plan, code, extra = Evolution.plan(Config, d, i, ctx)
	local cfg = cfgOf(Config)
	if plan then
		return { ok = true, i = i, sac = plan.sac, cost = plan.cost, need = cfg.sacrifices }
	end
	return { ok = false, i = i, code = code, cost = (code == "coins" or code == "price") and extra or nil, found = code == "dupes" and extra or nil, need = cfg and cfg.sacrifices or nil }
end

local function bump(evo, p)
	local k = tostring(p)
	evo[k] = math.min(1e6, (evo[k] or 0) + 1)
end

-- Copie du profil APRÈS l'évolution, à sauvegarder (le profil vivant n'est pas touché) : copie superficielle, avec de nouvelles tables pour
-- slots, evo et le pet visé ; les autres champs sont partagés (lecture seule pendant la sauvegarde).
function Evolution.stage(d, plan)
	local post = table.clone(d)
	local slots = table.clone(d.slots)
	local pet = table.clone(plan.target)
	pet.f = Evolution.FORM2
	slots[plan.i] = pet
	for _, j in ipairs(plan.sac) do
		slots[j] = false
	end
	local evo = table.clone(type(d.evo) == "table" and d.evo or {})
	bump(evo, plan.p)
	post.slots, post.evo = slots, evo
	post.coins = num(d.coins, 0) - plan.cost
	return post
end

-- Le plan s'applique-t-il encore au profil vivant (mêmes tables de pets aux mêmes emplacements, forme 1, pièces suffisantes) ?
function Evolution.stillValid(d, plan)
	if type(d) ~= "table" or type(d.slots) ~= "table" or type(plan) ~= "table" then
		return false
	end
	if d.slots[plan.i] ~= plan.target or Evolution.form(plan.target) ~= 1 then
		return false
	end
	for _, j in ipairs(plan.sac) do
		if d.slots[j] ~= plan.pets[j] then
			return false
		end
	end
	return num(d.coins, 0) >= plan.cost
end

-- Applique le plan au profil vivant (après une sauvegarde réussie de `stage`) : pièces débitées (delta : le revenu gagné pendant la sauvegarde reste),
-- doublons retirés, forme 2, compteur de l'espèce +1. Retourne true, ou false sans rien toucher si le plan ne s'applique plus.
function Evolution.apply(d, plan)
	if not Evolution.stillValid(d, plan) then
		return false
	end
	d.coins = num(d.coins, 0) - plan.cost
	for _, j in ipairs(plan.sac) do
		d.slots[j] = false
	end
	plan.target.f = Evolution.FORM2
	if type(d.evo) ~= "table" then
		d.evo = {}
	end
	bump(d.evo, plan.p)
	return true
end

-- Retire les indices sacrifiés d'une liste d'emplacements (equip) : sécurité, ils ne peuvent pas y être (protégés).
function Evolution.dropIndices(list, sac)
	if type(list) ~= "table" then
		return list
	end
	for n = #list, 1, -1 do
		if inList(sac, list[n]) then
			table.remove(list, n)
		end
	end
	return list
end

-- Messages des refus (client) : codes de plan / targetCheck.
Evolution.REFUSE = {
	disabled = "L'évolution n'est pas encore disponible.",
	slot = "Choisis un pet de ta base.",
	already = "Ce pet est déjà en forme 2.",
	special = "Les pets Géants, Colossaux, Arc-en-ciel, Alien et Célestes n'évoluent pas.",
	follower = "Ce pet te suit : retire-le de tes suiveurs avant de le faire évoluer.",
	team = "Ce pet est dans ton équipe de combat : retire-le de l'équipe avant de le faire évoluer.",
	defense = "Ce pet est dans ta défense PvP : enregistre une autre défense avant de le faire évoluer.",
	busy = "Termine d'abord ton combat.",
	dupes = "Il faut 3 doublons de la même rareté (jamais le dernier exemplaire d'une espèce).",
	coins = "Pas assez de pièces (5 min de revenus).",
	price = "Le prix a changé : regarde le nouveau prix et réessaie.",
	save = "Sauvegarde impossible pour l'instant : réessaie dans un moment (rien n'a été perdu).",
	changed = "Ta base a changé pendant l'évolution : rien n'a été fait.",
}

return Evolution
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX75"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX62"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Script : ServerScriptService/Main
-- Logique serveur complète de Chipe-Œufs (le serveur décide de tout, le client ne fait qu'afficher).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local MessagingService = game:GetService("MessagingService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
if Config.Game.roleFor(game.PlaceId) == "hub" then
	return -- le hub a son propre script (Hub.server) ; ce code est celui de la partie
end
local TeleportService = game:GetService("TeleportService")
local Party = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Party"))
local Reveal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Reveal"))
local Guard = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Guard"))
local Castle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Castle"))
local Belt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Belt"))
local Traps = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Traps")) -- pièges des territoires (lot 4)
local Riddle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Riddle")) -- énigme de la Mère Poule : règles pures (lot 6)
local Raven = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Raven")) -- vol à distance « Corbeau chipeur » : règles pures (lot 7)
local Data = require(script.Parent:WaitForChild("Data"))
local Builder = require(script.Parent:WaitForChild("Builder"))
local HenQuest = require(script.Parent:WaitForChild("HenQuest")) -- énigme de la Mère Poule : état, prompts, récompense (lot 6)
local Rules = require(script.Parent:WaitForChild("Rules")).new(Config) -- règles pures (tirages, revenus), testées avec Lune
local tele = (function() -- lot 9 : 12 métriques AnalyticsService (pcall, 1 événement / s / joueur) ; une seule variable locale (limite de 200)
	local svc = nil
	pcall(function()
		svc = game:GetService("AnalyticsService")
	end)
	return require(script.Parent:WaitForChild("Telemetry")).new(svc)
end)()

Players.CharacterAutoLoads = false

---------------------------------------------------------------- Remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = ReplicatedStorage
local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = Remotes
	return r
end
local RState, RNotify, RHatch, RAction = newRemote("State"), newRemote("Notify"), newRemote("Hatch"), newRemote("Action")
local RTop = newRemote("Top")
local RBattle = newRemote("Battle") -- serveur -> client : début, tours (événements à rejouer) et fin des combats de l'Arène des pets
local RRaven = newRemote("Raven") -- Corbeau chipeur (lot 7) : serveur -> client seulement (alerte de la victime, liste des cibles) ; les demandes passent par Action
local RHen = newRemote("Hen") -- serveur -> client : répliques de la Mère Poule (identifiant + paramètres), berceuse à jouer, retour des touches, plume ramassée

-- Lot 8B : kiosque central, décor de carte, meubles des maisons. UNE seule variable locale (limite de 200) : modules, remote, état et fonctions dans K8.
local K8 = {
	Kiosk = require(script.Parent:WaitForChild("Kiosk")), KioskData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("KioskData")),
	HouseDecor = require(script.Parent:WaitForChild("HouseDecor")), HouseDecorData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HouseDecorData")),
	remote = newRemote("Kiosk"), -- serveur -> client seulement : { panel = "shop" | "calendar" | "odds" | "ranking", ... } (Kiosk.handle) ; aucune demande client par ce remote
	world = nil, info = nil, -- dossier World (Builder.build) ; info du kiosque construit (centre, prompts, pastille)
	top = { at = -1e9, season = nil, list = {} }, -- cache du classement du kiosque (30 s : au plus 1 lecture DataStore par fenêtre)
	Sellers = require(script.Parent:WaitForChild("Sellers")), DecorData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("DecorData")), sellers = nil, -- lot 16 : 8 vendeurs PNJ autour du kiosque
}
-- Lot 15 : PNJ, série de 7 jours, quêtes bonus et hebdomadaires, sac d'œufs, rotation, événements. UNE seule variable locale (limite de 200) : modules,
-- remote serveur -> client « Npc » (les demandes du client passent par Action : npcAnswer, npcOff, daily, bagPlace, bonusClaim, weeklyClaim, plumeBuy),
-- carnets d'offres par joueur (mémoire, vidés au départ) et fonctions (bloc « Lot 15 » plus bas).
-- LOT 12 B : L15.BR (cartes de récompense D.5), L15.PetXp (source UNIQUE de l'XP et des niveaux de pets, D.6) et les fonctions de choix de carte sont rangés dans cette table : Luau limite une fonction à 200 variables locales.
local L15 = {
	SC = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Showcase")).new(Config), -- idée 3 : vitrine pet du jour
	BR = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BattleRewards")),
	PetXp = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetXp")),
	Npc = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Npc")), Rewards = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rewards")),
	Duel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Duel")), -- lot 13 : duel local, ligues, remise de saison (module pur) ; état des duels dans L15.duel (bloc « Duel local »)
	remote = newRemote("Npc"), books = {}, assets = nil, decorKey = nil,
	Onb = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Onboarding")).new(Config.ONBOARDING), -- lot 17 : onboarding des 5 premières minutes (règles pures ; fonctions L15.onb* plus bas)
}
-- Construit (ou reconstruit : idempotent) le kiosque dans World. assets = nil : repli procédural immédiat, sans avertissement.
function K8.build(assets)
	if not K8.world then
		return
	end
	local ok, _, _, info = pcall(K8.Kiosk.build, K8.world, Config.Map2.kiosk, assets and { Config = Config, assets = assets, noAmbience = true }
		or { Config = Config, quiet = true, noAmbience = true, loadAsset = function()
			return nil
		end })
	if ok and type(info) == "table" then
		local wasReady = K8.info and K8.info.ready
		K8.info = info
		if wasReady then
			K8.Kiosk.setBadge(info, true) -- la pastille allumée reste allumée après la reconstruction
		end
	end
	-- lot 16 : 8 vendeurs PNJ (un par catégorie de la boutique), reconstruits avec les modèles Blender arrivés ; repli procédural sinon
	task.wait() -- le placement (SellersData.layout, mémorisé) est un calcul assez long : on rend la main avant
	local okS, serr, _, sinfo = pcall(K8.Sellers.build, K8.world, assets and { Config = Config, assets = assets, decor = K8.DecorData }
		or { Config = Config, decor = K8.DecorData, loadAsset = function()
			return nil
		end })
	if okS and type(sinfo) == "table" then
		K8.sellers = sinfo
	elseif not okS then
		warn("[Sellers] construction impossible : " .. tostring(serr))
	end
end

---------------------------------------------------------------- Monde
local onAssetsLoaded = nil -- défini après applyBase et refreshAllPads (voir plus bas), appelé par la tâche de chargement des modèles
-- Apparence des œufs : modèles Roblox chargés en arrière-plan (jamais bloquant ; échec = apparence par défaut, voir Config.Assets).
task.spawn(function()
	local InsertService = game:GetService("InsertService")
	local assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets")).new(Config, {
		loadAsset = function(id)
			return InsertService:LoadAsset(id)
		end,
		spawn = task.spawn,
		wait = task.wait,
		clock = os.clock,
		warn = warn,
		store = function(key, model)
			model.Name = "EggAsset_" .. key
			model.Parent = game:GetService("ServerStorage")
		end,
	})
	Builder.setAssets(assets)
	-- Ordre de chargement : d'abord ce qui se voit dans les premières secondes (œufs, base du joueur, chemins, arbres, accessoires, village), par lots parallèles
	assets.loadAll()
	assets.loadGroup("base")
	assets.loadGroup("house") -- maisons évolutives (niveaux 2 à 7) : avant tous les groupes non essentiels, onAssetsLoaded les applique
	assets.loadGroup("paths")
	assets.loadGroup("trees")
	assets.loadProps()
	assets.loadGroup("scenery")
	assets.loadGroup("eggguard") -- protections d'œuf (dôme, cage, cristaux, nid) posées à chaque rafraîchissement de pad
	assets.loadPets()
	if onAssetsLoaded then
		pcall(onAssetsLoaded) -- base et pads déjà affichés : reconstruits avec les modèles arrivés
	end
	local petPub, petRefused = Builder.exportPets(assets) -- mobs étape 1 : modèles des pets publiés pour le combat (ReplicatedStorage.PetModels)
	print(("[Assets] pets publiés pour le combat : %d (refusés, plus de %d Parts : %d)"):format(petPub, Config.Assets.combatMaxParts or 40, petRefused))
	local propParts, propCount = Builder.dressWorld(assets)
	print("[Assets] accessoires Blender : " .. propCount .. " posés (" .. propParts .. " Parts)")
	assets.loadGroup("guards")
	print("[Assets] gardiens Blender : " .. Builder.dressGuards(assets) .. " remplacé(s)")
	assets.loadGroup("traps")
	assets.loadGroup("guards", { knight = true })
	print("[Assets] pièges Blender : " .. Builder.dressTraps(assets) .. " habillé(s)")
	print("[Assets] chevaliers Blender : " .. Builder.dressKnights(assets) .. " habillé(s)")
	assets.loadGroup("castle")
	assets.loadGroup("props") -- coffre, torche, drapeau, château en fond, moulin, enclos, lampadaire, banc, panneau
	assets.loadGroup("ground")
	print("[Assets] arène Blender : " .. Builder.dressArena(assets) .. " modèle(s) posé(s)")
	assets.loadTextures()
	print("[Assets] textures : " .. Builder.dressTextures(assets) .. " posée(s)")
	assets.loadGroup("deco")
	assets.loadGroup("terrain")
	local pt, pu = Builder.dressPaths(assets)
	print("[Assets] chemins sinueux : " .. pt .. " tuile(s), " .. pu .. " Parts (budget " .. Config.Assets.pathBudgetParts .. ")")
	local sn, su = Builder.dressScenery(assets)
	print("[Assets] décor de village : " .. sn .. " objet(s), " .. su .. " Parts (budget " .. Config.Assets.sceneryBudgetParts .. ")")
	local dp, du, df = Builder.dressDeco(assets)
	print("[Assets] décor fin : " .. dp .. " objet(s), " .. du .. " Parts Blender (budget " .. Config.Assets.decoBudgetParts .. "), " .. df .. " Parts de repli")
	local rn, ru = Builder.dressRelief(assets)
	print("[Assets] relief : " .. rn .. " pièce(s), " .. ru .. " Parts (budget " .. Config.Assets.reliefBudgetParts .. ")")
	print("[Assets] panneaux d'étoiles : " .. Builder.dressSigns(assets))
	assets.loadGroup("vfx")
	print("[Assets] effets 3D : " .. Builder.exportVfx(assets) .. " modèle(s) publiés pour les clients")
	local gt, gp = Builder.dressGround(assets)
	print("[Assets] sol Blender : " .. gt .. " tuile(s), " .. gp .. " Parts (budget " .. Config.Assets.groundBudgetParts .. ")")
	print("[Assets] château Blender : " .. Builder.dressCastle(assets) .. " modèle(s) posé(s)")
	assets.loadGroup("hub") -- lot 8B : kiosque central (hub.kiosk) ; le modèle remplace le repli procédural posé au démarrage
	K8.build(assets)
	assets.loadGroup("npc") -- lot 15 : PNJ (publiés aux clients, repli procédural côté client) ; décors d'événement ; calendrier mural près du kiosque
	assets.loadGroup("event")
	L15.assets = assets
	if L15.publishNpc then -- (fonctions du bloc « Lot 15 », définies au chargement du script)
		print("[Assets] PNJ publiés aux clients : " .. L15.publishNpc(assets) .. "/5 ; calendrier mural : " .. (L15.placeCalendar(assets) and "modèle Blender" or "absent (le kiosque garde son prompt)"))
		pcall(L15.placeEventDecor, true)
	end
	print("[Assets] kiosque central : " .. ((K8.info and K8.info.usedAsset) and "modèle Blender" or ("repli procédural (" .. tostring(K8.info and K8.info.reason) .. ")")))
	local dn, du, dfb = Builder.dressDecor(assets)
	print("[Assets] décor de carte (lots 15 à 17) : " .. dn .. " exemplaire(s), " .. du .. " Parts Blender (budget " .. Config.Assets.decorBudgetParts .. "), " .. dfb .. " Parts de repli")
	if onAssetsLoaded then
		pcall(onAssetsLoaded)
	end
	-- Rapport de chargement : par catégorie (chargés / demandés / en repli) et, pour chaque échec, nom, ID et message ; publié aux clients (touche F3, « Blender N/M »)
	local lines, loaded, requested = assets.reportLines()
	for _, l in ipairs(lines) do
		if l:find("ÉCHEC", 1, true) then
			warn(l)
		else
			print(l)
		end
	end
	print(("[Assets] TOTAL Blender %d/%d (repli procédural : %d)"):format(loaded, requested, requested - loaded))
	local rv = Instance.new("StringValue")
	rv.Name = "AssetReport"
	rv:SetAttribute("Loaded", loaded)
	rv:SetAttribute("Requested", requested)
	rv.Value = table.concat(lines, "\n"):sub(1, 15000)
	rv.Parent = ReplicatedStorage
end)

local world = Builder.build()
K8.world = world.folder -- dossier World (Builder.build retourne une table de résultats)
K8.build(nil) -- lot 8B : kiosque procédural immédiat (le modèle Blender le remplace dans la tâche des Assets)
local rng = Random.new()
local sessions = {} -- [Player] = session
local leavingSave = {} -- userId -> true tant que la sauvegarde de départ de ce joueur est en cours (une reconnexion attend)
local pendingSaves, saveLater = {}, nil -- profils à sauvegarder en arrière-plan (voir saveLater)
local beltBuy -- définie avec le tapis roulant central (section dédiée) ; déclarée ici car le gestionnaire de prompts l'utilise
-- lot 9b : Calendar (règles pures du calendrier de 30 jours) et Cal (fonctions du bloc « Lot 9b » plus bas) logent dans Lot7 : AUCUNE variable locale de plus (limite de 200 atteinte)
local Lot7 = { Calendar = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Calendar")), Odds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Odds")), Cal = {}, luckUntil = 0, luckBy = nil, compPaid = 0, L16 = {} } -- lot 7 : Corbeau, tapis privé, bonus serveur, PolicyService (fonctions ajoutées dans le bloc « Lot 7 » plus bas)
Lot7.Evolution, Lot7.REvo = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Evolution")), newRemote("Evo") -- idée 2 : évolution des pets (règles pures) ; Evo = serveur -> client (aperçu, résultat)
-- Lot 10 : 42 icônes d'interface (Config.ICONS = IDs de DÉCAL). Chargées une fois en arrière-plan (InsertService:LoadAsset sous pcall, une seule tentative par
-- icône), URL d'image (Decal.Texture) publiée en attribut du dossier ReplicatedStorage.Icons ; échec = attribut absent, le client garde l'emoji de repli.
task.spawn(function()
	local folder = Instance.new("Folder")
	folder.Name = "Icons"
	folder.Parent = ReplicatedStorage
	if not (Config.Assets and Config.Assets.Enabled == true) then
		return
	end
	local keys = {}
	for key in pairs(Config.ICONS) do
		keys[#keys + 1] = key
	end
	table.sort(keys)
	local loaded = 0
	for _, key in ipairs(keys) do
		local ok, model = pcall(function()
			return game:GetService("InsertService"):LoadAsset(Config.ICONS[key])
		end)
		if ok and model then
			pcall(function()
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("Decal") and type(d.Texture) == "string" and d.Texture ~= "" then
						folder:SetAttribute(key, d.Texture)
						loaded += 1
						break
					end
				end
				model:Destroy()
			end)
		end
	end
	print("[Assets] icônes d'interface : " .. loaded .. "/" .. #keys)
end)
local Hen = nil -- énigme de la Mère Poule (HenQuest) : construite après les événements serveur, utilisée par les prompts et la synchronisation
local castleEnter, castleFinish -- définies avec le mode Château (plus bas) ; déclarées ici car le gestionnaire de prompts les utilise
local serverPartyId = nil -- identifiant de la partie de ce serveur (celui du premier joueur envoyé par le hub)

local function rnd()
	return rng:NextNumber()
end
local function wpick(ws)
	return Rules.wpick(ws, rnd)
end

local function getRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function alive(player)
	local h = getHum(player)
	return h ~= nil and h.Health > 0
end
local function validSlot(i)
	return type(i) == "number" and i % 1 == 0 and i >= 1 and i <= Config.SLOTS_MAX
end
-- sfx (optionnel) : clé de Config.SOUNDS jouée par le client avec le message
local function notify(player, msg, sfx)
	if player and player.Parent then
		RNotify:FireClient(player, msg, sfx)
	end
end

---------------------------------------------------------------- Règles
local currentEvent = nil -- { cfg, ends }
local function evKey()
	return currentEvent and currentEvent.cfg.key or nil
end

-- Capacité de la base : 4 + améliorations + bonus de niveau de maison + pass ExtraSlots (jamais plus de Config.SLOTS_MAX = 20).
local function cap(s)
	return Rules.capacity(s.data.up, s.baseLevel or 1, s.passes.ExtraSlots == true)
end
local function carryCap(d)
	return Rules.carryCapacity(d.up)
end
local function hatchTime(s, tier)
	return Rules.hatchTime(tier, s.data.up.inc, s.passes.Fast == true)
end
local function shieldTime(s)
	local lv = Config.BASE_LEVELS[s.baseLevel or 1]
	return Rules.shieldTime(s.data.up.lock) * (s.passes.VipBase == true and Config.VIP_SHIELD_MUL or 1) + (lv and lv.shieldBonus or 0) -- château doré : +10 s
end
-- Multiplicateur de vitesse de marche (pass « Vitesse+ »), appliqué aussi à la tolérance anti-triche.
local function speedMul(s)
	return (s.passes.Speed == true and Config.SPEED_PASS_MUL or 1) * (L15.BR.boostActive(s.data.boosts, "speed15", os.time()) and 1.15 or 1) -- lot 12 B : carte Effet « vitesse +15 % »
end
local function freeSlot(s)
	for i = 1, cap(s) do
		if not s.data.slots[i] then
			return i
		end
	end
	return nil
end

-- Une passe est-elle ACTIVE ? Les passes à hasard (Lucky, Tapis privé) exigent que PolicyService ait confirmé « non restreint » (restricted == false) : restreint ou inconnu = inactive,
-- même si le joueur la possède (lot 7b : sinon une reconnexion la réactivait). Toute lecture d'une passe à hasard passe par ici.
local function passOn(s, name)
	if s.passes[name] ~= true then
		return false
	end
	local def = Config.PASSES[name]
	return not (def and def.random == true and s.restricted ~= false)
end

-- Multiplicateur de revenu : renaissances, Festin, événement, passe, collection, puis bonus de la maison évolutive (1 + 5 % à 50 %, REFONTE lot 5).
local function gmult(s)
	return Rules.multiplier(s.data.rb, s.data.up.food, evKey() == "gold" or L15.Rewards.isGoldenHour(Config, os.time()), s.passes.Coins2x == true, Config.collectionBonus(s.species or 0)) * Rules.levelMul(s.baseLevel or 1) * (L15.BR.boostActive(s.data.boosts, "income2", os.time()) and 2 or 1) * (Config.SHOWCASE.enabled and L15.SC.multiplier(s.data.showcase, os.time()) or 1) -- lot 12 B : carte Effet « revenus x2 » ; idée 3 : vitrine du jour (+5 %, un seul bonus actif)
end

local function income(s)
	return Rules.income(s.data.slots, cap(s), gmult(s))
end

local function luckPoints(s)
	local pts = Rules.upPoints(s.data.up.luck, evKey() == "luck", passOn(s, "Lucky"), os.time() < s.data.luckUntil or L15.BR.boostActive(s.data.boosts, "luck10", os.time()), os.time() < Lot7.luckUntil, passOn(s, "Lucky2")) + L15.Rewards.activeEvents(Config, os.time()).upgradeBonus -- lot 15 : week-end chanceux (+5, gratuit, pour tous) ; lot 16 : Chance +10 % II
	return Lot7.L16.luckTotal(pts, os.time() < s.data.doubleUntil and s.restricted == false) -- lot 16 : Double chance (x2, 70 points au plus ; produit à hasard : seulement si PolicyService a confirmé)
end

local function rollPet(s, eggTier, guaranteed)
	local up = Config.effectiveUp(eggTier, luckPoints(s), Config.dexTopTier(s.data.dex)) -- lot 9 : pas d'amélioration vers une rareté jamais découverte
	local alien = evKey() == "alien"
	local open = Config.debugForceTier(RunService:IsStudio()) and Config.allEventTags() or Lot7.L16.openEv(os.time()) -- A5 : espèces d'événement / de saison seulement dans leur fenêtre (A9 : toutes, Studio seulement)
	local pet = Rules.rollPet(eggTier, up, alien, rnd, guaranteed, open)
	pet.p = L15.Rewards.featuredPick(Config, L15.Rewards.rotation(Config, L15.Rewards.weekOf(os.time() // 86400)), pet.p, rnd) -- lot 15 : espèce vedette de la semaine (poids x2)
	return pet, up, alien, open
end

---------------------------------------------------------------- Missions quotidiennes
local QUEST_TYPES = { "steal", "hatch", "earn", "train", "pvp", "discover", "sell", "castle", "rare", "secret", "duel", "typeWin", "odds", "pve", "npcTrade" } -- A11 : 5 types des lots 12 à 14

local function newQuests(s)
	local inc = math.max(income(s), 1)
	local pool = table.clone(QUEST_TYPES)
	local out = {}
	for _ = 1, 3 do
		local t = table.remove(pool, rng:NextInteger(1, #pool))
		local goal
		if t == "steal" then
			goal = rng:NextInteger(3, 7)
		elseif t == "hatch" then
			goal = rng:NextInteger(4, 9)
		elseif t == "earn" then
			goal = math.floor(math.max(1000, inc * 240))
		elseif t == "train" then
			goal = rng:NextInteger(3, 6) * 20
		elseif t == "sell" then
			goal = rng:NextInteger(2, 4)
		elseif t == "castle" or t == "rare" or t == "secret" then
			goal = 1
		elseif L15.Rewards.newQuestGoal(Config, t, 0) then -- A11 : duel, typeWin, odds, pve, npcTrade (objectifs de Config.QUESTS.newTypes)
			goal = L15.Rewards.newQuestGoal(Config, t, rng:NextNumber())
		else -- pvp, discover
			goal = rng:NextInteger(1, 2)
		end
		local bonus = Config.questBonus(t, #out + 1, s.data.story.ch)
		out[#out + 1] = { t = t, goal = goal, prog = 0, rew = math.floor(math.max(250, inc * 150)), re = bonus.egg or 0, rb = bonus.boost or 0, claimed = false }
	end
	return out
end

local function qp(s, t, n)
	for _, q in ipairs(s.data.quests) do
		if q.t == t and q.prog < q.goal then
			q.prog = math.min(q.goal, q.prog + n)
		end
	end
	if L15.QP_WEEKLY[t] and L15.weekly then
		L15.weekly(s, L15.QP_WEEKLY[t], n) -- lot 15 : quêtes de la semaine (éclosion, vol, collection)
	end
end

-- A11 : applique la progression décidée par Rewards.questKinds (événements serveur seulement). Dans L15 : limite de 200 variables locales.
function L15.qk(s, kind, info)
	for _, e in ipairs(L15.Rewards.questKinds(Config, kind, info)) do
		qp(s, e[1], e[2])
	end
end

local function ensureQuests(s)
	local today = os.time() // 86400
	if s.data.qday ~= today or #s.data.quests == 0 then
		s.data.quests = newQuests(s)
		s.data.qday = today
	end
end

---------------------------------------------------------------- Histoire (chapitres), collection et rang
local function speciesCount(d)
	local n = 0
	for _ in pairs(d.dex) do
		n += 1
	end
	return n
end

local function chapter(s)
	return Config.STORY[s.data.story.ch + 1]
end

local function storyReached(s, c)
	notify(s.player, "📜 Chapitre « " .. c.title .. " » terminé ! Réclame ta récompense (Missions > Histoire).", "claim")
end

-- Fait avancer le chapitre en cours si son type correspond. info = { rival = n, tier = n } selon l'événement.
local function sp(s, kind, n, info)
	local c = chapter(s)
	local st = s.data.story
	if not c or c.type ~= kind or st.prog >= c.goal then
		return
	end
	if c.rival and (not info or info.rival ~= c.rival) then
		return
	end
	if c.tier and (not info or (info.tier or 0) < c.tier) then
		return
	end
	st.prog = math.min(c.goal, st.prog + n)
	if st.prog >= c.goal then
		storyReached(s, c)
	end
end

-- Chapitres fondés sur un état (espèces découvertes, renaissances).
local function storyRefresh(s)
	local c = chapter(s)
	local st = s.data.story
	if not c or st.prog >= c.goal then
		return
	end
	local value
	if c.type == "species" then
		value = s.species
	elseif c.type == "rebirth" then
		value = s.data.rb
	end
	if value and value > st.prog then
		st.prog = math.min(c.goal, value)
		if st.prog >= c.goal then
			storyReached(s, c)
		end
	end
end

local function updateSign(s)
	local r = Config.rankFor(s.data.story.ch)
	s.plot.nameLabel.Text = "🏠 Base de " .. s.player.DisplayName .. " · " .. r.emoji .. " " .. r.name
end

---------------------------------------------------------------- Statistiques de succès (l'énigme du jour est dans HenQuest)
local function statValues(s)
	local d = s.data
	return { hatched = d.hatched, stolen = d.stolen, species = s.species, rb = d.rb, puzzles = d.puzzle.solved, tower = d.battle.best, fragments = d.puzzle.fragments }
end

---------------------------------------------------------------- Synchronisation client
local function snapshot(s)
	local d = s.data
	local slots = {}
	for i = 1, Config.SLOTS_MAX do
		local sl = d.slots[i]
		if sl and sl.k == "e" then
			slots[i] = { k = "e", t = sl.t, ends = sl.ends }
		elseif sl then
			slots[i] = { k = "p", p = sl.p, s = sl.s, m = sl.m, o = sl.o, f = sl.f } -- lot 10 : o absent (pet ancien) = « — » côté client ; idée 2 : f = 2 (forme 2)
		else
			slots[i] = false
		end
	end
	local today = os.time() // 86400
	local l15 = L15.view and L15.view(s) or nil -- lot 15 : série, sac, quêtes bonus et de la semaine, événements, réglage PNJ
	return {
		up = d.up,
		slots = slots,
		rb = d.rb,
		dex = d.dex,
		mult = gmult(s),
		evo = d.evo, -- idée 2 : évolutions par espèce
		cap = cap(s),
		baseLevelFloor = d.baseLevelFloor,
		carry = #s.carry,
		carryCap = carryCap(d),
		passes = s.passes,
		starter = s.data.starter == true,
		dailyReady = l15 ~= nil and l15.streak.state ~= "done" or d.daily ~= today, -- lot 15 : série de 7 jours (pastille rouge du menu Bonus)
		streak = l15 ~= nil and l15.streak.day or 1,
		l15 = l15,
		stolen = d.stolen,
		hatched = d.hatched,
		cine = d.cine,
		quests = d.quests,
		equip = d.equip,
		luckLeft = math.max(0, d.luckUntil - os.time()),
		story = { ch = d.story.ch, prog = d.story.prog },
		pity = d.pity,
		species = s.species,
		collection = Config.collectionBonus(s.species),
		runes = s.runes,
		hen = Hen and Hen.snapshot(s) or nil, -- énigme de la Mère Poule : étape, plumes, indices (lot 6) ; aucun indice n'est envoyé avant le ramassage de la plume
		puzzleDone = d.puzzle.day == today,
		puzzleSolved = d.puzzle.solved,
		ach = d.ach,
		stats = statValues(s),
		baseScore = d.baseScore,
		away = math.floor(d.pendingAway),
		battle = { pvp = { trophies = d.battle.pvp.trophies, season = d.battle.pvp.season, wins = d.battle.pvp.wins, losses = d.battle.pvp.losses, hasDefense = #d.battle.pvp.defense > 0, fightsLeft = math.max(0, Config.PVP.dailyFights - (d.battle.pvp.day == os.time() // 86400 and d.battle.pvp.fights or 0)) }, team = d.battle.team, best = d.battle.best, fightsLeft = math.max(0, Config.TOWER.dailyFights + Lot7.L16.arenaExtra(s) - (d.battle.day == os.time() // 86400 and d.battle.fights or 0)), repeatsLeft = math.max(0, Config.TOWER.dailyRepeats + Lot7.L16.arenaExtra(s) - (d.battle.day == os.time() // 86400 and d.battle.repeats or 0)),
			duel = { w = d.battle.duel and d.battle.duel.w or 0, l = d.battle.duel and d.battle.duel.l or 0 }, pve = { w = d.battle.pve and d.battle.pve.w or 0, l = d.battle.pve and d.battle.pve.l or 0 }, league = L15.Duel.leagueText(Config.LEAGUES, d.battle.pvp.trophies) }, -- lot 13 : ratios duel / PvE, ligue
		baseLevel = s.baseLevel,
		welcome = s.welcome, -- œuf de bienvenue du tapis : wait / offered / taken / gone / none (onboarding)
		newbie = s.newbie == true, -- protection débutant active (lot 4)
		tokens = d.tokens.remoteSteal, -- lot 7 : jetons du Corbeau, réglage, journal « Qui m'a volé ? », offres masquées (PolicyService), bonus serveur, œufs du tapis privé
		ravenLeft = Lot7.ravenLeft and Lot7.ravenLeft(s) or 0,
		settings = { blockFriendRavens = d.settings.blockFriendRavens == true, duelOff = d.settings.duelOff == true },
		stealLog = d.stealLog,
		restricted = s.restricted ~= false, -- vrai tant que PolicyService n'a pas confirmé « non restreint » (repli prudent : offres à hasard masquées)
		srv = Lot7.serverBuffs and Lot7.serverBuffs() or { golden = 0, luck = 0 },
		pbCount = #d.pb,
		cal = Lot7.Cal.snapshot and Lot7.Cal.snapshot(s) or nil, -- lot 9b : vue du calendrier (le jour est décidé ICI, jamais par le client)
		l16 = Lot7.L16.view and Lot7.L16.view(s) or nil, -- lot 16 : achats uniques, saison (résumé), débordement, Double chance, pose, tickets d'arène
		onb = L15.Onb.view(s.data.onb, os.time()), -- lot 17 : étape de l'onboarding { index, total, text, target, prog, goal } ; nil = terminé, passé ou coupé
	}
end

local function pushStats(s)
	local d = s.data
	local p = s.player
	p:SetAttribute("Coins", d.coins)
	p:SetAttribute("Speed", d.speed)
	p:SetAttribute("Income", income(s))
	s.lsCoins.Value = math.floor(math.min(d.coins, 9e15))
	s.lsSpeed.Value = math.floor(d.speed)
	s.lsRb.Value = d.rb
	s.lsRank.Value = Config.rankFor(d.story.ch).name
end

local function sync(s)
	pushStats(s)
	RState:FireClient(s.player, snapshot(s))
end

---------------------------------------------------------------- Vigilance des territoires et protection débutant (lot 4)
-- Vols réussis par territoire (horodatages os.clock) : Guard.vigilance en tire le bonus de vue et d'ouïe des gardiens de CE territoire.
local vigilSteals = {}
local function recordSteal(terr)
	local now = os.clock()
	local list = Guard.vigilancePrune(vigilSteals[terr] or {}, now, Config.VIGILANCE)
	list[#list + 1] = now
	vigilSteals[terr] = list
end
local function vigilanceOf(terr)
	return Guard.vigilance(vigilSteals[terr] or {}, os.clock(), Config.VIGILANCE)
end
-- Protection débutant : moins de Config.NEWBIE.minutes de jeu cumulées ET maison sous le niveau Config.NEWBIE.untilLevel (sauf fin anticipée).
local function isNewbie(s)
	return Config.isNewbie(s.data.played, s.baseLevel, s.data.newbieOff)
end

---------------------------------------------------------------- Vitesse / étourdissement
-- Rarétés des œufs portés (liste d'indices) : le poids du portage dépend de la rareté (Config.CARRY.weight, produit, plancher 0,70).
local function carryTiers(s)
	local out = {}
	for i, e in ipairs(s.carry) do
		out[i] = e.t
	end
	return out
end
-- Boue (Mara) : vitesse x Config.TRAPS.mudMul tant que le joueur est encore « embourbé » dans l'un des territoires (états de Traps par territoire).
local function mudMulOf(s)
	local m = 1
	local now = os.clock()
	for _, ps in pairs(s.traps or {}) do
		m = math.min(m, Traps.mudMul(ps, now, Config.TRAPS))
	end
	return m
end
local function applySpeed(s)
	local hum = getHum(s.player)
	if hum and s.stun <= 0 then
		local ws = Config.walkSpeed(s.data.speed) * speedMul(s) * Config.carryMul(carryTiers(s)) * mudMulOf(s) * ((s.slowUntil or 0) > os.clock() and Config.INTRUDER.dogMul or 1)
		if math.abs(hum.WalkSpeed - ws) > 0.05 then
			hum.WalkSpeed = ws
		end
	end
end

---------------------------------------------------------------- Badge débutant, porte de base (lot 4)
-- Met à jour la protection débutant d'un joueur : attribut `Newbie` (le client l'affiche), badge 🐣 au-dessus de la tête (recréé après chaque réapparition).
local function refreshNewbie(s)
	local nb = isNewbie(s)
	if nb ~= s.newbie then
		local was = s.newbie
		s.newbie = nb
		s.player:SetAttribute("Newbie", nb)
		if was == true and not nb then
			notify(s.player, "⚔️ Protection débutant terminée : tu peux voler les autres joueurs, et ils peuvent te voler.")
		end
	end
	local char = s.player.Character
	local adornee = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if nb and adornee and not (s.badge and s.badge.Parent and s.badge.Adornee == adornee) then -- recréé après chaque réapparition (nouveau personnage)
		if s.badge then
			s.badge:Destroy()
			s.badge = nil
		end
		do
			local gui = Instance.new("BillboardGui")
			gui.Name = "NewbieBadge"
			gui.Adornee = adornee
			gui.Size = UDim2.fromOffset(44, 44)
			gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
			gui.MaxDistance = 80
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Enum.Font.GothamBold
			t.TextSize = 30
			t.Text = "🐣"
			t.Parent = gui
			gui.Parent = adornee
			s.badge = gui
		end
	elseif not nb and s.badge then
		s.badge:Destroy()
		s.badge = nil
	end
end

-- Barrière lumineuse de la porte de base : un mur de lumière sur le bord de la base qui regarde la place (aucune collision : le serveur refuse le vol).
local function setDoorBarrier(s, on)
	if on and not s.doorPart and s.plot then
		local half = math.max(s.plot.platform.Size.X / 2, (Config.baseExtent(s.baseLevel or 1)))
		local p = Instance.new("Part")
		p.Name = "DoorBarrier"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 120, 90)
		p.Transparency = 0.6
		p.Size = Vector3.new(half * 2, 7, 0.4)
		p.CFrame = s.plot.cf * CFrame.new(0, 4.5, -(half + 0.2))
		p.Parent = s.plot.model
		s.doorPart = p
	elseif not on and s.doorPart then
		s.doorPart:Destroy()
		s.doorPart = nil
	end
end

---------------------------------------------------------------- Œufs portés
local function rebuildCarry(s)
	s.player:SetAttribute("Carry", #s.carry) -- le client évite les plans de caméra quand un œuf est porté
	for _, p in ipairs(s.carryParts) do
		p:Destroy()
	end
	s.carryParts = {}
	local char = s.player.Character
	local root = getRoot(s.player)
	if not (char and root) then
		return
	end
	for i, e in ipairs(s.carry) do
		local egg = Builder.egg(e.t, false)
		egg.Massless = true
		local off = CFrame.new(0, 3.4 + (i - 1) * 1.8, 0)
		egg.CFrame = root.CFrame * off
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = egg
		w.C0 = off
		w.Parent = egg
		egg.Parent = char
		CollectionService:AddTag(egg, "CarryEgg") -- balancement pendant la course (client)
		s.carryParts[i] = egg
	end
	-- colonne de lumière : le porteur d'un œuf Légendaire ou plus est visible de loin (BillboardGui, portée Config.CARRY.beamRange, détruit avec les œufs)
	local top = 0
	for _, e in ipairs(s.carry) do
		top = math.max(top, e.t)
	end
	if top >= Config.CARRY.beamTier then
		local gui = Instance.new("BillboardGui")
		gui.Name = "CarryBeam"
		gui.Adornee = root
		gui.Size = UDim2.fromOffset(22, 640)
		gui.ExtentsOffset = Vector3.new(0, 0.5, 0)
		gui.MaxDistance = Config.CARRY.beamRange
		gui.AlwaysOnTop = true
		local col = Instance.new("Frame")
		col.Name = "Column"
		col.Size = UDim2.fromScale(1, 1)
		col.BorderSizePixel = 0
		col.BackgroundColor3 = Config.TIERS[top].color
		col.BackgroundTransparency = 0.25
		col.Parent = gui
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		fade.Parent = col
		gui.Parent = root
		s.carryParts[#s.carryParts + 1] = gui
	end
end

---------------------------------------------------------------- Nids des rivaux
local function setNestEgg(n, tier)
	n.egg = tier
	if n.eggPart then
		n.eggPart:Destroy()
		n.eggPart = nil
	end
	if not tier then
		return
	end
	local egg = Builder.egg(tier, true)
	egg.CFrame = CFrame.new(n.pos)
	egg:SetAttribute("Guarded", Config.TERR[n.terr] ~= nil and (Config.TERR[n.terr].guards or 0) > 0) -- lot graphismes 4 : bulle « nid surveillé » côté client
	egg.Parent = n.folder
	n.eggPart = egg
	CollectionService:AddTag(egg, "EggShake") -- animé côté client (rebond ; pas d'attribut Ends = pas de tremblement)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Voler l'œuf"
	pr.ObjectText = "Œuf " .. Config.TIERS[tier].name
	pr.HoldDuration = Config.stealTime(0, n.terr) -- temps de vol propre au territoire (sauvage 0,8 / Gus 1,3 / Mara 2,2 / Zed 3,5)
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Terr", n.terr)
	pr:SetAttribute("Kind", "Nest")
	pr:SetAttribute("Nest", n.index)
	pr:SetAttribute("Rival", n.rival) -- le client masque le prompt tant que la zone est verrouillée
	pr.Parent = egg
	CollectionService:AddTag(pr, "StealPrompt")
	Builder.sign(egg, Config.TIERS[tier].name, Config.TIERS[tier].color, 3, 160)
end

for i, n in ipairs(world.nests) do
	n.index = i
	setNestEgg(n, wpick(Config.foldWeights(n.weights or Config.RIVALS[n.rival].weights))) -- enclos sauvage : poids propres (Config.TERR.wild)
end

---------------------------------------------------------------- Pads d'une base
local hatch, speedUpEgg -- déclarations anticipées

local function clearPad(s, i)
	local pad = s.plot.pads[i]
	if pad.content then
		local gp = pad.content:GetAttribute("GuardParts")
		if s.guardBudget and gp then
			s.guardBudget.used = math.max(0, s.guardBudget.used - gp)
		end
		pad.content:Destroy()
		pad.content = nil
	end
	s.labels[i] = nil
end

local function refreshPad(s, i, animate)
	clearPad(s, i)
	local d = s.data
	local pad = s.plot.pads[i]
	local locked = i > cap(s)
	pad.locked = locked
	pad.lock.Enabled = locked
	if locked then
		local lbl = pad.lock:FindFirstChild("Text")
		if lbl then
			lbl.Text = Config.slotHint(i, cap(s), s.data.up.slots, s.baseLevel or 1, s.passes.ExtraSlots == true) -- cadenas + coût du prochain emplacement
		end
	end
	pad.part.Transparency = locked and 0.25 or 0.7
	pad.part.Color = locked and Color3.fromRGB(40, 40, 45) or Color3.new(1, 1, 1)
	pad.frame.Color = locked and Color3.fromRGB(50, 52, 58) or s.plot.color
	pad.frame.Material = locked and Enum.Material.SmoothPlastic or Enum.Material.Neon
	local sl = d.slots[i]
	if locked or not sl then
		return
	end
	local content = Instance.new("Model")
	content.Name = "Content"
	content.Parent = pad.part
	pad.content = content

	if sl.k == "e" then
		local egg = Builder.egg(sl.t, true)
		egg.CFrame = pad.part.CFrame * CFrame.new(0, 1.9, 0)
		egg:SetAttribute("Ends", sl.ends)
		egg:SetAttribute("ShieldUntil", type(sl.shield) == "number" and sl.shield or 0) -- lot graphismes 4 : bulle de protection côté client tant que le bouclier dure
		CollectionService:AddTag(egg, "EggShake")
		egg.Parent = content
		s.guardBudget = s.guardBudget or { used = 0 }
		Builder.nest(pad.part.Position + Vector3.new(0, 0.3, 0), content, sl.t, s.guardBudget) -- l'œuf repose sur une protection selon sa rareté
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Voler l'œuf"
		pr.ObjectText = "Œuf de " .. s.player.DisplayName
		pr.HoldDuration = Config.stealTime(0)
		pr.MaxActivationDistance = 10
		pr.RequiresLineOfSight = false
		pr:SetAttribute("Kind", "Pad")
		pr:SetAttribute("Owner", s.player.UserId)
		pr:SetAttribute("Slot", i)
		pr.Parent = egg
		CollectionService:AddTag(pr, "StealPrompt")
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 40
		cd.Parent = egg
		cd.MouseClick:Connect(function(who)
			speedUpEgg(s, i, who)
		end)
		s.labels[i] = Builder.sign(egg, "", Config.TIERS[sl.t].color, 3, 200)
	else
		local model, lift, labelY = Builder.pet(sl.p, sl.s, sl.m, sl.f) -- idée 2 : forme 2 (agrandie, anneau)
		model.Parent = content
		model:PivotTo(pad.part.CFrame * CFrame.new(0, 0.2 + lift, 0))
		CollectionService:AddTag(model, "Bob")
		model:SetAttribute("Seed", i * 17 + sl.p) -- désynchronise les clignements et les regards entre pets
		if animate then
			model:SetAttribute("Born", workspace:GetServerTimeNow())
			CollectionService:AddTag(model, "PopIn")
		end
		s.labels[i] = Builder.sign(model.PrimaryPart, "", Config.TIERS[Config.PETS[sl.p].tier].color, labelY, 220)
	end
end

local function refreshAllPads(s)
	for i = 1, Config.SLOTS_MAX do
		refreshPad(s, i)
	end
end

-- Capacité modifiée (niveau de maison, pass) : seuls les emplacements dont l'état verrouillé change, ou qui affichent un coût, sont rafraîchis ;
-- les emplacements occupés ne sont JAMAIS recréés.
local function refreshLocks(s)
	local c = cap(s)
	for i = 1, Config.SLOTS_MAX do
		local pad = s.plot.pads[i]
		if pad and (pad.locked ~= (i > c) or i == c + 1 or pad.hintShown) then
			refreshPad(s, i)
			pad.hintShown = (i > c) and i == c + 1 or nil
		end
	end
end

---------------------------------------------------------------- Retour / chute des œufs portés
local function returnEgg(e)
	if e.rival then
		local home = e.nest and world.nests[e.nest]
		if home then -- l'œuf regagne SON nid (même si un autre œuf y est réapparu entre-temps : le nid est remis tel qu'il était)
			setNestEgg(home, e.t)
			return
		end
		for pass = 1, 2 do -- d'abord un nid libre de SON territoire (clé `terr`), à défaut n'importe quel nid libre du même rival
			for _, n in ipairs(world.nests) do
				if n.rival == e.rival and not n.egg and (pass == 2 or n.terr == e.terr) then
					setNestEgg(n, e.t)
					return
				end
			end
		end
	elseif e.from then
		local vp = Players:GetPlayerByUserId(e.from)
		local vs = vp and sessions[vp]
		if vs then
			local i = freeSlot(vs)
			if i then
				vs.data.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(vs), rv = e.rv, rvAt = e.rvAt, og = e.og } -- vitrine : l'origine suit l'œuf
				refreshPad(vs, i)
				notify(vs.player, "🥚 Ton œuf t'a été rendu !")
				sync(vs)
			end
		end
	end
end

local function dropCarry(s)
	if #s.carry == 0 then
		return
	end
	for _, e in ipairs(s.carry) do
		if e.belt and (e.paid or 0) > 0 then
			s.data.coins += e.paid -- œuf du tapis perdu en route : les pièces sont rendues (il n'a pas de nid d'origine)
			notify(s.player, "🪙 Œuf du tapis perdu : " .. Config.fmt(e.paid) .. " 🪙 rendues.")
		end
		returnEgg(e)
	end
	s.carry = {}
	rebuildCarry(s)
	applySpeed(s)
	if s.player.Parent then
		sync(s)
	end
end

local function afterTake(s, msg, sfx)
	rebuildCarry(s)
	applySpeed(s)
	sync(s)
	notify(s.player, msg or "🥚 Œuf volé ! Rapporte-le vite à ta base.", sfx or "steal")
end

---------------------------------------------------------------- Pets suiveurs (le déplacement est calculé côté client, le serveur ne fait que créer les modèles)
local followersFolder = Instance.new("Folder")
followersFolder.Name = "Followers"
followersFolder.Parent = workspace

local function clearFollowers(s)
	for _, m in ipairs(s.followers) do
		m:Destroy()
	end
	s.followers = {}
end

local function rebuildFollowers(s)
	clearFollowers(s)
	local d = s.data
	local clean = {}
	for _, i in ipairs(d.equip) do
		local sl = validSlot(i) and d.slots[i]
		if sl and sl.k == "p" then
			clean[#clean + 1] = i
		end
	end
	d.equip = clean
	local root = getRoot(s.player)
	if not root or not alive(s.player) then
		return
	end
	for n, i in ipairs(d.equip) do
		local sl = d.slots[i]
		local m = Builder.follower(sl.p, sl.s, sl.m, sl.f)
		m.Name = "Follower"
		m:SetAttribute("OwnerId", s.player.UserId)
		m:SetAttribute("Idx", n)
		m:PivotTo(root.CFrame * CFrame.new((n - 2) * 3, -2, 4))
		m.Parent = followersFolder
		CollectionService:AddTag(m, "Follower")
		s.followers[#s.followers + 1] = m
	end
end

---------------------------------------------------------------- Annonces (ce serveur + tous les serveurs)
local function announce(text)
	for _, pl in ipairs(Players:GetPlayers()) do
		notify(pl, text)
	end
	task.spawn(function()
		pcall(function()
			MessagingService:PublishAsync("ChipeAnnounce", { sid = Data.SERVER_ID, text = text })
		end)
	end)
end
task.spawn(function() -- SubscribeAsync attend le réseau : ne pas bloquer le démarrage du serveur
	pcall(function()
		MessagingService:SubscribeAsync("ChipeAnnounce", function(msg)
			local m = msg.Data
			if type(m) == "table" and m.sid ~= Data.SERVER_ID and type(m.text) == "string" then
				for _, pl in ipairs(Players:GetPlayers()) do
					notify(pl, m.text)
				end
			end
		end)
	end)
end)

---------------------------------------------------------------- Progression de la base (niveau d'après le score pondéré par la rareté)
-- Niveau de maison d'après le score pondéré par la rareté, la rareté découverte (niveaux 7 et 8) et le plancher sauvegardé (jamais de recul).
local function levelOf(s)
	return Config.baseLevel(s.data.baseScore, s.data.dex, s.data.baseLevelFloor)
end
-- Reconstruit l'apparence de la base au niveau courant et publie le niveau (attributs lus par le client : animation de montée de niveau, interface).
-- Une vraie montée (célébration demandée, niveau supérieur à celui déjà construit) lance l'animation : l'ancienne maison reste le temps de l'effet (Config.UPGRADE_FX),
-- les pads ne sont pas recréés (refreshLocks). `force` reconstruit sans animation (modèles Blender arrivés, renaissance).
-- Lot 8B-meubles : meubles des lots 18 et 19 dans la maison BaseUpgrade que Builder.baseUpgrade vient de créer. Repère : attributs DecorY / DecorZ
-- posés par Builder (centre du bâtiment au plancher, repère de plot.cf). Idempotent (HouseDecor), part avec la maison quand elle est démolie.
function K8.houseDecor(plot, level)
	local house = plot and plot.model and plot.model:FindFirstChild("BaseUpgrade")
	if not house then
		return
	end
	local y, z = house:GetAttribute("DecorY"), house:GetAttribute("DecorZ")
	task.spawn(function()
		local ok, err = pcall(K8.HouseDecor.apply, house, level, {
			offset = { 0, type(y) == "number" and y or 1.6, type(z) == "number" and z or 0 }, data = K8.HouseDecorData, useAssets = Config.Assets.Enabled == true,
		})
		if not ok then
			warn("[HouseDecor] " .. tostring(err))
		end
	end)
end
local function applyBase(s, celebrate, force)
	local level = levelOf(s)
	local before = s.baseLevel
	s.baseLevel = level
	local built = s.baseBuilt
	local rose = celebrate and built ~= nil and level > built
	if s.plot and (built ~= level or force) then
		Builder.baseUpgrade(s.plot, level, rose and { animate = true } or nil)
		s.baseBuilt = level
		K8.houseDecor(s.plot, level) -- lot 8B-meubles : décor intérieur cumulé du niveau, posé sur la nouvelle maison (hors du thread courant : LoadAsset cède la main)
		if rose then
			local plot = s.plot
			task.delay(Config.UPGRADE_FX.seconds, function()
				if plot.upgrading then
					Builder.finishUpgrade(plot)
				end
			end)
		end
	end
	if before ~= nil and level > before then
		tele.log(s.player, "house_level_reached", s.data.played, "_l" .. level)
	end
	if s.plot and before ~= level then
		refreshLocks(s) -- la capacité dépend du niveau : cadenas et coûts à jour, pets déjà posés intacts
	end
	s.player:SetAttribute("BaseLevel", level)
	s.player:SetAttribute("BaseScore", s.data.baseScore)
	if rose or (celebrate and before and level > before) then
		local lv = Config.BASE_LEVELS[level]
		local text = Config.upgradeBanner(level)
		local player = s.player
		-- la bannière, la fanfare et les confettis arrivent au début de la fête (après échafaudage, poussière et échange des maisons : 2,7 s)
		task.delay(Config.UPGRADE_FX.scaffold + Config.UPGRADE_FX.dust + Config.UPGRADE_FX.swap, function()
			notify(player, text, "levelup")
		end)
		if level >= Config.UPGRADE_FX.announceFrom then
			announce("🏠 " .. player.DisplayName .. " passe au niveau " .. level .. " : " .. lv.emoji .. " " .. lv.name .. " !")
		end
		sync(s)
	end
end

-- Les modèles Blender arrivent APRÈS l'entrée des premiers joueurs : une fois un groupe chargé, on reconstruit la base et les pads déjà affichés
-- (sinon le repli procédural resterait visible jusqu'au prochain changement de niveau).
onAssetsLoaded = function()
	for _, s in pairs(sessions) do
		pcall(function()
			applyBase(s, false, true)
			refreshAllPads(s)
		end)
	end
end

---------------------------------------------------------------- Éclosion
-- Lot 10 : annonces d'un tirage d'après Odds.fx. Monde (N >= 1 000 000 ou rareté >= Secret) et ancienne règle (bandeau serveur, mutation >= Alien, Colossal) :
-- tous les serveurs ; serveur seul : N >= 10 000 ou Ultra Rare ; panneau « 1 sur N » au-dessus du pad pendant quelques secondes dès N >= 1 000 (visible de tous).
function Lot7.oddsAnnounce(s, i, def, p, odds, fx)
	local text = "🌟 " .. s.player.DisplayName .. " vient d'obtenir " .. def.emoji .. " " .. Config.petName(p.p, p.s, p.m) .. " !" .. (odds and (" (" .. Lot7.Odds.label(odds) .. ")") or "")
	if Config.tierAtLeast(def.tier, "serverBanner") or p.m >= 5 or p.s == 5 or fx.announceWorld then
		announce(text)
	elseif fx.announceServer then
		for _, pl in ipairs(Players:GetPlayers()) do
			notify(pl, text)
		end
	end
	local pad = s.plot and s.plot.pads[i]
	if fx.billboard and Config.HATCH_FX.Enabled and pad and pad.part then
		pcall(function()
			local bb = Instance.new("BillboardGui")
			bb.Name = "OddsBillboard"
			bb.Size = UDim2.fromOffset(220, 44)
			bb.StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 160
			local lab = Instance.new("TextLabel")
			lab.Size = UDim2.fromScale(1, 1)
			lab.BackgroundTransparency = 1
			lab.Font = Enum.Font.GothamBold
			lab.TextScaled = true
			lab.Text = "✦ " .. Lot7.Odds.label(odds) .. " ✦"
			lab.TextColor3 = Config.TIERS[def.tier].color
			lab.TextStrokeTransparency = 0
			lab.Parent = bb
			bb.Parent = pad.part
			game:GetService("Debris"):AddItem(bb, Config.HATCH_FX.billboardSeconds)
		end)
	end
end

function hatch(s, i)
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	local eggT = Config.debugForceTier(RunService:IsStudio()) or sl.t -- A9 : Config.Debug.forceHatch, Studio seulement (nil en production)
	local guaranteed = Config.PITY_ENABLED and eggT <= Config.UPGRADE.maxEggTier and d.pity >= Config.PITY_EVERY - 1
	local p, upPoints, alienBoost, open = rollPet(s, eggT, guaranteed)
	local oneIn = Reveal.oneIn(Config, Rules, eggT, upPoints, alienBoost, p.p, p.s, p.m, guaranteed, open)
	if p.tier > eggT then
		d.pity = 0
	elseif eggT <= Config.UPGRADE.maxEggTier then
		d.pity += 1
	end
	local firstOfTier = true -- lot 9 (mesure) : première fois que cette rareté est obtenue ?
	for k, e in pairs(d.dex) do
		local dd = Config.PETS[tonumber(k) or 0]
		if dd and dd.tier == p.tier and type(e) == "table" and type(e.n) == "number" and e.n > 0 then
			firstOfTier = false
		end
	end
	-- lot 10 : compteur « 1 sur N » de référence calculé UNE fois ici et figé dans le slot (jamais recalculé ; aucun bonus n'entre dans le calcul)
	local odds = Lot7.Odds.forPet(Config, p.p, p.s, p.m)
	d.slots[i] = { k = "p", p = p.p, s = p.s, m = p.m, o = odds, ov = odds and Config.ODDS.version or nil }
	L15.qk(s, "hatch", { odds = odds }) -- A11 : quête « 1 sur 1 000 ou plus rare » (compteur de référence, sans bonus)
	d.hatched += 1
	if d.hatched == 1 then
		tele.log(s.player, "first_hatch_seconds", d.played)
		tele.event(s.player, "onboarding", "first_hatch") -- lot 16 (I.2)
	end
	if Lot7.L16.hatchQualifies(p.tier) then
		Lot7.L16.addXp(s, "hatch") -- lot 16 : éclosion Épique ou mieux
	end
	if firstOfTier then
		tele.log(s.player, "tier_first_reached", d.played, "_r" .. p.tier)
		if Config.TIERS[p.tier] and Config.TIERS[p.tier].name == "Légendaire" then
			s.l16Legend = os.time() -- lot 16 : première éclosion Légendaire (déclencheur d'offre « Double chance », valable 10 min)
			Lot7.L16.event(s, "firstLegend")
		end
	end
	tele.log(s.player, "hatch_tier", 1, "_r" .. p.tier)
	d.baseScore += Config.baseGain(p.tier) -- la base grandit avec chaque pet éclos, d'autant plus que le pet est rare
	local key = tostring(p.p)
	local dx = d.dex[key]
	if not dx then
		dx = { n = 0, b = 0 }
		d.dex[key] = dx
		s.species += 1
		qp(s, "discover", 1)
	end
	dx.n += 1
	dx.b = math.max(dx.b, Config.SIZES[p.s].mult * Config.MUTS[p.m].mult)
	if Config.SHOWCASE.enabled and L15.SC.originOk(sl.og) and L15.SC.featured(p.p, os.time()) then -- idée 3 : espèce en vitrine, œuf GAGNÉ (origine figée sl.og) ; le DataStore ne bloque jamais l'éclosion
		task.spawn(function()
			local okStore, store = pcall(function()
				return game:GetService("DataStoreService"):GetDataStore(Config.SHOWCASE.storeName)
			end)
			if okStore and s.player.Parent then
				local r = L15.SC.tryClaim(store, d.showcase, p.p, { userId = s.player.UserId, name = s.player.DisplayName, og = sl.og }, os.time(), task.wait)
				if r == "won" then
					notify(s.player, "🏆 Vitrine du jour : " .. Config.PETS[p.p].name .. " ! +5 % de revenus pendant 24 h.", "claim")
				end
			end
		end)
	end
	refreshPad(s, i, true)
	qp(s, "hatch", 1)
	local def = Config.PETS[p.p]
	L15.onHatch(s, def.tier) -- lot 15 : quête bonus « éclosion Épique+ », calme des PNJ après une grande révélation
	sp(s, "hatch", 1)
	applyBase(s, true)
	sp(s, "tier", 1, { tier = def.tier })
	if p.m > 1 then
		sp(s, "mut", 1)
	end
	if Config.tierAtLeast(def.tier, "shine") then
		qp(s, "rare", 1)
	end
	storyRefresh(s)
	local big = Config.tierAtLeast(def.tier, "announce") or p.m > 1 or p.s >= 4
	local col = Config.MUTS[p.m].color or Config.TIERS[def.tier].color
	Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 3, 0), col, big and 90 or 25, big)
	-- Rareté élevée ou tirage secret : cercle runique au sol, particules, pilier de lumière et contour lumineux du pet (Config.AURA)
	local oddsFx = Lot7.Odds.fx(odds, def.tier, Config) -- lot 10 : annonces sociales (serveur, monde, pilier, panneau au-dessus du pad)
	local secretHit = oneIn >= Config.REVEAL.secret.oneInAtLeast or oddsFx.pillar
	if Config.AURA.Enabled and (def.tier >= Config.AURA.minTier or secretHit) then
		Builder.aura(s.plot.pads[i].part.Position, col, def.tier, secretHit)
		local holder = s.plot.pads[i].content
		local petModel = holder and holder:FindFirstChild("Pet")
		if Config.AURA.highlight and petModel then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 1
			hl.OutlineColor = col
			hl.OutlineTransparency = 0.1
			hl.Parent = petModel
			game:GetService("Debris"):AddItem(hl, Config.AURA.seconds)
		end
	end
	RHatch:FireClient(s.player, { p = p.p, s = p.s, m = p.m, slot = i, inc = Config.petIncome(p.p, p.s, p.m) * gmult(s), oneIn = oneIn < math.huge and oneIn or 0, egg = eggT, upgraded = p.tier > eggT, o = odds, first = firstOfTier })
	Lot7.oddsAnnounce(s, i, def, p, odds, oddsFx)
	sync(s)
end

function speedUpEgg(s, i, who)
	if who ~= s.player then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	Lot7.chase(s, i) -- un corbeau vise cet œuf : le toucher (dans sa base) le chasse
	local now = os.clock()
	if now - s.lastTap < 0.12 then
		return
	end
	s.lastTap = now
	sl.ends -= 1
	local content = s.plot.pads[i].content
	local eggPart = content and content:FindFirstChild("Egg")
	if eggPart then
		eggPart:SetAttribute("Ends", sl.ends)
	end
	if os.time() >= sl.ends then
		hatch(s, i)
	end
end

---------------------------------------------------------------- Vol (nids PNJ et bases des joueurs)
-- Le serveur mesure lui-même la durée de maintien du bouton (le client ne fait qu'afficher la barre).
local holds = {}
local pendingCharges = {} -- lot 8A : alarmes de nid en attente { player, terr, at } (Mara et Zed ; traitées par guardsStep)
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
	holds[player] = { prompt = prompt, t = os.clock() }
	local s = sessions[player]
	if s then
		s.holdSeen = true
	end
end)

-- Secrets de la carte : une récompense par jour et par secret, distance et existence vérifiées côté serveur.
local function claimSecret(s, root, prompt)
	local id = prompt:GetAttribute("SecretId")
	local sct = type(id) == "string" and Config.secret(id)
	local holder = prompt.Parent
	if not sct or not holder or not holder:IsA("BasePart") or (root.Position - holder.Position).Magnitude > 18 then
		return
	end
	local today = os.time() // 86400
	if s.data.secrets[sct.id] == today then
		notify(s.player, "💤 Tu as déjà fouillé ici aujourd'hui. Reviens demain !")
		return
	end
	local reward = Config.secretReward(sct, income(s))
	s.data.secrets[sct.id] = today
	s.data.coins += reward
	Builder.burst(holder.Position, Color3.fromRGB(255, 214, 90), 24, true)
	qp(s, "secret", 1)
	notify(s.player, sct.emoji .. " " .. sct.name .. " : +" .. Config.fmt(reward) .. " 🪙", "secret_decouvert") -- secret de la carte (lot 8A)
	sync(s)
end

-- Voyage rapide (Config.TRAVEL2) : le serveur valide TOUT (destination, portail débloqué, joueur vivant, hors combat, hors château, à moins de
-- maxDistance du portail, délai, AUCUN œuf porté : on ne téléporte jamais un œuf) ; la destination vient d'un attribut du prompt, jamais du client.
-- dest > 0 : portail k de la rose ; 0 : retour à la place ; -i : arche de la base i (réservée à son propriétaire).
local function fastTravel(s, dest, prompt)
	local root = getRoot(s.player)
	local T = Config.TRAVEL2
	if not root or not alive(s.player) or s.stun > 0 or s.castle then
		return false
	end
	if type(dest) ~= "number" or dest % 1 ~= 0 or dest < -Config.PLOT_COUNT or dest > #T.portals then
		return false
	end
	if not (prompt and prompt.Parent and prompt.Parent:IsA("BasePart")) or (root.Position - prompt.Parent.CFrame.Position).Magnitude > T.maxDistance + 1 then
		return false
	end
	local now = os.clock()
	if now - (s.travelAt or -99) < T.cooldown then
		return false
	end
	if s.sinceHit < T.combatLock or (s.battle and s.battle.duel) then -- lot 13 : pas de voyage pendant un duel (personnage figé sur le sable)
		notify(s.player, "⚔️ Pas de voyage rapide en plein combat.")
		return false
	end
	if T.blockWhileCarrying and #s.carry > 0 then
		notify(s.player, "🥚 Pas de portail avec un œuf : rapporte-le à pied !", "refuse")
		return false
	end
	local x, z
	if dest < 0 then
		local plot = s.plot
		if not plot or plot.index ~= -dest then
			notify(s.player, "🏠 Cette arche mène à la base d'un autre joueur.", "refuse")
			return false
		end
		local sp = plot.spawn.CFrame.Position
		x, z = sp.X, sp.Z
	else
		if dest > 0 and not Config.portalUnlocked(s.data.story.ch, dest) then
			notify(s.player, "🔒 Portail verrouillé : termine l'histoire jusqu'au chapitre " .. T.portals[dest].chapter .. ".", "refuse")
			return false
		end
		x, z = Config.travelDest(dest)
	end
	s.travelAt = now
	root.CFrame = CFrame.new(x, 4, z)
	root.AssemblyLinearVelocity = Vector3.zero
	s.noCheckUntil = now + 2
	s.lastPos = nil
	s.lastActive = now
	notify(s.player, "", "portal") -- son de portail
	return true
end

-- Lot 8B : kiosque central. Classement mis en cache 30 s (Data.pvpTop lit un DataStore : quota), quel que soit le nombre de joueurs.
function K8.topCached(season, n)
	local c = K8.top
	if c.season ~= season or os.clock() - c.at > 30 then
		c.at, c.season = os.clock(), season
		local ok, list = pcall(Data.pvpTop, season, n)
		c.list = (ok and type(list) == "table") and list or {}
	end
	return c.list
end
-- Un prompt du kiosque : TOUT est revalidé par Kiosk.handle (liste blanche d'actions, distance mesurée ici, pause par joueur). Un refus ne répond rien.
-- Le kiosque ne fait qu'ouvrir : réclamer le calendrier ou acheter passe par les chemins existants (RAction calClaim, achats Robux), déjà validés.
function K8.prompt(player, prompt)
	local res = K8.Kiosk.handle(player, prompt:GetAttribute("KioskAction"), {
		Config = Config,
		inRange = function(p)
			local r = getRoot(p)
			local info = K8.info
			if not (r and alive(p) and info and sessions[p]) then
				return false
			end
			local c = info.center
			return math.sqrt((r.Position.X - c.X) ^ 2 + (r.Position.Z - c.Z) ^ 2) <= K8.KioskData.SERVER_RANGE
		end,
		calView = function(p)
			local ss = sessions[p]
			return ss and Lot7.Cal.snapshot and Lot7.Cal.snapshot(ss) or nil
		end,
		top = K8.topCached,
		mine = function(p)
			local ss = sessions[p]
			local pv = ss and ss.data.battle and ss.data.battle.pvp
			return type(pv) == "table" and { trophies = pv.trophies, wins = pv.wins, losses = pv.losses } or nil
		end,
	})
	if res.ok then
		K8.remote:FireClient(player, res.payload)
	end
end
-- Pastille rouge du calendrier sur le kiosque : allumée dès qu'un joueur présent a une récompense réclamable (Calendar, via Lot7.Cal.snapshot). Toutes les 5 s.
task.spawn(function()
	while true do
		task.wait(5)
		if K8.info then
			local any = false
			for _, ss in pairs(sessions) do
				local okV, view = pcall(function()
					return Lot7.Cal.snapshot and Lot7.Cal.snapshot(ss) or nil
				end)
				if okV and K8.Kiosk.badgeNeeded(view) then
					any = true
					break
				end
			end
			K8.Kiosk.setBadge(K8.info, any)
		end
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	if CollectionService:HasTag(prompt, "BeltEgg") then
		beltBuy(player, prompt)
		return
	end
	if CollectionService:HasTag(prompt, "FastTravel") then
		local ss = sessions[player]
		if ss then
			fastTravel(ss, prompt:GetAttribute("Dest"), prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "KioskPrompt") then
		K8.prompt(player, prompt)
		return
	end
	if CollectionService:HasTag(prompt, "SellerPrompt") then
		-- lot 16 : vendeur PNJ -> ouvre la boutique sur SON onglet. Tout est revalidé par Sellers.handle (liste blanche, distance mesurée ici, pause par joueur).
		local res = K8.Sellers.handle(player, prompt:GetAttribute("SellerAction"), {
			Config = Config,
			inRange = function(p, id)
				local r = getRoot(p)
				return r ~= nil and alive(p) and sessions[p] ~= nil and K8.Sellers.inRange(K8.sellers, id, r.Position.X, r.Position.Z)
			end,
		})
		if res.ok then
			K8.remote:FireClient(player, res.payload)
		end
		return
	end
	if CollectionService:HasTag(prompt, "CastleEntry") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 and (rr.Position - prompt.Parent.Position).Magnitude <= 20 then
			castleEnter(ss)
		end
		return
	elseif CollectionService:HasTag(prompt, "CastleChest") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) then
			castleFinish(ss, rr, prompt)
		end
		return
	end
	if CollectionService:HasTag(prompt, "SecretPrompt") then
		local ss, rr = sessions[player], getRoot(player)
		if ss and rr and alive(player) and ss.stun <= 0 then
			claimSecret(ss, rr, prompt)
		end
		return
	end
	local kind = prompt:GetAttribute("Kind")
	if kind ~= "Nest" and kind ~= "Pad" and kind ~= "Rune" and kind ~= "RuneConfirm" and kind ~= "HenTalk" and kind ~= "Feather" and kind ~= "PrivBelt" then
		return
	end
	local s = sessions[player]
	local root = getRoot(player)
	if not s or not root or not alive(player) or s.stun > 0 then
		return
	end
	if kind == "PrivBelt" then
		Lot7.privTake(s, root, prompt) -- tapis privé : seul le propriétaire prend l'œuf (validé dans privTake)
		return
	end
	if kind == "Rune" or kind == "RuneConfirm" or kind == "HenTalk" or kind == "Feather" then
		if Hen then -- énigme de la Mère Poule (toutes les validations sont dans HenQuest)
			if kind == "Rune" then
				Hen.stoneTap(s, root, prompt)
			elseif kind == "RuneConfirm" then
				Hen.confirmRunes(s, root)
			elseif kind == "HenTalk" then
				Hen.talk(s, root)
			else
				Hen.pickFeather(s, root, prompt)
			end
		end
		return
	end
	local now = os.clock()
	if now - s.lastSteal < 0.3 then
		return
	end
	s.lastSteal = now
	if s.holdSeen then
		local h = holds[player]
		holds[player] = nil
		if not h or h.prompt ~= prompt or os.clock() - h.t < Config.stealTime(s.data.up.fing, prompt:GetAttribute("Terr")) * 0.7 then
			return
		end
	end
	if #s.carry >= carryCap(s.data) then
		notify(player, "Sac plein ! Rapporte tes œufs à ta base.")
		return
	end

	if kind == "Nest" then
		local n = world.nests[prompt:GetAttribute("Nest")]
		if not n or not n.egg or (root.Position - n.pos).Magnitude > 18 then
			return
		end
		local zone = Config.ZONES[n.rival]
		if not Config.zoneUnlocked(s.data.story.ch, n.rival) then
			notify(player, "🔒 " .. zone.name .. " : termine d'abord le chapitre " .. zone.chapter .. " de l'histoire.", "caught")
			return
		end
		local t = n.egg
		setNestEgg(n, nil)
		Builder.flyEgg(t, n.pos, player.UserId)
		Builder.burst(n.pos, Config.TIERS[t].color, 14, false)
		n.rt = rng:NextNumber(9, 16) * (1 + (n.rival - 1) * 0.3)
		s.carry[#s.carry + 1] = { t = t, rem = hatchTime(s, t), rival = n.rival, terr = n.terr, nest = n.index, fresh = Traps.freshDeadline(Config, t, n.terr, os.clock()), og = "g" } -- vitrine : œuf de nid = gagné en jouant
		recordSteal(n.terr) -- vigilance : les gardiens de ce territoire voient et entendent plus loin pendant un moment
		s.data.stolen += 1
		qp(s, "steal", 1)
		sp(s, "steal", 1, { rival = n.rival })
		local alarm = Config.TERR[n.terr] and Config.TERR[n.terr].nestAlarm
		if alarm then -- alarme du nid (Mara, Zed) : le gardien le plus proche chargera le voleur dans alarm.delay s (voir guardsStep)
			if #pendingCharges < 64 then -- borne de sécurité (une entrée par vol, purgée en alarm.delay s)
				pendingCharges[#pendingCharges + 1] = { player = player, terr = n.terr, at = os.clock() + alarm.delay }
			end
			afterTake(s, "🥚 Œuf chipé ! " .. (n.rival == 3 and "🐻 L'ours" or "🐺 Le loup") .. " a senti le nid se vider : file vers la sortie !")
		else
			afterTake(s)
		end
	else
		local vp = Players:GetPlayerByUserId(prompt:GetAttribute("Owner") or 0)
		local vs = vp and sessions[vp]
		local i = prompt:GetAttribute("Slot")
		if not vs or vs == s or type(i) ~= "number" then
			return
		end
		local sl = vs.data.slots[i]
		if not sl or sl.k ~= "e" then
			return
		end
		if isNewbie(s) then
			notify(player, "🐣 Protection débutant : tu ne peux pas encore voler d'autres joueurs (menu : « Je suis prêt pour le PvP »).")
			return
		end
		if isNewbie(vs) then
			notify(player, "🐣 Ce joueur est sous protection débutant : ses œufs ne peuvent pas être volés.")
			return
		end
		if (vs.lockUntil or 0) > os.clock() then
			notify(player, "🔒 La porte de cette base est fermée !")
			return
		end
		if (sl.shield or 0) > os.time() or (vs.graceUntil or 0) > os.time() then
			notify(player, "🛡 Cet œuf est encore protégé !")
			return
		end
		local pad = vs.plot.pads[i].part
		if (root.Position - pad.Position).Magnitude > 20 then
			return
		end
		vs.data.slots[i] = false
		refreshPad(vs, i)
		Builder.flyEgg(sl.t, pad.Position + Vector3.new(0, 2, 0), player.UserId)
		s.carry[#s.carry + 1] = { t = sl.t, rem = math.max(0, sl.ends - os.time()), from = vp.UserId, rv = sl.rv, rvAt = sl.rvAt, og = sl.og } -- rv/rvAt suivent l'œuf (lot 7b) ; og aussi (vitrine : un œuf payé volé reste payé)
		s.data.stolen += 1
		qp(s, "steal", 1)
		qp(s, "pvp", 1)
		sp(s, "steal", 1, {})
		notify(vp, "😡 " .. player.DisplayName .. " a volé ton œuf ! Rattrape-le !", "caught")
		Lot7.onPhysicalSteal(vs, player.DisplayName, sl.t) -- journal « Qui m'a volé ? » + bouclier post-vol de 5 min contre les corbeaux
		sync(vs)
		afterTake(s)
	end
end)

---------------------------------------------------------------- Gardiens PNJ : perception, états, dégâts non mortels (voir Guard.lua)
local GC = Config.GUARD

-- Réglages de perception propres à chaque gardien (délai de réaction : Gus 1,6 s, Mara 0,9 s, Zed 0,5 s).
local gcCache = {}
local function gcFor(rival)
	local c = gcCache[rival]
	if not c then
		c = setmetatable({ alertDelay = Config.RIVALS[rival].alertDelay or GC.alertDelay }, { __index = GC })
		gcCache[rival] = c
	end
	return c
end

local function setHp(s, hp)
	s.hp = hp
	s.player:SetAttribute("Hp", math.floor(hp + 0.5))
	s.player:SetAttribute("MaxHp", GC.maxHp)
end

-- Défaite (0 pv) : œufs portés rendus à leur nid, retour à la base avec tous les pv et une courte invulnérabilité. Jamais en un seul coup.
local function defeatAtBase(s)
	dropCarry(s)
	local root = getRoot(s.player)
	if root and s.plot then
		root.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end
	s.noCheckUntil = os.clock() + 2
	s.iframes, s.sinceHit = GC.respawnIframes, 0
	setHp(s, GC.maxHp)
	notify(s.player, "🏠 Tu as été vaincu : retour à ta base, œufs rendus, pv rétablis.", "caught")
end

local function hitPlayer(s, g)
	local r = g.stats
	if r.gentle then
		-- gardien clément (Gus) : jamais de dégâts ; la première prise renvoie à la base (la cargaison est gardée), puis 6 s de répit
		if os.clock() < (s.gentleUntil or 0) then
			return false
		end
		s.gentleUntil = os.clock() + GC.gentleRecover
		s.stun = GC.stun
		s.noCheckUntil = os.clock() + 2
		local root0 = getRoot(s.player)
		if root0 and s.plot then
			root0.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			root0.AssemblyLinearVelocity = Vector3.zero
		end
		notify(s.player, "🐕 " .. r.name .. " t'a attrapé, réessaie ! (aucun œuf ni pet perdu)", "hurt")
		return true
	end
	local hp, hit, inv = Guard.applyDamage(s.hp, r.damage, s.iframes, GC)
	if not hit then
		return false
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	s.stun = GC.stun
	s.noCheckUntil = os.clock() + 1.2
	local root, hum = getRoot(s.player), getHum(s.player)
	if hum then
		hum.PlatformStand = true
	end
	if root then
		local away = (root.Position - g.pos) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, 1)
		root.AssemblyLinearVelocity = away * GC.knockback + Vector3.new(0, 18, 0) -- recul
	end
	notify(s.player, "🐕 " .. r.name .. " t'a mordu : -" .. r.damage .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then
		defeatAtBase(s)
		return true
	end
	-- lot 8A (B.4 « prise par un gardien ») : le gardien qui CHARGE après l'alarme du nid reprend les œufs de SON territoire (ils regagnent leur nid)
	local back = false
	if g.charge == s.player then
		g.charge = nil
		for i = #s.carry, 1, -1 do
			local e = s.carry[i]
			if e.rival and e.terr == g.terr then
				table.remove(s.carry, i)
				returnEgg(e)
				back = true
			end
		end
	end
	if back then
		rebuildCarry(s)
		applySpeed(s)
		sync(s)
		notify(s.player, "↩️ " .. r.name .. " a repris l'œuf : il retourne à son nid.", "caught")
	end
	return true
end

-- Cible la plus proche dans la zone de perception maximale du gardien (seuls les joueurs dont le domaine est ouvert sont ciblables).
local function inPlot(s, root)
	local rel = s.plot.cf:PointToObjectSpace(root.Position)
	return Config.inBase(s.baseLevel or 1, rel.X, rel.Z, rel.Y) -- la plateforme grandit avec le niveau de la maison
end

-- Intrusion dans la base de `host` par `visitor` (D.2) : alarme (niveau 3, notification à l'hôte) et chien de garde (niveau 5, intrus ralenti x0,7 pendant 3 s).
-- Chaque effet a un délai de récupération ; aucun des deux ne bloque le vol (la porte de base et la protection débutant restent les règles de protection).
local function onIntrusion(host, visitor)
	local lv = Config.BASE_LEVELS[host.baseLevel or 1]
	if not lv then
		return
	end
	local now = os.clock()
	if lv.alarm and now - (host.lastAlarm or -99) >= Config.INTRUDER.alarmCooldown then
		host.lastAlarm = now
		notify(host.player, "🔔 Alarme : " .. visitor.player.DisplayName .. " est entré dans ta base !")
	end
	if lv.guardDog and now - (visitor.lastDog or -99) >= Config.INTRUDER.dogCooldown then
		visitor.lastDog = now
		visitor.slowUntil = now + Config.INTRUDER.dogSeconds
		applySpeed(visitor)
		notify(visitor.player, "🐕 Le chien de garde de " .. host.player.DisplayName .. " te ralentit !")
		task.delay(Config.INTRUDER.dogSeconds + 0.1, function()
			if visitor.player.Parent then
				applySpeed(visitor)
			end
		end)
	end
end

-- Zone de sécurité (A.5) : la base du joueur, toute la place du marché et les safeRadius studs autour de l'entrée du territoire du gardien ne sont
-- jamais ciblés.
local PLAZA = Config.Map2.plaza
local function safeSpot(s, root, g)
	if s.plot and inPlot(s, root) then
		return true
	end
	local p = root.Position
	if math.sqrt((p.X - PLAZA.x) ^ 2 + (p.Z - PLAZA.z) ^ 2) < PLAZA.r then
		return true
	end
	local ex, ez = Config.territoryEntry(g.terr)
	return math.sqrt((p.X - ex) ^ 2 + (p.Z - ez) ^ 2) < GC.safeRadius
end

local function candidate(g, r)
	local best, bd = nil, math.max(r.viewDist, r.hearRadius) + 2
	for player, s in pairs(sessions) do
		if Config.zoneUnlocked(s.data.story.ch, g.rival) and alive(player) then
			local root = getRoot(player)
			if root and not safeSpot(s, root, g) then
				local dd = math.sqrt((root.Position.X - g.pos.X) ^ 2 + (root.Position.Z - g.pos.Z) ^ 2)
				if dd < bd then
					best, bd = player, dd
				end
			end
		end
	end
	return best
end

-- Chemin : PathfindingService en tâche de fond (ComputeAsync cède) ; sans résultat, ligne droite (repli). Retourne le point visé.
local PathfindingService = game:GetService("PathfindingService")
local function aimPoint(g, goal, dt)
	g.pathT = (g.pathT or 0) - dt
	if g.pathT <= 0 and not g.pathBusy then
		g.pathT, g.pathBusy = GC.pathInterval, true
		local from = g.pos
		task.spawn(function()
			local ok, wps = pcall(function()
				local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false })
				path:ComputeAsync(from, goal)
				if path.Status ~= Enum.PathStatus.Success then
					return nil
				end
				local out = {}
				for _, w in ipairs(path:GetWaypoints()) do
					out[#out + 1] = w.Position
				end
				return out
			end)
			g.wps = ok and wps or nil
			g.pathBusy = false
		end)
	end
	if g.wps then
		while #g.wps > 0 and ((g.wps[1].X - g.pos.X) ^ 2 + (g.wps[1].Z - g.pos.Z) ^ 2) < 4 do
			table.remove(g.wps, 1)
		end
		if g.wps[1] then
			return Vector3.new(g.wps[1].X, g.pos.Y, g.wps[1].Z)
		end
	end
	return goal
end

local MARKS = { patrol = "", alert = "❓", chase = "❗", lostChase = "❓", ["return"] = "" }

for _, g in ipairs(world.guards) do -- marque d'état au-dessus de chaque gardien (❓ alerte, ❗ poursuite)
	local ok, label = pcall(Builder.sign, g.model.PrimaryPart, "", Color3.fromRGB(255, 230, 90), 7, 80)
	if ok then
		label.TextSize = 34
		g.mark = label
	end
end

-- Réglages de chaque gardien d'après SON territoire (Config.guardStats : vitesses, vue, ouïe, coup de Config.TERR ; Gus = son rival, clément).
for _, g in ipairs(world.guards) do
	g.stats = Config.guardStats(g.terr)
end

local function guardsStep(dt)
	for _, s in pairs(sessions) do -- invulnérabilité et temps depuis le dernier coup
		s.iframes = math.max(0, (s.iframes or 0) - dt)
		s.sinceHit = (s.sinceHit or 99) + dt
	end
	local nowc = os.clock()
	for i = #pendingCharges, 1, -1 do -- alarmes de nid échues (lot 8A) : le gardien du territoire le plus proche du voleur le charge
		local pc = pendingCharges[i]
		if nowc >= pc.at then
			table.remove(pendingCharges, i)
			local ps = sessions[pc.player]
			local proot = ps and alive(pc.player) and getRoot(pc.player)
			if proot then
				local best, bd = nil, math.huge
				for _, g in ipairs(world.guards) do
					if g.terr == pc.terr then
						local d = (Vector3.new(g.pos.X, 0, g.pos.Z) - Vector3.new(proot.Position.X, 0, proot.Position.Z)).Magnitude
						if d < bd then
							best, bd = g, d
						end
					end
				end
				if best and not safeSpot(ps, proot, best) then -- déjà à l'abri (entrée, place, base) : aucune charge
					best.st = Guard.charge(best.st)
					best.target, best.charge, best.wps = pc.player, pc.player, nil
					best.last = Vector3.new(proot.Position.X, best.pos.Y, proot.Position.Z)
					if best.mark then
						best.mark.Text = "❗"
					end
					local key = Config.guardSoundKey(Config.Assets.guardKinds[best.rival])
					for pl in pairs(sessions) do
						local pr = getRoot(pl)
						if pr and (pr.Position - best.pos).Magnitude < 60 then
							notify(pl, "", key)
						end
					end
				end
			end
		end
	end
	for _, g in ipairs(world.guards) do
		local r = g.stats
		local bonus = vigilanceOf(g.terr)
		if bonus ~= g.vigBonus or not g.rv then -- vue et ouïe majorées par la vigilance du territoire (recalculé seulement quand le bonus change)
			g.vigBonus, g.rv = bonus, Guard.boosted(r, bonus)
		end
		local rv = g.rv
		g.cd -= dt
		g.st = g.st or { state = "patrol", timer = 0, lost = 0 }
		g.look = g.look or Vector3.new(g.dir, 0, 0)
		-- perception de la cible (poursuivie ou la plus proche)
		local target = g.target
		local ts = target and sessions[target]
		if not (ts and alive(target) and getRoot(target) and Config.zoneUnlocked(ts.data.story.ch, g.rival)) then
			target, ts = nil, nil
		end
		if not target and (g.st.state == "patrol" or g.st.state == "alert" or g.st.state == "return") then
			g.scan = (g.scan or 0) - dt
			if g.scan <= 0 then
				g.scan = 0.15
				target = candidate(g, rv)
				ts = target and sessions[target]
			else
				target, ts = nil, nil
			end
		end
		local percept = { sees = false, hears = false, dist = math.huge, atHome = false }
		local troot = target and getRoot(target)
		if troot then
			local v = troot.AssemblyLinearVelocity
			local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
			percept = Guard.perceive(
				{ x = g.pos.X, z = g.pos.Z, fx = g.look.X, fz = g.look.Z },
				{ x = troot.Position.X, z = troot.Position.Z, speed = speed },
				rv, GC
			)
			if percept.sees or percept.hears then
				g.last = Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z)
			end
		end
		local home = Vector3.new(math.clamp(g.pos.X, g.cx - g.patrolHalf, g.cx + g.patrolHalf), g.pos.Y, g.patrolZ)
		percept.atHome = (home - g.pos).Magnitude < 1
		local prev = g.st.state
		local ev
		g.st, ev = Guard.nextState(g.st, dt, percept, gcFor(g.rival))
		local state = g.st.state
		if state ~= prev then
			if state == "alert" or state == "chase" then -- aboiement ou grognement pour les joueurs proches (une fois par changement d'état)
				local key = Config.guardSoundKey(Config.Assets.guardKinds[g.rival])
				for pl in pairs(sessions) do
					local pr = getRoot(pl)
					if pr and (pr.Position - g.pos).Magnitude < 60 then
						notify(pl, "", key)
					end
				end
			end
			local mark = g.mark
			if mark then
				mark.Text = MARKS[state] or ""
			end
			if state == "chase" or state == "patrol" or state == "return" then
				g.target = (state == "chase") and target or nil
			end
			if state ~= "chase" then
				g.charge = nil -- l'alarme du nid s'arrête avec la poursuite
			end
			if state == "chase" then
				g.target = target or g.target
			elseif state == "return" or state == "patrol" then
				g.target = nil
				g.wps = nil
			end
		end
		local look = nil
		local prevPos = g.pos
		local want = false -- le gardien DEVRAIT-il avancer ? (sert à la détection de blocage)
		if state == "patrol" then
			want = true
			g.pos += Vector3.new(g.dir * r.patrolSpeed * dt, 0, 0)
			if g.pos.X > g.cx + g.patrolHalf then
				g.dir = -1
			elseif g.pos.X < g.cx - g.patrolHalf then
				g.dir = 1
			end
			look = Vector3.new(g.dir, 0, 0)
		elseif state == "alert" then
			local to = g.last and (g.last - g.pos) or g.look -- s'arrête et se tourne vers le bruit ou la dernière position vue
			look = Vector3.new(to.X, 0, to.Z)
		elseif state == "chase" or state == "lostChase" then
			local goal = (state == "chase" and troot) and Vector3.new(troot.Position.X, g.pos.Y, troot.Position.Z) or g.last
			if goal then
				local aim = aimPoint(g, goal, dt)
				local dv = Vector3.new(aim.X - g.pos.X, 0, aim.Z - g.pos.Z)
				want = (goal - g.pos).Magnitude > GC.attackRange
				if dv.Magnitude > 0.01 then
					look = dv.Unit
					g.pos += look * math.min(dv.Magnitude, r.guardSpeed * dt)
				end
				local flat = Vector3.new(goal.X - g.pos.X, 0, goal.Z - g.pos.Z)
				if state == "chase" and ts and flat.Magnitude < GC.attackRange and g.cd <= 0 and troot ~= nil and not safeSpot(ts, troot, g) then -- jamais de coup dans la zone sûre (A.5, comme la simulation)
					if hitPlayer(ts, g) then
						g.cd = GC.attackCd
					end
				end
			end
		else -- retour
			local dv = home - g.pos
			want = dv.Magnitude >= 1
			if dv.Magnitude >= 1 then
				look = dv.Unit
				g.pos += look * math.min(dv.Magnitude, r.patrolSpeed * 1.6 * dt)
			end
		end
		-- le gardien reste dans le disque de SON territoire (Config.TERR), même en poursuite
		do
			local nx, nz = Guard.clampToDisc(g.pos.X, g.pos.Z, g.tx, g.tz, g.clampR)
			g.pos = Vector3.new(nx, g.pos.Y, nz)
		end
		-- blocage : devrait bouger mais n'avance pas depuis plus de 4 s -> retour doux à son poste, état remis à zéro
		g.stuck = g.stuck or { t = 0 }
		local moved = (g.pos - prevPos).Magnitude
		if Guard.stuckStep(g.stuck, dt, moved, want, GC) then
			g.pos = Vector3.new(g.cx, g.pos.Y, g.patrolZ)
			g.wps, g.target, g.last = nil, nil, nil
			g.st = { state = "patrol", timer = 0, lost = 0 }
			g.stuckFixes = (g.stuckFixes or 0) + 1
			pcall(function()
				g.model:SetAttribute("StuckFixes", g.stuckFixes)
			end)
			look = Vector3.new(g.dir, 0, 0)
		end
		if look and look.Magnitude > 0.01 then
			g.look = look.Unit
		end
		-- orientation vers la marche + animation procédurale (rebond et roulis en marchant, respiration à l'arrêt)
		g.speedNow = (g.speedNow or 0) * 0.8 + (moved / math.max(dt, 1e-3)) * 0.2
		local by, roll = Guard.walkPose(os.clock(), g.speedNow)
		g.model:PivotTo(CFrame.lookAt(g.pos + Vector3.new(0, by, 0), g.pos + Vector3.new(0, by, 0) + g.look) * CFrame.Angles(0, 0, roll))
	end
end

---------------------------------------------------------------- Pièges des territoires (lot 4) : fils à clochettes, boue, herse, dalles d'alarme, lanternes
-- Traps (pur) décide, ce code applique : alarme = les gardiens du territoire foncent vers l'endroit (état « perte de cible » = ils vont à la dernière
-- position connue puis reprennent leur poste, et repèrent le joueur s'il y est toujours) ; boue = vitesse x0,6 (applySpeed) ; herse = Part animée à 10 Hz.
local trapsWorld = world.traps or { layouts = {}, lights = {}, plates = {} }
local ALARM_TEXT = { bell = "🔔 Un fil à clochettes a sonné : les gardiens accourent !", plate = "🚨 Dalle d'alarme : les gardiens accourent !", light = "🔦 Une lanterne t'a repéré : les gardiens accourent !" }

local function alarmGuards(terr, x, z)
	for _, g in ipairs(world.guards) do
		if g.terr == terr and g.st and g.st.state ~= "chase" then
			g.st = { state = "lostChase", timer = 0, lost = 0 }
			g.last = Vector3.new(x, g.pos.Y, z)
			g.target, g.wps = nil, nil
			if g.mark then
				g.mark.Text = "❗"
			end
		end
	end
end

local function trapsStep(_dt)
	local now = os.clock()
	for player, s in pairs(sessions) do
		local root = getRoot(player)
		if root and alive(player) then
			local px, pz = root.Position.X, root.Position.Z
			for key, L in pairs(trapsWorld.layouts) do
				local ps = s.traps[key]
				if (px - L.cx) ^ 2 + (pz - L.cz) ^ 2 <= (L.r + 8) ^ 2 then
					if not ps then
						ps = Traps.newPlayerState()
						s.traps[key] = ps
					end
					for _, ev in ipairs(Traps.playerStep(ps, L, Config.TRAPS, now, px, pz)) do
						if ev.kind == "mud" then
							applySpeed(s)
							notify(player, "🟤 De la boue ! Tu es ralenti.")
						else
							alarmGuards(key, px, pz)
							notify(player, ALARM_TEXT[ev.kind] or "🔔", "caught")
							if ev.kind == "plate" then
								for _, pl in ipairs(trapsWorld.plates) do
									if pl.key == key and pl.index == ev.index then
										pl.part.Color = Color3.fromRGB(255, 220, 90)
										task.delay(0.8, function()
											pl.part.Color = Color3.fromRGB(150, 60, 60)
										end)
									end
								end
							end
						end
					end
				elseif ps then
					s.traps[key] = nil
					applySpeed(s)
				end
			end
		end
	end
	for _, ln in ipairs(trapsWorld.lights) do -- lanternes : le faisceau tourne (0,5 tour/s)
		local l = ln.light
		local a = Traps.lanternAngle(now, l)
		local dx, dz = math.cos(a), math.sin(a)
		local mid = Vector3.new(l.x + dx * l.range / 2, ln.y, l.z + dz * l.range / 2)
		ln.part.CFrame = CFrame.lookAt(mid, mid + Vector3.new(dx, 0, dz))
	end
	local gt = trapsWorld.gate
	local gl = trapsWorld.layouts.zed
	if gt and gl and gl.gate then -- herse de la cour de Zed : cycle 3 s ouverte / 3 s fermée, solide quand elle est descendue
		local lift = Traps.gateLift(now, gl.gate, Config.TRAPS.gateWindow)
		if lift ~= gt.lift then
			gt.lift = lift
			gt.part.CFrame = gt.baseCF + Vector3.new(0, -5.5 + 8.5 * lift, 0)
		end
		local solid = Traps.gateSolid(now, gl.gate, Config.TRAPS.gateWindow)
		if gt.solid ~= solid then
			gt.solid = solid
			gt.part.CanCollide = solid
		end
	end
end

---------------------------------------------------------------- Mode Château : salles à pièges, chrono, coffre final, classement des temps
local serverMode = "arena" -- « castle » si le premier joueur arrive du hub avec TeleportData.mode == "castle"
local castleWorld = world.castle

local function castleTeleport(s, room, depth)
	local root = getRoot(s.player)
	if root then
		local wx, wz = Castle.toWorld(room, 0, depth or 3)
		root.CFrame = CFrame.new(wx, 4, wz)
		root.AssemblyLinearVelocity = Vector3.zero
		s.noCheckUntil = os.clock() + 2
	end
end

function castleEnter(s)
	s.castle = { deaths = 0, maxRoom = 1, t0 = nil, finished = false }
	castleTeleport(s, 1, -4)
	notify(s.player, "🏰 Le Château : traverse 5 salles à pièges (pics, lames, boulets, portes). Le chrono démarre à la première salle. Coffre final : œuf rare !", "event")
end

-- Donne un œuf dans un emplacement libre (protégé quelques secondes) ; base pleine : l'équivalent de la moitié du prix en pièces. Retourne true si l'œuf est placé.
-- og = origine de l'œuf (vitrine : "g" gagné en jouant ; absent = inconnu, jamais compté).
local function giveEgg(s, tier, og)
	local d = s.data
	local i = freeSlot(s)
	if not i then
		d.coins += Config.eggCoinValue(tier) * 0.5
		return false
	end
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s), og = og }
	refreshPad(s, i)
	return true
end

local function castleDamage(s, kind, room)
	local dmg = Config.CASTLE.damage[kind] or 20
	local hp, hit, inv = Guard.applyDamage(s.hp, dmg, s.iframes, GC)
	if not hit then
		return
	end
	s.iframes, s.sinceHit = inv, 0
	setHp(s, hp)
	local label = kind == "spikes" and "des pics" or (kind == "blade" and "une lame" or (kind == "knight" and "un chevalier" or "un boulet"))
	notify(s.player, "💥 Touché par " .. label .. " : -" .. dmg .. " ❤️ (" .. math.floor(hp + 0.5) .. "/" .. GC.maxHp .. ")", "hurt")
	if hp <= 0 then -- défaite : retour au début de la salle, pv rétablis (jamais de perte d'œuf)
		local rootNow = getRoot(s.player)
		if rootNow and Config.purchasable(Config.PRODUCTS.Revive) then -- offre « Relancer maintenant » (produit payant, non bloquante)
			s.revive = { pos = rootNow.Position, room = room, expires = os.clock() + Config.REVIVE.offerSeconds }
			s.player:SetAttribute("ReviveUntil", os.time() + Config.REVIVE.offerSeconds)
		end
		s.castle.deaths += 1
		setHp(s, GC.maxHp)
		s.iframes = GC.respawnIframes
		castleTeleport(s, room, 3)
		notify(s.player, "🏰 Tu retentes la salle " .. room .. " (" .. s.castle.deaths .. " défaite(s)).", "caught")
	end
end

local castleBoardTimer = 0
local function castleBoardRefresh()
	task.spawn(function()
		local top = Data.castleTop(Config.CASTLE.boardSize)
		if castleWorld and castleWorld.board then
			local lines = { "🏰 Meilleurs temps" }
			for i, e in ipairs(top) do
				lines[#lines + 1] = i .. ". " .. e.name .. "  " .. Castle.formatTime(e.time)
			end
			if #top == 0 then
				lines[#lines + 1] = "(aucun pour l'instant)"
			end
			castleWorld.board.Text = table.concat(lines, "\n")
		end
	end)
end

local function castleStep(dt)
	Builder.animProps(os.clock())
	if not castleWorld then
		return
	end
	local T = os.clock()
	-- animation des pièges (positions répliquées 10 fois par seconde)
	for r, rec in ipairs(castleWorld.rooms) do
		local room = Castle.room(r)
		for i, sp in ipairs(Castle.spikes(room)) do
			local v = rec.spikes[i]
			local state = Castle.spikeState(T, sp, room)
			if state == "warning" and v.lastState ~= "warning" then
				rec.newWarn = true
			end
			v.lastState = state
			local tipY = state == "danger" and 0.9 or (state == "warning" and 0.05 or -1)
			v.tip.Position = Vector3.new(v.wx, tipY, v.wz)
			Builder.animSpike(v, tipY, state)
			v.tip.Color = state == "danger" and Color3.fromRGB(255, 90, 90) or (state == "warning" and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(210, 214, 222))
		end
		for i, bl in ipairs(Castle.blades(room)) do
			local v = rec.blades[i]
			local angle = Castle.bladeAngle(T, bl, room)
			v.arm.CFrame = CFrame.new(v.wx, 1.4, v.wz) * CFrame.Angles(0, angle, 0)
			Builder.animBlade(v, angle)
		end
		for i, ba in ipairs(Castle.balls(room)) do
			local v = rec.balls[i]
			local bx = Castle.ballX(T, ba, room)
			local bp = bx and Vector3.new(Castle.ORIGIN.x + bx, ba.radius, v.wz) or Vector3.new(Castle.ORIGIN.x, -10, v.wz)
			v.part.Position = bp
			Builder.animBall(v, bp.X, bp.Y, bp.Z)
		end
		if rec.newWarn then -- pics qui sortent : un son par salle (au plus toutes les 0,8 s) pour les joueurs de la salle
			rec.newWarn = false
			if T - (rec.lastSpikeSfx or -9) > 0.8 then
				rec.lastSpikeSfx = T
				for pl, ps in pairs(sessions) do
					local pr = ps.castle and getRoot(pl)
					if pr and Castle.roomAt(pr.Position.X, pr.Position.Z) == r then
						notify(pl, "", "spikes")
					end
				end
			end
		end
		for i, kn in ipairs(Castle.knights(room)) do
			local v = rec.knights[i]
			local kx, dir = Castle.knightPos(T, kn)
			v.part.Position = Vector3.new(Castle.ORIGIN.x + kx, 3, v.wz)
			Builder.animKnight(v, Castle.ORIGIN.x + kx, v.wz, dir, 4 * kn.amp / kn.period)
		end
		local open = Castle.doorIsOpen(T, room)
		rec.door.Position = Vector3.new(rec.doorX, open and 14 or rec.doorClosedY, rec.doorZ)
		rec.door.CanCollide = not open
		Builder.animDoor(rec, open)
	end
	-- joueurs dans le donjon : chrono, touches
	for player, s in pairs(sessions) do
		local root = getRoot(player)
		if s.castle and root and alive(player) and not s.castle.finished then
			local r, lx, lz = Castle.roomAt(root.Position.X, root.Position.Z)
			if r then
				s.castle.maxRoom = math.max(s.castle.maxRoom, r)
				if r == 1 and lz > 2 and not s.castle.t0 then
					s.castle.t0 = T
					notify(player, "⏱ Chrono lancé !")
				end
				local kind = Castle.hit(T, Castle.room(r), lx, lz)
				if kind then
					castleDamage(s, kind, r)
				end
			end
		end
	end
	castleBoardTimer += dt
	if castleBoardTimer >= Config.CASTLE.boardSeconds then
		castleBoardTimer = 0
		castleBoardRefresh()
	end
end
task.defer(castleBoardRefresh)

function castleFinish(s, root, prompt)
	local c = s.castle
	local holder = prompt.Parent
	if not (c and c.t0 and not c.finished and holder and (root.Position - holder.Position).Magnitude <= 18) then
		return
	end
	if c.maxRoom < Castle.ROOMS then
		return notify(s.player, "Il faut traverser les " .. Castle.ROOMS .. " salles avant d'ouvrir le coffre.")
	end
	c.finished = true
	notify(s.player, "", "fanfare")
	Builder.openChest()
	local seconds = os.clock() - c.t0
	local reward = Castle.reward(seconds, income(s), c.deaths)
	s.data.coins += reward.coins
	local placed = giveEgg(s, reward.eggTier, "g") -- vitrine : coffre du Château = gagné en jouant
	qp(s, "castle", 1)
	Lot7.L16.addXp(s, "pve") -- lot 16 : victoire au Château = victoire PvE
	Data.castleSubmit(s.player, seconds)
	notify(s.player, "🏆 Château terminé en " .. Castle.formatTime(seconds) .. " (" .. c.deaths .. " défaite(s)) : +" .. Config.fmt(reward.coins) .. " 🪙 et un œuf " .. Config.TIERS[reward.eggTier].name .. (placed and " dans ta base !" or " (base pleine : converti en pièces)."), "claim")
	sync(s)
	task.delay(4, function()
		if s.player.Parent and sessions[s.player] == s then
			s.castle = nil
			local root2 = getRoot(s.player)
			if root2 and s.plot then
				root2.CFrame = s.plot.spawn.CFrame + Vector3.new(0, 4, 0)
			end
			castleBoardRefresh()
		end
	end)
end

---------------------------------------------------------------- Événements serveur
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "EventTint"
tint.Parent = Lighting
local evTimer = rng:NextNumber(25, 40)

local function setEvent(cfg, seconds)
	if cfg then
		currentEvent = { cfg = cfg, ends = os.time() + (type(seconds) == "number" and seconds or Config.EVENT_DURATION) } -- seconds : événement offert plus long (énigme, lot 6)
		workspace:SetAttribute("EventKey", cfg.key)
		workspace:SetAttribute("EventEnds", currentEvent.ends)
		tint.TintColor = cfg.tint
		for _, p in ipairs(Players:GetPlayers()) do
			notify(p, cfg.emoji .. " " .. cfg.name .. " ! " .. cfg.desc, "event")
		end
	else
		currentEvent = nil
		workspace:SetAttribute("EventKey", nil)
		workspace:SetAttribute("EventEnds", nil)
		tint.TintColor = Color3.new(1, 1, 1)
	end
	for _, s in pairs(sessions) do
		sync(s)
	end
end

local function eventStep(dt)
	if currentEvent then
		if os.time() >= currentEvent.ends then
			setEvent(nil)
			evTimer = rng:NextNumber(Config.EVENT_GAP[1], Config.EVENT_GAP[2])
		end
	else
		evTimer -= dt
		if evTimer <= 0 then
			setEvent(Config.EVENTS[rng:NextInteger(1, #Config.EVENTS)])
		end
	end
end

-- Énigme de la Mère Poule (lot 6) : construite ici car elle déclenche l'événement « Pluie de chance » (setEvent) ; le gestionnaire de prompts la lit via `Hen`.
Hen = HenQuest.new({
	Config = Config, Riddle = Riddle, Builder = Builder, world = world, sessions = sessions, RHen = RHen,
	notify = notify, sync = sync, getRoot = getRoot, freeSlot = freeSlot, hatchTime = hatchTime, shieldTime = shieldTime, refreshPad = refreshPad,
	income = income, story = sp, setEvent = setEvent,
	onSolved = function(s)
		tele.log(s.player, "puzzle_solved")
		L15.weekly(s, "riddle", 1) -- lot 15 : quête de la semaine « énigmes »
	end,
})

---------------------------------------------------------------- Boucles de jeu
local function fastTick(dt)
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			local root = getRoot(player)
			local hum = getHum(player)
			if s.stun > 0 then
				s.stun -= dt
				if s.stun <= 0 and hum then
					hum.PlatformStand = false
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
			if not (root and hum and hum.Health > 0) then
				return
			end
			-- piste d'entraînement (ancien tapis roulant) : il faut courir dessus
			if s.stun <= 0 and world.treadmillContains(root.Position) and hum.MoveDirection.Magnitude > 0.1 then
				local rate = 0.8 * (1 + 0.35 * d.up.tm) * (evKey() == "run" and 3 or 1)
				d.speed += rate * dt
				qp(s, "train", dt)
				sp(s, "train", dt)
			end
			applySpeed(s)
			-- contrôle de vitesse : si le joueur parcourt bien plus que sa vitesse autorisée, on le remet en place
			local pos = root.Position
			if s.lastPos and s.stun <= 0 and os.clock() > s.noCheckUntil then
				local moved = Vector3.new(pos.X - s.lastPos.X, 0, pos.Z - s.lastPos.Z).Magnitude
				local allowed = (Config.walkSpeed(d.speed) * speedMul(s) + 16) * dt * 1.4 + 3
				if moved > allowed then
					s.flags += 1
					if s.flags >= 3 then
						root.CFrame = CFrame.new(s.lastPos) * root.CFrame.Rotation
						s.flags = 0
						warn("[AntiCheat] " .. player.Name .. " remis en place (vitesse anormale)")
						pos = s.lastPos
					end
				else
					s.flags = 0
				end
			end
			if s.lastPos and (pos - s.lastPos).Magnitude > 0.3 then
				s.lastActive = os.clock() -- déplacement = joueur actif
			end
			s.lastPos = pos
			-- intrusion : un autre joueur entre dans la base d'un hôte (alarme au niveau 3, chien de garde au niveau 5)
			do
				local host = nil
				for _, o in pairs(sessions) do
					if o ~= s and o.plot then
						local rel = o.plot.cf:PointToObjectSpace(pos)
						if Config.inBase(o.baseLevel or 1, rel.X, rel.Z, rel.Y) then
							host = o
							break
						end
					end
				end
				if host ~= s.intruderIn then
					s.intruderIn = host
					if host then
						onIntrusion(host, s)
					end
				end
			end
			-- dépôt des œufs dans sa base
			if #s.carry > 0 and inPlot(s, root) then
				local i = freeSlot(s)
				if not i then
					if os.clock() - s.lastFull > 4 then
						s.lastFull = os.clock()
						notify(player, "Base pleine ! Vends un pet ou agrandis-la.")
					end
				else
					local e = table.remove(s.carry, 1)
					d.slots[i] = { k = "e", t = e.t, ends = os.time() + e.rem, shield = os.time() + shieldTime(s), rv = (e.rv == true or (e.belt == true and e.paid == 0)) or nil, rvAt = e.rvAt, og = e.og } -- vitrine : origine figée portée par l'œuf ; lot 7b : un œuf gratuit (bienvenue) ou volé par corbeau reste non indemnisable
					refreshPad(s, i)
					Builder.burst(s.plot.pads[i].part.Position + Vector3.new(0, 2, 0), Config.TIERS[e.t].color, 12, false)
					rebuildCarry(s)
					applySpeed(s)
					sync(s)
				end
			end
			-- fraîcheur : un œuf Légendaire+ pris chez Zed refroidit s'il n'atteint pas la base à temps -> il regagne son nid
			if #s.carry > 0 then
				local nowc, cooled, soonest = os.clock(), false, 0
				for i = #s.carry, 1, -1 do
					local e = s.carry[i]
					if Traps.expired(e, nowc) then
						table.remove(s.carry, i)
						returnEgg(e)
						cooled = true
					elseif e.fresh then
						soonest = (soonest == 0) and (e.fresh - nowc) or math.min(soonest, e.fresh - nowc)
					end
				end
				if cooled then
					notify(player, "🧊 L'œuf a refroidi et regagne son nid")
					rebuildCarry(s)
					applySpeed(s)
					sync(s)
				end
				player:SetAttribute("FreshLeft", math.ceil(soonest))
			elseif player:GetAttribute("FreshLeft") ~= 0 then
				player:SetAttribute("FreshLeft", 0)
			end
			-- porte de base : fin de la fermeture
			if s.doorPart and os.clock() >= (s.lockUntil or 0) then
				setDoorBarrier(s, false)
			end
		end)
		if not ok then
			warn("[fastTick] " .. tostring(err))
		end
	end
end

local function petLabel(s, sl)
	local def = Config.PETS[sl.p]
	return string.format("%s %s%s\n+%s/s", def.emoji, Config.petName(sl.p, sl.s, sl.m), sl.f == 2 and " ★2" or "", Config.fmt(Config.petIncome(sl.p, sl.s, sl.m, sl.f) * gmult(s))) -- idée 2 : forme 2
end

local function slowTick(dt)
	eventStep(dt)
	tele.ccu(Players:GetPlayers(), serverMode) -- lot 14 : fréquentation du serveur, 1 échantillon / 60 s au plus (Telemetry.ccu)
	tele.step()
	for _, n in ipairs(world.nests) do
		if not n.egg then
			n.rt -= dt
			if n.rt <= 0 then
				setNestEgg(n, wpick(Config.foldWeights(n.weights or Config.RIVALS[n.rival].weights)))
			end
		end
	end
	local now = os.time()
	for player, s in pairs(sessions) do
		local ok, err = pcall(function()
			local d = s.data
			d.played += dt -- temps de jeu cumulé (secondes, sauvegardé) : protection débutant
			refreshNewbie(s)
			Lot7.Cal.tick(s)
			L15.tick(s, dt) -- lot 15 : jour UTC (compteurs PNJ, semaine, plumes), rencontres de PNJ toutes les 5 s, offres expirées
			local inc = income(s)
			local active = os.clock() - s.lastActive <= Config.IDLE.seconds
			if (player:GetAttribute("Idle") == true) == active then
				player:SetAttribute("Idle", not active) -- le client affiche « 💤 revenus en pause »
			end
			if active then
				d.coins += inc * dt
				qp(s, "earn", inc * dt)
				L15.onb(s, "earn", inc * dt) -- lot 17 : étape « premier revenu » (revenu réellement versé)
			end
			L15.onbTick(s, dt) -- lot 17 : faits lus côté serveur (base, éclosion, niveau de maison), 1 fois par seconde
			Lot7.privStep(s, dt, active) -- tapis privé : un œuf gratuit toutes les 120 s d'activité
			ensureQuests(s)
			storyRefresh(s)
			s.syncT += dt
			if s.syncT >= 10 then
				s.syncT = 0
				RState:FireClient(player, snapshot(s))
			end
			for i = 1, cap(s) do
				local sl = d.slots[i]
				if sl and sl.k == "e" then
					if now >= sl.ends then
						hatch(s, i)
					else
						local lbl = s.labels[i]
						if lbl then
							local txt = "🥚 " .. Config.fmtTime(sl.ends - now) .. ((sl.shield or 0) > now and "  🛡" or "")
							if lbl.Text ~= txt then
								lbl.Text = txt
							end
						end
					end
				elseif sl and sl.k == "p" then
					local lbl = s.labels[i]
					if lbl then
						local txt = petLabel(s, sl)
						if lbl.Text ~= txt then
							lbl.Text = txt
						end
					end
				end
			end
			-- régénération des pv (rapide dans la base, lente ailleurs après un délai sans coup)
			if s.hp < GC.maxHp then
				local root = getRoot(player)
				local atBase = root ~= nil and s.plot ~= nil and (root.Position - s.plot.spawn.Position).Magnitude < 40
				local newHp = Guard.regen(s.hp, s.sinceHit, dt, atBase, GC)
				if newHp ~= s.hp then
					setHp(s, newHp)
				end
			end
			pushStats(s)
		end)
		if not ok then
			warn("[slowTick] " .. tostring(err))
		end
	end
end

local acc1, acc2, acc3, acc4 = 0, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	guardsStep(dt)
	acc4 += dt
	if acc4 >= 0.1 then
		local d4 = acc4
		acc4 = 0
		local okT, errT = pcall(trapsStep, d4)
		if not okT then
			warn("[traps] " .. tostring(errT))
		end
	end
	acc3 += dt
	if acc3 >= Config.CASTLE.step then
		local d3 = acc3
		acc3 = 0
		castleStep(d3)
	end
	acc2 += dt
	if acc2 >= 0.25 then
		local d2 = acc2
		acc2 = 0
		fastTick(d2)
	end
	acc1 += dt
	if acc1 >= 1 then
		local d1 = acc1
		acc1 = 0
		slowTick(d1)
	end
end)

---------------------------------------------------------------- Tapis roulant central (lot 3 de la refonte)
-- Le serveur fait tout : Belt.step à 10 Hz (apparitions et sorties), un œuf visible par œuf du tapis (rareté et prix lisibles AVANT l'achat), un prompt
-- par œuf, achat par réservation atomique (Belt.tryBuy) après validation de la distance, des pièces et du sac. L'œuf acheté passe dans les bras du joueur
-- (s.carry, comme un œuf chipé) et doit être rapporté à la base. Tout œuf visuel est détruit à sa sortie (bac) ou à son achat : aucun objet ne fuit.
local BC = Config.BELT
local beltSt = Belt.new(rng:NextInteger(1, 2147483000), os.clock() + 2)
local beltFolder = Instance.new("Folder")
beltFolder.Name = "BeltEggs"
beltFolder.Parent = workspace
local beltEggs = {} -- [id] = { egg = œuf logique (Belt), part, prompt }
K8.beltPanelAt, K8.beltPanelKey = 0, "" -- panneau du tapis (lot 8B : dans K8, limite de 200 variables locales)
local BELT_Y = 3.0 -- hauteur du centre d'un œuf posé sur le tapis
local BELT_REACH = 14 -- distance serveur maximale joueur -> œuf (le prompt s'active à 10 ; marge pour la latence et le défilement)

local function beltRemoveVisual(id)
	local v = beltEggs[id]
	if v then
		beltEggs[id] = nil
		if v.egg.forUser and not v.egg.claimedBy then
			local op = Players:GetPlayerByUserId(v.egg.forUser)
			local os_ = op and sessions[op]
			if os_ and os_.welcome == "offered" then
				os_.welcome = "gone" -- l'œuf de bienvenue est tombé dans le bac sans être pris
				sync(os_)
			end
		end
		if v.part then
			v.part:Destroy() -- détruit aussi le prompt, l'étiquette, la lumière et le halo
		end
	end
end

local function beltAnnounce(tier)
	local t = Config.TIERS[tier]
	for _, p in ipairs(Players:GetPlayers()) do
		notify(p, "✨ Un œuf " .. t.name .. " arrive sur le tapis du marché !", Config.hatchSoundKey(tier, false))
	end
end

local function beltAddVisual(egg, ownerName)
	local t = Config.TIERS[egg.tier]
	local part = Builder.egg(egg.tier, true)
	local x = Belt.positionX(Config, egg, os.clock()) or Config.Map2.belt.x0
	part.CFrame = CFrame.new(x, BELT_Y, Config.Map2.belt.z)
	part:SetAttribute("EggId", egg.id)
	part:SetAttribute("Tier", egg.tier)
	part:SetAttribute("Price", egg.price)
	if egg.forUser then
		part:SetAttribute("ForUser", egg.forUser)
	end
	CollectionService:AddTag(part, "EggShake")
	local rare = Config.tierAtLeast(egg.tier, "announce")
	if rare then
		CollectionService:AddTag(part, "BeltRare") -- annonce visuelle côté client
	end
	local pr = Instance.new("ProximityPrompt")
	if egg.forUser then
		pr.ActionText = "Prendre (gratuit)"
		pr.ObjectText = "Œuf de bienvenue"
	else
		pr.ActionText = "Acheter 🪙 " .. Config.fmt(egg.price)
		pr.ObjectText = "Œuf " .. t.name
	end
	pr.HoldDuration = 0.3
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr.Enabled = not rare -- Légendaire et plus : le prompt s'active après Config.BELT.legendaryDelay (voir beltStep)
	pr:SetAttribute("EggId", egg.id)
	if egg.forUser then
		pr:SetAttribute("ForUser", egg.forUser)
	end
	pr.Parent = part
	CollectionService:AddTag(pr, "BeltEgg")
	local label
	if egg.forUser then
		label = "🎁 Œuf de bienvenue de " .. tostring(ownerName or "?") .. "\nGratuit"
	else
		label = t.name .. "\n🪙 " .. Config.fmt(egg.price)
	end
	Builder.sign(part, label, t.color, 3, 200)
	part.Parent = beltFolder
	beltEggs[egg.id] = { egg = egg, part = part, prompt = pr }
	if rare then
		beltAnnounce(egg.tier)
	end
end

local function beltPanelUpdate(now)
	local b = world.belt
	if not b then
		return
	end
	local info = Belt.panel(Config, beltSt, now)
	local key = info.active .. "|" .. info.status
	if key == K8.beltPanelKey then
		return
	end
	K8.beltPanelKey = key
	local mark = "▶ "
	b.panel.normal.Text = (info.active == "normal" and mark or "") .. "Standard : " .. info.normal
	b.panel.golden.Text = (info.active == "golden" and mark or "") .. "Doré : " .. info.golden
	b.panel.normal.TextColor3 = info.active == "normal" and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(190, 190, 205)
	b.panel.golden.TextColor3 = info.active == "golden" and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(190, 190, 205)
	b.panel.status.Text = info.status
end

local function beltStep()
	local now = os.clock()
	BC.interval = L15.Rewards.activeEvents(Config, os.time()).beltSeconds -- lot 15 : week-end chanceux (4 s au lieu de 5)
	local spawned, removed = Belt.step(Config, beltSt, now)
	for _, e in ipairs(removed) do
		beltRemoveVisual(e.id)
	end
	for _, e in ipairs(spawned) do
		local owner = e.forUser and Players:GetPlayerByUserId(e.forUser)
		beltAddVisual(e, owner and owner.DisplayName)
	end
	local alive_ = {}
	for _, e in ipairs(beltSt.eggs) do
		alive_[e.id] = true
	end
	local stale = {}
	for id in pairs(beltEggs) do
		if not alive_[id] then
			stale[#stale + 1] = id -- vendu, parti ou jamais revu dans la liste du tapis : plus aucun objet orphelin
		end
	end
	for _, id in ipairs(stale) do
		beltRemoveVisual(id)
	end
	for _, e in ipairs(beltSt.eggs) do
		local v = beltEggs[e.id]
		if v then
			local x = Belt.positionX(Config, e, now)
			if x then
				v.part.CFrame = CFrame.new(x, BELT_Y, Config.Map2.belt.z)
			end
			if not v.prompt.Enabled and now - e.born >= BC.legendaryDelay then
				v.prompt.Enabled = true
			end
		end
	end
	if now - K8.beltPanelAt >= 1 then
		K8.beltPanelAt = now
		beltPanelUpdate(now)
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(beltStep)
		if not ok then
			warn("[belt] " .. tostring(err))
		end
	end
end)

-- Action serveur INTERNE : ajoute des secondes de tapis doré (cumulables, plafonnées). Le produit Robux la branchera plus tard (lot 7) ; aucun ProcessReceipt ici.
local function goldenBeltAdd(seconds, byName)
	local left = Belt.addGolden(Config, beltSt, os.clock(), seconds, byName)
	K8.beltPanelKey = ""
	return left
end
Builder.beltHooks = { goldenAdd = goldenBeltAdd, stats = function() -- crochet interne (tests, lot 7) : jamais exposé aux clients
	local n = 0
	for _ in pairs(beltEggs) do
		n += 1
	end
	return { eggs = #beltSt.eggs, visuals = n, children = #beltFolder:GetChildren(), sold = beltSt.sold, goldenLeft = Belt.goldenLeft(beltSt, os.clock()) }
end }

-- Œuf de bienvenue : une fois par joueur, 20 s après l'arrivée, si hatched < 5 ; gratuit, étiqueté à son nom, achetable par lui seul.
local function beltWelcome(player, s)
	for _ = 1, 8 do
		if not (player.Parent and sessions[player] == s) then
			return
		end
		local egg = Belt.welcome(Config, beltSt, player.UserId, s.data.hatched, os.clock())
		if egg then
			s.welcome = "offered"
			beltAddVisual(egg, player.DisplayName)
			notify(player, "🎁 Un œuf de bienvenue t'attend sur le tapis du marché : il est gratuit, et il est à toi !", "event")
			sync(s)
			return
		end
		if s.data.hatched >= BC.welcome.maxHatched or beltSt.welcomed[player.UserId] then
			s.welcome = "none"
			sync(s)
			return
		end
		task.wait(1.5) -- tapis plein : on réessaie
	end
	s.welcome = "none"
end

local BELT_MSG = {
	late = "Trop tard ! Quelqu'un a pris cet œuf.",
	gone = "Trop tard ! Cet œuf n'est plus sur le tapis.",
	cooldown = "Attends un peu avant d'acheter un autre œuf.",
	wait = "Attends un instant : cet œuf rare vient d'arriver.",
	reserved = "Cet œuf de bienvenue est réservé à un autre joueur.",
	legendaryLimit = "Un seul œuf Légendaire ou plus par minute et par joueur.",
}

function beltBuy(player, prompt)
	local s, root = sessions[player], getRoot(player)
	if not s or not root or not alive(player) or s.stun > 0 then
		return
	end
	local now = os.clock()
	if now - (s.lastBeltTry or -10) < 0.25 then
		return -- anti-rafale
	end
	s.lastBeltTry = now
	local id = prompt:GetAttribute("EggId")
	local v = type(id) == "number" and beltEggs[id] or nil
	if not v or prompt.Parent ~= v.part then
		notify(player, BELT_MSG.late, "refuse") -- l'œuf a déjà été pris (ou est tombé dans le bac) pendant que la demande voyageait
		return
	end
	if (root.Position - v.part.CFrame.Position).Magnitude > BELT_REACH then
		return
	end
	if #s.carry >= carryCap(s.data) then
		notify(player, "Sac plein ! Rapporte tes œufs à ta base.")
		return
	end
	local ok, res = Belt.tryBuy(Config, beltSt, player.UserId, id, s.data.coins, now)
	if not ok then
		if res == "poor" then
			notify(player, "Pas assez de pièces : il te faut " .. Config.fmt(v.egg.price) .. " 🪙.", "refuse")
		else
			notify(player, BELT_MSG[res] or "Achat impossible.", "refuse")
		end
		return
	end
	local egg = res
	s.data.coins -= egg.price
	beltRemoveVisual(egg.id)
	Builder.burst(v.part.CFrame.Position, Config.TIERS[egg.tier].color, 10, false)
	s.carry[#s.carry + 1] = { t = egg.tier, rem = hatchTime(s, egg.tier), belt = true, paid = egg.price, og = "g" } -- vitrine : œuf du tapis = gagné en jouant
	if egg.forUser then
		s.welcome = "taken"
	end
	afterTake(s, "🥚 Œuf " .. Config.TIERS[egg.tier].name .. (egg.price > 0 and (" acheté (-" .. Config.fmt(egg.price) .. " 🪙)") or " pris") .. " ! Porte-le vite dans ta base.", egg.price > 0 and "belt_buy" or "claim") -- lot 10 : son approuvé du tapis
end

---------------------------------------------------------------- Actions du client
local actions = {}

-- Retour au hub : la progression est sauvegardée d'abord ; si la téléportation échoue, le joueur reste en jeu avec un message clair.
function actions.toHub(s)
	local now = os.clock()
	if s.leaving or now - (s.toHubAt or -100) < 15 then
		return
	end
	if Config.Game.roleFor(game.PlaceId) ~= "game" then
		return notify(s.player, "Le hub n'est pas disponible depuis ce lieu.")
	end
	s.toHubAt = now
	if not s.noSave then
		Data.save(s.player, s.data)
	end
	local res = Party.returnToHub(Config, {
		teleport = function(players, placeId, _, data)
			local opts = Instance.new("TeleportOptions")
			opts:SetTeleportData(data)
			TeleportService:TeleportAsync(placeId, players, opts)
		end,
		log = warn,
	}, s.player, serverPartyId)
	if res.ok then
		notify(s.player, "🏠 Retour au hub…")
	else
		notify(s.player, "⚠️ " .. res.message)
	end
end

-- Porte de base : ferme la base pendant Config.lockSeconds(niveau) secondes (aucun vol d'emplacement), puis recharge Config.DOOR.cooldown secondes.
function actions.lockDoor(s)
	local now = os.clock()
	if (s.lockUntil or 0) > now then
		return
	end
	if (s.lockReadyAt or 0) > now then
		notify(s.player, "🔒 La porte se recharge : encore " .. math.ceil(s.lockReadyAt - now) .. " s.")
		return
	end
	local dur = Config.lockSeconds(s.baseLevel or 1)
	s.lockUntil = now + dur
	s.lockReadyAt = s.lockUntil + Config.DOOR.cooldown
	local okT, server = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if not okT or type(server) ~= "number" then
		server = os.time()
	end
	s.player:SetAttribute("DoorUntil", server + dur)
	s.player:SetAttribute("DoorReady", server + dur + Config.DOOR.cooldown)
	setDoorBarrier(s, true)
	notify(s.player, "🔒 Porte fermée pendant " .. dur .. " s : personne ne peut voler tes œufs.")
end

-- Fin anticipée de la protection débutant (« Je suis prêt pour le PvP »).
function actions.newbieOff(s)
	if isNewbie(s) then
		s.data.newbieOff = true
		refreshNewbie(s)
		sync(s)
	end
end

-- Lot 17 : onboarding. Le serveur décide de tout (Onboarding.lua) : le client ne fournit AUCUN fait, seul « Passer » (onbSkip) existe et ne fait que terminer le tutoriel.
function L15.onb(s, kind, arg)
	local d = s.data
	if not L15.Onb.active(d.onb) then
		return
	end
	local advanced, info = L15.Onb.event(d.onb, kind, arg, os.time())
	if advanced then
		if info == "done" then
			notify(s.player, "🎉 Tutoriel terminé : à toi de jouer !", "buy")
			tele.event(s.player, "onboarding", "tut_done")
		else
			tele.event(s.player, "onboarding", "tut_step" .. tostring(d.onb.step)) -- étape atteinte (2 à 5) ; noms fermés dans Telemetry.ONBOARDING
		end
		RState:FireClient(s.player, snapshot(s))
	end
end

function L15.onbTick(s, dt)
	if not L15.Onb.active(s.data.onb) then
		return
	end
	s.onbT = (s.onbT or 0) + dt
	if s.onbT < 1 then
		return
	end
	s.onbT = 0
	local root = getRoot(s.player)
	L15.onb(s, "tick", { near = root ~= nil and s.plot ~= nil and alive(s.player) and inPlot(s, root), hatched = s.data.hatched, level = s.baseLevel or 1 })
end

function actions.onbSkip(s)
	if L15.Onb.skip(s.data.onb) then
		tele.event(s.player, "onboarding", "tut_skip")
		RState:FireClient(s.player, snapshot(s))
	end
end

function actions.sync(s)
	sync(s)
end

function actions.buyEgg(s, tier)
	if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > #Config.TIERS then
		return
	end
	if not Config.tierLive(tier) then -- lot 9 : rareté sans espèce publiée (Peu commun tant que le lot 11 n'est pas livré)
		return notify(s.player, "🥚 Les œufs " .. Config.TIERS[tier].name .. " arrivent bientôt !", "refuse")
	end
	if tier > Config.SHOP_MAX_TIER then -- lot 8A (B.3) : Mythique et Cosmique seulement au tapis du marché
		return notify(s.player, "🎪 Les œufs " .. Config.TIERS[tier].name .. " ne se trouvent qu'au tapis du marché !", "refuse")
	end
	local d = s.data
	local price = Config.EGG_PRICE[tier]
	if d.coins < price then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	local i = freeSlot(s)
	if not i then
		return notify(s.player, "Base pleine !")
	end
	d.coins -= price
	tele.economy(s.player, price, d.coins, "egg_r" .. tier) -- lot 9 : pièces dépensées en œufs
	d.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s), og = "c" } -- vitrine : boutique en pièces
	refreshPad(s, i)
	notify(s.player, "", "buy")
	sync(s)
end

function actions.buyUp(s, key)
	local u = type(key) == "string" and Config.upgrade(key)
	if not u then
		return
	end
	local d = s.data
	local l = d.up[key]
	if l >= u.max then
		return
	end
	local cost = u.cost(l)
	if d.coins < cost then
		return notify(s.player, "Pas assez de pièces !", "refuse")
	end
	d.coins -= cost
	notify(s.player, "", "buy")
	d.up[key] = l + 1
	if key == "slots" then
		refreshAllPads(s)
	end
	sync(s)
end

function actions.sell(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	s.data.coins += Config.sellValue(sl.p, sl.s, sl.m)
	s.data.slots[i] = false
	qp(s, "sell", 1)
	refreshPad(s, i)
	rebuildFollowers(s)
	sync(s)
end

-- Revend un œuf d'un emplacement (25 % du prix). Validé côté serveur : emplacement existant, contient un œuf.
function actions.sellEgg(s, i)
	if not validSlot(i) then
		return
	end
	local sl = s.data.slots[i]
	if not sl or sl.k ~= "e" then
		return
	end
	s.data.coins += Config.eggSellValue(sl.t)
	s.data.slots[i] = false
	refreshPad(s, i)
	qp(s, "sell", 1)
	sync(s)
end

-- Revend les doublons de pets (garde le meilleur de chaque espèce). Les pets revendus quittent la liste de ceux qui suivent le joueur.
function actions.sellDupes(s)
	local d = s.data
	local list, total = Config.dupesToSell(d.slots, cap(s))
	if #list == 0 then
		return notify(s.player, "Aucun doublon à revendre.")
	end
	for _, i in ipairs(list) do
		d.slots[i] = false
		refreshPad(s, i)
		for n = #d.equip, 1, -1 do
			if d.equip[n] == i then
				table.remove(d.equip, n)
			end
		end
		qp(s, "sell", 1)
	end
	d.coins += total
	rebuildFollowers(s)
	notify(s.player, "⭐ " .. #list .. " doublon(s) échangé(s) : +" .. Config.fmt(total) .. " 🪙", "claim")
	sync(s)
end

-- IDÉE 2 : évolution d'un pet en forme 2 (règles : Shared/Evolution). Le client n'envoie que l'emplacement (et le prix maximal vu) ; doublons, coût et
-- interdits sont calculés ici. Sauvegarde PUIS octroi : la copie « après » est sauvegardée, le profil vivant n'est modifié qu'en cas de succès.
function Lot7.evoCtx(s, maxCost)
	return { capacity = cap(s), income = income(s), maxCost = maxCost, busy = (s.battle or s.castle or s.pvpPending or s.evoBusy or s.leaving) and true or nil }
end
function actions.evoPreview(s, i)
	if Config.EVOLUTION.enabled ~= true then
		return
	end
	Lot7.REvo:FireClient(s.player, { k = "preview", view = Lot7.Evolution.view(Config, s.data, i, Lot7.evoCtx(s)) })
end
function actions.evolve(s, arg)
	local E = Lot7.Evolution
	if type(arg) ~= "table" or (arg.maxCost ~= nil and type(arg.maxCost) ~= "number") then
		return
	end
	local plan, code = E.plan(Config, s.data, arg.i, Lot7.evoCtx(s, arg.maxCost))
	if not plan then
		notify(s.player, "✨ " .. (E.REFUSE[code] or E.REFUSE.slot), "refuse")
		Lot7.REvo:FireClient(s.player, { k = "preview", view = E.view(Config, s.data, arg.i, Lot7.evoCtx(s)) })
		return
	end
	local d, player = s.data, s.player
	s.evoBusy = true
	local okRun, errRun = pcall(function()
		if not s.noSave and not Data.save(player, E.stage(d, plan), s.leaving == true) then
			notify(player, "✨ " .. E.REFUSE.save, "refuse")
			return
		end
		if s.data ~= d or not E.apply(d, plan) then -- impossible tant que les actions sont gelées : la sauvegarde « après » est alors réécrite avec l'état vivant
			if not s.noSave then
				Data.save(player, s.data, s.leaving == true)
			end
			notify(player, "✨ " .. E.REFUSE.changed, "refuse")
			return
		end
		E.dropIndices(d.equip, plan.sac)
		for _, j in ipairs(plan.sac) do
			refreshPad(s, j)
		end
		refreshPad(s, plan.i, true)
		rebuildFollowers(s)
		local def = Config.PETS[plan.p]
		notify(player, "✨ " .. def.emoji .. " " .. def.name .. " évolue en forme 2 ! Revenu +" .. math.floor((Config.EVOLUTION.incomeMul - 1) * 100 + 0.5) .. " %, force +" .. math.floor((Config.EVOLUTION.powerMul - 1) * 100 + 0.5) .. " %.", "claim")
		Lot7.REvo:FireClient(player, { k = "done", i = plan.i, p = plan.p, n = d.evo[tostring(plan.p)] })
	end)
	s.evoBusy = nil
	if not okRun then
		warn("[Evolution] " .. tostring(errRun))
	end
	if sessions[player] == s then
		sync(s)
	end
end

-- Dialogue de la Mère Poule (lot 6) : boutons « J'y vais ! », « Explique encore », « 💡 Un coup de bec », « 🔁 Réécouter » (intentions seulement).
function actions.henGo(s)
	return Hen and Hen.go(s)
end
function actions.henExplain(s)
	return Hen and Hen.explain(s)
end
function actions.henHint(s)
	return Hen and Hen.hint(s)
end
function actions.henReplay(s)
	return Hen and Hen.replay(s)
end

function actions.rebirth(s)
	local d = s.data
	if d.coins < Config.rebirthCost(d.rb) then
		return notify(s.player, "Pas assez de pièces pour renaître.", "refuse")
	end
	-- Correctif : remise à zéro par LISTE BLANCHE (le profil n'est plus reconstruit). Repartent de zéro : pièces, améliorations, emplacements de la base (pets
	-- et œufs posés ; l'œuf de départ gratuit revient), suiveurs, gains hors ligne non récupérés, horodatage des revenus. TOUT le reste survit : achats uniques
	-- (once, starter), passe de combat (season), calendrier et séries (cal, calStreak, calLast, grace, streak), quêtes (jour, semaine, bonus), plumes d'événement,
	-- sac d'œufs et coffre de débordement, PNJ, réglages, combat / ligues / duels (battle), jetons, parchemins, plumes, titres, cosmétiques, pose, boosts
	-- payés ou gagnés, XP de dresseur, tickets d'arène, temps de jeu (protection débutant), reçus, succès, index, journal de vol, Corbeau, tapis privé.
	-- Lot 17 : onb (onboarding), showcase (vitrine : bonus daté et recharge d'une semaine) et evo (compteur d'évolutions par espèce) ne sont PAS dans la liste :
	-- ils survivent. Les formes 2 (slot.f) partent avec les pets posés (slots), comme l'XP des pets.
	local fresh = Data.default()
	dropCarry(s)
	for _, k in ipairs({ "coins", "up", "slots", "equip", "pendingAway", "last" }) do
		d[k] = fresh[k]
	end
	d.rb = d.rb + 1
	refreshAllPads(s)
	rebuildFollowers(s)
	storyRefresh(s)
	sync(s)
	notify(s.player, string.format("🌅 Renaissance ! Revenus x%.1f", 1 + 0.5 * d.rb), "claim")
end

function actions.equip(s, i)
	if not validSlot(i) then
		return
	end
	local d = s.data
	local sl = d.slots[i]
	if not sl or sl.k ~= "p" then
		return
	end
	local at
	for n, v in ipairs(d.equip) do
		if v == i then
			at = n
		end
	end
	if at then
		table.remove(d.equip, at)
	else
		if #d.equip >= Lot7.L16.followerMax(s) then
			return notify(s.player, "Maximum " .. Lot7.L16.followerMax(s) .. " pets qui te suivent.")
		end
		d.equip[#d.equip + 1] = i
	end
	rebuildFollowers(s)
	sync(s)
end

function actions.claimQuest(s, i)
	local q = type(i) == "number" and s.data.quests[i]
	if not q or q.claimed or q.prog < q.goal then
		return
	end
	q.claimed = true
	Lot7.Calendar.addQuest(Config, s.data.cal) -- lot 9b : une mission réclamée compte pour le rattrapage « 3 missions » du calendrier
	L15.plume(s, "quest") -- lot 15 : plumes d'événement (plafond du jour)
	tele.log(s.player, "daily_quest_completed")
	Lot7.L16.addXp(s, "daily") -- lot 16 : XP du passe de combat (quête du jour réclamée)
	s.data.coins += q.rew
	local extra = ""
	if (q.re or 0) > 0 and Config.TIERS[q.re] then
		extra = extra .. (giveEgg(s, q.re, "g") and (" + œuf " .. Config.TIERS[q.re].name) or " (base pleine : œuf converti en pièces)")
	end
	if (q.rb or 0) > 0 then
		s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + q.rb
		extra = extra .. " + boost de chance"
	end
	notify(s.player, "🎯 Mission accomplie : +" .. Config.fmt(q.rew) .. " 🪙" .. extra, "claim")
	sync(s)
end

function actions.claimStory(s)
	local st = s.data.story
	local c = chapter(s)
	if not c or st.prog < c.goal then
		return
	end
	local rankBefore = Config.rankFor(st.ch).name
	local reward = Config.storyReward(c, income(s))
	s.data.coins += reward
	st.ch += 1
	st.prog = 0
	updateSign(s)
	notify(s.player, "📜 « " .. c.title .. " » accompli : +" .. Config.fmt(reward) .. " 🪙", "claim")
	local nextChapter = chapter(s)
	if nextChapter then
		notify(s.player, "📖 Chapitre " .. (st.ch + 1) .. " : " .. nextChapter.title .. " (Missions > Histoire)")
	else
		notify(s.player, "👑 Histoire terminée : tu es Roi des Couvées !", "event")
	end
	for _, z in ipairs(Config.ZONES) do
		if z.chapter > 0 and z.chapter == st.ch then
			notify(s.player, "🔓 " .. z.name .. " est ouvert ! Ses œufs sont plus rares.", "event")
		end
	end
	local rank = Config.rankFor(st.ch)
	if rank.name ~= rankBefore then
		notify(s.player, "🎖 Nouveau rang : " .. rank.emoji .. " " .. rank.name .. " !", "event")
	end
	storyRefresh(s) -- le chapitre suivant peut être déjà accompli (espèces déjà découvertes...)
	sync(s)
end

-- Mémorise qu'une cinématique a été vue (ou passée) : elle ne se rejouera pas à la prochaine connexion.
function actions.cineSeen(s, id)
	if type(id) ~= "string" then
		return
	end
	for _, known in ipairs(Config.CINE_IDS) do
		if known == id then
			if not s.data.cine[id] then
				s.data.cine[id] = true
				sync(s)
			end
			return
		end
	end
end

function actions.claimAch(s, id)
	local a = type(id) == "string" and Config.achievement(id)
	if not a then
		return
	end
	local d = s.data
	local tier = d.ach[a.id] or 0
	if tier >= #a.goals then
		return
	end
	local value = statValues(s)[a.stat]
	if not value or value < a.goals[tier + 1] then
		return
	end
	local reward = Config.achReward(tier + 1, income(s))
	d.ach[a.id] = tier + 1
	d.coins += reward
	notify(s.player, "🏅 Succès « " .. a.name .. " » (palier " .. (tier + 1) .. ") : +" .. Config.fmt(reward) .. " 🪙", "claim")
	sync(s)
end

local topCache = {}
function actions.top(s)
	RTop:FireClient(s.player, topCache)
end

function actions.claimAway(s)
	local gain = math.floor(s.data.pendingAway)
	if gain < 1 then
		return
	end
	s.data.pendingAway = 0
	s.data.coins += gain
	notify(s.player, "💰 Gains récupérés : +" .. Config.fmt(gain) .. " 🪙", "claim")
	RState:FireClient(s.player, snapshot(s))
end

-- Lot 15 : série de 7 jours (remplace l'ancien bonus quotidien). arg = nil (suite normale ou jour de grâce automatique), { how = "quest" } (sauvetage gratuit :
-- 3 missions du jour terminées) ou { how = "reset" } (repartir du jour 1). Le sauvetage payant (« product ») n'est JAMAIS accepté du client : seul le reçu
-- StreakRestore le déclenche (ProcessReceipt).
function actions.daily(s, arg)
	local how = type(arg) == "table" and arg.how or nil
	if how ~= "quest" and how ~= "reset" then
		how = nil
	end
	L15.streakClaim(s, how)
end

---------------------------------------------------------------- Lot 9b : calendrier des œufs sur 30 jours
-- Le serveur possède tout : jour UTC (os.time() // 86400), éligibilité, ressources de rattrapage, tirage du jour 30, œuf placé. Le client n'envoie que { day, how }.
-- Une réclamation : verrou s.calBusy (aucune seconde réclamation pendant la sauvegarde), validation (Calendar.check), jour MARQUÉ dans le profil, sauvegarde réussie,
-- ENFIN octroi. Sauvegarde échouée = jour démarqué, rien n'est donné. Mort du serveur entre la sauvegarde et l'octroi : récompense perdue (jamais doublée), limite documentée.
do
	local Calendar, CalSys, CAL = Lot7.Calendar, Lot7.Cal, Config.CALENDAR
	local function age(player)
		local ok, a = pcall(function()
			return player.AccountAge
		end)
		return (ok and type(a) == "number" and a == a) and a or 0
	end
	local function eligible(s)
		return Calendar.eligible(Config, age(s.player), s.data.played)
	end
	local function today()
		return os.time() // 86400
	end
	local refusal = {
		ineligible = "📅 Le calendrier n'est pas encore débloqué pour toi.", day = "📅 Jour invalide.", notStarted = "📅 Le calendrier n'a pas encore commencé.",
		future = "📅 Ce jour n'est pas encore arrivé : reviens à la date prévue !", claimed = "📅 Récompense déjà réclamée.", monthCap = "📅 Les 30 récompenses du cycle sont déjà réclamées.",
		dayCap = "📅 Reviens demain : une seule réclamation de rattrapage par jour.", how = "📅 Choisis comment rattraper ce jour.",
		noResource = "📅 Il te manque de quoi rattraper ce jour (jour de grâce, 3 missions ou un rattrapage).",
	}
	-- Vue du calendrier pour le client : normalise le cycle (renouvelé après 30 jours) ; ne démarre jamais un cycle (voir CalSys.tick).
	function CalSys.snapshot(s)
		local d = s.data
		Calendar.normalize(Config, d.cal, today())
		local ok, why = eligible(s)
		local v = Calendar.view(Config, d.cal, today(), ok, why)
		v.scrolls, v.plumes, v.ftokens = d.scrolls, d.plumes, d.fightTokens
		v.cosm, v.titles = d.cosm, { cal10 = d.titles.cal10 == true, cal25 = d.titles.cal25 == true, cal30 = d.titles.cal30 == true }
		v.playLeft = math.max(0, math.ceil(CAL.minPlayMinutes - d.played / 60))
		v.last = d.calLast
		return v
	end
	-- Une fois par seconde et par joueur (slowTick) : démarre le cycle d'un joueur devenu éligible, renouvelle un cycle fini, prévient d'une récompense disponible.
	function CalSys.tick(s)
		local d = s.data
		local day = today()
		local changed = false
		if d.cal.start == 0 then
			if eligible(s) and Calendar.begin(Config, d.cal, day) then
				changed = true
				notify(s.player, "📅 Calendrier des œufs débloqué ! Ouvre Bonus > Calendrier : un œuf Légendaire t'attend au jour 3.", "claim")
			end
		elseif Calendar.normalize(Config, d.cal, day) then
			changed = true
			notify(s.player, "📅 Nouveau cycle de 30 jours : la récompense du jour 1 t'attend.", "claim")
		end
		if changed or s.calSeenDay ~= day then
			s.calSeenDay = day
			sync(s)
		end
	end
	local function applyReward(s, plan, og) -- og : origine des œufs (vitrine) : "r" pour un rattrapage payant, "g" sinon
		local d = s.data
		local bits = {}
		if plan.coins > 0 then
			d.coins += plan.coins
			bits[#bits + 1] = "🪙 " .. Config.fmt(plan.coins)
		end
		if plan.egg then
			-- lot 15 : base puis sac d'œufs (place vérifiée avant la sauvegarde). Si le joueur a tout rempli PENDANT la sauvegarde, repli de giveEgg (pièces) :
			-- la récompense n'est jamais perdue ni doublée.
			local where = L15.storeEggs(s, { plan.egg }, og)
			if not where then
				giveEgg(s, plan.egg, og)
			end
			bits[#bits + 1] = "🥚 Œuf " .. Config.TIERS[plan.egg].name .. ((where and where[1] == "bag") and " (rangé dans ton sac d'œufs)" or (where and "" or " (base et sac pleins : converti en pièces)"))
		end
		if plan.scrolls > 0 then
			d.scrolls = math.min(CAL.caps.scrolls, d.scrolls + plan.scrolls)
			bits[#bits + 1] = "📜 +" .. plan.scrolls
		end
		if plan.plumes > 0 then
			d.plumes = math.min(CAL.caps.plumes, d.plumes + plan.plumes)
			bits[#bits + 1] = "🪶 +" .. plan.plumes
		end
		if plan.tokens > 0 then
			d.fightTokens = math.min(CAL.caps.tokens, d.fightTokens + plan.tokens)
			bits[#bits + 1] = "⚔️ +" .. plan.tokens
		end
		if plan.cosm and CAL.cosmetics[plan.cosm] then
			d.cosm[plan.cosm] = true
			bits[#bits + 1] = CAL.cosmetics[plan.cosm].emoji .. " " .. CAL.cosmetics[plan.cosm].name
		end
		if plan.title and CAL.titles[plan.title] then
			d.titles[plan.title] = true
			bits[#bits + 1] = "🏷 " .. CAL.titles[plan.title].name
		end
		return table.concat(bits, " · ")
	end
	function CalSys.claim(s, day, how)
		local d = s.data
		local cal = d.cal
		if s.leaving or s.calBusy ~= true then
			return
		end
		if how ~= "grace" and how ~= "quest" and how ~= "paid" then
			how = "today"
		end
		-- un rattrapage PAYANT d'un jour au tirage aléatoire (jour 30) : seulement si PolicyService a confirmé « non restreint » (rien n'est débité ici : le jeton est déjà acheté)
		if how == "paid" and type(day) == "number" and Calendar.isRandom(Config, day) and Lot7.awaitPolicy(s) then
			notify(s.player, "📅 Ce rattrapage n'est pas disponible pour ton compte.")
			return
		end
		if s.leaving or sessions[s.player] ~= s then
			return
		end
		local now = today()
		local okE, why = eligible(s)
		if okE and cal.start == 0 then
			Calendar.begin(Config, cal, now)
		end
		Calendar.normalize(Config, cal, now)
		local ok, code = Calendar.check(Config, cal, now, day, how, okE)
		if not ok then
			if code == "ineligible" then
				notify(s.player, why == "age" and ("📅 Il faut un compte Roblox d'au moins " .. CAL.minAccountAgeDays .. " jour pour le calendrier.") or ("📅 Encore " .. math.max(1, math.ceil(CAL.minPlayMinutes - d.played / 60)) .. " min de jeu avant de débloquer le calendrier."))
			else
				notify(s.player, refusal[code] or refusal.day)
			end
			sync(s)
			return
		end
		local plan = Calendar.plan(Config, day, rng:NextNumber(), income(s))
		if plan.egg and not L15.Rewards.canStore(Lot7.L16.bagCfg(s), d.slots, cap(s), d.eggBag, 1) then -- lot 15 : base OU sac d'œufs
			notify(s.player, "📅 Ta base et ton sac d'œufs sont pleins : libère une place, un œuf t'attend (rien n'est perdu).")
			return
		end
		-- 1. jour marqué dans le profil (état d'avant gardé pour l'annuler), 2. sauvegarde, 3. octroi
		local before = { days = cal.days, grace = cal.grace, catch = cal.catch, qc = cal.qc, dayD = cal.dayD, dayN = cal.dayN, streak = d.calStreak, last = d.calLast }
		local streak = Calendar.apply(Config, cal, now, day, how)
		d.calStreak, d.calLast = streak, now
		if not s.noSave and not Data.save(s.player, d, false) then
			cal.days, cal.grace, cal.catch, cal.qc, cal.dayD, cal.dayN = before.days, before.grace, before.catch, before.qc, before.dayD, before.dayN
			d.calStreak, d.calLast = before.streak, before.last
			notify(s.player, "📅 Sauvegarde impossible pour l'instant : réessaie dans un moment (rien n'a été perdu).")
			sync(s)
			return
		end
		local text = applyReward(s, plan, how == "paid" and "r" or "g") -- vitrine : un jour rattrapé avec un jeton PAYANT (CalendarCatchup) ne compte jamais
		notify(s.player, "📅 Jour " .. day .. (how == "today" and "" or " rattrapé") .. " : " .. text, (function()
			for _, m in ipairs(CAL.milestones) do
				if m == day then
					return "calendar_milestone"
				end
			end
			return "calendar_claim"
		end)()) -- lot 10 : sons approuvés
		tele.log(s.player, "calendar_claim_day", day, how == "today" and "_today" or nil)
		if how ~= "today" then
			tele.log(s.player, "calendar_catchup", day, "_" .. how)
		end
		tele.log(s.player, "calendar_streak", streak)
		if Calendar.claimedCount(cal) >= CAL.days then
			tele.log(s.player, "calendar_cycle_complete", cal.cycle)
		end
		sync(s)
		if not s.noSave then -- l'octroi est sauvegardé tout de suite (au mieux) : la sauvegarde automatique le reprendrait sinon dans la minute
			task.spawn(function()
				Data.save(s.player, d, s.leaving == true)
			end)
		end
	end
end

function actions.calClaim(s, arg)
	if type(arg) ~= "table" or s.calBusy then
		return
	end
	s.calBusy = true
	local ok, err = pcall(Lot7.Cal.claim, s, arg.day, arg.how)
	s.calBusy = nil
	if not ok then
		warn("[Calendrier] " .. tostring(err))
	end
end

RAction.OnServerEvent:Connect(function(player, action, arg)
	local s = sessions[player]
	if not s or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - s.lastAct < 0.08 then
		return
	end
	s.lastAct = now
	s.lastActive = now -- toute action = joueur actif
	if s.evoBusy and action ~= "sync" then -- idée 2 : aucune autre action pendant la sauvegarde d'une évolution (quelques secondes au plus)
		return
	end
	local fn = actions[action]
	if fn then
		local ok, err = pcall(fn, s, arg)
		if not ok then
			warn("[Action " .. action .. "] " .. tostring(err))
		end
	end
end)

---------------------------------------------------------------- Arène des pets (PvE : tour des Dresseurs)
-- Le serveur possède tout : l'équipe est relue dans le profil à chaque combat, la graine est tirée ici, le client n'envoie qu'une intention par tour
-- (« attack », « skill », « swap1 » à « swap3 ») et rejoue les événements reçus. Récompense versée UNE fois (s.battle est vidé avant le paiement).
local Battle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Battle"))
local TW = Config.TOWER
-- LOT 14 : classé en direct (file MemoryStore, apparieur élu, serveur réservé « ranked »). Règles pures : Shared/Ranked ; transport : PvpLive
-- (runtime injecté). Fermé tant que Config.PVP_LIVE.enabled = false ou que l'expérience compte moins de PVP_LIVE.minCCU joueurs simultanés.
-- Rangé dans la table Lot7 : AUCUNE nouvelle variable locale (le bloc principal est à la limite de 200).
Lot7.Live = (function()
	local PvpLive = require(script.Parent:WaitForChild("PvpLive"))
	return PvpLive.new(Config, require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranked")), Battle, PvpLive.robloxRuntime(Config, {
		save = function(player, d)
			local ss = sessions[player]
			if ss and ss.noSave then
				return true -- profil en lecture seule (version plus récente, Studio) : rien à écrire
			end
			return Data.save(player, d)
		end,
		send = function(player, msg)
			RBattle:FireClient(player, msg)
		end,
		notify = notify,
		sync = function(ss)
			RState:FireClient(ss.player, snapshot(ss))
		end,
		log = warn,
	}))
end)()

local function battleDay(s)
	local day = os.time() // 86400
	local b = s.data.battle
	if b.day ~= day then
		b.day, b.fights, b.repeats = day, 0, 0
	end
	return b
end

local function battleUnits(s)
	local units = {}
	for _, idx in ipairs(s.data.battle.team) do
		local sl = validSlot(idx) and s.data.slots[idx]
		if sl and sl.k == "p" then
			units[#units + 1] = Battle.unit(Config, sl, Lot7.Evolution.powerScale(Config, sl)) -- idée 2 : forme 2 = pv et attaque x Config.EVOLUTION.powerMul
		end
	end
	return units
end

function actions.setTeam(s, arg)
	if s.battle or type(arg) ~= "table" then
		return
	end
	local team, seen = {}, {}
	for i = 1, TW.teamSize do
		local v = arg[i]
		if type(v) == "number" and v == v and v % 1 == 0 and validSlot(v) and not seen[v] then
			local sl = s.data.slots[v]
			if sl and sl.k == "p" then
				seen[v] = true
				team[#team + 1] = v
			end
		end
	end
	s.data.battle.team = team
	RState:FireClient(s.player, snapshot(s))
end

-- PvP : saison en cours, remise à zéro douce des trophées et récompense de la saison écoulée (une seule fois, selon le palier atteint).
local function pvpState(s)
	local pv = s.data.battle.pvp
	local season = Config.pvpSeason(os.time())
	if pv.season ~= season then
		local rw = pv.season > 0 and L15.Duel.seasonReward(Config.LEAGUE_SEASON.rewards, pv.trophies) or nil -- lot 13 (E.4) : paliers étendus (100 à 1500)
		if rw then
			local parts = {}
			if (rw.coins or 0) > 0 then
				s.data.coins += rw.coins
				parts[#parts + 1] = "+" .. Config.fmt(rw.coins) .. " 🪙"
			end
			local eggT = rw.eggName and Config.tierIndexByName(rw.eggName) or rw.eggTier
			if rw.eggName and eggT then -- palier 1500 : base, puis sac d'œufs, puis coffre de débordement (jamais perdu, un seul crédit)
				local where = Lot7.L16.storeEgg(s, eggT, "g")
				parts[#parts + 1] = "un œuf " .. Config.TIERS[eggT].name .. (where == "bag" and " (dans ton sac d'œufs)" or (where == "overflow" and " (dans le coffre de débordement)" or ""))
			elseif eggT and Config.TIERS[eggT] then
				giveEgg(s, eggT, "g")
				parts[#parts + 1] = "un œuf " .. Config.TIERS[eggT].name
			end
			if rw.potion or rw.potionSeconds then
				local secs = rw.potionSeconds or Config.LUCK_POTION_SECONDS
				s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + secs
				parts[#parts + 1] = "potion de chance (" .. math.floor(secs / 60) .. " min)"
			end
			notify(s.player, "🏆 Fin de saison PvP : " .. pv.trophies .. " trophées -> " .. table.concat(parts, " + ") .. (rw.title and (" · 👑 " .. rw.title .. " " .. pv.season) or ""), "claim")
		end
		pv.season, pv.trophies, pv.wins, pv.losses = season, L15.Duel.seasonReset(pv.trophies, Config.LEAGUE_SEASON.resetAbove, Config.LEAGUE_SEASON.resetFactor), 0, 0 -- lot 13 (E.4) : max(300, floor(t x 0,6)) au-delà de 300
	end
	local day = os.time() // 86400
	if pv.day ~= day then
		pv.day, pv.fights = day, 0
	end
	return pv
end

local function pvpPublishAsync(s)
	local pv = s.data.battle.pvp
	local team, season, trophies, player = {}, pv.season, pv.trophies, s.player
	for _, e in ipairs(pv.defense) do
		team[#team + 1] = { p = e.p, s = e.s, m = e.m }
	end
	if #team > 0 then
		task.spawn(function()
			pcall(Data.pvpPublish, player, team, trophies, season)
		end)
	end
end

-- LOT 12 B : cartes de récompense (D.5). Le tirage est enregistré dans le profil (battle.pendingPick) AVANT l'envoi : déconnexion ou relance ne retire pas la récompense.
-- Délai de 15 s tenu par le SERVEUR (première carte d'office). Jamais exposé par snapshot : les cartes ne sortent que par { k = "pick" }.
function L15.pickHooks(s)
	local h = { where = nil }
	-- Carte Œuf : place libre cherchée AVANT ; base pleine -> sac d'œufs puis coffre de débordement (lot 15/16), jamais l'ancien giveEgg (demi-prix) ni de perte.
	h.giveEgg = function(t)
		if freeSlot(s) then
			h.where = "slot"
			return giveEgg(s, t, "g") -- vitrine : carte Œuf d'un combat = gagnée en jouant
		end
		h.where = Lot7.L16.storeEgg(s, t, "g")
		return h.where == "bag" or h.where == "overflow" or h.where == "slot"
	end
	return h
end
function L15.sendPick(s)
	local pk = s.data.battle.pendingPick
	if not pk then
		return
	end
	if L15.BR.expired(pk, os.time()) then
		return L15.claimPick(s, nil, nil)
	end
	local v = L15.BR.view(Config, pk, os.time())
	RBattle:FireClient(s.player, { k = "pick", id = v.id, cards = v.cards, seconds = v.seconds, floor = v.floor })
	task.delay(v.seconds + 1, function()
		local cur = s.data.battle.pendingPick
		if s.player.Parent and sessions[s.player] == s and cur and cur.id == v.id then
			L15.claimPick(s, nil, nil)
		end
	end)
end
function L15.claimPick(s, id, index)
	local b = s.data.battle
	local card, auto = L15.BR.claim(b.pendingPick, id, index, os.time())
	if not card then
		return -- index ou identifiant invalide : rien n'est consommé
	end
	b.pendingPick = nil -- vidé AVANT d'attribuer : aucun double gain
	local hooks = L15.pickHooks(s)
	local out = L15.BR.grant(Config, s.data, card, hooks, os.time(), L15.PetXp)
	local _, _, desc = L15.BR.cardText(Config, card)
	local note = (out and out.converted and " (converti en pièces)") or (hooks.where == "bag" and " (base pleine : rangé dans ton sac d'œufs)") or (hooks.where == "overflow" and " (base et sac pleins : rangé dans le coffre de débordement)") or ""
	RBattle:FireClient(s.player, { k = "picked", text = desc .. note, auto = auto })
	RState:FireClient(s.player, snapshot(s))
end
-- Propose les 3 cartes à la fin d'un combat gagné (mode « first » / « repeat » / « npc »), puis les envoie.
function L15.offerPick(s, floor, mode)
	local b = s.data.battle
	local pick = L15.BR.offer(Config, b.pendingPick, { floor = floor, income = income(s), mode = mode }, rng:NextInteger(1, 2147483000), os.time(), game:GetService("HttpService"):GenerateGUID(false))
	b.pendingPick = pick
	return pick
end
function actions.battlePick(s, arg) -- arg = { id, i } ; le dispatcher RAction fournit déjà la limitation de fréquence ; tout est revalidé par L15.BR.claim
	if type(arg) == "table" and type(arg.id) == "string" and #arg.id <= 64 and type(arg.i) == "number" then
		L15.claimPick(s, arg.id, arg.i)
	end
end

local function battleFinish(s)
	local bt = s.battle
	s.battle = nil -- vidé AVANT tout paiement : aucune double récompense possible
	local st, win = bt.st, bt.st.winner == 1
	local b = s.data.battle
	local rewards = {}
	if not bt.pvp then -- lot 13 (B.4) : ratio PvE (tour et PNJ) affiché dans l'intro
		b.pve = type(b.pve) == "table" and b.pve or { w = 0, l = 0 }
		if win then
			b.pve.w = math.min(1e7, (b.pve.w or 0) + 1)
		else
			b.pve.l = math.min(1e7, (b.pve.l or 0) + 1)
		end
	end
	if bt.npc then
		return L15.fightEnd(s, bt, win) -- lot 15 : combat de PNJ (résultat déclaré par le serveur, une seule fois)
	end
	if bt.pvp then
		local pv = pvpState(s)
		if win then
			local gain = Config.pvpGain(pv.trophies, bt.pvp.trophies)
			pv.trophies, pv.wins = pv.trophies + gain, pv.wins + 1
			rewards.trophies = gain
		else
			local loss = math.min(pv.trophies, Config.PVP.loss)
			pv.trophies, pv.losses = pv.trophies - loss, pv.losses + 1
			rewards.trophies = -loss
		end
		rewards.total = pv.trophies
		if win then
			L15.weekly(s, "pvp", 1) -- lot 15 : quête de la semaine « duels »
			Lot7.L16.addXp(s, "pvp") -- lot 16 : XP du passe de combat (victoire PvP, validée par le serveur)
		end
		pvpPublishAsync(s)
		L15.PetXp.addToTeam(s.data.slots, b.team, L15.PetXp.award("pvp", L15.PetXp.combat("pvp", win, 0), L15.PetXp.boostMul(s.data, os.time()))) -- lot 12 B : XP de pet (PvP)
		RBattle:FireClient(s.player, { k = "end", win = win, rewards = rewards, best = b.best, floor = 0, pvp = true, foe = bt.pvp.name, view = Battle.view(st) })
		RState:FireClient(s.player, snapshot(s))
		return
	end
	local sendAfter = false
	if win then
		L15.onPve(s) -- lot 15 : quête bonus, quête de la semaine et plumes d'une victoire PvE
		local first = bt.floor > b.best
		if first then
			b.best = bt.floor
			tele.log(s.player, "tower_floor_reached", bt.floor)
		end
		if first or b.repeats < TW.dailyRepeats + Lot7.L16.arenaExtra(s) then -- lot 16 : les tickets d'arène ajoutent des combats RÉCOMPENSÉS
			if not first then
				b.repeats += 1
			end
			rewards.first = first
			L15.qk(s, "pveWin", { rewarded = true, units = st.sides[1].units, weekType = L15.Rewards.rotation(Config, L15.Rewards.weekOf(os.time() // 86400)).type }) -- A11 : victoire de tour RÉCOMPENSÉE
			rewards.pick = true -- lot 12 B : le client attend { k = "pick" } (3 cartes) et masque « Continuer » ; remplace Config.towerReward
			L15.offerPick(s, bt.floor, first and "first" or "repeat")
			sendAfter = true
		else
			rewards.limited = true
		end
	end
	L15.PetXp.addToTeam(s.data.slots, b.team, L15.PetXp.award("pve", L15.PetXp.combat("pve", win, bt.floor), L15.PetXp.boostMul(s.data, os.time()))) -- lot 12 B : XP de pet (tour)
	RBattle:FireClient(s.player, { k = "end", win = win, rewards = rewards, best = b.best, floor = bt.floor, view = Battle.view(st) })
	RState:FireClient(s.player, snapshot(s))
	if sendAfter then
		L15.sendPick(s)
	end
end

local function battleStep(s, act)
	local bt = s.battle
	if not bt or bt.st.over then
		return
	end
	local events = Battle.turn(bt.st, act)
	bt.deadline = os.clock() + TW.turnSeconds
	if bt.st.over then
		RBattle:FireClient(s.player, { k = "turn", events = events, view = Battle.view(bt.st) })
		battleFinish(s)
	else
		RBattle:FireClient(s.player, { k = "turn", events = events, view = Battle.view(bt.st), seconds = TW.turnSeconds })
	end
end

function actions.pvpDefense(s)
	if s.battle then
		return
	end
	local pv = pvpState(s)
	local def = {}
	for _, idx in ipairs(s.data.battle.team) do
		local sl = validSlot(idx) and s.data.slots[idx]
		if sl and sl.k == "p" then
			def[#def + 1] = { p = sl.p, s = sl.s, m = sl.m }
		end
	end
	if #def == 0 then
		notify(s.player, "🛡 Choisis d'abord une équipe de pets.", "refuse")
		return
	end
	pv.defense = def
	pvpPublishAsync(s)
	notify(s.player, "🛡 Équipe de défense enregistrée (" .. #def .. " pet" .. (#def > 1 and "s" or "") .. "). Les autres joueurs peuvent l'affronter.", "buy")
	RState:FireClient(s.player, snapshot(s))
end

function actions.pvpStart(s)
	if s.battle or s.castle or s.pvpPending then
		return
	end
	local pv = pvpState(s)
	if #pv.defense == 0 then
		notify(s.player, "🛡 Enregistre d'abord ton équipe de défense pour entrer au classement.", "refuse")
		return
	end
	if pv.fights >= Config.PVP.dailyFights then
		notify(s.player, "🏆 Limite de combats classés atteinte pour aujourd'hui (" .. Config.PVP.dailyFights .. ").", "refuse")
		return
	end
	local mine = battleUnits(s)
	if #mine == 0 then
		notify(s.player, "⚔️ Compose d'abord une équipe de pets.", "refuse")
		return
	end
	s.pvpPending = true -- la recherche d'adversaire attend le DataStore : un seul départ à la fois
	local player = s.player
	task.spawn(function()
		local okOpp, opp = pcall(Data.pvpOpponent, player.UserId, pv.trophies, pv.season, rng:NextInteger(0, 4))
		s.pvpPending = nil
		if not (okOpp and sessions[player] == s) or s.battle then
			return
		end
		if not opp then -- aucun autre joueur classé : adversaire fantôme de la tour, au niveau des trophées
			local floor = math.min(Config.TOWER.floors, 1 + pv.trophies // 40)
			local ghost = {}
			for _, u in ipairs(Battle.towerTeam(Config, floor)) do
				ghost[#ghost + 1] = { p = u.p, s = u.s, m = u.m }
			end
			opp = { name = "Dresseur fantôme", team = ghost, trophies = pv.trophies }
		end
		local foes = {}
		for _, e in ipairs(opp.team) do
			foes[#foes + 1] = Battle.unit(Config, e)
		end
		pv.fights += 1
		s.battle = { st = Battle.new(rng:NextInteger(1, 2147483000), battleUnits(s), foes), floor = 0, pvp = { name = opp.name, trophies = opp.trophies }, deadline = os.clock() + TW.turnSeconds }
		RBattle:FireClient(player, { k = "start", floor = 0, foe = "🏆 " .. opp.name, pvp = true, view = Battle.view(s.battle.st), seconds = TW.turnSeconds })
	end)
end

-- LOT 14 : file en direct. Fermée (désactivée, moins de 60 joueurs simultanés, comptage inconnu) = classé asynchrone directement.
function actions.liveQueue(s)
	local ok, why = Lot7.Live.enqueue(s, { busy = s.battle ~= nil or s.castle ~= nil or s.pvpPending == true or #s.carry > 0 or s.leaving == true, serverMode = serverMode, party = serverPartyId })
	if ok then
		return
	elseif why == "closed" then
		return actions.pvpStart(s)
	elseif why == "fights" then
		notify(s.player, "🏆 Limite de combats classés en direct atteinte pour aujourd'hui (" .. Config.PVP_LIVE.dailyFights .. ").", "refuse")
	elseif why == "cap" then
		notify(s.player, "🏆 Plafond de trophées du jour atteint en direct (" .. Config.PVP_LIVE.dailyTrophyCap .. ") : reviens demain ou joue en classé enregistré.", "refuse")
	elseif why == "team" then
		notify(s.player, "⚔️ Compose d'abord une équipe de pets.", "refuse")
	elseif why == "busy" then
		notify(s.player, "⚔️ Termine d'abord ce que tu fais (combat, œuf porté, château).", "refuse")
	end
end

function actions.liveCancel(s)
	Lot7.Live.cancel(s)
end

function actions.towerStart(s, floor)
	if s.battle or s.castle or type(floor) ~= "number" or floor ~= floor or floor % 1 ~= 0 then
		return
	end
	local b = battleDay(s)
	if floor < 1 or floor > TW.floors or floor > b.best + 1 then
		notify(s.player, "🔒 Étage verrouillé : bats d'abord l'étage " .. (b.best + 1) .. ".", "refuse")
		return
	end
	if b.fights >= TW.dailyFights + Lot7.L16.arenaExtra(s) then -- lot 16 : tickets d'arène du jour (combats en plus)
		notify(s.player, "⚔️ Limite de combats atteinte pour aujourd'hui (" .. (TW.dailyFights + Lot7.L16.arenaExtra(s)) .. "). Reviens demain !", "refuse")
		Lot7.L16.event(s, "towerQuotaExhausted") -- lot 16 : offre contextuelle « Ticket d'arène » (si elle est permise)
		return
	end
	local mine = battleUnits(s)
	if #mine == 0 then
		notify(s.player, "⚔️ Compose d'abord une équipe de pets (1 à " .. TW.teamSize .. ").", "refuse")
		return
	end
	b.fights += 1
	L15.onb(s, "arena") -- lot 17 : étape « premier pet à l'Arène » (le combat est accepté et l'équipe n'est pas vide)
	local seed = rng:NextInteger(1, 2147483000)
	L15.boostUnits(mine) -- lot 15 : type « en forme » de la semaine (+20 % d'attaque, PvE seulement)
	s.battle = { st = Battle.new(seed, mine, Battle.towerTeam(Config, floor)), floor = floor, deadline = os.clock() + TW.turnSeconds }
	RBattle:FireClient(s.player, { k = "start", floor = floor, foe = Config.towerFoeName(floor), view = Battle.view(s.battle.st), seconds = TW.turnSeconds })
end

function actions.battleAct(s, arg)
	if Lot7.Live.act(s, arg) then
		return -- lot 14 : combat classé en direct (deux joueurs)
	end
	local bt = s.battle
	if bt and bt.duel then
		return L15.duel.act(s, arg) -- lot 13 : duel local (deux joueurs)
	end
	if not bt or type(arg) ~= "string" then
		return
	end
	local act
	if arg == "attack" or arg == "skill" then
		act = { kind = arg }
	else
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			act = { kind = "swap", to = n }
		end
	end
	if not act or Battle.validate(bt.st, 1, act) then
		notify(s.player, "⚔️ Action impossible.", "refuse")
		return
	end
	battleStep(s, act)
end

function actions.battleQuit(s)
	if Lot7.Live.quit(s) then
		return -- lot 14 : abandon d'un combat en direct = forfait
	end
	if s.battle and s.battle.duel then
		return L15.duel.quit(s) -- lot 13 : abandon d'un duel = forfait
	end
	if s.battle then
		s.battle.st.over, s.battle.st.winner = true, 2 -- abandon = défaite (le combat compte dans la limite du jour)
		battleFinish(s)
	end
end

task.spawn(function() -- tour limité à 10 s : action par défaut (attaque)
	while true do
		task.wait(1)
		for _, s in pairs(sessions) do
			local bt = s.battle
			if bt and not bt.duel and os.clock() > bt.deadline then -- lot 13 : les duels ont leur propre minuteur (L15.duel)
				pcall(battleStep, s, { kind = "attack" })
			end
		end
	end
end)

---------------------------------------------------------------- Duel local (lot 13, E.1 E.2 B.4) : défis, sable du colisée, tours à deux, spectateurs ; AUCUN trophée
-- Règles PURES dans ReplicatedStorage/Duel.lua (tests/lot13.luau) ; ce bloc lit l'état des joueurs et applique les décisions. Une seule variable locale (D, rangée
-- aussi dans L15.duel) : le bloc principal est proche de la limite Luau de 200 variables locales.
-- Le client n'envoie que : duelChallenge(userId), duelAnswer({ from, accept }), duelOff(bool) et, pendant le duel, battleAct / battleQuit (routés ici).
-- Chaque demande est revalidée par le serveur (distance, états des DEUX joueurs relus à l'acceptation, cooldown, défis en attente, équipe, réglage « refuser »).
do
	local D = { book = L15.Duel.newBook(), matches = {}, C = Config.DUEL }
	L15.duel = D
	D.REFUSE = {
		self = "⚔️ Tu ne peux pas te défier toi-même.", range = "⚔️ Trop loin pour un duel (approche-toi).", egg = "⚔️ Pas de duel avec un œuf dans les mains.", chased = "⚔️ Pas de duel pendant une poursuite.",
		dialogue = "⚔️ Un dialogue est en cours.", castle = "⚔️ Pas de duel en mode Château.", newbie = "⚔️ Protection débutant : désactive-la pour combattre.", busy = "⚔️ Un combat est déjà en cours.",
		flying = "⚔️ Pas de duel pendant un vol d'œuf.", cinematic = "⚔️ Pas de duel pendant une éclosion.",
		cooldown = "⚔️ Tu as déjà défié ce joueur : attends un peu.", pendingOut = "⚔️ Ton défi précédent est encore en attente.", crowded = "⚔️ Ce joueur a déjà plusieurs défis.",
		expired = "⚔️ Ce défi a expiré.", none = "⚔️ Ce défi n'est plus valable.", off = "⚔️ Ce joueur refuse les duels (réglage).", team = "⚔️ Compose d'abord une équipe de pets (Arène).",
		foeTeam = "⚔️ Ce joueur n'a pas encore d'équipe de pets.",
	}
	function D.flags(s)
		local root = getRoot(s.player)
		local c = root and L15.ctx and L15.ctx(s, root) or {}
		return {
			userId = s.player.UserId, carryingEgg = c.carrying == true or #s.carry > 0, chased = c.chased == true, inDialogue = c.pending == true,
			inCastle = s.castle ~= nil or serverMode == "castle", newbie = isNewbie(s), busy = s.battle ~= nil or s.pvpPending == true or s.leaving == true or serverMode == "ranked" or (Lot7.Live ~= nil and Lot7.Live.queued[s.player.UserId] ~= nil), -- lot 14 : en file classée = occupé
			flying = holds[s.player] ~= nil, inCinematic = os.clock() < (s.cineUntil or 0),
		}
	end
	function D.ctx(s, t)
		local r1, r2 = getRoot(s.player), getRoot(t.player)
		if not r1 or not r2 then
			return nil
		end
		return { a = D.flags(s), b = D.flags(t), distance = (r1.Position - r2.Position).Magnitude }
	end
	function D.find(s) -- duel en cours du joueur (id, match, côté 1 = défieur / 2 = défié)
		for id, d in pairs(D.matches) do
			if d.a == s then
				return id, d, 1
			elseif d.b == s then
				return id, d, 2
			end
		end
		return nil
	end
	function D.spectators(d) -- joueurs proches du colisée (hors duellistes) : reçoivent le bandeau du duel
		local A, out = Config.Map2.arena, {}
		for p, ss in pairs(sessions) do
			if ss ~= d.a and ss ~= d.b then
				local r = getRoot(p)
				if r and (Vector3.new(r.Position.X - A.x, 0, r.Position.Z - A.z)).Magnitude <= D.C.spectatorRange then
					out[#out + 1] = p
				end
			end
		end
		return out
	end
	function D.broadcast(d, msg) -- msg du point de vue du défieur (camp 1)
		for _, p in ipairs(D.spectators(d)) do
			RBattle:FireClient(p, msg)
		end
	end
	function D.watch(d, events)
		return { k = "duelWatch", a = d.a.player.DisplayName, b = d.b.player.DisplayName, view = Battle.view(d.st), events = events, over = d.st.over, winner = d.winnerName }
	end
	function D.place(s, side) -- sur le sable, face à face (±sandOffset en X), personnage figé pendant le duel
		local root = getRoot(s.player)
		if not root then
			return
		end
		local A = Config.Map2.arena
		local x = A.x + (side == 1 and -D.C.sandOffset or D.C.sandOffset)
		s.duelBack = root.Position
		root.CFrame = CFrame.lookAt(Vector3.new(x, 4, A.z), Vector3.new(A.x, 4, A.z))
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true
		s.noCheckUntil, s.lastPos = os.clock() + 2, nil
	end
	function D.release(s) -- personnage libéré et ramené où il était avant le duel
		local root = getRoot(s.player)
		if root then
			root.Anchored = false
			if s.duelBack then
				root.CFrame = CFrame.new(s.duelBack + Vector3.new(0, 1, 0))
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end
		s.duelBack, s.noCheckUntil, s.lastPos = nil, os.clock() + 2, nil
	end

	function actions.duelOff(s, v)
		if type(v) ~= "boolean" then
			return
		end
		s.data.settings.duelOff = v
		RState:FireClient(s.player, snapshot(s))
	end

	function actions.duelChallenge(s, arg) -- arg = userId du joueur défié
		if type(arg) ~= "number" or arg ~= arg or arg % 1 ~= 0 then
			return
		end
		local target = Players:GetPlayerByUserId(arg)
		local t = target and sessions[target]
		if not t then
			return
		end
		if t == s then
			notify(s.player, D.REFUSE.self, "refuse")
			return
		end
		if #battleUnits(s) == 0 then
			notify(s.player, D.REFUSE.team, "refuse")
			return
		end
		if t.data.settings.duelOff == true then
			notify(s.player, D.REFUSE.off, "refuse")
			return
		end
		if #battleUnits(t) == 0 then
			notify(s.player, D.REFUSE.foeTeam, "refuse")
			return
		end
		local ctx = D.ctx(s, t)
		if not ctx then
			return
		end
		local ok, why = L15.Duel.request(D.book, ctx, os.clock(), D.C)
		if not ok then
			notify(s.player, D.REFUSE[why] or D.REFUSE.busy, "refuse")
			return
		end
		notify(s.player, "⚔️ Défi envoyé à " .. target.DisplayName .. " (" .. D.C.requestTimeout .. " s pour répondre).", "buy")
		RBattle:FireClient(target, { k = "duelAsk", from = s.player.DisplayName, fromId = s.player.UserId, seconds = D.C.requestTimeout })
	end

	function D.start(f, s, id)
		local unitsA, unitsB = battleUnits(f), battleUnits(s)
		local st = Battle.new(rng:NextInteger(1, 2147483000), unitsA, unitsB)
		local d = { id = id, m = L15.Duel.newMatch(f.player.UserId, s.player.UserId), a = f, b = s, st = st, act = {}, deadline = os.clock() + D.C.turnSeconds + D.C.introSeconds }
		D.matches[id] = d
		f.battle = { duel = id, st = st, deadline = math.huge } -- s.battle occupé : tour, PvP, PNJ, équipe et nouveaux défis bloqués par les gardes existantes
		s.battle = { duel = id, st = st, deadline = math.huge }
		D.place(f, 1)
		D.place(s, 2)
		local view = Battle.view(st)
		local function side(me, foe, mineView)
			local w, l = L15.Duel.recordFor("duel", me.data.battle)
			local fw, fl = L15.Duel.recordFor("duel", foe.data.battle)
			return {
				me = { name = me.player.DisplayName, userId = me.player.UserId, wins = w, losses = l, trophies = me.data.battle.pvp.trophies, league = L15.Duel.leagueText(Config.LEAGUES, me.data.battle.pvp.trophies) },
				foe = { name = foe.player.DisplayName, userId = foe.player.UserId, wins = fw, losses = fl, trophies = foe.data.battle.pvp.trophies, league = L15.Duel.leagueText(Config.LEAGUES, foe.data.battle.pvp.trophies) },
				view = mineView,
			}
		end
		local ia, ib = side(f, s, view), side(s, f, L15.Duel.mirrorView(view))
		local A = Config.Map2.arena
		RBattle:FireClient(f.player, { k = "start", floor = 0, duel = true, foe = "⚔️ " .. s.player.DisplayName, view = ia.view, seconds = D.C.turnSeconds + D.C.introSeconds, intro = { me = ia.me, foe = ia.foe }, arena = { x = A.x, z = A.z, side = 1 } })
		RBattle:FireClient(s.player, { k = "start", floor = 0, duel = true, foe = "⚔️ " .. f.player.DisplayName, view = ib.view, seconds = D.C.turnSeconds + D.C.introSeconds, intro = { me = ib.me, foe = ib.foe }, arena = { x = A.x, z = A.z, side = 2 } })
		D.broadcast(d, D.watch(d, {}))
	end

	function actions.duelAnswer(s, arg) -- arg = { from = userId, accept = bool }
		if type(arg) ~= "table" or type(arg.from) ~= "number" or arg.from ~= arg.from then
			return
		end
		local fromPlayer = Players:GetPlayerByUserId(arg.from)
		local f = fromPlayer and sessions[fromPlayer]
		if not f or f == s then
			L15.Duel.decline(D.book, s.player.UserId, arg.from, os.clock(), D.C)
			return
		end
		local accept = arg.accept == true
		if accept and (#battleUnits(s) == 0 or #battleUnits(f) == 0) then
			L15.Duel.decline(D.book, s.player.UserId, arg.from, os.clock(), D.C)
			notify(s.player, #battleUnits(s) == 0 and D.REFUSE.team or D.REFUSE.foeTeam, "refuse")
			notify(f.player, "⚔️ Duel annulé : une équipe de pets est vide.", "refuse")
			return
		end
		local ok, id, cancelled = L15.Duel.answer(D.book, s.player.UserId, arg.from, accept, os.clock(), D.C, accept and D.ctx(f, s) or nil)
		if not ok then
			if id == "declined" then
				notify(f.player, "⚔️ " .. s.player.DisplayName .. " a refusé ton défi.", "refuse")
			elseif id ~= "none" then
				notify(f.player, D.REFUSE[id] or "⚔️ Défi annulé.", "refuse")
				notify(s.player, D.REFUSE[id] or "⚔️ Défi annulé.", "refuse")
			end
			return
		end
		for _, c in ipairs(cancelled) do
			local p = Players:GetPlayerByUserId(c.from)
			if p then
				notify(p, "⚔️ Défi annulé : ce joueur est déjà en duel.", "refuse")
			end
			local q = Players:GetPlayerByUserId(c.to)
			if q then
				RBattle:FireClient(q, { k = "duelAskEnd", fromId = c.from })
			end
		end
		D.start(f, s, id)
	end

	function D.act(s, arg) -- intention d'un duelliste pour le tour en cours (une seule par tour, validée par le moteur)
		local id, d, side = D.find(s)
		if not id or d.st.over then
			return
		end
		local act = L15.Duel.parseAction(arg)
		if not act or Battle.validate(d.st, side, act) then
			notify(s.player, "⚔️ Action impossible.", "refuse")
			return
		end
		if d.act[side] then
			return -- déjà choisie pour ce tour
		end
		d.act[side] = act
		if d.act[1] and d.act[2] then
			D.resolve(id)
		end
	end

	function D.resolve(id) -- joue le tour (action manquante = attaque), compte l'inactivité, diffuse
		local d = D.matches[id]
		if not d then
			return
		end
		local actedA, actedB = d.act[1] ~= nil, d.act[2] ~= nil
		local events = Battle.turn(d.st, d.act[1] or { kind = "attack" }, d.act[2] or { kind = "attack" })
		d.act = {}
		d.deadline = os.clock() + D.C.turnSeconds
		local verdict = L15.Duel.noteTurn(d.m, actedA, actedB, D.C)
		local winner
		if d.st.over then
			winner = d.st.winner == 1 and "a" or "b"
		elseif verdict == "forfeitA" then
			winner = "b"
		elseif verdict == "forfeitB" then
			winner = "a"
		end
		local view = Battle.view(d.st)
		local over = d.st.over or verdict ~= "continue"
		RBattle:FireClient(d.a.player, { k = "turn", duel = true, events = events, view = view, seconds = (not over) and D.C.turnSeconds or nil })
		RBattle:FireClient(d.b.player, { k = "turn", duel = true, events = L15.Duel.mirrorEvents(events), view = L15.Duel.mirrorView(view), seconds = (not over) and D.C.turnSeconds or nil })
		if over then
			D.finish(id, winner, verdict == "cancelled" and "cancelled" or (d.st.over and "ko" or "afk"))
		else
			D.broadcast(d, D.watch(d, events))
		end
	end

	-- Fin du duel (KO, forfait d'inactivité, abandon, départ, annulation). winner = "a" | "b" | nil. Récompenses : Duel.settle (10/jour, 3/paire/jour),
	-- pièces seulement (jamais de trophée ni de Robux) ; départ / abandon avant earlyMinTurns tours = personne n'est payé. leaver = session qui part (pas de pièces).
	function D.finish(id, winner, reason, leaver)
		local d = D.matches[id]
		if not d then
			return
		end
		D.matches[id] = nil -- retiré AVANT tout paiement : aucune double récompense
		d.m.over, d.m.winner = true, winner
		local early = reason == "leave" or reason == "quit"
		local oa, ob = L15.Duel.outcomes(d.m)
		d.winnerName = winner == "a" and d.a.player.DisplayName or (winner == "b" and d.b.player.DisplayName or nil)
		for _, e in ipairs({ { d.a, d.b, oa, 1 }, { d.b, d.a, ob, 2 } }) do
			local me, foe, outcome, side = e[1], e[2], e[3], e[4]
			me.battle = nil
			if sessions[me.player] == me then
				local res = L15.Duel.settle(me.data.battle.duel, foe.player.UserId, outcome, os.time(), income(me), D.C)
				local coins = me ~= leaver and L15.Duel.payable(res, d.m.turns, early, D.C.earlyMinTurns) or 0
				if coins > 0 then
					L15.qk(me, "duelPaid", { coins = coins }) -- A11 : quête « duel » (duels payés seulement : plafonds jour et paire de Duel.settle)
					me.data.coins += coins
					L15.PetXp.addToTeam(me.data.slots, me.data.battle.team, L15.PetXp.award("pvp", L15.PetXp.combat("pvp", res.won, 0), L15.PetXp.boostMul(me.data, os.time()))) -- XP de pet : seulement les duels payés (plafonnés)
				end
				if me ~= leaver then
					D.release(me)
					local view = Battle.view(d.st)
					local text = reason == "cancelled" and "⚔️ Duel annulé (personne n'a joué)." or ((res.won and "⚔️ Duel gagné" or "⚔️ Duel perdu")
						.. (reason == "afk" and " (forfait d'inactivité)" or (early and (me == (winner == "a" and d.a or d.b) and (reason == "leave" and " (l'adversaire est parti)" or " (abandon de l'adversaire)") or " (abandon)") or ""))
						.. (coins > 0 and (" : +" .. Config.fmt(coins) .. " 🪙") or (res.reason == "dayCap" and " · limite de 10 duels récompensés atteinte aujourd'hui" or (res.reason == "pairCap" and " · déjà 3 duels récompensés contre ce joueur aujourd'hui" or " · amical : pas de récompense"))))
					RBattle:FireClient(me.player, { k = "end", duel = true, win = res.won, rewards = { coins = coins > 0 and coins or nil, duelText = text, cancelled = reason == "cancelled" }, best = me.data.battle.best, floor = 0, foe = foe.player.DisplayName, view = side == 1 and view or L15.Duel.mirrorView(view) })
					notify(me.player, text, res.won and "claim" or "refuse")
					RState:FireClient(me.player, snapshot(me))
				end
			end
		end
		L15.Duel.finish(D.book, d.a.player.UserId)
		L15.Duel.finish(D.book, d.b.player.UserId)
		d.st.over = true
		D.broadcast(d, D.watch(d, {}))
	end

	function D.quit(s) -- abandon = forfait
		local id, d, side = D.find(s)
		if id then
			d.st.over = true
			D.finish(id, side == 1 and "b" or "a", "quit")
		end
	end

	function L15.duelLeave(s) -- départ d'un joueur (appelé par PlayerRemoving AVANT la sauvegarde) : forfait, défis retirés, rien ne reste en mémoire
		local id, _, side = D.find(s)
		if id then
			D.finish(id, side == 1 and "b" or "a", "leave", s)
		end
		for _, p in pairs(D.book.pending) do
			if p.to == s.player.UserId then
				local q = Players:GetPlayerByUserId(p.from)
				if q then
					notify(q, "⚔️ Défi annulé : ce joueur est parti.", "refuse")
				end
			elseif p.from == s.player.UserId then
				local q = Players:GetPlayerByUserId(p.to)
				if q then
					RBattle:FireClient(q, { k = "duelAskEnd", fromId = p.from })
				end
			end
		end
		L15.Duel.finish(D.book, s.player.UserId)
		s.duelBack = nil
	end

	task.spawn(function() -- délais : défis expirés, tours de 10 s (action par défaut = attaque), purge des cooldowns
		while true do
			task.wait(0.5)
			pcall(function()
				local now = os.clock()
				for _, e in ipairs(L15.Duel.expire(D.book, now, D.C)) do
					local p, q = Players:GetPlayerByUserId(e.from), Players:GetPlayerByUserId(e.to)
					if p then
						notify(p, "⚔️ Pas de réponse : défi expiré.", "refuse")
					end
					if q then
						RBattle:FireClient(q, { k = "duelAskEnd", fromId = e.from })
					end
				end
				for id, d in pairs(D.matches) do
					if now > d.deadline then
						local ok, err = pcall(D.resolve, id)
						if not ok then
							warn("[Duel] " .. tostring(err))
							D.finish(id, nil, "cancelled")
						end
					end
				end
				L15.Duel.prune(D.book, now, D.C)
			end)
		end
	end)
end

task.spawn(function() -- lot 14 : file, apparieur, arène et retours, une fois par seconde (chaque appel réseau est dans un pcall côté PvpLive)
	pcall(function()
		TeleportService.TeleportInitFailed:Connect(function(player)
			Lot7.Live.teleportFailed(player)
		end)
	end)
	while true do
		task.wait(1)
		local ok, err = pcall(Lot7.Live.step, sessions)
		if not ok then
			warn("[PvpLive] " .. tostring(err))
		end
	end
end)

---------------------------------------------------------------- Lot 15 : PNJ, série de 7 jours, quêtes bonus et hebdomadaires, sac d'œufs, rotation, événements
-- Le SERVEUR décide de tout (jour UTC, rencontres, offres, résultats des combats) ; le client n'envoie que des identifiants ou des booléens (actions npcAnswer,
-- npcOff, daily, bagPlace, bonusClaim, weeklyClaim, plumeBuy) et n'affiche que des vues. Modules purs : ReplicatedStorage/Npc et Rewards (tests/lot15.luau).
-- Tous les œufs donnés passent par L15.storeEggs (base puis sac d'œufs, ATOMIQUE : tout ou rien, jamais de perte). Aucun Robux dans un dialogue de PNJ,
-- aucun échange entre joueurs, aucune rareté interdite (FORBIDDEN_GIFT_TIERS) donnée par un PNJ, la série ou les quêtes.
do
	local Npc, Rewards = L15.Npc, L15.Rewards
	local E = Config.NPC_ENCOUNTER
	L15.QP_WEEKLY = { hatch = "hatch", steal = "steal", discover = "collect" } -- types de missions du jour (qp) -> thèmes de la semaine
	local MSG = {
		unknown = "Cette offre n'est plus valable.", used = "Cette offre n'est plus valable.", owner = "Cette offre n'est plus valable.", state = "Cette offre n'est plus valable.",
		expired = "Trop tard : le PNJ est reparti.", coins = "Il te manque des pièces pour cette offre.", changed = "Tes pets ont changé depuis l'offre : elle est annulée.",
		bagFull = "Ta base et ton sac d'œufs sont pleins : libère une place d'abord (rien n'est perdu).",
	}
	local function today()
		return os.time() // 86400
	end
	local function tierName(t)
		return Config.TIERS[t] and Config.TIERS[t].name or "?"
	end
	function L15.book(s)
		local b = L15.books[s.player]
		if not b then
			b = Npc.newBook()
			L15.books[s.player] = b
		end
		return b
	end
	-- Fabrique d'emplacement d'œuf (incubation et bouclier comme tous les œufs posés).
	-- og = origine figée des œufs posés (vitrine) : "g" gagné en jouant, "r" payé ; absent = inconnu (sac d'œufs, coffre de débordement : jamais compté).
	function L15.mkEgg(s, og)
		return function(tier)
			return { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s), og = og }
		end
	end
	-- Range des œufs (base puis sac, tout ou rien) et rafraîchit les pads remplis. Retourne la liste « slot » / « bag » ou (nil, "bagFull") sans rien modifier.
	function L15.storeEggs(s, tiers, og)
		local d = s.data
		local before = {}
		for i = 1, cap(s) do
			before[i] = not d.slots[i]
		end
		local ok, where = Rewards.storeEggs(Lot7.L16.bagCfg(s), d.slots, cap(s), d.eggBag, tiers, L15.mkEgg(s, og))
		if not ok then
			return nil, where
		end
		for i = 1, cap(s) do
			if before[i] and d.slots[i] then
				refreshPad(s, i)
			end
		end
		return where
	end
	local function saveSoon(s)
		if not s.noSave then
			task.spawn(function()
				Data.save(s.player, s.data, s.leaving == true)
			end)
		end
	end
	-- Missions du jour TERMINÉES (progression au but), pour la quête bonus et le sauvetage gratuit de la série.
	function L15.questsDone(s)
		local n = 0
		if s.data.qday == today() then
			for _, q in ipairs(s.data.quests) do
				if q.prog >= q.goal then
					n = n + 1
				end
			end
		end
		return n
	end
	-- Synchronise le jour UTC : compteurs des PNJ, semaine des quêtes, plumes (événement en cours ; connexion créditée une fois par jour).
	function L15.daySync(s)
		local d, t = s.data, today()
		Npc.rollDay(d.npc, t)
		Rewards.weeklySync(Config, d.weekly, Rewards.weekOf(t))
		local ev, key = Rewards.limitedEvent(Config, t)
		Rewards.plumeSync(Config, d.event, t, key)
		if ev and Rewards.plumeAdd(Config, d.event, "login", true) > 0 then
			notify(s.player, "🪶 " .. ev.name .. " : +" .. Config.PLUMES.login .. " plumes d'événement (connexion du jour).", "claim")
		end
		return ev
	end
	function L15.weekly(s, key, n)
		L15.daySync(s)
		Rewards.weeklyAdd(Config, s.data.weekly, key, n)
	end
	function L15.plume(s, source)
		local ev = L15.daySync(s)
		local got = Rewards.plumeAdd(Config, s.data.event, source, ev ~= nil)
		if got > 0 then
			notify(s.player, "🪶 +" .. got .. " plumes d'événement (" .. s.data.event.p .. ")")
		end
	end
	function L15.onHatch(s, tier)
		s.revealAt, s.revealTier = os.time(), tier
		if Config.tierAtLeast(tier, "fullCine") then
			s.cineUntil = os.clock() + 20 -- grande cinématique d'éclosion côté client : aucun PNJ pendant ce temps
		end
		L15.daySync(s)
		Rewards.bonusEvent(Config, s.data.weekly, today(), s.data.story.ch, L15.questsDone(s) >= 3, { kind = "hatch", tier = tier })
	end
	function L15.onPve(s)
		Lot7.L16.addXp(s, "pve") -- lot 16 : XP du passe de combat (victoire PvE : tour, PNJ, château), décidée par le serveur
		L15.daySync(s)
		Rewards.bonusEvent(Config, s.data.weekly, today(), s.data.story.ch, L15.questsDone(s) >= 3, { kind = "pve" })
		Rewards.weeklyAdd(Config, s.data.weekly, "pve", 1)
		L15.plume(s, "pve")
	end
	-- Type « en forme » de la semaine : +20 % d'attaque en PvE (tour, PNJ). Les types de Battle (Nature) suivent les noms de la rotation (Plante).
	function L15.boostUnits(units)
		local rot = Rewards.rotation(Config, Rewards.weekOf(today()))
		for _, u in ipairs(units) do
			local ty = u.type == "Nature" and "Plante" or u.type
			local mul = Rewards.typeDamage(Config, rot, ty, true)
			if mul ~= 1 then
				u.atk = math.floor(u.atk * mul + 0.5)
			end
		end
	end

	---------------------------------------------------------------- PNJ : inventaire, contexte, emplacement, rencontre
	function L15.inv(s)
		local d = s.data
		local eq, team, pets, seen, teamTiers = {}, {}, {}, {}, {}
		for _, i in ipairs(d.equip) do
			eq[i] = true
		end
		for _, i in ipairs(d.battle.team) do
			team[i] = true
		end
		for i = 1, Config.SLOTS_MAX do
			local sl = d.slots[i]
			if sl and sl.k == "p" then
				local def = false
				for _, e in ipairs(d.battle.pvp.defense) do -- défense PvP = copies : tout pet identique est protégé (prudent)
					if e.p == sl.p and e.s == sl.s and e.m == sl.m then
						def = true
					end
				end
				pets[#pets + 1] = { slot = i, p = sl.p, s = sl.s, m = sl.m, follower = eq[i] == true, team = team[i] == true, defense = def }
				if team[i] and Config.PETS[sl.p] then
					teamTiers[#teamTiers + 1] = Config.PETS[sl.p].tier
				end
			end
		end
		for k in pairs(d.dex) do
			local n = tonumber(k)
			if n then
				seen[n] = true
			end
		end
		return {
			coins = d.coins, pets = pets, seen = seen, avgLevel = 1, teamTiers = teamTiers,
			typeOf = function(p)
				local ty = Battle.SPECIES_TYPE[p]
				return ty == "Nature" and "Plante" or ty
			end,
		}
	end
	local function chased(player)
		for _, g in ipairs(world.guards) do
			if g.target == player and g.st and g.st.state == "chase" then
				return true
			end
		end
		return false
	end
	-- Point d'apparition : à approachRange studs du joueur, sur la place ou un chemin (zone « arena »), jamais dans un territoire ni sur une base, dans la carte.
	function L15.spot(root)
		local B = Config.Map2.bounds
		local px, pz = root.Position.X, root.Position.Z
		local a0 = rnd() * math.pi * 2
		for k = 0, 7 do
			local a = a0 + k * math.pi / 4
			local x, z = px + math.cos(a) * E.approachRange, pz + math.sin(a) * E.approachRange
			local ok = x > B.x0 + 10 and x < B.x1 - 10 and z > B.z0 + 10 and z < B.z1 - 10 and Config.zoneAt(x, z) == "arena"
			for _, pl in ipairs(world.plots) do
				if ok and pl.spawn and (Vector3.new(x, 0, z) - Vector3.new(pl.spawn.Position.X, 0, pl.spawn.Position.Z)).Magnitude < 34 then
					ok = false
				end
			end
			if ok then
				return x, z
			end
		end
		return nil
	end
	-- Contexte F.2 connu du serveur. « flying » = vol d'œuf en cours (appui long sur un nid ou un œuf) ; cinématique = grande éclosion récente.
	function L15.ctx(s, root)
		local zone = Config.zoneAt(root.Position.X, root.Position.Z)
		return {
			sessionStart = s.npcStart, carrying = #s.carry > 0, chased = chased(s.player), inDuel = s.battle ~= nil or s.pvpPending == true,
			inCastle = s.castle ~= nil or serverMode == "castle", inCinematic = os.clock() < (s.cineUntil or 0), flying = holds[s.player] ~= nil,
			inTerritory = zone ~= "arena", pending = L15.book(s).current ~= nil, lastRevealAt = s.revealAt, lastRevealTier = s.revealTier,
		}
	end
	local function offerText(o)
		if o.sub == "buy" then
			return Npc.say(Config, "pip", "offer1", { rarity = tierName(o.getEgg), price = Config.fmt(o.price) })
		elseif o.sub == "dupes" then
			return Npc.say(Config, "pip", "offer2", { r = tierName(o.dupeTier), r2 = tierName(o.getEgg) })
		elseif o.sub == "species" then
			return Npc.say(Config, "nora", "offer", { species = Config.PETS[o.getSpecies.p].name, dupe = Config.PETS[o.take[1].p].name, fee = Config.fmt(o.price) })
		end
		local names = {}
		for _, e in ipairs(o.team or {}) do
			local def = Config.PETS[e.p]
			names[#names + 1] = def and (def.emoji .. " " .. def.name) or "?"
		end
		return "Équipe adverse : " .. table.concat(names, ", ") .. (o.kind == "champion" and " · victoire = Œuf " .. tierName(o.guaranteedEgg) .. " garanti" or "")
	end
	-- Une tentative de rencontre (toutes les 5 s par joueur). Rien n'est consommé si elle échoue (Npc.encounter est atomique).
	function L15.tryEncounter(s)
		local root = getRoot(s.player)
		if not (root and alive(s.player)) then
			return
		end
		local d = s.data
		local now = os.time()
		local okSpawn = Npc.canSpawn(Config, d.npc, now, today(), L15.ctx(s, root))
		if not okSpawn then
			return
		end
		local x, z = L15.spot(root)
		if not x then
			return
		end
		local o = Npc.encounter(Config, d.npc, L15.book(s), s.player.UserId, now, today(), L15.ctx(s, root), L15.inv(s), rnd)
		if not o then
			return
		end
		local def = Config.NPCS[o.npc]
		L15.remote:FireClient(s.player, {
			k = "offer", id = o.id, npc = o.npc, kind = o.kind, name = def.name, emoji = def.emoji, model = o.npc,
			approach = Npc.say(Config, o.npc, "approach"), text = offerText(o), buttons = Config.DIALOGUES[o.npc].buttons,
			view = Npc.view(Config, o, Lot7.Odds), x = x, z = z, seconds = E.offerSeconds,
		})
		tele.log(s.player, "npc_encounter", 1, "_" .. o.npc)
	end
	function L15.tick(s, dt)
		s.npcT = (s.npcT or 0) + dt
		if s.npcT < 5 then
			return
		end
		s.npcT = 0
		L15.daySync(s)
		Npc.sweep(L15.book(s), os.time()) -- le PNJ repart sans pénalité après 60 s (le client le fait disparaître de son côté)
		L15.tryEncounter(s)
	end

	---------------------------------------------------------------- PNJ : réponses du joueur
	local function said(s, npcKey, text, ok)
		L15.remote:FireClient(s.player, { k = "said", npc = npcKey, text = text, ok = ok == true })
	end
	function L15.decline(s, id)
		local ok, res = Npc.decline(Config, s.data.npc, L15.book(s), id, s.player.UserId, os.time())
		if not ok then
			return said(s, nil, MSG[res] or MSG.unknown, false)
		end
		said(s, res.npc, res.gone and (Npc.say(Config, res.npc, "gone") ~= "" and Npc.say(Config, res.npc, "gone") or "Je ne reviendrai pas aujourd'hui. À demain !") or Npc.say(Config, res.npc, "refuse"), true)
	end
	-- Équipe adverse : 3 espèces existantes dont la puissance totale = puissance de l'équipe du joueur x powerMul (U(0,9 ; 1,1), Kaï x1,3).
	function L15.foes(o, mine)
		local pp, fp = 0, 0
		for _, u in ipairs(mine) do
			pp = pp + Battle.power(u)
		end
		for _, e in ipairs(o.team) do
			fp = fp + Battle.power(Battle.unit(Config, { p = e.p, s = 2, m = 1 }))
		end
		local scale = fp > 0 and math.clamp(pp * o.powerMul / fp, 0.2, 20) or 1
		local foes = {}
		for _, e in ipairs(o.team) do
			foes[#foes + 1] = Battle.unit(Config, { p = e.p, s = 2, m = 1 }, scale)
		end
		return foes
	end
	function L15.accept(s, id, confirm2)
		local d, book, now, uid = s.data, L15.book(s), os.time(), s.player.UserId
		local o = book.offers[id]
		if not o or o.userId ~= uid then
			return said(s, nil, MSG.unknown, false)
		end
		if o.kind == "trade" then
			local freed = 0
			for _, t in ipairs(o.take) do
				if t.slot <= cap(s) then
					freed = freed + 1
				end
			end
			if o.getEgg and Rewards.freeSlots(d.slots, cap(s)) + freed + (Lot7.L16.bagCfg(s).EGG_BAG.size - #d.eggBag) < 1 then
				return said(s, o.npc, MSG.bagFull, false)
			end
			local ok, eff = Npc.accept(Config, book, id, uid, now, L15.inv(s), { confirm2 = confirm2 })
			if not ok then
				if eff == "confirm2" then
					return L15.remote:FireClient(s.player, { k = "confirm2", id = id })
				end
				return said(s, o.npc, MSG[eff] or MSG.unknown, false)
			end
			-- effet appliqué EN UNE FOIS (aucune attente entre le retrait et le don) ; l'offre est déjà retirée du carnet : aucun rejeu possible
			d.coins = d.coins + eff.coins
			for _, i in ipairs(eff.take) do
				d.slots[i] = false
			end
			local got = {}
			if eff.species then
				local i = eff.take[1]
				local sp = eff.species
				local odds = Lot7.Odds.forPet(Config, sp.p, sp.s, sp.m)
				d.slots[i] = { k = "p", p = sp.p, s = sp.s, m = sp.m, o = odds, ov = odds and Config.ODDS.version or nil }
				local key = tostring(sp.p)
				if not d.dex[key] then
					d.dex[key] = { n = 0, b = 0 }
					s.species = s.species + 1
					qp(s, "discover", 1)
				end
				d.dex[key].n = d.dex[key].n + 1
				d.dex[key].b = math.max(d.dex[key].b, Config.SIZES[sp.s].mult * Config.MUTS[sp.m].mult)
				got[#got + 1] = Config.PETS[sp.p].emoji .. " " .. Config.PETS[sp.p].name
			end
			for _, i in ipairs(eff.take) do
				refreshPad(s, i)
			end
			if eff.egg then
				local where = L15.storeEggs(s, { eff.egg }) -- place garantie (vérifiée avant l'acceptation, les emplacements donnés sont libérés)
				got[#got + 1] = "🥚 Œuf " .. tierName(eff.egg) .. ((where and where[1] == "bag") and " (dans ton sac d'œufs)" or "")
			end
			rebuildFollowers(s)
			Npc.noteAccepted(d.npc, eff.npc)
			L15.weekly(s, "npc", 1)
			L15.qk(s, "npcTrade") -- A11 : échange de PNJ conclu (offre déjà retirée du carnet)
			said(s, eff.npc, "Marché conclu ! Tu reçois : " .. table.concat(got, ", ") .. ".", true)
			notify(s.player, "🤝 Échange avec " .. Config.NPCS[eff.npc].name .. " : " .. table.concat(got, ", "), "claim")
			tele.log(s.player, "npc_trade", 1, "_" .. eff.npc)
			sync(s)
			saveSoon(s)
			return
		end
		-- combat (Lina, Bruno) ou Champion errant (Kaï)
		if s.battle or s.castle or s.pvpPending then
			return said(s, o.npc, "Termine d'abord ce que tu fais, je t'attends !", false)
		end
		local mine = battleUnits(s)
		if #mine == 0 then
			return said(s, o.npc, "Compose d'abord ton équipe de pets (bouton ⚔️ Arène), puis reviens me voir !", false)
		end
		if o.kind == "champion" and not Rewards.canStore(Lot7.L16.bagCfg(s), d.slots, cap(s), d.eggBag, 1) then
			return said(s, o.npc, MSG.bagFull, false)
		end
		local ok, acc = Npc.accept(Config, book, id, uid, now, L15.inv(s), {})
		if not ok then
			return said(s, o.npc, MSG[acc] or MSG.unknown, false)
		end
		local foes = L15.foes(acc, mine)
		L15.boostUnits(mine)
		local def = Config.NPCS[acc.npc]
		s.battle = { st = Battle.new(rng:NextInteger(1, 2147483000), mine, foes), floor = 0, npc = { id = acc.id, key = acc.npc, name = def.emoji .. " " .. def.name }, deadline = os.clock() + TW.turnSeconds }
		L15.remote:FireClient(s.player, { k = "fight", id = acc.id })
		RBattle:FireClient(s.player, { k = "start", floor = 0, foe = def.emoji .. " " .. def.name, npc = true, view = Battle.view(s.battle.st), seconds = TW.turnSeconds })
	end
	-- Fin d'un combat de PNJ (appelé par battleFinish, s.battle déjà vidé). Npc.resolve est à usage unique : la récompense ne peut pas être versée deux fois.
	function L15.fightEnd(s, bt, win)
		local d = s.data
		local ok, out = Npc.resolve(Config, L15.book(s), bt.npc.id, s.player.UserId, os.time(), win)
		local rewards = {}
		local text = ""
		local pickAfter = false
		if ok then
			if out.won then
				L15.onPve(s)
				L15.qk(s, "pveWin", { rewarded = true, units = bt.st.sides[1].units, weekType = Rewards.rotation(Config, Rewards.weekOf(today())).type }) -- A11 : victoire de PNJ (Npc.resolve : une fois)
				local coins = math.floor(math.max(Config.STREAK.coinFloor, income(s) * 300) * (out.rewardMul or 1))
				d.coins = d.coins + coins
				rewards.coins = coins
				local eggT = out.egg
				if not eggT and out.cardEgg and rnd() * 100 < (out.cardPct or 0) then
					eggT = out.cardEgg
				end
				if eggT then
					if L15.storeEggs(s, { eggT }, "g") then -- vitrine : victoire PvE = gagné en jouant
						rewards.egg = eggT
					else
						local c2 = math.floor(Config.eggCoinValue(eggT) * 0.5)
						d.coins = d.coins + c2
						rewards.coins = coins + c2
					end
				end
				text = Npc.say(Config, out.npc, "win")
			else
				-- défaite : rien n'est perdu ; l'XP de pet (PetXp) est versée plus bas, victoire ou défaite
				text = Npc.say(Config, out.npc, "lose", { tip = Npc.tip(Config, { npc = out.npc }) })
			end
			L15.PetXp.addToTeam(d.slots, d.battle.team, L15.PetXp.award("npc", L15.PetXp.combat("npc", out.won, 0), L15.PetXp.boostMul(d, os.time()))) -- lot 12 B : XP de pet (PNJ), seule source d'XP
			if out.won then
				L15.offerPick(s, 0, "npc") -- lot 12 B : 3 cartes (valeurs x0,6) après une victoire contre un PNJ
				rewards.pick = true
				pickAfter = true
			end
			L15.weekly(s, "npc", 1)
			tele.log(s.player, "npc_fight", out.won and 1 or 0, "_" .. out.npc)
		end
		RBattle:FireClient(s.player, { k = "end", win = win, rewards = rewards, best = d.battle.best, floor = 0, npc = true, foe = bt.npc.name, view = Battle.view(bt.st) })
		if pickAfter then
			L15.sendPick(s)
		end
		if text ~= "" then
			said(s, bt.npc.key, text, win)
		end
		RState:FireClient(s.player, snapshot(s))
		saveSoon(s)
	end
	function actions.npcAnswer(s, arg)
		if type(arg) ~= "table" or type(arg.id) ~= "string" or #arg.id > 48 then
			return
		end
		if arg.action == "decline" then
			L15.decline(s, arg.id)
		elseif arg.action == "accept" then
			L15.accept(s, arg.id, arg.confirm2 == true)
		end
	end
	-- « Ne plus être interpellé » : réglage sauvegardé ; l'activer retire aussi l'offre en cours (sans pénalité).
	function actions.npcOff(s, v)
		if type(v) ~= "boolean" then
			return
		end
		s.data.npc.off = v
		if v then
			local book = L15.book(s)
			if book.current then
				book.offers[book.current] = nil
				book.current = nil
			end
			L15.remote:FireClient(s.player, { k = "clear" })
		end
		notify(s.player, v and "🤫 Les PNJ ne t'interpelleront plus (réglage dans Plus)." or "👋 Les PNJ peuvent de nouveau t'interpeller.")
		sync(s)
	end

	---------------------------------------------------------------- Série de 7 jours, sac d'œufs, quêtes bonus et de la semaine, plumes
	local STREAK_MSG = {
		done = "🔥 Série déjà réclamée aujourd'hui : reviens demain !", rescue = "🔥 Ta série va se perdre : choisis comment la sauver (menu Bonus).",
		noQuest = "🔥 Termine d'abord les 3 missions du jour pour sauver ta série gratuitement.", noProduct = "🔥 Le sauvetage payant a déjà servi cette semaine.",
		bagFull = "🔥 Ta base et ton sac d'œufs sont pleins : libère une place, ta récompense t'attend (rien n'est perdu).",
	}
	-- Réclame la série du jour. how : nil, "quest", "reset" (client) ou "product" (reçu StreakRestore vérifié). Retourne (true) ou (false, code).
	function L15.streakClaim(s, how)
		if s.streakBusy then
			return false, "busy"
		end
		s.streakBusy = true
		local d = s.data
		local g = { daily = d.daily, streak = d.streak, grace = d.grace }
		local ctx = { income = income(s), vip = s.passes.VipBase == true, questsDone = L15.questsDone(s), slots = d.slots, cap = cap(s), bag = d.eggBag, mkEgg = L15.mkEgg(s, how == "product" and "r" or "g") } -- vitrine : série sauvée par le produit payant StreakRestore = "r"
		local before = {}
		for i = 1, cap(s) do
			before[i] = not d.slots[i]
		end
		local ok, res = Rewards.streakClaim(Lot7.L16.bagCfg(s), g, today(), how, ctx)
		s.streakBusy = nil
		if not ok then
			if how ~= "product" then
				notify(s.player, STREAK_MSG[res] or STREAK_MSG.done, "refuse")
				sync(s)
			end
			return false, res
		end
		d.daily, d.streak = g.daily, g.streak
		for i = 1, cap(s) do
			if before[i] and d.slots[i] then
				refreshPad(s, i)
			end
		end
		local gr, bits = res.grant, {}
		if gr.coins > 0 then
			d.coins = d.coins + gr.coins
			bits[#bits + 1] = "🪙 " .. Config.fmt(gr.coins)
		end
		for _, t in ipairs(gr.eggs) do
			bits[#bits + 1] = "🥚 Œuf " .. tierName(t)
		end
		if gr.luck then
			d.luckUntil = math.max(os.time(), d.luckUntil) + gr.luck.minutes * 60
			bits[#bits + 1] = "🧪 Potion de chance " .. gr.luck.minutes .. " min"
		end
		if gr.boost then
			d.xp2Until = math.max(os.time(), d.xp2Until) + gr.boost.minutes * 60
			bits[#bits + 1] = "📜 XP x" .. gr.boost.mul .. " " .. gr.boost.minutes .. " min"
		end
		if gr.fragments > 0 then
			d.puzzle.fragments = d.puzzle.fragments + gr.fragments
			bits[#bits + 1] = "🧩 +" .. gr.fragments .. " fragment du Grand Œuf"
		end
		local bagged = false
		for _, w in ipairs(res.where or {}) do
			bagged = bagged or w == "bag"
		end
		notify(s.player, "🔥 Série jour " .. res.day .. "/7" .. (res.state == "grace" and " (jour de grâce utilisé)" or "") .. " : " .. table.concat(bits, " · ") .. (bagged and " (œuf rangé dans ton sac)" or ""), res.day == #Config.STREAK.days and "calendar_milestone" or "calendar_claim")
		tele.log(s.player, "streak_claim", res.day, "_" .. tostring(res.state))
		sync(s)
		saveSoon(s)
		return true
	end
	function actions.bagPlace(s)
		local d = s.data
		local ok, tier, i = Rewards.bagTake(d.slots, cap(s), d.eggBag, L15.mkEgg(s))
		if not ok then
			notify(s.player, tier == "empty" and "🎒 Ton sac d'œufs est vide." or "🎒 Ta base est pleine : libère un emplacement pour poser l'œuf.", "refuse")
			return
		end
		refreshPad(s, i)
		notify(s.player, "🎒 Œuf " .. tierName(tier) .. " posé dans ta base.", "claim")
		sync(s)
	end
	local function eggsText(gr)
		local bits = {}
		for _, t in ipairs(gr.eggs) do
			bits[#bits + 1] = "Œuf " .. tierName(t)
		end
		return table.concat(bits, ", ")
	end
	local function store(s, og) -- og : origine des œufs posés (vitrine) ; quêtes bonus / de la semaine et plumes d'événement = "g"
		local before = {}
		for i = 1, cap(s) do
			before[i] = not s.data.slots[i]
		end
		return { slots = s.data.slots, cap = cap(s), bag = s.data.eggBag, mkEgg = L15.mkEgg(s, og) }, before
	end
	local function refreshFilled(s, before)
		for i = 1, cap(s) do
			if before[i] and s.data.slots[i] then
				refreshPad(s, i)
			end
		end
	end
	function actions.bonusClaim(s)
		L15.daySync(s)
		local st, before = store(s, "g")
		local ok, gr = Rewards.bonusClaim(Lot7.L16.bagCfg(s), s.data.weekly, today(), s.data.story.ch, st)
		if not ok then
			notify(s.player, gr == "claimed" and "⭐ Quête bonus déjà réclamée aujourd'hui." or (gr == "bagFull" and MSG.bagFull or "⭐ Quête bonus pas encore terminée."), "refuse")
			return
		end
		refreshFilled(s, before)
		notify(s.player, "⭐ Quête bonus : " .. eggsText(gr), "claim")
		sync(s)
		saveSoon(s)
	end
	function actions.weeklyClaim(s, which)
		if which ~= 5 and which ~= 7 then
			return
		end
		L15.daySync(s)
		local st, before = store(s, "g")
		local ok, gr = Rewards.weeklyClaim(Lot7.L16.bagCfg(s), s.data.weekly, which, st)
		if not ok then
			notify(s.player, gr == "claimed" and "📆 Récompense de la semaine déjà réclamée." or (gr == "bagFull" and MSG.bagFull or "📆 Pas encore assez de quêtes de la semaine terminées."), "refuse")
			return
		end
		refreshFilled(s, before)
		local sx = (gr.seasonXp or 0) > 0 and Lot7.L16.addXp(s, "weekly") or nil -- lot 16 : quêtes de la semaine 7/7 -> XP du passe de combat (remplace l'ancien seasonXp)
		notify(s.player, "📆 Quêtes de la semaine " .. which .. "/7 : " .. eggsText(gr) .. ((sx and sx.gained > 0) and (" + " .. sx.gained .. " XP de passe de combat") or ""), "claim")
		sync(s)
		saveSoon(s)
	end
	function actions.plumeBuy(s)
		local ev = L15.daySync(s)
		local st, before = store(s, "g")
		local ok, t = Rewards.plumeBuyExclusive(Lot7.L16.bagCfg(s), s.data.event, ev ~= nil, st, Lot7.L16.openEv(os.time()))
		if not ok then
			local m = { inactive = "🪶 Aucun événement en cours.", limit = "🪶 Tu as déjà obtenu le maximum d'Œufs Exclusifs de cet événement.", plumes = "🪶 Il te faut " .. Config.PLUMES.exclusiveCost .. " plumes d'événement.",
				notLive = "🪶 L'Œuf Exclusif arrive bientôt : garde tes plumes pour cet événement.", closed = "🪶 Aucune espèce Exclusif n'est disponible pendant cet événement : garde tes plumes.", bagFull = MSG.bagFull }
			notify(s.player, m[t] or m.inactive, "refuse")
			return
		end
		refreshFilled(s, before)
		notify(s.player, "🪶 Œuf " .. tierName(t) .. " obtenu contre " .. Config.PLUMES.exclusiveCost .. " plumes !", "jackpot_rare")
		sync(s)
		saveSoon(s)
	end
	-- Vue envoyée au client (snapshot) : série, récompenses des 7 jours, sac, quêtes bonus et de la semaine, événements, rotation, réglage PNJ.
	function L15.view(s)
		local d, t = s.data, today()
		L15.daySync(s)
		local plan = Rewards.streakPlan(Config, { daily = d.daily, streak = d.streak, grace = d.grace }, t, { questsDone = L15.questsDone(s) })
		local days = {}
		for i = 1, #Config.STREAK.days do
			local gr = Rewards.streakReward(Config, i, d.grace.weeks, income(s), s.passes.VipBase == true)
			days[i] = { eggs = gr.eggs, coins = gr.coins, luck = gr.luck and gr.luck.minutes or nil, boost = gr.boost and gr.boost.minutes or nil, fragments = gr.fragments, mythic = gr.mythicWeek }
		end
		local q = Rewards.bonusQuest(Config, t, d.story.ch)
		local bq = (type(d.weekly.bq) == "table" and d.weekly.bq.d == t) and d.weekly.bq or { prog = 0, claimed = false }
		local themes = {}
		for i, th in ipairs(Config.QUESTS.weekly.themes) do
			themes[i] = { text = th.text, prog = d.weekly.prog[i], goal = th.goal }
		end
		local act = Rewards.activeEvents(Config, os.time())
		local rot = Rewards.rotation(Config, Rewards.weekOf(t))
		local exIdx = Rewards.tierIdx(Config, Config.PLUMES.exclusiveName)
		return {
			streak = { state = plan.state, day = plan.day, missed = plan.missed, streak = plan.streak, canQuest = plan.canQuest == true, canProduct = plan.canProduct == true and Config.purchasable(Config.PRODUCTS.StreakRestore), lost = plan.lost, weeks = d.grace.weeks, graceFree = not (d.grace.week == Rewards.weekOf(t) and d.grace.used >= 1) },
			days = days, bag = #d.eggBag, bagMax = Lot7.L16.bagCfg(s).EGG_BAG.size, questsDone = L15.questsDone(s),
			bonus = { text = q.text, prog = math.min(bq.prog, q.goal), goal = q.goal, egg = q.egg, unlocked = L15.questsDone(s) >= 3, claimed = bq.claimed == true },
			weekly = { themes = themes, done = Rewards.weeklyDone(Config, d.weekly), c5 = d.weekly.c5, c7 = d.weekly.c7 },
			ev = { weekend = act.weekend, golden = act.golden, limited = act.limited and act.limited.name or nil, plumes = d.event.p, got = d.event.x, cost = Config.PLUMES.exclusiveCost, max = Config.PLUMES.maxExclusivePerEvent, exclusiveLive = exIdx ~= nil and Config.tierLive(exIdx) },
			rot = { type = rot.type, featured = rot.featured },
			npcOff = d.npc.off == true,
		}
	end

	---------------------------------------------------------------- Modèles : PNJ publiés aux clients, calendrier mural, décor d'événement
	function L15.publishNpc(assets)
		local n = 0
		pcall(function()
			local folder = ReplicatedStorage:FindFirstChild("NpcTemplates") or Instance.new("Folder")
			folder.Name = "NpcTemplates"
			for key in pairs(Config.Assets.models.npc) do
				local clone = assets.cloneModel("npc", key)
				if clone then
					local old = folder:FindFirstChild(key)
					if old then
						old:Destroy()
					end
					clone.Name = key
					for _, dd in ipairs(clone:GetDescendants()) do
						if dd:IsA("BasePart") then
							dd.Anchored, dd.CanCollide, dd.CanQuery, dd.CanTouch = true, false, false, false
						end
					end
					clone.Parent = folder
					n = n + 1
				end
			end
			folder.Parent = ReplicatedStorage
		end)
		return n
	end
	-- Angle (degrés) qui tourne la face avant (-Z) d'un modèle posé en (x, z) vers le point (tx, tz) (sans math.atan2).
	local function faceDeg(x, z, tx, tz)
		local dx, dz = x - tx, z - tz
		local r = math.sqrt(dx * dx + dz * dz)
		if r < 1e-3 then
			return 0
		end
		local a = math.acos(math.clamp(dz / r, -1, 1))
		return math.deg(dx < 0 and -a or a)
	end
	-- Calendrier mural (hub.calendar) à côté du kiosque, tourné vers la place ; prompt « Calendrier » validé par Kiosk.handle (même action que le kiosque).
	function L15.placeCalendar(assets)
		if not K8.world or K8.world:FindFirstChild("CalendarBoard") then
			return false
		end
		local model = assets.cloneModel("hub", "calendar")
		if not model then
			return false
		end
		local K, B, P = Config.Map2.kiosk, Config.CALENDAR_BOARD, Config.Map2.plaza
		local x, z = K.x + B.dx, K.z + B.dz
		model.Name = "CalendarBoard"
		if not assets.place(model, x, z, faceDeg(x, z, P.x, P.z), B.height, K8.world) then
			return false
		end
		local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		if part then
			local pr = Instance.new("ProximityPrompt")
			pr.Name = "KioskPrompt_calendarBoard"
			pr.ActionText, pr.ObjectText, pr.HoldDuration, pr.MaxActivationDistance, pr.RequiresLineOfSight = "Calendrier", "📅 Calendrier des œufs", 0, 12, false
			pr:SetAttribute("KioskAction", "calendar")
			CollectionService:AddTag(pr, "KioskPrompt")
			pr.Parent = part
		end
		return true
	end
	-- Décor de l'événement limité du jour (EVENTS_CAL) : modèle Blender ou repli procédural ; retiré à la fin de l'événement. force = reconstruire.
	function L15.placeEventDecor(force)
		if not K8.world then
			return
		end
		local ev = Rewards.limitedEvent(Config, today())
		local key = ev and ev.decor or ""
		if L15.decorKey == key and not force then
			return
		end
		L15.decorKey = key
		local old = K8.world:FindFirstChild("EventDecor")
		if old then
			old:Destroy()
		end
		if not ev then
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "EventDecor"
		folder.Parent = K8.world
		local spot, mk = Config.EVENT_DECOR_SPOT, Config.EVENT_DECOR[key]
		local model = mk and L15.assets and L15.assets.cloneModel("event", mk)
		if model and L15.assets.place(model, spot.x, spot.z, faceDeg(spot.x, spot.z, 0, 0), spot.height, folder) then
			return
		end
		local ball = Instance.new("Part") -- repli procédural : une grosse boule aux couleurs de l'événement et son nom
		ball.Name = "EventDecorFallback"
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(6, 6, 6)
		ball.Anchored, ball.CanCollide = true, false
		ball.Material = Enum.Material.SmoothPlastic
		ball.Color = ev.id == "halloween" and Color3.fromRGB(255, 140, 30) or (ev.id == "xmas" and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(255, 170, 220))
		ball.Position = Vector3.new(spot.x, 3, spot.z)
		ball.Parent = folder
		local bb = Instance.new("BillboardGui")
		bb.Size, bb.StudsOffset, bb.MaxDistance = UDim2.fromOffset(220, 40), Vector3.new(0, 5, 0), 80
		bb.Parent = ball
		local lbl = Instance.new("TextLabel")
		lbl.Size, lbl.BackgroundTransparency, lbl.Text, lbl.TextScaled, lbl.Font, lbl.TextColor3 = UDim2.fromScale(1, 1), 1, "🎉 " .. ev.name, true, Enum.Font.GothamBold, Color3.new(1, 1, 1)
		lbl.Parent = bb
	end
	L15.placeEventDecor(false)
	task.spawn(function()
		while true do
			task.wait(600)
			pcall(L15.placeEventDecor, false)
		end
	end)
end

function actions.ravenList(s)
	return Lot7.ravenList(s)
end
function actions.ravenGo(s, arg)
	return Lot7.ravenGo(s, arg)
end
function actions.setBlockRavens(s, v)
	return Lot7.setBlockRavens(s, v)
end

---------------------------------------------------------------- Lot 7 : Corbeau chipeur, tapis privé, bonus serveur, PolicyService
-- Tout est décidé ICI, par le serveur : le client n'envoie que des intentions (ravenList, ravenGo { u, i }, setBlockRavens), jamais un contexte. Les règles pures sont dans
-- Raven.lua (canLaunch, settle, compensation...), testées une par une ; ce bloc construit les contextes d'après les sessions et applique les décisions.
do
	local RV = Config.REMOTE_STEAL
	local flights = {} -- [Player voleur] = vol en cours (un seul par voleur)
	local bySlot = {} -- [Player victime] = { [emplacement] = vol } : un seul corbeau par œuf
	local ravensFolder = Instance.new("Folder")
	ravensFolder.Name = "Ravens"
	ravensFolder.Parent = workspace

	local MSG = {
		invalid = "🐦‍⬛ Cible invalide.", self = "🐦‍⬛ Tu ne peux pas viser ta propre base.", noToken = "🐦‍⬛ Tu n'as plus de jeton de corbeau (Bonus > Corbeau chipeur).",
		alreadyFlying = "🐦‍⬛ Ton corbeau est déjà en vol.", dailyLimit = "🐦‍⬛ Limite atteinte : " .. RV.dailyMax .. " vols à distance réussis par jour.",
		castle = "🐦‍⬛ Pas de corbeau dans le mode Château.", newbie = "🐣 Protection débutant : pas de corbeau pour toi, ni contre toi.",
		tooYoung = "🐦‍⬛ Le corbeau demande " .. RV.minPlayMinutes .. " min de jeu à toi et " .. RV.victimMinMinutes .. " min à ta cible.",
		accountAge = "🐦‍⬛ Le corbeau demande un compte Roblox de " .. RV.minAccountAgeDays .. " jours au moins, pour toi comme pour ta cible.", recentlyStolen = "🛡 Cet œuf vient d'être volé par un corbeau : il est protégé un moment.", noSlot = "🐦‍⬛ Libère un emplacement dans ta base d'abord.",
		levelGap = "🐦‍⬛ Cette base est trop petite pour ton corbeau.", victimShield = "🛡 Cette base est protégée pour l'instant.", victimCooldown = "🛡 Cette base a déjà reçu un corbeau récemment.",
		grace = "🛡 Ce joueur vient d'arriver : ses œufs sont protégés.", friendBlocked = "🐦‍⬛ Ce joueur refuse les corbeaux de ses amis.", notEgg = "🐦‍⬛ Il faut un œuf en incubation.",
		tier = "🐦‍⬛ Cet œuf est trop rare pour un corbeau.", eggShield = "🛡 Cet œuf est encore protégé.", tooLate = "🐦‍⬛ Cet œuf éclôt trop bientôt.",
		targeted = "🐦‍⬛ Un corbeau vise déjà cet œuf.", gone = "🐦‍⬛ Joueur ou œuf introuvable.", busy = "🐦‍⬛ Patiente un instant.", cooldown = "🐦‍⬛ Ton corbeau se repose : encore quelques secondes.",
	}

	local function inCastleMode(s)
		return s.castle ~= nil or serverMode == "castle"
	end
	local function rollDaily(d)
		d.raven.day, d.raven.n = Raven.rollDaily(d.raven.day, d.raven.n, os.time())
	end
	function Lot7.ravenLeft(s) -- vols à distance restants aujourd'hui (sans modifier le profil)
		local _, n = Raven.rollDaily(s.data.raven.day, s.data.raven.n, os.time())
		return math.max(0, RV.dailyMax - n)
	end
	function Lot7.serverBuffs()
		return { golden = math.floor(Belt.goldenLeft(beltSt, os.clock())), luck = math.max(0, math.floor(Lot7.luckUntil - os.time())), luckBy = Lot7.luckBy, goldenBy = beltSt.goldenBy }
	end

	-- Journal serveur : print + DataStore RavenLog (en arrière-plan, jamais bloquant). File BORNÉE (Config.REMOTE_STEAL.logQueueMax : au-delà, la plus ancienne entrée est jetée avec un
	-- avertissement) vidée par UN seul travailleur, par lots de logBatch entrées ; Data.logRavenBatch réessaie un nombre borné de fois, un lot définitivement échoué est abandonné (journal
	-- de secours : les warn/print serveur). Un DataStore lent ou en panne ne peut donc ni bloquer le jeu ni faire grossir la mémoire.
	local logQueue, logWorker = {}, false
	Lot7.logDropped = 0
	function Lot7.logPending()
		return #logQueue + (logWorker and 1 or 0)
	end
	local function pumpLog()
		if logWorker then
			return
		end
		logWorker = true
		task.spawn(function()
			while #logQueue > 0 do
				local batch = {}
				while #logQueue > 0 and #batch < RV.logBatch do
					batch[#batch + 1] = table.remove(logQueue, 1)
				end
				local ok, res = pcall(Data.logRavenBatch, batch)
				if not (ok and res) then
					Lot7.logDropped += #batch
					warn("[Raven] journal : lot de " .. #batch .. " entrée(s) abandonné après essais (" .. tostring(ok and res or res) .. ")")
				end
			end
			logWorker = false
		end)
	end
	function Lot7.logEnqueue(entry)
		if #logQueue >= RV.logQueueMax then
			table.remove(logQueue, 1)
			Lot7.logDropped += 1
			warn("[Raven] journal : file pleine (" .. RV.logQueueMax .. "), entrée la plus ancienne jetée")
		end
		logQueue[#logQueue + 1] = entry
		pumpLog()
	end
	local function logEvent(f, result)
		print(string.format("[Raven] %s (%d) -> %s (%d) : œuf %s, résultat %s", f.thiefName, f.thiefId, f.victimName, f.victimId, Config.TIERS[f.tier].name, result))
		Lot7.logEnqueue({ thief = f.thiefId, thiefName = f.thiefName, victim = f.victimId, victimName = f.victimName, tier = f.tier, result = result, at = os.time() })
	end

	-- Amitié (appel réseau, avec cache de 5 min par session). Échec = considéré ami : le refus de la victime est respecté (repli prudent).
	local function friendsWith(s, other)
		s.friendCache = s.friendCache or {}
		local c = s.friendCache[other.UserId]
		if c and os.clock() - c.t < 300 then
			return c.v
		end
		local ok, res = pcall(function()
			return s.player:IsFriendsWith(other.UserId)
		end)
		local v = (not ok) or res == true
		s.friendCache[other.UserId] = { v = v, t = os.clock() }
		return v
	end

	-- Ancienneté du compte en jours : valeur d'origine incertaine (propriété Roblox) -> nombre ou 0 (refusé).
	local function ageDays(player)
		local ok, a = pcall(function()
			return player.AccountAge
		end)
		return (ok and type(a) == "number" and a == a) and a or 0
	end
	-- CONTEXTES de Raven.canLaunch : construits ICI d'après les sessions (aucun champ ne vient du client).
	local function thiefCtx(s)
		rollDaily(s.data)
		return { userId = s.player.UserId, tokens = s.data.tokens.remoteSteal, level = s.baseLevel or 1, playMinutes = s.data.played / 60, freeSlot = freeSlot(s) ~= nil,
			dailyDone = s.data.raven.n, flying = flights[s.player] ~= nil, newbie = isNewbie(s), inCastle = inCastleMode(s), accountAgeDays = ageDays(s.player) }
	end
	local function victimCtx(vs, friend)
		return { userId = vs.player.UserId, level = vs.baseLevel or 1, playMinutes = vs.data.played / 60, newbie = isNewbie(vs), inCastle = inCastleMode(vs), graceUntil = vs.graceUntil or 0,
			shieldUntil = vs.data.raven.sh, ravenCooldownUntil = vs.data.raven.cd, friendOfThief = friend == true, blockFriendRavens = vs.data.settings.blockFriendRavens == true, accountAgeDays = ageDays(vs.player) }
	end
	local function eggCtx(vs, i)
		local sl = vs.data.slots[i]
		if i > cap(vs) or type(sl) ~= "table" or sl.k ~= "e" then
			return nil
		end
		return { tier = sl.t, incubating = true, eggShieldUntil = sl.shield or 0, endsAt = sl.ends, rvAt = type(sl.rvAt) == "number" and sl.rvAt or nil }
	end

	function Lot7.addLog(vs, name, tier, kind)
		Raven.logPush(vs.data.stealLog, { n = string.sub(tostring(name), 1, 24), t = tier, at = os.time(), k = kind }, RV.logMax)
	end
	-- Vol PHYSIQUE subi : journal et bouclier post-vol de 5 min (il protège contre les corbeaux ; le vol physique garde ses propres règles).
	function Lot7.onPhysicalSteal(vs, thiefName, tier)
		Lot7.addLog(vs, thiefName, tier, "p")
		vs.data.raven.sh = math.max(vs.data.raven.sh, os.time() + RV.postStealShield)
	end

	---------------------------------------------------------------- Oiseau
	local function lerpPos(a, b, u)
		return a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, a.z + (b.z - a.z) * u
	end
	local function placeBird(bird, x, y, z, ax, ay, az)
		local dx, dy, dz = ax - x, ay - y, az - z
		if dx * dx + dy * dy + dz * dz < 1e-4 then
			bird:PivotTo(CFrame.new(x, y, z))
		else
			bird:PivotTo(CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(ax, ay, az)))
		end
	end
	local function moveBird(f, now)
		local bird = f.bird
		if not (bird and bird.Parent) then
			return
		end
		local t = (now - f.t0) / RV.flightSeconds
		local x, y, z = Raven.birdPos(f.from, f.to, t, 0.3)
		local ax, ay, az = Raven.birdPos(f.from, f.to, math.min(1, t + 0.06), 0.3)
		placeBird(bird, x, y, z, ax, ay, az)
		f.flap = not f.flap
		Builder.ravenFlap(bird, f.flap)
	end
	-- Départ après le vol (réussi : vers la base du voleur ; chassé : loin). Temporaire et borné : l'oiseau est TOUJOURS détruit à la fin.
	local function depart(bird, from, to, secs)
		if not bird then
			return
		end
		task.spawn(function()
			local t0, flap = os.clock(), false
			while bird.Parent and os.clock() - t0 < secs do
				local u = math.min(1, (os.clock() - t0) / secs)
				local x, y, z = lerpPos(from, to, u)
				placeBird(bird, x, y, z, to.x, to.y, to.z)
				flap = not flap
				Builder.ravenFlap(bird, flap)
				task.wait(0.1)
			end
			pcall(function()
				bird:Destroy()
			end)
		end)
	end

	---------------------------------------------------------------- Fin d'un vol
	local function release(f)
		flights[f.thief.player] = nil
		local list = bySlot[f.victim.player]
		if list then
			list[f.slot] = nil
			if next(list) == nil then
				bySlot[f.victim.player] = nil
			end
		end
	end
	local function refund(f)
		if f.refunded then
			return -- jamais deux fois
		end
		f.refunded = true
		local tk = f.thief.data.tokens
		tk.remoteSteal = math.min(RV.tokenMax, tk.remoteSteal + 1) -- le jeton en vol est compté dans le plafond d'achat : jamais perdu
	end

	local function finish(f, decision, reason)
		release(f) -- d'abord : plus aucun état partagé ne dépend de ce vol, même si la suite lève une erreur
		local s, vs = f.thief, f.victim
		local bird = f.bird
		f.bird = nil
		local result = decision == "aborted" and ("aborted:" .. reason) or decision
		if decision == "success" then
			local now = os.time()
			local rem = math.max(0, f.ref.ends - now)
			local ti = freeSlot(s)
			local rvv = vs.data.raven
			rvv.icDay, rvv.ic = Raven.rollDaily(rvv.icDay, rvv.ic, now) -- indemnités reçues aujourd'hui (jour UTC)
			local comp = Raven.indemnity(Config, f.tier, f.ref.rv == true, rvv.ic) -- 0 si l'œuf est non indemnisable ; plafonné par jour et par victime (lot 7b)
			-- 1. données (opérations de table seulement : rien ne peut échouer à mi-chemin)
			s.data.slots[ti] = { k = "e", t = f.tier, ends = now + rem, shield = now + shieldTime(s), rv = true, rvAt = now, og = f.ref.og } -- temps restant conservé, bouclier d'œuf normal ; marqué : plus jamais indemnisé, pas de revol avant 20 min
			vs.data.slots[f.slot] = false
			vs.data.coins += comp
			rvv.ic += comp
			Lot7.compPaid += comp -- compteur de session (tests, journal)
			vs.data.raven.cd = now + RV.victimCooldown
			vs.data.raven.sh = math.max(vs.data.raven.sh, now + RV.postStealShield)
			rollDaily(s.data)
			s.data.raven.n += 1 -- compte aux 3 vols par jour ; ne compte PAS dans `stolen` ni dans les quêtes de vol (classement)
			Lot7.addLog(vs, f.thiefName, f.tier, "r")
			-- 2. visuels et messages (un échec ici ne défait pas le vol)
			local okV, errV = pcall(function()
				local pad = vs.plot.pads[f.slot].part
				refreshPad(vs, f.slot)
				refreshPad(s, ti)
				Builder.flyEgg(f.tier, pad.Position + Vector3.new(0, 2, 0), s.player.UserId)
				local tp = s.plot.pads[ti].part.Position
				depart(bird, f.to, { x = tp.X, y = tp.Y + 9, z = tp.Z }, 2)
				bird = nil
			end)
			if not okV then
				warn("[Raven] visuels : " .. tostring(errV))
			end
			if bird then
				pcall(function()
					bird:Destroy()
				end)
			end
			local tn = Config.TIERS[f.tier].name
			notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " a emporté ton œuf " .. tn .. ". " .. (comp > 0 and ("Tu reçois 🪙 " .. Config.fmt(comp)) or "Pas d'indemnité (œuf non indemnisable ou plafond du jour atteint)") .. " et " .. math.floor(RV.postStealShield / 60) .. " min à l'abri des corbeaux.", "caught")
			notify(s.player, "🐦‍⬛ Ton corbeau rapporte un œuf " .. tn .. " de " .. f.victimName .. " ! (temps restant conservé)", "steal")
		else
			refund(f) -- chassé ou annulé : jeton rendu, sans remboursement Robux
			if bird then
				if decision == "chased" then
					depart(bird, f.to, { x = f.to.x + 40, y = f.to.y + 30, z = f.to.z }, 1.5)
				else
					pcall(function()
						bird:Destroy()
					end)
				end
			end
			if decision == "chased" then
				notify(s.player, "🐦‍⬛ " .. f.victimName .. " a chassé ton corbeau. Jeton rendu.", "refuse")
				notify(vs.player, "🐦‍⬛ Tu as chassé le corbeau de " .. f.thiefName .. " !", "claim")
			elseif reason == "victimGone" then
				notify(s.player, "🐦‍⬛ " .. f.victimName .. " a quitté la partie : ton corbeau rentre. Jeton rendu.")
			elseif reason == "eggGone" then
				notify(s.player, "🐦‍⬛ L'œuf n'est plus là (éclos ou volé) : ton corbeau rentre. Jeton rendu.")
			elseif reason == "thiefGone" then
				notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " est reparti.")
			elseif reason == "castle" then
				notify(s.player, "🐦‍⬛ Un des deux joueurs est entré au Château : ton corbeau rentre. Jeton rendu.")
				notify(vs.player, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " est reparti.")
			elseif reason == "newbie" then
				notify(s.player, "🐣 Protection débutant : ton corbeau rentre. Jeton rendu.")
			elseif reason == "shutdown" then
				notify(s.player, "🐦‍⬛ Le serveur ferme : ton corbeau rentre. Jeton rendu.")
			else
				notify(s.player, "🐦‍⬛ Le vol a échoué (" .. tostring(reason) .. "). Jeton rendu.", "refuse")
			end
		end
		RRaven:FireClient(vs.player, "end", { slot = f.slot, result = result })
		if sessions[s.player] == s and not s.leaving then
			RRaven:FireClient(s.player, "end", { slot = f.slot, result = result })
		end
		logEvent(f, result)
		if sessions[s.player] == s then
			sync(s)
		end
		if sessions[vs.player] == vs then
			sync(vs)
		end
	end

	local function worldOf(f, now)
		local s, vs = f.thief, f.victim
		local sl = vs.data.slots[f.slot]
		local still = sl == f.ref and type(sl) == "table" and sl.k == "e"
		local t = os.time()
		return { thiefHere = sessions[s.player] == s and not s.leaving, victimHere = sessions[vs.player] == vs and not vs.leaving, eggStill = still, eggLeft = still and (sl.ends - t) or 0,
			chased = f.chased, shielded = vs.data.raven.sh > t, thiefFreeSlot = freeSlot(s) ~= nil, now = now, endsAt = f.endsAt,
			inCastle = inCastleMode(s) or inCastleMode(vs), newbie = isNewbie(s) or isNewbie(vs) } -- château et protection débutant relus à chaque pas (lot 7b)
	end

	local function step()
		local now = os.clock()
		local list = {}
		for _, f in pairs(flights) do
			list[#list + 1] = f
		end
		for _, f in ipairs(list) do
			local ok, err = pcall(function()
				local decision, reason = Raven.settle(worldOf(f, now))
				if decision == "pending" and now > f.endsAt + 5 then
					decision, reason = "aborted", "timeout" -- filet de sécurité : un vol ne reste jamais bloqué
				end
				if decision == "pending" then
					moveBird(f, now)
				else
					finish(f, decision, reason)
				end
			end)
			if not ok then
				warn("[Raven] " .. tostring(err))
				if flights[f.thief.player] == f then
					pcall(finish, f, "aborted", "error")
					flights[f.thief.player] = nil
				end
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.1)
			if next(flights) then
				step()
			end
		end
	end)

	-- Départ d'un joueur : tout vol qui le concerne est annulé AVANT sa sauvegarde (le jeton du voleur lui est rendu dans son profil).
	function Lot7.onLeave(s)
		local list = {}
		for _, f in pairs(flights) do
			if f.thief == s or f.victim == s then
				list[#list + 1] = f
			end
		end
		for _, f in ipairs(list) do
			pcall(finish, f, "aborted", f.thief == s and "thiefGone" or "victimGone")
		end
		flights[s.player] = nil
		bySlot[s.player] = nil
		s.friendCache, s.priv = nil, nil
	end
	-- Fermeture du serveur (BindToClose, AVANT les sauvegardes) : tout vol en cours est annulé et son jeton rendu dans le profil, qui est sauvegardé juste après.
	function Lot7.abortAll()
		local list = {}
		for _, f in pairs(flights) do
			list[#list + 1] = f
		end
		for _, f in ipairs(list) do
			local ok, err = pcall(finish, f, "aborted", "shutdown")
			if not ok then
				warn("[Raven] abortAll : " .. tostring(err))
				release(f)
				refund(f) -- repli : le jeton est rendu quoi qu'il arrive (sans effet s'il l'a déjà été)
			end
		end
	end
	function Lot7.flightCount()
		local n, m = 0, 0
		for _ in pairs(flights) do
			n += 1
		end
		for _, l in pairs(bySlot) do
			for _ in pairs(l) do
				m += 1
			end
		end
		return n, m, #ravensFolder:GetChildren()
	end

	-- La victime touche son œuf (dans sa base) : le corbeau est chassé.
	function Lot7.chase(s, i)
		local list = bySlot[s.player]
		local f = list and list[i]
		if not f or f.chased then
			return
		end
		local root = getRoot(s.player)
		if not root or not alive(s.player) or not inPlot(s, root) then
			if os.clock() - (s.lastChaseMsg or -10) > 2 then
				s.lastChaseMsg = os.clock()
				notify(s.player, "🐦‍⬛ Reviens dans ta base pour chasser le corbeau !", "refuse")
			end
			return
		end
		f.chased = true -- résolu au prochain pas (0,1 s) par Raven.settle
	end

	---------------------------------------------------------------- Actions du client
	-- Liste des cibles : joueurs éligibles et leurs œufs éligibles (rareté et temps restant), calculée par le serveur avec les MÊMES règles que le lancement.
	function Lot7.ravenList(s)
		local clock = os.clock()
		if clock - (s.lastRavenList or -10) < RV.tryGap then
			return
		end
		s.lastRavenList = clock
		local cands = {}
		for _, vs in pairs(sessions) do
			if vs ~= s and not vs.leaving then
				cands[#cands + 1] = vs
			end
		end
		table.sort(cands, function(a, b)
			return a.player.UserId < b.player.UserId
		end)
		local friends = {}
		for _, vs in ipairs(cands) do
			friends[vs] = friendsWith(s, vs.player) -- peut attendre le réseau (mis en cache) : tout est relu ensuite
		end
		if sessions[s.player] ~= s or s.leaving then
			return
		end
		local t = thiefCtx(s)
		local now = os.time()
		local ideal = { userId = -1, level = t.level, playMinutes = 1e9, newbie = false, inCastle = false, graceUntil = 0, shieldUntil = 0, ravenCooldownUntil = 0, friendOfThief = false, blockFriendRavens = false, accountAgeDays = 1e9 }
		local okSelf, whySelf = Raven.canLaunch(Config, t, ideal, { tier = 1, incubating = true, eggShieldUntil = 0, endsAt = math.huge }, now)
		local targets = {}
		for _, vs in ipairs(cands) do
			if sessions[vs.player] == vs and not vs.leaving then
				local vctx = victimCtx(vs, friends[vs])
				local eggs = {}
				for i = 1, cap(vs) do
					local ectx = eggCtx(vs, i)
					if ectx and not (bySlot[vs.player] and bySlot[vs.player][i]) and Raven.canLaunch(Config, t, vctx, ectx, now) then
						eggs[#eggs + 1] = { i = i, t = ectx.tier, left = math.max(0, math.floor(ectx.endsAt - now)) }
					end
				end
				if #eggs > 0 then
					targets[#targets + 1] = { u = vs.player.UserId, name = vs.player.DisplayName, eggs = eggs }
				end
			end
		end
		RRaven:FireClient(s.player, "list", { tokens = s.data.tokens.remoteSteal, left = Lot7.ravenLeft(s), blocked = (not okSelf) and (MSG[whySelf] or MSG.invalid) or nil, targets = targets })
	end

	function Lot7.ravenGo(s, arg)
		if type(arg) ~= "table" then
			return
		end
		local uid, slot = arg.u, arg.i
		if type(uid) ~= "number" or uid % 1 ~= 0 or not validSlot(slot) then
			return
		end
		local clock = os.clock()
		if s.ravenBusy or clock - (s.lastRavenTry or -10) < RV.tryGap then
			return notify(s.player, MSG.busy, "refuse")
		end
		s.lastRavenTry = clock
		if clock - (s.lastRavenGo or -100) < RV.launchCooldown then
			return notify(s.player, MSG.cooldown, "refuse")
		end
		local vp = Players:GetPlayerByUserId(uid)
		local vs = vp and sessions[vp]
		if not vs or vs.leaving or vs == s then
			return notify(s.player, vs == s and MSG.self or MSG.gone, "refuse")
		end
		s.ravenBusy = true
		local friend = friendsWith(s, vp) -- seul point d'attente : tout ce qui suit est relu après lui
		s.ravenBusy = nil
		if sessions[s.player] ~= s or s.leaving or sessions[vp] ~= vs or vs.leaving then
			return
		end
		if bySlot[vp] and bySlot[vp][slot] then
			return notify(s.player, MSG.targeted, "refuse")
		end
		local ectx = eggCtx(vs, slot)
		if not ectx then
			return notify(s.player, MSG.notEgg, "refuse")
		end
		local ok, why = Raven.canLaunch(Config, thiefCtx(s), victimCtx(vs, friend), ectx, os.time())
		if not ok then
			return notify(s.player, MSG[why] or MSG.invalid, "refuse")
		end
		-- Décollage : le jeton est débité D'ABORD, avant toute construction ; si la construction échoue (erreur, pad introuvable...), il est rendu et rien n'est enregistré.
		local sl = vs.data.slots[slot]
		s.data.tokens.remoteSteal -= 1
		local f, bird
		local okF, errF = pcall(function()
			local pad = vs.plot.pads[slot].part
			local plaza = Config.Map2.plaza
			f = {
				thief = s, victim = vs, slot = slot, ref = sl, tier = sl.t, t0 = os.clock(), endsAt = os.clock() + RV.flightSeconds, chased = false, flap = false,
				thiefId = s.player.UserId, victimId = vp.UserId, thiefName = s.player.DisplayName, victimName = vp.DisplayName,
				from = { x = plaza.x, y = 30, z = plaza.z }, to = { x = pad.Position.X, y = pad.Position.Y + 12, z = pad.Position.Z },
			}
			local okB, b = pcall(Builder.raven, ravensFolder)
			bird = okB and b or nil -- sans oiseau visible le vol reste valable
			f.bird = bird
		end)
		if not okF then
			warn("[Raven] décollage impossible, jeton rendu : " .. tostring(errF))
			if bird then
				pcall(function()
					bird:Destroy()
				end)
			end
			s.data.tokens.remoteSteal = math.min(RV.tokenMax, s.data.tokens.remoteSteal + 1)
			return notify(s.player, "🐦‍⬛ Ton corbeau n'a pas pu décoller. Jeton rendu.", "refuse")
		end
		-- enregistrement (opérations de table seulement : ne peut pas échouer à mi-chemin)
		s.lastRavenGo = os.clock()
		vs.data.raven.cd = math.max(vs.data.raven.cd, os.time() + RV.victimFailCooldown) -- anti-harcèlement : 3 min de répit dès l'alerte ; les 20 min ne sont posées qu'en cas de SUCCÈS (finish)
		flights[s.player] = f
		bySlot[vp] = bySlot[vp] or {}
		bySlot[vp][slot] = f
		local okN, errN = pcall(function()
			local tn = Config.TIERS[sl.t].name
			RRaven:FireClient(vp, "alert", { who = f.thiefName, tier = sl.t, slot = slot, secs = RV.flightSeconds })
			notify(vp, "🐦‍⬛ Le corbeau de " .. f.thiefName .. " vise ton œuf " .. tn .. " ! Touche l'œuf pour le chasser (" .. RV.flightSeconds .. " s).", "caught")
			notify(s.player, "🐦‍⬛ Ton corbeau s'envole vers l'œuf " .. tn .. " de " .. f.victimName .. " (" .. RV.flightSeconds .. " s).", "event")
			RRaven:FireClient(s.player, "flight", { to = f.victimName, tier = sl.t, secs = RV.flightSeconds })
		end)
		if not okN then
			warn("[Raven] messages de décollage : " .. tostring(errN)) -- le vol est enregistré : il se règle normalement
		end
		logEvent(f, "launched")
		sync(s)
	end

	function Lot7.setBlockRavens(s, v)
		if type(v) ~= "boolean" then
			return
		end
		s.data.settings.blockFriendRavens = v
		sync(s)
	end

	---------------------------------------------------------------- Achats : jetons, tapis doré, pluie de chance
	-- Retourne true (livré), (false, message) = reçu NON traité (Roblox le rappellera : rien n'est perdu), ou nil si ce n'est pas un produit du lot 7.
	function Lot7.grant(s, name)
		local n = Raven.tokensFor(Config, name)
		if n > 0 then
			local held = Raven.held(s.data.tokens.remoteSteal, flights[s.player] ~= nil)
			if not Raven.canBuy(Config, held, n) then
				return false, "🐦‍⬛ Tu as déjà " .. held .. " jeton(s) : le maximum est " .. RV.tokenMax .. ". Utilise-en avant de finaliser cet achat (il sera livré automatiquement, rien n'est perdu)."
			end
			s.data.tokens.remoteSteal = Raven.addTokens(Config, s.data.tokens.remoteSteal, n)
			notify(s.player, "🐦‍⬛ +" .. n .. " jeton(s) de corbeau (" .. s.data.tokens.remoteSteal .. "/" .. RV.tokenMax .. ").", "buy")
			return true
		elseif name == "GoldenBelt" then
			local G = Config.BELT.golden
			local left, ok = Raven.stack(Belt.goldenLeft(beltSt, os.clock()), G.seconds, G.maxSeconds)
			if not ok then
				return false, "🌟 Le tapis doré est déjà presque au maximum (" .. Belt.clock(left) .. "). Ton achat sera livré dès qu'il y aura de la place, rien n'est perdu."
			end
			goldenBeltAdd(G.seconds, s.player.DisplayName)
			Lot7.goldenById = s.player.UserId
			announce("🌟 " .. s.player.DisplayName .. " offre le tapis doré à tout le serveur !")
			return true
		elseif name == "ServerLuck" then
			local L = Config.SERVER_LUCK
			local left, ok = Raven.stack(math.max(0, Lot7.luckUntil - os.time()), L.seconds, L.maxSeconds)
			if not ok then
				return false, "🌧️ La pluie de chance est déjà presque au maximum (" .. Config.fmtTime(left) .. "). Ton achat sera livré dès qu'il y aura de la place, rien n'est perdu."
			end
			Lot7.luckUntil, Lot7.luckBy, Lot7.luckById = os.time() + left, s.player.DisplayName, s.player.UserId
			announce("🌧️ " .. s.player.DisplayName .. " offre une pluie de chance : +" .. L.bonus .. " points d'amélioration pour tout le serveur pendant " .. math.floor(L.seconds / 60) .. " min !")
			return true
		end
		return nil
	end

	-- Bonus serveur et fermeture du serveur : la fin du tapis doré / de la pluie de chance est écrite (os.time) dans le profil du DERNIER donateur encore présent à la fermeture
	-- (BindToClose), puis rendue UNE fois (et effacée) à son arrivée sur un autre serveur. Un donateur déjà parti avant la fermeture n'a rien à restituer : limite documentée (CHANGELOG 7b).
	function Lot7.persistBuffs()
		local now = os.time()
		local gl = math.floor(Belt.goldenLeft(beltSt, os.clock()))
		local ll = math.floor(Lot7.luckUntil - now)
		for player, s in pairs(sessions) do
			if not s.noSave then
				if gl > 30 and Lot7.goldenById == player.UserId then
					s.data.srvBuff.g = now + gl
				end
				if ll > 30 and Lot7.luckById == player.UserId then
					s.data.srvBuff.l = now + ll
				end
			end
		end
	end
	function Lot7.restoreBuffs(s)
		local b, now = s.data.srvBuff, os.time()
		if type(b) ~= "table" then
			return
		end
		local G, L = Config.BELT.golden, Config.SERVER_LUCK
		local name, uid = s.player.DisplayName, s.player.UserId
		local gLeft, lLeft = (b.g or 0) - now, (b.l or 0) - now
		b.g, b.l = 0, 0 -- restitué une seule fois (jamais de duplication d'un serveur à l'autre)
		if gLeft > 30 then
			local add = math.min(gLeft, G.maxSeconds) - Belt.goldenLeft(beltSt, os.clock()) -- on ne cumule pas : le plus long des deux
			if add > 0 then
				goldenBeltAdd(add, name)
				Lot7.goldenById = uid
				announce("🌟 Le tapis doré de " .. name .. " est de retour : " .. Belt.clock(math.min(gLeft, G.maxSeconds)) .. " restantes pour tout le serveur !")
			end
		end
		if lLeft > 30 then
			local target = now + math.min(lLeft, L.maxSeconds)
			if target > Lot7.luckUntil then
				Lot7.luckUntil, Lot7.luckBy, Lot7.luckById = target, name, uid
				announce("🌧️ La pluie de chance de " .. name .. " est de retour : " .. Config.fmtTime(target - now) .. " restantes pour tout le serveur !")
			end
		end
	end

	---------------------------------------------------------------- PolicyService
	-- Passes à hasard : actives seulement si PolicyService a confirmé « non restreint » ET que le joueur les possède ; sinon forcées à faux (lot 7b).
	local function applyRandomPasses(s)
		for name, def in pairs(Config.PASSES) do
			if def.random == true then
				s.passes[name] = s.restricted == false and s.ownedRandom[name] == true
			end
		end
		Lot7.privRefresh(s)
		sync(s)
	end
	function Lot7.fetchPolicy(s)
		task.spawn(function()
			local ok, info = pcall(function()
				return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(s.player)
			end)
			if sessions[s.player] ~= s then
				return
			end
			if ok and type(info) == "table" then
				s.restricted = info.ArePaidRandomItemsRestricted ~= false -- seul « false » confirme que les offres à hasard sont permises
			elseif s.restricted == nil then
				s.restricted = true -- échec : repli prudent (offres à hasard masquées et refusées)
				warn("[Policy] " .. s.player.Name .. " : PolicyService indisponible, offres à hasard masquées")
			end
			applyRandomPasses(s)
		end)
		task.delay(8, function() -- délai dépassé : repli prudent (une réponse tardive pourra encore lever la restriction)
			if sessions[s.player] == s and s.restricted == nil then
				s.restricted = true
				applyRandomPasses(s)
			end
		end)
	end
	function Lot7.awaitPolicy(s) -- ProcessReceipt : attend (au plus 10 s) la réponse de PolicyService avant de décider
		local t0 = os.clock()
		while s.restricted == nil and os.clock() - t0 < 10 and sessions[s.player] == s do
			task.wait(0.25)
		end
		return s.restricted ~= false
	end

	---------------------------------------------------------------- Tapis privé (pass PrivateBelt)
	function Lot7.privRefresh(s)
		if passOn(s, "PrivateBelt") and s.plot and not s.leaving then
			Builder.privateBelt(s.plot, s.player.UserId, s.data.pb)
		elseif s.plot then
			Builder.clearPrivateBelt(s.plot)
		end
	end
	-- Un pas par seconde et par joueur (slowTick) : `active` = le joueur a agi ou bougé dans Config.IDLE.seconds. Joueur hors ligne = jamais appelé : aucune production hors ligne.
	function Lot7.privStep(s, dt, active)
		if not passOn(s, "PrivateBelt") then
			return
		end
		s.priv = s.priv or { acc = 0 }
		s.priv.pending = s.data.pb
		local tier = Belt.privateStep(Config, s.priv, dt, active, rnd())
		if tier then
			Lot7.privRefresh(s)
			notify(s.player, "🛤️ Un œuf " .. Config.TIERS[tier].name .. " t'attend sur ton tapis privé (gratuit).", "claim")
			sync(s)
		end
	end
	function Lot7.privTake(s, root, prompt)
		local now = os.clock()
		if now - (s.lastPriv or -10) < 0.25 then
			return
		end
		s.lastPriv = now
		if not passOn(s, "PrivateBelt") or prompt:GetAttribute("Owner") ~= s.player.UserId then
			return notify(s.player, "🛤️ Ce tapis n'est pas à toi.", "refuse")
		end
		local belt = s.plot and s.plot.privateBelt
		local strip = belt and belt:FindFirstChild("PrivateBeltStrip")
		if not strip or prompt.Parent ~= strip or (root.Position - strip.Position).Magnitude > 16 then
			return
		end
		local tier = s.data.pb[1]
		if not tier then
			return
		end
		local i = freeSlot(s)
		if not i then
			return notify(s.player, "Base pleine ! Libère un emplacement pour prendre l'œuf du tapis privé.", "refuse")
		end
		table.remove(s.data.pb, 1)
		s.data.slots[i] = { k = "e", t = tier, ends = os.time() + hatchTime(s, tier), shield = os.time() + shieldTime(s), rv = true, og = "r" } -- gratuit : non indemnisable (lot 7b) ; vitrine : tapis privé = passe payant ("r")
		refreshPad(s, i)
		Lot7.privRefresh(s)
		notify(s.player, "🥚 Œuf " .. Config.TIERS[tier].name .. " pris sur ton tapis privé !", "claim")
		sync(s)
	end

	-- Crochet INTERNE pour les tests (jamais exposé aux clients) : accès aux sessions et compteurs.
	Builder.lot7Hooks = { session = function(p)
		return sessions[p]
	end, logEnqueue = Lot7.logEnqueue, logPending = Lot7.logPending, logDropped = function()
		return Lot7.logDropped
	end, luckPoints = luckPoints, passOn = passOn, flights = Lot7.flightCount, serverBuffs = Lot7.serverBuffs, compPaid = function()
		return Lot7.compPaid
	end, duel = function() -- lot 13 : état des duels (tests de bout en bout seulement)
		return L15.duel
	end, live = function() -- lot 14 : état du classé en direct (tests de bout en bout seulement)
		return Lot7.Live
	end, tele = function() -- lot 14 : télémétrie (échantillons de fréquentation)
		return tele
	end, showcase = function() -- vitrine : module de la vitrine du serveur (tests de bout en bout seulement : espion de tryClaim)
		return L15.SC
	end }
end

---------------------------------------------------------------- Lot 16 : boutique en 8 catégories, passe de combat, offres contextuelles, vendeurs, télémétrie
-- Tout vit dans Lot7.L16 (AUCUNE variable locale de plus au niveau du script : limite de 200). Le client n'envoie que des clés ou des numéros (shopBuy, shopEv,
-- seasonView, seasonClaim, seasonAck, overflowTake, emoteSet, offerClose) ; le serveur revalide tout : Shop.canBuy AVANT l'invite d'achat (rien n'est débité
-- si l'achat est refusé : base et sac pleins, possédé, PolicyService, rareté sans espèce), ProcessReceipt livre UNE fois par reçu (L16.grant), la saison
-- ne crédite que ce que Season décide (aucune valeur venue du client). Aucun produit ne touche les stats de combat, l'XP de pet (champ x), les boucliers ou les trophées.
do
	local L16 = Lot7.L16
	local Shared = ReplicatedStorage:WaitForChild("Shared")
	local Shop = require(Shared:WaitForChild("Shop"))
	local SD = require(Shared:WaitForChild("SeasonData"))
	local S = require(Shared:WaitForChild("Season")).new(Config, SD)
	local Offers = require(Shared:WaitForChild("Offers"))
	local OffersData = require(Shared:WaitForChild("OffersData"))
	local LC = Config.LOT16
	L16.Shop, L16.Season = Shop, S
	local offerState = {} -- [Player] = état des offres de la session (jamais enregistré, libéré au départ)
	local gaps = {} -- [Player] = { [clé] = os.clock() } : pauses anti-rafale des demandes (libérées au départ)
	local bagPlus = setmetatable({ EGG_BAG = { size = Config.EGG_BAG.sizePlus } }, { __index = Config })

	-- A5 : fenêtres ouvertes des espèces d'événement / de saison (événement limité en cours, saison en cours), calculées par le SERVEUR seul.
	function L16.openEv(now)
		return L15.Rewards.openSpeciesEvents(Config, now, S.currentSeason(now).n)
	end
	-- Config vue par les règles du sac d'œufs : 20 places avec le passe EggBagPlus, 10 sinon.
	function L16.bagCfg(s)
		return (s and s.passes and s.passes.EggBagPlus == true) and bagPlus or Config
	end
	function L16.followerMax(s)
		return s.passes.Collector == true and Config.MAX_FOLLOWERS_COLLECTOR or Config.MAX_FOLLOWERS
	end
	-- Points de chance : Double chance = x2 puis 70 au plus ; sans elle, 70 au plus (= Rules.MAX_UP).
	function L16.luckTotal(points, doubled)
		return Shop.luckTotal(points, doubled)
	end
	function L16.hatchQualifies(tier)
		return S.hatchQualifies(tier)
	end
	-- Tickets d'arène du jour UTC en cours (combats de tour récompensés en plus).
	function L16.arenaExtra(s)
		local a = s.data.arenaTk
		return (type(a) == "table" and a.day == os.time() // 86400) and a.n or 0
	end
	local function gap(s, key, sec)
		local g = gaps[s.player]
		if not g then
			g = {}
			gaps[s.player] = g
		end
		local now = os.clock()
		if g[key] and now - g[key] < sec and now >= g[key] then
			return false
		end
		g[key] = now
		return true
	end
	local function restrictedFlag(s)
		return not (s.restricted == false) -- Shop / Offers : nil ou true = restreint (repli prudent), false = autorisé
	end
	local function ownedPasses(s)
		local out = {}
		for name in pairs(Config.PASSES) do
			out[name] = s.passes[name] == true or s.ownedRandom[name] == true
		end
		return out
	end
	-- Profil vu par Shop (forme du module pur) : base, sac, passes possédés, achats uniques, saison en cours.
	function L16.shopProfile(s)
		local d = s.data
		local se, cur = S.migrate(d, os.time())
		local once = {}
		for k, v in pairs(d.once) do
			once[k] = v
		end
		return { cap = cap(s), slots = d.slots, eggBag = d.eggBag, passes = ownedPasses(s), once = once, season = { cur = cur.n, premium = se.premium, plus = se.plus }, open = L16.openEv(os.time()) }
	end

	---------------------------------------------------------------- Rangement des œufs : base, puis sac, puis coffre de débordement (jamais de perte)
	function L16.storeEgg(s, tier, og) -- og (vitrine) : origine posée seulement si l'œuf va dans la base ; sac et coffre de débordement la perdent (inconnue = exclue)
		local where = L15.storeEggs(s, { tier }, og)
		if where then
			return where[1]
		end
		Shop.overflowAdd(s.data, tier, 1)
		return "overflow"
	end
	function actions.overflowTake(s)
		if not gap(s, "ovf", 0.3) then
			return
		end
		local d = s.data
		for t = #Config.TIERS, 1, -1 do
			local k = tostring(t)
			local n = d.overflow[k]
			if type(n) == "number" and n > 0 then
				local where = L15.storeEggs(s, { t })
				if not where then
					return notify(s.player, Shop.MSG_ROOM, "refuse")
				end
				d.overflow[k] = n > 1 and n - 1 or nil
				notify(s.player, "📦 Œuf " .. Config.TIERS[t].name .. " sorti du coffre de débordement (" .. (where[1] == "slot" and "dans ta base" or "dans ton sac") .. ").", "claim")
				sync(s)
				return
			end
		end
	end

	---------------------------------------------------------------- Passe de combat (Season.lua décide de tout)
	local function coinsFor(s, minutes)
		return math.floor(math.max(Config.COIN_PACK_MIN * minutes / Config.COIN_PACK_MINUTES, income(s) * minutes * 60))
	end
	-- Applique les grants de Season (paliers réclamés, premium crédité). Retourne un texte court.
	function L16.applyGrants(s, grants)
		local d, bits = s.data, {}
		for _, g in ipairs(grants or {}) do
			if g.kind == "coins" and type(g.minutes) == "number" then
				local c = coinsFor(s, g.minutes)
				d.coins += c
				bits[#bits + 1] = "🪙 " .. Config.fmt(c)
			elseif g.kind == "egg" and type(g.tier) == "number" and Config.TIERS[g.tier] then
				for _ = 1, math.max(1, math.floor(g.n or 1)) do
					L16.storeEgg(s, g.tier)
				end
				bits[#bits + 1] = "🥚 " .. (g.n or 1) .. " x Œuf " .. Config.TIERS[g.tier].name
			elseif g.kind == "token" and type(g.n) == "number" then
				d.fightTokens = math.min(Config.CALENDAR.caps.tokens, d.fightTokens + g.n)
				bits[#bits + 1] = "⚔️ " .. g.n .. " jeton(s) de combat"
			elseif g.kind == "scroll" and type(g.n) == "number" then
				d.scrolls = math.min(Config.CALENDAR.caps.scrolls, d.scrolls + g.n)
				bits[#bits + 1] = "📜 " .. g.n .. " parchemin(s)"
			elseif (g.kind == "cosmetic" or g.kind == "aura") and type(g.id) == "string" then
				d.cosm[g.id] = true
				bits[#bits + 1] = "🎀 " .. tostring(g.label or g.id)
			elseif g.kind == "species" and type(g.name) == "string" then
				-- espèce Exclusif FIXE de la saison : posée comme pet si une place est libre, sinon un œuf de sa rareté (débordement : jamais perdu)
				local idx
				for i, p in ipairs(Config.PETS) do
					if p.name == g.name then
						idx = i
					end
				end
				local slot = freeSlot(s)
				if idx and slot then
					d.slots[slot] = { k = "p", p = idx, s = 1, m = 1 }
					local key = tostring(idx)
					d.dex[key] = d.dex[key] or { n = 0, b = 0 }
					d.dex[key].n += 1
					d.dex[key].b = math.max(d.dex[key].b, 1)
					refreshPad(s, slot)
				else
					L16.storeEgg(s, g.tier)
				end
				bits[#bits + 1] = "✨ " .. g.name
			end
		end
		return table.concat(bits, ", ")
	end
	function L16.addXp(s, source)
		local r = S.addXp(s.data, source, os.time())
		if source == "pve" or source == "pvp" or source == "duel" then
			L16.victory(s)
		end
		if r.ok and #r.tiersUp > 0 and r.tier > 0 then
			notify(s.player, "🏅 Passe de combat : palier " .. r.tier .. " atteint ! Récompense à réclamer (Boutique › Passe de combat).", "claim")
			tele.event(s.player, "progression", "season", r.tier)
		end
		return r
	end
	function L16.seasonPush(s)
		local now = os.time()
		K8.remote:FireClient(s.player, { panel = "season", view = S.view(s.data, now), recap = S.recap(s.data, now), startsAt = Config.SEASON.start })
	end
	function actions.seasonView(s)
		if gap(s, "sview", 0.5) then
			L16.seasonPush(s)
		end
	end
	local CLAIM_MSG = { bad = "Palier inconnu.", locked = "🔒 Palier pas encore atteint.", premium = "🏅 Piste premium : il faut le passe premium de cette saison.", already = "✅ Déjà réclamé.",
		none = "Rien à réclamer sur ce palier.", expired = "⌛ La saison précédente est close : ces récompenses sont perdues.", noseason = "🏅 Le passe de combat n'a pas encore commencé." }
	function actions.seasonClaim(s, arg)
		if type(arg) ~= "table" or not gap(s, "sclaim", 0.25) then
			return
		end
		local which = arg.prev == true and "prev" or nil
		local now = os.time()
		local grants, label
		if arg.all == true then
			local r = S.claimAll(s.data, now, which)
			if r.claimed == 0 then
				return notify(s.player, "Rien à réclamer pour l'instant.", "refuse")
			end
			grants, label = r.grants, r.claimed .. " récompense(s)"
		else
			local r = S.claim(s.data, arg.tier, arg.track, now, which)
			if not r.ok then
				return notify(s.player, CLAIM_MSG[r.reason] or CLAIM_MSG.bad, "refuse")
			end
			grants, label = r.grants, "palier " .. r.tier
		end
		notify(s.player, "🏅 Passe de combat (" .. label .. ") : " .. L16.applyGrants(s, grants), "claim")
		sync(s)
		L16.seasonPush(s)
	end
	function actions.seasonAck(s)
		if gap(s, "sack", 0.5) then
			S.ackRecap(s.data, os.time())
			L16.seasonPush(s)
		end
	end

	---------------------------------------------------------------- Poses de victoire (cosmétiques, achat unique)
	function actions.emoteSet(s, n)
		if type(n) ~= "number" or n ~= n or n % 1 ~= 0 or n < 0 or n > #LC.emotes then
			return
		end
		if n > 0 and s.data.once["EmoteVictory" .. n] ~= true then
			return notify(s.player, "🎭 Cette pose n'est pas à toi.", "refuse")
		end
		s.data.emote = n
		sync(s)
	end
	function L16.victory(s)
		local n = s.data.emote
		if type(n) == "number" and n > 0 and s.data.once["EmoteVictory" .. n] == true then
			s.player:SetAttribute("VictoryPose", n)
			s.player:SetAttribute("VictoryAt", os.clock()) -- le client joue la pose (effet visuel seulement)
		end
		if not s.l16Win and (s.data.played or 0) < 7200 then
			s.l16Win = true
			tele.event(s.player, "onboarding", "first_battle_win")
		end
	end

	---------------------------------------------------------------- Boutique : contrôles AVANT l'invite d'achat (rien n'est débité en cas de refus)
	local WHY = {
		unknown = "🛒 Cet achat n'existe pas.", noId = Config.UNAVAILABLE_MESSAGE, policy = "🛒 Cette offre n'est pas disponible pour ton compte.",
		notLive = "🥚 Cet œuf n'est pas encore disponible.", owned = "✅ Tu possèdes déjà cet achat.", needPremium = "🏅 Il faut d'abord le passe de combat premium de la saison.",
		hasPremium = "🏅 Tu as déjà le passe premium : prends la version « suite » ou « sans passe ».", faisDeLaPlace = Shop.MSG_ROOM .. " Rien n'est débité.",
		noseason = "🏅 Le passe de combat n'a pas encore commencé (1er décembre 2026, UTC).",
	}
	-- Limites de RÉSERVE du moteur (pas des plafonds d'achat) : jetons de corbeau, rattrapages du calendrier ; série à sauver ; relance seulement après une défaite.
	local function engineBlock(s, key)
		local d = s.data
		local pack = Config.REMOTE_STEAL.packs[key]
		if pack and d.tokens.remoteSteal + pack > Config.REMOTE_STEAL.tokenMax then
			return "🐦‍⬛ Tu as déjà " .. d.tokens.remoteSteal .. " jeton(s) de corbeau (" .. Config.REMOTE_STEAL.tokenMax .. " en réserve au plus) : utilise-en d'abord. Rien n'est débité."
		end
		if key == "CalendarCatchup" and (tonumber(d.cal.catch) or 0) >= Config.CALENDAR.catchupMax then
			return "📅 Tu as déjà " .. Config.CALENDAR.catchupMax .. " rattrapages en réserve : utilises-en d'abord. Rien n'est débité."
		end
		if key == "StreakRestore" then
			local plan = L15.Rewards.streakPlan(Config, { daily = d.daily, streak = d.streak, grace = d.grace }, os.time() // 86400, { questsDone = L15.questsDone(s) })
			if plan.state ~= "rescue" then
				return "🔥 Ta série n'est pas en danger : rien à sauver. Rien n'est débité."
			end
		end
		if key == "Revive" and not (s.revive and s.castle and not s.castle.finished) then
			return "💫 La relance se propose juste après une défaite au Château."
		end
		return nil
	end
	function L16.canBuy(s, key)
		local ok, why = Shop.canBuy(L16.shopProfile(s), L16.bagCfg(s), key, restrictedFlag(s))
		if not ok then
			return false, WHY[why] or WHY.unknown
		end
		local block = engineBlock(s, key)
		if block then
			return false, block
		end
		return true
	end
	function actions.shopBuy(s, key)
		if type(key) ~= "string" or #key > 40 or not gap(s, "buy", 1) then
			return
		end
		local isPass = type(Config.PASSES[key]) == "table" and Config.PASSES[key].cat ~= nil
		local def = isPass and Config.PASSES[key] or Config.PRODUCTS[key]
		if type(def) ~= "table" or def.cat == nil then
			return
		end
		local ok, msg = L16.canBuy(s, key)
		if not ok then
			return notify(s.player, msg, "refuse")
		end
		tele.event(s.player, "funnel", "prompt", s.funnel)
		local player = s.player
		pcall(function()
			if isPass then
				MarketplaceService:PromptGamePassPurchase(player, def.id)
			else
				MarketplaceService:PromptProductPurchase(player, def.id)
			end
		end)
	end
	-- Mesure de l'entonnoir d'achat (vue de la boutique, ouverture d'une fiche) : aucune donnée personnelle, pause par joueur.
	function actions.shopEv(s, arg)
		if type(arg) ~= "table" or not gap(s, "shopEv", 0.5) then
			return
		end
		if arg.k == "view" then
			s.funnel = "f" .. (os.time() % 1000000) .. "_" .. rng:NextInteger(1, 999999)
			tele.event(s.player, "funnel", "shop_view", s.funnel)
			if not s.l16Shop and s.data.hatched < 30 then
				s.l16Shop = true
				tele.event(s.player, "onboarding", "first_shop_view")
			end
		elseif arg.k == "card" and type(arg.key) == "string" and (Config.PRODUCTS[arg.key] or Config.PASSES[arg.key]) then
			tele.event(s.player, "funnel", "card_open", s.funnel)
		end
	end

	---------------------------------------------------------------- Livraison d'un reçu (appelée par ProcessReceipt, PolicyService déjà vérifié, reçu non encore traité)
	-- Retourne true (livré), false + message (NotProcessedYet : RIEN n'a été modifié, Roblox rejouera), ou nil (produit livré par l'ancien code).
	local SEASON_KIND = { SeasonPremium = "premium", SeasonPremiumPlus = "premiumPlus", SeasonUpgradePlus = "upgradePlus" }
	local L16_KEYS = { StarterPack = true, CoinPack = true, CoinPackS = true, LuckPotion = true, LuckPotionMini = true, DoubleLuck = true, ArenaTickets = true, BundleLegend = true, BundleRoyal = true, BundleRoyalNoPass = true }
	function L16.grant(s, name, def)
		local d, now = s.data, os.time()
		if not (L16_KEYS[name] or SEASON_KIND[name] or type(def.eggTier) == "number" or (def.once == true and def.cat == "cosmetics")) then
			return nil
		end
		local eggs = Shop.eggsOf(name)
		for _, e in ipairs(eggs) do
			if not Config.tierLive(e.tier) then
				return false, "🥚 Cet œuf n'est pas encore disponible : ton achat sera livré plus tard (rien n'est perdu)."
			end
		end
		local withPremium = SEASON_KIND[name] ~= nil or name == "BundleRoyal" or name == "BundleRoyalNoPass"
		if withPremium and S.currentSeason(now).n == 0 then
			return false, "🏅 Le passe de combat n'a pas encore commencé : ton achat sera livré à son ouverture (rien n'est perdu)."
		end
		local bits, comp = {}, 0
		if def.once == true and d.once[name] == true then
			comp = def.robux -- achat unique déjà fait (course entre deux invites) : compensé en pièces, jamais un second octroi
		else
			for _, e in ipairs(eggs) do
				for _ = 1, e.n do
					L16.storeEgg(s, e.tier)
				end
				bits[#bits + 1] = (e.n > 1 and (e.n .. " x ") or "") .. "🥚 Œuf " .. Config.TIERS[e.tier].name
			end
			if SEASON_KIND[name] then
				local r = S.buyPremium(d, SEASON_KIND[name], now)
				if not r.ok and r.reason == "needPremium" then
					r = S.buyPremium(d, "premium", now) -- complément (400) payé sans premium (invite lancée hors de la boutique) : le premium (399) est donné, jamais plus que le prix payé
				end
				if r.ok then
					bits[#bits + 1] = "🏅 " .. def.name .. (r.credited > 0 and (" (" .. r.credited .. " palier(s) crédité(s) : " .. L16.applyGrants(s, r.grants) .. ")") or "")
				else
					comp = def.robux -- déjà possédé cette saison (course) : compensé en pièces
				end
			elseif name == "BundleRoyal" or name == "BundleRoyalNoPass" then
				local r = S.buyPremium(d, "premium", now) -- « sans passe » payé sans premium (course) : le premium est donné aussi (décision : équivalent plein)
				if r.ok then
					bits[#bits + 1] = "🏅 Passe de combat premium" .. (r.credited > 0 and (" (" .. L16.applyGrants(s, r.grants) .. ")") or "")
				elseif name == "BundleRoyal" then
					comp = Config.PRODUCTS.SeasonPremium.robux -- premium déjà possédé : la part « passe » est compensée en pièces
				end
			end
			if name == "StarterPack" then
				d.coins += Config.STARTER_PACK.coins
				d.luckUntil = math.max(now, d.luckUntil) + Config.LUCK_POTION_SECONDS
				bits[#bits + 1] = "🪙 " .. Config.fmt(Config.STARTER_PACK.coins) .. " et une potion de chance"
			elseif name == "CoinPack" or name == "CoinPackS" then
				local c = name == "CoinPack" and math.max(Config.COIN_PACK_MIN, income(s) * Config.COIN_PACK_MINUTES * 60) or math.max(LC.coinPackS.min, income(s) * LC.coinPackS.minutes * 60)
				d.coins += math.floor(c)
				bits[#bits + 1] = "🪙 " .. Config.fmt(c)
			elseif name == "LuckPotion" or name == "LuckPotionMini" then
				d.luckUntil = math.max(now, d.luckUntil) + (name == "LuckPotion" and Config.LUCK_POTION_SECONDS or LC.luckMiniSeconds)
				bits[#bits + 1] = "🧪 " .. def.name
			elseif name == "DoubleLuck" or name == "BundleLegend" then
				d.doubleUntil = math.max(now, d.doubleUntil) + (name == "DoubleLuck" and LC.doubleSeconds or LC.legendDoubleSeconds) -- durées cumulables, puissance plafonnée à 70
				bits[#bits + 1] = "🍀 Double chance"
			elseif name == "ArenaTickets" then
				local today = now // 86400
				local a = d.arenaTk
				d.arenaTk = { day = today, n = (a.day == today and a.n or 0) + LC.arenaTickets }
				bits[#bits + 1] = "🎫 +" .. LC.arenaTickets .. " combats de tour aujourd'hui"
			end
			if def.once == true then
				d.once[name] = true
				if name == "StarterPack" then
					d.starter = true
				end
				if def.cat == "cosmetics" then
					local n = tonumber(name:match("(%d+)$"))
					if n and d.emote == 0 then
						d.emote = n -- première pose achetée : choisie d'office (modifiable dans le menu)
					end
					bits[#bits + 1] = "🎭 " .. def.name
				end
			end
		end
		if comp > 0 then
			local coins = math.floor(math.max(Config.COIN_PACK_MIN, income(s) * Config.timeRobux(comp)))
			d.coins += coins
			bits[#bits + 1] = "🪙 " .. Config.fmt(coins) .. " (déjà possédé : compensé en pièces)"
		end
		notify(s.player, "🛒 " .. def.name .. " : " .. table.concat(bits, " · "), "buy")
		return true
	end

	---------------------------------------------------------------- Offres contextuelles (Offers.lua : 3 par session, 300 s d'écart, jamais en action, jamais après un achat)
	local function offerProfile(s)
		local d = s.data
		local owned = {}
		for k, v in pairs(d.once) do
			owned[k] = v
		end
		local best = 0
		for k in pairs(d.dex) do
			local p = Config.PETS[tonumber(k) or 0]
			if p and p.tier > best then
				best = p.tier
			end
		end
		return { owned = owned, passes = ownedPasses(s), dayNumber = math.max(1, os.time() // 86400 - (d.firstSeen > 0 and d.firstSeen or os.time() // 86400) + 1), bestTier = best, hatchedTotal = d.hatched }
	end
	local function offerCtx(s, flags)
		local d = s.data
		local now = os.time()
		local baseFull = freeSlot(s) == nil
		local bagFull = #d.eggBag >= L16.bagCfg(s).EGG_BAG.size
		local plan = L15.Rewards.streakPlan(Config, { daily = d.daily, streak = d.streak, grace = d.grace }, now // 86400, { questsDone = L15.questsDone(s) })
		local b = d.battle
		local ctx = {
			Config = Config, data = OffersData, restricted = restrictedFlag(s),
			baseFull = baseFull, bagFull = bagFull, streakAtRisk = plan.state == "rescue",
			firstLegend = s.l16Legend ~= nil and now - s.l16Legend < 600,
			towerQuotaExhausted = b.day == now // 86400 and b.fights >= Config.TOWER.dailyFights + L16.arenaExtra(s),
			inCombat = s.battle ~= nil or s.pvpPending == true, carrying = #s.carry > 0, castleTimer = s.castle ~= nil, flying = s.flying == true,
			calm = s.battle == nil and s.castle == nil and #s.carry == 0 and os.clock() - (s.lastSteal or 0) > 60,
		}
		for k, v in pairs(flags or {}) do
			ctx[k] = v
		end
		return ctx
	end
	function L16.tryOffer(s, flags)
		local st = offerState[s.player]
		if not st or s.leaving then
			return
		end
		local now = os.time()
		if st.current then
			if Offers.expired(st, now, offerCtx(s)) then
				st.current = nil
			else
				return
			end
		end
		local ok, o = pcall(Offers.pick, st, offerProfile(s), now, offerCtx(s, flags))
		if ok and o then
			Offers.onShown(st, o, now)
			K8.remote:FireClient(s.player, { panel = "offer", offer = o })
		end
	end
	function L16.event(s, flag)
		L16.tryOffer(s, { [flag] = true })
	end
	function actions.offerClose(s)
		local st = offerState[s.player]
		if st and gap(s, "offerClose", 0.3) then
			Offers.onClosed(st, os.time())
		end
	end
	function L16.bought(s, key)
		local st = offerState[s.player]
		if st then
			Offers.onBought(st, key, os.time()) -- aucune offre pendant 600 s après TOUT achat (pas de relance incitative)
		end
	end
	task.spawn(function() -- moments calmes et drapeaux durables (série en danger, base pleine, quota de tour) : un essai toutes les 20 s par joueur
		while true do
			task.wait(20)
			for _, ss in pairs(sessions) do
				pcall(L16.tryOffer, ss, nil)
			end
		end
	end)

	---------------------------------------------------------------- Arrivée / départ / vue
	function L16.join(s)
		local now = os.time()
		offerState[s.player] = Offers.newState(now)
		S.migrate(s.data, now)
		tele.event(s.player, "version", Config.BUILD)
		L15.Onb.resume(s.data.onb, os.time()) -- lot 17 : l'étape en cours repart de maintenant
		if s.data.hatched == 0 then
			tele.event(s.player, "onboarding", "join")
		end
		local rc = S.recap(s.data, now)
		if rc and not rc.expired then
			task.delay(10, function()
				if sessions[s.player] == s then
					notify(s.player, "🏅 La saison " .. rc.n .. " du passe de combat est terminée (palier " .. rc.tier .. ") : " .. (rc.unclaimedFree + rc.unclaimedPremium) .. " récompense(s) à réclamer encore " .. rc.graceDaysLeft .. " jour(s).", "claim")
				end
			end)
		end
	end
	function L16.leave(s)
		offerState[s.player] = nil
		gaps[s.player] = nil
	end
	local function hasBit(mask, t)
		return math.floor((tonumber(mask) or 0) / 2 ^ (t - 1)) % 2 == 1
	end
	function L16.view(s)
		local d, now = s.data, os.time()
		local se, cur = S.migrate(d, now)
		local tier = S.tierOf(se.xp)
		local claimable = false
		if cur.n > 0 then
			for t = 1, tier do
				if (SD.FREE[t] and not hasBit(se.claimedFree, t)) or (se.premium == se.n and SD.PREMIUM_TRACK[t] and not hasBit(se.claimedPrem, t)) then
					claimable = true
				end
			end
		end
		return {
			once = d.once, overflow = Shop.overflowCount(d), bagMax = L16.bagCfg(s).EGG_BAG.size, emote = d.emote, followerMax = L16.followerMax(s),
			doubleLeft = math.max(0, d.doubleUntil - now), arenaLeft = L16.arenaExtra(s), owned = ownedPasses(s), open = L16.openEv(now), -- A5 : affichage seulement (le serveur recalcule)
			season = { cur = cur.n, premium = se.premium, plus = se.plus, tier = tier, xp = se.xp, daysLeft = cur.daysLeft or 0, startsAt = Config.SEASON.start, claimable = claimable, prev = se.prev ~= nil and not se.prev.seen },
		}
	end
end

---------------------------------------------------------------- Game Passes
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local s = sessions[player]
	if not (s and purchased) then
		return
	end
	for name, def in pairs(Config.PASSES) do
		if Config.purchasable(def) and def.id == passId then
			if def.random == true and s.restricted ~= false then
				warn("[Policy] " .. player.Name .. " : achat du pass « " .. name .. " » refusé (offres à hasard restreintes)") -- jamais livré à un joueur restreint
				notify(player, "🛒 Cette offre n'est pas disponible pour ton compte.")
			else
				s.passes[name] = true
				if def.random == true then
					s.ownedRandom[name] = true
				end
				if name == "PrivateBelt" then
					Lot7.privRefresh(s)
				end
			end
		end
	end
	if passId == Config.PASSES.ExtraSlots.id and s.plot then
		refreshLocks(s) -- +4 emplacements : cadenas levés sans recréer les pads occupés
	end
	Lot7.L16.bought(s, "pass") -- lot 16 : aucune offre à l'écran juste après un achat
	sync(s)
end)

---------------------------------------------------------------- Produits développeur (achats Robux ponctuels)
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local s = player and sessions[player]
	if not s then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local rid = tostring(info.PurchaseId)
	local function persist()
		-- PurchaseGranted seulement une fois la sauvegarde réussie ; sinon Roblox rappellera ProcessReceipt (le reçu en mémoire n'est
		-- compté « traité » qu'après une sauvegarde réussie, la livraison n'est donc jamais refaite : s.pendingReceipts).
		if not s.noSave and not Data.save(player, s.data, s.leaving == true) then -- joueur en train de partir : libère aussi le verrou (sinon ce reçu le reprendrait après sa sauvegarde de départ)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		s.pendingReceipts[rid] = nil
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if s.pendingReceipts[rid] then
		return persist() -- déjà livré en mémoire, il ne reste qu'à sauvegarder
	end
	if s.data.receipts[rid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local granted = false
	for name, def in pairs(Config.PRODUCTS) do
		if Config.purchasable(def) and def.id == info.ProductId then
			if def.random == true and Lot7.awaitPolicy(s) then
				notify(player, "🛒 Cette offre n'est pas disponible pour ton compte.")
				return Enum.ProductPurchaseDecision.NotProcessedYet -- offre à hasard refusée côté serveur (PolicyService) : rien n'est livré
			end
			if s.pendingReceipts[rid] or s.data.receipts[rid] then
				return Enum.ProductPurchaseDecision.NotProcessedYet -- reçu livré pendant l'attente (appel concurrent du même reçu) : le deuxième appel ne livre rien
			end
			local l16ok, l16msg = Lot7.L16.grant(s, name, def) -- lot 16 : œufs (base, sac, débordement), packs, saison, chance, pièces, tickets, poses
			local l7ok, l7msg
			if l16ok == nil then
				l7ok, l7msg = Lot7.grant(s, name)
			end
			if l16ok == false then
				notify(player, l16msg)
				return Enum.ProductPurchaseDecision.NotProcessedYet
			elseif l16ok == true then
				-- livré par le lot 16 ; le reçu est enregistré plus bas
			elseif l7ok == false then
				notify(player, l7msg)
				return Enum.ProductPurchaseDecision.NotProcessedYet
			elseif l7ok == true then
				-- livré par le lot 7 (jetons, tapis doré, pluie de chance) ; le reçu est enregistré plus bas
			elseif name == "CalendarCatchup" then
				-- lot 9b : un jeton de rattrapage du calendrier (plafond Config.CALENDAR.catchupMax : au-delà, rien n'est débité, le reçu sera rejoué)
				if not Lot7.Calendar.addCatch(Config, s.data.cal) then
					notify(player, "📅 Tu as déjà " .. Config.CALENDAR.catchupMax .. " rattrapages : utilises-en avant de finaliser cet achat (il sera livré automatiquement, rien n'est perdu).")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				notify(player, "📅 +1 rattrapage du calendrier (" .. s.data.cal.catch .. "/" .. Config.CALENDAR.catchupMax .. ").", "buy")
			elseif name == "StreakRestore" then
				-- lot 15 : sauvetage payant de la série (lot 16 : sans plafond d'achat), seulement si la série est réellement à sauver (vérifié aussi AVANT l'invite) ; sinon rien n'est livré (rejoué plus tard)
				local okS, why = L15.streakClaim(s, "product")
				if not okS then
					notify(player, why == "bagFull" and "🔥 Base et sac d'œufs pleins : libère une place, ton achat sera livré automatiquement." or "🔥 Ta série n'a pas besoin d'être sauvée : ton achat n'est pas livré (rien n'est perdu).")
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
			elseif name == "InstantHatch" then
				for i = 1, cap(s) do
					hatch(s, i)
				end
			elseif name == "Revive" then
				local rv = s.revive
				s.revive = nil
				player:SetAttribute("ReviveUntil", nil)
				local root = getRoot(player)
				if s.castle and not s.castle.finished and rv and os.clock() <= rv.expires + 5 and root then
					-- relance sur place : retour là où il est tombé, pv pleins, invulnérable un moment, la défaite n'est pas comptée
					root.CFrame = CFrame.new(rv.pos + Vector3.new(0, 3, 0))
					root.AssemblyLinearVelocity = Vector3.zero
					s.noCheckUntil = os.clock() + 2
					setHp(s, GC.maxHp)
					s.iframes = Config.REVIVE.iframes
					s.castle.deaths = math.max(0, s.castle.deaths - 1)
					notify(player, "💫 Relance ! Tu repars de là où tu es tombé.", "claim")
				else
					-- l'offre a expiré (ou il a quitté le château) : l'achat n'est jamais perdu, il est remplacé par une potion de chance
					s.data.luckUntil = math.max(os.time(), s.data.luckUntil) + Config.LUCK_POTION_SECONDS
					notify(player, "💫 L'offre de relance avait expiré : une potion de chance t'est offerte à la place.", "claim")
				end
			end
			granted = true
			tele.log(player, "purchase_tier", def.robux, "_p" .. tele.priceTier(def.robux))
			tele.event(player, "funnel", "receipt", s.funnel) -- lot 16 (I.2) : entonnoir d'achat
			Lot7.L16.bought(s, name) -- lot 16 : aucune offre à l'écran juste après un achat
		end
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local now = os.time()
	for k, t in pairs(s.data.receipts) do
		if type(t) ~= "number" or now - t > 30 * 86400 then
			s.data.receipts[k] = nil
		end
	end
	s.data.receipts[rid] = now
	s.pendingReceipts[rid] = true
	sync(s)
	return persist()
end

---------------------------------------------------------------- Cycle de vie des joueurs
local function claimPlot(player)
	for _, pl in ipairs(world.plots) do
		if not pl.owner then
			pl.owner = player
			pl.nameLabel.Text = "🏠 Base de " .. player.DisplayName
			return pl
		end
	end
	return nil
end

local function releasePlot(s)
	setDoorBarrier(s, false)
	Builder.clearPrivateBelt(s.plot)
	if s.badge then
		s.badge:Destroy()
		s.badge = nil
	end
	for i = 1, Config.SLOTS_MAX do
		clearPad(s, i)
		s.plot.pads[i].lock.Enabled = true
		s.plot.pads[i].part.Transparency = 0.7
		s.plot.pads[i].frame.Color = Color3.fromRGB(50, 52, 58)
		s.plot.pads[i].frame.Material = Enum.Material.SmoothPlastic
	end
	s.plot.owner = nil
	s.plot.nameLabel.Text = "Base libre"
	Builder.clearBase(s.plot)
end

-- Partie pleine (5 joueurs au plus) ou lieu de jeu ouvert en trop : le joueur est renvoyé au hub (ou expulsé avec un message si le hub est injoignable).
local function bounceToHub(player, message)
	local hub = Config.Game.Places.hub
	local role = Config.Game.roleFor(game.PlaceId)
	if role == "game" and type(hub) == "number" and hub > 0 then
		local opts = Instance.new("TeleportOptions")
		opts:SetTeleportData({ from = "game", reason = "full" })
		local ok = pcall(function()
			TeleportService:TeleportAsync(hub, { player }, opts)
		end)
		if ok then
			return
		end
	end
	player:Kick(message)
end


local function onJoin(player)
	local okJ, joinData = pcall(function()
		return player:GetJoinData().TeleportData
	end)
	local admitted, why = Party.admitJoin(serverPartyId, okJ and joinData or nil, #Players:GetPlayers() - 1, Config.Game.MaxPlayers, Config.Game.roleFor(game.PlaceId))
	if not admitted then
		bounceToHub(player, why == "full" and ("Cette partie est pleine (" .. Config.Game.MaxPlayers .. " joueurs maximum). Réessaie avec une autre partie.") or "Tu ne fais pas partie de cette partie.")
		return
	end
	if serverPartyId == nil and okJ and type(joinData) == "table" and type(joinData.partyId) == "string" then
		serverPartyId = joinData.partyId
	end
	if okJ and type(joinData) == "table" and joinData.mode == "castle" and next(sessions) == nil then
		serverMode = "castle" -- le premier joueur détermine le mode du serveur réservé
	elseif okJ and type(joinData) == "table" and joinData.mode == "ranked" and next(sessions) == nil then
		serverMode = "ranked" -- lot 14 : serveur réservé d'un match classé en direct (le match est vérifié dans PvpMatch_v1, pas dans le TeleportData)
	end
	local late = next(sessions) ~= nil -- arrivée dans une partie déjà commencée
	local waitedLeave = 0
	while leavingSave[player.UserId] and waitedLeave < 20 and player.Parent do -- il vient de partir : attendre la fin de sa sauvegarde (sinon on lirait un profil périmé puis on l'écraserait)
		task.wait(0.25)
		waitedLeave += 0.25
	end
	local d, noSave = Data.load(player)
	if not d then
		player:Kick("Impossible de charger tes données. Reconnecte-toi dans un instant.")
		return
	end
	if pendingSaves[player.UserId] and not noSave then
		d = pendingSaves[player.UserId] -- il revient avant que sa dernière sauvegarde ait réussi : ce profil (plus récent) fait foi
		pendingSaves[player.UserId] = nil
	end
	if not player.Parent then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session
		end
		return
	end
	local plot = claimPlot(player)
	if not plot then
		if not noSave then
			Data.save(player, d, true) -- libère le verrou de session avant de refuser
		end
		player:Kick("Serveur plein. Réessaie dans un autre serveur.")
		return
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local function stat(name)
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
		return v
	end
	local rankStat = Instance.new("StringValue")
	rankStat.Name = "Rang"
	rankStat.Parent = ls
	local s = {
		species = speciesCount(d), lsRank = rankStat,
		player = player, data = d, plot = plot, carry = {}, carryParts = {}, labels = {}, passes = {},
		graceUntil = late and (os.time() + Config.Game.LateJoinGrace) or 0, hp = Config.GUARD.maxHp, iframes = 0, sinceHit = 99, stun = 0, lastAct = 0, lastActive = os.clock(), lastTap = 0, lastSteal = 0, lastFull = 0, noSave = noSave,
		followers = {}, ownedRandom = {}, pendingReceipts = {}, holdSeen = false, flags = 0, noCheckUntil = 0, syncT = 0, leaving = false, traps = {},
		runes = { 1, 1, 1, 1 }, lastRune = 0, runeLock = 0,
		lsCoins = stat("Pièces"), lsSpeed = stat("Vitesse"), lsRb = stat("Renaissances"),
	}
	ls.Parent = player
	player:SetAttribute("Hp", Config.GUARD.maxHp)
	player:SetAttribute("MaxHp", Config.GUARD.maxHp)
	sessions[player] = s
	do -- lot 9 (mesure de rétention) : jours UTC de première et de dernière connexion, aucune donnée personnelle
		local today = os.time() // 86400
		if d.firstSeen == 0 then
			d.firstSeen = today
		end
		local back = d.lastSeen ~= today and tele.retentionDay(d.firstSeen, today) or nil
		if back then
			tele.log(player, "retention_day" .. back)
		end
		d.lastSeen = today
		if Config.SHOWCASE.enabled then -- idée 3 : propriétaire de la vitrine du jour dont le bonus n'a pas été enregistré (arrêt serveur) : accordé une fois, ce jour seulement
			task.spawn(function()
				local okStore, store = pcall(function()
					return game:GetService("DataStoreService"):GetDataStore(Config.SHOWCASE.storeName)
				end)
				if okStore and player.Parent and L15.SC.onLogin(store, d.showcase, { userId = player.UserId, name = player.DisplayName }, os.time(), task.wait) == "granted" then
					notify(player, "🏆 Vitrine du jour : +5 % de revenus pendant 24 h.", "claim")
				end
			end)
		end
		s.joinClock = os.clock()
		s.npcStart = os.time() -- lot 15 : 8 premières minutes de la session sans PNJ
	end
	if plot and plot.spawn then
		player:SetAttribute("BaseX", plot.spawn.Position.X) -- le client affiche la distance à la base sur la bannière de zone
		player:SetAttribute("BaseZ", plot.spawn.Position.Z)
	end
	if late then
		notify(player, "🛡 Tu arrives en cours de partie : tes œufs sont protégés " .. Config.Game.LateJoinGrace .. " s.")
	end

	for name, def in pairs(Config.PASSES) do
		s.passes[name] = false
		if Config.purchasable(def) then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if def.random == true then
				s.ownedRandom[name] = ok and owns == true -- passe à hasard : possédée mais INACTIVE tant que PolicyService n'a pas confirmé « non restreint » (voir fetchPolicy)
			else
				s.passes[name] = ok and owns == true
			end
		end
	end

	Lot7.restoreBuffs(s) -- tapis doré / pluie de chance offerts par ce joueur sur un serveur fermé depuis : le temps restant est rendu une fois
	Lot7.fetchPolicy(s) -- offres à hasard : masquées et refusées tant que PolicyService n'a pas confirmé qu'elles sont permises
	Lot7.L16.join(s) -- lot 16 : passe de combat (saison à jour, récapitulatif), offres contextuelles, version publiée (télémétrie)
	s.baseLevel = levelOf(s) -- le revenu (gains hors ligne compris) dépend du niveau de maison ; la base est construite plus bas par applyBase
	-- gains hors-ligne (les œufs éclosent seuls grâce aux horodatages)
	local away = math.clamp(os.time() - d.last, 0, Config.IDLE.offlineMaxSeconds)
	if away > 30 then
		local gain = income(s) * away * Config.IDLE.offlineRate
		d.pendingAway = math.min(d.pendingAway + gain, math.max(income(s), 1) * Config.IDLE.offlineMaxSeconds * Config.IDLE.offlineRate) -- mis de côté (plafonné) : se récupère d'un clic (claimAway)
	end
	if d.pendingAway >= 1 then
		notify(player, "💤 Gains pendant ton absence : " .. Config.fmt(d.pendingAway) .. " 🪙 : touche « Récupérer »")
	end

	ensureQuests(s)
	pvpState(s) -- nouvelle saison : récompense de la précédente et remise à zéro douce
	if serverMode == "ranked" then
		Lot7.Live.arenaJoin(s, okJ and joinData or nil) -- lot 14 : joueur du match (sinon renvoyé chez lui)
	end
	applyBase(s, false)
	updateSign(s)
	refreshAllPads(s)
	Lot7.privRefresh(s) -- tapis privé (pass) : œufs en attente sauvegardés
	s.welcome = "wait"
	task.delay(5, function() -- lot 12 B : reconnexion avec un tirage de cartes en attente : mêmes cartes, temps restant (échu : première carte d'office)
		if player.Parent and sessions[player] == s and not s.battle then
			L15.sendPick(s)
		end
	end)
	task.delay(Config.BELT.welcome.delay, function()
		beltWelcome(player, s) -- œuf de bienvenue du tapis (une fois, 20 s après l'arrivée)
	end)
	player:SetAttribute("PlotCF", plot.cf) -- position de la base : sert aux caméras des cinématiques (réplication sûre)
	player.RespawnLocation = plot.spawn
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		s.stun = 0
		s.carry = {}
		s.carryParts = {}
		s.lastPos = nil
		s.followers = {}
		applySpeed(s)
		task.spawn(function()
			char:WaitForChild("HumanoidRootPart", 10)
			if player.Parent and sessions[player] == s then
				rebuildFollowers(s)
				if serverMode == "castle" and not s.castle then
					castleEnter(s) -- serveur de mode Château : arrivée directement à l'entrée du donjon
				end
			end
		end)
		hum.Died:Connect(function()
			dropCarry(s)
			clearFollowers(s)
			task.delay(3, function()
				if player.Parent and sessions[player] == s then
					pcall(function()
						player:LoadCharacterAsync()
					end)
				end
			end)
		end)
	end)
	if player.Parent then
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok then
			warn("[onJoin] LoadCharacterAsync : " .. tostring(err))
		end
		if player.Parent then
			sync(s)
		end
	end
end

Players.PlayerAdded:Connect(onJoin)
-- Filet de sécurité : personnage garanti dans la zone, replacement si chute (voir Spawn / SpawnGuard, traces [Spawn] en console serveur)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpawnGuard")).attach({
	role = "game",
	safeCFrame = function(p)
		local ss = sessions[p]
		local sp = ss and ss.plot and ss.plot.spawn
		if sp then
			return sp.CFrame + Vector3.new(0, 4, 0)
		end
		local pa = Config.Map2.plazaArrival
		return CFrame.new(pa.x, 8, pa.z) -- sur la place du marché, près de la rose des portails : toujours au sol
	end,
})
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

-- Profils dont la sauvegarde de départ a échoué : réessayée en arrière-plan (délais croissants, 10 essais), abandonnée si le joueur est revenu
-- (sa nouvelle session reprend ce profil au chargement) ; vidée aussi à la fermeture du serveur (BindToClose).
function saveLater(player, d)
	local uid = player.UserId
	pendingSaves[uid] = d
	task.spawn(function()
		local delay = 4
		for _ = 1, 10 do
			task.wait(delay)
			delay = math.min(delay * 2, 60)
			if pendingSaves[uid] ~= d then
				return
			end
			if Players:GetPlayerByUserId(uid) then
				return -- revenu : le chargement a repris pendingSaves, rien à écraser
			end
			if Data.save(player, d, true) then
				pendingSaves[uid] = nil
				return
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	local s = sessions[player]
	if not s then
		return
	end
	s.leaving = true -- l'autosave ne doit plus reprendre le verrou de session après ce point
	L15.duelLeave(s) -- lot 13 : duel en cours = forfait (défaite comptée dans le profil AVANT la sauvegarde ci-dessous), défis retirés
	do -- lot 9b : une réclamation du calendrier en cours (sauvegarde puis octroi) se termine AVANT la sauvegarde de départ
		local t0 = os.clock()
		while s.calBusy and os.clock() - t0 < 15 do
			task.wait(0.1)
		end
	end
	K8.Kiosk.forget(player) -- lot 8B : pause du kiosque (table à clés faibles : facultatif)
	K8.Sellers.forget(player) -- lot 16 : pause des vendeurs
	Lot7.L16.leave(s) -- lot 16 : état des offres et des pauses du joueur libéré (aucune fuite)
	L15.books[player] = nil -- lot 15 : carnet d'offres libéré (pas de fuite mémoire) ; les compteurs du profil restent (aucune rencontre relancée en se reconnectant)
	tele.log(player, "session_length", os.clock() - (s.joinClock or os.clock()))
	tele.flush(player)
	Lot7.Live.onLeave(s) -- lot 14 : retrait de la file ; combat en direct en cours = forfait écrit dans le profil AVANT la sauvegarde ci-dessous
	Lot7.onLeave(s) -- annule tout vol de corbeau en cours (jeton rendu au voleur AVANT la sauvegarde), vide les états du joueur
	dropCarry(s)
	clearFollowers(s)
	holds[player] = nil
	if not s.noSave then
		leavingSave[player.UserId] = true
		local okSave = Data.save(player, s.data, true) -- libère le verrou
		if not okSave then
			saveLater(player, s.data) -- DataStore en panne ou lent : on réessaie en arrière-plan (la progression n'est pas perdue)
		end
		leavingSave[player.UserId] = nil
		Data.submit(player, s.data)
	end
	releasePlot(s)
	sessions[player] = nil
end)

-- sauvegarde automatique toutes les 60 s
task.spawn(function()
	while true do
		task.wait(60)
		for player, s in pairs(sessions) do
			if not s.noSave and not s.leaving then
				task.spawn(function()
					Data.save(player, s.data)
					Data.submit(player, s.data)
				end)
			end
		end
	end
end)

game:BindToClose(function()
	pcall(Lot7.abortAll) -- d'abord : tout vol de corbeau en cours est annulé et son jeton rendu dans le profil, AVANT les sauvegardes ci-dessous
	pcall(Lot7.persistBuffs) -- fin du tapis doré / de la pluie de chance écrite dans le profil du donateur présent
	local pending = 0
	for uid, d in pairs(pendingSaves) do -- profils de joueurs déjà partis dont la sauvegarde a échoué
		pending += 1
		task.spawn(function()
			local ghost = Players:GetPlayerByUserId(uid) or { UserId = uid, Name = "joueur " .. uid }
			if Data.save(ghost, d, true) then
				pendingSaves[uid] = nil
			end
			pending -= 1
		end)
	end
	for player, s in pairs(sessions) do
		if not s.noSave then
			pending += 1
			task.spawn(function()
				Data.save(player, s.data, true)
				pending -= 1
			end)
		end
	end
	local t0 = os.clock()
	while (pending > 0 or Lot7.logPending() > 0) and os.clock() - t0 < 25 do -- (le journal RavenLog est vidé dans la même limite de temps)
		task.wait()
	end
end)

-- classement global : rafraîchi toutes les 2 minutes
task.spawn(function()
	while true do
		topCache = Data.top(10)
		task.wait(120)
	end
end)

print("[Chipe-Œufs] serveur prêt")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/Data
-- Sauvegarde DataStore avec VERROU DE SESSION (un joueur ne peut pas être chargé sur 2 serveurs à la fois :
-- empêche les pertes et duplications quand on change de serveur vite) + classement global.
-- Les emplacements vides valent `false` (un tableau JSON ne supporte pas les trous).
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
