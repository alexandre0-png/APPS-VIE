<Item class="ReplicatedFirst" referent="RBX3"><Properties><string name="Name">ReplicatedFirst</string></Properties><Item class="LocalScript" referent="RBX1"><Properties><string name="Name">LoadingScreen</string><ProtectedString name="Source"><![CDATA[-- LocalScript : ReplicatedFirst/LoadingScreen
-- Écran de chargement : image d'accroche plein écran (Decal 140180423430231) sur fond bleu nuit, barre de progression lissée, « Chargement des œufs… ».
-- Ne bloque jamais le jeu : tout est sous pcall, délai maximal (LoadingPlan.CFG.maxShow), garde-fou indépendant de la boucle. Fondu au premier personnage
-- ET après 2 s au moins, puis Destroy et déconnexions (aucune instance ni connexion restante). Aucune donnée du joueur, aucun remote.
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")

pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

local Plan = require(script.Parent:WaitForChild("LoadingPlan"))
local CFG = Plan.CFG
local bg3 = Color3.fromRGB(CFG.bg[1], CFG.bg[2], CFG.bg[3])
local WHITE = Color3.fromRGB(255, 255, 255)

local player = Players.LocalPlayer
local waited = 0
while not player and waited < 10 do
	waited = waited + task.wait(0.05)
	player = Players.LocalPlayer
end
if not player then
	return
end
local playerGui = player:WaitForChild("PlayerGui", 10)
if not playerGui then
	return
end

local gui, conns, closed = nil, {}, false
local state = Plan.new(CFG)
local imageStatus, hasChar = nil, player.Character and true or false

local function close()
	if closed then
		return
	end
	closed = true
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	conns = {}
	if gui then
		pcall(function()
			gui:Destroy()
		end)
		gui = nil
	end
end

local ok = pcall(function()
	gui = Instance.new("ScreenGui")
	gui.Name = "LoadingScreen"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = bg3
	back.BorderSizePixel = 0
	back.Parent = gui

	local img = Instance.new("ImageLabel")
	img.Name = "Splash"
	img.Size = UDim2.fromScale(1, 1)
	img.BackgroundTransparency = 1
	img.Image = CFG.image
	img.ScaleType = Enum.ScaleType.Fit
	img.Visible = false -- affichée seulement si le préchargement réussit (sinon : fond bleu nuit seul)
	img.Parent = back

	-- Bande basse sombre (lisibilité du texte sur n'importe quelle partie de l'image) : texte blanc sur bleu nuit, contraste > 4,5:1 même à 80 % d'opacité
	local band = Instance.new("Frame")
	band.Name = "Band"
	band.AnchorPoint = Vector2.new(0, 1)
	band.Position = UDim2.fromScale(0, 1)
	band.Size = UDim2.new(1, 0, 0, 84)
	band.BackgroundColor3 = bg3
	band.BackgroundTransparency = 0.2
	band.BorderSizePixel = 0
	band.Parent = back

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0, 12)
	label.Size = UDim2.new(1, -24, 0, 28)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 20
	label.TextColor3 = WHITE
	label.Text = CFG.text
	label.Parent = band

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0.5, 0)
	track.Position = UDim2.new(0.5, 0, 0, 52)
	track.Size = UDim2.new(0.7, 0, 0, 12)
	track.BackgroundColor3 = Color3.fromRGB(60, 70, 110)
	track.BorderSizePixel = 0
	track.Parent = band
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(0, 6)
	tc.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 6)
	fc.Parent = fill

	gui.Parent = playerGui

	local function applyScale()
		local cam = workspace.CurrentCamera
		local size = cam and cam.ViewportSize
		if size then
			img.ScaleType = Plan.scaleType(size.X, size.Y, CFG) == "Crop" and Enum.ScaleType.Crop or Enum.ScaleType.Fit
		end
	end
	applyScale()
	local cam = workspace.CurrentCamera
	if cam then
		conns[#conns + 1] = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			pcall(applyScale)
		end)
	end

	conns[#conns + 1] = player.CharacterAdded:Connect(function()
		hasChar = true
	end)

	-- Préchargement de l'image elle-même (hors boucle : un échec ou une lenteur ne bloque rien)
	task.spawn(function()
		local status = "Failure"
		pcall(function()
			ContentProvider:PreloadAsync({ img }, function(_, s)
				status = s
			end)
		end)
		imageStatus = status
	end)

	conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
		if closed then
			return
		end
		local good = pcall(function()
			local queue = 0
			pcall(function()
				queue = ContentProvider.RequestQueueSize
			end)
			Plan.update(state, { dt = dt, imageStatus = imageStatus, queue = queue, gameLoaded = game:IsLoaded() == true, character = hasChar })
			img.Visible = state.imageVisible
			fill.Size = UDim2.fromScale(state.shown, 1)
			local a = state.alpha
			back.BackgroundTransparency = a
			img.ImageTransparency = a
			band.BackgroundTransparency = 0.2 + 0.8 * a
			label.TextTransparency = a
			track.BackgroundTransparency = a
			fill.BackgroundTransparency = a
		end)
		if not good or state.done then
			close()
		end
	end)
end)

if not ok then
	close()
	return
end

-- Garde-fou indépendant de la boucle : l'écran disparaît au plus tard à maxShow + 3 s, même si Heartbeat ne tourne plus
task.delay(CFG.maxShow + 3, close)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">LoadingPlan</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedFirst/LoadingPlan
-- Écran de chargement : logique PURE (aucun service, aucune instance), testée hors Roblox. Le script LoadingScreen.client.lua l'appelle à chaque image.
-- Vit dans ReplicatedFirst (et non ReplicatedStorage) : ce dossier est répliqué en premier, ReplicatedStorage peut arriver après l'écran.
-- L'identifiant de l'image est donc répété ici ; Config.LOADING.image (ReplicatedStorage) doit rester identique (test « tests/loading.luau »).
-- Style : pas d'affectation composée ni de saut de boucle (modules partagés, lupa).
local LoadingPlan = {}

LoadingPlan.CFG = {
	image = "rbxassetid://140180423430231", -- Decal approuvé « Chipe-Oeufs accroche v2 », 1920 x 1080 (16:9) avec le titre
	imageRatio = 16 / 9,
	bg = { 14, 20, 48 }, -- bleu nuit, affiché tout de suite et conservé si l'image n'arrive pas
	text = "Chargement des œufs…",
	minShow = 2, -- secondes d'affichage minimales avant le fondu
	maxShow = 25, -- délai maximal : au-delà, on quitte l'écran quoi qu'il arrive (le jeu n'est jamais bloqué)
	hold = 0.25, -- le temps de remplir la barre à 100 % avant le fondu
	fade = 0.5, -- durée du fondu
	smooth = 6, -- vitesse de lissage de la barre (1 / s)
	cropMin = 1.5, -- plage de ratios d'écran (largeur / hauteur) où l'image est rognée (Crop) ; ailleurs elle est entière (Fit)
	cropMax = 2.0,
}

local function num(v, default)
	if type(v) == "number" and v == v and v > -math.huge and v < math.huge then
		return v
	end
	return default
end

local function clamp01(v)
	if v < 0 then
		return 0
	elseif v > 1 then
		return 1
	end
	return v
end

-- ScaleType de l'image 16:9 selon l'écran : "Crop" (remplit, rogne < 16 % de la largeur ou de la hauteur) proche du 16:9, "Fit" (image entière,
-- bandes bleu nuit autour) pour un téléphone en portrait, un écran carré ou ultra-large : le titre n'est jamais coupé ni déformé.
function LoadingPlan.scaleType(width, height, cfg)
	cfg = cfg or LoadingPlan.CFG
	local w, h = num(width, 0), num(height, 0)
	if w <= 0 or h <= 0 then
		return "Fit"
	end
	local r = w / h
	if r >= cfg.cropMin and r <= cfg.cropMax then
		return "Crop"
	end
	return "Fit"
end

-- L'image n'est affichée que si son préchargement a réussi (AssetFetchStatus.Success, avec ou sans préfixe « Enum.AssetFetchStatus. »).
function LoadingPlan.imageVisible(status)
	if status == nil then
		return false
	end
	local s = tostring(status)
	return s == "Success" or s == "Enum.AssetFetchStatus.Success"
end

function LoadingPlan.new(cfg)
	return {
		cfg = cfg or LoadingPlan.CFG,
		elapsed = 0,
		shown = 0, -- progression affichée, 0..1, ne recule jamais
		phase = "show", -- "show" -> "fade" -> "done"
		fadeT = 0,
		alpha = 0, -- transparence de l'écran (0 opaque, 1 invisible)
		done = false,
		imageVisible = false,
		maxQueue = 0,
	}
end

-- input = { dt, imageStatus, queue (éléments restant à charger), gameLoaded (bool), character (bool) } ; toute valeur invalide est ignorée.
function LoadingPlan.update(st, input)
	if st.done then
		return st
	end
	input = input or {}
	local cfg = st.cfg
	local dt = num(input.dt, 0)
	if dt < 0 then
		dt = 0
	elseif dt > 1 then
		dt = 1
	end
	st.elapsed = st.elapsed + dt
	if input.imageStatus ~= nil then
		st.imageVisible = LoadingPlan.imageVisible(input.imageStatus)
	end
	local imageDone = input.imageStatus ~= nil
	-- Fraction des éléments préchargés : la file ContentProvider.RequestQueueSize donne le reste, on retient son maximum comme total.
	local q = num(input.queue, 0)
	if q < 0 then
		q = 0
	end
	if q > st.maxQueue then
		st.maxQueue = q
	end
	local frac = 0
	if st.maxQueue > 0 then
		frac = clamp01(1 - q / st.maxQueue)
	elseif imageDone then
		frac = 1
	end
	local target = 0.05
	if imageDone then
		target = target + 0.15
	end
	target = target + 0.5 * frac
	if input.gameLoaded == true then
		target = target + 0.2
	end
	if input.character == true then
		target = target + 0.1
	end
	local creep = math.min(0.8, st.elapsed / cfg.maxShow * 0.8) -- plancher lié au temps : la barre ne reste jamais figée
	if creep > target then
		target = creep
	end
	if target > 1 then
		target = 1
	end
	if st.phase == "show" then
		if (input.character == true and st.elapsed >= cfg.minShow) or st.elapsed >= cfg.maxShow then
			st.phase = "fade"
			st.fadeT = 0
		end
	end
	local rate = cfg.smooth
	if st.phase ~= "show" then
		target = 1
		rate = rate * 3
	end
	local nxt = st.shown + (target - st.shown) * (1 - math.exp(-rate * dt))
	if nxt > st.shown then
		st.shown = clamp01(nxt)
	end
	if st.phase == "fade" then
		st.fadeT = st.fadeT + dt
		if st.fadeT > cfg.hold then
			st.alpha = clamp01((st.fadeT - cfg.hold) / cfg.fade)
		end
		if st.fadeT >= cfg.hold + cfg.fade then
			st.phase = "done"
			st.done = true
			st.alpha = 1
			st.shown = 1
		end
	end
	return st
end

return LoadingPlan
]]></ProtectedString></Properties></Item></Item>
<Item class="ReplicatedStorage" referent="RBX61"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX60"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Config
-- Toutes les données d'équilibrage du jeu. Modifie ici, rien d'autre à toucher.
local Config = {}

Config.PLOT_COUNT = 5 -- nombre de bases (= Config.Game.MaxPlayers : une partie accueille 5 joueurs au plus)

---------------------------------------------------------------- Architecture hub + parties
-- Deux lieux : le HUB (petit lieu léger : zones de lancement 1 à 5 joueurs, parties des amis) et le lieu de JEU (la partie, 5 joueurs max).
-- Le rôle d'un serveur se déduit de game.PlaceId (Config.Game.roleFor). Identifiants = LIEUX (place ids), pas des univers.
-- Les deux lieux appartiennent à la MÊME expérience « Jeu des oeufs » (univers 10776613087) : la réservation de serveur privé
-- (TeleportService) et le registre MemoryStore du hub fonctionnent donc entre eux. Si la réservation échoue malgré tout, le code essaie
-- les replis de `Fallbacks` (serveur public) puis prévient le joueur. Hub = lieu de départ de l'expérience.
Config.Game = {
	Places = { hub = 115261336085924, game = 87012762353093 },
	MaxPlayers = 5, -- plafond absolu d'un serveur de jeu (réglage Creator Dashboard : Max Players = 5 aussi)
	Sizes = { 1, 2, 3, 4, 5 }, -- tailles de partie proposées par les zones du hub
	CountdownFull = 5, -- secondes avant le départ d'un groupe complet
	PartialWait = 25, -- secondes après le premier arrivé avant de lancer un groupe incomplet (la partie reste ouverte aux amis)
	SoloCountdown = 3,
	PartyTTL = 7200, -- une partie du registre plus vieille que ça n'est plus proposée
	Fallbacks = { "reserved", "public" }, -- ordre des méthodes de téléportation essayées
	LateJoinGrace = 90, -- secondes de protection des œufs d'un joueur qui arrive dans une partie déjà commencée
	RegistryName = "ChipeParties",
}

function Config.Game.roleFor(placeId)
	if placeId == Config.Game.Places.hub then
		return "hub"
	elseif placeId == Config.Game.Places.game then
		return "game"
	end
	return "unknown" -- place non publiée (Studio) : chaque projet lance son propre code
end

-- LOT 9 (A.1) : 10 raretés. Les anciennes (1 Commun .. 6 Cosmique) sont migrées par Config.TIER_MIGRATE (Cosmique devient « Ultra Rare »).
Config.TIERS = {
	{ name = "Commun", color = Color3.fromRGB(220, 220, 230), color2 = Color3.fromRGB(142, 147, 160) },
	{ name = "Peu commun", color = Color3.fromRGB(60, 220, 60), color2 = Color3.fromRGB(30, 140, 40) },
	{ name = "Rare", color = Color3.fromRGB(46, 139, 255), color2 = Color3.fromRGB(20, 80, 180) },
	{ name = "Épique", color = Color3.fromRGB(155, 77, 255), color2 = Color3.fromRGB(74, 26, 140) },
	{ name = "Légendaire", color = Color3.fromRGB(255, 194, 26), color2 = Color3.fromRGB(184, 134, 11), crown = true },
	{ name = "Mythique", color = Color3.fromRGB(224, 32, 46), color2 = Color3.fromRGB(26, 16, 20), chains = true },
	{ name = "Ultra Rare", color = Color3.fromRGB(111, 214, 255), color2 = Color3.fromRGB(42, 127, 212), facets = true },
	{ name = "Secret", color = Color3.fromRGB(255, 120, 200), color2 = Color3.fromRGB(10, 10, 18), rainbow = true },
	{ name = "Exclusif", color = Color3.fromRGB(242, 242, 242), color2 = Color3.fromRGB(20, 20, 20), crown = true },
	{ name = "Divin", color = Color3.fromRGB(255, 243, 176), color2 = Color3.fromRGB(255, 255, 255), wings = true },
}
Config.TIER_COUNT = 10
-- Ancien indice de rareté (profils v10 et antérieurs, 6 raretés) -> nouvel indice (lot 9).
Config.TIER_MIGRATE = { 1, 3, 4, 5, 6, 7 }
-- Ancien indice (1..6) d'une rareté du lot 9 (inverse de TIER_MIGRATE ; une rareté nouvelle prend l'ancienne inférieure). Sert aux migrations et aux tests.
function Config.oldTier(t)
	local best = 1
	for old, new in ipairs(Config.TIER_MIGRATE) do
		if type(t) == "number" and new <= t then
			best = old
		end
	end
	return best
end
-- Seuils d'effets indexés par rareté (remplacent tous les `tier >= N` codés en dur ; test grep dans tests/run.luau).
-- shine : brillance du bandeau ; announce : annonce serveur, grande révélation ; aura : cercle runique ; pillar : pilier de lumière ;
-- beam : faisceau de portage ; serverBanner / globalBanner : annonces (lot 10) ; rareCine : cinématique « premier rare » ; belt2s : anti-monopole du tapis ;
-- ability : capacité animée des pets ; secret : son et effet « secret » de la rareté ; fullCine : grande cinématique d'éclosion.
Config.TIER_GATE = { shine = 4, announce = 5, aura = 5, pillar = 6, beam = 5, serverBanner = 7, globalBanner = 8, rareCine = 5, belt2s = 5, ability = 4, secret = 7, fullCine = 7 }
function Config.tierAtLeast(tier, gate)
	local g = Config.TIER_GATE[gate]
	return type(tier) == "number" and tier == tier and type(g) == "number" and tier >= g
end
-- Rareté « publiée » : au moins une espèce de Config.PETS (le lot 11 ajoutera les espèces des raretés 2, 8, 9, 10). Une rareté vide n'apparaît
-- jamais : ses poids sont reportés sur la rareté publiée inférieure (A.3), un œuf donné en récompense prend la rareté publiée inférieure.
function Config.tierLive(tier)
	for _, p in ipairs(Config.PETS) do
		if p.tier == tier then
			return true
		end
	end
	return false
end
-- A5 : espèces d'événement et de saison (champ `event` du bestiaire : « halloween », « noel », « saison1 »...). Elles ne font PAS partie du tirage normal :
-- une telle espèce n'est tirable que si son étiquette est dans `open` (ensemble { [étiquette] = true } calculé par le serveur avec
-- Rewards.openSpeciesEvents : événement limité de Config.EVENTS_CAL en cours, saison en cours). open = nil : aucune fenêtre ouverte.
-- tierLive reste statique (rareté publiée) ; tierOpen dit si la rareté a au moins une espèce tirable MAINTENANT (boutique, plumes).
function Config.speciesOpen(p, open)
	local def = type(p) == "number" and Config.PETS[p] or nil
	if type(def) ~= "table" then
		return false
	end
	if def.event == nil then
		return true
	end
	return type(open) == "table" and open[def.event] == true
end
-- Indices des espèces tirables d'une rareté (ordre de Config.PETS).
function Config.speciesPool(tier, open)
	local out = {}
	for i, p in ipairs(Config.PETS) do
		if p.tier == tier and Config.speciesOpen(i, open) then
			out[#out + 1] = i
		end
	end
	return out
end
function Config.tierOpen(tier, open)
	return #Config.speciesPool(tier, open) > 0
end
-- Rareté effective d'un tirage : la rareté elle-même si elle a une espèce tirable, sinon la plus haute rareté inférieure qui en a une
-- (seul cas : œuf Exclusif dont aucune fenêtre n'est ouverte, par exemple éclos après la fin de l'événement).
function Config.poolTier(tier, open)
	local t = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), Config.TIER_COUNT))
	while t > 1 and not Config.tierOpen(t, open) do
		t = t - 1
	end
	return t
end
-- Plus haute rareté publiée <= tier (1 au pire).
function Config.liveEggTier(tier)
	local t = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), Config.TIER_COUNT))
	while t > 1 and not Config.tierLive(t) do
		t = t - 1
	end
	return t
end
-- Rareté publiée immédiatement au-dessus (amélioration d'un cran), ou nil.
function Config.nextLiveTier(tier)
	for t = tier + 1, Config.TIER_COUNT do
		if Config.tierLive(t) then
			return t
		end
	end
	return nil
end
-- Rang d'une rareté parmi les raretés publiées (1..6 tant que seules les 18 espèces historiques existent : même rang que l'ancien indice).
function Config.tierRank(tier)
	local r = 0
	for t = 1, math.min(tier, Config.TIER_COUNT) do
		if Config.tierLive(t) then
			r = r + 1
		end
	end
	return math.max(1, r)
end
-- Poids effectifs d'une table de 10 poids : chaque rareté non publiée reporte son poids sur la rareté publiée inférieure.
function Config.foldWeights(w)
	local out = {}
	for i = 1, Config.TIER_COUNT do
		out[i] = 0
	end
	for i = 1, Config.TIER_COUNT do
		local x = w[i] or 0
		if x > 0 then
			local j = Config.liveEggTier(i)
			out[j] = out[j] + x
		end
	end
	return out
end
-- REGLE DE DESIGN (1) : fourchette de revenu par seconde de chaque rareté (avant taille et mutation). min(r+1) >= 1,8 x max(r) (testé),
-- toute espèce de la rareté est dans sa fourchette (testé). Les espèces du lot 11 devront s'y tenir.
Config.INCOME_RANGE = { { 1, 2 }, { 3.6, 4.1 }, { 7.5, 15 }, { 30, 75 }, { 150, 420 }, { 800, 3000 }, { 6000, 26000 }, { 50000, 120000 }, { 220000, 300000 }, { 550000, 900000 } }
Config.INCOME_GROWTH_MIN = 1.8
-- Prix et durées calibrés avec la simulation tests/Economy.lua (joueur-robot) : ~15 pièces/s après 1 min, œuf Rare vers 2 min,
-- Épique vers 5-8 min, Légendaire vers 15-20 min, Mythique après ~1 h, Cosmique après plusieurs heures ; première renaissance vers 1 h.
Config.START_COINS = 50
Config.FIRST_EGG_SECONDS = 12 -- lot 9 : l'œuf de départ (gratuit) éclot en 12 s (cible : première éclosion entre 10 et 15 s)
Config.EGG_PRICE = { 45, 99, 220, 26000, 7500000, 609975778, 42933105815, 75000000000, 0, 1800000000000 } -- lot 9 : 10 raretés recalibrées (tests/Economy.lua, tools/sim_economy.py) ; Exclusif (9) jamais en pièces ; lot 16 : Mythique et Ultra Rare réajustés (RYTHME_NOTES.md)
-- Lot 8A (B.3) : la boutique vend les raretés 1 à SHOP_MAX_TIER ; Mythique et Cosmique ne s'achètent qu'au tapis du marché (rareté visible, prix x 0,6).
Config.SHOP_MAX_TIER = 6 -- lot 9 : la boutique vend jusqu'au Mythique (sans lui, la maison stagnait entre 1 et 3 jours de jeu) ; Ultra Rare et au-delà : tapis seulement
Config.HATCH = { 18, 20, 30, 106.14, 450, 527, 560, 600, 600, 900 } -- secondes (lot 9 : recalibrées ; l'œuf de départ éclot en Config.FIRST_EGG_SECONDS ; lot 16 : Épique, Mythique, Ultra Rare)

-- tier, emoji (UI), nom, revenu/s, couleur du modèle 3D, oreilles, extra
Config.PETS = {
