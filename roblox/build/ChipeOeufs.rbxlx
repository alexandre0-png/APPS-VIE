	lbl.Text = ""
	lbl.Active = false
	lbl.Parent = dbg
	pcall(function()
		dbg.Parent = player:WaitForChild("PlayerGui")
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F3 then
				dbg.Enabled = not dbg.Enabled
			end
		end)
	end)
	task.spawn(function()
		local frames, t0 = 0, os.clock()
		local conn = RunService.RenderStepped:Connect(function()
			frames += 1
		end)
		while conn.Connected do
			task.wait(0.5)
			if dbg.Enabled then
				local now = os.clock()
				local fps = frames / math.max(0.001, now - t0)
				frames, t0 = 0, now
				local ping = "?"
				pcall(function()
					ping = string.format("%d", game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
				end)
				lbl.Text = string.format("FPS %d · ping %s ms", math.floor(fps + 0.5), ping)
			else
				frames, t0 = 0, os.clock()
			end
		end
	end)
end
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX27"><Properties><string name="Name">Animations</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Animations
-- Animations locales (aucun coût réseau). Chaque animation est activable dans Config.Animations et exécutée par Easing.guard :
-- sous pcall, et désactivée pour la session si elle lève une erreur. Les valeurs (courbes, phases, confettis) viennent du module
-- pur Easing, testé hors de Roblox. Aucune animation n'est nécessaire au gameplay.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Easing = require(Shared:WaitForChild("Easing"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local failed = {}
local function run(name, fn)
	return Easing.guard(Config.animEnabled, failed, name, fn, function(n, err)
		warn("[Animations] « " .. n .. " » désactivée pour cette session après une erreur : " .. tostring(err))
	end)
end

local state = nil
Remotes:WaitForChild("State").OnClientEvent:Connect(function(snap)
	state = snap
end)

---------------------------------------------------------------- Œufs : tremblement, blanchissement, rebond, squash & stretch
-- Les œufs à animer (pads, nids) portent le tag EggShake ; l'attribut Ends (heure d'éclosion) n'existe que sur les pads.
local eggData = setmetatable({}, { __mode = "k" })

local function eggInfo(egg)
	local d = eggData[egg]
	if not d then
		d = {
			base = egg.CFrame,
			color = egg.Color,
			mesh = egg:FindFirstChildOfClass("SpecialMesh"),
			phase = (egg.Position.X * 0.37 + egg.Position.Z * 0.51) % 3.2, -- désynchronise les rebonds
		}
		eggData[egg] = d
	end
	return d
end

RunService.RenderStepped:Connect(function()
	if not (Config.animEnabled("eggShake") or Config.animEnabled("eggBounce") or Config.animEnabled("hatchSquash")) then
		return
	end
	local eggs = CollectionService:GetTagged("EggShake")
	if #eggs == 0 then
		return
	end
	local now, t = os.time(), os.clock()
	for _, egg in ipairs(eggs) do
		local d = eggInfo(egg)
		d.y, d.rx, d.rz, d.sx, d.sy, d.whiten = 0, 0, 0, 1, 1, 0
		local ends = egg:GetAttribute("Ends")
		d.left = ends and (ends - now) or 99
	end
	run("eggShake", function() -- tremble les 4 dernières secondes, blanchit dans la dernière seconde et demie
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left < 4 then
				local a = (4 - d.left) / 4
				d.rx = math.sin(t * 29) * 0.08 * a
				d.rz = math.sin(t * 35) * 0.12 * a
				d.whiten = d.left < 1.5 and (1.5 - d.left) / 1.5 * (0.5 + 0.5 * math.sin(t * 22)) or 0
			end
		end
	end)
	run("eggBounce", function() -- petit saut périodique tant que l'éclosion n'est pas imminente
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left >= 4 then
				d.y, d.sx, d.sy = Easing.eggHop(t, d.phase, 0.6)
			end
		end
	end)
	run("hatchSquash", function() -- l'œuf pulse (écrasé puis étiré) dans les 2 dernières secondes : vrai squash & stretch non uniforme
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			if d.left < 2 then
				local sx, sy = Easing.squashStretch((t * 1.6) % 1, 0.18 + 0.2 * (2 - d.left) / 2)
				d.sx, d.sy = d.sx * sx, d.sy * sy
			end
		end
	end)
	pcall(function()
		for _, egg in ipairs(eggs) do
			local d = eggData[egg]
			egg.CFrame = d.base * CFrame.new(0, d.y, 0) * CFrame.Angles(d.rx, 0, d.rz)
			if d.mesh then
				d.mesh.Scale = Vector3.new(d.sx, d.sy, d.sx)
			end
			egg.Color = d.color:Lerp(Color3.new(1, 1, 1), d.whiten)
		end
	end)
end)

-- Halos des œufs (anneau du légendaire qui tourne, sphère du glitch qui scintille) : modification locale de la soudure et de la transparence.
local haloBase = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("eggHalo", function()
		local t = os.clock()
		for _, halo in ipairs(CollectionService:GetTagged("EggHalo")) do
			local weld = halo:FindFirstChild("HaloWeld")
			if weld then
				local base = haloBase[halo]
				if not base then
					base = weld.C0
					haloBase[halo] = base
				end
				local spin = halo:GetAttribute("Spin") or 0
				local off = CFrame.new()
				local trans = halo:GetAttribute("BaseT") or 0.5
				if spin ~= 0 then
					off = CFrame.Angles(0, t * spin, 0)
				end
				if halo:GetAttribute("Flicker") then
					local k = math.floor(t * 10)
					local r = (math.sin(k * 12.9898 + weld.Part0.Position.X) * 43758.5453) % 1
					if r > 0.8 then
						off = CFrame.new((r - 0.9) * 2.4, 0, 0)
					end
					if r > 0.65 then
						trans = math.min(1, trans + 0.3)
					end
				end
				weld.C0 = off * base
				halo.Transparency = trans
			end
		end
	end)
end)

-- Aura des raretés élevées : sur appareil tactile sans clavier (ou Config.REVEAL.forceReduced), le pilier de lumière et la moitié des particules sont coupés.
local UserInputService = game:GetService("UserInputService")
local auraTrimmed = setmetatable({}, { __mode = "k" })
task.spawn(function()
	while true do
		task.wait(0.5)
		run("auraReduced", function()
			if Config.REVEAL.forceReduced or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
				for _, a in ipairs(CollectionService:GetTagged("AuraFx")) do
					if not auraTrimmed[a] then
						auraTrimmed[a] = true
						for _, d in ipairs(a:GetChildren()) do
							if d:IsA("Beam") then
								d.Enabled = false
							elseif d:IsA("ParticleEmitter") then
								d.Rate = d.Rate / 2
							end
						end
					end
				end
			end
		end)
	end
end)

-- Marqueurs d'éléments interactifs (nids, secrets) : l'anneau doré pulse doucement.
RunService.RenderStepped:Connect(function()
	run("interactMarkers", function()
		local t = os.clock()
		for _, m in ipairs(CollectionService:GetTagged("Interactive")) do
			local base = m:GetAttribute("BaseT") or 0.35
			m.Transparency = math.clamp(base + math.sin(t * 3 + m.Position.X * 0.1) * 0.25, 0, 1)
		end
	end)
end)

-- Œufs portés : ils rebondissent pendant la course (modification locale de la soudure).
local carryBase = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("eggBounce", function()
		local t = os.clock()
		for _, egg in ipairs(CollectionService:GetTagged("CarryEgg")) do
			local weld = egg:FindFirstChildOfClass("Weld")
			if weld then
				local base = carryBase[egg]
				if not base then
					base = weld.C0
					carryBase[egg] = base
				end
				local hum = egg.Parent and egg.Parent:FindFirstChildOfClass("Humanoid")
				local moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
				weld.C0 = base * CFrame.new(0, Easing.runBounce(t + base.Y * 0.4, moving), 0)
			end
		end
	end)
end)

---------------------------------------------------------------- Pets : apparition (squash & stretch), onde de choc
-- Approximation : les modèles de pets sont faits de plusieurs Parts, on ne peut donc les mettre à l'échelle que de façon uniforme.
-- Le squash & stretch du pet est rendu par une échelle uniforme qui suit la courbe verticale ; celui de l'œuf (avant éclosion) est réel.
CollectionService:GetInstanceAddedSignal("PopIn"):Connect(function(model)
	local born = model:GetAttribute("Born")
	if not born or workspace:GetServerTimeNow() - born > 2 then
		return
	end
	local squash = Config.animEnabled("hatchSquash")
	if not (squash or Config.animEnabled("popIn")) then
		return
	end
	task.spawn(function()
		run(squash and "hatchSquash" or "popIn", function()
			local t0 = os.clock()
			local base = model:GetScale() -- échelle posée par le serveur (hauteur cible) : l'animation en est relative, jamais absolue
			while model.Parent do
				local a = math.min(1, (os.clock() - t0) / 0.7)
				model:ScaleTo(base * Easing.popScale(a, squash)) -- plafonné : le pet n'apparaît jamais plus gros que nature
				if a >= 1 then
					model:ScaleTo(base)
					break
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end)
end)

CollectionService:GetInstanceAddedSignal("Shockwave"):Connect(function(ring)
	run("shockwave", function()
		local big = ring:GetAttribute("Big")
		local d = big and 40 or 22
		TweenService:Create(ring, TweenInfo.new(big and 0.7 or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, d, d), Transparency = 1 }):Play()
	end)
end)

---------------------------------------------------------------- Récolte : l'œuf s'envole en arc vers le joueur
CollectionService:GetInstanceAddedSignal("FlyEgg"):Connect(function(egg)
	local target = Players:GetPlayerByUserId(egg:GetAttribute("Target") or 0)
	local start = egg:GetAttribute("Start")
	if not (target and start) then
		return
	end
	local baseSize = egg.Size
	task.spawn(function()
		run("harvest", function()
			local t0 = os.clock()
			while egg.Parent do
				local a = math.min(1, (os.clock() - t0) / 0.4)
				local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if not root then
					break
				end
				local e = a * a * (3 - 2 * a)
				local pos = start:Lerp(root.Position + Vector3.new(0, 4, 0), e) + Vector3.new(0, math.sin(a * math.pi) * 4, 0)
				egg.CFrame = CFrame.new(pos)
				egg.Size = baseSize * (1 - 0.6 * a)
				if a >= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
			if egg.Parent then
				egg.Transparency = 1
			end
		end)
	end)
end)

---------------------------------------------------------------- Visage des pets : clignement, regard, bouche
-- Paupières (LidL/LidR) et bouche (Mouth) sont des Parts du modèle ; les yeux se déplacent légèrement. Seuls les pets proches de la
-- caméra sont animés, au plus MAX_FACES par image (tourniquet), pour rester léger avec beaucoup de joueurs.
local MAX_FACES = 24
local FACE_RANGE = 70
local faceCache = setmetatable({}, { __mode = "k" })
local faceCursor = 0

local function facePart(body, model, name)
	local p = model:FindFirstChild(name)
	if p then
		return { part = p, rel = body.CFrame:ToObjectSpace(p.CFrame) }
	end
	return nil
end

local function faceOf(model)
	local c = faceCache[model]
	if c then
		return c
	end
	local body = model.PrimaryPart
	if not body then
		return nil
	end
	c = {
		body = body,
		R = body.Size.X / 2,
		seed = model:GetAttribute("Seed") or 0,
		eyeL = facePart(body, model, "EyeL"), eyeR = facePart(body, model, "EyeR"),
		shineL = facePart(body, model, "ShineL"), shineR = facePart(body, model, "ShineR"),
		lidL = facePart(body, model, "LidL"), lidR = facePart(body, model, "LidR"),
		mouth = facePart(body, model, "Mouth"),
		lidShown = false, lastMouth = 0,
	}
	if c.mouth then
		c.mouthSize = c.mouth.part.Size
	end
	faceCache[model] = c
	return c
end

RunService.RenderStepped:Connect(function()
	if not (Config.animEnabled("petBlink") or Config.animEnabled("petLook") or Config.animEnabled("petMouth")) then
		return
	end
	local cam = workspace.CurrentCamera
	local models = CollectionService:GetTagged("PetFace")
	if not cam or #models == 0 then
		return
	end
	local camPos, nowServer, t = cam.CFrame.Position, workspace:GetServerTimeNow(), os.clock()
	local near = {}
	for _, m in ipairs(models) do
		local body = m.PrimaryPart
		if body and (body.Position - camPos).Magnitude < FACE_RANGE then
			local born = m:GetAttribute("Born")
			if not born or nowServer - born > 1.2 then -- pas pendant l'apparition (le modèle change d'échelle)
				near[#near + 1] = m
			end
		end
	end
	local list = near
	if #near > MAX_FACES then
		list = {}
		for k = 0, MAX_FACES - 1 do
			list[#list + 1] = near[(faceCursor + k) % #near + 1]
		end
		faceCursor = (faceCursor + MAX_FACES) % #near
	end
	run("petBlink", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c and c.lidL and c.lidR then
				local closed = Easing.blinkOpenness(t, c.seed) < 0.45
				if closed ~= c.lidShown then
					c.lidShown = closed
					c.lidL.part.Transparency = closed and 0 or 1
					c.lidR.part.Transparency = closed and 0 or 1
				end
			end
		end
	end)
	run("petLook", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c then
				local dx, dy = Easing.look(t, c.seed)
				local off = CFrame.new(dx * 0.06 * c.R, dy * 0.05 * c.R, 0)
				local base = c.body.CFrame
				for _, key in ipairs({ "eyeL", "eyeR", "shineL", "shineR" }) do
					local e = c[key]
					if e then
						e.part.CFrame = base * e.rel * off
					end
				end
			end
		end
	end)
	run("petMouth", function()
		for _, m in ipairs(list) do
			local c = faceOf(m)
			if c and c.mouth then
				local open = Easing.mouthOpen(t, c.seed)
				if open ~= c.lastMouth then
					c.lastMouth = open
					local sz = c.mouthSize
					c.mouth.part.Size = Vector3.new(sz.X, sz.Y * (1 + open * 2.5), sz.Z)
					c.mouth.part.CFrame = c.body.CFrame * c.mouth.rel * CFrame.new(0, -open * 0.04 * c.R, 0)
				end
			end
		end
	end)
end)

---------------------------------------------------------------- Mère Poule : elle picore (la tête pivote autour du cou)
local henCache = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	run("hen", function()
		local t = os.clock()
		for _, model in ipairs(CollectionService:GetTagged("Hen")) do
			local body = model.PrimaryPart
			if body then
				local c = henCache[model]
				if not c then
					c = { parts = {}, seed = model:GetAttribute("Seed") or 0 }
					for _, name in ipairs({ "HenHead", "HenComb", "HenBeak", "HenWattle", "HenEyeL", "HenEyeR" }) do
						local p = model:FindFirstChild(name)
						if p then
							c.parts[#c.parts + 1] = { part = p, rel = body.CFrame:ToObjectSpace(p.CFrame) }
						end
					end
					henCache[model] = c
				end
				local neck = CFrame.new(0, 1.3, -1.2) -- pivot du cou (repère du corps)
				local rot = neck * CFrame.Angles(-Easing.peck(t, c.seed) * 0.7, 0, 0) * neck:Inverse()
				local base = body.CFrame
				for _, e in ipairs(c.parts) do
					e.part.CFrame = base * rot * e.rel
				end
			end
		end
	end)
end)

---------------------------------------------------------------- Barrières de zone (portails) : pulsation et dissolution à l'ouverture
local gateState = setmetatable({}, { __mode = "k" })

local function setGateOpen(gate)
	gate.CanCollide = false
	gate.Transparency = 1
	local lbl = gate:FindFirstChild("Label")
	if lbl then
		lbl.Enabled = false
	end
	gateState[gate] = "open"
end

local function openGateAnimated(gate)
	gateState[gate] = "opening"
	gate.CanCollide = false -- on peut passer pendant que la barrière se dissout
	local started = run("zones", function()
		local lbl = gate:FindFirstChild("Label")
		if lbl then
			lbl.Enabled = false
		end
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 255, 255))
		sparks.Rate = 0
		sparks.Lifetime = NumberRange.new(0.8, 1.6)
		sparks.Speed = NumberRange.new(10, 26)
		sparks.SpreadAngle = Vector2.new(180, 180)
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
		sparks.Parent = gate
		sparks:Emit(90)
		Debris:AddItem(sparks, 2.5)
		local tween = TweenService:Create(gate, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1, Size = gate.Size * 1.12 })
		tween.Completed:Connect(function()
			pcall(setGateOpen, gate)
		end)
		tween:Play()
	end)
	if not started then
		setGateOpen(gate) -- animation désactivée ou en erreur : ouverture immédiate
	end
end

RunService.RenderStepped:Connect(function()
	if not state then
		return
	end
	local gates = CollectionService:GetTagged("ZoneGate")
	if #gates == 0 then
		return
	end
	local t = os.clock()
	for _, gate in ipairs(gates) do
		local rival = gate:GetAttribute("Rival") or 0
		local gs = gateState[gate]
		if Config.zoneUnlocked(state.story.ch, rival) then
			if gs == nil or not Config.animEnabled("zones") then
				if gs ~= "open" then
					setGateOpen(gate) -- déjà ouverte à l'arrivée (ou animations coupées) : pas de mise en scène
				end
			elseif gs == "closed" then
				openGateAnimated(gate)
			end
		else
			if gs ~= "closed" then
				gate.CanCollide = true
				local lbl = gate:FindFirstChild("Label")
				if lbl then
					lbl.Enabled = true
				end
				gateState[gate] = "closed"
			end
			if not run("zones", function()
				gate.Transparency = 0.5 + 0.2 * Easing.gatePulse(t + rival, 2.2)
			end) then
				gate.Transparency = 0.6
			end
		end
	end
end)

---------------------------------------------------------------- Récompenses : confettis stylisés ; prise d'œuf / capture : secousse du champ de vision
local fx = Instance.new("ScreenGui")
fx.Name = "ChipeFX"
fx.ResetOnSpawn = false
fx.IgnoreGuiInset = true
fx.DisplayOrder = 50
fx.Parent = player:WaitForChild("PlayerGui")

local function uiConfetti(burst)
	for i = 1, burst.count do
		local p = Easing.confettiParticle(i, burst.count, burst)
		local f = Instance.new("Frame")
		f.Size = UDim2.fromOffset(p.w, p.h)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.4)
		f.BackgroundColor3 = Color3.fromHSV(p.hue, 0.75, 1)
		f.BorderSizePixel = 0
		f.Rotation = (i * 37) % 360
		f.Parent = fx
		local dx = math.cos(p.angle) * p.speed * burst.life * 0.5
		local dy = math.sin(p.angle) * p.speed * burst.life * 0.5 + 520 * burst.life * burst.life * 0.5 -- + gravité
		TweenService:Create(f, TweenInfo.new(burst.life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, dx, 0.4, dy),
			Rotation = f.Rotation + p.spin * burst.life,
			BackgroundTransparency = 1,
		}):Play()
		Debris:AddItem(f, burst.life + 0.1)
	end
end

local kicking = false
local function fovKick(kind)
	local k = Easing.FOV_KICK[kind]
	local cam = workspace.CurrentCamera
	if not k or not cam or kicking then
		return
	end
	kicking = true
	TweenService:Create(cam, TweenInfo.new(k.time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { FieldOfView = cam.FieldOfView + k.delta }):Play()
	task.delay(k.time * 2 + 0.05, function()
		kicking = false
	end)
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(_msg, sfx)
	local burst = Easing.rewardBurst(sfx)
	if burst then
		run("reward", function()
			uiConfetti(burst)
		end)
	end
	if sfx == "steal" or sfx == "caught" then
		run("characterPop", function()
			fovKick(sfx)
		end)
	end
end)

Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	local def = Config.PETS[info.p]
	if def and (def.tier >= 4 or info.m > 1 or info.s >= 4) then
		run("reward", function()
			uiConfetti(Easing.REWARD.rare)
		end)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX28"><Properties><string name="Name">Cinematics</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Cinematics
-- Cinématiques courtes, aux moments clés seulement : intro (la ferme, Mère Poule, les œufs, le but) et mini tutoriel au premier lancement,
-- première zone débloquée, premier pet rare. Toutes skippables (bouton, Entrée, manette B), réglables dans Config.Cinematics, exécutées
-- sous pcall (Easing.guard), et JAMAIS bloquantes : le joueur garde le contrôle de son personnage, le jeu continue, la caméra est
-- restituée quoi qu'il arrive (fin, skip, mort, attaque, erreur, délai de sécurité). La logique (séquences, durées, skip, reprise, file)
-- est dans le module pur Cinema, testé hors de Roblox.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Easing = require(Shared:WaitForChild("Easing"))
local Cinema = require(Shared:WaitForChild("Cinema")).new(Easing)
local CinematicKitMod = require(Shared:WaitForChild("CinematicKit"))
local Kit = CinematicKitMod.new(Easing, Cinema)
local Castle = require(Shared:WaitForChild("Castle"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RAction = Remotes:WaitForChild("Action")

local BIND_NAME = "ChipeCine"
local director = Cinema.director()
local plans = {} -- id -> { seq, resolved = { CFrame par plan }, startedAt }
local activeId = nil
local saved = nil -- caméra du joueur avant la cinématique
local bound = false
local state = nil
local lastCh = nil
local failed = {}

---------------------------------------------------------------- Interface : barres de cinéma, légende, bouton Passer
local gui = Instance.new("ScreenGui")
gui.Name = "ChipeCine"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 60
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local function bar(anchorY, height)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0, anchorY)
	f.Position = UDim2.fromScale(0, anchorY)
	f.Size = UDim2.fromScale(1, height)
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.BackgroundTransparency = 0.1
	f.BorderSizePixel = 0
	f.Parent = gui
	return f
end
local topBar, bottomBar = bar(0, 0.09), bar(1, 0.2)

local caption = Instance.new("TextLabel")
caption.BackgroundTransparency = 1
caption.Size = UDim2.new(0.84, 0, 0.8, 0)
caption.AnchorPoint = Vector2.new(0.5, 0.5)
caption.Position = UDim2.fromScale(0.5, 0.5)
caption.Font = Enum.Font.GothamBold
caption.TextColor3 = Color3.fromRGB(255, 244, 220)
caption.TextStrokeTransparency = 0.5
caption.TextWrapped = true
caption.TextScaled = true
caption.Text = ""
caption.Parent = bottomBar
local limit = Instance.new("UITextSizeConstraint")
limit.MaxTextSize = 28
limit.MinTextSize = 12
limit.Parent = caption

local header = Instance.new("TextLabel")
header.BackgroundTransparency = 1
header.Position = UDim2.fromOffset(16, 0)
header.Size = UDim2.new(0.5, 0, 1, 0)
header.Font = Enum.Font.GothamBold
header.TextSize = 18
header.TextXAlignment = Enum.TextXAlignment.Left
header.TextColor3 = Color3.fromRGB(255, 214, 120)
header.Text = ""
header.Parent = topBar

local function button(text, xOffset, width)
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Position = UDim2.new(1, xOffset, 0.5, 0)
	b.Size = UDim2.fromOffset(width, 34)
	b.BackgroundColor3 = Color3.fromRGB(255, 210, 63)
	b.TextColor3 = Color3.fromRGB(43, 34, 0)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.Text = text
	b.Parent = topBar
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = b
	return b
end
local skipBtn = button("Passer ▶", -12, 110)
local skipAllBtn = button("Tout passer", -132, 120)
skipAllBtn.BackgroundColor3 = Color3.fromRGB(75, 91, 81)
skipAllBtn.TextColor3 = Color3.fromRGB(244, 255, 246)

-- Carton de titre au centre (cinématiques à titre : « 🏰 Le Château », « ✦ SECRET ✦ »), jamais cliquable.
local titleCard = Instance.new("TextLabel")
titleCard.BackgroundTransparency = 1
titleCard.AnchorPoint = Vector2.new(0.5, 0.5)
titleCard.Position = UDim2.fromScale(0.5, 0.42)
titleCard.Size = UDim2.fromScale(0.8, 0.14)
titleCard.Font = Enum.Font.GothamBlack
titleCard.TextScaled = true
titleCard.TextColor3 = Color3.fromRGB(255, 244, 220)
titleCard.TextStrokeTransparency = 0.3
titleCard.TextTransparency = 1
titleCard.Text = ""
titleCard.Active = false
titleCard.Parent = gui
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MaxTextSize = 54
titleLimit.MinTextSize = 18
titleLimit.Parent = titleCard

local TITLES = { intro = "🎬 Il était une fois…", tutorial = "🎓 Comment jouer", firstZone = "🔓 Nouveau domaine", firstRare = "✨ Pet rare !" }

---------------------------------------------------------------- Caméra : toujours restituée
local function takeCamera()
	local cam = workspace.CurrentCamera
	if cam and not saved then
		saved = { cameraType = cam.CameraType, subject = cam.CameraSubject, fov = cam.FieldOfView }
		cam.CameraType = Enum.CameraType.Scriptable
	end
end

local function giveCameraBack()
	local cam = workspace.CurrentCamera
	if cam and saved then
		cam.CameraType = (saved.cameraType == Enum.CameraType.Scriptable) and Enum.CameraType.Custom or saved.cameraType
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = hum or saved.subject
		if type(saved.fov) == "number" then
			cam.FieldOfView = saved.fov -- le champ de vision d'une cinématique n'est jamais gardé
		end
	end
	saved = nil
end

local function exitCinematic()
	if bound then
		bound = false
		pcall(function()
			RunService:UnbindFromRenderStep(BIND_NAME)
		end)
	end
	pcall(giveCameraBack)
	gui.Enabled = false
	activeId = nil
	plans = {}
end

-- Sortie de secours : quoi qu'il arrive, tout s'arrête et la caméra revient au joueur. Rien n'est considéré comme vu.
local function emergency(reason)
	director.abort()
	exitCinematic()
	if reason then
		warn("[Cinematics] arrêt : " .. tostring(reason))
	end
end

local function markSeen(id)
	pcall(function()
		RAction:FireServer("cineSeen", id)
	end)
end

---------------------------------------------------------------- Ancres de caméra
local function plotCFrame()
	local attr = player:GetAttribute("PlotCF")
	if typeof(attr) == "CFrame" then
		return attr
	end
	local spawn = player.RespawnLocation
	if spawn and spawn:IsA("BasePart") then
		return spawn.CFrame * CFrame.new(0, -1.2, 20) -- le spawn est à (0, 1.2, -20) dans le repère de la base
	end
	return nil
end

local function rivalCF(i)
	local x, z = Config.rivalCenter(i)
	return CFrame.new(x, Config.rivalHeight(i), z)
end

local anchors = {
	arena = function()
		return CFrame.new(0, 0, 0)
	end,
	hen = function()
		local m = CollectionService:GetTagged("Hen")[1]
		local body = m and m.PrimaryPart
		return body and CFrame.new(body.Position.X, 0, body.Position.Z) or nil
	end,
	rival1 = function()
		return rivalCF(1)
	end,
	rival2 = function()
		return rivalCF(2)
	end,
	rival3 = function()
		return rivalCF(3)
	end,
	base = plotCFrame,
	world = function(ctx)
		return ctx and ctx.cf or nil
	end,
	castle = function()
		local x, z = Castle.toWorld(1, 0, 0)
		return CFrame.new(x, 0, z)
	end,
	castle_chest = function()
		local x, z = Castle.toWorld(Castle.ROOMS, 0, Castle.ROOM_LENGTH - 5)
		return CFrame.new(x, 0, z)
	end,
	pad = function(ctx)
		local pc = plotCFrame()
		if not pc or not ctx or not ctx.slot then
			return nil
		end
		local lx, lz = Config.padLocal(ctx.slot)
		return pc * CFrame.new(lx, 1.4, lz)
	end,
}

local function toWorld(acf, v)
	return acf:PointToWorldSpace(Vector3.new(v[1], v[2], v[3]))
end

---------------------------------------------------------------- Mise en scène
local function sparkleAt(position)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = position
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 232, 150), Color3.fromRGB(255, 255, 255))
	e.Rate = 0
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(6, 18)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = p
	p.Parent = workspace
	e:Emit(50)
	Debris:AddItem(p, 3)
end

local function onShot(id, index)
	local plan = plans[id]
	local shot = plan.seq.shots[index]
	caption.Text = shot.text
	caption.TextTransparency = 1
	TweenService:Create(caption, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	header.Text = (TITLES[id] or "🎬") .. "   " .. index .. "/" .. #plan.seq.shots
	if shot.title then
		titleCard.Text = shot.title
		titleCard.TextTransparency = 1
		TweenService:Create(titleCard, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextTransparency = 0 }):Play()
		task.delay(math.max(0.8, shot.dur - 0.5), function()
			TweenService:Create(titleCard, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end)
	end
	if shot.fx == "sparkle" or shot.fx == "sparks" or shot.fx == "crack" or shot.fx == "flash" then
		pcall(sparkleAt, toWorld(plan.resolved[index], shot.look) + Vector3.new(0, 2, 0))
	end
end

local function step()
	local now = os.clock()
	local cur = director.current
	local curPlan = cur and plans[cur.id]
	local tnow = now
	if curPlan and curPlan.kit then
		tnow = curPlan.requestedAt + Kit.virtualElapsed(curPlan.def, now - curPlan.requestedAt) -- le ralenti fait avancer le temps des prises plus lentement
	end
	local id, ev = director.update(tnow)
	if not id then
		exitCinematic()
		return
	end
	if not ev then
		return
	end
	if ev.finished then
		markSeen(id)
		if not director.current then
			exitCinematic()
		end
		return
	end
	local plan = plans[id]
	if not plan then
		return emergency("plan inconnu : " .. tostring(id))
	end
	if activeId ~= id then
		activeId = id
		plan.startedAt = now
	end
	if now - plan.startedAt > (plan.kit and Kit.realTotal(plan.def) or plan.seq.total) + Config.Cinematics.watchdog then
		return emergency("délai de sécurité dépassé")
	end
	if ev.shotChanged then
		onShot(id, ev.shot)
	end
	local cam = workspace.CurrentCamera
	local acf = plan.resolved[ev.shot]
	if plan.kit then
		local shot = plan.seq.shots[ev.shot]
		local kpos, klook, kfov = Kit.cameraAt(shot, ev.progress)
		local off = Kit.shakeOffset(shot, ev.progress, now)
		cam.CFrame = CFrame.lookAt(toWorld(acf, kpos) + Vector3.new(off[1], off[2], off[3]), toWorld(acf, klook))
		cam.FieldOfView = kfov
	else
		local pos, look = Cinema.cameraAt(plan.seq.shots[ev.shot], ev.progress)
		cam.CFrame = CFrame.lookAt(toWorld(acf, pos), toWorld(acf, look))
	end
	skipAllBtn.Visible = #director.queue > 0
end

local function safeStep()
	local ok, err = pcall(step)
	if not ok then
		local id = activeId
		if id then
			failed[id] = true
		end
		emergency(err)
	end
end

local function enter()
	gui.Enabled = true
	skipAllBtn.Visible = false
	takeCamera()
	if not bound then
		bound = true
		RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, safeStep)
	end
end

---------------------------------------------------------------- Lancer, passer
local function warnOnce(name, err)
	warn("[Cinematics] « " .. name .. " » désactivée pour cette session après une erreur : " .. tostring(err))
	emergency()
end

-- Retourne true si la cinématique a démarré ou été mise en file. Ne lève jamais d'erreur.
local function begin(id, def, ctx, chain, kit)
	if failed[id] or not (kit and Config.Cinematics.enabled == true or Config.cineEnabled(id)) then
		return false
	end
	if kit then
		local built = Kit.build(def) -- 8 secondes réelles au plus, prises validées
		if not built then
			return false
		end
		def = built
	end
	local ok, seq = pcall(Cinema.sequence, def)
	if not ok or not seq then
		return false
	end
	local resolved = {}
	for i, shot in ipairs(seq.shots) do
		local f = anchors[shot.anchor]
		local okAnchor, cf = pcall(function()
			return f and f(ctx)
		end)
		if not (okAnchor and cf) then
			return false -- ancre pas encore prête (monde non chargé) : pas de cinématique plutôt qu'un plan cassé
		end
		resolved[i] = cf
	end
	local started = false
	Easing.guard(kit and function()
		return Config.Cinematics.enabled == true
	end or Config.cineEnabled, failed, id, function()
		local result = director.request(id, seq, os.clock(), chain)
		if result == "refused" then
			return
		end
		plans[id] = { seq = seq, resolved = resolved, startedAt = nil, kit = kit == true, def = def, requestedAt = os.clock(), skipOnTap = def.skipOnTap == true }
		started = true
		if result == "playing" then
			enter()
		end
	end, warnOnce)
	return started
end

local function skipCurrent()
	local id = director.skip(os.clock())
	if id then
		markSeen(id)
	end
	if not director.current then
		exitCinematic()
	end
end

local function skipEverything()
	for _, id in ipairs(director.skipAll()) do
		markSeen(id)
	end
	exitCinematic()
end

skipBtn.Activated:Connect(skipCurrent)
skipAllBtn.Activated:Connect(skipEverything)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not director.isActive() then
		return
	end
	-- une cinématique d'éclosion se passe d'un simple tap dans le monde (un tap sur l'interface, par exemple l'inventaire, ne la passe pas et ne la bloque pas)
	local cp = director.current and plans[director.current.id]
	if cp and cp.skipOnTap and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		skipCurrent()
		return
	end
	if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonB then
		skipCurrent()
	end
end)

---------------------------------------------------------------- Abandon : le joueur est attaqué ou meurt
Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(_msg, sfx)
	if (sfx == "caught" or sfx == "hurt") and director.isActive() then
		emergency() -- un gardien ou un voleur s'en prend à lui : retour immédiat au jeu
	end
end)
local function watchCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			emergency()
		end)
	end
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	task.spawn(watchCharacter, player.Character)
end

---------------------------------------------------------------- Déclencheurs (moments clés uniquement)
-- Premier lancement : intro puis mini tutoriel (le tutoriel est mis en file derrière l'intro). Nouveaux joueurs seulement.
local function onFirstState()
	local t0 = os.clock()
	while os.clock() - t0 < 20 and not (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and plotCFrame()) do
		task.wait(0.25)
	end
	task.wait(1.5) -- laisse le jeu s'afficher
	if not state or state.story.ch ~= 0 or state.hatched ~= 0 then
		return
	end
	local playIntro = Config.cineEnabled("intro") and not state.cine.intro
	local playTutorial = Config.cineEnabled("tutorial") and not state.cine.tutorial
	if playIntro then
		begin("intro", Config.CINE.intro, {}, false)
		if playTutorial then
			begin("tutorial", Config.CINE.tutorial, {}, true)
		end
	elseif playTutorial then
		begin("tutorial", Config.CINE.tutorial, {}, false)
	end
end

Remotes:WaitForChild("State").OnClientEvent:Connect(function(snap)
	local first = state == nil
	state = snap
	if first then
		lastCh = snap.story.ch
		task.spawn(onFirstState)
		return
	end
	-- première zone débloquée : le chapitre vient d'atteindre le seuil d'un domaine
	if snap.story.ch > lastCh and not snap.cine.firstZone and snap.carry == 0 then
		for idx, zone in ipairs(Config.ZONES) do
			if zone.chapter > 0 and zone.chapter == snap.story.ch then
				begin("firstZone", Config.cineFirstZone(idx), {}, false)
			end
		end
	end
	lastCh = snap.story.ch
end)

-- Premier pet rare (même critère que les confettis) ; l'emplacement vient du serveur.
Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	if not state or state.cine.firstRare or state.carry > 0 then
		return
	end
	local def = Config.PETS[info.p]
	if not def or not (def.tier >= 4 or info.m > 1 or info.s >= 4) then
		return
	end
	begin("firstRare", Config.cineFirstRare(Config.petName(info.p, info.s, info.m), Config.TIERS[def.tier].name, "+" .. Config.fmt(info.inc) .. "/s."), { slot = info.slot }, false)
end)

---------------------------------------------------------------- Plans du CinematicKit : éclosions, château, alerte des gardiens
-- Suivi du danger : dernier coup reçu, dernière alerte de gardien (poursuite). Aucune cinématique à caméra si le joueur est en danger.
local lastHurtAt, lastAlertAt, alertShown, lastAlertFx, lastHatchCine = -100, -100, 0, nil, -100
local function dangerCtx(ignoreTrapRoom)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local inRoom = false
	if root and not ignoreTrapRoom then
		inRoom = Castle.roomAt(root.Position.X, root.Position.Z) ~= nil
	end
	return {
		hp = player:GetAttribute("Hp"), maxHp = player:GetAttribute("MaxHp"), sinceHit = os.clock() - lastHurtAt,
		chased = os.clock() - lastAlertAt < 8, inTrapRoom = inRoom, dead = not (hum and hum.Health > 0),
	}
end

-- Alerte « ❗ » (gardien ou chevalier qui repère le joueur) : aucun mouvement de caméra ; un à-coup de champ de vision, un carton et un peu de tremblement.
local function alertPunch()
	if not Kit.canAlert(dangerCtx(true), os.clock(), lastAlertFx, alertShown) then
		return
	end
	lastAlertFx = os.clock()
	alertShown += 1
	local A = CinematicKitMod.ALERT
	pcall(function()
		local cam = workspace.CurrentCamera
		local baseFov = cam.FieldOfView
		TweenService:Create(cam, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { FieldOfView = baseFov - A.fovPunch }):Play()
		task.delay(0.12, function()
			TweenService:Create(cam, TweenInfo.new(A.seconds - 0.12, Enum.EasingStyle.Sine), { FieldOfView = baseFov }):Play()
		end)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.3)
		label.Size = UDim2.fromOffset(120, 100)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 80, 70)
		label.TextStrokeTransparency = 0.2
		label.Text = A.title
		label.Active = false
		local g = Instance.new("ScreenGui")
		g.Name = "ChipeAlert"
		g.ResetOnSpawn = false
		g.DisplayOrder = 55
		label.Parent = g
		g.Parent = player:WaitForChild("PlayerGui")
		TweenService:Create(label, TweenInfo.new(A.seconds, Enum.EasingStyle.Quint), { TextTransparency = 1, Size = UDim2.fromOffset(180, 150) }):Play()
		Debris:AddItem(g, A.seconds + 0.2)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then -- tremblement léger (décalage de caméra du personnage), remis à zéro quoi qu'il arrive
			task.spawn(function()
				local t0 = os.clock()
				while os.clock() - t0 < A.seconds and hum.Parent do
					local k = (1 - (os.clock() - t0) / A.seconds) * A.shake * 0.25
					hum.CameraOffset = Vector3.new(math.sin(os.clock() * 60) * k, math.cos(os.clock() * 53) * k, 0)
					task.wait()
				end
				hum.CameraOffset = Vector3.zero
			end)
		end
	end)
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(msg, sfx)
	if sfx == "hurt" or sfx == "caught" then
		lastHurtAt = os.clock()
	elseif sfx == "growl" or sfx == "bark" then
		lastAlertAt = os.clock()
		alertPunch()
	elseif sfx == "fanfare" and Config.cineEnabled("chateau") and Kit.canPlay(dangerCtx(true)) then
		begin("chateau_victoire", CinematicKitMod.PLANS.chateau_victoire, {}, false, true)
	elseif sfx == "event" and type(msg) == "string" and msg:find("Le Château", 1, true) and Config.cineEnabled("chateau") and Kit.canPlay(dangerCtx()) then
		begin("chateau_entree", CinematicKitMod.PLANS.chateau_entree, {}, false, true)
	end
end)

-- Éclosion : commun et rare sans cinématique ; épique court ; légendaire, mythique, cosmique et secret complets ; au plus une toutes les 20 s.
Remotes:WaitForChild("Hatch").OnClientEvent:Connect(function(info)
	local def = Config.PETS[info.p]
	if not def or not Config.cineEnabled("eclosion") or os.clock() - lastHatchCine < 20 or director.isActive() then
		return
	end
	local plan = CinematicKitMod.hatchPlan(def.tier, def.tier >= 6)
	if not plan or not Kit.canPlay(dangerCtx()) then
		return
	end
	if begin(plan.id .. "_" .. tostring(def.tier), plan, { slot = info.slot }, false, true) then
		lastHatchCine = os.clock()
	end
end)

-- Montée de niveau de la base : plan court en orbite autour de la base (jamais en danger ; le premier niveau reçu à la connexion ne déclenche rien).
do
	local lastLevel = nil
	local function onLevel()
		local lv = player:GetAttribute("BaseLevel")
		if type(lv) ~= "number" then
			return
		end
		local previous = lastLevel
		lastLevel = lv
		if previous and lv > previous and Config.cineEnabled("base") and not director.isActive() and Kit.canPlay(dangerCtx()) then
			begin("base_niveau", CinematicKitMod.PLANS.base_niveau, {}, false, true)
		end
	end
	player:GetAttributeChangedSignal("BaseLevel"):Connect(onLevel)
	onLevel()
end

-- Revoir (menu Plus) : événement local déclenché par l'interface.
local replay = Instance.new("BindableEvent")
replay.Name = "ReplayCinematic"
replay.Parent = ReplicatedStorage
replay.Event:Connect(function(kind)
	if not Config.Cinematics.replay then
		return
	end
	if kind == "intro" then
		if begin("intro", Config.CINE.intro, {}, false) then
			begin("tutorial", Config.CINE.tutorial, {}, true)
		end
	elseif kind == "tutorial" then
		begin("tutorial", Config.CINE.tutorial, {}, false)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX29"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayerScripts/Ambience
-- Ambiance propre à chaque zone : en entrant dans un domaine (ou en revenant à l'arène), l'éclairage, l'atmosphère et la teinte de l'image
-- glissent doucement vers les réglages de Config.Map.ambience (modification locale : n'affecte que ce joueur). Coupable avec
-- Config.Animations.zoneAmbience. Une erreur désactive l'ambiance pour la session sans gêner le jeu.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local player = Players.LocalPlayer

local current = nil
local TweenService2 = TweenService

-- Bannière de zone : glisse depuis le haut au passage d'un domaine (ou du retour à l'arène), puis disparaît. Pas au tout premier placement.
local bannerGui = Instance.new("ScreenGui")
bannerGui.Name = "ZoneBanner"
bannerGui.ResetOnSpawn = false
bannerGui.IgnoreGuiInset = false
bannerGui.DisplayOrder = 5
local bannerFrame = Instance.new("Frame")
bannerFrame.AnchorPoint = Vector2.new(0.5, 0)
bannerFrame.Position = UDim2.new(0.5, 0, 0, -120)
bannerFrame.Size = UDim2.fromOffset(340, 74)
bannerFrame.BackgroundColor3 = Color3.fromRGB(20, 40, 30)
bannerFrame.Active = false
bannerFrame.Parent = bannerGui
local bCorner = Instance.new("UICorner")
bCorner.CornerRadius = UDim.new(0, 18)
bCorner.Parent = bannerFrame
local bStroke = Instance.new("UIStroke")
bStroke.Thickness = 4
bStroke.Color = Color3.fromRGB(255, 210, 63)
bStroke.Parent = bannerFrame
local bGrad = Instance.new("UIGradient")
bGrad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(130, 130, 130))
bGrad.Rotation = 90
bGrad.Parent = bannerFrame
local bTitle = Instance.new("TextLabel")
bTitle.BackgroundTransparency = 1
bTitle.Position = UDim2.fromOffset(10, 6)
bTitle.Size = UDim2.new(1, -20, 0, 36)
bTitle.Font = Enum.Font.GothamBlack
bTitle.TextScaled = true
bTitle.TextStrokeTransparency = 0.2
bTitle.Parent = bannerFrame
local bSub = Instance.new("TextLabel")
bSub.BackgroundTransparency = 1
bSub.Position = UDim2.fromOffset(10, 44)
bSub.Size = UDim2.new(1, -20, 0, 24)
bSub.Font = Enum.Font.GothamBold
bSub.TextSize = 13
bSub.TextWrapped = true
bSub.TextColor3 = Color3.fromRGB(225, 240, 230)
bSub.Parent = bannerFrame
bannerGui.Parent = player:WaitForChild("PlayerGui")
local bannerToken = 0

local function showBanner(zone)
	local b = Config.zoneBanner(zone)
	if not b then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bTitle.Text = b.title
	bTitle.TextColor3 = b.color
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local bx, bz = player:GetAttribute("BaseX"), player:GetAttribute("BaseZ")
	local dist = (root and type(bx) == "number" and type(bz) == "number") and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(bx, 0, bz)).Magnitude or nil
	bSub.Text = (dist and Config.zoneLine(zone, dist)) or b.sub
	bStroke.Color = b.color
	TweenService2:Create(bannerFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 70) }):Play()
	task.delay(Config.ZONE_BANNER_SECONDS, function()
		if token == bannerToken then
			TweenService2:Create(bannerFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -120) }):Play()
		end
	end)
end
local failed = false
local TWEEN = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local function apply(zone)
	local a = Config.Map.ambience[zone]
	if not a then
		return
	end
	TweenService:Create(Lighting, TWEEN, { ClockTime = a.clock, Ambient = a.ambient, OutdoorAmbient = a.outdoor }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, TWEEN, { Color = a.atmo, Density = a.density, Haze = a.haze }):Play()
	end
	local grade = Lighting:FindFirstChild("ChipeGrade")
	if grade and grade:IsA("ColorCorrectionEffect") then
		TweenService:Create(grade, TWEEN, { TintColor = a.tint }):Play()
	end
end

task.spawn(function()
	while not failed do
		local ok = pcall(function()
			if Config.animEnabled("zoneAmbience") then
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local zone = Config.zoneAt(root.Position.X, root.Position.Z)
					if zone ~= current then
						local first = current == nil
						current = zone
						apply(zone)
						if not first and Config.Animations.zoneBanner then
							showBanner(zone)
						end
					end
				end
			end
		end)
		if not ok then
			failed = true
			warn("[Ambience] désactivée pour cette session après une erreur")
		end
		task.wait(0.5)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX30"><Properties><string name="Name">Culling</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayer/StarterPlayerScripts/Culling
-- Masque les zones (domaines) éloignées du joueur : au-delà de Config.Culling.cullAt studs du bord d'une zone, ses Parts passent en transparence locale totale
-- (LocalTransparencyModifier = 1) et ses lumières, particules, faisceaux, feux et étiquettes sont coupés ; en dessous de showAt, tout revient. Rien n'est détruit ni
-- déplacé : les collisions et la réplication serveur ne changent pas. Découpé en lots par image, coupé par Config.Culling.enabled = false.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Culling = require(Shared:WaitForChild("Culling"))
if not Config.Culling.enabled then
	return
end
local player = Players.LocalPlayer

local zones = {} -- { x, z, radius, names = { dossiers }, culled, items = nil | { instances }, itemsAt }
for i, riv in ipairs(Config.RIVALS) do
	local x, z = Config.rivalCenter(i)
	zones[i] = { x = x, z = z, radius = Config.Map.plateauRadius, names = { "Rival_" .. riv.name, "Terrace_" .. riv.name }, culled = false }
end

local SWITCHABLE = { PointLight = true, SpotLight = true, SurfaceLight = true, ParticleEmitter = true, Beam = true, Fire = true, Smoke = true, Sparkles = true, BillboardGui = true, SurfaceGui = true, Highlight = true }

local function collect(zone)
	local world = workspace:FindFirstChild("World")
	local items = {}
	if world then
		for _, name in ipairs(zone.names) do
			local folder = world:FindFirstChild(name)
			if folder then
				for _, d in ipairs(folder:GetDescendants()) do
					if d:IsA("BasePart") or SWITCHABLE[d.ClassName] then
						items[#items + 1] = d
					end
				end
			end
		end
	end
	zone.items, zone.itemsAt = items, os.clock()
	return items
end

-- Applique l'état (masqué ou visible) à tous les éléments d'une zone, lot par lot (jamais plus de Config.Culling.batch par image).
local function apply(zone, hide)
	local items = (zone.items and os.clock() - zone.itemsAt < Config.Culling.refresh) and zone.items or collect(zone)
	for _, lot in ipairs(Culling.chunks(items, Config.Culling.batch)) do
		for _, d in ipairs(lot) do
			pcall(function()
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = hide and 1 or 0
				else
					d.Enabled = not hide
				end
			end)
		end
		task.wait()
	end
end

task.spawn(function()
	while true do
		task.wait(Config.Culling.interval)
		local ok = pcall(function()
			local cam = workspace.CurrentCamera
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local pos = root and root.Position or (cam and cam.CFrame.Position)
			if not pos then
				return
			end
			for _, zone in ipairs(zones) do
				local d = Culling.distanceTo(pos.X, pos.Z, zone)
				local hide = Culling.decide(d, zone.culled, Config.Culling.cullAt, Config.Culling.showAt)
				if hide ~= zone.culled then
					zone.culled = hide
					apply(zone, hide)
				end
			end
		end)
		if not ok then
			warn("[Culling] désactivé pour cette session après une erreur")
			break
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">RevealFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/RevealFx
-- Effet de révélation d'un œuf, 100 % dessiné par le code (Frames, UIGradient, UIStroke, UICorner, TweenService) : étoile lumineuse centrale
-- colorée selon la rareté, halo, rayons qui tournent, anneaux qui s'étendent, étincelles, libellé « ŒUF SECRET ». Aucun asset externe.
-- Le style (nombre de rayons, d'anneaux, de particules) vient de Reveal.style : l'option mobile le réduit. Aucune erreur ne sort d'ici.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local RevealFx = {}

local DURATION = 2.6

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function tween(obj, seconds, goal, style, dir)
	TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end

-- Nombre d'objets créés pour un style (plafond de performance, vérifié par les tests).
function RevealFx.cost(style)
	-- conteneur 1 + halo 3 (Frame, UICorner, UIGradient) + rayons 1 + 2 par rayon + 3 par anneau + étoile 1 + 1 par étincelle + libellé secret
	return 6 + 2 * style.rays + 3 * style.rings + style.particles + ((style.secret and style.label) and 1 or 0) + (style.banner and 5 or 0)
end

-- Joue l'effet au centre (position `center`, UDim2) de `parent` (ScreenGui). Retourne le conteneur (détruit tout seul), ou nil en cas d'erreur.
function RevealFx.play(parent, style, center)
	local ok, root = pcall(function()
		local color = style.color
		local box = make("Frame", {
			Name = "RevealFx", AnchorPoint = Vector2.new(0.5, 0.5), Position = center or UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1, ZIndex = 1, Active = false,
		}, parent)
		-- halo : disque dégradé (opaque au centre, transparent au bord)
		local glow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(60, 60), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 1 }, box)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glow)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.85) }), Rotation = 90 }, glow)
		tween(glow, 0.5, { Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 0.7 }, Enum.EasingStyle.Back)
		tween(glow, DURATION, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		-- rayons : conteneur tournant
		local spin = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = 2 }, box)
		for i = 1, style.rays do
			local ray = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(i % 2 == 0 and 7 or 4, i % 2 == 0 and 250 or 190),
				BackgroundColor3 = color, BackgroundTransparency = 0.15, Rotation = (i - 1) * 360 / style.rays, ZIndex = 2,
			}, spin)
			make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Rotation = 90 }, ray)
		end
		spin.Rotation = -20
		tween(spin, DURATION, { Rotation = 70 }, Enum.EasingStyle.Sine)
		-- anneaux
		for i = 1, style.rings do
			local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1, ZIndex = 3 }, box)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
			local stroke = make("UIStroke", { Color = color, Thickness = 5, Transparency = 0.1 }, ring)
			task.delay((i - 1) * 0.18, function()
				pcall(function()
					tween(ring, 0.9, { Size = UDim2.fromOffset(240 + i * 70, 240 + i * 70) }, Enum.EasingStyle.Quint)
					tween(stroke, 0.9, { Transparency = 1, Thickness = 1 })
				end)
			end)
		end
		-- étoile centrale : « ★ » avec contour sombre épais et reflet
		local star = make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, Text = "★", TextScaled = true, Font = Enum.Font.GothamBold,
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(30, 20, 40), ZIndex = 5, Rotation = -30,
		}, box)
		tween(star, 0.55, { Size = UDim2.fromOffset(150, 150), Rotation = 0 }, Enum.EasingStyle.Elastic)
		task.delay(DURATION - 0.7, function()
			pcall(function()
				tween(star, 0.7, { Size = UDim2.fromOffset(40, 40), TextTransparency = 1, TextStrokeTransparency = 1 })
			end)
		end)
		-- étincelles lancées dans toutes les directions
		for i = 1, style.particles do
			local a = (i / style.particles) * math.pi * 2 + (i % 3) * 0.3
			local dist = 150 + (i % 5) * 38
			local spark = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = i % 2 == 0 and "✦" or "✨",
				TextScaled = true, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3), Font = Enum.Font.GothamBold, ZIndex = 4,
			}, box)
			tween(spark, 0.9 + (i % 4) * 0.15, { Position = UDim2.fromOffset(math.cos(a) * dist, math.sin(a) * dist), TextTransparency = 1 })
		end
		if style.banner then -- bandeau de rareté coloré (commun jaune, rare vert, épique violet, légendaire rouge, mythique cyan, secret arc-en-ciel)
			local cols = style.banner.colors
			local keys = {}
			for i, c in ipairs(cols) do
				keys[i] = ColorSequenceKeypoint.new((i - 1) / math.max(#cols - 1, 1), c)
			end
			local band = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 120), Size = UDim2.fromOffset(40, 34), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 4 }, box)
			make("UICorner", { CornerRadius = UDim.new(0, 12) }, band)
			make("UIStroke", { Color = Color3.fromRGB(24, 16, 30), Thickness = 4 }, band)
			make("UIGradient", { Color = ColorSequence.new(keys), Rotation = #cols > 2 and 0 or 90 }, band)
			local bt = make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = style.banner.name, Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(24, 16, 30), ZIndex = 5 }, band)
			bt.Name = "BannerText"
			tween(band, 0.5, { Size = UDim2.fromOffset(250, 34) }, Enum.EasingStyle.Back)
		end
		if style.secret and style.label then
			make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, -150), Size = UDim2.fromOffset(360, 36), BackgroundTransparency = 1, Text = style.label,
				TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = color, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(50, 10, 0), ZIndex = 6,
			}, box)
		end
		Debris:AddItem(box, DURATION + 0.6)
		return box
	end)
	return ok and root or nil
end

return RevealFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">SlotFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/SlotFx
-- Écran de tirage « machine à sous » (rareté / taille / mutation) avant la révélation d'un œuf : 3 colonnes qui défilent comme des rouleaux, ralentissent et
-- s'arrêtent une à une (secousse et étincelles à chaque arrêt), bannière « SECRET ! » sur un tirage secret, phénix lumineux avec cercle runique dès le
-- palier Légendaire. 100 % dessiné par le code ; le plan (positions, arrêts) vient de Reveal.slotPlan et le résultat affiché est TOUJOURS le tirage réel.
-- opts.slotPos = Reveal.slotPos (injecté). Un tap passe l'animation. `onDone` est appelé exactement une fois (fin, passage ou erreur). Aucune erreur ne sort d'ici.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local SlotFx = {}

local FONT = Enum.Font.GothamBold
local RUNES = { "ᚠ", "ᚢ", "ᚦ", "ᚨ", "ᚱ", "ᚲ", "ᚷ", "ᚹ" }

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function tween(obj, seconds, goal, style, dir)
	TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end

-- Nombre d'objets créés AVANT le début de l'animation (hors étincelles, bannière et phénix, créés à l'arrêt).
SlotFx.STATIC_COST = 3 + 1 + 3 * 11 -- conteneur + coins + contour, titre, 3 colonnes (cadre, coins, contour, titre, 5 cases, fenêtre, contour)

-- Joue l'écran au centre de `parent` (ScreenGui). opts : secret (bool), onDone (fonction). Retourne le conteneur ou nil.
function SlotFx.play(parent, plan, cell, opts)
	opts = opts or {}
	local finished = false
	local conn, root
	local function finish()
		if finished then
			return
		end
		finished = true
		if conn then
			pcall(function()
				conn:Disconnect()
			end)
		end
		if root then
			pcall(function()
				tween(root, 0.18, { BackgroundTransparency = 1 })
				Debris:AddItem(root, 0.3)
			end)
		end
		if opts.onDone then
			pcall(opts.onDone)
		end
	end
	local ok = pcall(function()
		local CH = cell or 34
		local W = 128
		root = make("TextButton", {
			Name = "SlotFx", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(3 * W + 4 * 12, 3 * CH + 70),
			BackgroundColor3 = Color3.fromRGB(24, 18, 40), BackgroundTransparency = 0.05, Text = "", AutoButtonColor = false, ZIndex = 40,
		}, parent)
		make("UICorner", { CornerRadius = UDim.new(0, 18) }, root)
		make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 4 }, root)
		make("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 26), Text = "🎰 TIRAGE EN COURS… (touche pour passer)", Font = FONT, TextSize = 14,
			TextColor3 = Color3.fromRGB(255, 232, 150), ZIndex = 41,
		}, root)
		local cols = {}
		for k, col in ipairs(plan.columns) do
			local frame = make("Frame", {
				Position = UDim2.fromOffset(12 + (k - 1) * (W + 12), 56), Size = UDim2.fromOffset(W, 3 * CH), BackgroundColor3 = Color3.fromRGB(12, 10, 24), ClipsDescendants = true, ZIndex = 41,
			}, root)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
			make("UIStroke", { Color = Color3.fromRGB(90, 80, 130), Thickness = 2 }, frame)
			make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12 + (k - 1) * (W + 12), 32), Size = UDim2.fromOffset(W, 20), Text = col.title, Font = FONT, TextSize = 14, TextColor3 = Color3.fromRGB(180, 170, 220), ZIndex = 41 }, root)
			local labels = {}
			for j = -2, 2 do
				labels[j] = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, CH), Position = UDim2.new(0.5, 0, 0, CH * 1.5), Text = "", Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), ZIndex = 42 }, frame)
			end
			local win = make("Frame", { Position = UDim2.fromOffset(0, CH), Size = UDim2.new(1, 0, 0, CH), BackgroundTransparency = 1, ZIndex = 43 }, frame)
			make("UIStroke", { Color = Color3.fromRGB(255, 210, 63), Thickness = 2 }, win)
			cols[k] = { col = col, frame = frame, labels = labels, stopped = false, W = W, CH = CH }
		end
		local t0 = os.clock()
		local reduced = opts.reduced == true
		local function burst(k, color)
			local cx = 12 + (k - 1) * (W + 12) + W / 2
			for i = 1, (reduced and 3 or 6) do
				local spark = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, 56 + CH * 1.5), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = i % 2 == 0 and "✦" or "✨", TextScaled = true, TextColor3 = color, ZIndex = 45 }, root)
				local a = i / 6 * math.pi * 2
				tween(spark, 0.6, { Position = UDim2.fromOffset(cx + math.cos(a) * 60, 56 + CH * 1.5 + math.sin(a) * 50), TextTransparency = 1 })
				Debris:AddItem(spark, 0.7)
			end
			-- secousse du bloc à chaque arrêt
			local base = root.Position
			for s = 1, 4 do
				task.delay(s * 0.04, function()
					pcall(function()
						root.Position = s == 4 and base or UDim2.new(base.X.Scale, base.X.Offset + (s % 2 == 0 and 5 or -5), base.Y.Scale, base.Y.Offset)
					end)
				end)
			end
		end
		local ended = false
		local function ending()
			if ended then
				return
			end
			ended = true
			local tcol = plan.columns[1].symbols[plan.columns[1].final].color or Color3.new(1, 1, 1)
			if opts.secret then
				local ban = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(60, 20), BackgroundTransparency = 1, Text = "SECRET !", Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.fromRGB(255, 70, 20), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(50, 10, 0), ZIndex = 50 }, root)
				tween(ban, 0.45, { Size = UDim2.fromOffset(330, 80) }, Enum.EasingStyle.Back)
			end
			if plan.phoenix then
				local glow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = tcol, BackgroundTransparency = 0.3, ZIndex = 44 }, root)
				make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glow)
				make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.9) }), Rotation = 90 }, glow)
				tween(glow, 0.7, { Size = UDim2.fromOffset(360, 360), BackgroundTransparency = 0.85 }, Enum.EasingStyle.Quint)
				local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(240, 240), BackgroundTransparency = 1, ZIndex = 46 }, root)
				for i, r in ipairs(RUNES) do
					local a = (i - 1) / #RUNES * math.pi * 2
					make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.cos(a) * 110, 0.5, math.sin(a) * 110), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, Text = r, Font = FONT, TextScaled = true, TextColor3 = tcol, ZIndex = 46, Rotation = math.deg(a) + 90 }, ring)
				end
				tween(ring, plan.hold + 0.6, { Rotation = 120 }, Enum.EasingStyle.Sine)
				for _, side in ipairs({ -1, 1 }) do
					local wing = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "🪽", TextScaled = true, ZIndex = 47 }, root)
					tween(wing, 0.7, { Position = UDim2.new(0.5, side * 150, 0.5, -20), Size = UDim2.fromOffset(90, 90) }, Enum.EasingStyle.Back)
				end
				local bird = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "🔥", TextScaled = true, ZIndex = 48 }, root)
				tween(bird, 0.6, { Size = UDim2.fromOffset(110, 110) }, Enum.EasingStyle.Elastic)
				Debris:AddItem(glow, plan.hold + 0.7)
				Debris:AddItem(ring, plan.hold + 0.7)
			end
			task.delay(plan.hold, finish)
		end
		conn = RunService.Heartbeat:Connect(function()
			if finished then
				return
			end
			local ok2 = pcall(function()
				local t = os.clock() - t0
				local allStopped = true
				for k, c in ipairs(cols) do
					local col = c.col
					local pos = opts.slotPos(col, t)
					local n = #col.symbols
					local base = math.floor(pos + 0.5)
					local frac = pos - base
					for j = -2, 2 do
						local sym = col.symbols[(base + j - 1) % n + 1]
						local lab = c.labels[j]
						lab.Text = sym.text
						lab.TextColor3 = sym.color or Color3.new(1, 1, 1)
						lab.Position = UDim2.new(0.5, 0, 0, c.CH * (1.5 + j - frac))
						lab.TextTransparency = j == 0 and 0 or 0.45
					end
					if t >= col.stop then
						if not c.stopped then
							c.stopped = true
							burst(k, col.symbols[col.final].color or Color3.new(1, 1, 1))
						end
					else
						allStopped = false
					end
				end
				if allStopped then
					ending()
				end
			end)
			if not ok2 then
				finish()
			end
		end)
		root.Activated:Connect(finish)
		task.delay(plan.duration + 1.5, finish) -- garde-fou : jamais bloqué
	end)
	if not ok then
		finish()
		return nil
	end
	return root
end

return SlotFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">CoinIcon</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : StarterPlayerScripts/CoinIcon
-- Icônes de richesse dessinées par le code (Frames, UICorner, UIStroke, UIGradient) : 1 pièce, petite pile, grosse pile, coffre.
-- Aucune image ni identifiant. Retourne le conteneur ; aucune erreur ne sort d'ici (pcall) : nil si la construction échoue.
local CoinIcon = {}

local GOLD_TOP, GOLD_BOTTOM, DARK = Color3.fromRGB(255, 232, 120), Color3.fromRGB(224, 150, 20), Color3.fromRGB(78, 46, 6)

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function disc(parent, cx, cy, d)
	local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(d, d), BackgroundColor3 = Color3.new(1, 1, 1) }, parent)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
	make("UIStroke", { Color = DARK, Thickness = math.max(2, d * 0.1) }, f)
	make("UIGradient", { Color = ColorSequence.new(GOLD_TOP, GOLD_BOTTOM), Rotation = 90 }, f)
	return f
end

-- tier : 1 pièce, 2 petite pile, 3 grosse pile, 4 coffre. size : côté du conteneur en pixels.
function CoinIcon.build(parent, tier, size)
	local ok, root = pcall(function()
		local box = make("Frame", { Name = "CoinIcon", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
		local d = size * 0.34
		if tier <= 1 then
			disc(box, size / 2, size / 2, size * 0.62)
		elseif tier == 2 then
			for i = 0, 2 do
				disc(box, size * 0.22 + i * d * 0.9, size * 0.72, d)
			end
			for i = 0, 1 do
				disc(box, size * 0.34 + i * d * 0.9, size * 0.72 - d * 0.62, d)
			end
		elseif tier == 3 then
			local rows = { 4, 3, 2, 1 }
			for r, n in ipairs(rows) do
				for i = 0, n - 1 do
					disc(box, size / 2 + (i - (n - 1) / 2) * d * 0.88, size * 0.8 - (r - 1) * d * 0.62, d)
				end
			end
		else
			local body = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(size / 2, size * 0.42), Size = UDim2.fromOffset(size * 0.8, size * 0.46), BackgroundColor3 = Color3.fromRGB(150, 92, 44) }, box)
			make("UICorner", { CornerRadius = UDim.new(0.12, 0) }, body)
			make("UIStroke", { Color = DARK, Thickness = math.max(2, size * 0.05) }, body)
			make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)), Rotation = 90 }, body)
			local lid = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(size / 2, size * 0.46), Size = UDim2.fromOffset(size * 0.84, size * 0.24), BackgroundColor3 = Color3.fromRGB(190, 122, 56) }, box)
			make("UICorner", { CornerRadius = UDim.new(0.45, 0) }, lid)
			make("UIStroke", { Color = DARK, Thickness = math.max(2, size * 0.05) }, lid)
			make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(size / 2, size * 0.42), Size = UDim2.fromOffset(size * 0.1, size * 0.46), BackgroundColor3 = GOLD_BOTTOM, BorderSizePixel = 0 }, box)
			disc(box, size / 2, size * 0.62, size * 0.2)
			disc(box, size * 0.3, size * 0.3, d * 0.5)
			disc(box, size * 0.7, size * 0.26, d * 0.45)
		end
		return box
	end)
	return ok and root or nil
end

return CoinIcon
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
