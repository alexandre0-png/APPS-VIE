-- Rend la liste des indices d'espèces d'une rareté (ordre croissant d'indice).
function Bestiary.speciesOfTier(tier)
	local out = {}
	for i, d in ipairs(Bestiary.PETS) do
		if d.tier == tier then
			out[#out + 1] = i
		end
	end
	return out
end

-- Description normalisée du repli procédural d'une espèce (jamais nil pour un indice valide) : sert au Builder et aux tests « chaque modèle a un repli ».
function Bestiary.fallback(idx)
	local d = Bestiary.PETS[idx]
	if not d then
		return nil
	end
	return { color = d.color, ears = d.ears, extra = d.extra, extra2 = d.extra2, accent = d.accent, glow = d.glow == true, scale = d.scale or 1 }
end

return Bestiary
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX125"><Properties><string name="Name">PetXp</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/PetXp   (LOT 12 partie B, D.6)
-- Expérience et niveaux des pets : module PUR (aucun service Roblox, aucun require). L'XP est stockée sur l'emplacement du pet : `slot.x` = XP CUMULÉE (entier, champ déjà
-- créé à 0 par la migration v11 et assaini par Data.merge). Niveau 1 à 20 ; chaque niveau donne +1,5 % de pv et d'attaque (Battle.unit : stat x PetXp.statMul(niveau)).
-- RÈGLE FERME : l'XP de pet ne s'obtient QU'EN JOUANT (combat PvE/PvP/PNJ, carte Expérience D.5). Aucun produit, aucun pass, aucun reçu ne donne d'XP de pet
-- (PetXp.award refuse toute source hors liste blanche). L'effet « XP x2 » (série jour 5 = data.xp2Until, carte Effet = data.boosts.xp2) ne se gagne qu'en jouant.
-- Style : pas de `+=`, pas de `continue`, valeurs douteuses gardées par type avant toute comparaison.
local PetXp = {}

PetXp.MAX_LEVEL = 20
PetXp.PER_LEVEL = 0.015 -- +1,5 % pv / attaque par niveau au-dessus de 1
PetXp.MAX_AWARD = 100000 -- plafond d'un gain unique (anti-valeurs absurdes)
PetXp.TRAINER_MAX_LEVEL = 100
PetXp.TRAINER_MAX_XP = 1e9

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- XP à gagner pour passer du niveau L au niveau L+1 (D.6) : floor(40 x L^1,1). nil au niveau max ou pour un niveau invalide.
function PetXp.xpTo(L)
	if not isnum(L) or L < 1 or L >= PetXp.MAX_LEVEL then
		return nil
	end
	L = math.floor(L)
	return math.floor(40 * L ^ 1.1)
end

-- Seuils cumulés : CUM[L] = XP totale nécessaire pour ATTEINDRE le niveau L (CUM[1] = 0).
local CUM = { 0 }
for L = 1, PetXp.MAX_LEVEL - 1 do
	CUM[L + 1] = CUM[L] + PetXp.xpTo(L)
end
PetXp.CUM = CUM
PetXp.MAX_XP = CUM[PetXp.MAX_LEVEL] -- XP cumulée au niveau max : l'XP stockée ne dépasse jamais cette valeur

-- XP stockée saine (entier 0..MAX_XP). Idempotent.
function PetXp.sanitize(x)
	if not isnum(x) or x < 0 then
		return 0
	end
	x = math.floor(x)
	if x > PetXp.MAX_XP then
		return PetXp.MAX_XP
	end
	return x
end

-- (niveau, XP dans le niveau, XP requise pour le suivant | nil au max).
function PetXp.levelOf(x)
	x = PetXp.sanitize(x)
	local lv = 1
	while lv < PetXp.MAX_LEVEL and x >= CUM[lv + 1] do
		lv = lv + 1
	end
	if lv >= PetXp.MAX_LEVEL then
		return lv, 0, nil
	end
	return lv, x - CUM[lv], PetXp.xpTo(lv)
end

function PetXp.level(x)
	local lv = PetXp.levelOf(x)
	return lv
end

-- Multiplicateur de pv / attaque d'un niveau : 1 + 0,015 x (niveau - 1). Niveau invalide -> 1 ; plafonné au niveau max.
function PetXp.statMul(level)
	if not isnum(level) then
		return 1
	end
	level = math.min(PetXp.MAX_LEVEL, math.max(1, math.floor(level)))
	return 1 + PetXp.PER_LEVEL * (level - 1)
end

-- Ajoute `amount` (entier >= 0, plafonné) à l'XP cumulée `x`. Retourne (nouvelle XP, gain réel, niveau avant, niveau après).
function PetXp.add(x, amount)
	x = PetXp.sanitize(x)
	local before = PetXp.level(x)
	local a = 0
	if isnum(amount) and amount > 0 then
		a = math.min(PetXp.MAX_AWARD, math.floor(amount))
	end
	local nx = math.min(PetXp.MAX_XP, x + a)
	return nx, nx - x, before, PetXp.level(nx)
end

-- Vue pour l'interface : { level, into, need, frac, max }.
function PetXp.view(x)
	local lv, into, need = PetXp.levelOf(x)
	return { level = lv, into = into, need = need, frac = need and (into / need) or 1, max = lv >= PetXp.MAX_LEVEL }
end

---------------------------------------------------------------- Sources d'XP (D.6)
-- Liste blanche : on ne gagne de l'XP de pet qu'en jouant. Toute autre source (produit, pass, reçu, cadeau, don) vaut 0.
PetXp.SOURCES = { pve = true, pvp = true, npc = true, card = true }
PetXp.NPC_MUL = 0.6 -- D.5 : combats de PNJ, valeurs x0,6

function PetXp.sourceAllowed(source)
	return type(source) == "string" and PetXp.SOURCES[source] == true
end

-- XP de base par pet pour un combat terminé (D.6) : PvE gagné = 20 + 5 x étage, perdu = 5 ; PvP gagné 15, perdu 5 ; PNJ = formule PvE (étage 0) x 0,6.
function PetXp.combat(kind, win, floor)
	if kind == "pvp" then
		return win and 15 or 5
	end
	if kind == "npc" then
		return win and math.floor(20 * PetXp.NPC_MUL) or math.floor(5 * PetXp.NPC_MUL)
	end
	if kind ~= "pve" then
		return 0
	end
	if not win then
		return 5
	end
	local f = isnum(floor) and math.min(45, math.max(0, math.floor(floor))) or 0
	return 20 + 5 * f
end

-- Multiplicateur d'XP de COMBAT : x2 si l'effet « XP x2 » est actif (série : data.xp2Until ; carte Effet : data.boosts.xp2). Jamais vendu. Les cartes Expérience ne sont pas multipliées.
function PetXp.boostMul(data, now)
	if type(data) ~= "table" or not isnum(now) then
		return 1
	end
	if isnum(data.xp2Until) and data.xp2Until > now then
		return 2
	end
	if type(data.boosts) == "table" and isnum(data.boosts.xp2) and data.boosts.xp2 > now then
		return 2
	end
	return 1
end

-- Montant final d'un gain d'XP pour une source donnée : 0 pour toute source non autorisée (produit, Robux...). `mul` (>= 0) ne s'applique qu'aux combats.
function PetXp.award(source, base, mul)
	if not PetXp.sourceAllowed(source) or not isnum(base) or base <= 0 then
		return 0
	end
	local m = (source ~= "card" and isnum(mul) and mul > 0) and mul or 1
	return math.min(PetXp.MAX_AWARD, math.floor(base * m))
end

-- Donne `amount` d'XP à chacun des emplacements `team` (indices) de `slots` qui contiennent un pet (k == "p"). Retourne la liste { slot, gained, from, to } (niveaux).
function PetXp.addToTeam(slots, team, amount)
	local out = {}
	if type(slots) ~= "table" or type(team) ~= "table" then
		return out
	end
	local seen = {}
	for _, idx in ipairs(team) do
		local sl = isnum(idx) and slots[idx] or nil
		if type(sl) == "table" and sl.k == "p" and not seen[idx] then
			seen[idx] = true
			local nx, gained, from, to = PetXp.add(sl.x, amount)
			sl.x = nx
			out[#out + 1] = { slot = idx, gained = gained, from = from, to = to }
		end
	end
	return out
end

-- Vol / vente : un pet vendu ou volé perd son XP chez le propriétaire d'origine ; le voleur garde l'XP du pet volé (D.6). Retourne l'XP à reporter sur le nouvel emplacement.
function PetXp.carry(slot)
	if type(slot) == "table" and slot.k == "p" then
		return PetXp.sanitize(slot.x)
	end
	return 0
end

---------------------------------------------------------------- Niveau de Dresseur (D.6)
-- trainer = { xp } : total des XP gagnés (tous pets confondus) ; niveau = floor(sqrt(xp / 50)) + 1, max 100. Sert au matchmaking et aux titres : aucun effet sur la force.
function PetXp.sanitizeTrainer(saved)
	local xp = 0
	if type(saved) == "table" and isnum(saved.xp) and saved.xp > 0 then
		xp = math.min(PetXp.TRAINER_MAX_XP, math.floor(saved.xp))
	end
	return { xp = xp }
end

function PetXp.trainerLevel(xp)
	if not isnum(xp) or xp < 0 then
		return 1
	end
	return math.min(PetXp.TRAINER_MAX_LEVEL, math.floor(math.sqrt(xp / 50)) + 1)
end

function PetXp.trainerAdd(trainer, amount)
	local t = PetXp.sanitizeTrainer(trainer)
	if isnum(amount) and amount > 0 then
		t.xp = math.min(PetXp.TRAINER_MAX_XP, t.xp + math.min(PetXp.MAX_AWARD, math.floor(amount)))
	end
	return t
end

return PetXp
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX126"><Properties><string name="Name">BattleRewards</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/BattleRewards   (LOT 12 partie B, D.5)
-- Récompense AU CHOIX après une victoire PvE (tour des Dresseurs, combats de PNJ) : module PUR (aucun service Roblox). Ne remplace pas Rewards.lua (série / calendrier du lot 15).
-- Le SERVEUR tire 3 cartes de 3 catégories DIFFÉRENTES (poids : Pièces 30, Expérience 25, Œuf 15, Vitesse 15, Effet 15 ; aux boss, une des 3 est toujours l'Œuf), les enregistre dans
-- `data.battle.pendingPick = { id, cards, expires, floor, mode }` puis les envoie au client ; le joueur en choisit une en 15 s, sinon la première. Se déconnecter ou relancer ne
-- retire pas la récompense et n'en retire pas de nouvelle : BattleRewards.offer renvoie le tirage existant.
-- Aucune carte ne donne de force payante : pièces, XP de pet (PetXp, jamais vendu), un œuf, de la vitesse de piste GAGNÉE, un boost temporaire gagné en jouant (aucun Robux).
-- Aléa : Park-Miller (48271 mod 2^31-1) en double précision, graine INJECTABLE (le serveur passe une graine issue de Random ; les tests passent une graine fixe).
-- Config attendu (existant) : towerTier, liveEggTier, nextLiveTier, eggCoinValue (optionnel), TIERS, fmt (optionnel). Pas de += ni de continue (lanceur lupa).
local BattleRewards = {}

BattleRewards.PICK_SECONDS = 15
BattleRewards.CARD_COUNT = 3
-- Poids de tirage (D.5), dans l'ordre de tirage stable.
BattleRewards.KINDS = { "coins", "xp", "egg", "speed", "effect" }
BattleRewards.WEIGHTS = { coins = 30, xp = 25, egg = 15, speed = 15, effect = 15 }
-- Multiplicateurs de valeur : première victoire de l'étage x2, victoire répétée x0,5, combat de PNJ x0,6 (D.5).
BattleRewards.MODE_MUL = { first = 2, ["repeat"] = 0.5, npc = 0.6, normal = 1 }
BattleRewards.COINS_MIN = 500
BattleRewards.COINS_SECONDS = 90 -- « revenus de 1,5 min »
BattleRewards.MAX_FLOOR = 45
-- Effets (boosts temporaires) : durée en secondes, non cumulables avec eux-mêmes (prolongent), plafond 30 min. `name` : libellé affiché.
BattleRewards.EFFECTS = {
	income2 = { name = "Revenus ×2", seconds = 300, order = 1 },
	luck10 = { name = "Chance +10 points", seconds = 300, order = 2 },
	xp2 = { name = "XP ×2", seconds = 600, order = 3 },
	speed15 = { name = "Vitesse +15 %", seconds = 300, order = 4 },
}
BattleRewards.EFFECT_KEYS = { "income2", "luck10", "xp2", "speed15" }
BattleRewards.BOOST_CAP_SECONDS = 1800

local COINS_CAP, XP_CAP, SPEED_CAP = 1e15, 100000, 1000

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function int(v, lo, hi, def)
	if not isnum(v) then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

---------------------------------------------------------------- Aléa : Park-Miller 48271 mod 2^31-1
local M = 2147483647
local A = 48271 -- état < 2^31, produit < 2^47 : exact en double précision (pas de 1103515245)
BattleRewards.MODULUS, BattleRewards.MULTIPLIER = M, A

-- Générateur à graine injectable. Toute graine (même NaN, négative, énorme) devient un état valide 1..M-1.
function BattleRewards.rng(seed)
	local s = 1
	if isnum(seed) then
		s = math.floor(math.abs(seed)) % (M - 1)
		if s == 0 then
			s = 1
		end
	end
	local r = {}
	function r.next() -- flottant dans ]0 ; 1[
		s = (s * A) % M
		return s / M
	end
	function r.int(lo, hi) -- entier dans [lo ; hi]
		return lo + math.floor(r.next() * (hi - lo + 1))
	end
	function r.state()
		return s
	end
	return r
end

---------------------------------------------------------------- Valeurs des cartes (D.5)
local function modeOf(ctx)
	local m = type(ctx) == "table" and ctx.mode or nil
	if m ~= nil and BattleRewards.MODE_MUL[m] then
		return m
	end
	return "normal"
end

local function scaled(base, mul, lo)
	return math.max(lo, math.floor(base * mul + 1e-9))
end

-- Rareté de l'étage ; l'œuf d'un BOSS est d'un cran au-dessus (règle existante, jamais au-delà de 8 : ni Exclusif ni Divin), toujours une rareté publiée.
function BattleRewards.eggTierFor(Config, floor, boss)
	local rt = Config.towerTier(math.max(1, floor))
	local t = rt
	if boss then
		t = math.min(8, Config.nextLiveTier(rt) or rt)
	end
	return Config.liveEggTier(t)
end

-- ctx = { floor (0 pour un PNJ), income (revenu par seconde), mode ("first" | "repeat" | "npc" | "normal") }. Retourne une carte { kind, ... } sans état caché.
function BattleRewards.makeCard(Config, kind, ctx, rnd)
	local f = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0)
	local mul = BattleRewards.MODE_MUL[modeOf(ctx)]
	local boss = f >= 5 and f % 5 == 0 and modeOf(ctx) ~= "npc"
	if kind == "coins" then
		local income = isnum(ctx.income) and math.max(0, ctx.income) or 0
		local base = math.max(BattleRewards.COINS_MIN, income * BattleRewards.COINS_SECONDS * (1 + f / 10))
		return { kind = "coins", amount = math.min(COINS_CAP, scaled(base, mul, 1)) }
	elseif kind == "xp" then
		return { kind = "xp", amount = math.min(XP_CAP, scaled(30 + 10 * f, mul, 1)) }
	elseif kind == "egg" then
		return { kind = "egg", tier = BattleRewards.eggTierFor(Config, f, boss) }
	elseif kind == "speed" then
		return { kind = "speed", amount = math.min(SPEED_CAP, scaled(2 + f // 5, mul, 1)) }
	end
	local key = BattleRewards.EFFECT_KEYS[rnd.int(1, #BattleRewards.EFFECT_KEYS)]
	return { kind = "effect", key = key, seconds = BattleRewards.EFFECTS[key].seconds }
end

---------------------------------------------------------------- Tirage de 3 cartes
-- Tirage pondéré SANS remise sur les catégories : 3 catégories distinctes. `boss` : l'Œuf est d'office l'une des 3. L'ordre final est mélangé (Fisher-Yates).
function BattleRewards.draw(Config, ctx, seed)
	local rnd = BattleRewards.rng(seed)
	local f = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0)
	local boss = f >= 5 and f % 5 == 0 and modeOf(ctx) ~= "npc"
	local pool, kinds = {}, {}
	for _, k in ipairs(BattleRewards.KINDS) do
		pool[#pool + 1] = k
	end
	local function take(k)
		for i, v in ipairs(pool) do
			if v == k then
				table.remove(pool, i)
				break
			end
		end
		kinds[#kinds + 1] = k
	end
	if boss then
		take("egg")
	end
	while #kinds < BattleRewards.CARD_COUNT do
		local total = 0
		for _, k in ipairs(pool) do
			total = total + BattleRewards.WEIGHTS[k]
		end
		local roll, pick = rnd.next() * total, pool[#pool]
		for _, k in ipairs(pool) do
			roll = roll - BattleRewards.WEIGHTS[k]
			if roll < 0 then
				pick = k
				break
			end
		end
		take(pick)
	end
	for i = #kinds, 2, -1 do
		local j = rnd.int(1, i)
		kinds[i], kinds[j] = kinds[j], kinds[i]
	end
	local cards = {}
	for _, k in ipairs(kinds) do
		cards[#cards + 1] = BattleRewards.makeCard(Config, k, ctx, rnd)
	end
	return cards
end

---------------------------------------------------------------- pendingPick : enregistrement serveur
-- Crée un tirage enregistrable : { id, cards, expires, floor, mode }. `id` est fourni par le serveur (compteur ou chaîne) ; `now` = os.time().
function BattleRewards.newPick(Config, ctx, seed, now, id)
	return {
		id = id,
		cards = BattleRewards.draw(Config, ctx, seed),
		expires = (isnum(now) and now or 0) + BattleRewards.PICK_SECONDS,
		floor = int(ctx.floor, 0, BattleRewards.MAX_FLOOR, 0),
		mode = modeOf(ctx),
	}
end

-- Point d'entrée serveur après une victoire : s'il existe déjà un pendingPick (assaini), il est RENDU TEL QUEL (pas de nouveau tirage : se reconnecter ou enchaîner
-- ne fait ni perdre ni refaire la récompense). Retourne (pick, estNouveau). Le serveur doit stocker `pick` dans data.battle.pendingPick quand estNouveau.
function BattleRewards.offer(Config, pending, ctx, seed, now, id)
	local clean = BattleRewards.sanitizePending(Config, pending)
	if clean then
		return clean, false
	end
	return BattleRewards.newPick(Config, ctx, seed, now, id), true
end

function BattleRewards.expired(pick, now)
	return type(pick) == "table" and isnum(pick.expires) and isnum(now) and now >= pick.expires
end

-- Choix du joueur : retourne (carte, auto). Index invalide avant expiration -> nil, "bad_index" (le serveur ignore et NE consomme pas) ; après expiration, la première carte
-- est donnée d'office (auto = true), quel que soit l'index. id différent -> nil, "bad_id". Le serveur met data.battle.pendingPick = nil AVANT d'attribuer (pas de double gain).
function BattleRewards.claim(pick, id, index, now)
	if type(pick) ~= "table" or type(pick.cards) ~= "table" or #pick.cards == 0 then
		return nil, "no_pick"
	end
	if id ~= nil and pick.id ~= id then
		return nil, "bad_id"
	end
	if BattleRewards.expired(pick, now) then
		return pick.cards[1], true
	end
	if isnum(index) and index % 1 == 0 and index >= 1 and index <= #pick.cards then
		return pick.cards[index], false
	end
	return nil, "bad_index"
end

-- Secondes restantes (>= 0) pour l'affichage client ; à la reconnexion un tirage échu est résolu par claim (auto), un tirage vivant est renvoyé avec son temps restant.
function BattleRewards.remaining(pick, now)
	if type(pick) ~= "table" or not isnum(pick.expires) or not isnum(now) then
		return 0
	end
	return math.max(0, pick.expires - now)
end

---------------------------------------------------------------- Assainissement (profil)
local function cleanCard(Config, c)
	if type(c) ~= "table" then
		return nil
	end
	local kind = c.kind
	if kind == "coins" and isnum(c.amount) then
		return { kind = "coins", amount = int(c.amount, 1, COINS_CAP, 1) }
	elseif kind == "xp" and isnum(c.amount) then
		return { kind = "xp", amount = int(c.amount, 1, XP_CAP, 1) }
	elseif kind == "speed" and isnum(c.amount) then
		return { kind = "speed", amount = int(c.amount, 1, SPEED_CAP, 1) }
	elseif kind == "egg" and isnum(c.tier) then
		local n = type(Config.TIERS) == "table" and #Config.TIERS or 10
		return { kind = "egg", tier = int(c.tier, 1, n, 1) }
	elseif kind == "effect" and type(c.key) == "string" and BattleRewards.EFFECTS[c.key] then
		return { kind = "effect", key = c.key, seconds = BattleRewards.EFFECTS[c.key].seconds }
	end
	return nil
end

-- Assainit un pendingPick lu dans un profil : table valide (3 cartes de catégories distinctes, expires numérique) ou nil. IDEMPOTENT : sanitize(sanitize(x)) == sanitize(x).
function BattleRewards.sanitizePending(Config, saved)
	if type(saved) ~= "table" or type(saved.cards) ~= "table" or not isnum(saved.expires) then
		return nil
	end
	if not (type(saved.id) == "string" or isnum(saved.id)) then
		return nil
	end
	local cards, seen = {}, {}
	for _, c in ipairs(saved.cards) do
		local cc = cleanCard(Config, c)
		if cc and not seen[cc.kind] and #cards < BattleRewards.CARD_COUNT then
			seen[cc.kind] = true
			cards[#cards + 1] = cc
		end
	end
	if #cards ~= BattleRewards.CARD_COUNT then
		return nil
	end
	local mode = type(saved.mode) == "string" and BattleRewards.MODE_MUL[saved.mode] and saved.mode or "normal"
	return { id = saved.id, cards = cards, expires = int(saved.expires, 0, 4e9, 0), floor = int(saved.floor, 0, BattleRewards.MAX_FLOOR, 0), mode = mode }
end

-- Boosts temporaires : { income2, luck10, xp2, speed15 } = os.time() de fin (entier). Clés inconnues supprimées, valeurs <= 0 supprimées. IDEMPOTENT.
function BattleRewards.sanitizeBoosts(saved)
	local out = {}
	if type(saved) == "table" then
		for _, key in ipairs(BattleRewards.EFFECT_KEYS) do
			local v = saved[key]
			if isnum(v) and v > 0 then
				out[key] = int(v, 1, 4e9, 1)
			end
		end
	end
	return out
end

function BattleRewards.boostActive(boosts, key, now)
	return type(boosts) == "table" and isnum(boosts[key]) and isnum(now) and boosts[key] > now
end

-- Applique (ou prolonge) un boost : jamais cumulé avec lui-même, fin plafonnée à now + 30 min. Retourne la nouvelle fin.
function BattleRewards.applyBoost(boosts, key, seconds, now)
	local def = BattleRewards.EFFECTS[key]
	if type(boosts) ~= "table" or not def or not isnum(now) then
		return nil
	end
	local sec = isnum(seconds) and math.max(0, math.min(BattleRewards.BOOST_CAP_SECONDS, seconds)) or def.seconds
	local cur = isnum(boosts[key]) and boosts[key] or 0
	local ends = math.min(now + BattleRewards.BOOST_CAP_SECONDS, math.max(now, cur) + sec)
	boosts[key] = math.floor(ends)
	return boosts[key]
end

---------------------------------------------------------------- Attribution (serveur)
-- data = profil { coins, speed, boosts, slots, battle = { team } } ; hooks.giveEgg(tier) -> true si l'œuf est placé (base pleine -> false : son prix en pièces).
-- Retourne un résumé { kind, coins?, xp?, speed?, egg?, effect?, converted?, levelUps? } pour l'écran de résultat. N'effleure JAMAIS data.rb ni un champ payant.
function BattleRewards.grant(Config, data, card, hooks, now, PetXp)
	local c = cleanCard(Config, card)
	if not c or type(data) ~= "table" then
		return nil
	end
	local out = { kind = c.kind }
	if c.kind == "coins" then
		data.coins = (isnum(data.coins) and data.coins or 0) + c.amount
		out.coins = c.amount
	elseif c.kind == "xp" then
		out.xp = c.amount
		out.pets = {}
		if PetXp and type(data.battle) == "table" then
			out.pets = PetXp.addToTeam(data.slots, data.battle.team, c.amount)
		end
	elseif c.kind == "speed" then
		data.speed = (isnum(data.speed) and data.speed or 0) + c.amount
		out.speed = c.amount
	elseif c.kind == "egg" then
		local placed = type(hooks) == "table" and type(hooks.giveEgg) == "function" and hooks.giveEgg(c.tier) == true
		if placed then
			out.egg = c.tier
		else
			local price = type(Config.eggCoinValue) == "function" and Config.eggCoinValue(c.tier) or 0
			data.coins = (isnum(data.coins) and data.coins or 0) + price
			out.coins, out.converted, out.egg = price, true, c.tier
		end
	else
		if type(data.boosts) ~= "table" then
			data.boosts = {}
		end
		out.effect = c.key
		out.endsAt = BattleRewards.applyBoost(data.boosts, c.key, c.seconds, now)
	end
	return out
end

---------------------------------------------------------------- Affichage (texte sans état, utilisable par le serveur pour la vue)
function BattleRewards.cardText(Config, card)
	local fmt = type(Config) == "table" and type(Config.fmt) == "function" and Config.fmt or tostring
	local c = type(card) == "table" and card or {}
	if c.kind == "coins" then
		return "🪙", "Pièces", "+" .. fmt(c.amount or 0) .. " 🪙"
	elseif c.kind == "xp" then
		return "⭐", "Expérience", "+" .. tostring(c.amount or 0) .. " XP à chaque pet de l'équipe"
	elseif c.kind == "egg" then
		local t = type(Config) == "table" and type(Config.TIERS) == "table" and Config.TIERS[c.tier or 0] or nil
		return "🥚", "Œuf", "1 œuf " .. (t and t.name or "?")
	elseif c.kind == "speed" then
		return "👟", "Vitesse", "+" .. tostring(c.amount or 0) .. " de vitesse permanente"
	elseif c.kind == "effect" then
		local e = BattleRewards.EFFECTS[c.key or ""]
		return "✨", "Effet", e and (e.name .. " · " .. math.floor(e.seconds / 60) .. " min") or "?"
	end
	return "?", "?", ""
end

-- Vue envoyée au client : AUCUNE donnée de tirage (graine) ; juste de quoi afficher et renvoyer l'index choisi.
function BattleRewards.view(Config, pick, now)
	local cards = {}
	for i, c in ipairs(pick.cards) do
		local icon, title, desc = BattleRewards.cardText(Config, c)
		cards[i] = { kind = c.kind, icon = icon, title = title, desc = desc, boss = c.kind == "egg" and pick.floor % 5 == 0 and pick.floor > 0 and pick.mode ~= "npc" or nil }
	end
	return { id = pick.id, cards = cards, seconds = BattleRewards.remaining(pick, now), floor = pick.floor }
end

return BattleRewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX127"><Properties><string name="Name">Duel</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Duel   (lot 13, E.1 E.2 E.4, B.4)
-- Règles PURES du duel local et des ligues (aucun service Roblox, aucun require, horloge injectée, jamais d'erreur sur entrée invalide). Pas de += ni de continue (lanceur lupa).
-- Le serveur (Main.server.lua) fait les effets (placement sur le sable, Battle.turn, notifications) ; ce module décide.
--   Duel.canChallenge(ctx, cfg)        -> ok, raison, côté ("a" défieur | "b" défié)   [6 refus de E.2 + soi-même + occupé]
--   Duel.newBook() / request / answer / decline / expire / finish   -> carnet des défis (délai 20 s, un seul accepté)
--   Duel.newMatch / noteTurn            -> compteur d'inactivité : 2 tours sans action = forfait
--   Duel.settle(duelA, duelB, ...)      -> récompenses (10/jour, 3/paire/jour), ratio V/D ; AUCUN trophée
--   Duel.percent / record / recordFor   -> ratio « 124 V / 37 D (77 %) » (même formule que IntroPlan)
--   Duel.league / seasonReset / seasonReward / introSide -> ligues, saison, données d'intro B.4
local Duel = {}

Duel.CAP = 10000000
Duel.REASONS = { "self", "range", "egg", "chased", "dialogue", "castle", "newbie", "busy", "flying", "cinematic" }

local DEFAULT = { range = 30, requestTimeout = 20, sameTargetCooldown = 120, rewardedPerDay = 10, samePairRewardedPerDay = 3, turnSeconds = 10, afkTurnsToForfeit = 2, coinsWinMins = 1, coinsLoseMins = 0.25, maxPendingPerTarget = 3, maxCoins = 1e12 }

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function cfgOf(cfg)
	local c = {}
	for k, v in pairs(DEFAULT) do
		c[k] = v
	end
	if type(cfg) == "table" then
		for k, v in pairs(cfg) do
			if DEFAULT[k] ~= nil and isNum(v) then
				c[k] = v
			end
		end
	end
	return c
end

local function count(v)
	if not isNum(v) or v < 0 then
		return 0
	end
	return math.min(Duel.CAP, math.floor(v))
end

-- ---------------------------------------------------------------- Ratio
function Duel.percent(wins, losses)
	local w, l = count(wins), count(losses)
	return math.floor(100 * w / math.max(1, w + l) + 0.5)
end

function Duel.record(wins, losses)
	local w, l = count(wins), count(losses)
	return w .. " V / " .. l .. " D (" .. Duel.percent(w, l) .. " %)"
end

-- Victoires/défaites selon le mode (B.4). profile = battle (données du joueur) ; PNJ : passer { wins, losses } fixes au lieu d'un profil.
-- pvp = battle.pvp.wins/losses + battle.live.w/l ; duel = battle.duel.w/l ; pve = battle.pve.w/l ; tower = étage atteint (V = étages franchis, D = 0).
function Duel.recordFor(mode, battle)
	local b = type(battle) == "table" and battle or {}
	if mode == "duel" then
		local d = type(b.duel) == "table" and b.duel or {}
		return count(d.w), count(d.l)
	elseif mode == "pvp" then
		local p = type(b.pvp) == "table" and b.pvp or {}
		local lv = type(b.live) == "table" and b.live or {}
		return math.min(Duel.CAP, count(p.wins) + count(lv.w)), math.min(Duel.CAP, count(p.losses) + count(lv.l))
	elseif mode == "pve" then
		local d = type(b.pve) == "table" and b.pve or {}
		return count(d.w), count(d.l)
	elseif mode == "tower" then
		return count(b.best), 0
	elseif mode == "npc" then
		return count(b.wins), count(b.losses)
	end
	return 0, 0
end

-- ---------------------------------------------------------------- Ligues
-- leagues = Config.LEAGUES (liste triée par min croissant). Retourne l'entrée de la ligue (la plus haute dont min <= trophées), jamais nil si la liste est valide.
function Duel.league(leagues, trophies)
	local t = isNum(trophies) and math.max(0, math.floor(trophies)) or 0
	local best, idx
	if type(leagues) ~= "table" then
		return nil, 0
	end
	for i = 1, #leagues do
		local L = leagues[i]
		if type(L) == "table" and isNum(L.min) and t >= L.min and (best == nil or L.min >= best.min) then
			best, idx = L, i
		end
	end
	return best, idx or 0
end

-- Texte de ligue pour l'intro (IntroPlan : 16 caractères max) : « 🥇 Or ».
function Duel.leagueText(leagues, trophies)
	local L = Duel.league(leagues, trophies)
	if not L then
		return ""
	end
	return ((type(L.icon) == "string" and L.icon ~= "") and (L.icon .. " ") or "") .. tostring(L.name)
end

-- Remise partielle de saison (E.4) : sous 300 inchangé ; au-delà trophées = max(300, floor(trophées x 0,6)).
function Duel.seasonReset(trophies, from, factor)
	local t = isNum(trophies) and math.max(0, math.floor(trophies)) or 0
	local f = isNum(from) and from or 300
	local k = isNum(factor) and factor or 0.6
	if t <= f then
		return t
	end
	return math.max(f, math.floor(t * k))
end

-- Meilleure récompense dont le seuil est atteint (rewards triées par trophées croissants).
function Duel.seasonReward(rewards, trophies)
	local t = isNum(trophies) and trophies or 0
	local best
	if type(rewards) ~= "table" then
		return nil
	end
	for i = 1, #rewards do
		local r = rewards[i]
		if type(r) == "table" and isNum(r.trophies) and t >= r.trophies and (best == nil or r.trophies >= best.trophies) then
			best = r
		end
	end
	return best
end

-- Un côté de l'intro (B.4) à passer à IntroPlan.plan : { name, userId, wins, losses, league, trophies, pets }.
function Duel.introSide(mode, battle, base, leagues)
	local w, l = Duel.recordFor(mode, battle)
	local b = type(base) == "table" and base or {}
	local tr = count(b.trophies)
	return { name = b.name, userId = b.userId, wins = w, losses = l, league = Duel.leagueText(leagues, tr), trophies = tr, pets = b.pets }
end

-- ---------------------------------------------------------------- Défi : 6 cas de refus (E.2) + soi-même + occupé
-- ctx = { a = { userId, carryingEgg, chased, inDialogue, inCastle, newbie, busy, flying, inCinematic }, b = { même forme }, distance = studs }
-- Intégration lot 13 : `flying` (vol d'œuf en cours) et `inCinematic` (grande éclosion) ajoutés après les 6 cas de E.2.
-- newbie = protection débutant ACTIVE (déjà non désactivée). Retourne true | false, raison, "a"|"b".
function Duel.canChallenge(ctx, cfg)
	local c = cfgOf(cfg)
	if type(ctx) ~= "table" or type(ctx.a) ~= "table" or type(ctx.b) ~= "table" then
		return false, "busy", "a"
	end
	if ctx.a.userId ~= nil and ctx.a.userId == ctx.b.userId then
		return false, "self", "a"
	end
	if not isNum(ctx.distance) or ctx.distance > c.range or ctx.distance < 0 then
		return false, "range", "b"
	end
	local keys = { { "carryingEgg", "egg" }, { "chased", "chased" }, { "inDialogue", "dialogue" }, { "inCastle", "castle" }, { "newbie", "newbie" }, { "busy", "busy" }, { "flying", "flying" }, { "inCinematic", "cinematic" } }
	local sides = { { "a", ctx.a }, { "b", ctx.b } }
	for k = 1, #keys do
		for s = 1, 2 do
			if sides[s][2][keys[k][1]] == true then
				return false, keys[k][2], sides[s][1]
			end
		end
	end
	return true, "", ""
end

-- ---------------------------------------------------------------- Carnet des défis
-- book = { pending = { [challengerId] = { from, to, t } }, last = { ["from>to"] = t }, active = { [userId] = duelId }, nextId }
function Duel.newBook()
	return { pending = {}, last = {}, active = {}, nextId = 1 }
end

local function pendingFor(book, to)
	local n = 0
	for _, p in pairs(book.pending) do
		if p.to == to then
			n = n + 1
		end
	end
	return n
end

-- Envoie un défi. ctx comme canChallenge (+ ctx.a.userId, ctx.b.userId nombres). Retourne true | false, raison.
function Duel.request(book, ctx, now, cfg)
	local c = cfgOf(cfg)
	if type(book) ~= "table" or type(ctx) ~= "table" or type(ctx.a) ~= "table" or type(ctx.b) ~= "table" or not isNum(ctx.a.userId) or not isNum(ctx.b.userId) or not isNum(now) then
		return false, "busy"
	end
	local from, to = ctx.a.userId, ctx.b.userId
	if book.active[from] or book.active[to] then
		return false, "busy"
	end
	local ok, why = Duel.canChallenge(ctx, c)
	if not ok then
		return false, why
	end
	local last = book.last[from .. ">" .. to]
	if last and now - last < c.sameTargetCooldown then
		return false, "cooldown"
	end
	local mine = book.pending[from]
	if mine and now - mine.t < c.requestTimeout then
		return false, "pendingOut"
	end
	if pendingFor(book, to) >= c.maxPendingPerTarget then
		return false, "crowded"
	end
	book.pending[from] = { from = from, to = to, t = now }
	book.last[from .. ">" .. to] = now
	return true, ""
end

-- Le défié accepte le défi de `from`. Un seul défi accepté : tous les autres défis qui touchent l'un des deux sont annulés (retournés).
-- Retourne true, duelId, annulés | false, raison.
function Duel.answer(book, to, from, accept, now, cfg, ctx)
	local c = cfgOf(cfg)
	local p = type(book) == "table" and isNum(from) and book.pending[from] or nil
	if not p or p.to ~= to or not isNum(now) then
		return false, "none"
	end
	if now - p.t > c.requestTimeout then
		book.pending[from] = nil
		return false, "expired"
	end
	if not accept then
		book.pending[from] = nil
		return false, "declined"
	end
	if book.active[from] or book.active[to] then
		book.pending[from] = nil
		return false, "busy"
	end
	if ctx ~= nil then
		local ok, why = Duel.canChallenge(ctx, c) -- états relus à l'acceptation
		if not ok then
			book.pending[from] = nil
			return false, why
		end
	end
	book.pending[from] = nil
	local id = book.nextId
	book.nextId = id + 1
	book.active[from], book.active[to] = id, id
	local cancelled = {}
	for k, q in pairs(book.pending) do
		if q.from == from or q.to == from or q.from == to or q.to == to then
			cancelled[#cancelled + 1] = { from = q.from, to = q.to }
			book.pending[k] = nil
		end
	end
	return true, id, cancelled
end

function Duel.decline(book, to, from, now, cfg)
	return Duel.answer(book, to, from, false, now, cfg)
end

-- Défis expirés (à appeler toutes les secondes) : retourne la liste { from, to } retirée.
function Duel.expire(book, now, cfg)
	local c = cfgOf(cfg)
	local out = {}
	if type(book) ~= "table" or not isNum(now) then
		return out
	end
	for k, p in pairs(book.pending) do
		if now - p.t > c.requestTimeout then
			out[#out + 1] = { from = p.from, to = p.to }
			book.pending[k] = nil
		end
	end
	return out
end

-- Fin ou départ : libère les deux joueurs et retire leurs défis en attente (joueur qui quitte).
function Duel.finish(book, userId)
	if type(book) ~= "table" then
		return
	end
	local id = book.active[userId]
	if id then
		for u, v in pairs(book.active) do
			if v == id then
				book.active[u] = nil
			end
		end
	end
	for k, p in pairs(book.pending) do
		if p.from == userId or p.to == userId then
			book.pending[k] = nil
		end
	end
end

-- Purge les anciennes dates de cooldown (évite la croissance de la table).
function Duel.prune(book, now, cfg)
	local c = cfgOf(cfg)
	if type(book) ~= "table" or not isNum(now) then
		return
	end
	for k, t in pairs(book.last) do
		if now - t >= c.sameTargetCooldown then
			book.last[k] = nil
		end
	end
end

-- ---------------------------------------------------------------- Tours et forfait
function Duel.newMatch(idA, idB)
	return { a = idA, b = idB, afkA = 0, afkB = 0, turns = 0, over = false, winner = nil, reason = "" }
end

-- Enregistre un tour : actedA/actedB = le joueur a choisi une action avant la fin des 10 s. Une action remet le compteur à 0.
-- Retourne "continue" | "forfeitA" | "forfeitB" | "cancelled" (les deux inactifs en même temps : duel annulé, ni vainqueur ni récompense).
function Duel.noteTurn(m, actedA, actedB, cfg)
	local c = cfgOf(cfg)
	if type(m) ~= "table" or m.over then
		return "continue"
	end
	m.turns = m.turns + 1
	m.afkA = actedA and 0 or (m.afkA + 1)
	m.afkB = actedB and 0 or (m.afkB + 1)
	local fa, fb = m.afkA >= c.afkTurnsToForfeit, m.afkB >= c.afkTurnsToForfeit
	if fa and fb then
		m.over, m.reason = true, "cancelled"
		return "cancelled"
	elseif fa then
		m.over, m.winner, m.reason = true, "b", "forfeit"
		return "forfeitA"
	elseif fb then
		m.over, m.winner, m.reason = true, "a", "forfeit"
		return "forfeitB"
	end
	return "continue"
end

-- ---------------------------------------------------------------- Récompenses et ratio
-- Profil de duel assaini : { w, l, day, n, pairs = { [idAdversaire texte] = nombre } }. Les paires ne contiennent que des duels récompensés (<= rewardedPerDay clés).
function Duel.cleanState(raw, today)
	local d = type(raw) == "table" and raw or {}
	local day = isNum(d.day) and math.floor(d.day) or 0
	local out = { w = count(d.w), l = count(d.l), day = day, n = 0, pairs = {} }
	if day == today then
		out.n = math.min(1000, count(d.n))
		if type(d.pairs) == "table" then
			local k = 0
			for key, v in pairs(d.pairs) do
				if type(key) == "string" and isNum(v) and v >= 1 and k < 20 then
					out.pairs[key] = math.min(1000, math.floor(v))
					k = k + 1
				end
			end
		end
	else
		out.day = isNum(today) and today or day
	end
	return out
end

function Duel.coins(incomePerSec, minutes, cfg)
	local c = cfgOf(cfg)
	if not isNum(incomePerSec) or incomePerSec <= 0 or not isNum(minutes) or minutes <= 0 then
		return 0
	end
	return math.min(c.maxCoins, math.floor(incomePerSec * 60 * minutes))
end

-- Solde un duel pour UN joueur. state = battle.duel (modifié), oppId = userId adversaire, outcome = "win" | "loss" | "draw", now, incomePerSec.
-- Le ratio (w/l) est toujours compté (sauf annulé) ; les pièces seulement si quota du jour (10) ET quota de la paire (3) non atteints.
-- Retourne { rewarded, coins, reason, won }. NE TOUCHE JAMAIS aux trophées (aucun champ trophée n'existe ici).
function Duel.settle(state, oppId, outcome, now, incomePerSec, cfg)
	local c = cfgOf(cfg)
	local today = isNum(now) and math.floor(now / 86400) or 0
	local clean = Duel.cleanState(state, today)
	if type(state) == "table" then
		state.w, state.l, state.day, state.n, state.pairs = clean.w, clean.l, clean.day, clean.n, clean.pairs
	else
		state = clean
	end
	if outcome ~= "win" and outcome ~= "loss" then
		return { rewarded = false, coins = 0, reason = "draw", won = false }
	end
	local won = outcome == "win"
	if won then
		state.w = math.min(Duel.CAP, state.w + 1)
	else
		state.l = math.min(Duel.CAP, state.l + 1)
	end
	local key = tostring(isNum(oppId) and math.floor(oppId) or 0)
	local pair = state.pairs[key] or 0
	if state.n >= c.rewardedPerDay then
		return { rewarded = false, coins = 0, reason = "dayCap", won = won }
	end
	if pair >= c.samePairRewardedPerDay then
		return { rewarded = false, coins = 0, reason = "pairCap", won = won }
	end
	state.n = state.n + 1
	state.pairs[key] = pair + 1
	return { rewarded = true, coins = Duel.coins(incomePerSec, won and c.coinsWinMins or c.coinsLoseMins, c), reason = "", won = won }
end

-- ---------------------------------------------------------------- Vues en miroir (intégration lot 13)
-- Battle.view et les événements sont écrits du point de vue du camp 1 (le défieur) ; le défié reçoit la vue inversée (son équipe en camp 1).
function Duel.mirrorView(v)
	if type(v) ~= "table" or type(v.sides) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = x
	end
	out.sides = { v.sides[2], v.sides[1] }
	if v.winner == 1 or v.winner == 2 then
		out.winner = 3 - v.winner
	end
	return out
end

function Duel.mirrorEvents(events)
	local out = {}
	if type(events) ~= "table" then
		return out
	end
	for i, ev in ipairs(events) do
		local c = {}
		if type(ev) == "table" then
			for k, x in pairs(ev) do
				c[k] = x
			end
			if c.side == 1 or c.side == 2 then
				c.side = 3 - c.side
			end
		end
		out[i] = c
	end
	return out
end

-- Intention reçue du client (texte) -> action Battle, ou nil (« attack », « skill », « swap1 » à « swap3 »).
function Duel.parseAction(arg)
	if arg == "attack" or arg == "skill" then
		return { kind = arg }
	end
	if type(arg) == "string" and #arg <= 8 then
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			return { kind = "swap", to = n }
		end
	end
	return nil
end

-- Pièces réellement versées : un duel terminé par départ ou abandon avant `minTurns` tours ne paie personne (anti-collusion : un complice qui quitte
-- tout de suite n'offre rien). Le ratio V/D et les quotas restent comptés par Duel.settle.
function Duel.payable(res, turns, early, minTurns)
	if type(res) ~= "table" or not res.rewarded or not isNum(res.coins) or res.coins <= 0 then
		return 0
	end
	if early == true and (not isNum(turns) or turns < (isNum(minTurns) and minTurns or 3)) then
		return 0
	end
	return res.coins
end

-- Aide : issue d'un match vue de chaque côté ("win"/"loss"/"draw").
function Duel.outcomes(m)
	if type(m) ~= "table" or not m.over or m.winner == nil then
		return "draw", "draw"
	end
	if m.winner == "a" then
		return "win", "loss"
	end
	return "loss", "win"
end

return Duel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX128"><Properties><string name="Name">Ranked</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Ranked
-- LOT 14 : classé EN DIRECT (file MemoryStore, serveur réservé « ranked »). Logique PURE : aucune API Roblox, aucun yield, aucune erreur levée
-- sur une entrée invalide (valeurs de retour). Testé par tests/lot14.luau (Lune ou lupa). Le transport (MemoryStore, TeleportService) est dans
-- ServerScriptService/PvpLive.lua, qui n'appelle ces règles qu'à travers des fonctions de transformation (UpdateAsync) et des décisions.
--
-- Décisions (cahier LOTS_9_PLUS E.3 / E.4 / K « Lot 14 », décision utilisateur) :
--   * la file en direct est FERMÉE tant que les joueurs simultanés de l'expérience sont < cfg.minCCU (60) ou que cfg.enabled = false ;
--     elle est aussi fermée si le comptage est inconnu ou périmé (échec = fermé) : le classé reste alors sur le mode asynchrone existant ;
--   * aucun trophée ne bouge si les deux joueurs ne sont pas présents dans le serveur d'arène au départ (match annulé, quota rendu) ;
--   * déconnexion ou abandon pendant le combat = FORFAIT : le partant perd ; le restant gagne, sauf forfait avant cfg.minTurnsForGain tours
--     (anti-« nourrissage » entre deux comptes : 0 trophée pour le gagnant, le partant perd quand même) ;
--   * jamais le même adversaire deux fois en cfg.rematchCooldown secondes, jamais deux comptes ayant partagé un serveur dans les cfg.peerWindow
--     dernières secondes, jamais deux entrées du même serveur ;
--   * gains plafonnés à cfg.dailyTrophyCap trophées par jour UTC (pertes non plafonnées, bornées par le solde), cfg.dailyFights combats par jour ;
--   * rien d'achetable n'entre ici : ni Robux, ni pass, ni boost (la puissance d'équipe vient des stats brutes de Battle.unit).
local Ranked = {}

local function num(v, default)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function int(v, default, lo, hi)
	local n = math.floor(num(v, default))
	if lo and n < lo then
		n = lo
	end
	if hi and n > hi then
		n = hi
	end
	return n
end

local function isUid(v)
	return type(v) == "number" and v == v and v % 1 == 0 and v > 0 and v < 2 ^ 53
end
Ranked.isUid = isUid

local function contains(list, v)
	if type(list) ~= "table" then
		return false
	end
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

---------------------------------------------------------------- jour, ligues
function Ranked.day(now)
	return math.floor(num(now, 0) / 86400)
end

-- Ligue d'un nombre de trophées (Config.LEAGUES trié par `min` croissant) : retourne (ligue, indice). Valeur invalide = première ligue.
function Ranked.league(leagues, trophies)
	local t = num(trophies, 0)
	local best, idx = leagues[1], 1
	for i, l in ipairs(leagues) do
		if t >= l.min then
			best, idx = l, i
		end
	end
	return best, idx
end

-- Remise partielle de saison (E.4, OPTIONNELLE : non branchée par les patchs, le jeu garde `trophées // 4`) : au-delà de `floorAt`,
-- trophées = floor(trophées × keep), sans jamais redescendre sous `floorAt`.
function Ranked.seasonReset(trophies, keep, floorAt)
	local t = math.max(0, math.floor(num(trophies, 0)))
	floorAt = floorAt or 300
	if t <= floorAt then
		return t
	end
	return math.max(floorAt, math.floor(t * (keep or 0.6)))
end

---------------------------------------------------------------- ouverture de la file (seuil de joueurs simultanés)
-- Somme des comptes publiés par les serveurs (SortedMap PvpCcu_v1 : { n, t }) encore frais. Entrées invalides ignorées.
function Ranked.ccuSum(entries, now, ttl)
	local total, servers = 0, 0
	if type(entries) ~= "table" then
		return 0, 0
	end
	for _, e in ipairs(entries) do
		local v = type(e) == "table" and (e.value or e) or nil
		if type(v) == "table" and type(v.n) == "number" and type(v.t) == "number" and now - v.t <= ttl and v.n >= 0 and v.n <= 200 then
			total = total + math.floor(v.n)
			servers = servers + 1
		end
	end
	return total, servers
end

-- La file en direct est-elle ouverte ? rec = { n = joueurs simultanés, t = date du comptage } écrit par l'apparieur. Retourne (bool, raison).
function Ranked.liveOpen(cfg, rec, now)
	if not cfg or cfg.enabled ~= true then
		return false, "disabled"
	end
	if type(rec) ~= "table" or type(rec.n) ~= "number" or type(rec.t) ~= "number" or now - rec.t > cfg.ccuTtl or rec.t > now + 5 then
		return false, "unknown" -- comptage absent ou périmé : fermé (jamais de file vide qui frustre)
	end
	if rec.n < cfg.minCCU then
		return false, "low_ccu"
	end
	return true, "open"
end

---------------------------------------------------------------- profil : champ battle.live
-- battle.live = { day, fights, gained, w, l, recent = { { u = userId, t = date } } } : compteurs du jour UTC et derniers adversaires.
function Ranked.sanitizeLive(v, cfg)
	local maxRecent = (cfg and cfg.recentMax) or 20
	local out = { day = 0, fights = 0, gained = 0, w = 0, l = 0, recent = {} }
	if type(v) ~= "table" then
		return out
	end
	out.day = int(v.day, 0, 0, 1e7)
	out.fights = int(v.fights, 0, 0, 1000)
	out.gained = int(v.gained, 0, 0, 1e6)
	out.w = int(v.w, 0, 0, 1e7)
	out.l = int(v.l, 0, 0, 1e7)
	if type(v.recent) == "table" then
		for _, r in ipairs(v.recent) do
			if #out.recent >= maxRecent then
				break
			end
			if type(r) == "table" and isUid(r.u) and type(r.t) == "number" and r.t == r.t then
				out.recent[#out.recent + 1] = { u = r.u, t = math.floor(r.t) }
			end
		end
	end
	return out
end

-- Remet les compteurs du jour à zéro si le jour UTC a changé. Retourne live (modifié en place).
function Ranked.liveDay(live, now)
	local d = Ranked.day(now)
	if live.day ~= d then
		live.day, live.fights, live.gained = d, 0, 0
	end
	return live
end

-- Adversaires récents encore bloqués (liste d'userId) ; nettoie la liste au passage.
function Ranked.recentOpponents(cfg, live, now)
	local keep, out = {}, {}
	for _, r in ipairs(live.recent or {}) do
		if now - r.t < cfg.rematchCooldown then
			keep[#keep + 1] = r
			out[#out + 1] = r.u
		end
	end
	live.recent = keep
	return out
end

function Ranked.recordOpponent(cfg, live, uid, now)
	if not isUid(uid) then
		return
	end
	Ranked.recentOpponents(cfg, live, now)
	local keep = {}
	for _, r in ipairs(live.recent) do
		if r.u ~= uid then
			keep[#keep + 1] = r
		end
	end
	keep[#keep + 1] = { u = uid, t = math.floor(now) }
	while #keep > cfg.recentMax do
		table.remove(keep, 1)
	end
	live.recent = keep
end

---------------------------------------------------------------- équipe figée et puissance
-- Équipe { {p,s,m} } assainie contre Config.PETS (espèce connue, 3 pets au plus). Seuls p, s, m sont gardés : aucun bonus ne passe.
function Ranked.sanitizeTeam(Config, team, size)
	local out = {}
	size = size or 3
	if type(team) ~= "table" then
		return out
	end
	for _, e in ipairs(team) do
		if #out >= size then
			break
		end
		if type(e) == "table" and type(e.p) == "number" and e.p % 1 == 0 and Config.PETS[e.p] then
			local s = (type(e.s) == "string" and #e.s <= 16) and e.s or nil
			local m = (type(e.m) == "string" and #e.m <= 16) and e.m or nil
			out[#out + 1] = { p = e.p, s = s, m = m }
		end
	end
	return out
end

-- Puissance d'équipe : somme de Battle.power des unités BRUTES (Battle.unit sans échelle ni boost hebdomadaire).
function Ranked.teamPower(Battle, Config, team)
	local total = 0
	for _, e in ipairs(team) do
		local u = Battle.unit(Config, e)
		total = total + Battle.power({ hp = u.maxHp, atk = u.atk, spd = u.spd })
	end
	return total
end

---------------------------------------------------------------- entrée en file
-- Le joueur peut-il entrer en file en direct ? ctx (calculé par le SERVEUR) :
--   { open, busy, serverMode, team (assainie), live (assaini, jour courant), trophies, hasDefense }
-- Retourne (true) ou (false, raison) ; raison = "closed" | "busy" | "mode" | "team" | "fights" | "cap".
function Ranked.canQueue(cfg, ctx)
	if not ctx.open then
		return false, "closed"
	end
	if ctx.busy then
		return false, "busy"
	end
	if ctx.serverMode == "ranked" or ctx.serverMode == "castle" then
		return false, "mode"
	end
	if type(ctx.team) ~= "table" or #ctx.team == 0 then
		return false, "team"
	end
	if ctx.live.fights >= cfg.dailyFights then
		return false, "fights"
	end
	if ctx.live.gained >= cfg.dailyTrophyCap then
		return false, "cap"
	end
	return true
end

-- Entrée écrite dans la SortedMap (clé "u"..uid, clé de tri = trophées). `since` = première entrée (gardée lors d'une remise en file).
function Ranked.makeEntry(cfg, a)
	local function ids(list, max)
		local out = {}
		for _, v in ipairs(type(list) == "table" and list or {}) do
			if isUid(v) and #out < max then
				out[#out + 1] = v
			end
		end
		return out
	end
	return {
		u = a.uid,
		tr = int(a.trophies, 0, 0, 100000),
		pow = math.max(1, num(a.power, 1)),
		job = tostring(a.job or ""),
		party = type(a.party) == "string" and a.party or nil,
		t = a.since,
		r = a.now,
		team = a.team,
		peers = ids(a.peers, cfg.peersMax),
		opp = ids(a.opp, cfg.recentMax),
		name = tostring(a.name or "?"):sub(1, 24),
	}
end

-- Entrée lue depuis la file : forme minimale vérifiée (le contenu est écrit par nos serveurs, mais la file est partagée : on reste prudent).
-- Une entrée non rafraîchie depuis 3 rafraîchissements (30 s) est ignorée même si le MemoryStore ne l'a pas encore effacée (90 s) :
-- un joueur parti, déjà en téléportation ou dont le serveur est tombé n'est plus proposé.
function Ranked.validEntry(cfg, e, now)
	return type(e) == "table"
		and isUid(e.u)
		and type(e.tr) == "number"
		and type(e.pow) == "number"
		and e.pow > 0
		and type(e.t) == "number"
		and type(e.r) == "number"
		and now - e.r <= math.min(cfg.queueTtl, 3 * cfg.refresh)
		and type(e.job) == "string"
		and type(e.team) == "table"
		and #e.team > 0
end

---------------------------------------------------------------- appariement
-- Fenêtre de trophées après `waited` secondes : base + step × floor(waited / every), plafonnée à max.
function Ranked.trophyWindow(cfg, waited)
	local w = cfg.trophyWindow
	return math.min(w.max, w.base + w.step * math.floor(math.max(0, waited) / w.every))
end

-- Bornes du rapport de puissance (élargies après power.wideAfter secondes).
function Ranked.powerBounds(cfg, waited)
	local p = cfg.power
	if waited >= p.wideAfter then
		return p.wideLo, p.wideHi
	end
	return p.lo, p.hi
end

-- Deux entrées peuvent-elles s'affronter ? Les DEUX doivent accepter : on prend la plus courte attente (la fenêtre la plus étroite).
-- Retourne (bool, raison).
function Ranked.compatible(cfg, a, b, now)
	if a.u == b.u then
		return false, "self"
	end
	if a.m or b.m then
		return false, "taken"
	end
	if a.job ~= "" and a.job == b.job then
		return false, "same_server"
	end
	if contains(a.peers, b.u) or contains(b.peers, a.u) then
		return false, "peers"
	end
	if contains(a.opp, b.u) or contains(b.opp, a.u) then
		return false, "rematch"
	end
	local waited = math.min(now - a.t, now - b.t)
	if math.abs(a.tr - b.tr) > Ranked.trophyWindow(cfg, waited) then
		return false, "trophies"
	end
	local lo, hi = Ranked.powerBounds(cfg, waited)
	local ratio = a.pow / b.pow
	if ratio < lo or ratio > hi then
		return false, "power"
	end
	return true
end

-- Paires { {a, b} } depuis une liste d'entrées : le plus ancien en file d'abord ; pour lui, l'adversaire compatible le plus proche en trophées
-- (égalité : le plus ancien, puis le plus petit userId). Chaque joueur apparaît au plus UNE fois. Entrées invalides ou périmées ignorées.
function Ranked.pairUp(cfg, entries, now)
	local list, seen = {}, {}
	for _, e in ipairs(entries) do
		if Ranked.validEntry(cfg, e, now) and not e.m and not seen[e.u] then
			seen[e.u] = true
			list[#list + 1] = e
		end
	end
	table.sort(list, function(x, y)
		if x.t ~= y.t then
			return x.t < y.t
		end
		return x.u < y.u
	end)
	local used, pairs_ = {}, {}
	for i, a in ipairs(list) do
		if not used[a.u] then
			local best, bestD
			for j = i + 1, #list do
				local b = list[j]
				if not used[b.u] and Ranked.compatible(cfg, a, b, now) then
					local d = math.abs(a.tr - b.tr)
					if not best or d < bestD then
						best, bestD = b, d
					end
				end
			end
			if best then
				used[a.u], used[best.u] = true, true
				pairs_[#pairs_ + 1] = { a = a, b = best }
			end
		end
	end
	return pairs_
end

---------------------------------------------------------------- transformations UpdateAsync (atomiques côté MemoryStore)
-- Bail de l'apparieur : pris si libre, expiré ou déjà à nous. Retourne la nouvelle valeur, ou nil (= ne rien écrire).
function Ranked.leaderTransform(old, job, now, ttl)
	if type(old) ~= "table" or type(old.exp) ~= "number" or old.exp <= now or old.job == job then
		return { job = job, exp = now + ttl }
	end
	return nil
end

function Ranked.isLeader(value, job, now)
	return type(value) == "table" and value.job == job and type(value.exp) == "number" and value.exp > now
end

-- Réserve une entrée de file pour un match : échoue (nil) si l'entrée a disparu (annulée, expirée) ou est déjà prise.
function Ranked.claimTransform(old, matchId)
	if type(old) ~= "table" or old.m ~= nil then
		return nil
	end
	local new = table.clone(old)
	new.m = matchId
	return new
end

-- Annule la réservation (réservation de serveur ratée, second joueur indisponible) : seulement si c'est la nôtre.
function Ranked.releaseTransform(old, matchId)
	if type(old) ~= "table" or old.m ~= matchId then
		return nil
	end
	local new = table.clone(old)
	new.m = nil
	return new
end

-- Rafraîchissement par le serveur du joueur : ne réécrit JAMAIS une entrée déjà réservée par l'apparieur (le ticket arrive).
function Ranked.refreshTransform(old, entry, now)
	if type(old) == "table" and old.m ~= nil then
		return nil
	end
	local new = table.clone(entry)
	new.r = now
	return new
end

---------------------------------------------------------------- match, ticket, serveur d'arène
-- Enregistrement de match (HashMap PvpMatch_v1[id]) : seule source de vérité du serveur d'arène (le TeleportData n'est qu'un indice).
function Ranked.newMatch(cfg, id, a, b, code, psid, seed, now)
	return {
		id = id,
		a = a.u,
		b = b.u,
		na = a.name,
		nb = b.name,
		ta = a.team,
		tb = b.team,
		pa = a.party,
		pb = b.party,
		code = code,
		psid = psid,
		seed = seed,
		t = now,
		exp = now + cfg.matchTtl,
	}
end

function Ranked.newTicket(cfg, match, side, now)
	local mine = side == "a"
	return { match = match.id, code = match.code, opp = mine and match.nb or match.na, side = side, exp = now + cfg.ticketTtl }
end

-- Ticket utilisable par ce serveur pour ce joueur ? (forme, expiration).
function Ranked.ticketValid(t, now)
	return type(t) == "table"
		and type(t.match) == "string"
		and #t.match > 0
		and #t.match <= 64
		and type(t.code) == "string"
		and #t.code > 0
		and type(t.exp) == "number"
		and t.exp > now
		and (t.side == "a" or t.side == "b")
end

-- Admission dans le serveur d'arène : le match existe, n'a pas expiré, a été réservé pour CE serveur (PrivateServerId) et le joueur en fait partie.
-- Retourne (side "a"|"b") ou (nil, raison).
function Ranked.arenaAdmit(match, uid, psid, now)
	if type(match) ~= "table" or type(match.exp) ~= "number" then
		return nil, "no_match"
	end
	if match.exp <= now then
		return nil, "expired"
	end
	if type(match.psid) == "string" and match.psid ~= "" and match.psid ~= psid then
		return nil, "wrong_server"
	end
	if uid == match.a then
		return "a"
	elseif uid == match.b then
		return "b"
	end
	return nil, "not_member"
end

-- État du serveur d'arène. phase : "wait" (attente des deux joueurs) -> "fight" -> "done" ; ou "void" (annulé : personne ne gagne ni ne perd).
function Ranked.arenaNew(match, now)
	return { match = match, phase = "wait", t0 = now, present = {}, turns = 0 }
end

function Ranked.arenaArrive(A, side)
	if A.phase ~= "wait" or (side ~= "a" and side ~= "b") then
		return false
	end
	A.present[side] = true
	return true
end

-- Décision : "start" (les deux là), "void" (délai dépassé avec un absent), "wait" ; hors attente : "fight" pendant le combat, sinon "idle"
-- (un match annulé ou terminé ne redéclenche jamais rien).
function Ranked.arenaTick(cfg, A, now)
	if A.phase ~= "wait" then
		return A.phase == "fight" and "fight" or "idle"
	end
	if A.present.a and A.present.b then
		return "start"
	end
	if now - A.t0 >= cfg.waitArena then
		return "void"
	end
	return "wait"
end

-- Un joueur part. Pendant l'attente : il n'est plus présent (le match sera annulé au délai). Pendant le combat : forfait.
-- Retourne "absent" | "forfeit" | "none".
function Ranked.arenaLeave(A, side)
	if A.phase == "wait" then
		A.present[side] = nil
		return "absent"
	elseif A.phase == "fight" then
		return "forfeit"
	end
	return "none"
end

---------------------------------------------------------------- résultat et trophées
-- Résultat d'un match en direct (les deux joueurs étaient présents au départ, sinon cette fonction n'est jamais appelée).
-- r = { winner = "a"|"b", forfeit = bool, turns = n, a = { trophies, live }, b = { trophies, live } } ; gainFn = Config.pvpGain ; loss = Config.PVP.loss.
-- Retourne { a = delta, b = delta, capped = { a = bool, b = bool }, fed = bool } sans rien modifier.
function Ranked.outcome(cfg, gainFn, loss, r)
	local w, l = r.winner, (r.winner == "a" and "b" or "a")
	local out = { capped = {} }
	local gain = gainFn(r[w].trophies, r[l].trophies)
	if r.forfeit and (r.turns or 0) < cfg.minTurnsForGain then
		gain = 0
		out.fed = true -- forfait trop tôt : rien pour le gagnant (deux comptes ne peuvent pas se « nourrir »)
	end
	local room = math.max(0, cfg.dailyTrophyCap - r[w].live.gained)
	if gain > room then
		gain = room
		out.capped[w] = true
	end
	out[w] = gain
	out[l] = -math.min(math.max(0, r[l].trophies), loss)
	return out
end

-- Applique un delta à pv (battle.pvp) et live (battle.live) d'un joueur. win = bool.
function Ranked.apply(pv, live, delta, win)
	pv.trophies = math.max(0, pv.trophies + delta)
	if win then
		pv.wins = pv.wins + 1
		live.w = live.w + 1
		if delta > 0 then
			live.gained = live.gained + delta
		end
	else
		pv.losses = pv.losses + 1
		live.l = live.l + 1
	end
end

-- Combat consommé au départ (les deux présents) ; un match annulé ne consomme rien.
function Ranked.canFight(cfg, live)
	return live.fights < cfg.dailyFights
end

---------------------------------------------------------------- téléportation, repli, retour
-- Après `attempts` échecs : { retry = délai } tant que attempts <= cfg.teleportRetries, sinon { requeue = true }.
function Ranked.teleportPlan(cfg, attempts)
	if attempts <= cfg.teleportRetries then
		return { retry = cfg.teleportRetryDelay }
	end
	return { requeue = true }
end

-- Repli vers l'asynchrone après cfg.fallbackAfter secondes sans adversaire.
function Ranked.shouldFallback(cfg, since, now)
	return now - since >= cfg.fallbackAfter
end

-- Destination du retour : la partie d'origine si son entrée du registre ChipeParties existe encore (le MemoryStore l'efface à expiration),
-- est ouverte et compte encore le joueur parmi ses membres (le hub ne le retire qu'à son arrivée au hub) ; sinon le hub.
-- (createdAt du registre est un os.clock() du HUB : non comparable depuis un autre serveur, donc non utilisé ici.)
-- Retourne { place = "party", code, partyId } ou { place = "hub", partyId }.
function Ranked.returnPlan(Game, partyId, entry, uid)
	if
		type(partyId) == "string"
		and type(entry) == "table"
		and entry.open
		and type(entry.code) == "string"
		and contains(entry.members, uid)
		and type(entry.count) == "number"
		and entry.count <= math.min(entry.size or Game.MaxPlayers, Game.MaxPlayers)
	then
		return { place = "party", code = entry.code, partyId = partyId }
	end
	return { place = "hub", partyId = type(partyId) == "string" and partyId or nil }
end

---------------------------------------------------------------- combat à deux joueurs : vues en miroir
-- Battle.view et les événements sont écrits du point de vue du camp 1 (camp A) ; le joueur B reçoit la vue inversée.
function Ranked.mirrorView(v)
	local out = table.clone(v)
	out.sides = { v.sides[2], v.sides[1] }
	if v.winner then
		out.winner = 3 - v.winner
	end
	return out
end

function Ranked.mirrorEvents(events)
	local out = {}
	for i, ev in ipairs(events) do
		local c = table.clone(ev)
		if c.side == 1 or c.side == 2 then
			c.side = 3 - c.side
		end
		out[i] = c
	end
	return out
end

-- Action reçue du client (chaîne) -> action Battle, ou nil.
function Ranked.parseAction(arg)
	if arg == "attack" or arg == "skill" then
		return { kind = arg }
	end
	if type(arg) == "string" and #arg <= 8 then
		local n = tonumber(arg:match("^swap(%d)$"))
		if n then
			return { kind = "swap", to = n }
		end
	end
	return nil
end

---------------------------------------------------------------- quotas MemoryStore (E.3)
-- Requêtes par minute estimées : chaque serveur publie son compte et lit l'ouverture (2 × 60/ccuPublish) et tente le bail (60/leaderEvery) ;
-- le leader lit la file (60/leaderEvery) et somme puis écrit les comptes (2 × 60/ccuPublish) ; chaque joueur en file rafraîchit (60/refresh) et
-- interroge son ticket (60/pollTicket) ; chaque match coûte ~8 requêtes (2 réservations, match, 2 tickets, 2 retraits, 1 lecture à l'arène).
-- Limite Roblox : 1000 + 100 × joueurs par minute.
function Ranked.quotaPerMinute(cfg, servers, queued, matchesPerMin)
	local perServer = 2 * 60 / cfg.ccuPublish + 60 / cfg.leaderEvery
	local leader = 60 / cfg.leaderEvery + 2 * 60 / cfg.ccuPublish
	local perQueued = 60 / cfg.refresh + 60 / cfg.pollTicket
	return servers * perServer + leader + queued * perQueued + (matchesPerMin or 0) * 8
end

function Ranked.quotaLimit(players)
	return 1000 + 100 * players
end

return Ranked
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX133"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX131"><Properties><string name="Name">Hub</string><ProtectedString name="Source"><![CDATA[-- Script : ServerScriptService/Hub (lieu HUB uniquement)
-- Zones de lancement (1 à 5 joueurs), file d'attente visible, téléportation vers le lieu de jeu, liste des parties d'amis (registre
-- MemoryStore) et bouton Rejoindre. Toute la logique de décision est dans Party (testée) ; ici : Roblox (joueurs, zones, services).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local MemoryStoreService = game:GetService("MemoryStoreService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
if Config.Game.roleFor(game.PlaceId) == "game" then
	return -- lieu de jeu : le code de la partie (Main) s'en charge
end
local PartyMod = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Party"))
local Placement = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Placement"))
local HubWorld = require(script.Parent:WaitForChild("HubWorld"))

local G = Config.Game
local world = HubWorld.build(Config)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpawnGuard")).attach({
	role = "hub",
	safeCFrame = function()
		return world.spawn.CFrame + Vector3.new(0, 4, 0)
	end,
})

-- Décor catalogue du hub : chargé en arrière-plan (serveur, pcall, délai, scripts retirés) ; un échec ne retire rien (le hub est déjà décoré par le code).
task.spawn(function()
	local assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets")).new(Config, {
		loadAsset = function(id)
			return game:GetService("InsertService"):LoadAsset(id)
		end,
		spawn = task.spawn,
		wait = task.wait,
		clock = os.clock,
		warn = warn,
	})
	local loaded = assets.loadDecor()
	assets.loadProps()
	-- Fontaine Blender sur la place : si elle est posée, la fontaine procédurale est retirée (sinon elle reste : repli)
	local fountain = assets.cloneProp("fountain")
	if fountain and assets.place(fountain, 0, 0, 0, Config.Assets.propsHeight.fountain, world.folder) then
		for _, p in ipairs(world.fountainParts) do
			p:Destroy()
		end
	end
	-- Bancs et lampadaires Blender : chacun remplace son équivalent procédural une fois posé (la lumière des lampadaires reste, boule invisible)
	assets.loadGroup("props", { bench = true, lamp = true })
	local swapped = 0
	for _, b in ipairs(world.benchItems) do
		local clone = assets.cloneModel("props", "bench")
		if clone and assets.place(clone, b.x, b.z, b.rot, Config.Assets.targetHeights.bench, world.folder) then
			b.seat:Destroy()
			b.back:Destroy()
			swapped += 1
		end
	end
	for _, l in ipairs(world.lampItems) do
		local clone = assets.cloneModel("props", "lamp")
		if clone and assets.place(clone, l.x, l.z, 0, Config.Assets.targetHeights.lamp, world.folder) then
			l.post:Destroy()
			l.head.Transparency = 1
			swapped += 1
		end
	end
	local placed = 0
	for _, spot in ipairs(Config.HubDecor) do
		local clone = assets.cloneDecor(spot[1])
		if clone and HubWorld.placeModel(clone, spot[2], spot[3], spot[4], spot[5], world.folder) then
			placed += 1
		end
	end
	-- Village : maisons, puits, tour, pins, rochers, pont de pierre sur la mare, île sakura (Config.HubScenery) ; les arbres et fleurs procéduraux sous
	-- l'empreinte d'un modèle posé sont retirés. Budget Parts séparé ; modèle refusé = rien ne change.
	assets.loadGroup("scenery")
	local village, vParts = 0, 0
	for _, e in ipairs(Config.HubScenery) do
		local dims = Config.Assets.sceneryDims[e[1]]
		local st = assets.status["m:scenery." .. e[1]]
		local cost = st and st.ok and st.parts or 0
		if dims and cost > 0 and vParts + cost <= Config.Assets.sceneryBudgetParts then
			local clone = assets.cloneModel("scenery", e[1])
			local rot = e[4] or Placement.facing(-e[2], -e[3])
			if clone and assets.place(clone, e[2], e[3], rot, (not e[5]) and dims.h or nil, world.folder, e[5] or dims.len, 0) then
				village += 1
				vParts += cost
				for _, d in ipairs(world.folder:GetChildren()) do
					local n = d.Name
					if (n == "Trunk" or n == "Leaves" or n == "Flower" or n == "PathStone") and d:IsA("BasePart") then
						if math.sqrt((d.Position.X - e[2]) ^ 2 + (d.Position.Z - e[3]) ^ 2) < dims.r + 2 then
							d:Destroy()
						end
					end
				end
			end
		end
	end
	print("[Hub] village : " .. village .. " modèle(s), " .. vParts .. " Parts (budget " .. Config.Assets.sceneryBudgetParts .. ")")
	local lines, loadedN, requestedN = assets.reportLines()
	for _, l in ipairs(lines) do
		if l:find("ÉCHEC", 1, true) then
			warn(l)
		else
			print(l)
		end
	end
	print(("[Assets] TOTAL Blender (hub) %d/%d (repli procédural : %d)"):format(loadedN, requestedN, requestedN - loadedN))
	local rv = Instance.new("StringValue")
	rv.Name = "AssetReport"
	rv:SetAttribute("Loaded", loadedN)
	rv:SetAttribute("Requested", requestedN)
	rv.Value = table.concat(lines, "\n"):sub(1, 15000)
	rv.Parent = ReplicatedStorage
	print("[Hub] décor catalogue : " .. loaded .. " modèle(s) chargé(s), " .. placed .. " placé(s), " .. swapped .. " banc(s)/lampadaire(s) Blender")
end)

local remote = Instance.new("RemoteEvent")
remote.Name = "HubRemote"
remote.Parent = ReplicatedStorage

local function say(player, text, kind)
	remote:FireClient(player, "msg", text, kind or "info")
end

---------------------------------------------------------------- Registre des parties (MemoryStore), tout sous pcall
local map
do
	local ok, m = pcall(function()
		return MemoryStoreService:GetHashMap(G.RegistryName)
	end)
	if ok then
		map = m
	else
		warn("[Hub] MemoryStore indisponible : pas de liste de parties d'amis (" .. tostring(m) .. ")")
	end
end

local store = {}
function store.get(key)
	assert(map, "MemoryStore indisponible")
	return map:GetAsync(key)
end
function store.update(key, fn)
	assert(map, "MemoryStore indisponible")
	return map:UpdateAsync(key, fn, G.PartyTTL)
end
function store.remove(key)
	if map then
		map:RemoveAsync(key)
	end
end
function store.list()
	assert(map, "MemoryStore indisponible")
	local items = map:ListItemsAsync(100):GetCurrentPage()
	local out = {}
	for _, it in ipairs(items) do
		out[#out + 1] = it.value
	end
	return out
end

local P = PartyMod.new(Config, {
	clock = os.clock,
	guid = function()
		return HttpService:GenerateGUID(false)
	end,
	reserve = function(placeId)
		local code = TeleportService:ReserveServerAsync(placeId)
		return code
	end,
	teleport = function(players, placeId, code, data)
		local opts = Instance.new("TeleportOptions")
		if code then
			opts.ReservedServerAccessCode = code
		end
		opts:SetTeleportData(data)
		TeleportService:TeleportAsync(placeId, players, opts)
	end,
	store = store,
	log = warn,
})

---------------------------------------------------------------- Zones de lancement : qui est dans quel portail
local function rootOf(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function zoneAt(pos)
	for _, z in pairs(world.zones) do
		local d = (Vector3.new(pos.X, 0, pos.Z) - z.center).Magnitude
		if d <= z.radius then
			return z
		end
	end
	return nil
end

local launching = {} -- userId -> true pendant la téléportation (évite de relancer)

local function doLaunch(group)
	local players = {}
	for _, uid in ipairs(group.members) do
		local p = Players:GetPlayerByUserId(uid)
		if p and p.Parent then
			players[#players + 1] = p
			launching[uid] = true
		end
	end
	if #players == 0 then
		return
	end
	local members = {}
	for _, p in ipairs(players) do
		members[#members + 1] = p.UserId
		say(p, "🚀 Départ vers la partie…", "info")
	end
	local res = P.launch({ size = group.size, mode = group.mode, members = members, players = players, hostName = players[1].DisplayName })
	if not res.ok then
		for _, p in ipairs(players) do
			launching[p.UserId] = nil
			say(p, "⚠️ " .. res.message, "error")
		end
	else
		task.delay(20, function() -- si la téléportation n'a pas fini par déplacer le joueur, on le libère
			for _, p in ipairs(players) do
				launching[p.UserId] = nil
			end
		end)
	end
end

local function statusText(size, mode)
	local st = P.status(size, mode)
	if st.mode == "empty" then
		return "Libre"
	end
	local base = st.count .. "/" .. size .. " joueur" .. (size > 1 and "s" or "")
	if st.countdown then
		return base .. " · départ " .. math.ceil(st.countdown) .. " s"
	end
	return base
end

local lastStatus = {}
task.spawn(function()
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			if not launching[player.UserId] then
				local root = rootOf(player)
				local zone = root and zoneAt(root.Position) or nil
				local size = zone and P.key(zone.size, zone.mode) or nil
				local cur = P.where[player.UserId]
				if size ~= cur then
					if size then
						if not P.enter(player.UserId, zone.size, zone.mode) then
							say(player, "Cette zone est pleine, choisis-en une autre.", "info")
						end
					else
						P.leave(player.UserId)
					end
				end
			end
		end
		for _, group in ipairs(P.collectLaunches()) do
			task.spawn(doLaunch, group)
		end
		for key, z in pairs(world.zones) do
			local txt = statusText(z.size, z.mode)
			if lastStatus[key] ~= txt then
				lastStatus[key] = txt
				z.status.Text = txt
			end
		end
		task.wait(0.25)
	end
end)

---------------------------------------------------------------- Amis : liste des parties ouvertes, rejoindre
local friendCache = {} -- userId -> { t, set }
local function friendsOf(player)
	local c = friendCache[player.UserId]
	if c and os.clock() - c.t < 90 then
		return c.set
	end
	local set = {}
	local ok = pcall(function()
		local pages = Players:GetFriendsAsync(player.UserId)
		for _ = 1, 5 do
			for _, f in ipairs(pages:GetCurrentPage()) do
				set[f.Id] = true
			end
			if pages.IsFinished then
				break
			end
			pages:AdvanceToNextPageAsync()
		end
	end)
	if not ok and c then
		return c.set
	end
	friendCache[player.UserId] = { t = os.clock(), set = set }
	return set
end

local lastReq = {}
remote.OnServerEvent:Connect(function(player, action, arg)
	local now = os.clock()
	if now - (lastReq[player] or 0) < 0.4 or type(action) ~= "string" then
		return
	end
	lastReq[player] = now
	if action == "parties" then
		local list, ok = P.visibleFor(player.UserId, friendsOf(player))
		remote:FireClient(player, "parties", list, ok)
	elseif action == "join" then
		if type(arg) ~= "string" or #arg > 64 or launching[player.UserId] then
			return
		end
		launching[player.UserId] = true
		P.leave(player.UserId)
		local res = P.join(arg, player, player.UserId, friendsOf(player))
		if not res.ok then
			launching[player.UserId] = nil
			say(player, "⚠️ " .. res.message, "error")
		else
			say(player, "🚀 Tu rejoins la partie…", "info")
			task.delay(20, function()
				launching[player.UserId] = nil
			end)
		end
	end
end)

---------------------------------------------------------------- Arrivées et départs
Players.PlayerAdded:Connect(function(player)
	local ok, data = pcall(function()
		return player:GetJoinData().TeleportData
	end)
	if ok and type(data) == "table" then
		player:SetAttribute("ReturnVisit", true) -- de retour d'une partie : pas de survol d'accueil
		if type(data.partyId) == "string" then
			P.leaveParty(data.partyId, player.UserId) -- de retour de la partie : la place se libère
		end
		if data.reason == "full" then
			task.delay(2, say, player, "Cette partie était pleine (5 joueurs maximum). Choisis-en une autre !", "info")
		end
	end
end)
Players.PlayerRemoving:Connect(function(player)
	P.leave(player.UserId)
	launching[player.UserId] = nil
	lastReq[player] = nil
	friendCache[player.UserId] = nil
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX132"><Properties><string name="Name">HubWorld</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ServerScriptService/HubWorld (lieu HUB uniquement)
-- Construit le hub : place pavée avec fontaine, 5 portails de lancement (solo, 2, 3, 4, 5 joueurs) en arc, panneau des parties d'amis,
-- décor et ambiance. Tout en Parts, matériaux et lumières de base Roblox. Léger (une centaine de Parts) : pensé pour les téléphones.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local HubWorld = {}

local FONT = Enum.Font.GothamBold
local ZONE_COLORS = {
	Color3.fromRGB(255, 210, 63), -- solo
	Color3.fromRGB(91, 227, 125), -- 2
	Color3.fromRGB(74, 163, 255), -- 3
	Color3.fromRGB(184, 120, 255), -- 4
	Color3.fromRGB(255, 107, 107), -- 5
}

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function cylinder(props, parent) -- cylindre à axe vertical
	props.Shape = Enum.PartType.Cylinder
	local h, d = props.Height, props.Diameter
	props.Size = Vector3.new(h, d, d)
	props.Height, props.Diameter = nil, nil
	local pos = props.Position
	props.Position = nil
	props.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	return part(props, parent)
end

-- opts (étiquettes de portail) : { key = clé du portail, kind = "title" | "status" } : taille fixe en pixels, visible à moins de 40 studs seulement,
-- et affichée uniquement pour le portail le plus proche (HubClient).
local function billboard(adornee, text, offsetY, width, height, opts)
	local bb = Instance.new("BillboardGui")
	bb.Adornee = adornee
	bb.Size = UDim2.fromOffset(width, height)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = opts and opts.maxDist or 140
	if opts then
		bb.Name = "PortalLabel_" .. opts.kind
		bb:SetAttribute("PortalKey", opts.key)
		bb:SetAttribute("Kind", opts.kind)
		CollectionService:AddTag(bb, "PortalLabel")
	end
	bb.LightInfluence = 0
	bb.Parent = adornee
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = FONT
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.3
	l.Text = text
	l.Parent = bb
	return l
end

local function tree(pos, parent, rng)
	local s = rng:NextNumber(0.9, 1.4)
	part({ Name = "Trunk", Size = Vector3.new(2 * s, 8 * s, 2 * s), Position = pos + Vector3.new(0, 4 * s, 0), Color = Color3.fromRGB(110, 78, 50), Material = Enum.Material.Wood }, parent)
	part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(11 * s, 11 * s, 11 * s), Position = pos + Vector3.new(0, 11 * s, 0), Color = Color3.fromRGB(70, 150, 80), Material = Enum.Material.Grass }, parent)
end

local function lamp(pos, parent)
	local post = part({ Name = "LampPost", Size = Vector3.new(0.8, 7, 0.8), Position = pos + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(50, 52, 60), Material = Enum.Material.Metal }, parent)
	local head = part({ Name = "Lamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8), Position = pos + Vector3.new(0, 7.6, 0), Color = Color3.fromRGB(255, 235, 170), Material = Enum.Material.Neon }, parent)
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 225, 160)
	l.Range = 24
	l.Brightness = 1.2
	l.Parent = head
	return { post = post, head = head, x = pos.X, z = pos.Z }
end

function HubWorld.setupLighting()
	Lighting.ClockTime = 17.6 -- crépuscule doré : les portails néon ressortent
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(110, 100, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 125, 150)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 200, 150)
	Lighting.GlobalShadows = true
	local atm = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.25
	atm.Color = Color3.fromRGB(255, 205, 170)
	atm.Decay = Color3.fromRGB(180, 120, 160)
	atm.Haze = 1.6
	atm.Parent = Lighting
	local bloom = Lighting:FindFirstChild("HubBloom") or Instance.new("BloomEffect")
	bloom.Name = "HubBloom"
	bloom.Intensity = 0.5
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
end

-- Place une copie d'un modèle de décor : mise à l'échelle à `height` studs, posée au sol en (x, z), tournée de `rotDeg`. Tout est ancré,
-- sans collision ni requête (décor). Retourne true si le modèle est en place ; en cas d'erreur, tout est défait. Ne lève jamais d'erreur.
function HubWorld.placeModel(model, x, z, rotDeg, height, parent)
	local ok = pcall(function()
		if not model:IsA("Model") then
			error("pas un Model")
		end
		local _, size = model:GetBoundingBox()
		if size.Y < 0.05 then
			error("hauteur nulle")
		end
		model:ScaleTo(height / size.Y)
		local bbox, size2 = model:GetBoundingBox()
		local target = CFrame.new(x, size2.Y / 2, z) * CFrame.Angles(0, math.rad(rotDeg), 0)
		model:PivotTo(target * bbox:ToObjectSpace(model:GetPivot()))
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		model.Parent = parent
	end)
	if not ok then
		pcall(function()
			model:Destroy()
		end)
	end
	return ok
end

-- Retourne { spawn, zones = { [taille] = { part, label, center, radius } }, folder }
function HubWorld.build(Config)
	local world = Instance.new("Folder")
	world.Name = "HubWorld"
	world.Parent = workspace
	HubWorld.setupLighting()
	local rng = Random.new(11)

	cylinder({ Name = "Ground", Height = 2, Diameter = 420, Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(88, 150, 84), Material = Enum.Material.Grass }, world)
	cylinder({ Name = "Plaza", Height = 0.6, Diameter = 96, Position = Vector3.new(0, 0.1, 0), Color = Color3.fromRGB(196, 184, 160), Material = Enum.Material.Cobblestone }, world)
	cylinder({ Name = "PlazaRing", Height = 0.5, Diameter = 100, Position = Vector3.new(0, 0, 0), Color = Color3.fromRGB(150, 125, 85), Material = Enum.Material.Slate }, world)
	-- Murs et plafond INVISIBLES : on ne sort jamais du hub, ni par les côtés ni en sautant très haut (hauteur des murs = plafond).
	local CEIL = 130
	for _, w in ipairs({ { 0, -212, 428, 4 }, { 0, 212, 428, 4 }, { 212, 0, 4, 428 }, { -212, 0, 4, 428 } }) do
		part({ Name = "InvisibleWall", Size = Vector3.new(w[3], CEIL, w[4]), Position = Vector3.new(w[1], CEIL / 2, w[2]), Transparency = 1, CanQuery = false }, world)
	end
	part({ Name = "InvisibleCeiling", Size = Vector3.new(428, 4, 428), Position = Vector3.new(0, CEIL + 2, 0), Transparency = 1, CanQuery = false }, world)

	-- Mare du village (décor : on la traverse sans nager) ; le pont de pierre Blender l'enjambe, des rochers la bordent
	local pond = Config.HubPond
	part({ Name = "Pond", Size = Vector3.new(pond.w, 0.2, pond.d), Position = Vector3.new(pond.x, 0.12, pond.z), Color = Color3.fromRGB(70, 150, 210), Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false, CanQuery = false }, world)

	-- Fontaine centrale
	local fBase = cylinder({ Name = "FountainBase", Height = 2.4, Diameter = 16, Position = Vector3.new(0, 1.2, 0), Color = Color3.fromRGB(170, 170, 178), Material = Enum.Material.Marble }, world)
	local fWater = cylinder({ Name = "FountainWater", Height = 0.4, Diameter = 14, Position = Vector3.new(0, 2.5, 0), Color = Color3.fromRGB(90, 200, 255), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false }, world)
	local spout = part({ Name = "Spout", Size = Vector3.new(1.4, 6, 1.4), Position = Vector3.new(0, 5, 0), Color = Color3.fromRGB(190, 190, 200), Material = Enum.Material.Marble }, world)
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(Color3.fromRGB(160, 225, 255))
	spray.Rate = 14
	spray.Lifetime = NumberRange.new(1, 1.6)
	spray.Speed = NumberRange.new(6, 10)
	spray.SpreadAngle = Vector2.new(25, 25)
	spray.Acceleration = Vector3.new(0, -14, 0)
	spray.Size = NumberSequence.new(0.5, 0)
	spray.LightEmission = 0.7
	spray.Parent = spout
	local fl = Instance.new("PointLight")
	fl.Color = Color3.fromRGB(120, 210, 255)
	fl.Range = 22
	fl.Brightness = 1.4
	fl.Parent = spout

	-- Point d'arrivée au sud de la place
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 0.4, 14)
	spawn.Position = Vector3.new(0, 0.6, 34)
	spawn.Color = Color3.fromRGB(255, 226, 150)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.45
	spawn.Parent = world

	-- Titre au-dessus de l'entrée
	local titlePost = part({ Name = "TitlePost", Size = Vector3.new(1.2, 14, 1.2), Position = Vector3.new(0, 7, 50), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
	local titleBoard = part({ Name = "TitleBoard", Size = Vector3.new(24, 6, 0.8), Position = Vector3.new(0, 13, 49.5), Color = Color3.fromRGB(120, 84, 56), Material = Enum.Material.WoodPlanks }, world)
	billboard(titleBoard, "🥚 " .. Config.TITLE .. " : le hub", 0, 360, 70)
	billboard(titlePost, "Entre dans un portail pour lancer ta partie", -4, 360, 40).TextSize = 18

	-- Panneau des parties d'amis (la liste cliquable est dans l'interface, en haut à droite)
	local fp = part({ Name = "FriendsPost", Size = Vector3.new(1, 8, 1), Position = Vector3.new(-26, 4, 28), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
	local fb = part({ Name = "FriendsBoard", Size = Vector3.new(11, 5, 0.7), Position = Vector3.new(-26, 8.6, 28), Color = Color3.fromRGB(46, 110, 80), Material = Enum.Material.WoodPlanks }, world)
	billboard(fb, "👥 Parties de tes amis\nBouton « Amis » en haut à droite", 0, 300, 90)
	CollectionService:AddTag(fp, "HubFriendsPost")

	-- Portails de lancement : un arc au nord de la place, du solo à 5 joueurs
	local zones = {}
	local sizes = Config.Game.Sizes
	local R = 62
	for i, size in ipairs(sizes) do
		local a = math.rad(-72 + (i - 1) * 36) -- -72°..72° autour du nord (-Z)
		local cx, cz = math.sin(a) * R, -math.cos(a) * R
		local color = ZONE_COLORS[(i - 1) % #ZONE_COLORS + 1]
		local rot = CFrame.lookAt(Vector3.new(cx, 0, cz), Vector3.new(0, 0, 0))
		cylinder({ Name = "PortalRing" .. size, Height = 0.5, Diameter = 21, Position = Vector3.new(cx, 0.45, cz), Color = color:Lerp(Color3.new(1, 1, 1), 0.15), Material = Enum.Material.SmoothPlastic, CanCollide = false }, world)
		local padPart = cylinder({ Name = "PortalZone" .. size, Height = 0.6, Diameter = 18, Position = Vector3.new(cx, 0.55, cz), Color = color:Lerp(Color3.new(0, 0, 0), 0.55), Material = Enum.Material.SmoothPlastic, CanCollide = false }, world)
		padPart:SetAttribute("Size", size)
		CollectionService:AddTag(padPart, "PortalZone")
		for _, sx in ipairs({ -10.5, 10.5 }) do -- piliers de l'arche
			part({ Name = "Pillar", Size = Vector3.new(2, 14, 2), CFrame = rot * CFrame.new(sx, 7, -2), Color = Color3.fromRGB(205, 200, 210), Material = Enum.Material.Marble }, world)
		end
		local lintel = part({ Name = "Lintel", Size = Vector3.new(24, 2.4, 2.4), CFrame = rot * CFrame.new(0, 15, -2), Color = color, Material = Enum.Material.Neon }, world)
		local pl = Instance.new("PointLight")
		pl.Color = color
		pl.Range = 30
		pl.Brightness = 1.6
		pl.Parent = lintel
		local PL = Config.PORTAL_LABEL
		local label = billboard(lintel, "", 4 + (i % 2) * 1.5, PL.titleSize[1], PL.titleSize[2], { key = tostring(size), kind = "title", maxDist = PL.maxDist })
		label.Text = size == 1 and "SOLO" or (size .. " JOUEURS")
		local status = billboard(padPart, "Libre", 7 + (i % 2) * 1.2, PL.statusSize[1], PL.statusSize[2], { key = tostring(size), kind = "status", maxDist = PL.maxDist })
		status.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.5)
		zones[size] = { part = padPart, status = status, center = Vector3.new(cx, 0, cz), radius = 9, color = color, title = label, size = size, mode = "arena" }
	end

	-- Portails du mode CHÂTEAU : second arc, plus au nord, couleur pierre et feu (clés « c1 » à « c5 »)
	local castleColor = Color3.fromRGB(255, 110, 60)
	for i, size in ipairs(sizes) do
		local a = math.rad(-72 + (i - 1) * 36)
		local cx, cz = math.sin(a) * 108, -math.cos(a) * 108
		local rot = CFrame.lookAt(Vector3.new(cx, 0, cz), Vector3.new(0, 0, 0))
		cylinder({ Name = "CastlePortalRing" .. size, Height = 0.5, Diameter = 21, Position = Vector3.new(cx, 0.45, cz), Color = castleColor, Material = Enum.Material.SmoothPlastic, CanCollide = false }, world)
		local padPart = cylinder({ Name = "CastlePortalZone" .. size, Height = 0.6, Diameter = 18, Position = Vector3.new(cx, 0.55, cz), Color = Color3.fromRGB(70, 36, 24), Material = Enum.Material.Slate, CanCollide = false }, world)
		padPart:SetAttribute("Size", size)
		padPart:SetAttribute("Mode", "castle")
		CollectionService:AddTag(padPart, "PortalZone")
		for _, sx in ipairs({ -10.5, 10.5 }) do -- piliers en pierre sombre, créneaux
			part({ Name = "CastlePillar", Size = Vector3.new(2.6, 16, 2.6), CFrame = rot * CFrame.new(sx, 8, -2), Color = Color3.fromRGB(112, 108, 120), Material = Enum.Material.Slate }, world)
			part({ Name = "CastleMerlon", Size = Vector3.new(3.4, 1.4, 3.4), CFrame = rot * CFrame.new(sx, 16.7, -2), Color = Color3.fromRGB(96, 92, 104), Material = Enum.Material.Slate }, world)
		end
		local lintel = part({ Name = "CastleLintel", Size = Vector3.new(24, 2.4, 2.4), CFrame = rot * CFrame.new(0, 15.5, -2), Color = castleColor, Material = Enum.Material.Neon }, world)
		local pl = Instance.new("PointLight")
		pl.Color = castleColor
		pl.Range = 30
		pl.Brightness = 1.6
		pl.Parent = lintel
		local PL = Config.PORTAL_LABEL
		local label = billboard(lintel, "", 4 + (i % 2) * 1.5, PL.titleSize[1] + 40, PL.titleSize[2], { key = "c" .. size, kind = "title", maxDist = PL.maxDist })
		label.Text = "🏰 CHÂTEAU · " .. (size == 1 and "SOLO" or (size .. " JOUEURS"))
		local status = billboard(padPart, "Libre", 7 + (i % 2) * 1.2, PL.statusSize[1], PL.statusSize[2], { key = "c" .. size, kind = "status", maxDist = PL.maxDist })
		status.TextColor3 = Color3.fromRGB(255, 190, 150)
		zones["c" .. size] = { part = padPart, status = status, center = Vector3.new(cx, 0, cz), radius = 9, color = castleColor, title = label, size = size, mode = "castle" }
	end
	local cb = part({ Name = "CastleBoard", Size = Vector3.new(15, 9, 0.7), CFrame = CFrame.lookAt(Vector3.new(0, 10, 78), Vector3.new(0, 10, 36)), Color = Color3.fromRGB(70, 46, 40), Material = Enum.Material.WoodPlanks }, world)
	billboard(cb, "🏰 Mode Château\nSalles à pièges : pics, lames, boulets, portes.\nCoffre final : œuf rare. Classement des temps.", 0, 420, 130)

	-- Panneaux d'explication : planches lisibles (SurfaceGui) tournées vers le point d'arrivée
	local function board(name, pos, title, lines, color)
		local post = part({ Name = name .. "Post", Size = Vector3.new(1, 7, 1), Position = pos + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood }, world)
		local face = part({ Name = name, Size = Vector3.new(15, 9, 0.7), CFrame = CFrame.lookAt(pos + Vector3.new(0, 10, 0), Vector3.new(0, 10, 36)), Color = Color3.fromRGB(46, 90, 64), Material = Enum.Material.WoodPlanks }, world)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.CanvasSize = Vector2.new(600, 360)
		sg.LightInfluence = 0
		sg.Adornee = face
		sg.Parent = face
		local head = Instance.new("TextLabel")
		head.BackgroundTransparency = 1
		head.Position = UDim2.fromOffset(20, 10)
		head.Size = UDim2.new(1, -40, 0, 56)
		head.Font = FONT
		head.TextScaled = true
		head.TextColor3 = color
		head.Text = title
		head.Parent = sg
		local body = Instance.new("TextLabel")
		body.BackgroundTransparency = 1
		body.Position = UDim2.fromOffset(24, 72)
		body.Size = UDim2.new(1, -48, 1, -84)
		body.Font = Enum.Font.GothamMedium
		body.TextSize = 27
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.TextColor3 = Color3.fromRGB(240, 250, 242)
		body.Text = table.concat(lines, "\n")
		body.Parent = sg
		return post
	end
	local G = Config.Game
	board("BoardHow", Vector3.new(26, 0, 30), "Comment jouer", {
		"🥚 Chipe des œufs, fais-les éclore, deviens Roi des Couvées.",
		"🏃 Cours sur le tapis pour aller plus vite.",
		"🐾 Tes pets rapportent des pièces tant que tu joues ; un peu de revenu continue quand tu pars.",
	}, Color3.fromRGB(255, 210, 63))
	board("BoardParty", Vector3.new(-26, 0, 8), "Lancer une partie", {
		"1. Choisis ta taille : solo ou 2 à " .. G.MaxPlayers .. " joueurs.",
		"2. Entre dans le portail de ce nombre.",
		"3. Départ " .. G.CountdownFull .. " s après le dernier joueur (ou " .. G.PartialWait .. " s si le groupe est incomplet).",
	}, Color3.fromRGB(91, 227, 125))
	board("BoardFriends", Vector3.new(26, 0, 8), "Rejoindre des amis", {
		"👥 Bouton « Amis » en haut à droite.",
		"Tu vois les parties ouvertes de tes amis (moins de " .. G.MaxPlayers .. " joueurs).",
		"Appuie sur Rejoindre : tu arrives en cours de partie, tes œufs sont protégés " .. G.LateJoinGrace .. " s.",
	}, Color3.fromRGB(74, 163, 255))
	local benchItems, lampItems = {}, {}
	for i = 1, 6 do -- bancs autour de la fontaine
		local a = i / 6 * math.pi * 2 + 0.5
		local bx, bz = math.sin(a) * 15, math.cos(a) * 15
		local look = CFrame.lookAt(Vector3.new(bx, 1.6, bz), Vector3.new(0, 1.6, 0))
		local seat = part({ Name = "BenchSeat", Size = Vector3.new(6, 0.6, 2), CFrame = look, Color = Color3.fromRGB(150, 104, 70), Material = Enum.Material.WoodPlanks }, world)
		local back = part({ Name = "BenchBack", Size = Vector3.new(6, 1.8, 0.4), CFrame = look * CFrame.new(0, 1.2, 1), Color = Color3.fromRGB(130, 90, 60), Material = Enum.Material.WoodPlanks }, world)
		benchItems[#benchItems + 1] = { seat = seat, back = back, x = bx, z = bz, rot = math.deg(a) }
	end
	local pathIndex = 0
	for _, z in pairs(zones) do -- chemin de pas : de la place jusqu'au portail de l'arène ; du portail de l'arène jusqu'à son jumeau « château »
		pathIndex += 1
		local pathY = 0.5 + 0.07 * (pathIndex % 3) -- trois niveaux : deux chemins voisins ne partagent jamais la même hauteur (aucun scintillement)
		local twin = z.mode == "castle" and zones[z.size] or nil
		local ox, oz = 0, 34
		if twin then
			ox, oz = twin.center.X, twin.center.Z
		end
		local pathLen = math.sqrt((z.center.X - ox) ^ 2 + (z.center.Z - oz) ^ 2)
		for k = 1, 7 do
			local t = k / 8
			local sx, sz = ox + (z.center.X - ox) * t, oz + (z.center.Z - oz) * t
			local blocked = false
			for _, other in pairs(zones) do
				if math.sqrt((sx - other.center.X) ^ 2 + (sz - other.center.Z) ^ 2) < 13.5 then
					blocked = true -- jamais de pavé sous l'anneau d'un portail (le sien ou celui d'un autre)
				end
			end
			if not blocked and pathLen > 0 then
				part({ Name = "PathStone", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 4.4, 4.4), CFrame = CFrame.new(Vector3.new(sx, pathY, sz)) * CFrame.Angles(0, 0, math.pi / 2), Color = z.color:Lerp(Color3.fromRGB(215, 205, 180), 0.6), Material = Enum.Material.Cobblestone, CanCollide = false }, world)
			end
		end
	end
	local sparks = part({ Name = "Fireflies", Size = Vector3.new(160, 14, 160), Position = Vector3.new(0, 9, 0), Transparency = 1, CanCollide = false, CanQuery = false }, world)
	local ff = Instance.new("ParticleEmitter")
	ff.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	ff.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
	ff.Rate = 10
	ff.Lifetime = NumberRange.new(4, 6)
	ff.Speed = NumberRange.new(0.5, 1.5)
	ff.SpreadAngle = Vector2.new(180, 180)
	ff.Size = NumberSequence.new(0.35)
	ff.LightEmission = 1
	ff.Parent = sparks

	-- Décor : lampadaires autour de la place, arbres, fleurs, rochers, collines
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		lampItems[#lampItems + 1] = lamp(Vector3.new(math.sin(a) * 47, 0, math.cos(a) * 47), world)
	end
	for _ = 1, 46 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(70, 190)
		tree(Vector3.new(math.sin(a) * r, 0, math.cos(a) * r), world, rng)
	end
	local flowerColors = { Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 220, 90), Color3.fromRGB(190, 140, 255), Color3.fromRGB(120, 220, 255) }
	for _ = 1, 90 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(52, 120)
		part({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), Position = Vector3.new(math.sin(a) * r, 0.45, math.cos(a) * r), Color = flowerColors[rng:NextInteger(1, #flowerColors)], CanCollide = false }, world)
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local sz = rng:NextNumber(120, 200)
		part({ Name = "Hill", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz, sz), Position = Vector3.new(math.sin(a) * 250, -sz * 0.38, math.cos(a) * 250), Color = Color3.fromRGB(80 + (k % 3) * 8, 140 + (k % 2) * 12, 90), Material = Enum.Material.Grass, CanCollide = false }, world)
	end
	return { spawn = spawn, zones = zones, folder = world, fountainParts = { fBase, fWater, spout }, benchItems = benchItems, lampItems = lampItems }
end

return HubWorld
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX136"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX135"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX134"><Properties><string name="Name">HubClient</string><ProtectedString name="Source"><![CDATA[-- LocalScript : StarterPlayerScripts/HubClient (lieu HUB uniquement)
-- Interface du hub : bouton « Amis » en haut à droite qui ouvre la liste des parties ouvertes de tes amis (bouton Rejoindre), messages en
-- haut à droite. Tout est ancré aux bords, la zone centrale reste libre (voir Layout.lua).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
if Config.Game.roleFor(game.PlaceId) == "game" then
	return
end
local Layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Layout"))
local remote = ReplicatedStorage:WaitForChild("HubRemote")
local player = Players.LocalPlayer
pcall(function()
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetReportUi")).start(Config, player, ReplicatedStorage, game:GetService("UserInputService"))
end)

local COL = {
	bg = Color3.fromRGB(15, 42, 27), panel = Color3.fromRGB(29, 77, 51), pill = Color3.fromRGB(10, 30, 20),
	yellow = Color3.fromRGB(255, 210, 63), text = Color3.fromRGB(244, 255, 246), muted = Color3.fromRGB(159, 199, 173),
	green = Color3.fromRGB(91, 227, 125), red = Color3.fromRGB(255, 107, 107),
}
local FONT = Enum.Font.GothamBold

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local gui = make("ScreenGui", { Name = "HubUI", ResetOnSpawn = false, ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets }, player:WaitForChild("PlayerGui"))
local root = make("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromOffset(900, 520) }, gui)
local scale = make("UIScale", { Scale = 1 }, root)

-- Bouton « Amis » : en haut à droite
local friendsBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(120, 44), BackgroundColor3 = COL.pill, Text = "👥 Amis", Font = FONT, TextSize = 18, TextColor3 = COL.text, AutoButtonColor = true }, root)
corner(friendsBtn, 14)
make("UIStroke", { Color = COL.yellow, Thickness = 2 }, friendsBtn)

-- Panneau des parties : sous le bouton, côté droit
local panel = make("Frame", { AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(300, 260), BackgroundColor3 = COL.bg, Visible = false }, root)
corner(panel, 14)
make("UIStroke", { Color = COL.panel, Thickness = 2 }, panel)
make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 26), Font = FONT, TextSize = 18, TextColor3 = COL.yellow, TextXAlignment = Enum.TextXAlignment.Left, Text = "Parties ouvertes de tes amis" }, panel)
local list = make("ScrollingFrame", { Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -16, 1, -44), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, panel)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local empty = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 44), Size = UDim2.new(1, -24, 0, 60), Font = FONT, TextSize = 14, TextWrapped = true, TextColor3 = COL.muted, Text = "Aucune partie ouverte pour l'instant. Lance la tienne dans un portail : tes amis pourront la rejoindre !" }, panel)

-- Messages : sous le bouton Amis
local msg = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(300, 44), BackgroundColor3 = COL.pill, BackgroundTransparency = 0.1, Font = FONT, TextSize = 14, TextColor3 = COL.text, TextWrapped = true, Text = "", Visible = false }, root)
corner(msg, 12)
make("UIStroke", { Color = COL.yellow, Thickness = 2 }, msg)
local msgToken = 0
local function toast(text, kind)
	msgToken += 1
	local token = msgToken
	msg.Text = text
	msg.TextColor3 = kind == "error" and COL.red or COL.text
	msg.Visible = true
	task.delay(5, function()
		if token == msgToken then
			msg.Visible = false
		end
	end)
end

local function applyLayout()
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(900, 520)
	if vs.X < 50 or vs.Y < 50 then
		return
	end
	local s = Layout.scaleFor(vs.X, vs.Y)
	scale.Scale = s
	local dw = vs.X / s
	root.Size = UDim2.fromOffset(dw, vs.Y / s)
	local e = Layout.EDGE
	friendsBtn.Position = UDim2.fromOffset(dw - e, e)
	panel.Position = UDim2.fromOffset(dw - e, e + 52)
	panel.Size = UDim2.fromOffset(math.min(300, dw - 2 * e), 260)
	msg.Position = UDim2.fromOffset(dw - e, e + 52 + (panel.Visible and 268 or 0))
	msg.Size = UDim2.fromOffset(math.min(300, dw - 2 * e), 44)
end
applyLayout()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
end

local function render(parties)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	empty.Visible = #parties == 0
	for i, p in ipairs(parties) do
		local row = make("Frame", { Size = UDim2.new(1, -4, 0, 48), BackgroundColor3 = COL.panel, LayoutOrder = i }, list)
		corner(row, 10)
		make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -110, 0, 24), Font = FONT, TextSize = 15, TextColor3 = COL.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "🏠 " .. tostring(p.hostName) }, row)
		make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -110, 0, 20), Font = FONT, TextSize = 12, TextColor3 = COL.muted, TextXAlignment = Enum.TextXAlignment.Left, Text = tostring(math.max(0, p.size - p.count)) .. " place(s) libre(s) · " .. tostring(p.count) .. "/" .. tostring(p.size) }, row)
		local join = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(100, 34), BackgroundColor3 = COL.green, Font = FONT, TextSize = 12, TextColor3 = Color3.fromRGB(10, 40, 20), Text = "Rejoindre l'ami" }, row)
		corner(join, 12)
		join.Activated:Connect(function()
			join.Text = "…"
			remote:FireServer("join", p.id)
		end)
	end
end

local function refresh()
	remote:FireServer("parties")
end
friendsBtn.Activated:Connect(function()
	panel.Visible = not panel.Visible
	applyLayout()
	if panel.Visible then
		refresh()
	end
end)
task.spawn(function()
	while true do
		task.wait(8)
		if panel.Visible then
			refresh()
		end
	end
end)

-- Une seule étiquette de portail à la fois : celle du portail le plus proche (à moins de Config.PORTAL_LABEL.maxDist studs) ; les autres sont masquées.
task.spawn(function()
	local CollectionService = game:GetService("CollectionService")
	while true do
		pcall(function()
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local portals, labels = {}, CollectionService:GetTagged("PortalLabel")
			local seen = {}
			for _, bb in ipairs(labels) do
				local key = bb:GetAttribute("PortalKey")
				local adornee = bb.Adornee
				if key and adornee and not seen[key] then
					seen[key] = true
					portals[#portals + 1] = { key = key, x = adornee.Position.X, z = adornee.Position.Z }
				end
			end
			local near = root and Config.nearestPortal(root.Position.X, root.Position.Z, portals) or nil
			for _, bb in ipairs(labels) do
				bb.Enabled = near ~= nil and bb:GetAttribute("PortalKey") == near
			end
		end)
		task.wait(0.25)
	end
end)

remote.OnClientEvent:Connect(function(kind, a, b)
	if kind == "msg" then
		toast(tostring(a), b)
	elseif kind == "parties" then
		if type(a) == "table" then
			render(a)
		end
		if b == false then
			toast("Liste des amis indisponible pour l'instant.", "info")
		end
	end
end)
TweenService:Create(friendsBtn, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(120, 44) }):Play()

---------------------------------------------------------------- Survol d'accueil : la fontaine puis les portails (CinematicKit)
-- 5 secondes, première arrivée seulement (pas au retour d'une partie), passage d'un tap, d'un clic, d'Entrée ou du bouton, 8 s au plus par construction ;
-- le personnage garde le contrôle, la caméra est restituée quoi qu'il arrive (fin, passage, erreur, sécurité).
task.spawn(function()
	if not Config.cineEnabled("hub") then
		return
	end
	local ok, err = pcall(function()
		local UserInputService = game:GetService("UserInputService")
		local RunService = game:GetService("RunService")
		local Shared = ReplicatedStorage:WaitForChild("Shared")
		local Easing = require(Shared:WaitForChild("Easing"))
		local CK = require(Shared:WaitForChild("CinematicKit"))
		local Kit = CK.new(Easing, require(Shared:WaitForChild("Cinema")).new(Easing))
		local t0 = os.clock()
		while os.clock() - t0 < 15 and not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) do
			task.wait(0.25)
		end
		task.wait(1.5)
		if player:GetAttribute("ReturnVisit") then
			return
		end
		local cam = workspace.CurrentCamera
		local saved = nil
		local cine = make("ScreenGui", { Name = "HubCine", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 60, Enabled = false }, player:WaitForChild("PlayerGui"))
		local function bar(y)
			make("Frame", { AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), Size = UDim2.fromScale(1, 0.1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.1, BorderSizePixel = 0, Active = false }, cine)
		end
		bar(0)
		bar(1)
		local title = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(420, 70), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = COL.text, TextStrokeTransparency = 0.3, Text = "", Active = false }, cine)
		local caption = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.93, 0), Size = UDim2.fromOffset(520, 40), BackgroundTransparency = 1, Font = FONT, TextSize = 20, TextColor3 = COL.yellow, TextWrapped = true, Text = "", Active = false }, cine)
		local skipBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0.02, 0), Size = UDim2.fromOffset(110, 34), BackgroundColor3 = COL.yellow, Text = "Passer ▶", Font = FONT, TextSize = 15, TextColor3 = Color3.fromRGB(43, 34, 0) }, cine)
		corner(skipBtn, 10)
		local lastShot = 0
		local host = {
			takeCamera = function()
				saved = { cameraType = cam.CameraType, fov = cam.FieldOfView }
				cam.CameraType = Enum.CameraType.Scriptable
				cine.Enabled = true
			end,
			giveCameraBack = function()
				cine.Enabled = false
				if saved then
					cam.CameraType = saved.cameraType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or saved.cameraType
					cam.FieldOfView = saved.fov
					local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						cam.CameraSubject = hum
					end
					saved = nil
				end
			end,
			apply = function(index, progress, shot)
				local pos, look, fov = Kit.cameraAt(shot, progress)
				local off = Kit.shakeOffset(shot, progress, os.clock())
				cam.CFrame = CFrame.lookAt(Vector3.new(pos[1] + off[1], pos[2] + off[2], pos[3] + off[3]), Vector3.new(look[1], look[2], look[3]))
				cam.FieldOfView = fov
				if index ~= lastShot then
					lastShot = index
					title.Text = shot.title or ""
					caption.Text = shot.text or ""
				end
			end,
		}
		local runner = Kit.runner(host)
		local started = runner.start(CK.PLANS.hub_survol, os.clock())
		if started ~= "playing" then
			warn("[Hub] survol d'accueil non démarré : " .. tostring(started))
			return
		end
		local function stop()
			pcall(function()
				RunService:UnbindFromRenderStep("HubSurvol")
			end)
			runner.abort()
		end
		RunService:BindToRenderStep("HubSurvol", Enum.RenderPriority.Camera.Value + 1, function()
			local status = runner.update(os.clock())
			if status ~= "playing" then
				stop()
			end
		end)
		skipBtn.Activated:Connect(function()
			runner.skip(os.clock())
			stop()
		end)
		UserInputService.InputBegan:Connect(function(input)
			if runner.isActive() and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonB) then
				runner.skip(os.clock())
				stop()
			end
		end)
		task.delay(CK.MAX_SECONDS + 2, stop) -- sécurité : la caméra revient de force
	end)
	if not ok then
		warn("[Hub] survol d'accueil abandonné : " .. tostring(err))
		pcall(function()
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		end)
	end
end)

]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
