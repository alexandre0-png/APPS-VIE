F.boulder_cluster = { id = 94606784141362, lot = 17, cap = 40, zone = "region", region = rect(-330, 330, -215, 215), minPlaza = 85, count = 5, length = 9, r = 5, gap = 4, share = 0.06, fb = { name = "rock" }, fbMax = 5 }
