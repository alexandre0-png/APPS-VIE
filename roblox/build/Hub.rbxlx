---------------------------------------------------------------- Lot 17 : décor de carte (nouvelles variétés)
F.bench_park = { id = 71149096082627, lot = 17, cap = 40, zone = "pathSide", pathMinPlaza = 72, step = 46, offset = 4, count = 6, height = 2.5, r = 2.2, gap = 4, share = 0.05, fb = { name = "bench" }, fbMax = 6 }
