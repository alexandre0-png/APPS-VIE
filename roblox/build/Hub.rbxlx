]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX83"><Properties><string name="Name">Easing</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Easing
-- Fonctions d'animation PURES (aucun service Roblox, aucun Instance) : courbes, squash & stretch, rebonds, clignements, regards,
-- paramètres de confettis et garde-fou d'exécution. Testées hors de Roblox (tests/run.luau). Le client (Animations.client.lua)
-- ne fait qu'appliquer ces valeurs aux objets.
local Easing = {}

local pi, sin, cos, exp, abs, floor, sqrt = math.pi, math.sin, math.cos, math.exp, math.abs, math.floor, math.sqrt

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end
Easing.clamp01 = clamp01

local function frac(x)
	return x - floor(x)
end

-- Direction de déplacement unitaire (dx, dz) d'un objet qui a parcouru (dx, dz) en dt secondes, ou nil s'il va plus lentement que minSpeed (studs/s) : il garde
-- alors son orientation. Sert à tourner les pets suiveurs vers leur direction de marche.
function Easing.travelDir(dx, dz, dt, minSpeed)
	if type(dx) ~= "number" or type(dz) ~= "number" or type(dt) ~= "number" or dt <= 0 or dx ~= dx or dz ~= dz then
		return nil
	end
	local d = sqrt(dx * dx + dz * dz)
	if d / dt < (minSpeed or 1.5) or d < 1e-9 then
		return nil
	end
	return dx / d, dz / d
end

function Easing.lerp(a, b, t)
	return a + (b - a) * t
end

-- Animations d'interface -------------------------------------------------------------------------------------------------------
-- Compteur qui défile : rapproche `shown` de `target` (approche exponentielle, jamais de dépassement, arrêt exact). dt en secondes.
function Easing.rollTo(shown, target, dt)
	if type(shown) ~= "number" or shown ~= shown then
		return type(target) == "number" and target == target and target or 0
	end
	if type(target) ~= "number" or target ~= target then
		return shown
	end
	local diff = target - shown
	if math.abs(diff) <= math.max(1, math.abs(target) * 0.0005) then
		return target
	end
	local k = 1 - exp(-(dt or 1 / 30) * 9)
	local nextValue = shown + diff * k
	if (diff > 0 and nextValue > target) or (diff < 0 and nextValue < target) then
		return target
	end
	return nextValue
end

-- Balayage de brillance : position horizontale (fraction de la largeur, de -0,25 à 1,25) à la progression p.
function Easing.shineX(p)
	p = clamp01(p)
	return -0.25 + 1.5 * (1 - (1 - p) * (1 - p))
end

-- Pulsation unique (montée rapide, descente douce) : 0 -> 1 -> 0 sur p dans [0, 1].
function Easing.pulse(p)
	p = clamp01(p)
	if p < 0.2 then
		return 1 - (1 - p / 0.2) ^ 2
	end
	local e = (p - 0.2) / 0.8
	return (1 - e) ^ 2
end

-- Courbes classiques (entrée et sortie dans [0, 1]) ---------------------------------------------------------------
function Easing.inOutSine(x)
	x = clamp01(x)
	return -(cos(pi * x) - 1) / 2
end

function Easing.outQuad(x)
	x = clamp01(x)
	return 1 - (1 - x) * (1 - x)
end

function Easing.outBack(x)
	x = clamp01(x)
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

function Easing.outElastic(x)
	x = clamp01(x)
	if x == 0 or x == 1 then
		return x
	end
	return 2 ^ (-10 * x) * sin((x * 10 - 0.75) * (2 * pi) / 3) + 1
end

function Easing.outBounce(x)
	x = clamp01(x)
	local n1, d1 = 7.5625, 2.75
	if x < 1 / d1 then
		return n1 * x * x
	elseif x < 2 / d1 then
		x = x - 1.5 / d1
		return n1 * x * x + 0.75
	elseif x < 2.5 / d1 then
		x = x - 2.25 / d1
		return n1 * x * x + 0.9375
	end
	x = x - 2.625 / d1
	return n1 * x * x + 0.984375
end

-- Squash & stretch : au temps t (0 -> 1), retourne (sx, sy) à appliquer en largeur et en hauteur.
-- Part écrasé (sy < 1, sx > 1), puis s'étire, puis oscille de moins en moins jusqu'à (1, 1). Toujours strictement positif.
function Easing.squashStretch(t, strength)
	if t >= 1 then
		return 1, 1
	end
	if t < 0 then
		t = 0
	end
	local amp = (strength or 0.4) * exp(-5 * t) * cos(14 * t)
	return math.max(0.2, 1 + amp * 0.6), math.max(0.2, 1 - amp)
end

-- Petit saut d'un œuf toutes les `period` secondes. Retourne (décalage vertical >= 0, sx, sy).
-- Étirement en l'air, écrasement à l'atterrissage ; hors du saut : (0, 1, 1).
function Easing.eggHop(time, phase, height, period)
	period = period or 3.2
	height = height or 0.6
	local u = ((time + (phase or 0)) % period) / 0.6 -- le saut dure 0,6 s
	if u >= 1 then
		return 0, 1, 1
	end
	local y = height * sin(u * pi)
	local sy = 1 + 0.15 * sin(u * pi)
	if u > 0.85 then
		sy = 1 - 0.12 * sin((u - 0.85) / 0.15 * pi)
	end
	return y, 1 / sqrt(sy), sy
end

-- Balancement d'un œuf porté pendant la course (décalage vertical >= 0).
function Easing.runBounce(time, moving)
	if not moving then
		return 0
	end
	return 0.25 * abs(sin(time * 8))
end

-- Clignement : 1 = œil ouvert, 0 = fermé. Bref (0,16 s) à intervalle irrégulier propre à chaque `seed`.
function Easing.blinkOpenness(time, seed)
	seed = seed or 0
	local period = 2.6 + (seed % 7) * 0.37
	local ph = (time + seed * 0.53) % period
	local d = 0.16
	if ph < d then
		return clamp01(1 - sin(ph / d * pi)) -- bornée : sin(pi) vaut ±1e-16 selon le moteur
	end
	return 1
end

-- Regard : décalage (dx, dy) des yeux, dx dans [-0.85, 0.85], dy dans [-0.3, 0.3].
function Easing.look(time, seed)
	seed = seed or 0
	local dx = sin(time * 0.7 + seed) * 0.6 + sin(time * 1.9 + seed * 2) * 0.25
	local dy = sin(time * 0.5 + seed * 3) * 0.3
	return dx, dy
end

-- Bouche : ouverture dans [0, 1] ; elle « mâche » brièvement de temps en temps.
function Easing.mouthOpen(time, seed)
	seed = seed or 0
	local period = 4 + (seed % 5) * 0.6
	local ph = (time + seed * 0.9) % period
	if ph < 0.7 then
		return sin(ph / 0.7 * pi)
	end
	return 0
end

-- Poule : coups de bec doubles à intervalle irrégulier. Retourne l'enfoncement de la tête dans [0, 1].
function Easing.peck(time, seed)
	seed = seed or 0
	local period = 3.4 + (seed % 5) * 0.5
	local ph = (time + seed * 0.7) % period
	if ph < 0.25 then
		return clamp01(sin(ph / 0.25 * pi))
	elseif ph < 0.5 then
		return clamp01(sin((ph - 0.25) / 0.25 * pi))
	end
	return 0
end

-- Pulsation d'une barrière de zone, dans [0, 1].
-- Échelle du pet qui apparaît à l'éclosion (a = progression 0..1) : part de 25 %, ne dépasse jamais `cap` et vaut exactement 1 à la fin.
function Easing.popScale(a, squash, cap)
	cap = cap or 1.15
	if a >= 1 then
		return 1
	end
	local scale
	if squash then
		local _, sy = Easing.squashStretch(a, 0.45)
		scale = (0.25 + 0.75 * Easing.outQuad(math.min(1, a * 1.8))) * sy
	else
		scale = 0.25 + 0.75 * Easing.outBack(a)
	end
	return math.min(cap, math.max(0.05, scale))
end

-- États des pets : idle (respiration), move (bonds penchés vers l'avant), ability (saut en vrille). Retourne { y, pitch, yaw, scale } ;
-- state "ability" attend p = progression 0..1 de la capacité (Easing.abilityProgress). Toutes les valeurs sont bornées.
function Easing.petPose(state, t, seed, p)
	seed = seed or 0
	if state == "move" then
		return { y = abs(sin(t * 9 + seed)) * 0.7, pitch = -0.18, yaw = sin(t * 9 + seed) * 0.08, scale = 1 }
	elseif state == "ability" then
		local q = clamp01(p or 0)
		return { y = sin(q * pi) * 1.8, pitch = 0, yaw = q * 2 * pi, scale = 1 + 0.25 * sin(q * pi) }
	end
	return { y = sin(t * 3 + seed) * 0.25, pitch = 0, yaw = sin(t * 0.8 + seed) * 0.12, scale = 1 }
end

-- Progression 0..1 de la capacité d'un pet (durée `window` s toutes les `interval` s environ, décalée par seed), nil hors capacité.
function Easing.abilityProgress(t, seed, interval, window)
	window = window or 1.1
	local period = (interval or 9) + ((seed or 0) % 5)
	if period <= window then
		return nil
	end
	local phase = (t + (seed or 0) * 1.3) % period
	if phase < window then
		return phase / window
	end
	return nil
end

function Easing.gatePulse(time, speed)
	return 0.5 + 0.5 * sin(time * (speed or 2))
end

-- Récompenses : effets de confettis selon la clé de son envoyée avec la notification serveur. nil = pas de confettis.
Easing.REWARD = {
	claim = { count = 24, minSpeed = 160, maxSpeed = 340, life = 1.3 },
	event = { count = 40, minSpeed = 180, maxSpeed = 380, life = 1.5 },
	rare = { count = 70, minSpeed = 200, maxSpeed = 440, life = 1.7 },
	levelup = { count = 60, minSpeed = 190, maxSpeed = 420, life = 1.8 }, -- montée de niveau de la maison
}
function Easing.rewardBurst(sfx)
	return Easing.REWARD[sfx]
end

-- Secousse de caméra (champ de vision) selon la clé de son : delta en degrés, durée d'un aller en secondes.
Easing.FOV_KICK = {
	steal = { delta = 5, time = 0.14 },
	caught = { delta = -8, time = 0.2 },
}

-- Particule `i` d'une salve de `count` confettis : éventail vers le haut, déterministe (suite de la section d'or).
-- Retourne { angle (radians, 0 = droite, -pi/2 = haut), speed, spin (degrés/s), hue [0,1), w, h (pixels) }.
function Easing.confettiParticle(i, count, burst)
	local minSpeed, maxSpeed = burst.minSpeed, burst.maxSpeed
	return {
		angle = -pi / 2 + (frac(i * 0.6180339887) - 0.5) * 1.8,
		speed = minSpeed + frac(i * 0.7548776662) * (maxSpeed - minSpeed),
		spin = (frac(i * 0.5698402910) - 0.5) * 720,
		hue = frac(i * 0.3819660113 + count * 0.01),
		w = 6 + floor(frac(i * 0.2599) * 7),
		h = 10 + floor(frac(i * 0.4143) * 9),
	}
end

-- Garde-fou d'une animation. isEnabled(name) -> bool ; failed : table partagée name -> true ; fn : l'animation (appelée sous pcall).
-- Une animation désactivée n'est pas exécutée. Une animation qui lève une erreur est désactivée pour le reste de la session
-- (onError(name, err) est appelé une seule fois). Retourne true si fn s'est exécutée sans erreur.
function Easing.guard(isEnabled, failed, name, fn, onError)
	if failed[name] or not isEnabled(name) then
		return false
	end
	local ok, err = pcall(fn)
	if not ok then
		failed[name] = true
		if onError then
			onError(name, err)
		end
	end
	return ok
end

return Easing
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX84"><Properties><string name="Name">Cinema</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Cinema
-- Logique PURE des cinématiques (aucun service Roblox, aucune Instance) : séquences de plans, lecteur à états (lecture, skip, abandon,
-- reprise), interpolation de caméra, directeur qui enchaîne une file. Easing est injecté : require(Cinema).new(Easing).
-- Le client (Cinematics.client.lua) ne fait qu'appliquer ces valeurs à la caméra.
local Cinema = {}

function Cinema.new(Easing)
	local C = {}

	-- Construit une séquence à partir de { id, shots = { { dur = secondes, ... }, ... } }.
	-- Retourne nil et un message si la définition est invalide (aucun plan, durée <= 0).
	function C.sequence(def)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucun plan"
		end
		local starts, t = {}, 0
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur <= 0 then
				return nil, "durée invalide (plan " .. i .. ")"
			end
			starts[i] = t
			t = t + shot.dur
		end
		return { id = def.id, shots = def.shots, starts = starts, total = t }
	end

	-- Plan actif à l'instant t (secondes depuis le début) : (index, progression dans [0, 1[), ou nil si la séquence est terminée.
	-- Un temps négatif est ramené à 0.
	function C.shotAt(seq, t)
		if t < 0 then
			t = 0
		end
		if t >= seq.total then
			return nil
		end
		for i = #seq.shots, 1, -1 do
			if t >= seq.starts[i] then
				return i, (t - seq.starts[i]) / seq.shots[i].dur
			end
		end
		return 1, 0
	end

	local function lerp3(a, b, e)
		return { a[1] + (b[1] - a[1]) * e, a[2] + (b[2] - a[2]) * e, a[3] + (b[3] - a[3]) * e }
	end

	-- Position et point visé de la caméra pour la progression p du plan (repère de l'ancre), avec adoucissement.
	function C.cameraAt(shot, p)
		local e = Easing.inOutSine(Easing.clamp01(p))
		return lerp3(shot.pos, shot.toPos or shot.pos, e), lerp3(shot.look, shot.toLook or shot.look, e)
	end

	-- Lecteur d'une séquence. États : idle -> playing -> done (raison : completed | skipped | aborted). play() redémarre à zéro (reprise).
	function C.player(seq)
		local P = { state = "idle", reason = nil, startedAt = 0, lastShot = 0 }
		function P.play(now)
			P.state, P.reason, P.startedAt, P.lastShot = "playing", nil, now, 0
		end
		function P.isPlaying()
			return P.state == "playing"
		end
		-- À appeler à chaque image. nil si rien ne joue ; sinon { shot, progress, shotChanged, finished, reason }.
		-- L'événement `finished` n'est renvoyé qu'une seule fois.
		function P.update(now)
			if P.state ~= "playing" then
				return nil
			end
			local i, p = C.shotAt(seq, now - P.startedAt)
			if not i then
				P.state, P.reason = "done", "completed"
				return { finished = true, reason = "completed" }
			end
			local changed = i ~= P.lastShot
			P.lastShot = i
			return { shot = i, progress = p, shotChanged = changed, finished = false }
		end
		function P.skip()
			if P.state == "playing" then
				P.state, P.reason = "done", "skipped"
				return true
			end
			return false
		end
		function P.abort()
			if P.state == "playing" then
				P.state, P.reason = "done", "aborted"
				return true
			end
			return false
		end
		return P
	end

	-- Directeur : une seule cinématique à la fois. Une demande « chain » pendant une lecture est mise en file (intro puis tutoriel) ;
	-- une autre demande est refusée (jamais de cinématique superposée). Une cinématique ne démarre jamais seule en plein jeu.
	function C.director()
		local D = { current = nil, queue = {} }

		local function startNext(now)
			local nxt = table.remove(D.queue, 1)
			if nxt then
				D.current = { id = nxt.id, seq = nxt.seq, player = C.player(nxt.seq) }
				D.current.player.play(now)
			end
		end

		-- Retourne "playing", "queued" ou "refused".
		function D.request(id, seq, now, chain)
			if D.current and D.current.player.isPlaying() then
				if chain then
					D.queue[#D.queue + 1] = { id = id, seq = seq }
					return "queued"
				end
				return "refused"
			end
			D.current = { id = id, seq = seq, player = C.player(seq) }
			D.current.player.play(now)
			return "playing"
		end

		-- Retourne (id, événement). À la fin d'une séquence, la suivante de la file démarre ; l'événement `finished` est renvoyé une fois.
		function D.update(now)
			local cur = D.current
			if not cur then
				return nil
			end
			local ev = cur.player.update(now)
			if ev and ev.finished then
				D.current = nil
				startNext(now)
			end
			return cur.id, ev
		end

		-- Passe la séquence en cours (la file continue). Retourne l'id passé, ou nil si rien ne jouait.
		function D.skip(now)
			local cur = D.current
			if cur and cur.player.skip() then
				D.current = nil
				startNext(now)
				return cur.id
			end
			return nil
		end

		-- Passe tout : la séquence en cours et la file. Retourne la liste des identifiants passés.
		function D.skipAll()
			local ids = {}
			local cur = D.current
			if cur and cur.player.skip() then
				ids[#ids + 1] = cur.id
			end
			for _, q in ipairs(D.queue) do
				ids[#ids + 1] = q.id
			end
			D.current, D.queue = nil, {}
			return ids
		end

		-- Abandon (mort, attaque, erreur) : tout s'arrête, la file est vidée, rien n'est considéré comme vu.
		function D.abort()
			local cur = D.current
			if cur then
				cur.player.abort()
			end
			D.current, D.queue = nil, {}
		end

		function D.isActive()
			return D.current ~= nil
		end

		return D
	end

	return C
end

return Cinema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX85"><Properties><string name="Name">VfxKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/VfxKit
-- Effets visuels 3D : DONNÉES PURES (préréglages nommés = séquences de pièces Blender, émetteurs de particules, faisceau, surbrillance) et
-- fonctions de planification testées hors de Roblox (qualité Élevé / Moyen / Bas, plafonds mobiles, effets par rareté), puis EXÉCUTION côté
-- client (VfxKit.play) : chaque pièce est un modèle Blender blanc (`Nom__FFFFFF`, Neon) cloné depuis ReplicatedStorage.VfxTemplates, recoloré
-- par code, ancré, sans collision, dont la transparence, l'échelle, la rotation et la hauteur sont animées par TweenService ; tout est nettoyé
-- (Debris) et protégé par pcall : un effet qui échoue ne casse jamais le jeu.
-- Utilisation : local Vfx = require(Shared.VfxKit).new(Config, Easing)
local VfxKit = {}

-- Modèles Blender d'effets (clé = nom du fichier Blender, voir Config.Assets.models.vfx).
VfxKit.MODELS = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Préréglages. Pièce : { model, at (retard s), dur (s), s0/s1 (échelle de départ/arrivée, 1 = taille Blender), t0/t1 (transparence), spin (rad/s),
-- rise (studs montés pendant l'effet), style (Back, Elastic, Quint, Quad, Sine), dir (Out, In, InOut), color ("rarity" | "white" | {r,g,b} 0-255) }.
-- L'ordre des pièces est leur priorité : la qualité Basse n'en garde que les premières. Particules : { count, life, speed, size, color }.
VfxKit.PRESETS = {
	aura_runique = {
		pieces = {
			{ model = "cercle_runique", at = 0, dur = 1.8, s0 = 0.3, s1 = 1.15, t0 = 0.9, t1 = 1, spin = 1.4, style = "Back", dir = "Out", color = "rarity", peak = 0.35 },
			{ model = "halo", at = 0.1, dur = 1.6, s0 = 0.5, s1 = 1.0, t0 = 0.85, t1 = 1, spin = -0.8, style = "Quint", dir = "Out", color = "rarity", peak = 0.4 },
		},
		particles = { count = 24, life = 1.4, speed = 5, size = 0.35, color = "rarity" },
		minQuality = "low",
	},
	aura_ailes = {
		pieces = { { model = "ailes", at = 0.2, dur = 2.2, s0 = 0.2, s1 = 1.2, t0 = 0.8, t1 = 1, rise = 1.5, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 } },
		particles = { count = 18, life = 1.8, speed = 3, size = 0.3, color = "rarity" },
		highlight = true,
		minQuality = "medium",
	},
	onde_de_choc = {
		pieces = { { model = "onde", at = 0, dur = 0.9, s0 = 0.2, s1 = 3.2, t0 = 0.2, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 } },
		particles = { count = 14, life = 0.8, speed = 14, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	pilier_revelation = {
		pieces = {
			{ model = "pilier_lumiere", at = 0.15, dur = 1.8, s0 = 0.1, s1 = 1.1, t0 = 0.7, t1 = 1, style = "Quint", dir = "Out", color = "rarity", peak = 0.25 },
			{ model = "rayons", at = 0.2, dur = 1.6, s0 = 0.4, s1 = 1.3, t0 = 0.75, t1 = 1, spin = 0.9, style = "Quint", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cone_lumiere", at = 0.3, dur = 1.5, s0 = 0.6, s1 = 1.0, t0 = 0.8, t1 = 1, style = "Sine", dir = "InOut", color = "white", peak = 0.45 },
		},
		particles = { count = 30, life = 2, speed = 8, size = 0.4, color = "white" },
		beam = true,
		minQuality = "low",
	},
	bouclier = {
		pieces = { { model = "bouclier", at = 0, dur = 1.4, s0 = 0.5, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.6, style = "Back", dir = "Out", color = { 90, 200, 255 }, peak = 0.45 } },
		highlight = true,
		minQuality = "low",
	},
	etincelles = {
		pieces = { { model = "etincelles", at = 0, dur = 1.6, s0 = 0.5, s1 = 1.2, t0 = 0.3, t1 = 1, rise = 3, style = "Quad", dir = "Out", color = "rarity", peak = 0.1 } },
		particles = { count = 30, life = 1.5, speed = 9, size = 0.3, color = "rarity" },
		minQuality = "low",
	},
	spirale_montee = {
		pieces = {
			{ model = "spirale", at = 0, dur = 2.4, s0 = 0.4, s1 = 1.2, t0 = 0.6, t1 = 1, spin = 3, rise = 8, style = "Quint", dir = "Out", color = "rarity", peak = 0.2 },
			{ model = "etoile", at = 1.0, dur = 1.2, s0 = 0.2, s1 = 1.4, t0 = 0.5, t1 = 1, spin = 1, rise = 10, style = "Back", dir = "Out", color = "white", peak = 0.2 },
		},
		particles = { count = 26, life = 2.2, speed = 6, size = 0.35, color = "rarity" },
		minQuality = "medium",
	},
	portail_torii = {
		pieces = {
			{ model = "torii", at = 0.3, dur = 2.6, s0 = 0.3, s1 = 1.0, t0 = 0.85, t1 = 1, style = "Back", dir = "Out", color = "rarity", peak = 0.3 },
			{ model = "cristaux", at = 0.5, dur = 2.2, s0 = 0.2, s1 = 1.0, t0 = 0.8, t1 = 1, spin = 0.4, style = "Elastic", dir = "Out", color = "rarity", peak = 0.3 },
		},
		particles = { count = 22, life = 2, speed = 4, size = 0.4, color = "rarity" },
		minQuality = "medium",
	},
}

-- Qualités. Mobile = Bas : au plus 3 effets simultanés, 40 particules par émetteur, jamais de faisceau (Beam).
VfxKit.QUALITY = {
	high = { rank = 3, maxConcurrent = 8, particleCap = 120, beams = true, maxPieces = 3, highlight = true },
	medium = { rank = 2, maxConcurrent = 5, particleCap = 70, beams = false, maxPieces = 2, highlight = true },
	low = { rank = 1, maxConcurrent = 3, particleCap = 40, beams = false, maxPieces = 1, highlight = false },
}

-- Effets (préréglages) joués pour une éclosion : ampleur croissante avec la rareté (1 Commun discret .. 5 Mythique) ; Cosmique et secret sont
-- spectaculaires. Retourne la liste ordonnée des préréglages et un facteur d'ampleur (échelle).
-- Lot 9 : tables indexées par rareté (1..10), sans seuil codé en dur ; les raretés migrées gardent leurs effets d'avant.
VfxKit.HATCH_AMP = { 0.55, 0.65, 0.75, 0.95, 1.2, 1.45, 1.8, 1.9, 1.9, 2 }
VfxKit.HATCH_FX = {
	{ "etincelles" },
	{ "etincelles" },
	{ "etincelles", "onde_de_choc" },
	{ "aura_runique", "onde_de_choc" },
	{ "pilier_revelation", "aura_runique", "aura_ailes", "onde_de_choc" },
	{ "pilier_revelation", "aura_runique", "aura_ailes", "spirale_montee", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
	{ "pilier_revelation", "spirale_montee", "aura_runique", "aura_ailes", "portail_torii", "onde_de_choc" },
}
function VfxKit.hatchEffects(tier, secret)
	tier = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), #VfxKit.HATCH_FX))
	if secret then
		return { "pilier_revelation", "spirale_montee", "portail_torii", "aura_runique", "onde_de_choc", "etincelles" }, 2
	end
	return VfxKit.HATCH_FX[tier], VfxKit.HATCH_AMP[tier]
end

-- Qualité : tactile = Bas, sinon Élevé ; `override` (« high », « medium », « low ») la remplace.
function VfxKit.quality(isTouch, override)
	if override and VfxKit.QUALITY[override] then
		return override
	end
	return isTouch and "low" or "high"
end

function VfxKit.new(Config, Easing)
	local K = { active = 0 }

	-- Couleur (r, g, b en 0-255) d'une rareté ; blanc si inconnue.
	function K.rarityColor(tier)
		local t = Config.TIERS[tier]
		local c = t and t.color
		if c then
			return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
		end
		return { 255, 255, 255 }
	end

	local function resolveColor(spec, tier)
		if spec == "white" then
			return { 255, 255, 255 }
		elseif type(spec) == "table" then
			return spec
		end
		return K.rarityColor(tier)
	end

	-- Courbe nommée (style de TweenService) sur [0, 1] : Back, Elastic, Quint, Quad, Sine (sortie ou entrée-sortie).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	-- Plan concret d'un préréglage pour une rareté et une qualité : pièces (priorité, nombre limité par la qualité), particules plafonnées,
	-- faisceau seulement en Élevé, surbrillance selon la qualité, durée totale. nil si préréglage inconnu ou trop exigeant pour la qualité.
	-- amp multiplie l'échelle (ampleur selon la rareté).
	function K.plan(name, tier, quality, amp)
		local preset = VfxKit.PRESETS[name]
		local q = VfxKit.QUALITY[quality]
		if not preset or not q then
			return nil
		end
		local need = VfxKit.QUALITY[preset.minQuality or "low"]
		if q.rank < need.rank then
			return nil
		end
		amp = (type(amp) == "number" and amp == amp and amp > 0) and math.min(amp, 3) or 1
		local pieces, duration = {}, 0
		for i, p in ipairs(preset.pieces) do
			if i > q.maxPieces then
				break
			end
			pieces[#pieces + 1] = {
				model = p.model, at = p.at, dur = p.dur, s0 = p.s0 * amp, s1 = p.s1 * amp, t0 = p.t0, t1 = p.t1, spin = p.spin or 0, rise = (p.rise or 0) * amp,
				style = p.style, dir = p.dir, color = resolveColor(p.color, tier), peak = p.peak,
			}
			duration = math.max(duration, p.at + p.dur)
		end
		local particles = nil
		if preset.particles then
			particles = {
				count = math.min(preset.particles.count, q.particleCap), life = preset.particles.life, speed = preset.particles.speed,
				size = preset.particles.size, color = resolveColor(preset.particles.color, tier),
			}
		end
		return {
			name = name, pieces = pieces, particles = particles, beam = preset.beam == true and q.beams, highlight = preset.highlight == true and q.highlight,
			duration = duration,
		}
	end

	-- Admission : combien d'effets peuvent encore démarrer (limite de simultanéité de la qualité).
	function K.admit(active, quality)
		local q = VfxKit.QUALITY[quality]
		return q ~= nil and type(active) == "number" and active < q.maxConcurrent
	end

	-- Liste ordonnée des plans d'une éclosion, tronquée à la simultanéité de la qualité (rien de plus que ce que le téléphone peut jouer).
	function K.hatchPlans(tier, secret, quality, activeNow)
		local names, amp = VfxKit.hatchEffects(tier, secret)
		local out = {}
		local active = activeNow or 0
		for _, name in ipairs(names) do
			if not K.admit(active + #out, quality) then
				break
			end
			local plan = K.plan(name, tier, quality, amp)
			if plan then
				out[#out + 1] = plan
			end
		end
		return out
	end

	-- Transparence d'une pièce à la progression p (0..1) : monte en fondu vers `peak` (visibilité maximale) puis disparaît ; valeur dans [0, 1].
	function K.transparencyAt(piece, p)
		p = Easing.clamp01(p)
		local appear = 0.25
		if p < appear then
			return piece.t0 + (piece.peak - piece.t0) * K.curve("Quad", p / appear)
		end
		local e = (p - appear) / (1 - appear)
		return math.min(math.max(piece.peak + (piece.t1 - piece.peak) * K.curve("Sine", e), 0), 1)
	end

	-- Échelle d'une pièce à la progression p.
	function K.scaleAt(piece, p)
		return piece.s0 + (piece.s1 - piece.s0) * K.curve(piece.style, p)
	end

	---------------------------------------------------------------- Exécution (client)
	-- env = { clone(model) -> Model|nil, tween = TweenService, debris = Debris, parent = Instance, spawn = task.spawn, delay = task.delay, color = Color3.fromRGB }
	-- Retourne true si l'effet a démarré. Tout est sous pcall ; l'effet est détruit à la fin (Debris) quoi qu'il arrive.
	function K.play(env, plan, cframe, opts)
		if not plan or K.active >= 99 then
			return false
		end
		local started = false
		local ok = pcall(function()
			local folder = Instance.new("Folder")
			folder.Name = "Vfx_" .. plan.name
			folder.Parent = env.parent
			env.debris:AddItem(folder, plan.duration + 1.5)
			K.active += 1
			env.delay(plan.duration + 1.4, function()
				K.active = math.max(0, K.active - 1)
			end)
			for _, piece in ipairs(plan.pieces) do
				env.delay(piece.at, function()
					pcall(function()
						local model = env.clone(piece.model)
						if not model then
							return
						end
						model.Parent = folder
						local color = env.color(piece.color[1], piece.color[2], piece.color[3])
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false
								d.CanQuery = false
								d.CanTouch = false
								d.CastShadow = false
								d.Color = color
								d.Transparency = piece.t0
							end
						end
						local base = model:GetScale()
						local pivot = cframe
						local value = Instance.new("NumberValue")
						value.Parent = folder
						local function apply(p)
							if not model.Parent then
								return
							end
							pcall(function()
								model:ScaleTo(math.max(0.01, base * K.scaleAt(piece, p)))
								model:PivotTo(pivot * CFrame.new(0, piece.rise * p, 0) * CFrame.Angles(0, piece.spin * p * piece.dur, 0))
								local tr = K.transparencyAt(piece, p)
								for _, d in ipairs(model:GetDescendants()) do
									if d:IsA("BasePart") then
										d.Transparency = tr
									end
								end
							end)
						end
						apply(0)
						value.Changed:Connect(apply)
						env.tween:Create(value, TweenInfo.new(piece.dur, Enum.EasingStyle.Linear), { Value = 1 }):Play() -- les courbes sont appliquées par apply (Back, Elastic, Quint...)
					end)
				end)
			end
			if plan.particles then
				local anchor = Instance.new("Part")
				anchor.Anchored = true
				anchor.CanCollide = false
				anchor.CanQuery = false
				anchor.Transparency = 1
				anchor.Size = Vector3.new(1, 1, 1)
				anchor.CFrame = cframe
				anchor.Parent = folder
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(env.color(plan.particles.color[1], plan.particles.color[2], plan.particles.color[3]))
				e.Rate = 0
				e.Lifetime = NumberRange.new(plan.particles.life * 0.6, plan.particles.life)
				e.Speed = NumberRange.new(plan.particles.speed * 0.5, plan.particles.speed)
				e.SpreadAngle = Vector2.new(180, 180)
				e.LightEmission = 1
				e.Size = NumberSequence.new(plan.particles.size)
				e.Parent = anchor
				e:Emit(plan.particles.count) -- plafonné par la qualité (40 sur téléphone)
			end
			if plan.beam then -- faisceau vertical (qualité Élevée seulement)
				local top = Instance.new("Part")
				top.Anchored = true
				top.CanCollide = false
				top.CanQuery = false
				top.Transparency = 1
				top.Size = Vector3.new(1, 1, 1)
				top.CFrame = cframe * CFrame.new(0, 14, 0)
				top.Parent = folder
				local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
				a0.Parent = top
				a1.Parent = folder:FindFirstChildOfClass("Part") or top
				local beam = Instance.new("Beam")
				beam.Attachment0, beam.Attachment1 = a0, a1
				beam.Width0, beam.Width1 = 0.6, 2.2
				beam.LightEmission = 1
				beam.Transparency = NumberSequence.new(0.35, 1)
				beam.Color = ColorSequence.new(env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255))
				beam.Parent = top
			end
			if plan.highlight and opts and opts.target then
				local hl = Instance.new("Highlight")
				hl.FillTransparency = 0.8
				hl.OutlineTransparency = 0.2
				hl.FillColor = env.color(plan.pieces[1] and plan.pieces[1].color[1] or 255, plan.pieces[1] and plan.pieces[1].color[2] or 255, plan.pieces[1] and plan.pieces[1].color[3] or 255)
				hl.Parent = opts.target
				env.debris:AddItem(hl, plan.duration)
			end
			started = true
		end)
		return ok and started
	end

	return K
end

return VfxKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX86"><Properties><string name="Name">CinematicKit</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/CinematicKit
-- Caméras de cinématique : LOGIQUE PURE (aucun service Roblox) testée hors de Roblox. Un « plan » est une liste de prises { dur, pos, look, toPos, toLook,
-- fov, toFov, path, ease, shake, slow, text, title, fx, anchor } dans le repère de son ancre ; trajectoires : travelling (linéaire), orbite autour du
-- point visé, plongée (de haut en bas), zoom dolly (la caméra avance et le champ de vision se resserre). Bandes noires, cartons de titre, tremblement,
-- ralenti et bouton Passer sont appliqués par le client (Cinematics.client.lua) à partir de ces valeurs.
-- Garanties : jamais plus de 8 secondes réelles (MAX_SECONDS) ; aucune cinématique si le joueur est en danger (`canPlay`) ; la caméra et le contrôle
-- sont restitués par le client quoi qu'il arrive (fin, passage, erreur, départ). Utilisation : require(CinematicKit).new(Easing, Cinema).
local CinematicKit = {}

CinematicKit.MAX_SECONDS = 8

-- Plans nommés. Les positions sont { x, y, z } dans le repère de l'ancre (arena, base, pad, rival1..3, castle, world, hubfountain, hubportals).
-- `slow = { at, to, scale }` : entre ces progressions de la prise (0..1), le temps s'écoule à `scale` (0.35 = ralenti), ce qui allonge la durée réelle.
CinematicKit.PLANS = {
	hub_survol = { id = "hub_survol", shots = {
		{ anchor = "hubfountain", pos = { 0, 30, 70 }, look = { 0, 3, 0 }, toPos = { 0, 18, 40 }, path = "travel", dur = 2.2, ease = "Quint", title = "🥚 Bienvenue !" },
		{ anchor = "hubportals", pos = { 0, 22, 100 }, look = { 0, 8, -60 }, toPos = { 0, 14, 30 }, toLook = { 0, 8, -80 }, path = "travel", dur = 2.8, ease = "Sine", text = "Choisis un portail : seul, ou avec des amis." },
	} },
	secret = { id = "secret", shots = {
		{ anchor = "pad", pos = { 0, 6, 10 }, look = { 0, 3, 0 }, toPos = { 0, 14, 6 }, path = "dive", dur = 1.4, ease = "Quint", shake = 0.25, title = "✦ ???" },
		{ anchor = "pad", pos = { 0, 12, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = 2.4, height = 8, dur = 3.4, ease = "Sine", shake = 0.5, slow = { at = 0.35, to = 0.6, scale = 0.4 }, fx = "flash" },
		{ anchor = "pad", pos = { 0, 5, 9 }, look = { 0, 4, 0 }, path = "dolly", fov = 70, toFov = 46, toPos = { 0, 4, 3 }, dur = 1.4, ease = "Back", title = "✦ SECRET ✦" },
	} },
	chateau_entree = { id = "chateau_entree", shots = {
		{ anchor = "castle", pos = { -40, 16, 34 }, look = { 0, 6, -8 }, toPos = { 40, 14, 34 }, toLook = { 0, 8, -8 }, path = "travel", dur = 2.6, ease = "Sine", title = "🏰 Le Château" },
		{ anchor = "castle", pos = { 0, 5, 16 }, look = { 0, 7, 0 }, toPos = { 0, 6, 9 }, path = "dolly", fov = 70, toFov = 55, dur = 2.2, ease = "Quint", text = "La herse se lève…", fx = "gate" },
	} },
	-- Montée de niveau de la maison (D.4) : 4,5 s au total (2,7 + 1,8), plan large depuis l'avant de la base vers la maison à l'arrière ; passable (Passer, toucher l'écran).
	base_niveau = { id = "base_niveau", skipOnTap = true, shots = {
		{ anchor = "base", pos = { 0, 24, -62 }, look = { 0, 6, 14 }, toPos = { 0, 20, -50 }, path = "travel", dur = 2.7, ease = "Sine", title = "🏠 Ta base évolue !" },
		{ anchor = "base", pos = { -34, 16, -26 }, look = { 0, 8, 16 }, toPos = { 34, 16, -26 }, path = "travel", dur = 1.8, ease = "Sine" },
	} },
	chateau_victoire = { id = "chateau_victoire", shots = {
		{ anchor = "castle_chest", pos = { 6, 7, 10 }, look = { 0, 3, 0 }, toPos = { 3, 5, 6 }, path = "dolly", fov = 70, toFov = 52, dur = 1.6, ease = "Quint", slow = { at = 0.4, to = 0.9, scale = 0.35 }, shake = 0.3, fx = "sparks" },
		{ anchor = "castle_chest", pos = { 0, 6, 11 }, look = { 0, 3, 0 }, path = "orbit", radius = 11, toRadius = 9, angle0 = 0.6, angle1 = 2.0, height = 6, dur = 2.4, ease = "Sine", title = "🏆 Victoire !" },
	} },
}

-- Plan d'éclosion selon la rareté (1..6) : plus la rareté monte, plus la caméra s'engage (orbite, zoom, secousse, ralenti, pilier de lumière côté VfxKit).
-- Commun et Rare : AUCUNE cinématique (les effets 3D de VfxKit suffisent) ; Épique : plan court ; Légendaire et au-delà : plan complet.
-- Lot 9 : genre de plan par rareté (1..10) : "none", "short" (Épique), "full", "big" (Mythique et au-delà).
CinematicKit.TIER_PLAN = { "none", "none", "none", "short", "full", "big", "big", "big", "big", "big" }
function CinematicKit.hatchPlan(tier, secret)
	tier = math.floor(math.min(math.max(type(tier) == "number" and tier == tier and tier or 1, 1), #CinematicKit.TIER_PLAN))
	local kind = CinematicKit.TIER_PLAN[tier]
	if secret then
		return CinematicKit.PLANS.secret
	elseif kind == "none" then
		return nil
	elseif kind == "short" then
		return { id = "eclosion_epique", skipOnTap = true, shots = {
			{ anchor = "pad", pos = { 0, 8, 12 }, look = { 0, 3, 0 }, toPos = { 0, 5, 7 }, path = "dolly", fov = 70, toFov = 56, dur = 1.6, ease = "Quint", shake = 0.15 },
		} }
	end
	local big = kind == "big"
	return { id = "eclosion", skipOnTap = true, shots = {
		{ anchor = "pad", pos = { 0, 7, 12 }, look = { 0, 3, 0 }, path = "orbit", radius = 12, toRadius = 8, angle0 = 0, angle1 = big and 2.2 or 1.6, height = 6, dur = big and 2.4 or 1.8, ease = "Sine" },
		{ anchor = "pad", pos = { 0, 5, 8 }, look = { 0, 3.2, 0 }, path = "dolly", fov = 70, toFov = big and 44 or 52, toPos = { 0, 4, 4 }, dur = big and 1.8 or 1.2, ease = "Back", shake = big and 0.6 or 0.4, slow = { at = 0.5, to = 1, scale = 0.35 }, fx = "crack" },
		{ anchor = "pad", pos = { 0, 6, 9 }, look = { 0, 4, 0 }, toPos = { 0, 7, 11 }, path = "travel", fov = big and 52 or 60, toFov = 70, dur = big and 1.6 or 1.2, ease = "Quint", title = nil },
	} }
end

-- Plan court « gardien ou chevalier qui repère le joueur » : AUCUN mouvement de caméra (le joueur garde le contrôle, il est en danger) : un à-coup
-- de champ de vision, un peu de tremblement et un « ❗ » (voir `overlay`). Retourne le descriptif d'effet d'interface.
CinematicKit.ALERT = { seconds = 1.2, fovPunch = 8, shake = 0.35, title = "❗", cooldown = 90, perSession = 3 }

function CinematicKit.new(Easing, Cinema)
	local K = {}

	-- Courbe nommée (style de TweenService).
	function K.curve(style, x)
		x = Easing.clamp01(x)
		if style == "Back" then
			return Easing.outBack(x)
		elseif style == "Elastic" then
			return Easing.outElastic(x)
		elseif style == "Quint" then
			return 1 - (1 - x) ^ 5
		elseif style == "Quad" then
			return Easing.outQuad(x)
		end
		return Easing.inOutSine(x)
	end

	local function lerp(a, b, e)
		return a + (b - a) * e
	end
	local function lerp3(a, b, e)
		return { lerp(a[1], b[1], e), lerp(a[2], b[2], e), lerp(a[3], b[3], e) }
	end

	-- Durée RÉELLE d'une prise (le ralenti l'allonge) : dur x (1 + (1/scale - 1) x largeur de la zone lente).
	function K.realDuration(shot)
		local s = shot.slow
		if not s then
			return shot.dur
		end
		local width = math.max(0, math.min(1, s.to) - math.max(0, s.at))
		return shot.dur * (1 + (1 / math.max(0.05, s.scale) - 1) * width)
	end

	function K.realTotal(def)
		local t = 0
		for _, shot in ipairs(def.shots) do
			t = t + K.realDuration(shot)
		end
		return t
	end

	-- Plan normalisé : durées réduites proportionnellement si la durée RÉELLE dépasse `maxSeconds` (8 par défaut) ; prise invalide (durée <= 0, NaN) = refus.
	-- Retourne (définition prête pour Cinema.sequence, durée réelle) ou (nil, raison).
	function K.build(def, maxSeconds)
		if type(def) ~= "table" or type(def.shots) ~= "table" or #def.shots == 0 then
			return nil, "aucune prise"
		end
		maxSeconds = (type(maxSeconds) == "number" and maxSeconds > 0) and math.min(maxSeconds, CinematicKit.MAX_SECONDS) or CinematicKit.MAX_SECONDS
		for i, shot in ipairs(def.shots) do
			if type(shot.dur) ~= "number" or shot.dur ~= shot.dur or shot.dur <= 0 or type(shot.pos) ~= "table" or type(shot.look) ~= "table" then
				return nil, "prise invalide (" .. i .. ")"
			end
		end
		local real = K.realTotal(def)
		local k = real > maxSeconds and (maxSeconds / real) or 1
		local shots = {}
		for i, shot in ipairs(def.shots) do
			local copy = {}
			for key, v in pairs(shot) do
				copy[key] = v
			end
			copy.dur = shot.dur * k
			shots[i] = copy
		end
		local out = { id = def.id, shots = shots, skipOnTap = def.skipOnTap }
		return out, real * k
	end

	-- Temps virtuel (celui des prises) atteint après `realElapsed` secondes réelles : le ralenti fait avancer le temps plus lentement dans sa zone.
	function K.virtualElapsed(def, realElapsed)
		local virtual, left = 0, math.max(0, realElapsed)
		for _, shot in ipairs(def.shots) do
			local rd = K.realDuration(shot)
			if left >= rd then
				virtual = virtual + shot.dur
				left = left - rd
			else
				local s = shot.slow
				if not s then
					return virtual + left
				end
				local a, b = math.max(0, s.at) * shot.dur, math.min(1, s.to) * shot.dur
				local slowReal = (b - a) / math.max(0.05, s.scale)
				if left <= a then
					return virtual + left
				elseif left <= a + slowReal then
					return virtual + a + (left - a) * math.max(0.05, s.scale)
				end
				return virtual + b + (left - a - slowReal)
			end
		end
		return virtual
	end

	-- Caméra à la progression p d'une prise : (position, point visé, champ de vision) dans le repère de l'ancre.
	function K.cameraAt(shot, p)
		local e = K.curve(shot.ease or "Sine", p)
		local fov = lerp(shot.fov or 70, shot.toFov or shot.fov or 70, e)
		local look = lerp3(shot.look, shot.toLook or shot.look, e)
		local path = shot.path
		if path == "orbit" then
			local r = lerp(shot.radius or 10, shot.toRadius or shot.radius or 10, e)
			local a = lerp(shot.angle0 or 0, shot.angle1 or (shot.angle0 or 0), e)
			return { look[1] + math.sin(a) * r, look[2] + (shot.height or 5), look[3] + math.cos(a) * r }, look, fov
		elseif path == "dive" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- plongée : de haut en bas (ou l'inverse) en gardant la cible
		elseif path == "dolly" then
			return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- zoom dolly : la caméra avance, le champ de vision se resserre
		end
		return lerp3(shot.pos, shot.toPos or shot.pos, e), look, fov -- travelling
	end

	-- Décalage de caméra dû au tremblement (amplitude shot.shake en studs, décroissante sur la prise, bruit déterministe).
	function K.shakeOffset(shot, p, time)
		local amp = shot.shake
		if not amp or amp <= 0 then
			return { 0, 0, 0 }
		end
		local decay = (1 - Easing.clamp01(p)) ^ 1.5
		local a = amp * decay
		return { math.sin(time * 47.3) * a * 0.5, math.sin(time * 61.1 + 1.7) * a * 0.4, math.cos(time * 39.7) * a * 0.3 }
	end

	-- Le joueur peut-il voir une cinématique maintenant ? ctx = { hp, maxHp, sinceHit (s depuis le dernier coup), chased (poursuivi par un gardien),
	-- inTrapRoom (dans une salle à pièges du château), dead }. Jamais en danger : peu de pv, coup récent, poursuite, salle à pièges, mort.
	function K.canPlay(ctx)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.5 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 4) or ctx.chased or ctx.inTrapRoom then
			return false
		end
		return true
	end

	-- Alerte (gardien ou chevalier qui repère le joueur) : pas une cinématique (aucune caméra) ; autorisée même poursuivi, mais pas à moins de 40 % de pv
	-- ni juste après un coup, avec temps de recharge et nombre maximum par session.
	function K.canAlert(ctx, now, lastAt, shown)
		if type(ctx) ~= "table" or ctx.dead then
			return false
		end
		local maxHp = (type(ctx.maxHp) == "number" and ctx.maxHp > 0) and ctx.maxHp or 100
		local hp = type(ctx.hp) == "number" and ctx.hp == ctx.hp and ctx.hp or maxHp
		if hp / maxHp < 0.4 or (type(ctx.sinceHit) == "number" and ctx.sinceHit < 2) then
			return false
		end
		if (shown or 0) >= CinematicKit.ALERT.perSession or (lastAt and now - lastAt < CinematicKit.ALERT.cooldown) then
			return false
		end
		return true
	end

	-- Gestionnaire de lecture : une seule cinématique à la fois (le directeur de Cinema refuse la seconde), passage immédiat, restitution garantie.
	-- host = { takeCamera(), giveCameraBack(), apply(shotIndex, progress, shot) } ; toute erreur de host.apply restitue la caméra et abandonne.
	-- Retourne un objet { start(def, now), update(now), skip(now), abort(), isActive(), restored } pour le client et les tests.
	function K.runner(host)
		local R = { restored = 0 }
		local director = Cinema.director()
		local current = nil
		local function restore()
			if current then
				current = nil
			end
			R.restored = R.restored + 1
			pcall(host.giveCameraBack)
		end
		-- Retourne "playing", "queued" ou "refused" (ou "invalid").
		function R.start(def, now, chain)
			local built, real = K.build(def)
			if not built then
				return "invalid"
			end
			local seq = Cinema.sequence(built)
			if not seq then
				return "invalid"
			end
			local result = director.request(def.id, seq, now, chain)
			if result == "playing" then
				current = { def = built, startedAt = now, seq = seq, real = real }
				local ok = pcall(host.takeCamera)
				if not ok then
					director.abort()
					restore()
					return "invalid"
				end
			end
			return result
		end
		function R.update(now)
			if not current then
				return nil
			end
			local virtual = K.virtualElapsed(current.def, now - current.startedAt)
			local id, ev = director.update(current.startedAt + virtual)
			if not id or (ev and ev.finished) then
				restore()
				return "finished"
			end
			if ev and ev.shot then
				local ok = pcall(host.apply, ev.shot, ev.progress, current.def.shots[ev.shot])
				if not ok then
					director.abort()
					restore()
					return "error"
				end
			end
			return "playing"
		end
		function R.skip(now)
			if director.skip(now) then
				restore()
				return true
			end
			return false
		end
		function R.abort()
			director.abort()
			if current then
				restore()
			end
		end
		function R.isActive()
			return director.isActive()
		end
		return R
	end

	return K
end

return CinematicKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX87"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Placement
-- Pose PLANIFIÉE du décor Blender (arbres, rochers, buissons, cabanes, barrières, ponts) : logique PURE, déterministe, testée hors de Roblox.
-- Principes : une grille de cellules parcourue dans un ordre fixe (aucun tirage libre), chaque objet a une empreinte circulaire ; il n'est posé que si son
-- empreinte ne touche NI l'eau (lacs, rivières, fontaine, douve), NI un chemin, NI la place, l'arène, un territoire, une base, un secret ou une plume
-- (règles de MapGeo.blocked), et reste à distance minimale des objets déjà posés. Cabanes tournées face au centre de leur territoire, barrières
-- alignées sur une même ligne, ponts de bois centrés sur leur cours d'eau. Forêts par rectangles et bosquets (REFONTE lot 2, carte 700 x 500).
-- Utilisation : require(Placement).new(Config).plan() (MapGeo chargé à côté ; les tests le passent : Placement.new(Config, MapGeo)).
local Placement = {}

-- Pause coopérative facultative (Builder la règle sur task.wait) : les calculs de pose cèdent la main tous les 25 essais (jamais de gel du serveur ;
-- les tests purs la laissent à nil).
Placement.yield = nil
local pauseCount = 0
local function pause()
	pauseCount = pauseCount + 1
	if Placement.yield and pauseCount % 25 == 0 then
		Placement.yield()
	end
end

local KIND_RADIUS = { tree = 3.5, fir = 3.5, rock = 2.5, bush = 2, hut = 7, fence = 5.5 }
Placement.KIND_RADIUS = KIND_RADIUS
Placement.MIN_GAP = 2 -- espace libre minimal entre deux empreintes (studs)
Placement.CELL = 30

-- Angle (degrés) de rotation autour de Y pour qu'un modèle dont l'avant est -Z regarde la direction (dx, dz). Portable (pas de math.atan2).
function Placement.facing(dx, dz)
	local fx, fz = -dx, -dz -- on veut sin(theta) = -dx/len et cos(theta) = -dz/len
	if fx == 0 and fz == 0 then
		return 0
	end
	local theta
	if fz == 0 then
		theta = fx > 0 and math.pi / 2 or -math.pi / 2
	else
		theta = math.atan(fx / fz)
		if fz < 0 then
			theta = theta + math.pi
		end
	end
	return math.deg(theta) % 360
end

local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / len2)) or 0
	local cx, cz = ax + dx * t, az + dz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Placement.distToSegment = distToSegment

-- Angle Y (degrés, convention Roblox : CFrame.Angles(0, a, 0) envoie +X vers (cos a, -sin a)) d'un déplacement (dx, dz). Pas de math.atan2.
function Placement.yawOfDir(dx, dz)
	local ax, az = dx, -dz -- on veut cos a = dx/len, sin a = -dz/len
	if ax == 0 and az == 0 then
		return 0
	end
	local a
	if ax == 0 then
		a = az > 0 and math.pi / 2 or -math.pi / 2
	else
		a = math.atan(az / ax)
		if ax < 0 then
			a = a + math.pi
		end
	end
	return math.deg(a) % 360
end

-- REFONTE (lot 2) : le module MapGeo (géométrie de la carte 700 x 500) est injecté par l'appelant ou chargé à côté de ce module.
local function loadGeo(MapGeo)
	if MapGeo then
		return MapGeo
	end
	if Placement.MapGeo then
		return Placement.MapGeo
	end
	local ok, mod = pcall(function()
		return require(script.Parent:WaitForChild("MapGeo"))
	end)
	if ok then
		Placement.MapGeo = mod
		return mod
	end
	error("Placement : module MapGeo introuvable (passe-le à Placement.new(Config, MapGeo))")
end

-- Variante d'arbre selon la zone : tree_sakura près des lacs et de la place, tree_pine au nord (derrière la rivière), autour des territoires et sur le
-- plateau du château, sinon prairie (chênes, bouleau, arbre rond en alternance ; tree_oak_b porte des pommes). `kind` = "tree" ou "fir" (les sapins
-- restent des pins). `k` = rang (déterministe).
function Placement.treeVariant(Config, kind, x, z, k, MapGeo)
	if kind == "fir" then
		return "tree_pine"
	end
	local M2 = Config.Map2
	for _, lk in ipairs(M2.lakes) do
		if math.sqrt((x - lk.x) ^ 2 + (z - lk.z) ^ 2) < lk.r + 40 then
			return "tree_sakura"
		end
	end
	if math.sqrt((x - M2.plaza.x) ^ 2 + (z - M2.plaza.z) ^ 2) < M2.plaza.r + 50 then
		return "tree_sakura"
	end
	if z < -180 then
		return "tree_pine"
	end
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		if math.sqrt((x - t.x) ^ 2 + (z - t.z) ^ 2) < t.r + 25 then
			return "tree_pine"
		end
	end
	return ({ "tree_oak_a", "tree_oak_b", "tree_birch", "tree_round" })[(k or 0) % 4 + 1]
end

-- Échelle aléatoire déterministe 1 ± jitter d'après la position (jamais de tirage libre).
function Placement.jitter(x, z, jitter)
	local h = math.abs(math.sin(x * 12.9898 + z * 78.233) * 43758.5453)
	return 1 + ((h - math.floor(h)) * 2 - 1) * jitter
end

-- Chemin sinueux : la polyligne est rééchantillonnée tous les `tile` studs et décalée latéralement d'une sinusoïde (amplitude `wind`, nulle aux
-- extrémités et aux sommets). Retourne { tiles = { {kind, x, z, rot} }, borders = { {x, z, rot} } } : tuiles droites (le long de X, tournées vers la
-- direction), tuile de virage quand la direction tourne de 50° à 130° (rotation par pas de 90°), bordures de pierres de part et d'autre.
function Placement.pathTiles(poly, tile, wind)
	local pts, cum = {}, { 0 }
	local verts = {}
	local total = 0
	for k = 1, #poly - 1 do
		local ax, az, bx, bz = poly[k][1], poly[k][2], poly[k + 1][1], poly[k + 1][2]
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		verts[#verts + 1] = total
		local n = math.max(1, math.floor(len / tile + 0.5))
		for j = 0, n - 1 do
			local t = j / n
			local dx, dz = (bx - ax) / len, (bz - az) / len
			pts[#pts + 1] = { x = ax + (bx - ax) * t, z = az + (bz - az) * t, nx = -dz, nz = dx, d = total + len * t }
		end
		total = total + len
	end
	local last = poly[#poly]
	local pdx, pdz = last[1] - poly[#poly - 1][1], last[2] - poly[#poly - 1][2]
	local pl = math.sqrt(pdx * pdx + pdz * pdz)
	pts[#pts + 1] = { x = last[1], z = last[2], nx = -pdz / pl, nz = pdx / pl, d = total }
	verts[#verts + 1] = total
	for _, p in ipairs(pts) do
		local near = total
		for _, v in ipairs(verts) do
			near = math.min(near, math.abs(p.d - v))
		end
		local env = math.min(1, near / (tile * 2))
		local off = (wind or 0) * math.sin(p.d / 38) * env
		p.x, p.z = p.x + p.nx * off, p.z + p.nz * off
	end
	local tiles, borders = {}, {}
	local snap = function(dx, dz)
		if math.abs(dx) >= math.abs(dz) then
			return dx > 0 and 1 or -1, 0
		end
		return 0, dz > 0 and 1 or -1
	end
	for i = 1, #pts do
		local a, b = pts[i], pts[i + 1] or pts[i]
		local pa = pts[i - 1]
		local dx, dz = b.x - a.x, b.z - a.z
		if i == #pts then
			dx, dz = a.x - pa.x, a.z - pa.z
		end
		local rot = Placement.yawOfDir(dx, dz)
		local kind = "path_straight"
		if pa and i < #pts then
			local ix, iz = a.x - pa.x, a.z - pa.z
			local li, lo = math.sqrt(ix * ix + iz * iz), math.sqrt(dx * dx + dz * dz)
			local cosT = (ix * dx + iz * dz) / (li * lo)
			if cosT < 0.64 and cosT > -0.64 then -- tourne de 50° à 130°
				local ux, uz = snap(ix, iz)
				local vx, vz = snap(dx, dz)
				-- virage de base : on entre en allant vers +X et on sort vers -Z ; 4 rotations x (sens direct / inverse)
				local found
				for q = 0, 3 do
					local th = math.rad(q * 90)
					local function rot90(x, z) -- image de (x, z) par Angles(0, th, 0)
						return math.floor(x * math.cos(th) + z * math.sin(th) + 0.5), math.floor(-x * math.sin(th) + z * math.cos(th) + 0.5)
					end
					local ex, ez = rot90(1, 0)
					local fx, fz = rot90(0, -1)
					if ex == ux and ez == uz and fx == vx and fz == vz then
						found = q * 90
					elseif -fx == ux and -fz == uz and -ex == vx and -ez == vz then
						found = q * 90 -- tuile parcourue en sens inverse
					end
				end
				if found then
					kind, rot = "path_curve", found
				end
			end
		end
		tiles[#tiles + 1] = { kind = kind, x = a.x, z = a.z, rot = rot }
		local nxl, nzl = -dz, dx
		local nl = math.sqrt(nxl * nxl + nzl * nzl)
		if nl > 0 then
			for _, side in ipairs({ -1, 1 }) do
				borders[#borders + 1] = { x = a.x + side * nxl / nl * (tile / 2 + 1.2), z = a.z + side * nzl / nl * (tile / 2 + 1.2), rot = rot }
			end
		end
	end
	return { tiles = tiles, borders = borders, length = total }
end

function Placement.new(Config, MapGeo)
	local MG = loadGeo(MapGeo)
	local G = MG.new(Config)
	local P = { G = G }
	local M2 = Config.Map2
	local B = M2.bounds

	-- Segments des chemins au sol (mêmes polylignes que Scenery.paths) : { ax, az, bx, bz } ; les ponts sont des chemins.
	function P.pathSegments()
		local out = {}
		for _, sg in ipairs(G.pathSegs) do
			if (sg.y or 0) == 0 then
				out[#out + 1] = { sg[1], sg[2], sg[3], sg[4], half = sg.half }
			end
		end
		return out
	end

	-- Altitude du sol en (x, z) : plateau du château, colline, sinon 0.
	function P.groundY(x, z)
		return G.groundY(x, z)
	end

	-- Pourquoi une empreinte (x, z, r) est interdite : "eau", "chemin", "place", "repère", "arène", "château", "domaine", "base", "secret",
	-- "plume", "bord" ou nil si libre. opts.allowDomain : dans un territoire (cabanes, barrières) ; opts.allowPlateau : sur le plateau du château.
	function P.blocked(x, z, r, opts)
		return G.blocked(x, z, r, opts)
	end

	-- Empreintes réservées dans les territoires : nids et postes des gardiens (rien n'y est posé).
	local reserved = {}
	for _, t in ipairs(G.terrs) do
		for _, n in ipairs(t.nests or {}) do
			reserved[#reserved + 1] = { n[1], n[2], 5 }
		end
		for _, p in ipairs(t.posts or {}) do
			reserved[#reserved + 1] = { p[1], p[2], 6 }
		end
	end
	reserved[#reserved + 1] = { G.keep.x, G.keep.z, G.keep.half + 4 }
	local function freeOfReserved(x, z, r)
		for _, q in ipairs(reserved) do
			if math.sqrt((x - q[1]) ^ 2 + (z - q[2]) ^ 2) < q[3] + r then
				return false
			end
		end
		return true
	end

	-- Arbres PROCÉDURAUX des forêts (rectangles de Map2.forests, débordant sur le décor de fond au bord de la carte) et des bosquets : positions
	-- déterministes, rien dans l'eau, sur un chemin, une base ou un territoire. { {x, z, r, y, grove} } ; au plus Map2.procTrees en forêt.
	function P.forest()
		if G._forest then
			return G._forest
		end
		local out = {}
		local r = 3.5
		local function freeHere(x, z)
			pause()
			if math.abs(x) > M2.backdrop.w / 2 - 6 or math.abs(z) > M2.backdrop.d / 2 - 6 then
				return false
			end
			local why = G.blocked(x, z, r, {})
			if why and not (why == "bord" and not G.inBounds(x, z, 0)) then
				return false
			end
			if not freeOfReserved(x, z, r) then
				return false
			end
			for _, o in ipairs(out) do
				if math.sqrt((x - o.x) ^ 2 + (z - o.z) ^ 2) < 2 * r + Placement.MIN_GAP then
					return false
				end
			end
			return true
		end
		-- bosquets : groveTrees arbres en couronne
		for gi, gv in ipairs(M2.groves) do
			for k = 1, M2.groveTrees do
				local a = (k / M2.groveTrees + gi * 0.13) * math.pi * 2
				local rad = M2.groveRadius * (k % 2 == 0 and 0.75 or 0.35)
				local x, z = gv.x + math.cos(a) * rad, gv.z + math.sin(a) * rad
				if freeHere(x, z) then
					out[#out + 1] = { x = x, z = z, r = r, y = G.groundY(x, z), grove = gi }
				end
			end
		end
		-- forêts : quota proportionnel au maximum de chaque rectangle ; un rectangle collé au bord déborde de 24 studs dans le décor de fond
		local sumMax = 0
		for _, f in ipairs(M2.forests) do
			sumMax = sumMax + f.max
		end
		local seed = 2711
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		for _, f in ipairs(M2.forests) do
			local quota = math.floor(M2.procTrees * f.max / sumMax + 0.5)
			local x0, x1, z0, z1 = f.x0, f.x1, f.z0, f.z1
			if x0 <= B.x0 then
				x0 = x0 - 24
			end
			if x1 >= B.x1 then
				x1 = x1 + 24
			end
			if z0 <= B.z0 then
				z0 = z0 - 24
			end
			if z1 >= B.z1 then
				z1 = z1 + 24
			end
			local cells = {}
			local step = 11
			for gx = x0 + step / 2, x1, step do
				for gz = z0 + step / 2, z1, step do
					cells[#cells + 1] = { gx, gz }
				end
			end
			for i = #cells, 2, -1 do
				local j = 1 + math.floor(rnd() * i)
				cells[i], cells[j] = cells[j], cells[i]
			end
			local got = 0
			for _, c in ipairs(cells) do
				if got >= quota then
					break
				end
				local x, z = c[1] + (rnd() - 0.5) * 5, c[2] + (rnd() - 0.5) * 5
				if freeHere(x, z) then
					out[#out + 1] = { x = x, z = z, r = r, y = G.groundY(x, z) }
					got = got + 1
				end
			end
		end
		G._forest = out
		return out
	end

	-- Plan complet : { items = { {kind, x, z, rot, r, y} }, bridges = { {x, z, rot, length, name} }, forest = P.forest() }. Déterministe.
	function P.plan()
		if G._plan then
			return G._plan
		end
		local items = {}
		local forest = P.forest()
		local function fits(kind, x, z, opts)
			pause()
			local r = KIND_RADIUS[kind]
			if P.blocked(x, z, r, opts) or not freeOfReserved(x, z, r) then
				return false
			end
			for _, it in ipairs(items) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + Placement.MIN_GAP then
					return false
				end
			end
			for _, it in ipairs(forest) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + Placement.MIN_GAP then
					return false
				end
			end
			return true
		end
		local function add(kind, x, z, rot)
			items[#items + 1] = { kind = kind, x = x, z = z, rot = rot, r = KIND_RADIUS[kind], y = P.groundY(x, z) }
		end
		local plan = Config.Assets.propsPlan
		-- 1. par rival (premier territoire) : une ligne de barrières alignée puis une cabane face au centre du territoire (jamais dans l'eau)
		for i = 1, #Config.RIVALS do
			local cx, cz = Config.rivalCenter(i)
			local t = G.terr(Config.rivalTerritories(i)[1].key)
			local inner = t.r - 10
			local opts = { allowDomain = true, allowPlateau = true }
			local perDomain = math.ceil((plan.fence or 0) / #Config.RIVALS)
			for k = 0, perDomain - 1 do
				local fx, fz = cx - 20.25 + k * 13.5, cz - (t.r - 12) -- côté nord du territoire
				if fits("fence", fx, fz, opts) then
					add("fence", fx, fz, 0) -- alignées sur l'axe X, même rotation : jamais de barrières qui se croisent
				end
			end
			for _, off in ipairs({ { -1, 0.3 }, { 1, 0.3 }, { -0.7, -0.7 }, { 0.7, -0.7 }, { 0, 1 }, { 0, -1 }, { 0, 0.55 }, { 0.55, 0 }, { -0.55, 0 }, { 0, -0.55 } }) do
				local hx, hz = cx + off[1] * inner, cz + off[2] * inner
				if (plan.hut or 0) > 0 and fits("hut", hx, hz, opts) then
					add("hut", hx, hz, Placement.facing(cx - hx, cz - hz))
					break
				end
			end
		end
		-- 2. décor libre : les sapins et les arbres vont d'abord dans les forêts, puis partout ; rochers et buissons sur toute la carte
		local seed = 4093 -- Park–Miller : mélange déterministe des cellules
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		local cell = Placement.CELL
		local cells, forestCells = {}, {}
		for gx = B.x0 + 10, B.x1 - 10, cell do
			for gz = B.z0 + 10, B.z1 - 10, cell do
				local c = { gx + cell / 2, gz + cell / 2 }
				cells[#cells + 1] = c
				for _, f in ipairs(M2.forests) do
					if c[1] >= f.x0 - 10 and c[1] <= f.x1 + 10 and c[2] >= f.z0 - 10 and c[2] <= f.z1 + 10 then
						forestCells[#forestCells + 1] = c
						break
					end
				end
			end
		end
		local function shuffle(list)
			for i = #list, 2, -1 do
				local j = 1 + math.floor(rnd() * i)
				list[i], list[j] = list[j], list[i]
			end
		end
		shuffle(cells)
		shuffle(forestCells)
		local function scatter(kind, count, list)
			local got = 0
			for _, c in ipairs(list) do
				if got >= count then
					break
				end
				local x, z = c[1] + (rnd() - 0.5) * 14, c[2] + (rnd() - 0.5) * 14
				if fits(kind, x, z) then
					add(kind, x, z, rnd() * 360)
					got = got + 1
				end
			end
			return got
		end
		local firs = scatter("fir", plan.fir or 0, forestCells)
		scatter("fir", (plan.fir or 0) - firs, cells)
		local trees = scatter("tree", math.ceil((plan.tree or 0) / 2), forestCells)
		scatter("tree", (plan.tree or 0) - trees, cells)
		scatter("rock", plan.rock or 0, cells)
		scatter("bush", plan.bush or 0, cells)
		-- 3. ponts de bois (Blender) : centrés sur leur cours d'eau, axe du pont ; le pont de pierre du château (rampe) reste procédural
		local bridges = {}
		for _, b in ipairs(G.bridges) do
			if not b.stone then
				bridges[#bridges + 1] = { x = b.x, z = b.z, rot = b.axis == "NS" and 90 or 0, length = b.len, name = b.name, river = b.river }
			end
		end
		G._plan = { items = items, bridges = bridges, forest = forest }
		return G._plan
	end

	-- Décor fin (fleurs, touffes, pierres, lanternes) : mêmes règles (rien dans l'eau ni sur un chemin), espacement plus serré, après le plan principal.
	-- Retourne { {kind, x, z, rot, r} } ; kinds : flower_a/b/c, tuft, stone_flat, stone_round, lantern. Les lanternes bordent les chemins (à 5 studs).
	local DECO_RADIUS = { flower_a = 1, flower_b = 1, flower_c = 1, tuft = 1, stone_flat = 1.5, stone_round = 1.5, lantern = 1 }
	Placement.DECO_RADIUS = DECO_RADIUS
	function P.decor(planItems, counts)
		counts = counts or { flowers = 36, tufts = 24, stones = 18, lanterns = 12 }
		local out = {}
		local function fits(kind, x, z)
			pause()
			local r = DECO_RADIUS[kind]
			if P.blocked(x, z, r, { allowDomain = true }) then
				return false
			end
			for _, it in ipairs(planItems or {}) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 1 then
					return false
				end
			end
			for _, it in ipairs(P.forest()) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 1 then
					return false
				end
			end
			for _, it in ipairs(out) do
				if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 0.5 then
					return false
				end
			end
			return true
		end
		local seed = 7919
		local function rnd()
			seed = seed * 16807 % 2147483647
			return seed / 2147483647
		end
		-- lanternes le long des chemins (un côté, tous les ~28 studs)
		local placedLanterns = 0
		for _, seg in ipairs(P.pathSegments()) do
			local dx, dz = seg[3] - seg[1], seg[4] - seg[2]
			local len = math.sqrt(dx * dx + dz * dz)
			local nx, nz = -dz / len, dx / len
			local steps = math.max(1, math.floor(len / 28))
			for k = 1, steps do
				if placedLanterns >= counts.lanterns then
					break
				end
				local t = (k - 0.5) / steps
				local x, z = seg[1] + dx * t + nx * ((seg.half or M2.pathHalf) + 3.5), seg[2] + dz * t + nz * ((seg.half or M2.pathHalf) + 3.5)
				if fits("lantern", x, z) then
					out[#out + 1] = { kind = "lantern", x = x, z = z, rot = 0, r = DECO_RADIUS.lantern, y = P.groundY(x, z) }
					placedLanterns = placedLanterns + 1
				end
			end
		end
		-- fleurs, touffes, pierres : cellules de 24 studs dans un ordre mélangé déterministe ; les fleurs se regroupent autour des domaines et des chemins
		local kinds = {}
		for i = 1, counts.flowers do
			kinds[#kinds + 1] = ({ "flower_a", "flower_b", "flower_c" })[i % 3 + 1]
		end
		for _ = 1, counts.tufts do
			kinds[#kinds + 1] = "tuft"
		end
		for i = 1, counts.stones do
			kinds[#kinds + 1] = i % 2 == 0 and "stone_flat" or "stone_round"
		end
		local cells = {}
		local cell = 24
		for gx = B.x0 + 12, B.x1 - 12, cell do
			for gz = B.z0 + 12, B.z1 - 12, cell do
				cells[#cells + 1] = { gx + cell / 2, gz + cell / 2 }
			end
		end
		for i = #cells, 2, -1 do
			local j = 1 + math.floor(rnd() * i)
			cells[i], cells[j] = cells[j], cells[i]
		end
		local ki = 1
		for _, c in ipairs(cells) do
			if ki > #kinds then
				break
			end
			local x, z = c[1] + (rnd() - 0.5) * 14, c[2] + (rnd() - 0.5) * 14
			if fits(kinds[ki], x, z) then
				out[#out + 1] = { kind = kinds[ki], x = x, z = z, rot = rnd() * 360, r = DECO_RADIUS[kinds[ki]], y = P.groundY(x, z) }
				ki = ki + 1
			end
		end
		return out
	end

	-- Décor de village de la carte (modèles scn_*) : candidats sur des anneaux autour de la place, ordre fixe ; mêmes règles que plan() (rien dans l'eau, sur un
	-- chemin, une base, un territoire ni sur un objet du plan). Retourne { {kind, x, z, rot, r, y} }.
	local VILLAGE = { { "scn_tour_cloche", 1 }, { "scn_maison_colombages", 3 }, { "scn_puits", 2 }, { "scn_pin_haut", 6 }, { "scn_rocher_a", 3 }, { "scn_rocher_b", 3 }, { "scn_rocher_c", 3 } }
	Placement.VILLAGE = VILLAGE
	function P.scenery(planItems)
		local out = {}
		local dims = Config.Assets.sceneryDims
		for _, entry in ipairs(VILLAGE) do
			local kind, want = entry[1], entry[2]
			local r = dims[kind].r
			local got, tries = 0, 0
			while got < want and tries < 400 do
				tries = tries + 1
				pause()
				local ang = math.rad((tries * 137.5 + #out * 23) % 360)
				local rad = 75 + (tries * 29) % 250 -- anneaux de 75 à 325 studs autour de la place
				local x, z = math.sin(ang) * rad, -math.cos(ang) * rad
				local ok = not P.blocked(x, z, r, {}) and freeOfReserved(x, z, r)
				if ok then
					for _, it in ipairs(planItems or {}) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 2 then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, it in ipairs(P.forest()) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 2 then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, it in ipairs(out) do
						if math.sqrt((x - it.x) ^ 2 + (z - it.z) ^ 2) < r + it.r + 3 then
							ok = false
							break
						end
					end
				end
				if ok then
					out[#out + 1] = { kind = kind, x = x, z = z, rot = Placement.facing(-x, -z), r = r, y = P.groundY(x, z) }
					got = got + 1
				end
			end
		end
		return out
	end

	return P
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX88"><Properties><string name="Name">MapGeo</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/MapGeo
-- REFONTE (lot 2) : géométrie PURE de la carte 700 x 500 (Config.Map2 et Config.TERR), testée hors de Roblox. Source unique pour Builder, Scenery,
-- Placement, la mini-carte et les tests : bases orientées vers la place (spawn devant), territoires, chemins, eau (lacs, rivières en polylignes,
-- fontaine, douve), murs invisibles de la rivière du Nord coupés aux ponts, hauteur du sol (plateau du château, collines), accessibilité d'un point.
-- Nord = -Z, Est = +X. Aucun service Roblox ; pas de math.atan2. Utilisation : require(MapGeo).new(Config).
local MapGeo = {}

local function dist(ax, az, bx, bz)
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end
MapGeo.dist = dist

local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / len2)) or 0
	return dist(px, pz, ax + dx * t, az + dz * t)
end
MapGeo.distToSegment = distToSegment

-- Distance d'un point à une polyligne { {x, z}, ... }.
function MapGeo.distToPoly(px, pz, pts)
	local best = math.huge
	for k = 1, #pts - 1 do
		best = math.min(best, distToSegment(px, pz, pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]))
	end
	return best
end

function MapGeo.polyLength(pts)
	local total = 0
	for k = 1, #pts - 1 do
		total = total + dist(pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2])
	end
	return total
end

local function cross(ax, az, bx, bz)
	return ax * bz - az * bx
end

-- Les segments [A, B] et [C, D] se coupent-ils (contact compris) ? Deux segments parallèles ne se coupent pas (un mur ne se longe pas « à travers »).
function MapGeo.segmentsCross(ax, az, bx, bz, cx, cz, dx, dz)
	local rx, rz = bx - ax, bz - az
	local sx, sz = dx - cx, dz - cz
	local den = cross(rx, rz, sx, sz)
	if math.abs(den) < 1e-12 then
		return false
	end
	local t = cross(cx - ax, cz - az, sx, sz) / den
	local u = cross(cx - ax, cz - az, rx, rz) / den
	return t >= -1e-9 and t <= 1 + 1e-9 and u >= -1e-9 and u <= 1 + 1e-9
end

-- Colline en calotte sphérique (rayon au sol r, hauteur h) : rayon de la sphère et hauteur de son centre (sous le sol).
function MapGeo.hillSphere(hill)
	local R = (hill.r * hill.r + hill.h * hill.h) / (2 * hill.h)
	return R, hill.h - R
end

local cache = setmetatable({}, { __mode = "k" })

function MapGeo.new(Config, fresh)
	if cache[Config] and not fresh then
		return cache[Config]
	end
	local M = Config.Map2
	local G = { M = M }
	cache[Config] = G
	local B = M.bounds

	function G.inBounds(x, z, margin)
		margin = margin or 0
		return x >= B.x0 + margin and x <= B.x1 - margin and z >= B.z0 + margin and z <= B.z1 - margin
	end

	---------------------------------------------------------------- Bases : façade (-Z local) tournée vers la place, spawn devant
	G.bases = {}
	for i, b in ipairs(M.bases) do
		local d = dist(b.x, b.z, M.plaza.x, M.plaza.z)
		local fx, fz = (M.plaza.x - b.x) / d, (M.plaza.z - b.z) / d
		G.bases[i] = { i = i, x = b.x, z = b.z, fx = fx, fz = fz, half = M.baseSizeMax / 2, spawn = { x = b.x + fx * M.spawnForward, z = b.z + fz * M.spawnForward } }
	end
	-- Coordonnées locales d'un point dans la base i : (avant = vers la place, côté = à droite).
	function G.baseLocal(i, x, z)
		local b = G.bases[i]
		local rx, rz = x - b.x, z - b.z
		return rx * b.fx + rz * b.fz, rx * -b.fz + rz * b.fx
	end
	-- Distance d'un point au carré de la base i (demi-côté `half`, par défaut l'emprise maximale) ; 0 dedans.
	function G.distToBase(i, x, z, half)
		local a, s = G.baseLocal(i, x, z)
		half = half or G.bases[i].half
		local ex, ez = math.max(0, math.abs(a) - half), math.max(0, math.abs(s) - half)
		return math.sqrt(ex * ex + ez * ez)
	end

	---------------------------------------------------------------- Territoires (Config.TERR, ordre TERR_ORDER)
	G.terrs = {}
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		local ex, ez = Config.territoryEntry(key)
		G.terrs[#G.terrs + 1] = { key = key, x = t.x, z = t.z, r = t.r, rival = t.rival, guards = t.guards, nests = t.nests, posts = t.posts or {}, entry = { x = ex, z = ez }, data = t }
	end
	function G.terr(key)
		for _, t in ipairs(G.terrs) do
			if t.key == key then
				return t
			end
		end
		return nil
	end
	-- Territoire qui contient (x, z) (marge facultative), ou nil.
	function G.terrAt(x, z, margin)
		for _, t in ipairs(G.terrs) do
			if dist(x, z, t.x, t.z) < t.r + (margin or 0) then
				return t
			end
		end
		return nil
	end

	---------------------------------------------------------------- Chemins
	G.paths = M.paths
	-- Segments de tous les chemins : { ax, az, bx, bz, half, name, y }.
	G.pathSegs = {}
	for _, p in ipairs(M.paths) do
		local half = p.kind == "dirt" and M.dirtHalf or M.pathHalf
		for k = 1, #p.pts - 1 do
			G.pathSegs[#G.pathSegs + 1] = { p.pts[k][1], p.pts[k][2], p.pts[k + 1][1], p.pts[k + 1][2], half = half, name = p.name, y = p.y or 0 }
		end
	end
	function G.path(name)
		for _, p in ipairs(M.paths) do
			if p.name == name then
				return p
			end
		end
		return nil
	end
	-- Distance au bord du chemin le plus proche (négative sur le chemin).
	function G.pathEdgeDist(x, z)
		local best = math.huge
		for _, s in ipairs(G.pathSegs) do
			best = math.min(best, distToSegment(x, z, s[1], s[2], s[3], s[4]) - s.half)
		end
		return best
	end

	---------------------------------------------------------------- Eau
	-- Distance au bord de l'eau la plus proche (négative dans l'eau) et son nom. withShore : la rive de sable des lacs compte comme de l'eau.
	function G.waterEdgeDist(x, z, withShore)
		local best, name = math.huge, nil
		local function try(d, n)
			if d < best then
				best, name = d, n
			end
		end
		for _, lk in ipairs(M.lakes) do
			try(dist(x, z, lk.x, lk.z) - lk.r - (withShore and lk.shore or 0), lk.name)
		end
		for _, rv in ipairs(M.rivers) do
			try(MapGeo.distToPoly(x, z, rv.pts) - rv.width / 2, rv.name)
		end
		try(dist(x, z, M.fountain.x, M.fountain.z) - M.fountain.r, "Fountain")
		local mo = G.moat
		local ex = math.max(mo.x0 - x, 0, x - mo.x1)
		local ez = math.max(mo.z0 - z, 0, z - mo.z1)
		try(math.sqrt(ex * ex + ez * ez) - ((ex == 0 and ez == 0) and 0.01 or 0), "CastleMoat")
		return best, name
	end
	-- Douve décorative : bande de 6 au pied de la falaise sud du château, entre la rivière et le plateau.
	G.moat = { x0 = M.castle.x0 + 8, x1 = M.castle.x1, z0 = M.castle.z1, z1 = M.castle.z1 + 6 }

	---------------------------------------------------------------- Ponts et murs de la rivière du Nord
	-- Pont : rivière franchie (la plus proche), point de franchissement sur la rivière, demi-passage dans le mur.
	G.bridges = {}
	for _, b in ipairs(M.bridges) do
		local bestR, bestD = nil, math.huge
		for ri, rv in ipairs(M.rivers) do
			local d = MapGeo.distToPoly(b.x, b.z, rv.pts)
			if d < bestD then
				bestR, bestD = ri, d
			end
		end
		local pts = M.rivers[bestR].pts
		local cxp, czp, cd = b.x, b.z, math.huge -- point de la rivière le plus proche du centre du pont
		for k = 1, #pts - 1 do
			local ax, az, bx, bz = pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]
			local dx, dz = bx - ax, bz - az
			local t = math.max(0, math.min(1, ((b.x - ax) * dx + (b.z - az) * dz) / (dx * dx + dz * dz)))
			local qx, qz = ax + dx * t, az + dz * t
			local d = dist(b.x, b.z, qx, qz)
			if d < cd then
				cxp, czp, cd = qx, qz, d
			end
		end
		G.bridges[#G.bridges + 1] = { name = b.name, x = b.x, z = b.z, axis = b.axis, w = b.w, len = b.len, stone = b.stone, river = bestR, cross = { x = cxp, z = czp }, gapHalf = math.max(b.w / 2, M.bridgeHalfGap) }
	end
	-- Murs invisibles de la rivière du Nord (rivière 1) : sa ligne médiane découpée, sans les passages des ponts. { {ax, az, bx, bz}, ... }
	function G.riverWalls(ri)
		ri = ri or 1
		local pts = M.rivers[ri].pts
		local gaps = {}
		for _, b in ipairs(G.bridges) do
			if b.river == ri then
				gaps[#gaps + 1] = b
			end
		end
		local out = {}
		for k = 1, #pts - 1 do
			local ax, az, bx, bz = pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]
			local dx, dz = bx - ax, bz - az
			local len = math.sqrt(dx * dx + dz * dz)
			local cuts = {} -- intervalles [t0, t1] retirés (points à moins de gapHalf du point de franchissement)
			for _, b in ipairs(gaps) do
				-- |A + t D - C|^2 = g^2  ->  t^2 L^2 + 2 t (A-C).D + |A-C|^2 - g^2 = 0
				local ox, oz = ax - b.cross.x, az - b.cross.z
				local qa, qb, qc = len * len, 2 * (ox * dx + oz * dz), ox * ox + oz * oz - b.gapHalf * b.gapHalf
				local disc = qb * qb - 4 * qa * qc
				if disc > 0 then
					local s = math.sqrt(disc)
					local t0, t1 = (-qb - s) / (2 * qa), (-qb + s) / (2 * qa)
					if t1 > 0 and t0 < 1 then
						cuts[#cuts + 1] = { math.max(0, t0), math.min(1, t1) }
					end
				end
			end
			table.sort(cuts, function(p, q)
				return p[1] < q[1]
			end)
			local from = 0
			local function add(t0, t1)
				if (t1 - t0) * len > 0.5 then
					out[#out + 1] = { ax + dx * t0, az + dz * t0, ax + dx * t1, az + dz * t1 }
				end
			end
			for _, c in ipairs(cuts) do
				add(from, c[1])
				from = math.max(from, c[2])
			end
			add(from, 1)
		end
		return out
	end
	-- Le trajet [A, B] traverse-t-il un mur de la rivière du Nord ?
	function G.crossesRiverWall(ax, az, bx, bz)
		for _, w in ipairs(G.riverWalls(1)) do
			if MapGeo.segmentsCross(ax, az, bx, bz, w[1], w[2], w[3], w[4]) then
				return true
			end
		end
		return false
	end

	---------------------------------------------------------------- Relief : plateau du château, collines
	local C = M.castle
	-- Palier du pont du château : relie le pont (dont la moitié ouest dépasse du plateau) au plateau.
	G.landing = { x0 = C.x0 - 7, x1 = C.x0, z0 = C.z1 - 8, z1 = C.z1 }
	function G.onPlateau(x, z)
		return (x >= C.x0 and x <= C.x1 and z >= C.z0 and z <= C.z1) or (x >= G.landing.x0 and x <= G.landing.x1 and z >= G.landing.z0 and z <= G.landing.z1)
	end
	function G.hillHeight(x, z)
		local best = 0
		for _, h in ipairs(M.hills) do
			local d = dist(x, z, h.x, h.z)
			if d < h.r then
				local R, cy = MapGeo.hillSphere(h)
				best = math.max(best, math.sqrt(R * R - d * d) + cy)
			end
		end
		return best
	end
	-- Hauteur du sol : plateau du château, sinon colline, sinon 0.
	function G.groundY(x, z)
		if G.onPlateau(x, z) then
			return C.h
		end
		return G.hillHeight(x, z)
	end

	---------------------------------------------------------------- Accessibilité (plumes, arrivées) : approximation documentée
	-- Un point est atteignable s'il est dans les bornes, hors de l'eau (sauf sur un ponton), hors des bâtiments pleins (donjon, cabane), et pas dans la
	-- bande close entre la rivière du Nord et la falaise du château (à l'est du pont : on n'y accède ni par le pont ni par le plateau).
	G.docks = {}
	for _, dk in ipairs(M.docks) do
		local lk = M.lakes[dk.lake]
		local d = dist(dk.x, dk.z, lk.x, lk.z)
		local ux, uz = (lk.x - dk.x) / d, (lk.z - dk.z) / d -- vers le centre du lac
		G.docks[#G.docks + 1] = { ax = dk.x - ux * 4, az = dk.z - uz * 4, bx = dk.x + ux * dk.len, bz = dk.z + uz * dk.len, w = dk.w, lake = dk.lake }
	end
	function G.onDock(x, z)
		for _, dk in ipairs(G.docks) do
			if distToSegment(x, z, dk.ax, dk.az, dk.bx, dk.bz) <= dk.w / 2 then
				return true
			end
		end
		return false
	end
	G.keep = { x = C.keep.x, z = C.keep.z, half = 12 }
	function G.reachable(x, z)
		if not G.inBounds(x, z, 2) then
			return false, "bord"
		end
		if not G.onDock(x, z) and G.waterEdgeDist(x, z, false) < 1 then
			return false, "eau"
		end
		if math.abs(x - G.keep.x) < G.keep.half and math.abs(z - G.keep.z) < G.keep.half then
			return false, "donjon"
		end
		local cab = M.cabin
		if math.abs(x - cab.x) < cab.w / 2 and math.abs(z - cab.z) < cab.d / 2 then
			return false, "cabane"
		end
		if x > C.x0 + 6 and z > C.z1 and z < C.z1 + 30 then -- entre le plateau et la rivière, à l'est du pont : bande close
			local rz = nil
			local pts = M.rivers[1].pts
			for k = 1, #pts - 1 do
				if x >= pts[k][1] and x <= pts[k + 1][1] then
					local t = (x - pts[k][1]) / (pts[k + 1][1] - pts[k][1])
					rz = pts[k][2] + (pts[k + 1][2] - pts[k][2]) * t
				end
			end
			if rz and z < rz then
				return false, "bande close"
			end
		end
		return true, nil
	end

	---------------------------------------------------------------- Portails et repères de la place
	G.portals = {}
	for k, p in ipairs(Config.TRAVEL2.portals) do
		local px, pz = Config.portalPad(k)
		G.portals[k] = { k = k, name = p.name, pad = { x = px, z = pz }, to = { x = p.to[1], z = p.to[2] }, back = { x = p.back[1], z = p.back[2] }, chapter = p.chapter or 0 }
	end
	G.homeArches = {}
	for i = 1, #M.bases do
		local x, z = Config.homeArch(i)
		G.homeArches[i] = { x = x, z = z }
	end

	---------------------------------------------------------------- Emprises occupées (pose du décor) : raison du blocage ou nil
	-- opts.allowDomain : l'empreinte peut être dans un territoire (cabanes, barrières) ; opts.allowPlateau : sur le plateau du château.
	local function feathers()
		local out = {}
		for _, list in pairs(Config.FEATHER_SPOTS or {}) do
			for _, f in ipairs(list) do
				out[#out + 1] = f
			end
		end
		return out
	end
	G.featherList = feathers()
	function G.blocked(x, z, r, opts)
		local margin = 1.5
		if not G.inBounds(x, z, 4 + r) then
			return "bord"
		end
		if G.waterEdgeDist(x, z, true) < r + margin then
			return "eau"
		end
		if dist(x, z, M.plaza.x, M.plaza.z) < M.plaza.r + r + margin then
			return "place"
		end
		if dist(x, z, M.bigEgg.x, M.bigEgg.z) < M.bigEgg.r + r + margin then
			return "repère"
		end
		local tr = M.track
		if math.abs(x - tr.x) < tr.w / 2 + r + margin and math.abs(z - tr.z) < tr.d / 2 + r + margin then
			return "repère"
		end
		for _, p in ipairs(G.portals) do
			if dist(x, z, p.back.x, p.back.z) < 6 + r or dist(x, z, p.to.x, p.to.z) < 4 + r then
				return "repère"
			end
		end
		local A = M.arena
		if dist(x, z, A.x, A.z) < A.r + r + margin then
			return "arène"
		end
		if G.onPlateau(x, z) or (x > C.x0 - 8 - r and x < C.x1 + r and z > C.z0 - r and z < C.z1 + r) then
			if not (opts and opts.allowPlateau) then
				return "château"
			end
		end
		for _, t in ipairs(G.terrs) do
			if dist(x, z, t.x, t.z) < t.r + r + margin and not (opts and opts.allowDomain) then
				return "domaine"
			end
		end
		if G.pathEdgeDist(x, z) < r + margin then
			return "chemin"
		end
		for _, b in ipairs(G.bridges) do
			if dist(x, z, b.x, b.z) < b.len / 2 + r then
				return "chemin"
			end
		end
		for i = 1, #G.bases do
			if G.distToBase(i, x, z) < r + 4 then
				return "base"
			end
		end
		for _, sct in ipairs(Config.SECRETS) do
			if dist(x, z, sct.x, sct.z) < 14 + r then
				return "secret"
			end
		end
		for _, f in ipairs(G.featherList) do
			if dist(x, z, f.x, f.z) < 4 + r then
				return "plume"
			end
		end
		local cab = M.cabin
		if math.abs(x - cab.x) < cab.w / 2 + r + 2 and math.abs(z - cab.z) < cab.d / 2 + r + 2 then
			return "repère"
		end
		return nil
	end

	return G
end

return MapGeo
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX89"><Properties><string name="Name">Culling</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Culling
-- Masquage des zones éloignées, côté client, SANS toucher à StreamingEnabled : logique PURE testée hors de Roblox. Une zone (domaine : plateau et contenu) plus
-- loin que `cullAt` du joueur est masquée (transparence locale, lumières, particules et étiquettes coupées) ; elle réapparaît en dessous de `showAt`
-- (hystérésis : pas de clignotement à la limite). Le travail est découpé en lots (`chunks`) pour ne jamais bloquer une image.
local Culling = {}

-- Retourne true si la zone doit être MASQUÉE. wasCulled : état actuel. Distance invalide (nil, NaN) : on ne masque rien (sûr).
function Culling.decide(distance, wasCulled, cullAt, showAt)
	if type(distance) ~= "number" or distance ~= distance then
		return false
	end
	if wasCulled then
		return distance > showAt
	end
	return distance > cullAt
end

-- Distance horizontale d'un point à une zone circulaire, bord compris (0 dans la zone).
function Culling.distanceTo(px, pz, zone)
	local d = math.sqrt((px - zone.x) ^ 2 + (pz - zone.z) ^ 2) - zone.radius
	return d > 0 and d or 0
end

-- Découpe une liste en lots de `size` éléments (au moins 1).
function Culling.chunks(list, size)
	size = math.max(1, math.floor(size or 1))
	local out = {}
	for i = 1, #list, size do
		local lot = {}
		for j = i, math.min(i + size - 1, #list) do
			lot[#lot + 1] = list[j]
		end
		out[#out + 1] = lot
	end
	return out
end

return Culling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX90"><Properties><string name="Name">AssetReportUi</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/AssetReportUi
-- Diagnostic visible des modèles Blender (Config.Debug.AssetReport) : petite étiquette « Blender N/M » en bas à gauche (hub et partie) ; un clic ou F4 ouvre le
-- rapport complet (catégories et échecs : nom, ID, message). Le rapport vient du serveur (StringValue « AssetReport » dans ReplicatedStorage), imprimé aussi
-- dans la console client par lignes « [Assets] ». Tout sous pcall, jamais d'erreur.
local AssetReportUi = {}

-- Texte de l'étiquette : « Blender N/M » (ou « Blender … » tant que le rapport n'est pas arrivé).
function AssetReportUi.label(loaded, requested)
	if type(loaded) ~= "number" or type(requested) ~= "number" then
		return "Blender …"
	end
	return ("Blender %d/%d"):format(loaded, requested)
end

function AssetReportUi.start(Config, player, ReplicatedStorage, UserInputService)
	if not (Config.Debug and Config.Debug.AssetReport) then
		return nil
	end
	local ok, gui = pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "AssetReport"
		g.ResetOnSpawn = false
		g.DisplayOrder = 90
		local lbl = Instance.new("TextButton")
		lbl.Name = "Label"
		lbl.AnchorPoint = Vector2.new(0, 1)
		lbl.Position = UDim2.new(0, 8, 1, -8)
		lbl.Size = UDim2.fromOffset(130, 22)
		lbl.BackgroundColor3 = Color3.new(0, 0, 0)
		lbl.BackgroundTransparency = 0.5
		lbl.Font = Enum.Font.Code
		lbl.TextSize = 13
		lbl.TextColor3 = Color3.fromRGB(190, 255, 190)
		lbl.Text = AssetReportUi.label(nil, nil)
		lbl.AutoButtonColor = false
		lbl.Parent = g
		local box = Instance.new("TextLabel")
		box.Name = "Details"
		box.AnchorPoint = Vector2.new(0, 1)
		box.Position = UDim2.new(0, 8, 1, -34)
		box.Size = UDim2.new(0.8, 0, 0.6, 0)
		box.BackgroundColor3 = Color3.new(0, 0, 0)
		box.BackgroundTransparency = 0.25
		box.Font = Enum.Font.Code
		box.TextSize = 12
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
		box.TextWrapped = true
		box.Visible = false
		box.Text = ""
		box.Parent = g
		lbl.Activated:Connect(function()
			box.Visible = not box.Visible
		end)
		g.Parent = player:WaitForChild("PlayerGui")
		return g
	end)
	if not ok then
		return nil
	end
	task.spawn(function()
		local rv = ReplicatedStorage:WaitForChild("AssetReport", 120)
		if not rv then
			pcall(function()
				gui.Label.Text = "Blender : pas de rapport"
			end)
			return
		end
		pcall(function()
			gui.Label.Text = AssetReportUi.label(rv:GetAttribute("Loaded"), rv:GetAttribute("Requested"))
			gui.Details.Text = rv.Value
			for line in rv.Value:gmatch("[^\n]+") do
				print(line) -- rapport dans la console client
			end
		end)
	end)
	pcall(function()
		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F4 then
				gui.Details.Visible = not gui.Details.Visible
			end
		end)
	end)
	return gui
end

return AssetReportUi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91"><Properties><string name="Name">MiniMap</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/MiniMap
-- Mini-carte : projection PURE (testée) d'un point du monde vers un disque centré sur le joueur, nord en haut (axe -Z vers le haut de l'écran).
-- `radius` = studs représentés du centre au bord, `half` = demi-taille du disque en pixels. Les repères importants (base, zones, portails) sont ramenés
-- au bord quand ils sont trop loin (`clamp`), les autres (gardiens) disparaissent hors du disque.
local MiniMap = {}

function MiniMap.place(px, pz, x, z, radius, half, clamp)
	if type(px) ~= "number" or type(pz) ~= "number" or type(x) ~= "number" or type(z) ~= "number" or x ~= x or z ~= z or px ~= px or pz ~= pz or radius <= 0 then
		return nil
	end
	local dx, dz = x - px, z - pz
	local d = math.sqrt(dx * dx + dz * dz)
	if d > radius then
		if not clamp then
			return nil
		end
		dx, dz = dx / d * radius, dz / d * radius
	end
	return dx / radius * half, dz / radius * half -- (droite, bas) en pixels depuis le centre
end

-- Repères du monde : { {kind, x, z, label, locked} } (REFONTE lot 2) : ta base (🏠), les autres bases (kind « plot »), les territoires (zones ;
-- grisés si verrouillés), les portails de la rose (grisés si verrouillés). Pur : ne lit que Config et la position de la base.
function MiniMap.landmarks(Config, plotX, plotZ, chaptersDone)
	local out = {}
	if plotX then
		out[#out + 1] = { kind = "base", x = plotX, z = plotZ, label = "🏠" }
	end
	for _, b in ipairs(Config.Map2.bases) do
		if not (plotX and math.abs(b.x - plotX) < 1 and math.abs(b.z - plotZ) < 1) then
			out[#out + 1] = { kind = "plot", x = b.x, z = b.z, label = "⬜" }
		end
	end
	for _, key in ipairs(Config.TERR_ORDER) do
		local t = Config.TERR[key]
		local riv = Config.RIVALS[t.rival]
		out[#out + 1] = { kind = "zone", x = t.x, z = t.z, label = riv and riv.emoji or "🧺", locked = riv ~= nil and not Config.zoneUnlocked(chaptersDone or 0, t.rival), key = key }
	end
	for k = 1, #Config.TRAVEL2.portals do
		local px, pz = Config.portalPad(k)
		out[#out + 1] = { kind = "portal", x = px, z = pz, label = "🌀", locked = not Config.portalUnlocked(chaptersDone or 0, k) }
	end
	return out
end

-- Plumes dorées non ramassées à moins de `range` studs (icône 🪶, REFONTE lot 6). spots = { { x, z } } publiés par le serveur (étape 1 seulement).
function MiniMap.featherMarks(spots, px, pz, range)
	local out = {}
	if type(spots) ~= "table" or type(px) ~= "number" or type(pz) ~= "number" or px ~= px or pz ~= pz then
		return out
	end
	for _, sp in ipairs(spots) do
		if type(sp.x) == "number" and type(sp.z) == "number" then
			local dx, dz = sp.x - px, sp.z - pz
			if dx * dx + dz * dz <= range * range then
				out[#out + 1] = { kind = "feather", x = sp.x, z = sp.z, label = "🪶" }
			end
		end
	end
	return out
end

return MiniMap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX92"><Properties><string name="Name">Battle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Battle   (LOT 12 partie A : moteur refait, D.1 à D.4 et D.6 de LOTS_9_PLUS.md)
-- Moteur de combat PUR (aucun service Roblox) de l'Arène des pets : équipes de 3 pets, tour par tour, résolution DÉTERMINISTE d'après une graine.
-- Le serveur est la seule autorité : le client n'envoie qu'une intention (attaque, spécial, changer de pet) et rejoue les événements reçus.
-- Types (9) : 3 triangles primaires (BEATS, x1,5 / x0,67) : Feu > Nature > Eau > Feu, Lumière > Ombre > Ciel > Lumière, Terre > Foudre > Glace > Terre ;
-- relations secondaires (BEATS2, x1,25 / x0,8), une sortante et une entrante par type. La clé `Nature` est conservée (affichée « Plante » : Battle.TYPE_LABEL).
-- Spécial : CHARGE u.charge 0..5 ; chaque attaque +1 (+1 de plus si le coup est x1,25 ou mieux) ; le spécial exige 5 et consomme 5.
-- Aucune dépendance Roblox ; pas de `+=` ni de `continue` (lanceur lupa).
local Battle = {}

Battle.TYPES = { "Feu", "Eau", "Nature", "Glace", "Foudre", "Terre", "Ciel", "Ombre", "Lumière" }
Battle.TYPE_EMOJI = { Feu = "🔥", Eau = "💧", Nature = "🌿", Glace = "❄️", Foudre = "⚡", Terre = "⛰️", Ciel = "🌪️", Ombre = "🌑", ["Lumière"] = "✨" }
Battle.TYPE_LABEL = { Feu = "Feu", Eau = "Eau", Nature = "Plante", Glace = "Glace", Foudre = "Foudre", Terre = "Terre", Ciel = "Ciel", Ombre = "Ombre", ["Lumière"] = "Lumière" }
-- Nom du spécial par type (D.3) : l'EFFET vient de la compétence de l'espèce (Battle.SKILLS), le NOM du type de l'attaquant.
Battle.SPECIAL_NAME = {
	Feu = "Souffle ardent", Eau = "Raz-de-marée", Nature = "Fouet de lianes", Glace = "Blizzard", Foudre = "Arc électrique",
	Terre = "Séisme", Ciel = "Tempête", Ombre = "Voile des ténèbres", ["Lumière"] = "Rayon sacré",
}
Battle.BEATS = { Feu = "Nature", Nature = "Eau", Eau = "Feu", ["Lumière"] = "Ombre", Ombre = "Ciel", Ciel = "Lumière", Terre = "Foudre", Foudre = "Glace", Glace = "Terre" }
Battle.BEATS2 = { Feu = "Glace", Glace = "Ciel", Ciel = "Terre", Terre = "Feu", Foudre = "Eau", Eau = "Ombre", Ombre = "Nature", Nature = "Lumière", ["Lumière"] = "Foudre" }
Battle.STRONG, Battle.WEAK = 1.5, 0.67
Battle.STRONG2, Battle.WEAK2 = 1.25, 0.8
Battle.MAX_TURNS = 40
Battle.CHARGE_MAX = 5 -- charge nécessaire au spécial
Battle.CHARGE_BONUS_MUL = 1.25 -- un coup de cette efficacité ou mieux donne +1 de charge en plus
-- Multiplicateur global de dégâts (les deux camps : ne change aucun rapport de force). Les STATS de D.4 étant imposées (6 à 7 coups pour mettre un pet à terre),
-- il ramène la durée moyenne d'un combat 3 contre 3 à 8-14 tours (cible du lot 12, mesurée par tests/lot12a.luau) ; à 1 : ~18 tours.
Battle.DAMAGE_MUL = 1.6

-- FUSION LOTS 11 + 12 : modules frères optionnels, lus par `require` seulement dans Roblox (en tests, `script` n'existe pas : le pcall les ignore et les tests
-- injectent `Battle.PetXp` / `Battle.SPECIES_*` ou fournissent un `script`/`require` simulé).
local okB, Bestiary = pcall(function()
	return require(script.Parent:WaitForChild("Bestiary", 10))
end)
if not okB or type(Bestiary) ~= "table" then
	Bestiary = nil
end
local okX, PetXp = pcall(function()
	return require(script.Parent:WaitForChild("PetXp", 10))
end)
if not okX or type(PetXp) ~= "table" then
	PetXp = nil
end
Battle.PetXp = PetXp -- source UNIQUE de l'XP et des niveaux (exposant 1,1) ; sans elle, tous les pets sont niveau 1

-- Type et spécial de chaque espèce (indice = Config.PETS) : source unique Bestiary.SPECIES_TYPE / SPECIES_SKILL (78 espèces, 9 types). Bestiary écrit « Plante » ;
-- le moteur garde la clé `Nature` (affichée « Plante » par Battle.TYPE_LABEL), d'où la conversion. Repli sans Bestiary : les 18 espèces historiques.
local LEGACY_TYPE = { "Ciel", "Ombre", "Lumière", "Eau", "Nature", "Feu", "Lumière", "Ombre", "Ciel", "Feu", "Nature", "Eau", "Ciel", "Ombre", "Lumière", "Nature", "Eau", "Feu" }
local LEGACY_SKILL = { "focus", "heal", "guard", "stun", "strike", "drain", "heal", "stun", "guard", "drain", "strike", "heal", "strike", "focus", "stun", "drain", "heal", "guard" }
Battle.SPECIES_TYPE, Battle.SPECIES_SKILL = {}, {}
for i, t in ipairs((Bestiary and Bestiary.SPECIES_TYPE) or LEGACY_TYPE) do
	Battle.SPECIES_TYPE[i] = (t == "Plante") and "Nature" or t
end
for i, k in ipairs((Bestiary and Bestiary.SPECIES_SKILL) or LEGACY_SKILL) do
	Battle.SPECIES_SKILL[i] = k
end
-- Spécial « signature » des trois nouveaux types (pour les espèces du lot 11 qui n'en choisissent pas un autre).
Battle.TYPE_SKILL = { Glace = "freeze", Foudre = "chain", Terre = "bulwark" }
Battle.SKILLS = {
	strike = { name = "Coup puissant", mul = 2.5 },
	drain = { name = "Morsure vampire", mul = 1.6, leech = 0.4 }, -- soigne 40 % des dégâts
	heal = { name = "Soin", heal = 0.35 }, -- 35 % des pv max, retire l'étourdissement
	guard = { name = "Garde", keep = 0.3, hits = 2 }, -- les 2 prochains coups reçus ne font que 30 %
	stun = { name = "Étourdissement", mul = 1.2 }, -- l'ennemi passe 1 tour
	focus = { name = "Concentration", mul = 1.4, boost = 1.4, turns = 3 }, -- puis attaque +40 % pendant 3 tours
	freeze = { name = "Gel", mul = 1.5, drain = 2 }, -- l'ennemi perd 2 de charge
	chain = { name = "Chaîne d'éclairs", mul = 1.6, splash = 0.35 }, -- 35 % des dégâts sur le pet suivant en réserve
	bulwark = { name = "Rempart", mul = 1.3, keep = 0.5, hits = 1 }, -- puis le prochain coup reçu ne fait que 50 %
}

-- Multiplicateur d'efficacité du type `atk` contre le type `def` : 1,5 / 0,67 (primaire), 1,25 / 0,8 (secondaire), sinon 1.
function Battle.typeMul(atk, def)
	if Battle.BEATS[atk] == def then
		return Battle.STRONG
	elseif Battle.BEATS[def] == atk then
		return Battle.WEAK
	elseif Battle.BEATS2[atk] == def then
		return Battle.STRONG2
	elseif Battle.BEATS2[def] == atk then
		return Battle.WEAK2
	end
	return 1
end

-- Nom affiché du spécial d'une unité : nom propre au type de l'attaquant (D.3), à défaut celui de la compétence.
function Battle.specialName(unitOrType, skill)
	local ty = type(unitOrType) == "table" and unitOrType.type or unitOrType
	local sk = skill or (type(unitOrType) == "table" and unitOrType.skill)
	return Battle.SPECIAL_NAME[ty] or (Battle.SKILLS[sk] and Battle.SKILLS[sk].name) or "Spécial"
end

-- Générateur déterministe de qualité (Park-Miller « MINSTD » révisé : multiplicateur 48271, modulo 2^31 - 1). Le produit reste < 2^47, donc EXACT en
-- double précision (un LCG 1103515245 dépasserait 2^53 et perdrait des bits). État = entier 1..2^31-2, retourne (valeur 0..1 exclu, nouvel état).
Battle.RNG_MUL, Battle.RNG_MOD = 48271, 2147483647
local function nextRnd(state)
	state = (state * 48271) % 2147483647
	return state / 2147483647, state
end
Battle.nextRnd = nextRnd

-- Graine -> état initial valide (1..2^31-2) puis 4 tirages d'échauffement (des graines voisines ne donnent pas des premiers tirages voisins).
function Battle.seedState(seed)
	local n = tonumber(seed) or 1
	if n ~= n or n == math.huge or n == -math.huge then
		n = 1
	end
	local s = (math.floor(n) % 2147483646) + 1
	for _ = 1, 4 do
		local _v
		_v, s = nextRnd(s)
	end
	return s
end

local SIZE_BONUS = { 0.95, 1, 1.05, 1.10, 1.15 }
local MUT_BONUS = { 1, 1.03, 1.05, 1.08, 1.10, 1.12 }
Battle.SIZE_BONUS, Battle.MUT_BONUS = SIZE_BONUS, MUT_BONUS

-- LOT 9, REGLE DE DESIGN (2) : stats de base par rareté (1..10). Puissance = pv + 3 x attaque + 2 x vitesse (Battle.power), strictement croissante,
-- facteur >= 1,25 entre raretés consécutives (testé). Raretés 3 à 7 (Rare .. Ultra Rare) = valeurs EXACTES de l'ancienne formule pour les anciennes
-- raretés 2 à 6 (un pet migré garde ses stats) ; le Commun passe de 60/10/12 à 50/8/12 pour laisser la place au Peu commun (règle x1,25).
Battle.STATS = {
	{ hp = 50, atk = 8, spd = 12 },
	{ hp = 68, atk = 11, spd = 12 },
	{ hp = 87, atk = 14, spd = 14 },
	{ hp = 126, atk = 20, spd = 16 },
	{ hp = 183, atk = 27, spd = 18 },
	{ hp = 265, atk = 38, spd = 20 },
	{ hp = 385, atk = 54, spd = 22 },
	{ hp = 490, atk = 68, spd = 24 },
	{ hp = 620, atk = 86, spd = 26 },
	{ hp = 785, atk = 108, spd = 28 },
}
Battle.POWER_GROWTH_MIN = 1.25
function Battle.power(st)
	return st.hp + 3 * st.atk + 2 * st.spd
end
-- Profils de combat au sein d'une rareté (lot 12 : attribués par espèce). `k` = répartition pv / attaque / vitesse, `power` = puissance visée
-- relative à l'équilibré : l'écart entre le profil le plus faible et le plus fort d'une rareté est de 8 à 15 % (1,06 / 0,94 = +12,8 %), et le
-- plus fort d'une rareté reste sous le plus faible de la suivante (testé). Rien d'achetable ne modifie ces tables.
Battle.PROFILES = {
	balanced = { k = { hp = 1, atk = 1, spd = 1 }, power = 1 },
	tank = { k = { hp = 1.3, atk = 0.85, spd = 0.85 }, power = 1.05 },
	attacker = { k = { hp = 0.85, atk = 1.3, spd = 1 }, power = 1.06 },
	fast = { k = { hp = 0.85, atk = 0.95, spd = 1.35 }, power = 0.94 },
}
function Battle.profileStats(r, profile)
	local b = Battle.STATS[r]
	local pr = Battle.PROFILES[profile] or Battle.PROFILES.balanced
	local raw = { hp = b.hp * pr.k.hp, atk = b.atk * pr.k.atk, spd = b.spd * pr.k.spd }
	local f = pr.power * Battle.power(b) / Battle.power(raw)
	return { hp = raw.hp * f, atk = raw.atk * f, spd = raw.spd * f }
end

-- ---------------------------------------------------------------- Niveaux de pets (D.6)
-- L'XP (slot.x), les niveaux et les gains vivent dans PetXp (source unique) : Battle ne garde que le multiplicateur de stats, délégué à PetXp.statMul.
Battle.MAX_LEVEL = 20
Battle.LEVEL_STEP = 0.015
function Battle.levelMul(level)
	if Battle.PetXp then
		return Battle.PetXp.statMul(level)
	end
	return 1 + Battle.LEVEL_STEP * (math.min(math.max(level or 1, 1), Battle.MAX_LEVEL) - 1)
end
-- Unité de combat à partir de paramètres bruts (aussi utilisée par les tests). spec = { type, skill, tier, level, scale, size, mut, p }.
function Battle.rawUnit(spec)
	local t = math.min(math.max(spec.tier or 1, 1), #Battle.STATS)
	local st = Battle.STATS[t]
	local level = math.min(math.max(math.floor(spec.level or 1), 1), Battle.MAX_LEVEL)
	local bonus = (SIZE_BONUS[spec.size or 2] or 1) * (MUT_BONUS[spec.mut or 1] or 1) * (spec.scale or 1) * Battle.levelMul(level)
	local hp = math.floor(st.hp * bonus + 0.5)
	return {
		p = spec.p or 1, s = spec.size or 2, m = spec.mut or 1, tier = t, level = level,
		type = spec.type, skill = spec.skill,
		maxHp = hp, hp = hp, atk = math.floor(st.atk * bonus + 0.5), spd = st.spd,
		charge = 0, guard = 0, guardKeep = 1, stun = 0, focus = 0,
	}
end

-- Unité de combat d'un pet { p = espèce, s = taille, m = mutation, x = XP (optionnel) } ; `scale` : multiplicateur (adversaires de la tour) ;
-- `tierOverride` : rareté des stats (étage de la tour dont la rareté n'a pas encore d'espèce : apparence d'une rareté inférieure, stats de l'étage).
-- Niveau d'après `pet.x` (XP de l'emplacement) ; sans `x` : niveau 1 (adversaires, anciens profils).
function Battle.unit(Config, pet, scale, tierOverride)
	local def = Config.PETS[pet.p]
	return Battle.rawUnit({
		p = pet.p, size = pet.s, mut = pet.m, scale = scale, tier = tierOverride or def.tier,
		type = Battle.SPECIES_TYPE[pet.p], skill = Battle.SPECIES_SKILL[pet.p], level = Battle.PetXp and Battle.PetXp.level(pet.x) or 1,
	})
end

local function copyUnit(u)
	local c = {}
	for k, v in pairs(u) do
		c[k] = v
	end
	c.charge, c.guard, c.guardKeep, c.stun, c.focus = c.charge or 0, c.guard or 0, c.guardKeep or 1, c.stun or 0, c.focus or 0
	return c
end

-- Nouveau combat. teamA/teamB : listes d'unités (Battle.unit). Camp A = joueur (ou attaquant), camp B = adversaire (ou défenseur).
-- `seed` : graine injectable ; même graine + mêmes équipes + mêmes actions = même journal.
function Battle.new(seed, teamA, teamB)
	local function side(team)
		local units = {}
		for i, u in ipairs(team) do
			units[i] = copyUnit(u)
		end
		return { units = units, active = 1 }
	end
	return { seed = seed, rnd = Battle.seedState(seed), turn = 0, sides = { side(teamA), side(teamB) }, over = false, winner = nil, log = {} }
end

local function alive(u)
	return u.hp > 0
end

local function activeOf(st, i)
	local sd = st.sides[i]
	return sd.units[sd.active]
end

local function firstAlive(sd, from)
	for k = 0, #sd.units - 1 do
		local idx = ((from - 1 + k) % #sd.units) + 1
		if alive(sd.units[idx]) then
			return idx
		end
	end
	return nil
end

-- Actions : { kind = "attack" } | { kind = "skill" } (le spécial) | { kind = "swap", to = n }. Retourne nil si valide, sinon la raison du refus.
function Battle.validate(st, sideIdx, action)
	if type(action) ~= "table" then
		return "action invalide"
	end
	local sd = st.sides[sideIdx]
	local u = sd.units[sd.active]
	if action.kind == "attack" then
		return nil
	elseif action.kind == "skill" then
		if u.charge < Battle.CHARGE_MAX then
			return "spécial pas prêt (" .. u.charge .. "/" .. Battle.CHARGE_MAX .. ")"
		end
		return nil
	elseif action.kind == "swap" then
		local to = action.to
		if type(to) ~= "number" or to % 1 ~= 0 or not sd.units[to] then
			return "pet inconnu"
		elseif to == sd.active or not alive(sd.units[to]) then
			return "pet indisponible"
		end
		return nil
	end
	return "action inconnue"
end

-- Action de l'IA (déterministe, sans tirage) : spécial dès que la charge est pleine, sauf `heal` tant que les pv > 70 % et `guard` tant que l'ennemi
-- n'a pas 4+ de charge (il attend alors en attaquant) ; change de pet quand le type adverse est très favorable, que ce pet est blessé et qu'un meilleur existe.
function Battle.aiAction(st, sideIdx)
	local sd, foe = st.sides[sideIdx], activeOf(st, 3 - sideIdx)
	local u = sd.units[sd.active]
	if Battle.typeMul(foe.type, u.type) >= Battle.STRONG and u.hp < u.maxHp * 0.6 then
		for i, o in ipairs(sd.units) do
			if i ~= sd.active and alive(o) and Battle.typeMul(foe.type, o.type) <= 1 then
				return { kind = "swap", to = i }
			end
		end
	end
	if u.charge >= Battle.CHARGE_MAX then
		local sk = u.skill
		local wait = (sk == "heal" and u.hp > u.maxHp * 0.7) or (sk == "guard" and foe.charge < 4)
		if not wait then
			return { kind = "skill" }
		end
	end
	return { kind = "attack" }
end

local function emit(st, ev)
	st.log[#st.log + 1] = ev
	return ev
end

-- Inflige des dégâts de `side` (attaquant) à l'unité active adverse ; retourne (dégâts, multiplicateur de type).
local function strike(st, atkSide, mul)
	local a, d = activeOf(st, atkSide), activeOf(st, 3 - atkSide)
	local r
	r, st.rnd = nextRnd(st.rnd)
	local tm = Battle.typeMul(a.type, d.type)
	local atk = a.atk * (a.focus > 0 and Battle.SKILLS.focus.boost or 1)
	local dmg = math.max(1, math.floor(atk * mul * tm * Battle.DAMAGE_MUL * (0.9 + 0.2 * r) + 0.5))
	if d.guard > 0 then
		dmg = math.max(1, math.floor(dmg * d.guardKeep))
		d.guard = d.guard - 1
		if d.guard == 0 then
			d.guardKeep = 1
		end
	end
	d.hp = math.max(0, d.hp - dmg)
	return dmg, tm
end

local function perform(st, sideIdx, action)
	local sd = st.sides[sideIdx]
	local u = sd.units[sd.active]
	if not alive(u) then
		return
	end
	if u.stun > 0 then -- un pet étourdi passe son tour et ne charge pas
		u.stun = u.stun - 1
		emit(st, { t = "stunned", side = sideIdx, p = u.p })
		return
	end
	if action.kind == "swap" then
		sd.active = action.to -- la charge reste attachée au pet
		emit(st, { t = "swap", side = sideIdx, to = action.to, p = sd.units[action.to].p })
		return
	end
	local foe = activeOf(st, 3 - sideIdx)
	if action.kind == "skill" and u.charge >= Battle.CHARGE_MAX then
		local sk = Battle.SKILLS[u.skill]
		u.charge = u.charge - Battle.CHARGE_MAX
		if u.skill == "heal" then
			local h = math.min(u.maxHp - u.hp, math.floor(u.maxHp * sk.heal + 0.5))
			u.hp = u.hp + h
			u.stun = 0
			emit(st, { t = "heal", side = sideIdx, amount = h, skill = u.skill, special = true, name = Battle.specialName(u), p = u.p })
		elseif u.skill == "guard" then
			u.guard, u.guardKeep = sk.hits, sk.keep
			emit(st, { t = "guard", side = sideIdx, skill = u.skill, special = true, name = Battle.specialName(u), p = u.p })
		else
			local dmg, tm = strike(st, sideIdx, sk.mul)
			emit(st, { t = "hit", side = sideIdx, dmg = dmg, mul = tm, skill = u.skill, special = true, name = Battle.specialName(u), hp = foe.hp, p = u.p, target = foe.p })
			if u.skill == "drain" then
				local h = math.min(u.maxHp - u.hp, math.floor(dmg * sk.leech))
				u.hp = u.hp + h
			elseif u.skill == "stun" and foe.hp > 0 then
				foe.stun = 1
			elseif u.skill == "focus" then
				u.focus = sk.turns + 1 -- décrémenté en fin de ce tour : 3 tours complets ensuite
				emit(st, { t = "buff", side = sideIdx, skill = u.skill, p = u.p })
			elseif u.skill == "freeze" and foe.hp > 0 then
				local lost = math.min(foe.charge, sk.drain)
				foe.charge = foe.charge - lost
				emit(st, { t = "discharge", side = sideIdx, amount = lost, target = foe.p, charge = foe.charge })
			elseif u.skill == "chain" then
				local fs = st.sides[3 - sideIdx]
				local nxt = firstAlive(fs, fs.active + 1)
				if nxt and nxt ~= fs.active then
					local rs = fs.units[nxt]
					local sp = math.max(1, math.floor(dmg * sk.splash))
					rs.hp = math.max(0, rs.hp - sp)
					emit(st, { t = "splash", side = sideIdx, dmg = sp, to = nxt, hp = rs.hp, p = u.p, target = rs.p })
				end
			elseif u.skill == "bulwark" then
				u.guard, u.guardKeep = sk.hits, sk.keep
				emit(st, { t = "guard", side = sideIdx, skill = u.skill, p = u.p })
			end
		end
	else
		local dmg, tm = strike(st, sideIdx, 1)
		u.charge = math.min(Battle.CHARGE_MAX, u.charge + 1 + (tm >= Battle.CHARGE_BONUS_MUL and 1 or 0))
		emit(st, { t = "hit", side = sideIdx, dmg = dmg, mul = tm, hp = foe.hp, p = u.p, target = foe.p, charge = u.charge })
	end
end

local function settle(st)
	for i = 1, 2 do
		local sd = st.sides[i]
		if not alive(sd.units[sd.active]) then
			local nxt = firstAlive(sd, sd.active)
			if nxt then
				sd.active = nxt
				emit(st, { t = "swap", side = i, to = nxt, forced = true, p = sd.units[nxt].p })
			else
				emit(st, { t = "ko", side = i })
			end
		end
	end
	local aOut, bOut = firstAlive(st.sides[1], 1) == nil, firstAlive(st.sides[2], 1) == nil
	if aOut or bOut then
		st.over, st.winner = true, aOut and 2 or 1
		if aOut and bOut then
			st.winner = 2 -- égalité : le défenseur l'emporte
		end
	end
end

local function totalFrac(sd)
	local hp, mx = 0, 0
	for _, u in ipairs(sd.units) do
		hp, mx = hp + u.hp, mx + u.maxHp
	end
	return hp / mx
end

-- Joue UN tour : actionA = intention du camp A (validée ici ; invalide -> attaque), le camp B joue l'IA (ou actionB). Retourne les événements du tour.
function Battle.turn(st, actionA, actionB)
	if st.over then
		return {}
	end
	local from = #st.log + 1
	st.turn = st.turn + 1
	if Battle.validate(st, 1, actionA) then
		actionA = { kind = "attack" }
	end
	actionB = actionB or Battle.aiAction(st, 2)
	if Battle.validate(st, 2, actionB) then
		actionB = { kind = "attack" }
	end
	emit(st, { t = "turn", n = st.turn })
	-- les changements de pet passent en premier, puis la vitesse décide (égalité : tirage)
	local order = { 1, 2 }
	local acts = { actionA, actionB }
	local function prio(i)
		return acts[i].kind == "swap" and 1 or 0
	end
	local ua, ub = activeOf(st, 1), activeOf(st, 2)
	local tie
	tie, st.rnd = nextRnd(st.rnd)
	if prio(2) > prio(1) or (prio(2) == prio(1) and (ub.spd > ua.spd or (ub.spd == ua.spd and tie < 0.5))) then
		order = { 2, 1 }
	end
	for _, i in ipairs(order) do
		if not st.over and alive(activeOf(st, i)) then
			perform(st, i, acts[i])
			settle(st)
		end
	end
	settle(st) -- même si personne n'a pu agir (deux camps déjà à terre)
	for i = 1, 2 do -- effets qui s'estompent
		for _, u in ipairs(st.sides[i].units) do
			if u.focus > 0 then
				u.focus = u.focus - 1
			end
		end
	end
	if not st.over and st.turn >= Battle.MAX_TURNS then
		local fa, fb = totalFrac(st.sides[1]), totalFrac(st.sides[2])
		st.over, st.winner = true, fa > fb and 1 or 2 -- limite de tours : le plus de PV restants gagne, égalité au défenseur
		emit(st, { t = "timeout" })
	end
	local out = {}
	for i = from, #st.log do
		out[#out + 1] = st.log[i]
	end
	return out
end

-- Équipe adverse de l'étage `floor` de la tour (déterministe) : 3 espèces de la rareté de l'étage, taille normale, niveau Config.towerScale.
function Battle.towerTeam(Config, floor)
	local tier = Config.towerTier(floor)
	local look = Config.liveEggTier(tier) -- lot 9 : rareté sans espèce publiée : espèces de la rareté inférieure, stats de l'étage
	local ids = {}
	for i, d in ipairs(Config.PETS) do
		if d.tier == look then
			ids[#ids + 1] = i
		end
	end
	local scale = Config.towerScale(floor)
	local team = {}
	for k = 1, Config.TOWER.teamSize do
		team[k] = Battle.unit(Config, { p = ids[(floor + k) % #ids + 1], s = 2, m = 1 }, scale, tier)
	end
	return team
end

-- Combat complet automatique (IA des deux côtés) : sert à l'équilibrage et aux tests. Retourne l'état final.
function Battle.run(seed, teamA, teamB)
	local st = Battle.new(seed, teamA, teamB)
	while not st.over do
		Battle.turn(st, Battle.aiAction(st, 1))
	end
	return st
end

-- Texte court d'un événement pour le journal : « 🐰 Lapin : Coup puissant ! 12 dégâts (super efficace) ». `side` 1 = toi.
function Battle.describe(Config, ev)
	local def = ev.p and Config.PETS[ev.p]
	local who = def and (def.emoji .. " " .. def.name) or ""
	local pre = ev.side == 1 and "" or "Adversaire · "
	if ev.t == "turn" then
		return "— Tour " .. ev.n .. " —"
	elseif ev.t == "hit" then
		local eff = ev.mul > 1 and " (super efficace !)" or (ev.mul < 1 and " (peu efficace)" or "")
		local sk = ev.skill and ((ev.name or Battle.SKILLS[ev.skill].name) .. " ! ") or ""
		return pre .. who .. " : " .. sk .. ev.dmg .. " dégâts" .. eff
	elseif ev.t == "heal" then
		return pre .. who .. " se soigne de " .. ev.amount
	elseif ev.t == "guard" then
		return pre .. who .. " se met en garde"
	elseif ev.t == "buff" then
		return pre .. who .. " se concentre (attaque +40 %)"
	elseif ev.t == "stunned" then
		return pre .. who .. " est étourdi et passe son tour"
	elseif ev.t == "discharge" then
		return pre .. who .. " : l'adversaire perd " .. ev.amount .. " de charge"
	elseif ev.t == "splash" then
		return pre .. who .. " : l'éclair touche le pet en réserve (" .. ev.dmg .. " dégâts)"
	elseif ev.t == "swap" then
		return pre .. (ev.forced and "envoie " or "change pour ") .. who
	elseif ev.t == "ko" then
		return (ev.side == 1 and "Ton équipe est" or "L'équipe adverse est") .. " à terre"
	elseif ev.t == "timeout" then
		return "Limite de " .. Battle.MAX_TURNS .. " tours : les PV restants décident"
	end
	return ""
end

-- Vue minimale d'un camp pour l'interface (aucune donnée de graine). `cd` = charge restante avant le spécial (0 = prêt) : l'ancien écran qui lit `cd` reste valable.
function Battle.view(st)
	local out = { turn = st.turn, over = st.over, winner = st.winner, sides = {} }
	for i = 1, 2 do
		local sd = st.sides[i]
		local units = {}
		for k, u in ipairs(sd.units) do
			units[k] = {
				p = u.p, s = u.s, m = u.m, type = u.type, hp = u.hp, maxHp = u.maxHp, skill = u.skill, level = u.level,
				charge = u.charge, chargeMax = Battle.CHARGE_MAX, cd = math.max(0, Battle.CHARGE_MAX - u.charge),
				guard = u.guard > 0, stun = u.stun, focus = u.focus,
			}
		end
		out.sides[i] = { units = units, active = sd.active }
	end
	return out
end

return Battle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX93"><Properties><string name="Name">Layout</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Layout
-- Disposition PURE de l'interface fixe (HUD) : tout est ancré aux bords (compteurs et objectif à gauche, bannière et notifications en haut
-- à droite, conseils en bas à gauche, boutons de menu en colonne en bas à droite) ; la zone centrale reste libre pour voir le personnage.
-- Testée avec une matrice d'appareils (tests/run.luau). Unités : pixels « de conception » ; le HUD est mis à l'échelle par `scale`.
local Layout = {}

Layout.MIN_SCALE = 0.85 -- en dessous, les boutons passent sous 44 px (cible tactile minimale)
Layout.MAX_SCALE = 1.25
Layout.EDGE = 8
Layout.NAV_BUTTON = 52
Layout.NAV_GAP = 4
-- Zone centrale à garder libre (en fraction de l'écran) : le personnage et la caméra.
Layout.CENTER = { x0 = 0.32, x1 = 0.68, y0 = 0.32, y1 = 0.75 }

function Layout.scaleFor(vw, vh)
	local s = math.min(vw / 900, vh / 520)
	if s ~= s then
		s = 1
	end
	return math.max(Layout.MIN_SCALE, math.min(Layout.MAX_SCALE, s))
end

-- Rectangles { x, y, w, h } en pixels de conception pour un écran de vw x vh pixels réels. Retourne (rects, scale, dw, dh).
function Layout.rects(vw, vh, navCount)
	navCount = navCount or 6
	local s = Layout.scaleFor(vw, vh)
	local dw, dh = vw / s, vh / s
	local e = Layout.EDGE
	local navH = navCount * Layout.NAV_BUTTON + (navCount - 1) * Layout.NAV_GAP
	local navW = Layout.NAV_BUTTON
	local rightW = math.min(330, math.max(180, dw - 196 - 3 * e)) -- bannière et notifications : à droite des compteurs
	local nav = { x = dw - e - navW, y = dh - e - navH, w = navW, h = navH }
	-- Notifications : sous la bannière, à droite des compteurs ; décalées à gauche de la colonne de menu si celle-ci monte jusqu'à elles.
	local toastsTop, toastsH = e + 46, 76
	local right = (nav.y < toastsTop + toastsH) and (nav.x - e) or (dw - e)
	local toastsW = math.min(240, right - (e + 196 + e))
	local r = {
		pillCoins = { x = e, y = e, w = 196, h = 52 },
		pillSpeed = { x = e, y = e + 58, w = 196, h = 52 },
		objective = { x = e, y = e + 118, w = 196, h = 78 },
		carry = { x = e, y = e + 204, w = 170, h = 26 },
		hp = { x = e, y = dh - e - 44 - 28, w = 170, h = 22 }, -- au-dessus des conseils, bas gauche (jamais au centre)
		banner = { x = dw - e - rightW, y = e, w = rightW, h = 40 },
		toasts = { x = right - toastsW, y = toastsTop, w = toastsW, h = toastsH },
		nav = nav,
		hint = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 },
		offer = { x = e, y = dh - e - 44, w = math.min(260, dw - navW - 3 * e - 8), h = 44 }, -- offre d'achat non bloquante : prend la place du conseil (jamais les deux)
	}
	return r, s, dw, dh
end

local function overlap(a, b)
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end
Layout.overlap = overlap

-- Zone centrale à garder libre, en pixels de conception pour cet écran.
function Layout.centerRect(vw, vh)
	local s = Layout.scaleFor(vw, vh)
	local c = Layout.CENTER
	return { x = c.x0 * vw / s, y = c.y0 * vh / s, w = (c.x1 - c.x0) * vw / s, h = (c.y1 - c.y0) * vh / s }
end

return Layout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX94"><Properties><string name="Name">Party</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Party
-- Logique PURE du hub : file d'attente des zones de lancement (1 à 5 joueurs), création de partie, registre des parties ouvertes
-- (visibles des amis), rejoindre en cours de partie, repli de téléportation. Toutes les dépendances Roblox sont injectées pour pouvoir
-- tester avec un faux TeleportService (tests/run.luau). Aucune erreur ne sort de ce module : les échecs sont des valeurs de retour.
--   deps.clock() -> secondes
--   deps.reserve(placeId) -> accessCode            (réel : TeleportService:ReserveServer ; peut lever une erreur)
--   deps.teleport(players, placeId, accessCode|nil, data)   (réel : TeleportToPrivateServer / TeleportAsync ; peut lever une erreur)
--   deps.store : { get(key), update(key, fn) , remove(key), list() }   (réel : MemoryStoreService ; peut lever une erreur)
--   deps.log(msg) (facultatif)
local Party = {}

-- Un serveur de jeu accepte-t-il un joueur de plus ? count = joueurs déjà présents.
function Party.admit(count, max)
	return count < max
end

-- Admission d'un joueur dans un serveur de JEU. serverPartyId = identifiant de partie du serveur (celui du premier arrivé, nil si aucun),
-- data = TeleportData reçu à l'arrivée (nil si arrivée directe), count = joueurs déjà présents, role = Config.Game.roleFor(PlaceId).
-- Liste blanche : sur un serveur de partie, seul un joueur envoyé par le hub avec LE MÊME partyId entre. Retourne (true) ou (false, raison).
function Party.admitJoin(serverPartyId, data, count, max, role)
	if not Party.admit(count, max) then
		return false, "full"
	end
	if role ~= "game" then
		return true -- Studio / place non publiée : pas de liste blanche
	end
	local pid = type(data) == "table" and data.partyId or nil
	if serverPartyId ~= nil then
		if pid ~= serverPartyId or data.from ~= "hub" then
			return false, "not_member"
		end
	elseif pid ~= nil and data.from ~= "hub" then
		return false, "not_member"
	end
	return true
end

-- Retour d'un joueur de la partie vers le hub. deps.teleport(players, placeId, nil, data) peut lever une erreur (réseau, lieu non autorisé).
-- Retourne { ok = true } ou { ok = false, message } : le joueur reste alors dans la partie (aucune perte), avec un message clair.
function Party.returnToHub(Config, deps, player, partyId)
	local hub = Config.Game.Places.hub
	if type(hub) ~= "number" or hub <= 0 then
		return { ok = false, message = "Le hub n'est pas configuré. Tu restes dans la partie." }
	end
	local ok, err = pcall(deps.teleport, { player }, hub, nil, { from = "game", partyId = partyId, reason = "leave" })
	if not ok then
		if deps.log then
			deps.log("[Party] retour au hub impossible : " .. tostring(err))
		end
		return { ok = false, message = "Impossible de retourner au hub pour l'instant. Tu restes dans la partie : réessaie dans un instant." }
	end
	return { ok = true }
end

-- Même message pour « inexistante », « terminée » et « tu n'es pas ami de l'hôte » : rien n'est révélé sur les parties des autres.
local GONE_MESSAGE = "Cette partie n'existe plus : elle vient de se terminer ou ton ami est parti."

function Party.new(Config, deps)
	local G = Config.Game
	local P = { queues = {}, where = {} } -- queues[clé] = { size, mode, members = {userId...}, firstAt, readyAt } ; clé = taille (arène) ou "c<taille>" (château)

	local function log(msg)
		if deps.log then
			deps.log("[Party] " .. msg)
		end
	end

	-- Clé d'une file : la taille seule pour l'arène (compatibilité), « c<taille> » pour le mode Château.
	function P.key(size, mode)
		return mode == "castle" and ("c" .. tostring(size)) or size
	end

	for _, size in ipairs(G.Sizes) do
		P.queues[size] = { size = size, mode = "arena", members = {} }
		P.queues["c" .. size] = { size = size, mode = "castle", members = {} }
	end

	---------------------------------------------------------------- zones de lancement (file d'attente)
	function P.enter(userId, size, mode)
		local key = P.key(size, mode)
		local q = P.queues[key]
		if not q then
			return false, "taille inconnue"
		end
		if P.where[userId] then
			if P.where[userId] == key then
				return true
			end
			P.leave(userId)
		end
		if #q.members >= q.size then
			return false, "zone pleine"
		end
		q.members[#q.members + 1] = userId
		P.where[userId] = key
		if #q.members == 1 then
			q.firstAt = deps.clock()
		end
		q.readyAt = nil
		return true
	end

	function P.leave(userId)
		local key = P.where[userId]
		if not key then
			return false
		end
		local q = P.queues[key]
		for i, id in ipairs(q.members) do
			if id == userId then
				table.remove(q.members, i)
				break
			end
		end
		P.where[userId] = nil
		q.readyAt = nil
		if #q.members == 0 then
			q.firstAt = nil
		end
		return true
	end

	-- État affiché d'une zone : { size, mode = "arena" | "castle", count, countdown (secondes ou nil), state = "empty" | "waiting" | "full" }
	function P.status(size, mode)
		local q = P.queues[P.key(size, mode)]
		local now = deps.clock()
		local count = #q.members
		local out = { size = size, count = count, queue = mode == "castle" and "castle" or "arena" }
		out.mode = count == 0 and "empty" or (count >= size and "full" or "waiting") -- (nom historique : état de la file)
		if count > 0 then
			if count >= size then
				q.readyAt = q.readyAt or (now + (size == 1 and G.SoloCountdown or G.CountdownFull))
				out.countdown = math.max(0, q.readyAt - now)
			else
				q.readyAt = nil
				out.countdown = math.max(0, q.firstAt + G.PartialWait - now)
			end
		end
		return out
	end

	-- Groupes prêts à partir : { size, mode, members }. Les membres sont retirés de la file.
	function P.collectLaunches()
		local out = {}
		local keys = {}
		for _, size in ipairs(G.Sizes) do
			keys[#keys + 1] = size
			keys[#keys + 1] = "c" .. size
		end
		for _, key in ipairs(keys) do
			local q = P.queues[key]
			if #q.members > 0 then
				local st = P.status(q.size, q.mode)
				if st.countdown ~= nil and st.countdown <= 0 then
					local members = table.clone(q.members)
					for _, id in ipairs(members) do
						P.where[id] = nil
					end
					q.members = {}
					q.firstAt, q.readyAt = nil, nil
					out[#out + 1] = { size = q.size, mode = q.mode, members = members }
				end
			end
		end
		return out
	end

	---------------------------------------------------------------- registre des parties
	-- Identifiant imprévisible (GUID injecté : HttpService:GenerateGUID). Jamais dérivé de l'hôte ni de l'heure.
	local function newPartyId()
		if deps.guid then
			return deps.guid()
		end
		local t = {}
		for i = 1, 4 do
			t[i] = string.format("%08x", math.random(0, 0x7fffffff))
		end
		return table.concat(t, "-")
	end

	local function alive(e)
		return type(e) == "table" and deps.clock() - (e.createdAt or 0) < G.PartyTTL
	end

	-- Teleporte un groupe vers le lieu de jeu. Essaie les méthodes de G.Fallbacks dans l'ordre.
	-- group = { size = n, members = {userId...}, players = {Player...}, hostName = "..." }
	-- Retourne { ok = true, mode, partyId? } ou { ok = false, reason, message }.
	function P.launch(group)
		local gamePlace = G.Places.game
		if type(gamePlace) ~= "number" or gamePlace <= 0 then
			return { ok = false, reason = "lieu de jeu non configuré", message = "Le lieu de jeu n'est pas configuré. Préviens le créateur." }
		end
		local size = math.min(math.max(group.size or #group.members, 1), G.MaxPlayers)
		local mode = group.mode == "castle" and "castle" or "arena"
		local data = { from = "hub", size = size, late = false, mode = mode }
		local lastErr = "aucune méthode de téléportation"
		for _, method in ipairs(G.Fallbacks) do
			if method == "reserved" then
				local okR, code = pcall(deps.reserve, gamePlace)
				if okR and code then
					local partyId = newPartyId()
					data.partyId = partyId
					local okT, errT = pcall(deps.teleport, group.players, gamePlace, code, data)
					if okT then
						local entry = {
							id = partyId, host = group.members[1], hostName = group.hostName or "?", size = G.MaxPlayers, groupSize = size, mode = mode, count = #group.members,
							members = table.clone(group.members), code = code, createdAt = deps.clock(), open = true, -- toute partie (même solo) reste ouverte aux amis jusqu'au plafond
						}
						local okS, errS = pcall(deps.store.update, partyId, function()
							return entry
						end)
						if not okS then
							log("registre indisponible : " .. tostring(errS))
						end
						return { ok = true, mode = "reserved", partyId = partyId, registered = okS }
					end
					lastErr = "téléportation : " .. tostring(errT)
				else
					lastErr = "réservation : " .. tostring(code)
				end
			elseif method == "public" then
				data.partyId = nil
				local okT, errT = pcall(deps.teleport, group.players, gamePlace, nil, data)
				if okT then
					return { ok = true, mode = "public" }
				end
				lastErr = "téléportation publique : " .. tostring(errT)
			end
		end
		log("lancement impossible : " .. tostring(lastErr))
		return { ok = false, reason = lastErr, message = "Impossible de lancer la partie pour l'instant. Réessaie dans un instant." }
	end

	-- Parties ouvertes visibles par `viewerId` : celles de ses amis (friends[userId] = true) ou celles où il est déjà inscrit.
	-- Retourne une liste triée { id, hostName, count, size }.
	function P.visibleFor(viewerId, friends)
		local okL, list = pcall(deps.store.list)
		if not okL or type(list) ~= "table" then
			return {}, false
		end
		local out = {}
		for _, e in ipairs(list) do
			if alive(e) and e.open and e.count < e.size and e.count < G.MaxPlayers then
				local mine = false
				for _, id in ipairs(e.members or {}) do
					if id == viewerId then
						mine = true
					end
				end
				if not mine and friends and friends[e.host] then
					out[#out + 1] = { id = e.id, hostName = e.hostName, count = e.count, size = e.size }
				end
			end
		end
		table.sort(out, function(a, b)
			return a.id < b.id
		end)
		return out, true
	end

	-- Rejoindre une partie en cours. Retourne { ok = true } ou { ok = false, reason = "full" | "gone" | "registry" | "teleport", message }.
	-- friends = ensemble d'amis du joueur calculé par le SERVEUR (jamais fourni par le client) : seuls les amis de l'hôte (ou un joueur déjà
	-- inscrit) peuvent rejoindre, même s'ils connaissent l'identifiant de la partie.
	function P.join(partyId, player, userId, friends)
		if type(partyId) ~= "string" then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local okG, e = pcall(deps.store.get, partyId)
		if not okG then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not alive(e) or not e.open then
			return { ok = false, reason = "gone", message = GONE_MESSAGE }
		end
		local isMember = false
		for _, id in ipairs(e.members or {}) do
			if id == userId then
				isMember = true
			end
		end
		if not isMember and not (type(friends) == "table" and friends[e.host]) then
			log("refus : " .. tostring(userId) .. " n'est pas ami de l'hôte")
			return { ok = false, reason = "gone", message = GONE_MESSAGE } -- même message : ne révèle pas son existence
		end
		-- réservation atomique de la place (compte + membre) ; refus si plein
		local reserved = false
		local okU, errU = pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" or old.count >= old.size or old.count >= G.MaxPlayers then
				return nil
			end
			for _, id in ipairs(old.members) do
				if id == userId then
					return nil
				end
			end
			old.count = old.count + 1
			old.members[#old.members + 1] = userId
			reserved = true
			return old
		end)
		if not okU then
			return { ok = false, reason = "registry", message = "Liste des parties indisponible." }
		end
		if not reserved then
			return { ok = false, reason = "full", message = "Cette partie est pleine (" .. G.MaxPlayers .. " joueurs maximum)." }
		end
		local okT, errT = pcall(deps.teleport, { player }, G.Places.game, e.code, { from = "hub", partyId = partyId, size = e.size, late = true, mode = e.mode or "arena" })
		if not okT then
			P.leaveParty(partyId, userId) -- annule la place prise
			log("rejoindre : " .. tostring(errT))
			return { ok = false, reason = "teleport", message = "Impossible de rejoindre la partie pour l'instant." }
		end
		return { ok = true }
	end

	-- Libère la place d'un joueur (retour au hub, échec de téléportation). Supprime la partie quand elle est vide.
	function P.leaveParty(partyId, userId)
		pcall(deps.store.update, partyId, function(old)
			if type(old) ~= "table" then
				return nil
			end
			for i, id in ipairs(old.members) do
				if id == userId then
					table.remove(old.members, i)
					old.count = math.max(0, old.count - 1)
					break
				end
			end
			return old
		end)
		-- plus personne dans la partie : elle est retirée du registre (les amis ne la voient plus, « n'existe plus » s'ils réessaient)
		local okG, e = pcall(deps.store.get, partyId)
		if okG and type(e) == "table" and e.count <= 0 then
			pcall(deps.store.remove, partyId)
		end
	end

	return P
end

return Party
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX95"><Properties><string name="Name">Spawn</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Spawn
-- Décisions PURES du filet anti-chute et de la garantie de personnage (testées hors Roblox). Le module SpawnGuard les applique.
local Spawn = {}

-- Réglages par rôle. floorY : en dessous, le joueur est tombé hors du monde. half : demi-côté de la zone jouable (au-delà : hors zone).
-- freefallSpeed : vitesse verticale (studs/s, négative) au-delà de laquelle une chute au-dessus du sol est anormale.
Spawn.PRESETS = {
	game = { floorY = -25, half = 590, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 400 },
	hub = { floorY = -25, half = 205, freefallSpeed = -160, freefallY = 40, noCharTimeout = 10, sky = 140 },
}

-- st = { hasChar, alive, waited, x, y, z, vy } ; waited = secondes sans personnage. Retourne nil ou une raison :
-- "nochar" (aucun personnage depuis trop longtemps), "void" (sous le sol), "freefall" (chute libre), "outside" (hors de la zone), "sky" (trop haut).
function Spawn.rescueReason(st, cfg)
	if not st.hasChar then
		if (st.waited or 0) >= cfg.noCharTimeout then
			return "nochar"
		end
		return nil
	end
	if st.alive == false or st.y == nil then
		return nil
	end
	if st.y ~= st.y or (st.x or 0) ~= (st.x or 0) or (st.z or 0) ~= (st.z or 0) then
		return "void" -- NaN : position corrompue
	end
	if st.y < cfg.floorY then
		return "void"
	end
	if math.abs(st.x or 0) > cfg.half or math.abs(st.z or 0) > cfg.half then
		return "outside"
	end
	if st.y > cfg.sky then
		return "sky"
	end
	if (st.vy or 0) < cfg.freefallSpeed and st.y < cfg.freefallY then
		return "freefall"
	end
	return nil
end

-- Compteurs de sauvetages : une boucle de sauvetages (> maxPerMinute) est signalée pour ne pas masquer un vrai bug.
function Spawn.newTally()
	local t = { counts = {}, total = 0, times = {} }
	function t.add(kind, now)
		t.counts[kind] = (t.counts[kind] or 0) + 1
		t.total = t.total + 1
		t.times[#t.times + 1] = now
		while #t.times > 0 and now - t.times[1] > 60 do
			table.remove(t.times, 1)
		end
		return #t.times
	end
	return t
end

return Spawn
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX96"><Properties><string name="Name">SpawnGuard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/SpawnGuard
-- Garantit qu'un joueur a toujours un personnage dans la zone de jeu : (1) si aucun personnage n'apparaît dans les `noCharTimeout`
-- secondes (script d'arrivée planté, CharacterAutoLoads coupé), il est chargé ici ; (2) un joueur sous le sol, hors zone, trop haut ou en
-- chute libre est replacé au point de départ ; (3) chaque événement est tracé dans la console serveur avec le préfixe [Spawn].
-- Les décisions sont dans Spawn (pur, testé) ; ce module n'applique que du Roblox. Aucune erreur ne sort d'ici (tout sous pcall).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spawn = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Spawn"))

local SpawnGuard = {}

-- opts = { role = "game" | "hub", safeCFrame = function(player) -> CFrame, interval = 0.5 }
function SpawnGuard.attach(opts)
	local cfg = Spawn.PRESETS[opts.role] or Spawn.PRESETS.game
	local tally = Spawn.newTally()
	local noChar = {} -- Player -> secondes sans personnage
	local loading = {} -- Player -> true pendant un LoadCharacterAsync lancé ici
	local function log(msg)
		print("[Spawn] (" .. opts.role .. ") " .. msg)
	end

	local function safeCF(player)
		local ok, cf = pcall(opts.safeCFrame, player)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
		return CFrame.new(0, 10, 0)
	end

	local function place(player, root, reason)
		local n = tally.add(reason, os.clock())
		local cf = safeCF(player)
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		log(player.Name .. " replacé (" .. reason .. ") vers " .. string.format("%.0f, %.0f, %.0f", cf.X, cf.Y, cf.Z) .. " [" .. tally.total .. " au total]")
		if n > 6 then
			warn("[Spawn] (" .. opts.role .. ") plus de 6 sauvetages en une minute : un joueur retombe en boucle, vérifie le point de départ")
		end
	end

	Players.PlayerAdded:Connect(function(player)
		log(player.Name .. " arrivé (" .. #Players:GetPlayers() .. " joueur(s), CharacterAutoLoads = " .. tostring(Players.CharacterAutoLoads) .. ")")
		player.CharacterAdded:Connect(function(char)
			log(player.Name .. " : personnage apparu")
			task.defer(function()
				local root = char:WaitForChild("HumanoidRootPart", 5)
				if root and player.Parent then
					local st = { hasChar = true, alive = true, x = root.Position.X, y = root.Position.Y, z = root.Position.Z, vy = 0 }
					local reason = Spawn.rescueReason(st, cfg)
					if reason then
						place(player, root, reason)
					end
				end
			end)
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(opts.interval or 0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(function()
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not root then
						noChar[player] = (noChar[player] or 0) + (opts.interval or 0.5)
					else
						noChar[player] = 0
					end
					local pos = root and root.Position
					local st = {
						hasChar = root ~= nil, alive = hum == nil or hum.Health > 0, waited = noChar[player] or 0,
						x = pos and pos.X, y = pos and pos.Y, z = pos and pos.Z, vy = root and root.AssemblyLinearVelocity.Y or 0,
					}
					local reason = Spawn.rescueReason(st, cfg)
					if reason == "nochar" then
						if not loading[player] and player.Parent then
							loading[player] = true
							noChar[player] = 0
							tally.add("nochar", os.clock())
							log(player.Name .. " sans personnage depuis " .. cfg.noCharTimeout .. " s : chargement forcé")
							task.spawn(function()
								local ok, err = pcall(function()
									player:LoadCharacterAsync()
								end)
								if not ok then
									warn("[Spawn] (" .. opts.role .. ") LoadCharacterAsync a échoué pour " .. player.Name .. " : " .. tostring(err))
								end
								loading[player] = nil
							end)
						end
					elseif reason and root then
						place(player, root, reason)
					end
				end)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		noChar[player] = nil
		loading[player] = nil
	end)
	log("filet de sécurité actif (sol " .. cfg.floorY .. ", demi-zone " .. cfg.half .. ")")
	return tally
end

return SpawnGuard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX97"><Properties><string name="Name">Belt</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Belt
-- Tapis roulant central du marché : logique PURE (aucun service Roblox), testée. Le serveur appelle step() à 10 Hz et tryBuy() à chaque demande d'achat ;
-- le client ne fait qu'afficher. La rareté d'un œuf est tirée à son apparition et reste VISIBLE avant l'achat. Un œuf n'a qu'un acheteur (réservation atomique).
local Belt = {}

local function nextRnd(state)
	state = (state * 16807) % 2147483647
	return state / 2147483647, state
end

-- Tire une rareté (1..#weights) d'après des poids ; r dans [0, 1).
function Belt.pick(weights, r)
	local total = 0
	for _, w in ipairs(weights) do
		total = total + math.max(w, 0)
	end
	local x = r * total
	local last = #weights
	for i, w in ipairs(weights) do
		if w > 0 then
			last = i
			x = x - w
			if x < 0 then
				return i
			end
		end
	end
	return last -- jamais une rareté de poids nul (lot 9)
end

-- Prix en pièces d'un œuf de rareté `tier` au tapis : `priceRatio` du prix de la boutique (arrondi inférieur).
function Belt.price(Config, tier)
	return math.floor(Config.EGG_PRICE[tier] * Config.BELT.priceRatio)
end

function Belt.new(seed, startAt)
	return { eggs = {}, nextId = 1, rnd = (math.floor(seed) % 2147483646) + 1, nextSpawn = startAt or 0, lastBuy = {}, legendaryAt = {}, goldenUntil = 0, sold = 0, welcomed = {} }
end

-- Le tapis doré est-il actif à l'instant `now` ? Retourne les secondes restantes (0 si inactif).
function Belt.goldenLeft(st, now)
	return math.max(0, st.goldenUntil - now)
end

-- Ajoute `seconds` de tapis doré (cumulable, plafonné à `maxSeconds` restantes). `by` (optionnel) : nom du donateur, affiché sur le panneau.
function Belt.addGolden(Config, st, now, seconds, by)
	local G = Config.BELT.golden
	if type(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 then
		return Belt.goldenLeft(st, now)
	end
	local left = Belt.goldenLeft(st, now)
	st.goldenUntil = now + math.min(G.maxSeconds, left + seconds)
	if by then
		st.goldenBy = by
	end
	return Belt.goldenLeft(st, now)
end

-- « 9:05 » pour 545 secondes.
function Belt.clock(seconds)
	local n = math.max(0, math.floor((seconds or 0) + 0.999))
	return string.format("%d:%02d", n // 60, n % 60)
end

-- Contenu du panneau du tapis : les deux tables de rareté (textes de Config.beltOddsText, donc identiques à la config), celle en vigueur, le compte à rebours du tapis doré.
function Belt.panel(Config, st, now)
	local left = Belt.goldenLeft(st, now)
	local golden = left > 0
	local status = "Tapis standard : un œuf toutes les " .. Config.BELT.interval .. " s"
	if golden then
		status = "✨ TAPIS DORÉ : " .. Belt.clock(left) .. (st.goldenBy and (" · Offert par " .. st.goldenBy) or "")
	end
	return { normal = Config.beltOddsText("normal"), golden = Config.beltOddsText("golden"), active = golden and "golden" or "normal", left = left, status = status }
end

-- Abscisse de l'œuf sur le tapis (de belt.x0 vers belt.x1 à `speed` studs/s) ; nil s'il est tombé dans le bac.
function Belt.positionX(Config, egg, now)
	local B = Config.Map2.belt
	local x = B.x0 + Config.BELT.speed * (now - egg.born)
	if x > B.x1 then
		return nil
	end
	return x
end

-- Fait vivre le tapis : retire les œufs arrivés au bac, en fait apparaître un nouveau toutes les `interval` secondes (3 en doré) tant qu'il y en a moins de maxEggs.
-- `welcome` : si non nil, { userId = n } -> un œuf de bienvenue Commun gratuit est posé en tête (une fois par joueur, voir Belt.welcome). Retourne (apparus, retirés).
function Belt.step(Config, st, now)
	local C = Config.BELT
	local removed, spawned = {}, {}
	local keep = {}
	for _, e in ipairs(st.eggs) do
		if Belt.positionX(Config, e, now) then
			keep[#keep + 1] = e
		else
			removed[#removed + 1] = e
		end
	end
	st.eggs = keep
	local golden = Belt.goldenLeft(st, now) > 0
	local interval = golden and C.golden.interval or C.interval
	local weights = Config.foldWeights(golden and C.weights.golden or C.weights.normal) -- lot 9 : raretés sans espèce reportées vers le bas
	local guard = 0
	while now >= st.nextSpawn and guard < 50 do
		guard = guard + 1
		if #st.eggs < C.maxEggs then
			local r
			r, st.rnd = nextRnd(st.rnd)
			local egg = { id = st.nextId, tier = Belt.pick(weights, r), born = st.nextSpawn, claimedBy = nil, price = nil }
			egg.price = Belt.price(Config, egg.tier)
			st.nextId = st.nextId + 1
			st.eggs[#st.eggs + 1] = egg
			spawned[#spawned + 1] = egg
		end
		st.nextSpawn = st.nextSpawn + interval
	end
	if now - st.nextSpawn > 60 then
		st.nextSpawn = now -- serveur en pause : pas de rattrapage massif
	end
	return spawned, removed
end

-- Œuf de bienvenue : gratuit, posé sur le tapis au nom du joueur, une seule fois par joueur (et seulement si hatched < welcome.maxHatched). Retourne l'œuf ou nil.
function Belt.welcome(Config, st, userId, hatched, now)
	local W = Config.BELT.welcome
	if st.welcomed[userId] or hatched >= W.maxHatched or #st.eggs >= Config.BELT.maxEggs then
		return nil
	end
	st.welcomed[userId] = true
	local egg = { id = st.nextId, tier = 1, born = now, claimedBy = nil, price = 0, forUser = userId }
	st.nextId = st.nextId + 1
	st.eggs[#st.eggs + 1] = egg
	return egg
end

-- Tapis privé (pass PrivateBelt) : état { acc, pending = { raretés } }. Un œuf gratuit toutes les `interval` secondes d'ACTIVITÉ (`active` : le joueur a agi ou bougé dans
-- Config.IDLE.seconds), `pending` œufs en attente au plus (plein : le compteur est suspendu), table STANDARD (Config.BELT.weights.normal), AUCUNE production hors ligne
-- (ce module n'est appelé que pour un joueur présent). `r` dans [0, 1) tire la rareté. Retourne la rareté créée, ou nil.
function Belt.privateStep(Config, st, dt, active, r)
	local P = Config.BELT.private
	if not active or type(dt) ~= "number" or dt ~= dt or dt <= 0 or #st.pending >= P.pending then
		return nil
	end
	st.acc = st.acc + math.min(dt, 5) -- un grand dt (serveur en pause) ne rattrape pas plusieurs œufs
	if st.acc < P.interval then
		return nil
	end
	st.acc = 0
	local tier = Belt.pick(Config.foldWeights(Config.BELT.weights.normal), r)
	st.pending[#st.pending + 1] = tier
	return tier
end

-- Tente l'achat de l'œuf `eggId` par `userId` ; `coins` = pièces du joueur. Retourne (true, œuf) ou (false, raison).
-- Règles : 1 achat par joueur toutes les `buyCooldown` s ; œuf Légendaire+ : prompt actif seulement `legendaryDelay` s après son apparition et 1 par joueur
-- et par minute ; œuf de bienvenue réservé à son destinataire ; réservation atomique (le premier valide l'emporte).
function Belt.tryBuy(Config, st, userId, eggId, coins, now)
	local C = Config.BELT
	local egg
	for _, e in ipairs(st.eggs) do
		if e.id == eggId then
			egg = e
		end
	end
	if not egg or not Belt.positionX(Config, egg, now) then
		return false, "gone"
	end
	if egg.claimedBy then
		return false, "late" -- « Trop tard ! »
	end
	if egg.forUser and egg.forUser ~= userId then
		return false, "reserved"
	end
	if not egg.forUser and now - (st.lastBuy[userId] or -1e9) < C.buyCooldown then
		return false, "cooldown"
	end
	if Config.tierAtLeast(egg.tier, "belt2s") then
		if now - egg.born < C.legendaryDelay then
			return false, "wait"
		end
		if now - (st.legendaryAt[userId] or -1e9) < 60 / C.legendaryPerMinute then
			return false, "legendaryLimit"
		end
	end
	if type(coins) ~= "number" or coins ~= coins or coins < egg.price then
		return false, "poor"
	end
	egg.claimedBy = userId -- atomique : la deuxième demande reçoit « late »
	if not egg.forUser then
		st.lastBuy[userId] = now
	end
	if Config.tierAtLeast(egg.tier, "belt2s") then
		st.legendaryAt[userId] = now
	end
	st.sold = st.sold + 1
	-- l'œuf quitte le tapis
	local keep = {}
	for _, e in ipairs(st.eggs) do
		if e ~= egg then
			keep[#keep + 1] = e
		end
	end
	st.eggs = keep
	return true, egg
end

return Belt
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX98"><Properties><string name="Name">Raven</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Raven
-- Règles PURES du vol à distance « Corbeau chipeur » (aucun service Roblox), testées une par une. Le serveur fournit des « contextes » (tables simples) et applique
-- la décision ; le client n'envoie qu'une intention. Jamais d'anonymat, jamais de protection payante : les protections sont gratuites.
local Raven = {}

-- Ancienneté de compte (jours) d'après une valeur d'origine incertaine : tout ce qui n'est pas un nombre fini vaut 0 (donc refusé).
local function days(v)
	if type(v) ~= "number" or v ~= v then
		return 0
	end
	return v
end

-- Vérifie le DÉPART d'un corbeau. thief = { userId, tokens, level, playMinutes, freeSlot, dailyDone, flying, newbie, inCastle }
-- (lot 7b : thief et victim portent aussi accountAgeDays ; egg porte rvAt = os.time() du dernier vol par corbeau, nil sinon)
-- victim = { userId, level, playMinutes, newbie, inCastle, graceUntil, shieldUntil, ravenCooldownUntil, friendOfThief, blockFriendRavens }
-- egg = { tier, incubating, eggShieldUntil, endsAt }, now en secondes (os.time). Retourne true ou (false, code).
function Raven.canLaunch(Config, thief, victim, egg, now)
	local R = Config.REMOTE_STEAL
	if not thief or not victim or not egg then
		return false, "invalid"
	end
	if thief.userId == victim.userId then
		return false, "self"
	end
	if (thief.tokens or 0) < 1 then
		return false, "noToken"
	end
	if thief.flying then
		return false, "alreadyFlying"
	end
	if (thief.dailyDone or 0) >= R.dailyMax then
		return false, "dailyLimit"
	end
	if thief.inCastle or victim.inCastle then
		return false, "castle"
	end
	if thief.newbie or victim.newbie then
		return false, "newbie"
	end
	if (thief.playMinutes or 0) < R.minPlayMinutes or (victim.playMinutes or 0) < R.victimMinMinutes then
		return false, "tooYoung"
	end
	if days(thief.accountAgeDays) < R.minAccountAgeDays or days(victim.accountAgeDays) < R.minAccountAgeDays then
		return false, "accountAge"
	end
	if not thief.freeSlot then
		return false, "noSlot"
	end
	if (victim.level or 1) < (thief.level or 1) - R.levelGap then
		return false, "levelGap"
	end
	if now < (victim.shieldUntil or 0) then
		return false, "victimShield"
	end
	if now < (victim.ravenCooldownUntil or 0) then
		return false, "victimCooldown"
	end
	if now < (victim.graceUntil or 0) then
		return false, "grace"
	end
	if victim.friendOfThief and victim.blockFriendRavens then
		return false, "friendBlocked"
	end
	if not egg.incubating then
		return false, "notEgg"
	end
	if type(egg.tier) ~= "number" or egg.tier > R.maxTier or egg.tier < 1 then
		return false, "tier"
	end
	if now < (egg.eggShieldUntil or 0) then
		return false, "eggShield"
	end
	if type(egg.rvAt) == "number" and now - egg.rvAt < R.reStealSeconds then
		return false, "recentlyStolen" -- un œuf volé par corbeau ne se revole pas tout de suite (anti-aller-retour entre comptes complices)
	end
	if (egg.endsAt or 0) - now <= R.minEggSecondsLeft then
		return false, "tooLate"
	end
	return true
end

-- Indemnité de la victime : floor(prix de la boutique x ratio).
function Raven.compensation(Config, tier)
	return math.floor(Config.EGG_PRICE[tier] * Config.REMOTE_STEAL.compensationRatio)
end

-- Indemnité RÉELLEMENT versée (lot 7b) : 0 pour un œuf non indemnisable (`rv` : déjà volé par corbeau, issu du tapis privé ou de l'œuf de bienvenue), sinon
-- l'indemnité normale plafonnée par ce que la victime peut encore recevoir aujourd'hui (plafond = prix d'un œuf de Config.REMOTE_STEAL.compensationCapTier).
function Raven.indemnity(Config, tier, rv, receivedToday)
	if rv == true then
		return 0
	end
	local R = Config.REMOTE_STEAL
	local got = (type(receivedToday) == "number" and receivedToday == receivedToday) and math.max(0, receivedToday) or 0 -- valeur incertaine : nombre fini sinon 0
	local room = Config.EGG_PRICE[R.compensationCapTier] - got
	return math.max(0, math.min(Raven.compensation(Config, tier), room))
end

-- Jour UTC d'un horodatage (clé du plafond quotidien).
function Raven.day(now)
	return math.floor(now / 86400)
end

-- Plafond quotidien : retourne le nouveau compteur (remis à zéro si le jour a changé) sous la forme (jour, compte).
function Raven.rollDaily(day, count, now)
	local today = Raven.day(now)
	if day ~= today then
		return today, 0
	end
	return day, count
end

-- Un achat de `n` jetons est-il possible sans dépasser le plafond ? (sinon le reçu n'est PAS traité : jamais de jeton payé perdu.)
function Raven.canBuy(Config, tokens, n)
	return math.max(0, tokens) + n <= Config.REMOTE_STEAL.tokenMax
end

-- Jetons après un achat de `n` jetons (plafond tokenMax) : retourne (nouveau total, jetons perdus au-delà du plafond).
function Raven.addTokens(Config, tokens, n)
	local cap = Config.REMOTE_STEAL.tokenMax
	local total = math.min(cap, math.max(0, tokens) + n)
	return total, math.max(0, math.max(0, tokens) + n - cap)
end

-- Issue du vol : la victime a-t-elle chassé le corbeau (touche son pad à temps, présente dans sa base) ?
function Raven.resolve(chased)
	return chased and "chased" or "success"
end

-- Jetons offerts par un produit (RemoteSteal 1, RemoteStealPack 3) ; 0 si le produit n'en donne pas.
function Raven.tokensFor(Config, productName)
	local n = Config.REMOTE_STEAL.packs[productName]
	return type(n) == "number" and n or 0
end

-- Jetons « détenus » pour le plafond d'achat : ceux du profil PLUS celui qui est en vol (il sera rendu en cas d'échec : le compter évite de le perdre au-delà du plafond).
function Raven.held(tokens, flying)
	return math.max(0, tokens) + (flying and 1 or 0)
end

-- Cumul d'un bonus serveur (tapis doré, pluie de chance) : `left` secondes restantes, `add` secondes achetées, plafond `max`. Retourne (nouveau restant, accepté).
-- Un achat qui dépasserait le plafond n'est PAS accepté (le reçu reste « pas encore traité » : aucun argent perdu).
function Raven.stack(left, add, max)
	left = math.max(0, left)
	if left + add > max then
		return left, false
	end
	return left + add, true
end

-- Une demande de vol en cours est-elle toujours valable ? Tout est décidé par le serveur ; `w` = { thiefHere, victimHere, eggStill, eggLeft, chased, shielded, thiefFreeSlot, now, endsAt }.
-- (lot 7b : `inCastle` et `newbie` = l'un des DEUX joueurs, relus à chaque pas.)
-- Retourne (decision, raison) : "pending" (le corbeau vole encore), "chased" (jeton rendu), "success", ou "aborted" (raison : thiefGone, victimGone, eggGone, shield, noSlot ;
-- jeton rendu partout sauf thiefGone, où le serveur le rend dans le profil du voleur avant sa sauvegarde de départ).
function Raven.settle(w)
	if not w.thiefHere then
		return "aborted", "thiefGone"
	end
	if not w.victimHere then
		return "aborted", "victimGone"
	end
	if not w.eggStill or (type(w.eggLeft) == "number" and w.eggLeft <= 0) then
		return "aborted", "eggGone"
	end
	if w.inCastle then
		return "aborted", "castle" -- l'un des deux est entré au Château pendant le vol (relu à chaque pas) : pas de corbeau dans ce mode
	end
	if w.newbie then
		return "aborted", "newbie" -- protection débutant d'un des deux (relue pendant le vol)
	end
	if w.chased then
		return "chased", "chased"
	end
	if w.now < w.endsAt then
		return "pending", "flying"
	end
	if w.shielded then
		return "aborted", "shield" -- un autre corbeau (ou un vol) vient de protéger la victime : un seul vol à la fois la dépouille
	end
	if not w.thiefFreeSlot then
		return "aborted", "noSlot"
	end
	return "success", "success"
end

-- Journal « Qui m'a volé ? » : insère l'entrée en tête, ne garde que `max` entrées. Retourne la liste (modifiée en place).
function Raven.logPush(list, entry, max)
	table.insert(list, 1, entry)
	while #list > max do
		table.remove(list)
	end
	return list
end

-- Clés du journal serveur RavenLog (une clé par jour UTC) : jour courant, et jour à effacer (plus vieux que `days` jours).
function Raven.dayKey(now)
	return "D" .. Raven.day(now)
end
function Raven.expiredKey(now, days)
	return "D" .. (Raven.day(now) - days - 1)
end

-- Position du corbeau (x, y, z) à l'instant t (0 à 1) d'un vol de `from` vers `to` : montée en arc puis cercle au-dessus de la cible sur la fin.
-- Pure (aucun Vector3) : le serveur en tire un CFrame. `orbit` = fraction du vol passée à tourner (0,3).
function Raven.birdPos(from, to, t, orbit)
	t = math.min(math.max(t, 0), 1)
	local o = orbit or 0.3
	local k = 1 - o
	if t < k then
		local u = t / k
		local e = u * u * (3 - 2 * u)
		return from.x + (to.x - from.x) * e, from.y + (to.y - from.y) * e + math.sin(u * math.pi) * 6, from.z + (to.z - from.z) * e
	end
	local a = (t - k) / o * math.pi * 2
	return to.x + math.cos(a) * 5, to.y, to.z + math.sin(a) * 5
end

return Raven
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX99"><Properties><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Assets (utilisé côté SERVEUR seulement : jeu et hub)
-- Chargement SÛR des modèles Roblox qui servent d'apparence aux œufs. Rien ici ne touche au gameplay : en cas d'échec quel qu'il soit,
-- cloneEgg retourne nil et l'appelant garde l'apparence par défaut. Les dépendances Roblox sont injectées (Assets.new(Config, deps)) pour
-- tester tous les cas d'échec avec un chargeur factice (tests/run.luau).
--   deps.loadAsset(id) -> modèle   (réel : InsertService:LoadAsset)
--   deps.spawn(fn), deps.wait(secondes), deps.clock() -> secondes   (réels : task.spawn, task.wait, os.clock)
--   deps.warn(message)  (facultatif)   deps.store(clé, modèle)  (facultatif : range le modèle, ex. dans ServerStorage)
local Assets = {}

-- Convention des modèles Blender : chaque pièce se nomme `Nom__RRGGBB` (hexadécimal). Retourne (r, g, b) en 0-255, ou nil si le nom n'a pas de
-- suffixe valide (exactement 6 chiffres hexadécimaux après le DERNIER « __ »). Pur et testé.
function Assets.parseColorSuffix(name)
	if type(name) ~= "string" then
		return nil
	end
	-- un doublon d'import Blender (« Sapin__2E7D4F.001 ») garde la couleur de son suffixe
	local hex = name:match("__(%x%x%x%x%x%x)$") or name:match("__(%x%x%x%x%x%x)%.%d+$")
	if not hex then
		return nil
	end
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

-- Clés des modèles d'effets (même liste que VfxKit.MODELS), pour l'export vers les clients.
Assets.vfxKeys = { "cercle_runique", "ailes", "halo", "rayons", "etoile", "cristaux", "onde", "torii", "spirale", "pilier_lumiere", "etincelles", "cone_lumiere", "bouclier" }

-- Nom de base d'une pièce Blender : sans suffixe de couleur ni suffixe de doublon (« Lame__D8DCE8.001 » -> « Lame »).
function Assets.baseName(name)
	if type(name) ~= "string" then
		return ""
	end
	local n = name:gsub("%.%d+$", "")
	n = n:gsub("__%x%x%x%x%x%x$", "")
	return n
end

-- Met un modèle à la hauteur cible (studs) d'après GetExtentsSize, puis REMESURE : la hauteur obtenue doit être à ±10 % de la cible (deux corrections
-- au plus). Retourne (true, hauteur) ou (false, raison) : l'appelant ne pose alors pas le modèle (repli procédural), jamais d'échelle 1 brute.
function Assets.fitHeight(model, target)
	local ok, res = pcall(function()
		if type(target) ~= "number" or target ~= target or target <= 0 or target > 1000 then
			error("hauteur cible invalide")
		end
		local height
		for _ = 1, 3 do
			local e = model:GetExtentsSize()
			height = e and e.Y
			if type(height) ~= "number" or height ~= height or height < 0.05 or height > 1e6 then
				error("mesure impossible")
			end
			if math.abs(height - target) <= 0.1 * target and _ > 1 then
				return height
			end
			model:ScaleTo(model:GetScale() * target / height)
		end
		local e = model:GetExtentsSize()
		height = e and e.Y
		if type(height) ~= "number" or math.abs(height - target) > 0.1 * target then
			error("hauteur hors tolérance")
		end
		return height
	end)
	return ok, res
end

-- Lot 9 : met un modèle à l'échelle d'après la hauteur d'UNE pièce (`partName`, nom de base sans suffixe de couleur, ex. « Coque » des œufs) :
-- couronne, auréole ou ailes dépassent sans fausser la taille de l'œuf. Le rapport hauteur de la pièce / hauteur du modèle est mesuré AVANT la mise
-- à l'échelle, puis Assets.fitHeight vise target / rapport (vérifié à ±10 %). Sans cette pièce : repli sur la hauteur du modèle entier.
-- Retourne (true, hauteur du modèle) ou (false, raison).
function Assets.partRatio(model, partName)
	local ok, r = pcall(function()
		local e = model:GetExtentsSize()
		local mh = e and e.Y
		if type(mh) ~= "number" or mh ~= mh or mh <= 0 then
			return nil
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and Assets.baseName(d.Name) == partName then
				local h = d.Size.Y
				if type(h) == "number" and h == h and h > 0 and h <= mh * 1.001 then
					return h / mh
				end
			end
		end
		return nil
	end)
	return ok and r or nil
end
function Assets.fitByPart(model, partName, target)
	local r = Assets.partRatio(model, partName)
	if not r or r < 0.2 then
		return Assets.fitHeight(model, target)
	end
	return Assets.fitHeight(model, target / r)
end

function Assets.new(Config, deps)
	local A = { templates = {}, status = {}, failedIds = {}, requested = {}, placeFailures = {} } -- status[clé] = { ok, reason | parts, removed } ; failedIds[id] = raison
	local warned = {} -- un seul avertissement par ID
	local byId = {} -- identifiant -> { model, status } des modèles déjà chargés
	local cfg = Config.Assets

	local function warn(msg, id)
		if id ~= nil then
			A.failedIds[id] = msg
			if warned[id] then
				return
			end
			warned[id] = true
		end
		if deps.warn then
			deps.warn("[Assets] " .. msg)
		end
	end

	-- Exécute fn avec un délai maximum (le chargeur réel peut ne jamais répondre). Retourne (ok, résultat | message).
	-- Si le résultat arrive après le délai, le modèle est détruit et ignoré.
	local function withTimeout(fn, seconds)
		local state = { done = false, abandoned = false }
		deps.spawn(function()
			local ok, res = pcall(fn)
			state.done, state.ok, state.res = true, ok, res
			if state.abandoned and ok and res ~= nil then
				pcall(function()
					res:Destroy()
				end)
			end
		end)
		local t0 = deps.clock()
		while not state.done and deps.clock() - t0 < seconds do
			deps.wait(0.1)
		end
		if not state.done then
			state.abandoned = true
			return false, "délai dépassé (" .. seconds .. " s)"
		end
		return state.ok, state.res
	end

	local function descendants(model)
		local ok, list = pcall(function()
			return model:GetDescendants()
		end)
		if ok and type(list) == "table" then
			return list
		end
		return nil
	end

	-- Retire tout ce qui est interdit, plafonne les particules, vérifie qu'il reste de la géométrie.
	-- Retourne (true, { parts, removed }) ou (false, raison). Ne lève jamais d'erreur.
	function A.sanitize(model, maxParts)
		maxParts = maxParts or cfg.maxParts
		if model == nil then
			return false, "modèle absent"
		end
		local list = descendants(model)
		if not list then
			return false, "modèle illisible ou corrompu"
		end
		local blocked = {}
		for _, d in ipairs(list) do
			local ok, className = pcall(function()
				return d.ClassName
			end)
			if not ok or type(className) ~= "string" then
				return false, "instance corrompue"
			end
			if Config.isBlockedClass(className) then
				blocked[#blocked + 1] = d
			end
		end
		for _, d in ipairs(blocked) do
			pcall(function()
				d:Destroy()
			end)
		end
		local after = descendants(model)
		if not after then
			return false, "modèle illisible après nettoyage"
		end
		local parts = 0
		for _, d in ipairs(after) do
			local okPart, isPart = pcall(function()
				return d:IsA("BasePart")
			end)
			if okPart and isPart then
				parts = parts + 1
			else
				local okEmitter, isEmitter = pcall(function()
					return d.ClassName == "ParticleEmitter"
				end)
				if okEmitter and isEmitter then
					pcall(function()
						if d.Rate > cfg.maxParticleRate then
							d.Rate = cfg.maxParticleRate
						end
					end)
				end
			end
		end
		if parts == 0 then
			return false, "modèle vide (aucune part)"
		end
		if parts > maxParts then
			return false, "modèle trop lourd (" .. parts .. " parts, maximum " .. maxParts .. ")"
		end
		return true, { parts = parts, removed = #blocked }
	end

	-- Applique la couleur lue dans le suffixe `__RRGGBB` du nom de chaque pièce (les couleurs du FBX ne sont jamais utilisées) ; sans suffixe, rien
	-- ne change. CastShadow = false pour les petits détails (arête la plus longue sous cfg.smallDetail studs). Retourne le nombre de pièces colorées.
	function A.colorize(model, keepMaterial)
		local make = deps.color or (Color3 and Color3.fromRGB)
		if not make then
			return 0
		end
		local list = descendants(model)
		if not list then
			return 0
		end
		local count = 0
		local MAT = deps.material or (Enum and Enum.Material)
		for _, d in ipairs(list) do
			local okName, name = pcall(function()
				return d.Name
			end)
			if MAT and not keepMaterial then
				-- matières : Metal et Neon seulement pour les pièces explicitement métalliques ou lumineuses (Metal sans reflets rend noir),
				-- tout le reste en plastique lisse, jamais de reflets
				pcall(function()
					if d:IsA("BasePart") then
						local base = Assets.baseName(okName and name or "")
						local metals, neons = cfg.metalParts or {}, cfg.neonParts or {}
						if metals[base] then
							d.Material = MAT.Metal
						elseif neons[base] then
							d.Material = MAT.Neon
						elseif d.Material ~= MAT.Plastic and d.Material ~= MAT.SmoothPlastic then
							d.Material = MAT.SmoothPlastic
						end
						d.Reflectance = 0
					end
				end)
			end
			local r, g, b = Assets.parseColorSuffix(okName and name or nil)
			if r then
				local isPart = false
				pcall(function()
					isPart = d:IsA("BasePart")
				end)
				if isPart then
					pcall(function()
						d.Color = make(r, g, b)
						count = count + 1
						pcall(function()
							if d.ClassName == "MeshPart" then
								d.TextureID = "" -- une texture importée teinterait la couleur (rendu sombre)
							end
							for _, c in ipairs(d:GetChildren()) do
								if c.ClassName == "SurfaceAppearance" then
									c:Destroy()
								end
							end
						end)
						local s = d.Size
						if s and math.max(s.X, s.Y, s.Z) < (cfg.smallDetail or 0.6) then
							d.CastShadow = false
						end
					end)
				end
			end
		end
		return count
	end

	-- Charge, nettoie et range un modèle. Retourne true si un modèle utilisable est disponible. Ne lève jamais d'erreur.
	function A.loadOne(key, id, maxParts)
		A.requested[key] = id
		-- un identifiant déjà chargé (même modèle sous une autre clé) est réutilisé : un seul LoadAsset par modèle
		if byId[id] then
			A.templates[key] = byId[id].model
			A.status[key] = byId[id].status
			return true
		end
		A.startedAt = A.startedAt or deps.clock()
		local t1 = deps.clock()
		local attempts = 1
		local ok, model = withTimeout(function()
			return deps.loadAsset(id)
		end, cfg.timeout)
		-- un seul nouvel essai (chargement refusé ou trop lent), tant que le plafond global de relance n'est pas atteint : un échec ne bloque jamais la suite
		if not ok and deps.clock() - A.startedAt < (cfg.retryUntil or 25) then
			deps.wait(0.4)
			attempts = 2
			ok, model = withTimeout(function()
				return deps.loadAsset(id)
			end, cfg.timeout)
		end
		if not ok then
			A.status[key] = { ok = false, reason = tostring(model), id = id, attempts = attempts, seconds = deps.clock() - t1 }
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(model) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local sOk, valid, info = pcall(A.sanitize, model, maxParts)
		if not sOk then
			valid, info = false, tostring(valid)
		end
		if not valid then
			A.status[key] = { ok = false, reason = tostring(info), id = id }
			pcall(function()
				if model ~= nil then
					model:Destroy()
				end
			end)
			warn("« " .. key .. " » (" .. tostring(id) .. ") : " .. tostring(info) .. " : apparence construite par le code conservée.", id)
			return false
		end
		local colored = 0
		local cOk, cn = pcall(A.colorize, model, key:sub(1, 2) == "v:" or key:sub(1, 6) == "m:vfx.") -- les effets gardent leur matière Neon
		if cOk then
			colored = cn
		end
		A.templates[key] = model
		A.status[key] = { ok = true, parts = info.parts, removed = info.removed, colored = colored, id = id, attempts = attempts, seconds = deps.clock() - t1 }
		byId[id] = { model = model, status = A.status[key] }
		if deps.store then
			pcall(deps.store, key, model)
		end
		return true
	end

	-- Charge une liste { {key, id, cap} } par LOTS PARALLÈLES (cfg.batchSize, 8 par défaut) : chaque modèle a son délai et son nouvel essai, un échec ou un modèle
	-- lent ne retarde jamais que son lot et n'empêche JAMAIS de lancer les suivants. Les identifiants en double sont chargés une seule fois.
	-- Retourne le nombre de modèles utilisables. Ne lève jamais d'erreur.
	function A.loadMany(entries)
		local first, dups, seen = {}, {}, {}
		for _, e in ipairs(entries) do
			A.requested[e.key] = e.id
			if byId[e.id] or seen[e.id] then
				dups[#dups + 1] = e
			else
				seen[e.id] = true
				first[#first + 1] = e
			end
		end
		local size = cfg.batchSize or 8
		local i = 1
		while i <= #first do
			local running = 0
			for j = i, math.min(i + size - 1, #first) do
				local e = first[j]
				running = running + 1
				deps.spawn(function()
					pcall(A.loadOne, e.key, e.id, e.cap)
					running = running - 1
				end)
			end
			while running > 0 do
				deps.wait(0.05)
			end
			i = i + size
		end
		for _, e in ipairs(dups) do
			pcall(A.loadOne, e.key, e.id, e.cap)
		end
		local loaded = 0
		for _, e in ipairs(entries) do
			if A.status[e.key] and A.status[e.key].ok then
				loaded = loaded + 1
			end
		end
		return loaded
	end

	-- Catégorie d'une clé de statut (pour le rapport) : arbres, chemins, protections d'œufs, base, village, pets, œufs, gardiens, décor...
	local CATEGORY = { trees = "arbres", paths = "chemins", eggguard = "protections d'œufs", base = "base", scenery = "village", guards = "gardiens", traps = "pièges", castle = "château", ground = "sol", deco = "décor", terrain = "relief", vfx = "effets", props = "accessoires", decor = "décor de carte", hub = "kiosque" }
	function A.categoryOf(key)
		local grp = key:match("^m:(%a+)%.")
		if grp then
			return CATEGORY[grp] or grp
		end
		local prefix = key:match("^(%a+):")
		if prefix == "p" then
			return "pets"
		elseif prefix == "r" then
			return "œufs"
		elseif prefix == "d" then
			return "décor catalogue"
		elseif prefix == "x" then
			return "accessoires"
		elseif prefix == "t" then
			return "textures"
		end
		return "œufs"
	end

	-- Rapport par catégorie : { {cat, requested, loaded, fallback, failures = { {key, id, reason} }} } trié par nom ; les statuts sans demande (ID invalide) comptent.
	function A.report()
		local cats, order = {}, {}
		local function bucket(c)
			if not cats[c] then
				cats[c] = { cat = c, requested = 0, loaded = 0, fallback = 0, failures = {} }
				order[#order + 1] = c
			end
			return cats[c]
		end
		local keys, seenKey = {}, {}
		for k in pairs(A.requested) do
			keys[#keys + 1] = k
			seenKey[k] = true
		end
		for k in pairs(A.status) do
			if not seenKey[k] then
				keys[#keys + 1] = k
			end
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			local b = bucket(A.categoryOf(k))
			local st = A.status[k]
			b.requested = b.requested + 1
			if st and st.ok then
				b.loaded = b.loaded + 1
			else
				b.fallback = b.fallback + 1
				b.failures[#b.failures + 1] = { key = k, id = A.requested[k] or (st and st.id), reason = st and st.reason or "pas encore chargé" }
			end
		end
		table.sort(order)
		local out = {}
		for _, c in ipairs(order) do
			out[#out + 1] = cats[c]
		end
		return out
	end

	-- Lignes de texte du rapport (une par catégorie, puis une par échec) + totaux { loaded, requested }.
	function A.reportLines()
		local lines, loaded, requested = {}, 0, 0
		local rep = A.report()
		for _, b in ipairs(rep) do
			loaded, requested = loaded + b.loaded, requested + b.requested
			lines[#lines + 1] = ("[Assets] %s : %d/%d chargés, %d en repli"):format(b.cat, b.loaded, b.requested, b.fallback)
		end
		for _, b in ipairs(rep) do
			for _, f in ipairs(b.failures) do
				lines[#lines + 1] = ("[Assets]   ÉCHEC %s (ID %s) : %s"):format(tostring(f.key), tostring(f.id), tostring(f.reason))
			end
		end
		local shown = {}
		for _, f in ipairs(A.placeFailures) do
			if not shown[f] and #shown < 20 then -- un message distinct à la fois, 20 au plus
				shown[f] = true
				shown[#shown + 1] = f
				lines[#lines + 1] = "[Assets]   POSE REFUSÉE " .. f
			end
		end
		return lines, loaded, requested
	end

	-- Charge tous les modèles d'œufs (un par clé). onReady() est appelé une fois si au moins un modèle est utilisable.
	-- Retourne le nombre de modèles chargés. Ne lève jamais d'erreur ; ne fait rien si Config.Assets.Enabled est faux.
	function A.loadAll(onReady)
		if cfg.Enabled ~= true then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.eggs) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		if type(cfg.eggsByRarity) == "table" then -- modèles Blender par rareté (1..6 et « secret ») : prioritaires sur les modèles du catalogue, chargés en premier
			local rk = {}
			for rarity in pairs(cfg.eggsByRarity) do
				rk[#rk + 1] = rarity
			end
			table.sort(rk, function(a, b)
				return tostring(a) < tostring(b)
			end)
			for _, rarity in ipairs(rk) do
				local id = cfg.eggsByRarity[rarity]
				if type(id) == "number" and id > 0 and id % 1 == 0 then
					entries[#entries + 1] = { key = "r:" .. tostring(rarity), id = id, cap = cfg.eggsMaxParts }
				else
					A.status["r:" .. tostring(rarity)] = { ok = false, reason = "ID invalide" }
				end
			end
		end
		for _, key in ipairs(keys) do
			local id = cfg.eggs[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = key, id = id, cap = cfg.eggsMaxParts } -- lot 9 : plafond propre des œufs (40)
			else
				A.status[key] = { ok = false, reason = "ID invalide" }
			end
		end
		local loaded = A.loadMany(entries)
		if loaded > 0 and onReady then
			pcall(onReady)
		end
		return loaded
	end

	-- Charge les modèles de décor du hub (Config.Assets.decor : clé -> ID), plafond de Parts plus large que pour les œufs.
	-- Clés rangées sous « d:<clé> ». Retourne le nombre de modèles chargés. Ne lève jamais d'erreur.
	function A.loadDecor()
		if cfg.Enabled ~= true or type(cfg.decor) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.decor) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.decor[key]
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "d:" .. key, id = id, cap = cfg.decorMaxParts or cfg.maxParts }
			else
				A.status["d:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Charge les modèles Blender des pets (Config.Assets.pets : index d'espèce -> ID). Clés « p:<index> ». Retourne le nombre de modèles chargés.
	function A.loadPets()
		if cfg.Enabled ~= true or type(cfg.pets) ~= "table" then
			return 0
		end
		local loaded = 0
		local idxs = {}
		for idx in pairs(cfg.pets) do
			idxs[#idxs + 1] = idx
		end
		-- Lot 11 : les 60 nouvelles espèces (cfg.petsNew, plafond de Parts propre cfg.petsMaxPartsNew) ; cfg.pets garde la priorité sur un même indice.
		local newIds = type(cfg.petsNew) == "table" and cfg.petsNew or {}
		for idx in pairs(newIds) do
			if cfg.pets[idx] == nil then
				idxs[#idxs + 1] = idx
			end
		end
		table.sort(idxs, function(a, b)
			return tostring(a) < tostring(b)
		end)
		local entries = {}
		for _, idx in ipairs(idxs) do
			local isNew = cfg.pets[idx] == nil
			local id = cfg.pets[idx] or newIds[idx]
			if type(idx) == "number" and Config.PETS[idx] and type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "p:" .. idx, id = id, cap = isNew and (cfg.petsMaxPartsNew or cfg.petsMaxParts or cfg.maxParts) or (cfg.petsMaxParts or cfg.maxParts) }
			else
				A.status["p:" .. tostring(idx)] = { ok = false, reason = "entrée invalide" }
			end
		end
		loaded = A.loadMany(entries)
		return loaded
	end

	-- Copie du modèle du pet d'espèce `petIdx`, ou nil (repli : pet procédural).
	function A.clonePet(petIdx)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["p:" .. tostring(petIdx)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle de décor `key`, ou nil (coupé, échoué, pas encore chargé).
	function A.cloneDecor(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["d:" .. key]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Copie du modèle d'un œuf de rareté `tier`, ou nil (chargement coupé, échoué, pas encore terminé...) : garder l'apparence par défaut.
	function A.cloneEgg(tier, secret)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = nil
		if secret then
			template = A.templates["r:secret"]
		end
		template = template or A.templates["r:" .. tostring(tier)]
		if not template then
			local key = Config.eggAssetKey(tier)
			template = key and A.templates[key]
		end
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Accessoires (arbres, rochers, cabanes, pont, fontaine, nid...) : Config.Assets.props clé -> ID, plafond de Parts par clé (propsMaxParts).
	function A.loadProps()
		if cfg.Enabled ~= true or type(cfg.props) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.props) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = cfg.props[key]
			local cap = (cfg.propsMaxParts and cfg.propsMaxParts[key]) or cfg.decorMaxParts or cfg.maxParts
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "x:" .. key, id = id, cap = cap }
			else
				A.status["x:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Textures tuilables : chaque entrée de Config.Assets.textures est un ID de DÉCAL ; on charge le décal côté serveur, on lit son `Texture` (URL
	-- d'image) et on la met en cache (A.textureUrls[clé]). Un échec laisse la matière actuelle (aucune URL = rien n'est posé). Retourne le nombre chargé.
	A.textureUrls = {}
	function A.loadTextures()
		if cfg.Enabled ~= true or type(cfg.textures) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(cfg.textures) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local loaded = 0
		for _, key in ipairs(keys) do
			local id = cfg.textures[key].id
			if type(id) == "number" and id > 0 and id % 1 == 0 then
				local ok, model = withTimeout(function()
					return deps.loadAsset(id)
				end, cfg.timeout)
				local url = nil
				if ok and model ~= nil then
					pcall(function()
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("Decal") and type(d.Texture) == "string" and d.Texture ~= "" then
								url = d.Texture
								break
							end
						end
					end)
					pcall(function()
						model:Destroy()
					end)
				end
				if url then
					A.textureUrls[key] = url
					A.status["t:" .. key] = { ok = true }
					loaded = loaded + 1
				else
					A.status["t:" .. key] = { ok = false, reason = ok and "aucun décal dans le modèle" or tostring(model) }
					warn("texture « " .. key .. " » (" .. tostring(id) .. ") indisponible : matière actuelle conservée.", id)
				end
			else
				A.status["t:" .. key] = { ok = false, reason = "ID invalide" }
			end
		end
		return loaded
	end

	-- Groupes de modèles Blender de Config.Assets.models (guards, castle, traps, ground, props...) : clé "groupe.nom", plafond de Parts par
	-- Config.Assets.modelsMaxParts["groupe.nom"]. Même garanties que loadProps (un seul LoadAsset par ID, jamais d'erreur levée).
	function A.loadGroup(group, only)
		local g = cfg.models and cfg.models[group]
		if cfg.Enabled ~= true or type(g) ~= "table" then
			return 0
		end
		local keys = {}
		for key in pairs(g) do
			keys[#keys + 1] = key
		end
		table.sort(keys)
		local entries = {}
		for _, key in ipairs(keys) do
			local id = (not only or only[key]) and g[key] or nil
			local full = group .. "." .. key
			local cap = (cfg.modelsMaxParts and cfg.modelsMaxParts[full]) or (group == "vfx" and cfg.vfxMaxParts) or cfg.decorMaxParts or cfg.maxParts
			if not id then
				-- clé non demandée (filtre `only`)
			elseif type(id) == "number" and id > 0 and id % 1 == 0 then
				entries[#entries + 1] = { key = "m:" .. full, id = id, cap = cap }
			else
				A.status["m:" .. full] = { ok = false, reason = "ID invalide" }
			end
		end
		return A.loadMany(entries)
	end

	-- Copie d'un modèle d'un groupe (ou nil : repli procédural).
	function A.cloneModel(group, key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["m:" .. tostring(group) .. "." .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		return ok and clone or nil
	end

	-- Copie d'un accessoire (clone du modèle chargé une seule fois : jamais de LoadAsset répété), ou nil.
	function A.cloneProp(key)
		if cfg.Enabled ~= true then
			return nil
		end
		local template = A.templates["x:" .. tostring(key)]
		if not template then
			return nil
		end
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok then
			return clone
		end
		return nil
	end

	-- Pose un modèle cloné : mis à l'échelle à `height` studs, posé au sol en (x, z), tourné de rotDeg, ancré, sans collision. Retourne (true, nombre de
	-- Parts) ou (false) ; en cas d'erreur le clone est détruit. Ne lève jamais d'erreur.
	function A.place(model, x, z, rotDeg, height, parent, length, groundY)
		local count = 0
		local mname = "?"
		pcall(function()
			mname = tostring(model.Name)
		end)
		local ok, err = pcall(function()
			if not model:IsA("Model") then
				error("pas un Model")
			end
			local _, size = model:GetBoundingBox()
			if size.Y < 0.05 then
				error("hauteur nulle")
			end
			local longest = math.max(size.X, size.Z)
			if length and longest > 0.05 then
				model:ScaleTo(length / longest) -- ponts : échelle d'après la longueur
			else
				local fitted, why = Assets.fitHeight(model, height) -- mesure puis vérification à ±10 % : sinon on ne pose pas
				if not fitted then
					error(why)
				end
			end
			local bbox, size2 = model:GetBoundingBox()
			local target = CFrame.new(x, (groundY or 0) + size2.Y / 2, z) * CFrame.Angles(0, math.rad(rotDeg or 0), 0)
			model:PivotTo(target * bbox:ToObjectSpace(model:GetPivot()))
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					count = count + 1
				end
			end
			model.Parent = parent
		end)
		if not ok then
			-- journal : le modèle est refusé (mesure, échelle ±10 %...) et l'apparence procédurale prend le relais
			if #A.placeFailures < 200 then
				A.placeFailures[#A.placeFailures + 1] = ("%s : %s"):format(mname, tostring(err))
			end
			pcall(function()
				model:Destroy()
			end)
			return false
		end
		return true, count
	end

	return A
end

return Assets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX100"><Properties><string name="Name">Reveal</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Reveal
-- Probabilité EXACTE d'un tirage et texte « 1 sur N » de la révélation d'œuf. Pur (Rules est injecté) et testé : la probabilité affichée
-- est celle que Rules.rollPet applique réellement (même poids de rareté, d'espèce, de taille, de mutation ; tirage de pitié inclus).
local Reveal = {}

-- Probabilité d'obtenir exactement (espèce p, taille s, mutation m) d'un œuf de rareté eggTier. guaranteed = tirage de pitié.
function Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local def = Config.PETS[p]
	if not def or not Config.SIZES[s] or not Config.MUTS[m] then
		return 0
	end
	local pTier
	eggTier = Config.liveEggTier(eggTier)
	local nxt = Config.nextLiveTier(eggTier)
	if guaranteed and eggTier <= Config.UPGRADE.maxEggTier and nxt then
		pTier = def.tier == nxt and 1 or 0
	else
		local w = Rules.tierWeights(eggTier, upPoints)
		local total = w[1] + w[2] + w[3]
		local idx = def.tier == eggTier and 2 or (def.tier == nxt and 3 or 0)
		pTier = (idx >= 1 and total > 0) and (math.max(w[idx], 0) / total) or 0
	end
	if pTier == 0 then
		return 0
	end
	local species = 0
	for _, q in ipairs(Config.PETS) do
		if q.tier == def.tier then
			species = species + 1
		end
	end
	local function share(weights, index)
		local total = 0
		for _, x in ipairs(weights) do
			total = total + math.max(x, 0)
		end
		return total > 0 and math.max(weights[index], 0) / total or 0
	end
	return pTier * (1 / species) * share(Rules.sizeWeights(), s) * share(Rules.mutWeights(alienBoost), m)
end

-- « 1 sur N » : N = 1 / probabilité (math.huge si impossible).
function Reveal.oneIn(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	local pr = Reveal.probability(Config, Rules, eggTier, upPoints, alienBoost, p, s, m, guaranteed)
	return pr > 0 and 1 / pr or math.huge
end

-- Style de la révélation selon la rareté du pet et la probabilité réelle. Un tirage plus rare que Config.REVEAL.secret.oneInAtLeast
-- déclenche l'effet « œuf secret ». reduced = option mobile (moins de rayons, de particules et de secousse).
function Reveal.style(Config, petTier, oneIn, reduced)
	local R = Config.REVEAL
	local base = R.tiers[math.min(math.max(petTier, 1), #R.tiers)]
	local st = {}
	for k, v in pairs(base) do
		st[k] = v
	end
	st.secret = oneIn ~= nil and oneIn >= R.secret.oneInAtLeast
	if st.secret then
		for k, v in pairs(R.secret) do
			st[k] = v
		end
	end
	st.color = st.secret and R.secret.color or Config.TIERS[math.min(math.max(petTier, 1), #Config.TIERS)].color
	st.banner = Config.rarityBanner(petTier, st.secret)
	if reduced then
		local k = R.reducedFactor
		st.rays = math.max(4, math.floor(st.rays * k))
		st.particles = math.floor(st.particles * k)
		st.shake = st.shake * k
		st.rings = math.max(1, math.floor(st.rings * k + 0.5))
	end
	return st
end

-- Écran de tirage « machine à sous » : plan PUR des 3 colonnes. Chaque colonne est un anneau de symboles ; la position (continue, base 1) part de 1, tourne
-- `loops` tours puis ralentit (sortie en puissance 4) et s'arrête EXACTEMENT sur le résultat réel. fast : durées courtes (tirage banal ou mobile).
function Reveal.slotPlan(Config, petTier, sizeIdx, mutIdx, fast)
	local S = Config.REVEAL.slot
	local stops = fast and S.fastStops or S.stops
	local function column(title, symbols, final, k)
		local n = #symbols
		local f = math.min(math.max(math.floor(tonumber(final) or 1), 1), n)
		return { title = title, symbols = symbols, final = f, stop = stops[k], travel = n * S.loops[k] + (f - 1) }
	end
	local tiers, sizes, muts = {}, {}, {}
	for i, t in ipairs(Config.TIERS) do
		tiers[i] = { text = t.name, color = t.color }
	end
	for i, z in ipairs(Config.SIZES) do
		sizes[i] = { text = z.name } -- couleur nil : blanc côté client
	end
	for i, m in ipairs(Config.MUTS) do
		muts[i] = { text = m.name == "" and "Normal" or m.name, color = m.color }
	end
	local cols = { column("RARETÉ", tiers, petTier, 1), column("TAILLE", sizes, sizeIdx, 2), column("MUTATION", muts, mutIdx, 3) }
	return { columns = cols, duration = cols[3].stop + S.hold, hold = S.hold, tier = math.min(math.max(math.floor(tonumber(petTier) or 1), 1), #Config.TIERS) }
end

-- Position continue de la colonne `col` à l'instant t (s) : croît sans jamais reculer, ralentit, vaut exactement 1 + travel à l'arrêt.
function Reveal.slotPos(col, t)
	local u = math.min(math.max(t / col.stop, 0), 1)
	return 1 + col.travel * (1 - (1 - u) ^ 4)
end

-- Indice (1..n) du symbole centré à la position pos.
function Reveal.slotIndex(col, pos)
	local n = #col.symbols
	return (math.floor(pos + 0.5) - 1) % n + 1
end

return Reveal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX101"><Properties><string name="Name">Guard</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Guard
-- Perception et état des gardiens (chien de Gus, loup de Mara, ours de Zed) : champ de vision (cône + distance), ouïe (le bruit dépend de la
-- vitesse du joueur), machine à états Patrouille / Alerte / Poursuite / Perte de cible / Retour, dégâts avec invulnérabilité courte et régénération.
-- PUR (aucun service Roblox, positions = tables { x, z }) : testé hors de Roblox. Main n'applique que ces décisions au monde.
local Guard = {}

local sqrt, acos, deg = math.sqrt, math.acos, math.deg

local function len(x, z)
	return sqrt(x * x + z * z)
end

-- Angle en degrés (0..180) entre le regard (fx, fz) et la direction (dx, dz). 0 si l'un des vecteurs est nul.
function Guard.angle(fx, fz, dx, dz)
	local a, b = len(fx, fz), len(dx, dz)
	if a < 1e-9 or b < 1e-9 then
		return 0
	end
	local c = (fx * dx + fz * dz) / (a * b)
	return deg(acos(math.max(-1, math.min(1, c))))
end

-- Le gardien g = { x, z, fx, fz } voit-il la cible t = { x, z } ? Cône de `viewAngle` degrés (total) et distance max `viewDist`.
function Guard.sees(g, t, viewDist, viewAngle)
	local dx, dz = t.x - g.x, t.z - g.z
	local d = len(dx, dz)
	if d > viewDist then
		return false
	end
	if d < 1.5 then
		return true -- collé au gardien : toujours vu
	end
	return Guard.angle(g.fx, g.fz, dx, dz) <= viewAngle / 2
end

-- Niveau de bruit (0..1) selon la vitesse : immobile = silence, marche lente = discret, course = plein bruit.
function Guard.noise(speed, cfg)
	if type(speed) ~= "number" or speed ~= speed or speed <= cfg.stillSpeed then
		return 0
	elseif speed < cfg.sneakSpeed then
		return cfg.sneakNoise
	end
	return 1
end

-- Entend-il la cible ? Rayon d'ouïe réduit proportionnellement au bruit.
function Guard.hears(dist, noise, hearRadius)
	return noise > 0 and dist <= hearRadius * noise
end

-- Perception complète : { sees, hears, dist }. g = { x, z, fx, fz }, t = { x, z, speed }, rival = { viewDist, viewAngle, hearRadius }.
function Guard.perceive(g, t, rival, cfg)
	local d = len(t.x - g.x, t.z - g.z)
	return { sees = Guard.sees(g, t, rival.viewDist, rival.viewAngle), hears = Guard.hears(d, Guard.noise(t.speed, cfg), rival.hearRadius), dist = d }
end

-- Machine à états. st = { state, timer, lost } ; percept = { sees, hears, atHome, dist } ; retourne le nouvel état (nouvelle table) et un événement
-- éventuel : "alert" (intrigué), "spotted" (poursuite), "lost" (cible perdue), "calm" (retour au calme).
--   patrol  : voit -> alert ; entend -> alert
--   alert   : s'arrête et regarde ; voit pendant alertDelay -> chase ; ne perçoit plus alertMax secondes -> return
--   chase   : voit ou entend -> poursuite continue ; ne perçoit plus -> lostChase ; trop loin (giveUpDist) -> return
--   lostChase : continue vers la dernière position connue loseDelay secondes (perte de cible), retrouve la cible -> chase, sinon -> return
--   return  : revient à la patrouille ; en route, voit -> alert
function Guard.nextState(st, dt, p, cfg)
	local s, timer, lost = st.state, st.timer or 0, st.lost or 0
	local event = nil
	if s == "patrol" then
		if p.sees or p.hears then
			s, timer, event = "alert", 0, "alert"
		end
	elseif s == "alert" then
		if p.sees then
			timer = timer + dt
			if timer >= cfg.alertDelay then
				s, timer, lost, event = "chase", 0, 0, "spotted"
			end
		elseif p.hears then
			timer = math.max(0, timer - dt * 0.25) -- bruit seul : reste méfiant mais ne poursuit pas
		else
			timer = timer + dt
			if timer >= cfg.alertMax then
				s, timer, event = "return", 0, "calm"
			end
		end
	elseif s == "chase" then
		if p.dist > cfg.giveUpDist then
			s, lost, event = "return", 0, "lost"
		elseif p.sees or p.hears then
			lost = 0
		else
			s, lost = "lostChase", 0
		end
	elseif s == "lostChase" then
		if p.sees or p.hears then
			s, lost, event = "chase", 0, "spotted"
		else
			lost = lost + dt
			if lost >= cfg.loseDelay then
				s, lost, event = "return", 0, "lost"
			end
		end
	else -- return
		if p.sees then
			s, timer, event = "alert", 0, "alert"
		elseif p.atHome then
			s, timer, event = "patrol", 0, "calm"
		end
	end
	return { state = s, timer = timer, lost = lost }, event
end

-- Alarme du nid (cour de Zed, lot 8A) : l'ours réveillé passe directement en poursuite du voleur (nouvelle table d'état).
function Guard.charge(_st)
	return { state = "chase", timer = 0, lost = 0 }
end

-- Dégâts : retourne (nouveaux points de vie, touché ?, invulnérabilité restante). Pendant l'invulnérabilité ou si hp <= 0 : aucun dégât.
function Guard.applyDamage(hp, damage, iframes, cfg)
	if iframes > 0 or hp <= 0 or damage <= 0 then
		return hp, false, iframes
	end
	return math.max(0, hp - damage), true, cfg.iframes
end

-- Régénération : après regenDelay secondes sans coup, regenPerSec par seconde (baseRegen par seconde dans la base du joueur). Plafonnée à maxHp.
-- Ramène (x, z) dans le disque de centre (cx, cz) et de rayon `radius` (territoire : le gardien ne quitte jamais son plateau ni ne traverse la douve).
function Guard.clampToDisc(x, z, cx, cz, radius)
	local dx, dz = x - cx, z - cz
	local d = len(dx, dz)
	if d <= radius or d < 1e-9 then
		return x, z
	end
	return cx + dx / d * radius, cz + dz / d * radius
end

-- Détection d'un gardien bloqué : `tr` = { t = 0 } conservé par gardien. Renvoie true quand il devrait bouger (want) mais avance de moins de cfg.stuckSpeed studs/s
-- depuis cfg.stuckSeconds secondes ; tout mouvement ou toute immobilité voulue (alerte) remet le compteur à zéro.
function Guard.stuckStep(tr, dt, moved, want, cfg)
	if not want or moved > cfg.stuckSpeed * dt then
		tr.t = 0
		return false
	end
	tr.t = tr.t + dt
	if tr.t >= cfg.stuckSeconds then
		tr.t = 0
		return true
	end
	return false
end

-- Pose de marche procédurale : rebond vertical et roulis en marchant (selon la vitesse), respiration à l'arrêt. `t` en secondes. Retourne (y, roulis en radians).
function Guard.walkPose(t, speed)
	if speed > 0.5 then
		local ph = t * speed * 0.9
		return math.abs(math.sin(ph)) * math.min(0.35, 0.04 * speed), math.sin(ph) * 0.06
	end
	return math.sin(t * 2) * 0.04, 0
end

-- Vigilance d'un territoire (Config.VIGILANCE) : `steals` = horodatages (s) des vols réussis dans CE territoire. Bonus de vue et d'ouïe = perSteal par vol
-- des `window` dernières secondes, plafonné à `max` ; retour à zéro `decay` secondes après le dernier vol. Retourne un nombre (0 .. max).
function Guard.vigilance(steals, now, cfg)
	local last, n = nil, 0
	for _, t in ipairs(steals) do
		if t <= now then
			if now - t <= cfg.window then
				n = n + 1
			end
			if last == nil or t > last then
				last = t
			end
		end
	end
	if last == nil or now - last >= cfg.decay then
		return 0
	end
	return math.min(cfg.max, n * cfg.perSteal)
end

-- Retire les vols trop anciens pour compter (hors de la fenêtre) : la liste ne grossit jamais. Retourne la nouvelle liste.
function Guard.vigilancePrune(steals, now, cfg)
	local out = {}
	for _, t in ipairs(steals) do
		if now - t <= cfg.window then
			out[#out + 1] = t
		end
	end
	return out
end

-- Réglages de perception majorés par la vigilance (vue et ouïe x (1 + bonus)) ; l'angle de vue ne change pas. Nouvelle table.
function Guard.boosted(rival, bonus)
	return { viewDist = rival.viewDist * (1 + bonus), viewAngle = rival.viewAngle, hearRadius = rival.hearRadius * (1 + bonus) }
end

function Guard.regen(hp, sinceHit, dt, atBase, cfg)
	if hp <= 0 or hp >= cfg.maxHp then
		return math.min(hp, cfg.maxHp)
	end
	local rate = atBase and cfg.baseRegen or (sinceHit >= cfg.regenDelay and cfg.regenPerSec or 0)
	return math.min(cfg.maxHp, hp + rate * dt)
end

return Guard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX102"><Properties><string name="Name">Traps</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Traps
-- Pièges des territoires (REFONTE lot 4) : fils à clochettes et flaques de boue de Mara, herse, dalles d'alarme et lanternes tournantes de Zed, plus la
-- fraîcheur des œufs de Zed. PUR (aucun service Roblox, positions = nombres x, z) : testé hors de Roblox. Les positions sont DÉRIVÉES de Config.TERR
-- (centre, rayon, entrée) : rien n'est écrit en dur. Le serveur (Main) applique les décisions, le Builder construit les Parts d'après `layout`.
local Traps = {}

local sqrt, cos, sin, rad, deg, acos, pi = math.sqrt, math.cos, math.sin, math.rad, math.deg, math.acos, math.pi

-- Tourne le vecteur unitaire (ux, uz) de `degrees` degrés.
local function rot(ux, uz, degrees)
	local c, s = cos(rad(degrees)), sin(rad(degrees))
	return ux * c - uz * s, ux * s + uz * c
end

-- Plan des pièges d'un territoire (nil si le territoire n'en a pas). `Config` = module Config. Tout est calculé autour de l'entrée du territoire :
--   fils à clochettes : 3 fils tangents sur l'arc à 70 % du rayon, à -30 / 0 / +30 degrés de l'entrée (demi-longueur Config.TRAPS.bellHalfWidth)
--   boue : flaques à 45 % du rayon, étalées de -70 à +70 degrés
--   dalles d'alarme : à 55 % du rayon, tous les 360/n degrés à partir de 45 degrés
--   lanternes : à 55 % du rayon, à +90 et -90 degrés, tournant en sens inverse l'une de l'autre depuis des angles opposés
--   herse : à l'entrée (Config.TERR.zed.traps.gate)
function Traps.layout(Config, key)
	local t = Config.TERR[key]
	local tr = t and t.traps
	if not tr then
		return nil
	end
	local C = Config.TRAPS
	local ex, ez = Config.territoryEntry(key)
	local dx, dz = ex - t.x, ez - t.z
	local d = sqrt(dx * dx + dz * dz)
	local ux, uz = dx / d, dz / d
	local function at(frac, degrees)
		local vx, vz = rot(ux, uz, degrees)
		return t.x + vx * t.r * frac, t.z + vz * t.r * frac, vx, vz
	end
	local L = { key = key, cx = t.x, cz = t.z, r = t.r, bells = {}, mud = {}, plates = {}, lights = {}, gate = nil }
	for k = 1, tr.bells or 0 do
		local x, z, vx, vz = at(0.7, (k - 2) * 30)
		local tx, tz = -vz, vx -- tangente au cercle : le fil barre le passage vers l'intérieur
		L.bells[k] = { x = x, z = z, ax = x - tx * C.bellHalfWidth, az = z - tz * C.bellHalfWidth, bx = x + tx * C.bellHalfWidth, bz = z + tz * C.bellHalfWidth }
	end
	local nm = tr.mud or 0
	for k = 1, nm do
		local x, z = at(0.45, -70 + (k - 1) * 140 / math.max(1, nm - 1))
		L.mud[k] = { x = x, z = z, r = C.mudRadius }
	end
	local np = tr.plates or 0
	for k = 1, np do
		local x, z = at(0.55, 45 + (k - 1) * 360 / np)
		L.plates[k] = { x = x, z = z, r = C.plateRadius }
	end
	for k = 1, tr.searchlights or 0 do
		local x, z = at(0.55, 90 + (k - 1) * 180)
		L.lights[k] = { x = x, z = z, phase = (k - 1) * pi, rev = tr.searchlightRev or 0.5, range = C.lightRange, cone = C.lightCone }
	end
	if tr.gate then
		L.gate = { x = tr.gate.x, z = tr.gate.z, open = tr.gate.open, closed = tr.gate.closed }
	end
	return L
end

-- Nombre de Parts que les pièges d'un plan font construire au Builder (budget : <= 40 pour tous les territoires).
-- fil : 2 poteaux + le fil ; flaque : 1 ; dalle : 1 ; lanterne : poteau + faisceau ; herse : 0 (la Part CourtGate de Scenery est réutilisée).
function Traps.partCount(L)
	if not L then
		return 0
	end
	return #L.bells * 3 + #L.mud + #L.plates + #L.lights * 2
end

---------------------------------------------------------------- géométrie
local function orient(px, pz, qx, qz, rx, rz)
	return (qx - px) * (rz - pz) - (qz - pz) * (rx - px)
end

-- Les segments [a b] et [c d] se croisent-ils strictement ?
function Traps.segCross(ax, az, bx, bz, cx, cz, dx, dz)
	local o1, o2 = orient(ax, az, bx, bz, cx, cz), orient(ax, az, bx, bz, dx, dz)
	local o3, o4 = orient(cx, cz, dx, dz, ax, az), orient(cx, cz, dx, dz, bx, bz)
	return o1 * o2 < 0 and o3 * o4 < 0
end

-- Distance du point (px, pz) au segment [a b].
function Traps.distToSeg(px, pz, ax, az, bx, bz)
	local vx, vz = bx - ax, bz - az
	local l2 = vx * vx + vz * vz
	local t = l2 > 0 and math.max(0, math.min(1, ((px - ax) * vx + (pz - az) * vz) / l2)) or 0
	local qx, qz = ax + vx * t, az + vz * t
	return sqrt((px - qx) ^ 2 + (pz - qz) ^ 2)
end

---------------------------------------------------------------- herse (cycle ouverte `open` s / fermée `closed` s, ouverte au temps 0)
function Traps.gateOpen(t, gate)
	local cyc = gate.open + gate.closed
	return (t % cyc) < gate.open
end

-- Hauteur de la herse : 1 = levée (ouverte), 0 = baissée (fermée). Montée ou descente en `window` secondes au début de chaque phase.
function Traps.gateLift(t, gate, window)
	local cyc = gate.open + gate.closed
	local ph = t % cyc
	if ph < gate.open then
		return math.min(1, ph / window)
	end
	return math.max(0, 1 - (ph - gate.open) / window)
end

-- La herse est SOLIDE tant qu'elle est descendue à moitié ou plus (elle ne bloque pas pendant qu'elle monte).
function Traps.gateSolid(t, gate, window)
	return Traps.gateLift(t, gate, window) <= 0.5 and not Traps.gateOpen(t, gate)
end

---------------------------------------------------------------- lanternes tournantes
function Traps.lanternAngle(t, light)
	return light.phase + 2 * pi * light.rev * t
end

-- La lanterne éclaire-t-elle (px, pz) au temps t ? Portée `range`, cône de `cone` degrés (total) centré sur l'angle courant.
function Traps.lanternSees(light, t, px, pz)
	local dx, dz = px - light.x, pz - light.z
	local d = sqrt(dx * dx + dz * dz)
	if d > light.range then
		return false
	end
	if d < 1 then
		return true
	end
	local a = Traps.lanternAngle(t, light)
	local c = (cos(a) * dx + sin(a) * dz) / d
	return deg(acos(math.max(-1, math.min(1, c)))) <= light.cone / 2
end

---------------------------------------------------------------- décision par joueur
function Traps.newPlayerState()
	return { px = nil, pz = nil, mudUntil = 0, cd = {} }
end

-- Un pas de simulation pour un joueur en (x, z) au temps t (le serveur l'appelle ~10 fois par seconde pour les joueurs proches du territoire).
-- Met `ps` à jour (position précédente, délais) et retourne la liste des événements :
--   { kind = "bell", index }  : le joueur a traversé un fil (ou le frôle à moins d'un stud)
--   { kind = "plate", index } : il marche sur une dalle d'alarme
--   { kind = "light", index } : une lanterne l'éclaire
--   { kind = "mud", index }   : il entre dans une flaque (une seule fois par passage ; la vitesse est ralentie tant que t < ps.mudUntil)
-- Chaque alarme a un délai de recharge par joueur (cfg = Config.TRAPS).
function Traps.playerStep(ps, L, cfg, t, x, z)
	local ev = {}
	local qx, qz = ps.px or x, ps.pz or z
	ps.px, ps.pz = x, z
	for i, b in ipairs(L.bells) do
		local key = "b" .. i
		if t >= (ps.cd[key] or 0) and (Traps.segCross(qx, qz, x, z, b.ax, b.az, b.bx, b.bz) or Traps.distToSeg(x, z, b.ax, b.az, b.bx, b.bz) < 1) then
			ps.cd[key] = t + cfg.bellCooldown
			ev[#ev + 1] = { kind = "bell", index = i }
		end
	end
	for i, m in ipairs(L.mud) do
		if (x - m.x) ^ 2 + (z - m.z) ^ 2 <= m.r * m.r then
			if t >= ps.mudUntil then
				ev[#ev + 1] = { kind = "mud", index = i }
			end
			ps.mudUntil = t + cfg.mudSeconds
		end
	end
	for i, p in ipairs(L.plates) do
		local key = "p" .. i
		if t >= (ps.cd[key] or 0) and (x - p.x) ^ 2 + (z - p.z) ^ 2 <= p.r * p.r then
			ps.cd[key] = t + cfg.plateCooldown
			ev[#ev + 1] = { kind = "plate", index = i }
		end
	end
	for i, l in ipairs(L.lights) do
		local key = "l" .. i
		if t >= (ps.cd[key] or 0) and Traps.lanternSees(l, t, x, z) then
			ps.cd[key] = t + cfg.lightCooldown
			ev[#ev + 1] = { kind = "light", index = i }
		end
	end
	return ev
end

-- Multiplicateur de vitesse de la boue (1 hors flaque).
function Traps.mudMul(ps, t, cfg)
	return t < ps.mudUntil and cfg.mudMul or 1
end

---------------------------------------------------------------- fraîcheur des œufs
-- Échéance (temps absolu) d'un œuf de rareté `tier` pris dans le territoire `terr`, ou nil s'il ne se refroidit pas : seuls les œufs de rareté
-- Config.CARRY.beamTier ou plus (Légendaire+) pris dans un territoire qui a une `freshness` (Zed : 75 s).
function Traps.freshDeadline(Config, tier, terr, now)
	local t = terr and Config.TERR[terr]
	if t and t.freshness and tier >= Config.CARRY.beamTier then
		return now + t.freshness
	end
	return nil
end

function Traps.expired(egg, now)
	return egg.fresh ~= nil and now >= egg.fresh
end

return Traps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX103"><Properties><string name="Name">Riddle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Riddle
-- REFONTE lot 6 : énigme de la Mère Poule en 3 étapes GUIDÉES (plumes, runes, berceuse). Module PUR : aucune dépendance à Roblox, testé avec Lune/lupa.
-- Le serveur tient l'état (profil `puzzle`), le client ne fait qu'afficher ; ce module décide de tout ce qui est « règle » :
--   plumes du jour, berceuse du jour, transitions d'étape (refusées si invalides), indices, compte à rebours, répliques, guidage, effet collectif.
--
-- Générateur : Config.dayRng (le MÊME Park-Miller déterministe que Config.riddleFor) avec un « sel » par usage, pour que les plumes, la berceuse et
-- les runes d'un même jour ne soient pas corrélées : plumes = dayRng(jour + 5003), berceuse = dayRng(jour + 9007), runes = dayRng(jour) (Config.riddleFor).
-- Même jour = mêmes plumes, mêmes runes, même berceuse pour tous les joueurs.
--
-- Étapes : 0 non commencée · 1 plumes · 2 runes · 3 berceuse · 4 faite (= puzzle.day == jour). Le profil ne stocke que 0..3 (+ puzzle.pday, le jour de la
-- progression : un autre jour = remise à zéro) ; « 4 » se déduit de puzzle.day.
local Riddle = {}

Riddle.STEP = { idle = 0, feathers = 1, runes = 2, lullaby = 3, done = 4 }
Riddle.DIRS = { "N", "E", "S", "O" } -- ordre de Config.RUNE_DIRECTIONS et de Config.Map2.runeStones
Riddle.DIR_OF = { "du Nord", "de l'Est", "du Sud", "de l'Ouest" } -- « La plume du Nord », « la rune de l'Est »
local FEATHER_SALT, LULLABY_SALT = 5003, 9007
local BIT = { 1, 2, 4, 8 } -- masque des plumes : Nord 1, Est 2, Sud 4, Ouest 8

local function validDir(dir)
	return type(dir) == "number" and dir == dir and dir % 1 == 0 and dir >= 1 and dir <= 4
end

-- Profil `puzzle` neuf (même forme que Data.default().puzzle).
function Riddle.fresh()
	return { day = 0, solved = 0, step = 0, feathers = 0, hints = 0, fragments = 0, pday = 0, met = false }
end

---------------------------------------------------------------- Plumes et berceuse du jour
-- Une plume par direction (N, E, S, O) parmi les 3 emplacements de Config.FEATHER_SPOTS : { { dir, key, index, x, z, where } x4 }.
function Riddle.featherSpots(Config, day)
	local r = Config.dayRng(day + FEATHER_SALT)
	local out = {}
	for dir = 1, 4 do
		local list = Config.FEATHER_SPOTS[Riddle.DIRS[dir]]
		local idx = r(#list)
		local sp = list[idx]
		out[dir] = { dir = dir, key = Riddle.DIRS[dir], index = idx, x = sp.x, z = sp.z, where = sp.where, dock = sp.dock == true }
	end
	return out
end

-- Berceuse du jour : Config.HEN.lullabyLength pierres (numéros 1..4 = Nord, Est, Sud, Ouest), chaque pierre présente au moins une fois
-- (les 4 pierres d'abord, puis des pierres tirées, le tout mélangé).
function Riddle.lullaby(Config, day)
	local r = Config.dayRng(day + LULLABY_SALT)
	local n = math.max(4, Config.HEN.lullabyLength)
	local seq = { 1, 2, 3, 4 }
	for i = 5, n do
		seq[i] = r(4)
	end
	for i = n, 2, -1 do
		local j = r(i)
		seq[i], seq[j] = seq[j], seq[i]
	end
	return seq
end

-- Durée totale d'une écoute de la berceuse (secondes) : chaque pierre brille `lullabyNote` s, puis `lullabyGap` s de silence.
function Riddle.lullabyDuration(Config)
	return Config.HEN.lullabyLength * (Config.HEN.lullabyNote + Config.HEN.lullabyGap)
end

-- Début (en secondes depuis le début de l'écoute) de la note i.
function Riddle.noteStart(Config, i)
	return (i - 1) * (Config.HEN.lullabyNote + Config.HEN.lullabyGap)
end

---------------------------------------------------------------- État et transitions (toutes pures : elles modifient p et disent si c'était permis)
function Riddle.available(chaptersDone)
	return type(chaptersDone) == "number" and chaptersDone >= 2 -- chapitre 2 réussi
end

function Riddle.featherCount(mask)
	local n = 0
	for dir = 1, 4 do
		if math.floor(mask / BIT[dir]) % 2 == 1 then
			n = n + 1
		end
	end
	return n
end

function Riddle.hasFeather(mask, dir)
	return validDir(dir) and type(mask) == "number" and math.floor(mask / BIT[dir]) % 2 == 1
end

-- Un autre jour que celui de la progression : remise à zéro (étape, plumes, indices ; fragments et résolutions sont conservés).
-- Retourne true si une remise à zéro a eu lieu, puis true si une progression a été perdue.
function Riddle.normalize(p, day)
	if p.pday ~= day then
		local lost = p.step ~= 0 or p.feathers ~= 0 or p.hints ~= 0
		p.pday, p.step, p.feathers, p.hints = day, 0, 0, 0
		return true, lost
	end
	return false, false
end

-- Étape effective : 4 si résolue ce jour, sinon l'étape sauvegardée (0..3).
function Riddle.stepOf(p, day)
	if p.day == day then
		return 4
	end
	return p.step
end

-- 0 -> 1 : le joueur accepte d'aider la Mère Poule. Refusée si indisponible (chapitre 2), déjà faite ou déjà commencée.
function Riddle.start(p, day, avail)
	if not avail then
		return false, "locked"
	end
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 0 then
		return false, "started"
	end
	p.step = 1
	return true
end

-- Ramassage d'une plume (étape 1 seulement). Retourne ok, nombre de plumes (ou ok=false, raison).
function Riddle.collect(p, day, dir)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 1 then
		return false, "step"
	end
	if not validDir(dir) then
		return false, "dir"
	end
	if Riddle.hasFeather(p.feathers, dir) then
		return false, "have"
	end
	p.feathers = p.feathers + BIT[dir]
	return true, Riddle.featherCount(p.feathers)
end

-- 1 -> 2 : IMPOSSIBLE sans les 4 plumes.
function Riddle.toRunes(p, day)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 1 then
		return false, "step"
	end
	if Riddle.featherCount(p.feathers) ~= 4 then
		return false, "feathers"
	end
	p.step = 2
	return true
end

-- Une rune ne se tourne qu'une fois la plume de sa direction ramassée, et seulement pendant les étapes 1 et 2.
function Riddle.runeUnlocked(p, day, dir)
	if p.day == day or p.pday ~= day then
		return false
	end
	return (p.step == 1 or p.step == 2) and Riddle.hasFeather(p.feathers, dir)
end

-- Nombre de runes justes (jamais lesquelles). runes et answer : 4 symboles.
function Riddle.runesCorrect(runes, answer)
	local k = 0
	for i = 1, 4 do
		if runes[i] ~= nil and runes[i] == answer[i] then
			k = k + 1
		end
	end
	return k
end

-- 2 -> 3 : seulement si les 4 runes sont justes (`correct` = résultat de runesCorrect).
function Riddle.toLullaby(p, day, correct)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 2 then
		return false, "step"
	end
	if correct ~= 4 then
		return false, "runes"
	end
	p.step = 3
	return true
end

-- Touche d'une pierre pendant la berceuse : seq = suite attendue, pos = position attendue (1..#seq), stone = pierre touchée (1..4).
-- Retourne "ok" (bonne pierre, pos avance), "done" (dernière pierre juste) ou "wrong" (erreur : pos revient à 1, la suite est rejouée).
function Riddle.tap(seq, pos, stone)
	if seq[pos] ~= nil and stone == seq[pos] then
		if pos >= #seq then
			return "done", 1
		end
		return "ok", pos + 1
	end
	return "wrong", 1
end

function Riddle.tapAllowed(Config, now, lastTap)
	return type(now) == "number" and type(lastTap) == "number" and now - lastTap >= Config.HEN.tapMinGap
end

function Riddle.pickupAllowed(Config, dist, now, lastPick)
	return type(dist) == "number" and dist == dist and dist <= Config.HEN.pickupDistance and type(now) == "number" and type(lastPick) == "number" and now - lastPick >= Config.HEN.pickupGap
end

-- 3 -> 4 : récompense UNE fois par jour. Retourne ok puis { eggTier, coinsMins, fragments, legendary, titleNew } ; fragments cumulés,
-- 1 œuf Légendaire à chaque tranche de Config.HEN.fragmentsForEgg (7) atteinte, titre « Ami de la Mère Poule » dès 7.
function Riddle.complete(Config, p, day, lullabyDone)
	Riddle.normalize(p, day)
	if p.day == day then
		return false, "done"
	end
	if p.step ~= 3 then
		return false, "step"
	end
	if lullabyDone ~= true then
		return false, "lullaby"
	end
	local before = p.fragments
	local after = before + 1
	local per = Config.HEN.fragmentsForEgg
	local legendary = math.floor(after / per) - math.floor(before / per)
	p.day = day
	p.solved = p.solved + 1
	p.step, p.feathers = 0, 0
	p.fragments = after
	return true, { eggTier = Config.PUZZLE_EGG_TIER, mins = Config.PUZZLE_MINS, fragments = after, legendary = legendary, titleNew = before < per and after >= per }
end

function Riddle.hasTitle(Config, fragments)
	return type(fragments) == "number" and fragments >= Config.HEN.fragmentsForEgg
end

---------------------------------------------------------------- Indices (« 💡 Un coup de bec »)
-- 2 par jour, jamais payants. Le 1er : gratuit après hintAfterSeconds dans l'étape courante. Le 2e : après failsForHint validations ratées à l'étape 2.
-- Retourne ok ; sinon false, raison ("step" | "max" | "wait" | "fails"), et le temps (s) ou le nombre de validations ratées restantes.
function Riddle.hintStatus(Config, p, day, secondsInStep, fails)
	local H = Config.HEN
	local step = Riddle.stepOf(p, day)
	if step < 1 or step > 3 then
		return false, "step"
	end
	if p.hints >= H.hintsPerDay then
		return false, "max"
	end
	if p.hints == 0 then
		if secondsInStep >= H.hintAfterSeconds then
			return true
		end
		return false, "wait", math.ceil(H.hintAfterSeconds - secondsInStep)
	end
	if step == 2 and fails >= H.failsForHint then
		return true
	end
	return false, "fails", step == 2 and (H.failsForHint - fails) or nil
end

-- Contenu de l'indice : identifiant de réplique et paramètres. runes = symboles actuels du joueur (4 numéros).
function Riddle.hintFor(Config, p, day, runes)
	local step = Riddle.stepOf(p, day)
	if step == 1 then
		local spots = Riddle.featherSpots(Config, day)
		for dir = 1, 4 do
			if not Riddle.hasFeather(p.feathers, dir) then
				return "hintFeather", { dir = Riddle.DIR_OF[dir], where = spots[dir].where }
			end
		end
	elseif step == 2 then
		local answer = Config.riddleFor(day).answer
		for dir = 1, 4 do
			if runes[dir] ~= answer[dir] then
				return "hintRune", { dir = Riddle.DIR_OF[dir], symbol = Config.RUNES[answer[dir]] }
			end
		end
	elseif step == 3 then
		return "hintLullaby", { dir = Riddle.DIR_OF[Riddle.lullaby(Config, day)[1]] }
	end
	return nil
end

---------------------------------------------------------------- Compte à rebours
-- « Nouvelle berceuse dans h mm » : heures, minutes (arrondies au-dessus), secondes restantes avant 00:00 UTC.
function Riddle.untilNext(now)
	local left = 86400 - (now % 86400)
	local total = math.ceil(left / 60)
	return math.floor(total / 60), total % 60, left
end

---------------------------------------------------------------- Répliques
function Riddle.format(tpl, params)
	return (tpl:gsub("{(%w+)}", function(k)
		local v = params and params[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

-- « du Nord, de l'Est et de l'Ouest » d'après le masque de plumes (les directions MANQUANTES).
function Riddle.missingDirs(mask)
	local list = {}
	for dir = 1, 4 do
		if not Riddle.hasFeather(mask, dir) then
			list[#list + 1] = Riddle.DIR_OF[dir]
		end
	end
	if #list <= 1 then
		return list[1] or ""
	end
	return table.concat(list, ", ", 1, #list - 1) .. " et " .. list[#list]
end

-- Paramètres de la réplique « missing » d'après le masque.
function Riddle.missingParams(mask)
	return { n = 4 - Riddle.featherCount(mask), dirs = Riddle.missingDirs(mask) }
end

-- Réplique « {h} h {mm} ».
function Riddle.doneParams(now)
	local h, m = Riddle.untilNext(now)
	return { h = h, mm = string.format("%02d", m) }
end

-- Texte d'une réplique (id de Config.HEN_LINES) : { id, pages = { texte, ... }, buttons = { { id, text }, ... } }.
-- step = étape du joueur : ajoute « 💡 Un coup de bec » (étapes 1 à 3) et « 🔁 Réécouter » (étape 3) aux répliques de suivi.
function Riddle.say(Config, id, params, step)
	local L = Config.HEN_LINES
	local B = L.buttons
	local pages, ids = nil, {}
	if id == "first" then
		pages, ids = L.first, { "go", "again" }
	elseif id == "explain" or id == "again" then
		pages, ids = { L[id] }, { "go", "later" }
	elseif id == "success" or id == "done" or id == "locked" or id == "feather" then
		pages = { L[id] }
	elseif L[id] ~= nil and type(L[id]) == "string" then
		pages = { L[id] }
		if step == 1 or step == 2 or step == 3 then
			ids[#ids + 1] = "hint"
		end
		if step == 3 then
			ids[#ids + 1] = "replay"
		end
	else
		return { id = id, pages = {}, buttons = {} }
	end
	local out = {}
	for i, p in ipairs(pages) do
		out[i] = Riddle.format(p, params)
	end
	local buttons = {}
	for _, b in ipairs(ids) do
		buttons[#buttons + 1] = { id = b, text = B[b] }
	end
	return { id = id, pages = out, buttons = buttons }
end

-- Texte d'une plume ramassée : « 🪶 Plume du Nord : « ce qui coule et berce » ».
function Riddle.featherLine(Config, day, dir)
	local clue = Config.riddleFor(day).clues[dir]
	return Riddle.format(Config.HEN_LINES.feather, { dir = Riddle.DIR_OF[dir], clue = clue }), clue
end

---------------------------------------------------------------- Guidage (faisceau, mini-carte)
-- Centre du quart de carte (quadrant Nord-Ouest, Nord-Est, Sud-Ouest, Sud-Est de Config.Map2.bounds) qui contient (x, z).
function Riddle.quarter(Config, x, z)
	local b = Config.Map2.bounds
	return (x < 0 and b.x0 or b.x1) / 2, (z < 0 and b.z0 or b.z1) / 2
end

local function dist2d(ax, az, bx, bz)
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

-- Cible du faisceau jaune d'après l'état `hen` envoyé par le serveur (avail, step, spots = plumes NON ramassées { dir, x, z }) et la position du joueur.
-- { kind = "hen" | "quarter" | "feather" | "runes", x, z, dir, near } ou nil. Étape 0 : la Mère Poule. Étape 1 : le centre du quart de carte de la plume la
-- plus proche tant qu'on en est loin (> quarterReach du centre), puis la plume elle-même ; `near` = à moins de sparkleDistance (la plume scintille).
-- Étapes 2 et 3 : le Grand Œuf (les 4 runes l'entourent).
function Riddle.guide(Config, hen, px, pz)
	if type(hen) ~= "table" or hen.avail ~= true or type(hen.step) ~= "number" or hen.step >= 4 then
		return nil
	end
	local H = Config.HEN
	if hen.step == 0 then
		return { kind = "hen", x = Config.Map2.hen.x, z = Config.Map2.hen.z }
	elseif hen.step >= 2 then
		return { kind = "runes", x = Config.Map2.bigEgg.x, z = Config.Map2.bigEgg.z }
	end
	local best, bd = nil, math.huge
	for _, sp in ipairs(hen.spots or {}) do
		if type(sp.x) == "number" and type(sp.z) == "number" then
			local d = dist2d(px, pz, sp.x, sp.z)
			if d < bd then
				best, bd = sp, d
			end
		end
	end
	if not best then
		return { kind = "hen", x = Config.Map2.hen.x, z = Config.Map2.hen.z }
	end
	if bd <= H.sparkleDistance then
		return { kind = "feather", x = best.x, z = best.z, dir = best.dir, near = true }
	end
	local qx, qz = Riddle.quarter(Config, best.x, best.z)
	if dist2d(px, pz, qx, qz) > H.quarterReach then
		return { kind = "quarter", x = qx, z = qz, dir = best.dir }
	end
	return { kind = "feather", x = best.x, z = best.z, dir = best.dir, near = false }
end

---------------------------------------------------------------- Effet collectif (Pluie de chance)
-- c = { day, count, fired } propre au serveur. Retourne true quand l'événement doit démarrer MAINTENANT (une fois par jour et par serveur).
function Riddle.collectiveAdd(Config, c, day)
	if c.day ~= day then
		c.day, c.count, c.fired = day, 0, false
	end
	c.count = c.count + 1
	if not c.fired and c.count >= Config.HEN.collectiveSolves then
		c.fired = true
		return true
	end
	return false
end

return Riddle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX104"><Properties><string name="Name">Castle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Castle
-- Mode « Château » : donjon de salles successives avec pièges à éviter (pics, lames tournantes, boulets, porte à timing) et coffre final.
-- Logique PURE (aucun service Roblox) : géométrie des salles, états des pièges en fonction du temps, détection des touches, difficulté croissante,
-- classement des temps et récompense. Coordonnées d'une salle : lx (travers, -20..20) et lz (profondeur depuis l'entrée, 0..roomLength).
local Castle = {}

Castle.ROOMS = 5
Castle.ROOM_LENGTH = 56
Castle.ROOM_WIDTH = 40
Castle.ORIGIN = { x = 470, z = -280 } -- entrée de la salle 1 dans le monde ; les salles avancent vers -z

-- Difficulté d'une salle r (1..ROOMS) : nombre de pièges et rythme, croissants.
function Castle.room(r)
	r = math.min(math.max(r, 1), Castle.ROOMS)
	return {
		index = r,
		spikes = 3 + r, -- plaques à pics (4 colonnes)
		blades = r >= 4 and 2 or (r >= 2 and 1 or 0),
		balls = r >= 3 and (r - 2) or 0,
		knights = r >= 5 and 2 or (r >= 3 and 1 or 0), -- chevaliers qui patrouillent d'un mur à l'autre (touche non mortelle)
		period = math.max(1.6, 3.4 - 0.3 * r), -- durée d'un cycle des pics (s)
		bladeSpeed = 1.2 + 0.3 * r, -- radians par seconde
		ballTravel = math.max(1.6, 3.2 - 0.25 * r), -- traversée d'un boulet (s)
		doorPeriod = math.max(3, 5 - 0.4 * r), -- cycle de la porte (s)
		doorOpen = math.max(1.4, 2.4 - 0.2 * r), -- durée d'ouverture (s)
	}
end

-- Pics : phase 0..1 du cycle ; avertissement avant le danger (les pics se dressent), danger 0,9 s par cycle.
local DANGER, WARN = 0.9, 0.6
function Castle.spikeState(t, trap, room)
	local period = room.period
	local phase = ((t + trap.offset) % period)
	local dangerStart = period - DANGER
	if phase >= dangerStart then
		return "danger"
	elseif phase >= dangerStart - WARN then
		return "warning"
	end
	return "safe"
end

-- Plaques à pics de la salle : 4 colonnes espacées (couloirs sûrs de 4 studs entre elles), phases décalées.
function Castle.spikes(room)
	local out = {}
	for i = 1, room.spikes do
		local col, row = (i - 1) % 4, math.floor((i - 1) / 4)
		out[i] = { lx = -15 + col * 10, lz = 10 + row * 9, radius = 3, offset = ((col + row) % 4) * (room.period / 4) }
	end
	return out
end

-- Lames tournantes : centre de la salle, deux bras opposés de 14 studs, angle selon le temps.
function Castle.blades(room)
	local out = {}
	for i = 1, room.blades do
		out[i] = { lx = (i - (room.blades + 1) / 2) * 20, lz = 34, arm = 14, phase = (i - 1) * math.pi / 2 }
	end
	return out
end

function Castle.bladeAngle(t, blade, room)
	return blade.phase + t * room.bladeSpeed
end

-- Boulets : couloirs horizontaux (traversée de gauche à droite puis pause avant de recommencer).
function Castle.balls(room)
	local out = {}
	for i = 1, room.balls do
		out[i] = { lz = 18 + (i - 1) * 9, radius = 3, offset = (i - 1) * 0.9 }
	end
	return out
end

-- Position latérale d'un boulet (nil pendant la pause).
function Castle.ballX(t, ball, room)
	local cycle = room.ballTravel + 1.4
	local phase = (t + ball.offset) % cycle
	if phase >= room.ballTravel then
		return nil
	end
	return -22 + 44 * (phase / room.ballTravel)
end

-- Chevaliers : patrouille en aller-retour latéral (onde triangulaire, vitesse constante), décalés pour ne pas être synchrones.
function Castle.knights(room)
	local out = {}
	for i = 1, room.knights do
		out[i] = { lz = 14 + (i - 1) * 24, amp = 15, period = math.max(5, 9 - 0.7 * room.index), offset = (i - 1) * 2.3, radius = 2.6 }
	end
	return out
end

-- Position latérale et sens (+1 vers la droite, -1 vers la gauche) d'un chevalier à l'instant t.
function Castle.knightPos(t, k)
	local phase = ((t + k.offset) % k.period) / k.period -- 0..1
	if phase < 0.5 then
		return -k.amp + 4 * k.amp * phase, 1
	end
	return k.amp - 4 * k.amp * (phase - 0.5), -1
end

-- Porte de fin de salle : ouverte pendant doorOpen secondes par cycle.
function Castle.doorIsOpen(t, room)
	return (t % room.doorPeriod) < room.doorOpen
end

-- Distance d'un point au segment [a, b].
local function distToSegment(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local u = l2 > 0 and math.max(0, math.min(1, ((px - ax) * dx + (pz - az) * dz) / l2)) or 0
	local cx, cz = ax + u * dx, az + u * dz
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end
Castle.distToSegment = distToSegment

-- Le joueur (px, pz en coordonnées locales de salle) est-il touché par un piège à l'instant t ? Retourne le nom du piège ou nil.
function Castle.hit(t, room, px, pz, playerRadius)
	playerRadius = playerRadius or 1.2
	for _, sp in ipairs(Castle.spikes(room)) do
		if Castle.spikeState(t, sp, room) == "danger" and math.sqrt((px - sp.lx) ^ 2 + (pz - sp.lz) ^ 2) < sp.radius + playerRadius * 0.5 then
			return "spikes"
		end
	end
	for _, bl in ipairs(Castle.blades(room)) do
		local a = Castle.bladeAngle(t, bl, room)
		local cx, cz = math.cos(a) * bl.arm, math.sin(a) * bl.arm
		if distToSegment(px, pz, bl.lx - cx, bl.lz - cz, bl.lx + cx, bl.lz + cz) < 1.6 + playerRadius * 0.5 then
			return "blade"
		end
	end
	for _, ba in ipairs(Castle.balls(room)) do
		local bx = Castle.ballX(t, ba, room)
		if bx and math.sqrt((px - bx) ^ 2 + (pz - ba.lz) ^ 2) < ba.radius + playerRadius * 0.5 then
			return "ball"
		end
	end
	for _, kn in ipairs(Castle.knights(room)) do
		local kx = Castle.knightPos(t, kn)
		if math.sqrt((px - kx) ^ 2 + (pz - kn.lz) ^ 2) < kn.radius + playerRadius * 0.5 then
			return "knight"
		end
	end
	return nil
end

-- Conversion monde <-> salle : la salle r commence à ORIGIN.z - (r - 1) * ROOM_LENGTH et avance vers -z.
function Castle.toLocal(wx, wz)
	local depth = Castle.ORIGIN.z - wz -- profondeur totale depuis l'entrée
	local r = math.floor(depth / Castle.ROOM_LENGTH) + 1
	return r, wx - Castle.ORIGIN.x, depth - (r - 1) * Castle.ROOM_LENGTH
end

function Castle.toWorld(r, lx, lz)
	return Castle.ORIGIN.x + lx, Castle.ORIGIN.z - ((r - 1) * Castle.ROOM_LENGTH + lz)
end

-- Joueur dans le château ? (rectangle des salles). Retourne le numéro de salle ou nil.
function Castle.roomAt(wx, wz)
	local r, lx, lz = Castle.toLocal(wx, wz)
	if r >= 1 and r <= Castle.ROOMS and math.abs(lx) <= Castle.ROOM_WIDTH / 2 and lz >= 0 then
		return r, lx, lz
	end
	return nil
end

-- Classement des temps (secondes, plus petit = meilleur) : insère { name, userId, time }, conserve `max` entrées, un seul meilleur temps par joueur.
-- Retourne (nouvelle liste, rang du joueur ou nil s'il n'entre pas).
function Castle.insertScore(list, entry, max)
	local out, existing = {}, nil
	for _, e in ipairs(list) do
		if e.userId == entry.userId then
			existing = e
		else
			out[#out + 1] = e
		end
	end
	if existing and existing.time <= entry.time then
		local same = {}
		for i, e in ipairs(list) do
			same[i] = e
		end
		return same, nil -- son meilleur temps existant est conservé
	end
	out[#out + 1] = entry
	table.sort(out, function(a, b)
		if a.time ~= b.time then
			return a.time < b.time
		end
		return a.userId < b.userId
	end)
	local rank = nil
	for i, e in ipairs(out) do
		if e == entry then
			rank = i
		end
	end
	while #out > max do
		table.remove(out)
	end
	if rank and rank > max then
		rank = nil
	end
	return out, rank
end

-- Durée en « m:ss.d » (arrondie au dixième).
function Castle.formatTime(seconds)
	if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 then
		return "--:--.-"
	end
	local tenths = math.floor(seconds * 10 + 0.5)
	local m = tenths // 600
	local rest = (tenths - m * 600) / 10
	return string.format("%d:%04.1f", m, rest)
end

Castle.REWARD_TIERS = { fast = 5, slow = 4 } -- lot 9 : Légendaire et Épique (indices des 10 raretés)
-- Récompense du coffre final : œuf rare (Épique, Légendaire si temps rapide), pièces proportionnelles aux revenus.
-- fastTime : durée de référence « rapide » (s) pour ce nombre de salles.
function Castle.reward(timeSeconds, income, deaths)
	local fast = 60 * Castle.ROOMS * 0.6 -- 3 min : bon temps
	local tier = (timeSeconds <= fast and (deaths or 0) == 0) and Castle.REWARD_TIERS.fast or Castle.REWARD_TIERS.slow
	local coins = math.floor(math.max(5000, income * 600 * (timeSeconds <= fast and 1.5 or 1)))
	return { eggTier = tier, coins = coins }
end

return Castle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX105"><Properties><string name="Name">Upgrade</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Upgrade
-- Montée de niveau de la maison (REFONTE lot 5, D.4) : LOGIQUE PURE (aucun service Roblox), testée hors de Roblox. Calcule, pour un temps t (secondes),
-- l'état de chaque phase de l'animation ; le client (BaseUpgradeFx) l'applique aux objets. Ne lève jamais d'erreur (valeurs invalides = début).
-- Phases (Config.UPGRADE_FX) : ① échafaudage 0,8 s ② poussière + onde 0,4 s ③ l'ancienne maison s'enfonce, la nouvelle monte (squash & stretch) 1,5 s
-- ④ fête (confettis, bannière) 1,8 s ; total 4,5 s. Utilisation : require(Upgrade).new(Config, Easing).
local Upgrade = {}

function Upgrade.new(Config, Easing)
	local U = {}
	local F = Config.UPGRADE_FX

	local function clamp01(x)
		if type(x) ~= "number" or x ~= x then
			return 0
		end
		return math.min(1, math.max(0, x))
	end

	U.seconds = F.seconds
	U.dustAt = F.scaffold -- début de la poussière
	U.swapAt = F.scaffold + F.dust -- début de l'échange des maisons
	U.partyAt = F.scaffold + F.dust + F.swap -- début de la fête

	-- État au temps t : toutes les valeurs sont dans [0, 1] sauf sx / sy (squash & stretch de la nouvelle maison, > 0).
	--   scaffold : hauteur de l'échafaudage ; strip : retrait de l'échafaudage (pendant la fête) ; dust : poussière (0 -> 1 -> 0) ; wave : onde (0 avant, 1 pendant la poussière)
	--   drop : enfoncement de l'ancienne maison ; rise : montée de la nouvelle ; party : progression de la fête ; done : animation terminée
	function U.state(t)
		t = (type(t) == "number" and t == t) and math.max(t, 0) or 0
		local sc = clamp01(t / F.scaffold)
		local swap = clamp01((t - U.swapAt) / F.swap)
		local sx, sy = 1, 1
		if swap > 0 and swap < 1 then
			sx, sy = Easing.squashStretch(swap, 0.35)
		end
		local dustP = clamp01((t - U.dustAt) / F.dust)
		return {
			t = t,
			scaffold = Easing.outQuad(sc),
			strip = clamp01((t - U.partyAt) / 0.5),
			dust = dustP > 0 and dustP < 1 and math.sin(dustP * math.pi) or 0,
			wave = (t >= U.dustAt and t < U.swapAt) and 1 or 0,
			drop = swap * swap, -- l'ancienne maison accélère en s'enfonçant
			rise = Easing.outBack(swap), -- la nouvelle monte avec un léger dépassement
			sx = sx,
			sy = sy,
			party = clamp01((t - U.partyAt) / F.party),
			done = t >= U.seconds,
		}
	end

	-- Texte de la bannière : « 🏠 Niveau 5 : Maison au garage ! +2 emplacements, revenus +20 % ».
	function U.banner(level)
		return Config.upgradeBanner(level)
	end

	-- La caméra large est-elle permise ? Propriétaire seul, sans œuf porté, pas poursuivi (`chased`), vivant, aucune autre cinématique en cours.
	function U.canFrame(isOwner, carrying, chased, dead, busy)
		return isOwner == true and (carrying or 0) <= 0 and not chased and not dead and not busy
	end

	return U
end

return Upgrade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX106"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Odds   (lot 10, B.1 et B.2)
-- Compteur de rareté « 1 sur N » : module PUR (aucun service Roblox, aucun require). Les tables viennent de la table `Config` PASSÉE en paramètre :
--   Config.SIZES[i].weight, Config.MUTS[i].weight, Config.PETS[i].tier (espèces par rareté), Config.ODDS.REF[r] (poids de référence, en %).
-- Le compteur est la rareté de RÉFÉRENCE d'une combinaison (espèce, taille, mutation) : identique pour tous les joueurs, quel que soit l'œuf ou les
-- bonus utilisés. Aucune fonction d'ici ne reçoit de bonus (chance, trèfle, passe, potion, événement) : un achat ne peut donc pas gonfler le chiffre.
--   p_ref = REF[r]/100 × 1/n_r × SIZES[s].weight/ΣSIZES × MUTS[m].weight/ΣMUTS      N = 1/p_ref, arrondi
-- API (toutes les fonctions renvoient nil / "" / false sur entrée invalide, jamais d'erreur) :
--   Odds.value(Config, r, s, m [, nr])    -> N arrondi (nombre) ou nil. nr = nombre d'espèces de la rareté r (défaut : Odds.speciesCount)
--   Odds.forPet(Config, petIndex, s, m [, nr]) -> idem à partir de l'indice d'espèce de Config.PETS
--   Odds.speciesCount(Config, r)          -> nombre d'espèces publiées de rareté r (pet.published == false ou pet.hidden == true : exclu)
--   Odds.pRef(Config, r, s, m [, nr])     -> probabilité de référence (0..1) ou nil
--   Odds.round(n)                         -> arrondi : entier, sauf N < 10 (une décimale)
--   Odds.short(n) / Odds.label(n)         -> « 38 494 » / « 1 sur 38 494 » (milliers séparés par une espace insécable, « 12,5 M », « 8 Md »)
--   Odds.isSpecial(n [, Config])          -> n >= 10 000 (Config.ODDS.specialMin), seuil des effets spéciaux
--   Odds.level(n [, Config])              -> 0 (rien) .. 5 (voir Odds.LEVELS)
--   Odds.fx(n, r [, Config])              -> { special, level, banner, secretSound, announceServer, announceWorld, pillar, billboard }
--   Odds.countSteps(n [, steps])          -> liste croissante de paliers 1 .. n pour le compteur animé (12 paliers par défaut, dernier = n exact)
--   Odds.validate(Config)                 -> ok, liste de problèmes (tables de poids, REF)
-- Pour la brancher : `local Odds = require(ReplicatedStorage.Odds)` ; serveur à l'éclosion : `slot.o = Odds.forPet(Config, petIdx, s, m)` (une seule fois,
-- jamais recalculé) ; client : `Odds.label(slot.o)`. Pas de += ni de continue (le lanceur lupa du dépôt ne les gère pas dans ReplicatedStorage).
local Odds = {}

Odds.SEP = "\u{00A0}" -- espace insécable : rendue par toutes les polices Roblox (l'espace fine U+202F n'est pas garantie)
Odds.MAX = 9007199254740992 -- 2^53, borne du classement OrderedDataStore
Odds.DEFAULT_SPECIAL = 10000
Odds.DEFAULT_BILLBOARD = 1000
-- Seuils des niveaux d'effet : 1 = spécial (>= 10 000), 2 = bandeau « Tirage exceptionnel » (>= 100 000), 3 = son secret (>= 1 000 000),
-- 4 = >= 100 000 000, 5 = >= 1 000 000 000.
Odds.LEVELS = { 10000, 100000, 1000000, 100000000, 1000000000 }
Odds.BANNER_MIN = 100000
Odds.SECRET_SOUND_MIN = 1000000
Odds.SERVER_ANNOUNCE_N, Odds.SERVER_ANNOUNCE_R = 10000, 7
Odds.WORLD_ANNOUNCE_N, Odds.WORLD_ANNOUNCE_R = 1000000, 8

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Somme des poids d'une liste { {weight = x}, ... } ; nil si la liste est inutilisable.
local function sumWeights(list)
	if type(list) ~= "table" then
		return nil
	end
	local total, count = 0, 0
	for i = 1, #list do
		local e = list[i]
		local w = type(e) == "table" and e.weight or nil
		if isNum(w) and w >= 0 then
			total = total + w
		end
		count = count + 1
	end
	if count == 0 or total <= 0 then
		return nil
	end
	return total
end

local function weightAt(list, i)
	if type(list) ~= "table" or not isNum(i) or i ~= math.floor(i) or i < 1 or i > #list then
		return nil
	end
	local e = list[i]
	local w = type(e) == "table" and e.weight or nil
	if isNum(w) and w > 0 then
		return w
	end
	return nil
end

function Odds.speciesCount(Config, r)
	if type(Config) ~= "table" or type(Config.PETS) ~= "table" or not isNum(r) then
		return 0
	end
	local n = 0
	for i = 1, #Config.PETS do
		local p = Config.PETS[i]
		if type(p) == "table" and p.tier == r and p.published ~= false and p.hidden ~= true then
			n = n + 1
		end
	end
	return n
end

function Odds.pRef(Config, r, s, m, nr)
	local ok, res = pcall(function()
		if type(Config) ~= "table" or not isNum(r) or r ~= math.floor(r) or r < 1 then
			return nil
		end
		local odds = Config.ODDS
		local ref = type(odds) == "table" and type(odds.REF) == "table" and odds.REF[r] or nil
		if not isNum(ref) or ref <= 0 then
			return nil
		end
		local count = nr
		if count == nil then
			count = Odds.speciesCount(Config, r)
		end
		if not isNum(count) or count < 1 then
			return nil
		end
		local sw, mw = weightAt(Config.SIZES, s), weightAt(Config.MUTS, m)
		local sTotal, mTotal = sumWeights(Config.SIZES), sumWeights(Config.MUTS)
		if sw == nil or mw == nil or sTotal == nil or mTotal == nil then
			return nil
		end
		local p = (ref / 100) * (1 / count) * (sw / sTotal) * (mw / mTotal)
		if isNum(p) and p > 0 then
			return p
		end
		return nil
	end)
	if ok then
		return res
	end
	return nil
end

-- Arrondi du compteur : entier, sauf N < 10 (une décimale) ; jamais < 1, jamais > 2^53.
function Odds.round(n)
	if not isNum(n) then
		return nil
	end
	if n < 1 then
		return 1
	end
	if n > Odds.MAX then
		return Odds.MAX
	end
	if n < 9.95 then
		return math.floor(n * 10 + 0.5) / 10
	end
	return math.floor(n + 0.5)
end

function Odds.value(Config, r, s, m, nr)
	local p = Odds.pRef(Config, r, s, m, nr)
	if p == nil then
		return nil
	end
	return Odds.round(1 / p)
end

function Odds.forPet(Config, petIndex, s, m, nr)
	if type(Config) ~= "table" or type(Config.PETS) ~= "table" or not isNum(petIndex) then
		return nil
	end
	local pet = Config.PETS[petIndex]
	if type(pet) ~= "table" then
		return nil
	end
	return Odds.value(Config, pet.tier, s, m, nr)
end

-- Groupe les milliers d'une chaîne de chiffres.
local function group(digits)
	local out, n = "", #digits
	for i = 1, n do
		out = out .. digits:sub(i, i)
		local left = n - i
		if left > 0 and left % 3 == 0 then
			out = out .. Odds.SEP
		end
	end
	return out
end

-- 12.5 -> « 12,5 » ; 8 -> « 8 » (une décimale seulement si elle n'est pas nulle).
local function oneDecimal(v)
	local t = math.floor(v * 10 + 0.5) / 10
	if t == math.floor(t) then
		return group(string.format("%.0f", t))
	end
	return (string.format("%.1f", t):gsub("%.", ","))
end

function Odds.short(n)
	if not isNum(n) or n <= 0 then
		return ""
	end
	n = Odds.round(n)
	if n < 10 then
		return (string.format("%.1f", n):gsub("%.", ","))
	end
	if n < 10000000 then
		return group(string.format("%.0f", n))
	end
	if n < 1000000000 then
		local v = n / 1000000
		if math.floor(v * 10 + 0.5) / 10 < 1000 then
			return oneDecimal(v) .. Odds.SEP .. "M"
		end
	end
	local v = n / 1000000000
	if v < 100 then
		return oneDecimal(v) .. Odds.SEP .. "Md"
	end
	return group(string.format("%.0f", math.floor(v + 0.5))) .. Odds.SEP .. "Md"
end

function Odds.label(n)
	local s = Odds.short(n)
	if s == "" then
		return ""
	end
	return "1 sur " .. s
end

function Odds.isSpecial(n, Config)
	if not isNum(n) then
		return false
	end
	local min = Odds.DEFAULT_SPECIAL
	if type(Config) == "table" and type(Config.ODDS) == "table" and isNum(Config.ODDS.specialMin) and Config.ODDS.specialMin > 0 then
		min = Config.ODDS.specialMin
	end
	return n >= min
end

function Odds.level(n, Config)
	if not isNum(n) then
		return 0
	end
	if not Odds.isSpecial(n, Config) then
		return 0
	end
	local lvl = 1
	for i = 2, #Odds.LEVELS do
		if n >= Odds.LEVELS[i] then
			lvl = i
		end
	end
	return lvl
end

-- Effets et annonces liés à un tirage (B.1 et B.2). r = rareté de l'espèce (peut être nil).
function Odds.fx(n, r, Config)
	local num = isNum(n) and n or 0
	local rr = isNum(r) and r or 0
	local billboardMin = Odds.DEFAULT_BILLBOARD
	if type(Config) == "table" and type(Config.ODDS) == "table" and isNum(Config.ODDS.billboardMin) and Config.ODDS.billboardMin > 0 then
		billboardMin = Config.ODDS.billboardMin
	end
	return {
		special = Odds.isSpecial(num, Config),
		level = Odds.level(num, Config),
		banner = num >= Odds.BANNER_MIN,
		secretSound = num >= Odds.SECRET_SOUND_MIN,
		announceServer = num >= Odds.SERVER_ANNOUNCE_N or rr >= Odds.SERVER_ANNOUNCE_R,
		announceWorld = num >= Odds.WORLD_ANNOUNCE_N or rr >= Odds.WORLD_ANNOUNCE_R,
		pillar = rr >= 10,
		billboard = num >= billboardMin,
	}
end

-- Paliers du compteur animé : de 1 à N, ralentissement final (ease out cubique), croissants, le dernier est N exact.
function Odds.countSteps(n, steps)
	local count = 12
	if isNum(steps) then
		count = math.max(1, math.min(60, math.floor(steps)))
	end
	local target = Odds.round(isNum(n) and n or 1) or 1
	local out = {}
	local prev = 1
	for i = 1, count do
		local t = i / count
		local v = 1 + (target - 1) * (1 - (1 - t) ^ 3)
		if target >= 10 then
			v = math.floor(v + 0.5)
		else
			v = math.floor(v * 10 + 0.5) / 10
		end
		if v < prev then
			v = prev
		end
		if i == count then
			v = target
		end
		out[i] = v
		prev = v
	end
	return out
end

-- Vérifie les tables lues dans Config : sommes de poids, REF, espèces par rareté.
function Odds.validate(Config)
	local problems = {}
	if type(Config) ~= "table" then
		return false, { "Config absente" }
	end
	local sTotal, mTotal = sumWeights(Config.SIZES), sumWeights(Config.MUTS)
	if sTotal == nil then
		problems[#problems + 1] = "Config.SIZES inutilisable"
	elseif math.abs(sTotal - 100) > 1e-6 then
		problems[#problems + 1] = "somme des tailles = " .. tostring(sTotal) .. " (attendu 100)"
	end
	if mTotal == nil then
		problems[#problems + 1] = "Config.MUTS inutilisable"
	elseif math.abs(mTotal - 100) > 1e-6 then
		problems[#problems + 1] = "somme des mutations = " .. tostring(mTotal) .. " (attendu 100)"
	end
	local odds = Config.ODDS
	if type(odds) ~= "table" or type(odds.REF) ~= "table" then
		problems[#problems + 1] = "Config.ODDS.REF absente"
	else
		for r = 1, #odds.REF do
			if not isNum(odds.REF[r]) or odds.REF[r] <= 0 then
				problems[#problems + 1] = "REF[" .. r .. "] invalide"
			end
			if Odds.speciesCount(Config, r) < 1 then
				problems[#problems + 1] = "aucune espèce publiée de rareté " .. r
			end
		end
	end
	return #problems == 0, problems
end

return Odds
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX107"><Properties><string name="Name">HatchPlan</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/HatchPlan   (lot 10, B.3)
-- PLAN PUR des 10 animations d'éclosion (une par rareté) : aucune dépendance, aucun service Roblox, déterministe (mêmes entrées -> même plan), jamais d'erreur.
-- Remplace `CinematicKit.hatchPlan` pour le nouvel écran d'éclosion (HatchFx exécute le plan). Le plan est une liste de « prises » (beats) :
--   { t = début (s), d = durée (s), kind = "...", n = nombre d'objets d'effet créés (0 si aucun), color = "main"|"second"|"white"|"black"|"gold"|"red"|"rainbow", ... }
-- Types de prises : shake (l'œuf tremble), pop (l'œuf disparaît), burst (n éclats), rays (n rayons), ring (anneaux, mode "converge"|"expand"|"ground"|"rise"),
-- flash (plein écran), shakeScreen, text (glyphe ou libellé : couronne, « ??? »), banner (bandeau de rareté), zoom (champ de vision), tint (teinte / désaturation
-- de l'image 3D), black (écran noir), slot (mini machine à sous rareté/taille/mutation), crystals, frost, cracks, chains, runes, smoke, stars, wings, pillar, split.
-- Plan complet : { r, duration, skipAfter, noSkip, camera, reduced, sound = {key, fanfare}, revealAt, beats, counter = {t, d, steps, from, to} | nil, special, exceptional,
--   secretSound, objects (somme des n, <= 30), particles (objets hors bandeau/texte/ailes/pilier ; <= 50 % en version réduite), peakRate (objets/s au pic, <= 40), seed }.
-- DÉCISIONS : durée de r10 ramenée de 9,0 s (spec B.3) à 8,0 s (plafond demandé) ; chaque n est ensuite ajusté pour tenir 30 objets et 40 objets/s ;
-- la version réduite (mobile) divise chaque n de particule par deux (arrondi bas) donc <= 50 % ; bandeau, texte, ailes et pilier restent ; zoom retiré si la caméra ne doit pas bouger (œuf porté, poursuite).
-- Brancher : `local plan = HatchPlan.plan(slot.r, slot.o, { reduced = isMobile, firstTime = firstTimeForThisRarity, still = carryingEgg })` puis HatchFx.play(gui, plan, opts).
-- Pas de += ni de continue (lanceur lupa).
local HatchPlan = {}

HatchPlan.MAX_DURATION = 8
HatchPlan.MAX_OBJECTS = 30
HatchPlan.MAX_RATE = 40
HatchPlan.SKIP_AFTER = 1.5
HatchPlan.COUNTER_SECONDS = 0.8
HatchPlan.COUNTER_STEPS = 12
-- Durées par rareté (B.3 ; r10 plafonnée à 8 s).
HatchPlan.DURATIONS = { 1.2, 1.5, 2.0, 2.8, 4.0, 5.0, 6.0, 7.0, 6.5, 8.0 }
local EXCEPTIONAL_MIN = 100000
local SECRET_SOUND_MIN = 1000000
local SPECIAL_MIN = 10000

-- Prises qui ne sont pas des particules : toujours conservées telles quelles en version réduite (bandeau, texte, anneau unique, ailes, pilier, éclat plein écran).
local FIXED_KINDS = { banner = true, text = true, wings = true, pillar = true }

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Clé de son (reprend Config.hatchSoundKey du lot 9 : r1-2 hatch, r3 rare, r4 epic, r5-6 legendary, r7-10 hatchSecret ; fanfare dès r8).
function HatchPlan.soundKey(r)
	local rr = isNum(r) and math.floor(r) or 1
	local key = "hatch"
	if rr >= 7 then
		key = "hatchSecret"
	elseif rr >= 5 then
		key = "legendary"
	elseif rr == 4 then
		key = "epic"
	elseif rr == 3 then
		key = "rare"
	end
	return { key = key, fanfare = rr >= 8, divine = rr >= 10 }
end

local function beat(t, d, kind, n, extra)
	local b = { t = t, d = d, kind = kind, n = n or 0 }
	if extra then
		for k, v in pairs(extra) do
			b[k] = v
		end
	end
	return b
end

-- Nombre de runes du cercle runique pour r >= 5 (B.3) : min(12, 4 + (r-4) x 2).
function HatchPlan.runes(r)
	return math.min(12, 4 + (r - 4) * 2)
end

-- Séquences de base (version complète, avant ajustement des plafonds). rv = instant de la révélation.
local function build(r)
	local B = {}
	local rv
	if r == 1 then
		rv = 0.5
		B = {
			beat(0, 0.4, "shake", 0, { amp = 3 }),
			beat(0.4, 0.1, "pop", 0),
			beat(0.4, 0.15, "flash", 0, { color = "white", a = 0.7 }),
			beat(0.4, 0.5, "rays", 6, { color = "white", len = 120 }),
		}
	elseif r == 2 then
		rv = 0.55
		B = {
			beat(0, 0.5, "shake", 0, { amp = 4 }),
			beat(0.5, 0.1, "pop", 0),
			beat(0.5, 0.7, "burst", 12, { color = "main", glyph = "cube", dist = 150, arc = "crown" }),
			beat(0.7, 0.7, "burst", 6, { color = "second", glyph = "petal", dist = 110, arc = "fall" }),
		}
	elseif r == 3 then
		rv = 1.05
		B = {
			beat(0, 1.0, "ring", 1, { color = "main", mode = "converge", ease = "in" }),
			beat(0.2, 0.8, "shake", 0, { amp = 5, grow = true }),
			beat(1.0, 0.15, "flash", 0, { color = "main", a = 0.6 }),
			beat(1.0, 0.1, "pop", 0),
			beat(1.0, 0.8, "ring", 2, { color = "main", mode = "ground" }),
		}
	elseif r == 4 then
		rv = 2.1
		B = {
			beat(0, 0.8, "crystals", 6, { color = "main", from = "ground" }),
			beat(0.8, 0.25, "shakeScreen", 0, { amp = 6 }),
			beat(0.9, 1.2, "slot", 4, { color = "main" }),
			beat(2.0, 0.1, "pop", 0),
			beat(2.1, 0.7, "banner", 1, { color = "main" }),
		}
	elseif r == 5 then
		rv = 2.1
		B = {
			beat(0, 1.4, "text", 1, { glyph = "crown", color = "gold", fall = true }),
			beat(0.6, 1.4, "shake", 0, { amp = 6, grow = true }),
			beat(0.8, 1.2, "runes", HatchPlan.runes(5), { color = "gold" }),
			beat(1.4, 2.4, "zoom", 0, { k = 1.15 }),
			beat(2.0, 0.2, "flash", 0, { color = "gold", a = 0.8 }),
			beat(2.0, 0.1, "pop", 0),
			beat(2.0, 0.5, "split", 2, { color = "gold" }),
			beat(2.0, 1.0, "rays", 12, { color = "gold", len = 220 }),
			beat(2.2, 1.8, "banner", 1, { color = "gold" }),
		}
	elseif r == 6 then
		rv = 2.6
		B = {
			beat(0.3, 2.1, "chains", 6, { color = "second", breakAt = 2.1 }),
			beat(0.4, 1.6, "cracks", 4, { color = "red" }),
			beat(0.5, 1.8, "shake", 0, { amp = 8, grow = true }),
			beat(2.0, 0.6, "tint", 0, { color = "red", a = 0.5 }),
			beat(2.4, 0.6, "shakeScreen", 0, { amp = 10 }),
			beat(2.4, 0.1, "pop", 0),
			beat(2.4, 1.0, "runes", HatchPlan.runes(6), { color = "red" }),
			beat(2.7, 2.0, "banner", 1, { color = "red" }),
		}
	elseif r == 7 then
		rv = 3.2
		B = {
			beat(0, 1.5, "crystals", 6, { color = "main", from = "around" }),
			beat(0.8, 1.6, "frost", 3, { color = "white" }),
			beat(1.5, 1.4, "shake", 0, { amp = 7, grow = true }),
			beat(3.0, 0.15, "flash", 0, { color = "main", a = 0.8 }),
			beat(3.0, 0.1, "pop", 0),
			beat(3.0, 0.8, "burst", 8, { color = "main", glyph = "shard", dist = 190, arc = "ball" }),
			beat(3.0, 1.5, "runes", HatchPlan.runes(7), { color = "main" }),
			beat(3.3, 2.4, "banner", 1, { color = "main" }),
		}
	elseif r == 8 then
		rv = 2.9
		B = {
			beat(0, 2.5, "black", 0, { a = 1, fadeOut = true }),
			beat(0.5, 2.0, "text", 1, { glyph = "???", color = "white" }),
			beat(2.5, 0.9, "ring", 1, { color = "rainbow", mode = "expand" }),
			beat(2.8, 0.9, "ring", 1, { color = "rainbow", mode = "expand" }),
			beat(2.5, 1.0, "stars", 8, { color = "rainbow" }),
			beat(2.5, 0.15, "flash", 0, { color = "white", a = 0.9 }),
			beat(2.5, 0.1, "pop", 0),
			beat(2.6, 1.2, "runes", HatchPlan.runes(8), { color = "rainbow" }),
			beat(3.0, 3.2, "banner", 1, { color = "rainbow" }),
		}
	elseif r == 9 then
		rv = 2.8
		B = {
			beat(0, 0.8, "tint", 0, { sat = -1, hold = true, a = 0 }),
			beat(0.5, 2.0, "text", 1, { glyph = "crown", color = "black" }),
			beat(2.5, 0.8, "burst", 6, { color = "black", glyph = "shard", dist = 160, arc = "ball" }),
			beat(2.5, 2.0, "smoke", 5, { color = "second" }),
			beat(2.5, 0.4, "shakeScreen", 0, { amp = 8 }),
			beat(2.5, 0.1, "pop", 0),
			beat(2.6, 1.2, "runes", HatchPlan.runes(9), { color = "white" }),
			beat(2.9, 2.2, "banner", 1, { color = "white" }),
		}
	else
		rv = 3.3
		B = {
			beat(0, 1.8, "wings", 2, { color = "main" }),
			beat(1.0, 1.5, "ring", 1, { color = "gold", mode = "rise" }),
			beat(1.4, 6.0, "pillar", 1, { color = "main" }),
			beat(2.4, 3.0, "zoom", 0, { k = 1.1 }),
			beat(3.0, 0.2, "flash", 0, { color = "white", a = 0.9 }),
			beat(3.0, 0.1, "pop", 0),
			beat(3.0, 2.0, "rays", 16, { color = "main", len = 260 }),
			beat(3.0, 2.0, "runes", HatchPlan.runes(10), { color = "gold" }),
			beat(3.4, 4.0, "banner", 1, { color = "main" }),
		}
	end
	return B, rv
end

-- Somme des objets et pic de débit (objets/s, estimé sur une grille de 0,05 s) d'une liste de prises.
local function measure(beats, duration)
	local total = 0
	for i = 1, #beats do
		total = total + beats[i].n
	end
	local peak = 0
	local t = 0
	while t <= duration do
		local rate = 0
		for i = 1, #beats do
			local b = beats[i]
			if b.n > 0 and t >= b.t and t < b.t + math.max(b.d, 0.4) then
				rate = rate + b.n / math.max(b.d, 0.4)
			end
		end
		if rate > peak then
			peak = rate
		end
		t = t + 0.05
	end
	return total, peak
end

-- Réduit les plus gros n (un cran à la fois, ordre stable) jusqu'à respecter les plafonds d'objets et de débit. Les prises à 1 objet ne sont jamais supprimées.
local function fit(beats, duration, maxObjects)
	local guard = 0
	while guard < 400 do
		guard = guard + 1
		local total, peak = measure(beats, duration)
		if total <= maxObjects and peak <= HatchPlan.MAX_RATE then
			return
		end
		local bestI, bestN = nil, 1
		for i = 1, #beats do
			if beats[i].n > bestN and not FIXED_KINDS[beats[i].kind] then
				bestI, bestN = i, beats[i].n
			end
		end
		if bestI == nil then
			return
		end
		beats[bestI].n = beats[bestI].n - math.max(1, math.floor(bestN * 0.15))
	end
end

-- Plan d'éclosion. r : rareté (1..10, borné), N : compteur « 1 sur N » (nombre, sinon ignoré).
-- opts : reduced (version mobile), firstTime (première fois qu'une rareté >= 8 est obtenue : non passable), still (la caméra ne bouge pas).
function HatchPlan.plan(r, N, opts)
	local o = type(opts) == "table" and opts or {}
	local rr = 1
	if isNum(r) then
		rr = math.max(1, math.min(10, math.floor(r)))
	end
	local duration = HatchPlan.DURATIONS[rr]
	local beats, revealAt = build(rr)
	if o.still == true then
		local kept = {}
		for i = 1, #beats do
			if beats[i].kind ~= "zoom" then
				kept[#kept + 1] = beats[i]
			end
		end
		beats = kept
	end
	local num = nil
	if isNum(N) and N >= 1 then
		num = math.min(N, 9007199254740992)
	end
	local exceptional = num ~= nil and num >= EXCEPTIONAL_MIN
	if exceptional then
		beats[#beats + 1] = beat(revealAt + 0.2, math.min(1.6, duration - revealAt - 0.2), "text", 1, { glyph = "exceptional", color = "gold", y = "low" })
	end
	-- plafonds d'objets et de débit sur la version complète, puis réduction mobile (moitié, arrondi bas)
	fit(beats, duration, HatchPlan.MAX_OBJECTS)
	local reduced = o.reduced == true
	if reduced then
		for i = 1, #beats do
			if not FIXED_KINDS[beats[i].kind] then
				beats[i].n = math.floor(beats[i].n / 2)
			end
		end
	end
	table.sort(beats, function(a, b)
		if a.t ~= b.t then
			return a.t < b.t
		end
		return a.kind < b.kind
	end)
	local objects, peak = measure(beats, duration)
	local particles = 0
	for i = 1, #beats do
		if not FIXED_KINDS[beats[i].kind] then
			particles = particles + beats[i].n
		end
	end
	local counter = nil
	if num ~= nil then
		local cd = math.min(HatchPlan.COUNTER_SECONDS, duration - revealAt)
		counter = { t = revealAt, d = math.max(0.25, cd), steps = HatchPlan.COUNTER_STEPS, from = 1, to = num }
	end
	return {
		r = rr,
		duration = duration,
		skipAfter = HatchPlan.SKIP_AFTER,
		noSkip = o.firstTime == true and rr >= 8,
		camera = o.still ~= true,
		reduced = reduced,
		sound = HatchPlan.soundKey(rr),
		revealAt = revealAt,
		beats = beats,
		counter = counter,
		special = num ~= nil and num >= SPECIAL_MIN,
		exceptional = exceptional,
		secretSound = num ~= nil and num >= SECRET_SOUND_MIN,
		objects = objects,
		particles = particles,
		peakRate = peak,
		seed = (rr * 7919 + (num and math.floor(num) % 100003 or 0)) % 2147483647,
	}
end

-- Contrôle de cohérence d'un plan (utilisé par les tests et par HatchFx avant exécution) : retourne ok, raison.
function HatchPlan.check(plan)
	if type(plan) ~= "table" or type(plan.beats) ~= "table" or not isNum(plan.duration) then
		return false, "plan invalide"
	end
	if plan.duration <= 0 or plan.duration > HatchPlan.MAX_DURATION then
		return false, "durée hors bornes"
	end
	for i = 1, #plan.beats do
		local b = plan.beats[i]
		if type(b) ~= "table" or type(b.kind) ~= "string" or not isNum(b.t) or not isNum(b.d) or not isNum(b.n) then
			return false, "prise " .. i .. " invalide"
		end
		if b.t < 0 or b.d < 0 or b.t + b.d > plan.duration + 1e-9 or b.n < 0 then
			return false, "prise " .. i .. " hors de la durée"
		end
	end
	return true, ""
end

return HatchPlan
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX108"><Properties><string name="Name">IntroPlan</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/IntroPlan   (lot 10, B.4)
-- PLAN PUR de l'intro de combat (aucun service Roblox, aucun require, déterministe, jamais d'erreur) : deux bandeaux (joueur à gauche, adversaire à droite) avec
-- nom, ligue, trophées, ratio « 124 V / 37 D (77 %) » et 3 vignettes de pets (type + compteur de rareté), « VS » qui frappe, flèche d'avantage de type, décompte 3-2-1.
-- DÉCISION : durée totale 3,0 s au maximum (la spec disait 3,5 s ; plafond demandé 3 s) ; passable après 1,0 s ; sans décompte l'intro dure 2,2 s.
-- Entrée : IntroPlan.plan(info, opts)
--   info = { mode = "pvp"|"duel"|"pve"|"npc"|"tower", countdown = bool (décompte 3-2-1 si le temps de tour n'a pas démarré), advantage = nombre (multiplicateur du pet actif du joueur
--            contre le pet actif de l'adversaire, 1,5 / 1,25 / 1 / 0,8 / 0,67),
--            me = { name, userId, wins, losses, league, trophies, pets = { { type = "Feu", odds = 38494, tier = 5 }, ... } },
--            foe = { même forme ; name peut être un PNJ avec wins/losses fictifs } }
--   opts = { fmtOdds = function(n) -> texte (défaut : Odds.label, injecté par l'appelant ; sinon « 1 sur N » simple) }
-- Sortie : { duration, skipAfter, countdown, mode, left = side, right = side, vs = {t, d, ...}, arrow = {...} | nil, count = {{t, text}...}, beats }
--   side = { name, record = "124 V / 37 D (77 %)", wins, losses, percent, league, trophies, userId, pets = { {type, odds, oddsText, tier} (3 au plus) } }
-- Brancher : `BattleIntro.play(gui, IntroPlan.plan(info, { fmtOdds = Odds.label }), { onDone = startBattle })`.
-- Pas de += ni de continue (lanceur lupa).
local IntroPlan = {}

IntroPlan.MAX_DURATION = 3
IntroPlan.SKIP_AFTER = 1
IntroPlan.SLIDE = 0.4
IntroPlan.MAX_PETS = 3
IntroPlan.CAP = 999999999

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function count(v)
	if not isNum(v) or v < 0 then
		return 0
	end
	return math.min(IntroPlan.CAP, math.floor(v))
end

-- Pourcentage de victoires : floor(100 x V / max(1, V + D) + 0,5).
function IntroPlan.percent(wins, losses)
	local w, l = count(wins), count(losses)
	return math.floor(100 * w / math.max(1, w + l) + 0.5)
end

-- « 124 V / 37 D (77 %) »
function IntroPlan.record(wins, losses)
	local w, l = count(wins), count(losses)
	return w .. " V / " .. l .. " D (" .. IntroPlan.percent(w, l) .. " %)"
end

-- Multiplicateur en français : 1,5 -> « 1,5 » ; 1,25 -> « 1,25 » ; 0,67 -> « 0,67 » ; 0,8 -> « 0,8 ».
function IntroPlan.fmtMult(m)
	if not isNum(m) or m <= 0 then
		return "1"
	end
	local s = string.format("%.2f", m)
	s = s:gsub("0+$", ""):gsub("%.$", "")
	return (s:gsub("%.", ","))
end

local function cleanText(v, fallback, maxLen)
	if type(v) ~= "string" or v == "" then
		return fallback
	end
	return v:sub(1, maxLen or 24)
end

local function simpleOdds(n)
	if not isNum(n) or n < 1 then
		return ""
	end
	return "1 sur " .. string.format("%.0f", math.floor(n + 0.5))
end

local function side(raw, fmt)
	local t = type(raw) == "table" and raw or {}
	local w, l = count(t.wins), count(t.losses)
	local pets = {}
	local src = type(t.pets) == "table" and t.pets or {}
	for i = 1, math.min(IntroPlan.MAX_PETS, #src) do
		local p = type(src[i]) == "table" and src[i] or {}
		local odds = isNum(p.odds) and p.odds > 0 and p.odds or nil
		local text = ""
		if odds then
			local ok, res = pcall(fmt, odds)
			text = ok and type(res) == "string" and res or simpleOdds(odds)
		end
		pets[i] = { type = cleanText(p.type, "", 16), odds = odds, oddsText = text, tier = isNum(p.tier) and math.max(1, math.min(10, math.floor(p.tier))) or 1 }
	end
	return {
		name = cleanText(t.name, "???", 20),
		userId = isNum(t.userId) and math.floor(t.userId) or 0,
		wins = w,
		losses = l,
		percent = IntroPlan.percent(w, l),
		record = IntroPlan.record(w, l),
		league = cleanText(t.league, "", 16),
		trophies = count(t.trophies),
		pets = pets,
	}
end

function IntroPlan.plan(info, opts)
	local inf = type(info) == "table" and info or {}
	local fmt = type(opts) == "table" and type(opts.fmtOdds) == "function" and opts.fmtOdds or simpleOdds
	local countdown = inf.countdown == true
	local duration = countdown and 3.0 or 2.2
	local S = IntroPlan.SLIDE
	local mult = isNum(inf.advantage) and inf.advantage or 1
	local arrow = nil
	if mult > 1.0001 or mult < 0.9999 then
		arrow = { t = 1.0, d = 1.0, mult = mult, text = (mult > 1 and "Avantage ×" or "Désavantage ×") .. IntroPlan.fmtMult(mult), good = mult > 1, side = "left" }
	end
	local counts = {}
	local beats = {
		{ t = 0, d = S, kind = "slide", side = "left" },
		{ t = 0, d = S, kind = "slide", side = "right" },
		{ t = S, d = 0.4, kind = "pets" },
		{ t = 0.5, d = 0.3, kind = "vs", from = 2, to = 1, shake = 0.3, volume = 0.5, sound = "fanfare" },
	}
	if arrow then
		beats[#beats + 1] = { t = arrow.t, d = arrow.d, kind = "arrow" }
	end
	if countdown then
		for i = 1, 3 do
			local t = 1.6 + (i - 1) * 0.4
			counts[i] = { t = t, text = tostring(4 - i) }
			beats[#beats + 1] = { t = t, d = 0.4, kind = "count", text = tostring(4 - i) }
		end
	end
	beats[#beats + 1] = { t = duration - 0.2, d = 0.2, kind = "exit" }
	return {
		duration = duration,
		skipAfter = IntroPlan.SKIP_AFTER,
		countdown = countdown,
		mode = type(inf.mode) == "string" and inf.mode:sub(1, 12) or "pve",
		left = side(inf.me, fmt),
		right = side(inf.foe, fmt),
		vs = beats[4],
		arrow = arrow,
		count = counts,
		beats = beats,
	}
end

-- Contrôle de cohérence (tests, BattleIntro).
function IntroPlan.check(plan)
	if type(plan) ~= "table" or type(plan.beats) ~= "table" or not isNum(plan.duration) then
		return false, "plan invalide"
	end
	if plan.duration <= 0 or plan.duration > IntroPlan.MAX_DURATION then
		return false, "durée hors bornes"
	end
	for i = 1, #plan.beats do
		local b = plan.beats[i]
		if type(b) ~= "table" or not isNum(b.t) or not isNum(b.d) or b.t < 0 or b.d < 0 or b.t + b.d > plan.duration + 1e-9 then
			return false, "prise " .. i .. " hors de la durée"
		end
	end
	return true, ""
end

return IntroPlan
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX109"><Properties><string name="Name">TypeFx</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/TypeFx   (lot 10, B.6)
-- DONNÉES PURES des effets d'attaque par type (9 types de la matrice D.2) : couleur, attaque de base (0,5 s) et spécial (1,2 s). Aucune dépendance.
-- Sera exposé plus tard comme `Config.TYPE_FX = TypeFx.DATA` ; le client StarterPlayerScripts/TypeFx.lua lit ces données (passées en paramètre, pas de require).
-- Forme : DATA[type] = { hex = "FF6A1A", rgb = {r, g, b}, basic = Effet, special = Effet }
--   Effet = { d = durée (s), shake = secousse de l'écran (s) | nil, linger = durée de persistance au sol (s) | nil, layers = { Couche, ... } }
--   Couche = { prim = "shoot"|"burst"|"bolt"|"column"|"ring"|"cone"|"flash"|"runes"|"decal"|"spiral"|"chainring"|"beam", n = nombre d'objets créés (>= 1),
--              t = début (s), d = durée (s), glyph = texte | nil, size = taille px | nil, color = "main"|"white"|"dark" | nil, ... }
-- Coût d'un effet = 1 (conteneur) + somme des n (TypeFx.cost) ; plafonds : base <= 14, spécial <= 30 (vérifiés par les tests).
-- Noms de types : ceux de D.2 (Feu, Eau, Plante, Glace, Foudre, Terre, Ciel, Ombre, Lumière) ; l'ancien nom « Nature » est un alias de « Plante » (TypeFx.get).
-- Pas de += ni de continue (lanceur lupa).
local TypeFx = {}

TypeFx.TYPES = { "Feu", "Eau", "Plante", "Glace", "Foudre", "Terre", "Ciel", "Ombre", "Lumière" }
TypeFx.ALIASES = { Nature = "Plante" }
TypeFx.BASIC_MAX, TypeFx.SPECIAL_MAX = 14, 30
TypeFx.BASIC_SECONDS, TypeFx.SPECIAL_SECONDS = 0.5, 1.2

local function rgb(hex)
	return { tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16) }
end

local function L(prim, n, t, d, extra)
	local l = { prim = prim, n = n, t = t, d = d }
	if extra then
		for k, v in pairs(extra) do
			l[k] = v
		end
	end
	return l
end

local function def(hex, basic, special)
	return { hex = hex, rgb = rgb(hex), basic = basic, special = special }
end

TypeFx.DATA = {
	Feu = def("FF6A1A",
		{ d = 0.5, layers = { L("shoot", 1, 0, 0.35, { glyph = "●", size = 28 }), L("burst", 5, 0.3, 0.2, { glyph = "✦", dist = 40 }) } },
		{ d = 1.2, shake = 0.4, linger = 2, layers = { L("runes", 6, 0, 1.2), L("cone", 10, 0.1, 0.8, { glyph = "●", size = 26 }), L("decal", 1, 0.6, 0.6, { color = "dark" }), L("burst", 6, 0.6, 0.5, { glyph = "✦", dist = 70 }) } }),
	Eau = def("3C96DC",
		{ d = 0.5, layers = { L("shoot", 4, 0, 0.35, { glyph = "💧", size = 20 }), L("burst", 4, 0.3, 0.2, { glyph = "•", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("ring", 3, 0.2, 0.9), L("burst", 8, 0.5, 0.6, { glyph = "💧", dist = 80 }) } }),
	Plante = def("5CB256",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.4, { glyph = "🍃", size = 24, spin = true }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("column", 6, 0.2, 0.7, { glyph = "vine", size = 18 }), L("burst", 4, 0.8, 0.3, { glyph = "🍃", dist = 50 }) } }),
	Glace = def("BFEFFF",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.35, { glyph = "❄", size = 24, spin = true }), L("burst", 4, 0.3, 0.2, { glyph = "✧", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, linger = 2, layers = { L("runes", 6, 0, 1.2), L("column", 6, 0.2, 0.6, { glyph = "spike", size = 20 }), L("decal", 1, 0.6, 0.5, { color = "white" }), L("burst", 6, 0.7, 0.4, { glyph = "❄", dist = 70 }) } }),
	Foudre = def("FFE14A",
		{ d = 0.5, layers = { L("bolt", 6, 0, 0.3), L("flash", 1, 0.3, 0.1, { alpha = 0.3 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("bolt", 6, 0.2, 0.4), L("bolt", 6, 0.55, 0.4), L("flash", 1, 0.9, 0.1, { alpha = 0.6 }) } }),
	Terre = def("9C6B45",
		{ d = 0.5, layers = { L("column", 4, 0, 0.4, { glyph = "rock", size = 26 }), L("burst", 4, 0.3, 0.2, { glyph = "•", dist = 34 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("ring", 2, 0.2, 0.9), L("bolt", 4, 0.3, 0.5, { color = "dark" }), L("burst", 8, 0.5, 0.6, { glyph = "•", dist = 80 }) } }),
	Ciel = def("DDEBFF",
		{ d = 0.5, layers = { L("shoot", 5, 0, 0.4, { glyph = "✧", size = 22, spin = true }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("spiral", 10, 0.2, 1.0, { glyph = "☁", size = 24 }), L("burst", 4, 0.9, 0.3, { glyph = "✧", dist = 60 }) } }),
	Ombre = def("8A3CFF",
		{ d = 0.5, layers = { L("shoot", 3, 0, 0.4, { glyph = "●", size = 24 }), L("burst", 4, 0.3, 0.2, { glyph = "☁", dist = 40 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 6, 0, 1.2), L("chainring", 6, 0.2, 0.9), L("burst", 6, 0.7, 0.5, { glyph = "☁", dist = 70 }) } }),
	["Lumière"] = def("FFE680",
		{ d = 0.5, layers = { L("beam", 1, 0, 0.4), L("burst", 3, 0.3, 0.2, { glyph = "✦", dist = 36 }) } },
		{ d = 1.2, shake = 0.4, layers = { L("runes", 8, 0, 1.2), L("column", 1, 0.2, 0.9, { glyph = "pillar", size = 70 }), L("flash", 1, 0.3, 0.15, { alpha = 0.5 }), L("burst", 6, 0.6, 0.5, { glyph = "✦", dist = 70 }) } }),
}

-- Nom canonique d'un type (alias « Nature » -> « Plante »), ou nil.
function TypeFx.canonical(name)
	if type(name) ~= "string" then
		return nil
	end
	local n = TypeFx.ALIASES[name] or name
	if TypeFx.DATA[n] then
		return n
	end
	return nil
end

function TypeFx.get(name)
	local n = TypeFx.canonical(name)
	return n and TypeFx.DATA[n] or nil
end

-- Coût (objets créés, conteneur compris) d'un effet ; reduced : moitié des objets de chaque couche (arrondi bas, au moins 1).
function TypeFx.cost(name, special, reduced)
	local def = TypeFx.get(name)
	if def == nil then
		return 0
	end
	local fx = special and def.special or def.basic
	local total = 1
	for i = 1, #fx.layers do
		local n = fx.layers[i].n
		if reduced then
			n = math.max(1, math.floor(n / 2))
		end
		total = total + n
	end
	return total
end

-- Texte d'efficacité flottant (B.6) pour un multiplicateur de type : texte, couleur RGB ; nil si neutre (x1) ou invalide.
TypeFx.EFFICACY = {
	{ min = 1.5, text = "Super efficace !", rgb = { 70, 220, 90 } },
	{ min = 1.2, text = "Efficace", rgb = { 150, 230, 120 } },
	{ max = 0.7, text = "Pas très efficace…", rgb = { 230, 70, 70 } },
	{ max = 0.95, text = "Peu efficace", rgb = { 255, 160, 50 } },
}

function TypeFx.efficacy(mult)
	if type(mult) ~= "number" or mult ~= mult or mult <= 0 then
		return nil
	end
	for i = 1, #TypeFx.EFFICACY do
		local e = TypeFx.EFFICACY[i]
		if (e.min ~= nil and mult >= e.min - 1e-9) or (e.max ~= nil and mult <= e.max + 1e-9) then
			return e.text, e.rgb
		end
	end
	return nil
end

return TypeFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX110"><Properties><string name="Name">Calendar</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Calendar
-- LOT 9b : règles PURES du calendrier des œufs sur 30 jours (aucun service Roblox, testées une par une). Le serveur fournit le jour UTC et décide ; le client ne reçoit
-- que `Calendar.view` (affichage). Style : pas de `+=`, pas de `continue`, valeurs d'origine incertaine gardées par type avant toute comparaison numérique.
-- État d'un profil (`cal`) : start = jour UTC du jour 1 du cycle (0 = pas démarré), cycle = numéro du cycle, days = 30 caractères « 0 » / « 1 » (jour réclamé),
-- grace = jours de grâce utilisés ce cycle, catch = jetons de rattrapage payants, qc = missions réclamées comptées pour un rattrapage,
-- dayD / dayN = jour UTC et nombre de réclamations déjà faites ce jour-là (plafond Config.CALENDAR.dayCap).
local Calendar = {}

local function int(v, lo, hi, def)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end
Calendar.int = int

local function zeros(Config)
	return string.rep("0", Config.CALENDAR.days)
end

function Calendar.newState(Config)
	return { start = 0, cycle = 0, days = zeros(Config), grace = 0, catch = 0, qc = 0, dayD = 0, dayN = 0 }
end

-- Assainit un `cal` lu du profil (champ facultatif : absent, corrompu ou d'une autre forme = état neuf). Ne garde que des entiers bornés.
function Calendar.sanitize(Config, saved)
	local C = Config.CALENDAR
	local cal = Calendar.newState(Config)
	if type(saved) ~= "table" then
		return cal
	end
	cal.start = int(saved.start, 0, 1e6, 0)
	cal.cycle = int(saved.cycle, 0, 1e4, 0)
	if cal.start > 0 and cal.cycle < 1 then
		cal.cycle = 1
	end
	if type(saved.days) == "string" and #saved.days == C.days and not string.find(saved.days, "[^01]") then
		cal.days = saved.days
	end
	cal.grace = int(saved.grace, 0, C.days, 0)
	cal.catch = int(saved.catch, 0, C.catchupMax, 0)
	cal.qc = int(saved.qc, 0, C.catchupQuests * 2, 0)
	cal.dayD = int(saved.dayD, 0, 1e6, 0)
	cal.dayN = int(saved.dayN, 0, C.dayCap, 0)
	return cal
end

function Calendar.claimedCount(cal)
	local _, n = string.gsub(cal.days, "1", "")
	return n
end

-- Jour du cycle (1 à 30 pendant le cycle ; 0 = pas démarré ; > 30 = cycle terminé, à renouveler). today = jour UTC (os.time() // 86400).
function Calendar.dayIndex(cal, today)
	if type(today) ~= "number" or today ~= today or cal.start <= 0 then
		return 0
	end
	return math.floor(today) - cal.start + 1
end

-- Cycle terminé (30 jours écoulés) : nouveau cycle commençant aujourd'hui, jours remis à zéro (les jours non réclamés sont perdus ; jetons et missions comptées restent).
-- Retourne vrai si le cycle a été renouvelé.
function Calendar.normalize(Config, cal, today)
	if type(today) ~= "number" or today ~= today or cal.start <= 0 then
		return false
	end
	if math.floor(today) - cal.start >= Config.CALENDAR.days then
		cal.cycle = cal.cycle + 1
		cal.start = math.floor(today)
		cal.days = zeros(Config)
		cal.grace = 0
		cal.dayD = 0
		cal.dayN = 0
		return true
	end
	return false
end

-- Démarre le cycle 1 aujourd'hui s'il ne l'est pas (appelé seulement pour un joueur éligible). Retourne vrai si démarré maintenant.
function Calendar.begin(Config, cal, today)
	if cal.start > 0 or type(today) ~= "number" or today ~= today then
		return false
	end
	cal.start = math.floor(today)
	cal.cycle = math.max(1, cal.cycle + 1)
	cal.days = zeros(Config)
	cal.grace = 0
	cal.dayD = 0
	cal.dayN = 0
	return true
end

-- Éligibilité : ancienneté du compte (jours) et temps de jeu cumulé (secondes). Valeurs incertaines : tout ce qui n'est pas un nombre fini vaut 0 (refusé).
function Calendar.eligible(Config, ageDays, playedSeconds)
	local C = Config.CALENDAR
	local a = (type(ageDays) == "number" and ageDays == ageDays) and ageDays or 0
	local p = (type(playedSeconds) == "number" and playedSeconds == playedSeconds) and playedSeconds or 0
	if a < C.minAccountAgeDays then
		return false, "age"
	end
	if p < C.minPlayMinutes * 60 then
		return false, "played"
	end
	return true
end

-- Jours de grâce gagnés au jour `idx` (1 dès le jour 1, +1 tous les `graceEvery` jours) moins ceux déjà utilisés.
function Calendar.graceEarned(Config, idx)
	if type(idx) ~= "number" or idx ~= idx or idx < 1 then
		return 0
	end
	return math.floor((math.min(idx, Config.CALENDAR.days) - 1) / Config.CALENDAR.graceEvery) + 1
end

function Calendar.graceAvail(Config, cal, idx)
	return math.max(0, Calendar.graceEarned(Config, idx) - cal.grace)
end

-- Réclamations déjà faites aujourd'hui (UTC).
function Calendar.todayCount(cal, today)
	return cal.dayD == today and cal.dayN or 0
end

-- Une réclamation est-elle permise ? `day` = carte demandée, `how` = "today" (le jour en cours) ou, pour un jour manqué, "grace" / "quest" / "paid".
-- Retourne true ou (false, code) : ineligible, day, notStarted, future, claimed, monthCap, dayCap, how, noResource.
function Calendar.check(Config, cal, today, day, how, eligible)
	local C = Config.CALENDAR
	if eligible ~= true then
		return false, "ineligible"
	end
	if type(day) ~= "number" or day ~= day or day % 1 ~= 0 or day < 1 or day > C.days then
		return false, "day"
	end
	local idx = Calendar.dayIndex(cal, today)
	if idx < 1 then
		return false, "notStarted"
	end
	if day > idx then
		return false, "future"
	end
	if string.sub(cal.days, day, day) == "1" then
		return false, "claimed"
	end
	if Calendar.claimedCount(cal) >= C.monthCap then
		return false, "monthCap"
	end
	if Calendar.todayCount(cal, today) >= C.dayCap then
		return false, "dayCap"
	end
	if day == idx then
		return true
	end
	local have
	if how == "grace" then
		have = Calendar.graceAvail(Config, cal, idx) > 0
	elseif how == "quest" then
		have = cal.qc >= C.catchupQuests
	elseif how == "paid" then
		have = cal.catch >= 1
	else
		return false, "how"
	end
	if not have then
		return false, "noResource"
	end
	return true
end

-- Série : jours consécutifs réclamés qui se terminent au dernier jour réclamé du cycle.
function Calendar.streak(days)
	local last = 0
	for i = #days, 1, -1 do
		if string.sub(days, i, i) == "1" then
			last = i
			break
		end
	end
	local n = 0
	for i = last, 1, -1 do
		if string.sub(days, i, i) == "1" then
			n = n + 1
		else
			break
		end
	end
	return n
end

-- Applique une réclamation DÉJÀ validée par `check` : jour marqué, ressource consommée, compteur du jour. Retourne la série.
function Calendar.apply(Config, cal, today, day, how)
	local idx = Calendar.dayIndex(cal, today)
	cal.days = string.sub(cal.days, 1, day - 1) .. "1" .. string.sub(cal.days, day + 1)
	if cal.dayD ~= today then
		cal.dayD = today
		cal.dayN = 0
	end
	cal.dayN = cal.dayN + 1
	if day < idx then
		if how == "grace" then
			cal.grace = cal.grace + 1
		elseif how == "quest" then
			cal.qc = math.max(0, cal.qc - Config.CALENDAR.catchupQuests)
		elseif how == "paid" then
			cal.catch = math.max(0, cal.catch - 1)
		end
	end
	return Calendar.streak(cal.days)
end

-- Une mission réclamée compte pour le rattrapage « 3 missions » (plafonné à 2 rattrapages d'avance).
function Calendar.addQuest(Config, cal)
	cal.qc = math.min(Config.CALENDAR.catchupQuests * 2, cal.qc + 1)
end

-- Un jeton de rattrapage payant de plus ; faux si le plafond est atteint (l'achat n'est alors pas traité : rien n'est perdu).
function Calendar.addCatch(Config, cal)
	if cal.catch >= Config.CALENDAR.catchupMax then
		return false
	end
	cal.catch = cal.catch + 1
	return true
end

-- Une rareté a-t-elle au moins une espèce tirable (Config.PETS, hors `published == false` / `hidden == true`) ?
function Calendar.tierAvailable(Config, tier)
	for _, p in ipairs(Config.PETS or {}) do
		if p.tier == tier and p.published ~= false and p.hidden ~= true then
			return true
		end
	end
	return false
end

-- Table EFFECTIVE du tirage du jour 30 : { { tier, pct } } dans l'ordre de Config.CALENDAR.draw ; une rareté sans espèce verse son pourcentage
-- à `drawFallback` (Ultra Rare), jamais d'œuf vide. Sert au tirage ET au texte affiché (probabilités réelles).
function Calendar.drawTable(Config)
	local C = Config.CALENDAR
	local fb = C.drawFallback or C.draw[1].tier
	local out, idx = {}, {}
	for _, e in ipairs(C.draw) do
		local t = e.tier
		if not Calendar.tierAvailable(Config, t) then
			t = fb
		end
		if idx[t] then
			out[idx[t]].pct = out[idx[t]].pct + e.pct
		else
			out[#out + 1] = { tier = t, pct = e.pct }
			idx[t] = #out
		end
	end
	return out
end

-- Tirage du jour 30 : r dans [0, 1) -> rareté de l'œuf (table effective ci-dessus, pourcentages affichés).
function Calendar.draw(Config, r)
	local d = Calendar.drawTable(Config)
	local v = (type(r) == "number" and r == r) and r or 0
	local acc = 0
	for _, e in ipairs(d) do
		acc = acc + e.pct / 100
		if v < acc then
			return e.tier
		end
	end
	return d[#d].tier
end

-- Un jour dont la récompense est aléatoire (donc soumis à PolicyService quand il est obtenu par un rattrapage PAYANT).
function Calendar.isRandom(Config, day)
	local r = Config.CALENDAR.rewards[day]
	return r ~= nil and r.draw == true
end

-- Récompense concrète d'un jour : { coins, egg, scrolls, plumes, tokens, cosm, title, drew }. `rnd` = tirage [0,1) (serveur), `income` = pièces / s du joueur.
function Calendar.plan(Config, day, rnd, income)
	local C = Config.CALENDAR
	local r = C.rewards[day]
	if not r then
		return nil
	end
	local inc = (type(income) == "number" and income == income and income > 0) and income or 0
	local coins = 0
	if r.c then
		coins = math.floor(math.max(C.coinFloor, inc * 60 * r.c))
	end
	local egg = r.egg
	local drew = false
	if r.draw then
		egg = Calendar.draw(Config, rnd)
		drew = true
	end
	return { coins = coins, egg = egg, scrolls = r.scrolls or 0, plumes = r.plumes or 0, tokens = r.tokens or 0, cosm = r.cosm, title = r.title, drew = drew }
end

-- Texte court de la récompense affichée sur une carte.
function Calendar.rewardText(Config, day)
	local C = Config.CALENDAR
	local r = C.rewards[day]
	if not r then
		return ""
	end
	local parts = {}
	if r.draw then
		local t = {}
		for _, e in ipairs(Calendar.drawTable(Config)) do
			t[#t + 1] = e.pct .. " % " .. Config.TIERS[e.tier].name
		end
		parts[#parts + 1] = "🎲 Œuf : " .. table.concat(t, " / ")
	elseif r.egg then
		parts[#parts + 1] = "🥚 Œuf " .. Config.TIERS[r.egg].name
	end
	if r.c then
		parts[#parts + 1] = "🪙 " .. r.c .. " min de revenu"
	end
	if r.scrolls then
		parts[#parts + 1] = "📜 " .. r.scrolls
	end
	if r.plumes then
		parts[#parts + 1] = "🪶 " .. r.plumes
	end
	if r.tokens then
		parts[#parts + 1] = "⚔️ " .. r.tokens
	end
	if r.cosm and C.cosmetics[r.cosm] then
		parts[#parts + 1] = C.cosmetics[r.cosm].emoji .. " " .. C.cosmetics[r.cosm].name
	end
	if r.title and C.titles[r.title] then
		parts[#parts + 1] = "🏷 " .. C.titles[r.title].name
	end
	return table.concat(parts, " · ")
end

-- Compte à rebours du Légendaire (jour 3), visible dès le jour 1. idx = jour du cycle (0 avant le démarrage = jour 1), got = œuf déjà réclamé.
function Calendar.legendaryText(Config, idx, got)
	if got then
		return "🌟 Légendaire du jour " .. Config.CALENDAR.legendaryDay .. " : obtenu !"
	end
	local i = (type(idx) == "number" and idx == idx and idx >= 1) and idx or 1
	local left = Config.CALENDAR.legendaryDay - i
	if left > 1 then
		return "🌟 Œuf Légendaire : plus que " .. left .. " jours !"
	elseif left == 1 then
		return "🌟 Œuf Légendaire : plus que 1 jour !"
	elseif left == 0 then
		return "🌟 Œuf Légendaire : c'est aujourd'hui !"
	end
	return "🌟 Œuf Légendaire manqué : rattrape le jour " .. Config.CALENDAR.legendaryDay .. " !"
end

-- Vue envoyée au client (toute décision reste au serveur). states : 30 caractères, « c » réclamé, « t » à réclamer aujourd'hui, « m » manqué (rattrapable),
-- « f » à venir. Un jour qui n'est plus rattrapable n'existe pas : tout jour manqué du cycle reste rattrapable jusqu'à la fin du cycle.
function Calendar.view(Config, cal, today, eligible, reason)
	local C = Config.CALENDAR
	local idx = Calendar.dayIndex(cal, today)
	local started = idx >= 1 and idx <= C.days
	local out = {}
	for d = 1, C.days do
		local claimed = string.sub(cal.days, d, d) == "1"
		local st = "f"
		if claimed then
			st = "c"
		elseif started and d == idx then
			st = "t"
		elseif started and d < idx then
			st = "m"
		end
		out[#out + 1] = st
	end
	local shownIdx = started and idx or 1
	local left = math.max(0, C.dayCap - Calendar.todayCount(cal, today))
	local canToday = eligible == true and started and string.sub(cal.days, idx, idx) == "0" and left > 0 and Calendar.claimedCount(cal) < C.monthCap
	return {
		states = table.concat(out), idx = shownIdx, started = started, cycle = cal.cycle, claimed = Calendar.claimedCount(cal), streak = Calendar.streak(cal.days),
		grace = started and Calendar.graceAvail(Config, cal, idx) or 0, catch = cal.catch, qc = cal.qc, left = left, eligible = eligible == true, reason = reason,
		canToday = canToday == true, legendary = Calendar.legendaryText(Config, shownIdx, string.sub(cal.days, C.legendaryDay, C.legendaryDay) == "1"),
	}
end

return Calendar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX111"><Properties><string name="Name">Npc</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Npc
-- LOT 15 (F) : logique PURE des PNJ qui interpellent le joueur (aucun service Roblox). Le SERVEUR génère l'offre, la range dans un carnet (`book`), la lie au userId, la fait
-- expirer après 60 s et ne l'accepte qu'une fois ; le client ne renvoie que l'identifiant et « accepter ». Jamais de Robux, jamais d'échange entre joueurs.
-- Config attendu : TIERS, EGG_PRICE, PETS, SIZES, MUTS (existants) + NPCS, NPC_ENCOUNTER, NPC_RULES, DIALOGUES, TYPE_WEAK (bloc « LOT 15 » de Config.lua). Toute rareté passe par Config.TIERS (noms).
-- État de profil `npc` : day (jour UTC des compteurs), trades / fights (rencontres du jour), enc (rencontres du jour, alternance), nextAt (secondes UNIX absolues),
-- off (« Ne plus être interpellé »), champ (semaine du dernier Champion errant), refuse / gone (refus de suite et PNJ partis pour la journée, par clé de PNJ).
-- Style : pas de `+=`, pas de `continue`, valeurs douteuses gardées par type avant toute comparaison.
-- Inventaire fourni par le serveur à chaque appel (`inv`) : { coins, pets = { { slot, p, s, m, follower, team, defense } }, seen = { [p] = true }, typeOf = fn(p) -> type, avgLevel, teamTiers = { rareté } }.
local Npc = {}

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function int(v, lo, hi, def)
	if not isnum(v) then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end
Npc.int = int

local function rint(rng, a, b)
	return a + math.floor(rng() * (b - a + 1))
end

-- Indice d'une rareté d'après son NOM dans Config.TIERS (nil si absente : tout ce qui en dépend est alors refusé).
function Npc.tierIdx(Config, name)
	for i, t in ipairs(Config.TIERS) do
		if t.name == name then
			return i
		end
	end
	return nil
end

local function listIdx(list, name)
	for i, e in ipairs(list or {}) do
		if e.name == name then
			return i
		end
	end
	return nil
end

-- Une rareté sans espèce publiée n'apparaît jamais : un œuf donné prend la rareté publiée inférieure (Config.tierLive du lot 9 si présent).
local function liveTier(Config, t)
	if type(Config.tierLive) ~= "function" then
		return t
	end
	while t > 1 and not Config.tierLive(t) do
		t = t - 1
	end
	return t
end
Npc.liveTier = liveTier

local function forbiddenTier(Config, t)
	local name = Config.TIERS[t] and Config.TIERS[t].name
	for _, n in ipairs(Config.FORBIDDEN_GIFT_TIERS or {}) do
		if n == name then
			return true
		end
	end
	return false
end
Npc.forbiddenTier = forbiddenTier

---------------------------------------------------------------- Temps (UTC, jour = os.time() // 86400)
-- 0 = dimanche. Le 1er janvier 1970 (jour 0) était un jeudi.
function Npc.dow(day)
	return (math.floor(day) + 4) % 7
end

-- Numéro de semaine (lundi UTC = début).
function Npc.weekOf(day)
	return math.floor((math.floor(day) + 3) / 7)
end

---------------------------------------------------------------- État du profil
function Npc.newState()
	return { day = 0, trades = 0, fights = 0, enc = 0, nextAt = 0, off = false, champ = 0, refuse = {}, gone = {} }
end

local function cleanMap(saved, isBool)
	local out, n = {}, 0
	if type(saved) == "table" then
		for k, v in pairs(saved) do
			if type(k) == "string" and #k <= 16 and n < 12 then
				if isBool then
					if v == true then
						out[k] = true
						n = n + 1
					end
				elseif isnum(v) then
					out[k] = int(v, 0, 99, 0)
					n = n + 1
				end
			end
		end
	end
	return out
end

-- Assainit un `npc` lu du profil (absent, corrompu ou d'une autre forme = état neuf ; que des entiers bornés).
function Npc.sanitize(saved)
	local s = Npc.newState()
	if type(saved) ~= "table" then
		return s
	end
	s.day = int(saved.day, 0, 1e6, 0)
	s.trades = int(saved.trades, 0, 99, 0)
	s.fights = int(saved.fights, 0, 99, 0)
	s.enc = int(saved.enc, 0, 99, 0)
	s.nextAt = int(saved.nextAt, 0, 4e9, 0)
	s.off = saved.off == true
	s.champ = int(saved.champ, 0, 1e6, 0)
	s.refuse = cleanMap(saved.refuse, false)
	s.gone = cleanMap(saved.gone, true)
	return s
end

-- Remet à zéro les compteurs du jour au changement de jour UTC (nextAt, off et champ survivent : se reconnecter ne relance rien).
function Npc.rollDay(npc, today)
	if npc.day ~= today then
		npc.day = today
		npc.trades = 0
		npc.fights = 0
		npc.enc = 0
		npc.refuse = {}
		npc.gone = {}
	end
end

---------------------------------------------------------------- Conditions de rencontre (F.2)
-- ctx : { sessionStart, carrying, chased, inDuel, inCastle, inCinematic, flying, inTerritory, pending, lastRevealAt, lastRevealTier }.
-- Retourne true ou (false, code) : off, pending, carrying, chased, duel, castle, cine, flying, territory, early, reveal, wait.
function Npc.canSpawn(Config, npc, now, today, ctx)
	local E, R = Config.NPC_ENCOUNTER, Config.NPC_RULES
	ctx = type(ctx) == "table" and ctx or {}
	if npc.off == true then
		return false, "off"
	end
	if ctx.pending then
		return false, "pending"
	end
	if ctx.carrying then
		return false, "carrying"
	elseif ctx.chased then
		return false, "chased"
	elseif ctx.inDuel then
		return false, "duel"
	elseif ctx.inCastle then
		return false, "castle"
	elseif ctx.inCinematic then
		return false, "cine"
	elseif ctx.flying then
		return false, "flying"
	elseif ctx.inTerritory then
		return false, "territory"
	end
	if not isnum(now) then
		return false, "wait"
	end
	local started = isnum(ctx.sessionStart) and ctx.sessionStart or now
	if now - started < E.firstAfterMinutes * 60 then
		return false, "early"
	end
	local quietTier = Npc.tierIdx(Config, R.revealQuietTier)
	if isnum(ctx.lastRevealAt) and isnum(ctx.lastRevealTier) and quietTier and ctx.lastRevealTier >= quietTier and now - ctx.lastRevealAt < R.revealQuietSeconds then
		return false, "reveal"
	end
	if now < npc.nextAt then
		return false, "wait"
	end
	return true
end

---------------------------------------------------------------- Règles de pets (F.4 point 3)
-- Nombre d'exemplaires de chaque espèce possédés (tous pets, équipés ou non).
local function speciesCounts(inv)
	local c = {}
	for _, pet in ipairs(inv.pets or {}) do
		c[pet.p] = (c[pet.p] or 0) + 1
	end
	return c
end

-- Un pet peut-il être DEMANDÉ par un PNJ ? (indépendamment du nombre d'exemplaires, voir `giveable`.)
function Npc.petAllowed(Config, pet)
	local R = Config.NPC_RULES
	if type(pet) ~= "table" or type(pet.p) ~= "number" or Config.PETS[pet.p] == nil then
		return false
	end
	if pet.follower or pet.team or pet.defense then
		return false
	end
	local maxTier = Npc.tierIdx(Config, R.giveMaxTier)
	local mutFrom = listIdx(Config.MUTS, R.forbidMutFrom)
	local sizeFrom = listIdx(Config.SIZES, R.forbidSizeFrom)
	if not maxTier or not mutFrom or not sizeFrom then
		return false -- configuration incomplète : on refuse (pas de repli permissif)
	end
	if Config.PETS[pet.p].tier > maxTier or forbiddenTier(Config, Config.PETS[pet.p].tier) then
		return false
	end
	if type(pet.m) ~= "number" or pet.m >= mutFrom or type(pet.s) ~= "number" or pet.s >= sizeFrom then
		return false
	end
	return true
end

-- Pets que le joueur peut donner, groupés par rareté : giveable[r] = liste de pets (du moins précieux au plus précieux) en respectant « jamais le dernier exemplaire ».
local function giveableByTier(Config, inv)
	local counts = speciesCounts(inv)
	local bySpecies = {}
	for _, pet in ipairs(inv.pets or {}) do
		if Npc.petAllowed(Config, pet) then
			local l = bySpecies[pet.p]
			if not l then
				l = {}
				bySpecies[pet.p] = l
			end
			l[#l + 1] = pet
		end
	end
	local out = {}
	for p, list in pairs(bySpecies) do
		table.sort(list, function(a, b)
			local va, vb = a.m * 10 + a.s, b.m * 10 + b.s
			if va ~= vb then
				return va < vb
			end
			return (a.slot or 0) < (b.slot or 0)
		end)
		local allowed = math.min(#list, counts[p] - 1) -- au moins un exemplaire reste (doublon = au moins 2)
		local r = Config.PETS[p].tier
		for i = 1, allowed do
			out[r] = out[r] or {}
			out[r][#out[r] + 1] = list[i]
		end
	end
	for _, l in pairs(out) do
		table.sort(l, function(a, b)
			local va, vb = a.m * 10 + a.s, b.m * 10 + b.s
			if va ~= vb then
				return va < vb
			end
			return (a.slot or 0) < (b.slot or 0)
		end)
	end
	return out
end

---------------------------------------------------------------- Valeurs d'échange exactes (F.4 point 2)
function Npc.buyPrice(Config, r)
	local R = Config.NPC_RULES
	return math.floor(Config.EGG_PRICE[r] * R.buyDiscountNum / R.buyDiscountDen)
end

function Npc.speciesFee(Config, r)
	local R = Config.NPC_RULES
	return math.floor(Config.EGG_PRICE[r] * R.speciesFeeNum / R.speciesFeeDen)
end

---------------------------------------------------------------- Carnet d'offres (serveur, un par joueur)
function Npc.newBook()
	return { offers = {}, used = {}, usedOrder = {}, seq = 0, current = nil }
end

local function remember(book, id)
	book.used[id] = true
	book.usedOrder[#book.usedOrder + 1] = id
	while #book.usedOrder > 64 do
		local old = table.remove(book.usedOrder, 1)
		book.used[old] = nil
	end
end

local function newId(book, userId, rng)
	book.seq = book.seq + 1
	return string.format("%d-%d-%08x", math.floor(userId), book.seq, math.floor(rng() * 4294967296))
end

-- Retire les offres expirées (le PNJ repart sans pénalité). Retourne le nombre retiré.
function Npc.sweep(book, now)
	local n = 0
	for id, o in pairs(book.offers) do
		local limit = o.state == "accepted" and o.resultBy or o.expires
		if now >= limit then
			book.offers[id] = nil
			if book.current == id then
				book.current = nil
			end
			n = n + 1
		end
	end
	return n
end

---------------------------------------------------------------- Construction des offres
local function tierName(Config, t)
	return Config.TIERS[t] and Config.TIERS[t].name or "?"
end

local function newOffer(Config, book, npcKey, kind, userId, now, rng)
	local E = Config.NPC_ENCOUNTER
	return {
		id = newId(book, userId, rng), userId = math.floor(userId), npc = npcKey, kind = kind, created = now, expires = now + E.offerSeconds, state = "open",
		take = {}, price = 0,
	}
end

-- Pip : (A) œuf contre pièces à 80 % du prix, ou (B) 3 doublons de rareté r (r <= 4) contre 1 œuf r+1 (jamais un gain nul).
local function makePip(Config, book, userId, inv, now, rng, give)
	local R = Config.NPC_RULES
	local buyMax = Npc.tierIdx(Config, R.buyMaxTier)
	local dupMax = Npc.tierIdx(Config, R.dupesMaxTier)
	local options = {}
	if buyMax then
		options[#options + 1] = "buy"
	end
	if dupMax then
		for r = 1, math.min(dupMax, #Config.TIERS - 1) do
			local gain = liveTier(Config, r + 1)
			if gain > r and not forbiddenTier(Config, gain) and give[r] and #give[r] >= R.dupesNeeded then
				options[#options + 1] = "dupes"
				break
			end
		end
	end
	if #options == 0 then
		return nil
	end
	local pick = options[rint(rng, 1, #options)]
	local o = newOffer(Config, book, "pip", "trade", userId, now, rng)
	if pick == "buy" then
		local coins = isnum(inv.coins) and inv.coins or 0
		local candidates = {}
		for r = 1, buyMax do
			local t = liveTier(Config, r)
			if t == r and Config.EGG_PRICE[r] > 0 and Npc.buyPrice(Config, r) <= coins then
				candidates[#candidates + 1] = r
			end
		end
		local r = #candidates > 0 and candidates[rint(rng, 1, #candidates)] or liveTier(Config, 1)
		o.sub = "buy"
		o.price = Npc.buyPrice(Config, r)
		o.getEgg = r
	else
		local choices = {}
		for r = 1, math.min(dupMax, #Config.TIERS - 1) do
			local gain = liveTier(Config, r + 1)
			if gain > r and not forbiddenTier(Config, gain) and give[r] and #give[r] >= R.dupesNeeded then
				choices[#choices + 1] = r
			end
		end
		local r = choices[rint(rng, 1, #choices)]
		o.sub = "dupes"
		o.dupeTier = r
		o.getEgg = liveTier(Config, r + 1)
		for i = 1, R.dupesNeeded do
			local pet = give[r][i]
			o.take[#o.take + 1] = { slot = pet.slot, p = pet.p, s = pet.s, m = pet.m }
		end
	end
	return o
end

-- Nora : espèce manquante (rareté <= 5, jamais vue) contre 1 doublon de même rareté + 20 % du prix de l'œuf.
local function makeNora(Config, book, userId, inv, now, rng, give)
	local R = Config.NPC_RULES
	local maxTier = Npc.tierIdx(Config, R.speciesMaxTier)
	local normal = listIdx(Config.SIZES, R.speciesSize)
	if not maxTier or not normal then
		return nil
	end
	local seen = inv.seen or {}
	local cands = {}
	for p, sp in ipairs(Config.PETS) do
		local r = sp.tier
		if r <= maxTier and not seen[p] and sp.published ~= false and sp.hidden ~= true and not forbiddenTier(Config, r) and give[r] and #give[r] >= 1 and Config.EGG_PRICE[r] > 0 then
			cands[#cands + 1] = p
		end
	end
	if #cands == 0 then
		return nil
	end
	local p = cands[rint(rng, 1, #cands)]
	local r = Config.PETS[p].tier
	local pet = give[r][1]
	local o = newOffer(Config, book, "nora", "trade", userId, now, rng)
	o.sub = "species"
	o.price = Npc.speciesFee(Config, r)
	o.getSpecies = { p = p, s = normal, m = 1 }
	o.take[1] = { slot = pet.slot, p = pet.p, s = pet.s, m = pet.m }
	return o
end

-- Équipe adverse : 3 espèces EXISTANTES (types du PNJ si `inv.typeOf` est fourni, sinon toutes), niveau = niveau moyen du joueur, puissance = équipe du joueur x U(0,9 ; 1,1).
local function makeFight(Config, book, npcKey, userId, inv, now, rng, champion)
	local R = Config.NPC_RULES
	local def = Config.NPCS[npcKey]
	local o = newOffer(Config, book, npcKey, champion and "champion" or "fight", userId, now, rng)
	local maxPlayer = 1
	local sum, n = 0, 0
	for _, t in ipairs(inv.teamTiers or {}) do
		if isnum(t) then
			maxPlayer = math.max(maxPlayer, t)
			sum = sum + t
			n = n + 1
		end
	end
	local pool, fallback = {}, {}
	for p, sp in ipairs(Config.PETS) do
		if sp.published ~= false and sp.hidden ~= true and sp.tier <= maxPlayer then
			fallback[#fallback + 1] = p
			if type(inv.typeOf) ~= "function" or not def.types then
				pool[#pool + 1] = p
			else
				local ty = inv.typeOf(p)
				for _, want in ipairs(def.types) do
					if ty == want then
						pool[#pool + 1] = p
						break
					end
				end
			end
		end
	end
	if #pool == 0 then
		pool = fallback
	end
	if #pool == 0 then
		for p in ipairs(Config.PETS) do
			pool[#pool + 1] = p
		end
	end
	local lvl = int(inv.avgLevel, 1, 999, 1)
	local bag = {}
	for _, p in ipairs(pool) do
		bag[#bag + 1] = p
	end
	o.team = {}
	for _ = 1, 3 do
		local i = #bag > 0 and rint(rng, 1, #bag) or nil
		local p
		if i then
			p = bag[i]
			table.remove(bag, i)
		else
			p = pool[rint(rng, 1, #pool)]
		end
		o.team[#o.team + 1] = { p = p, lvl = lvl }
	end
	o.powerMul = (R.powerMin + rng() * (R.powerMax - R.powerMin)) * (champion and R.champPowerMul or 1)
	o.cardPct = champion and R.champCardPct or R.cardPct
	o.rewardMul = champion and 1 or R.fightRewardMul
	if champion then
		o.guaranteedEgg = liveTier(Config, Npc.tierIdx(Config, R.champEgg) or 1)
	else
		local cap = Npc.tierIdx(Config, R.fightEggCap) or 1
		local avg = n > 0 and math.floor(sum / n) or 1
		o.cardEgg = math.max(1, math.min(cap, liveTier(Config, math.max(1, avg))))
	end
	return o
end

---------------------------------------------------------------- Rencontre complète (spawn)
-- Tente une rencontre : conditions F.2, alternance échange / combat (rencontre n impaire = combat), quotas du jour, Kaï le lundi (1 fois par semaine, hors quota), puis offre.
-- Toute la mutation (compteurs, nextAt, carnet) n'a lieu qu'en cas de succès : un échec ne consomme rien. Retourne l'offre ou (nil, code).
-- Codes en plus de canSpawn : quota (plus de PNJ ce jour), noOffer (rien à proposer).
function Npc.encounter(Config, npc, book, userId, now, today, ctx, inv, rng)
	local E = Config.NPC_ENCOUNTER
	if not isnum(userId) or not isnum(today) then
		return nil, "args"
	end
	Npc.rollDay(npc, today)
	local ok, why = Npc.canSpawn(Config, npc, now, today, ctx)
	if not ok then
		return nil, why
	end
	local give = giveableByTier(Config, inv)
	local tradeLeft = npc.trades < E.tradesPerDay
	local fightLeft = npc.fights < E.fightsPerDay
	local week = Npc.weekOf(today)
	local order = {}
	if Npc.dow(today) == 1 and npc.champ ~= week and E.weeklyChampion >= 1 and not npc.gone.kai then
		order[#order + 1] = "champion"
	end
	local wantFight = (npc.enc + 1) % 2 == 1
	local first, second = "trade", "fight"
	if wantFight then
		first, second = "fight", "trade"
	end
	if (first == "trade" and tradeLeft) or (first == "fight" and fightLeft) then
		order[#order + 1] = first
	end
	if (second == "trade" and tradeLeft) or (second == "fight" and fightLeft) then
		order[#order + 1] = second
	end
	if #order == 0 then
		return nil, "quota"
	end
	local offer
	for _, kind in ipairs(order) do
		if kind == "champion" then
			offer = makeFight(Config, book, "kai", userId, inv, now, rng, true)
		elseif kind == "trade" then
			if not npc.gone.nora and rng() < 0.4 then
				offer = makeNora(Config, book, userId, inv, now, rng, give)
			end
			if not offer and not npc.gone.pip then
				offer = makePip(Config, book, userId, inv, now, rng, give)
			end
		else
			local names = {}
			for key, def in pairs(Config.NPCS) do
				if def.role == "fight" and not npc.gone[key] then
					names[#names + 1] = key
				end
			end
			table.sort(names)
			if #names > 0 then
				offer = makeFight(Config, book, names[rint(rng, 1, #names)], userId, inv, now, rng, false)
			end
		end
		if offer then
			break
		end
	end
	if not offer then
		return nil, "noOffer"
	end
	if offer.kind == "champion" then
		npc.champ = week
	elseif offer.kind == "fight" then
		npc.fights = npc.fights + 1
		npc.enc = npc.enc + 1
	else
		npc.trades = npc.trades + 1
		npc.enc = npc.enc + 1
	end
	npc.nextAt = math.max(npc.nextAt, now + rint(rng, E.gapMinutes[1] * 60, E.gapMinutes[2] * 60))
	book.offers[offer.id] = offer
	book.current = offer.id
	return offer
end

---------------------------------------------------------------- Accepter, refuser, résoudre
local function lookup(book, id, userId, now)
	if type(id) ~= "string" then
		return nil, "unknown"
	end
	local o = book.offers[id]
	if not o then
		if book.used[id] then
			return nil, "used"
		end
		return nil, "unknown"
	end
	if o.userId ~= userId then
		return nil, "owner"
	end
	return o
end

-- Contrôle une offre d'échange contre l'inventaire ACTUEL du joueur (le serveur ne fait jamais confiance au moment où l'offre a été faite).
local function revalidate(Config, o, inv)
	local mine = {}
	for _, pet in ipairs(inv.pets or {}) do
		mine[pet.slot] = pet
	end
	local counts = speciesCounts(inv)
	local given = {}
	for _, t in ipairs(o.take) do
		local pet = mine[t.slot]
		if not pet or pet.p ~= t.p or pet.s ~= t.s or pet.m ~= t.m or not Npc.petAllowed(Config, pet) then
			return false
		end
		given[pet.p] = (given[pet.p] or 0) + 1
	end
	for p, n in pairs(given) do
		if counts[p] - n < 1 then
			return false
		end
	end
	return true
end

-- Accepte une offre. opts.confirm2 : seconde confirmation (obligatoire si l'offre donne un pet de rareté >= 4).
-- Trade -> (true, effet) ; effet = { coins = -prix, take = { emplacements }, egg = rareté, species = { p, s, m }, npc, quest = "npcTrade" } à appliquer par le serveur en une fois.
-- Combat -> (true, offre acceptée) : le résultat doit ensuite être déclaré par `Npc.resolve` (le serveur le connaît, pas le client).
-- Refus : unknown, owner, used, expired, state, coins, changed, confirm2.
function Npc.accept(Config, book, id, userId, now, inv, opts)
	local o, why = lookup(book, id, userId, now)
	if not o then
		return false, why
	end
	if o.state ~= "open" then
		return false, "state"
	end
	if now >= o.expires then
		book.offers[id] = nil
		if book.current == id then
			book.current = nil
		end
		return false, "expired"
	end
	if o.kind == "trade" then
		local coins = isnum(inv.coins) and inv.coins or 0
		if o.price > coins then
			return false, "coins"
		end
		if #o.take > 0 and not revalidate(Config, o, inv) then
			return false, "changed"
		end
		if Npc.needsConfirm2(Config, o) and not (type(opts) == "table" and opts.confirm2 == true) then
			return false, "confirm2"
		end
		book.offers[id] = nil
		if book.current == id then
			book.current = nil
		end
		remember(book, id)
		local slots = {}
		for _, t in ipairs(o.take) do
			slots[#slots + 1] = t.slot
		end
		return true, { coins = -o.price, take = slots, egg = o.getEgg, species = o.getSpecies, npc = o.npc, quest = "npcTrade" }
	end
	o.state = "accepted"
	o.resultBy = now + Config.NPC_RULES.resultSeconds
	return true, o
end

-- Refus (« Pas maintenant ») : pas d'autre PNJ pendant 10 min ; 3 refus de suite du même PNJ : il ne revient plus ce jour-là. Un refus ne coûte rien d'autre.
function Npc.decline(Config, npc, book, id, userId, now)
	local o, why = lookup(book, id, userId, now)
	if not o then
		return false, why
	end
	if o.state ~= "open" then
		return false, "state"
	end
	book.offers[id] = nil
	if book.current == id then
		book.current = nil
	end
	remember(book, id)
	npc.nextAt = math.max(npc.nextAt, now + Config.NPC_ENCOUNTER.snoozeMinutes * 60)
	npc.refuse[o.npc] = math.min(99, (npc.refuse[o.npc] or 0) + 1)
	local gone = false
	if npc.refuse[o.npc] >= Config.NPC_RULES.maxRefusals then
		npc.gone[o.npc] = true
		gone = true
	end
	return true, { gone = gone, npc = o.npc }
end

-- Un échange accepté remet à zéro les refus de suite du PNJ concerné.
function Npc.noteAccepted(npc, npcKey)
	npc.refuse[npcKey] = 0
end

-- Résultat d'un combat accepté (déclaré par le serveur, une seule fois). Victoire : cartes D.5 à `cardPct` % (Kaï : Œuf garanti + carte à 100 %), valeurs x0,6 ;
-- défaite : rien n'est perdu, +5 XP. Retourne (true, issue) ou (false, code : unknown, owner, used, state, expired).
function Npc.resolve(Config, book, id, userId, now, won)
	local o, why = lookup(book, id, userId, now)
	if not o then
		return false, why
	end
	if o.state ~= "accepted" then
		return false, "state"
	end
	if now >= o.resultBy then
		book.offers[id] = nil
		if book.current == id then
			book.current = nil
		end
		return false, "expired"
	end
	book.offers[id] = nil
	if book.current == id then
		book.current = nil
	end
	remember(book, id)
	local out = { won = won == true, npc = o.npc, champion = o.kind == "champion", ratio = true }
	if won == true then
		out.cardPct = o.cardPct
		out.rewardMul = o.rewardMul
		out.cardEgg = o.cardEgg
		out.egg = o.guaranteedEgg
		out.xp = 0
	else
		out.xp = Config.NPC_RULES.lossXp
	end
	return true, out
end

---------------------------------------------------------------- Confirmation, vue et dialogues
-- 2e confirmation si un pet de rareté >= 4 (« Épique ») est donné.
function Npc.needsConfirm2(Config, o)
	local from = Npc.tierIdx(Config, Config.NPC_RULES.confirm2FromTier)
	for _, t in ipairs(o.take or {}) do
		local sp = Config.PETS[t.p]
		if sp and (not from or sp.tier >= from) then
			return true
		end
	end
	return false
end

-- Vue pour l'écran de confirmation (les deux objets côte à côte). `Odds` facultatif (module du lot 10) : compteur « 1 sur N » ; valeur de revente via Config.eggSellValue si présente.
function Npc.view(Config, o, Odds)
	local give, get = {}, {}
	for _, t in ipairs(o.take or {}) do
		local sp = Config.PETS[t.p]
		local odds
		if Odds and Odds.value and Odds.label and sp then
			odds = Odds.label(Odds.value(Config, sp.tier, t.s, t.m))
		end
		give[#give + 1] = { kind = "pet", p = t.p, name = sp and sp.name or "?", tier = sp and sp.tier, odds = odds }
	end
	if o.price and o.price > 0 then
		give[#give + 1] = { kind = "coins", amount = o.price }
	end
	if o.getEgg then
		get[#get + 1] = { kind = "egg", tier = o.getEgg, name = tierName(Config, o.getEgg), sell = type(Config.eggSellValue) == "function" and Config.eggSellValue(o.getEgg) or nil }
	end
	if o.getSpecies then
		local sp = Config.PETS[o.getSpecies.p]
		local odds
		if Odds and Odds.value and Odds.label and sp then
			odds = Odds.label(Odds.value(Config, sp.tier, o.getSpecies.s, o.getSpecies.m))
		end
		get[#get + 1] = { kind = "pet", p = o.getSpecies.p, name = sp and sp.name or "?", tier = sp and sp.tier, odds = odds }
	end
	return { npc = o.npc, name = Config.NPCS[o.npc].name, give = give, get = get, confirm2 = Npc.needsConfirm2(Config, o), expires = o.expires }
end

-- Texte d'un dialogue : `which` = approach, offer1, offer2, offer, win, lose, refuse, gone ; {variables} remplacées par `vars`.
function Npc.say(Config, npcKey, which, vars)
	local d = Config.DIALOGUES[npcKey]
	local text = d and d[which]
	if type(text) ~= "string" then
		return ""
	end
	return (string.gsub(text, "{(%w+)}", function(k)
		local v = vars and vars[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

-- Astuce de défaite (types de l'équipe adverse). `weak` = { typeAdverse = typeQuiLeBat } (défaut Config.TYPE_WEAK).
function Npc.tip(Config, o, weak)
	weak = weak or Config.TYPE_WEAK or {}
	local def = Config.NPCS[o.npc]
	local ty = def and def.types and def.types[1]
	local against = ty and weak[ty]
	if not against then
		return "observe bien les types de l'équipe adverse."
	end
	return "le type " .. ty .. " craint le type " .. against .. "."
end

-- Contrôle indépendant d'une offre : retourne la liste des violations de F.4 (vide = conforme). Sert aux 10 000 offres des tests et peut servir de garde du serveur.
function Npc.violations(Config, o, inv, userId)
	local R = Config.NPC_RULES
	local bad = {}
	local function no(msg)
		bad[#bad + 1] = msg
	end
	if o.userId ~= userId then
		no("offre non liée au userId")
	end
	if type(o.id) ~= "string" or o.id == "" then
		no("identifiant absent")
	end
	if o.expires - o.created ~= Config.NPC_ENCOUNTER.offerSeconds then
		no("durée de validité")
	end
	for k in pairs(o) do
		local lk = string.lower(tostring(k))
		if string.find(lk, "robux") or string.find(lk, "product") or string.find(lk, "gamepass") or string.find(lk, "target") or string.find(lk, "other") then
			no("champ interdit : " .. tostring(k))
		end
	end
	local counts = speciesCounts(inv)
	local mine = {}
	for _, pet in ipairs(inv.pets or {}) do
		mine[pet.slot] = pet
	end
	local given = {}
	local seenSlot = {}
	for _, t in ipairs(o.take or {}) do
		local pet = mine[t.slot]
		if not pet then
			no("pet demandé absent de l'inventaire")
		else
			if seenSlot[t.slot] then
				no("même emplacement demandé deux fois")
			end
			seenSlot[t.slot] = true
			local tier = Config.PETS[pet.p].tier
			if tier > Npc.tierIdx(Config, R.giveMaxTier) then
				no("pet de rareté trop haute demandé")
			end
			if pet.follower or pet.team or pet.defense then
				no("pet équipé, d'équipe ou de défense demandé")
			end
			if pet.m >= listIdx(Config.MUTS, R.forbidMutFrom) then
				no("pet muté Arc-en-ciel ou mieux demandé")
			end
			if pet.s >= listIdx(Config.SIZES, R.forbidSizeFrom) then
				no("pet Géant ou Colossal demandé")
			end
			given[pet.p] = (given[pet.p] or 0) + 1
		end
	end
	for p, n in pairs(given) do
		if counts[p] - n < 1 then
			no("dernier exemplaire d'une espèce demandé")
		end
	end
	if o.sub == "buy" then
		if #o.take ~= 0 then
			no("achat d'œuf : aucun pet ne doit être demandé")
		end
		if o.getEgg > Npc.tierIdx(Config, R.buyMaxTier) or o.price ~= math.floor(Config.EGG_PRICE[o.getEgg] * R.buyDiscountNum / R.buyDiscountDen) then
			no("prix ou rareté de l'achat")
		end
	elseif o.sub == "dupes" then
		if #o.take ~= R.dupesNeeded then
			no("nombre de doublons")
		end
		if o.dupeTier > Npc.tierIdx(Config, R.dupesMaxTier) or o.price ~= 0 or o.getEgg <= o.dupeTier then
			no("règle des doublons")
		end
		for _, t in ipairs(o.take) do
			if Config.PETS[t.p].tier ~= o.dupeTier then
				no("doublon d'une autre rareté")
			end
		end
	elseif o.sub == "species" then
		local sp = Config.PETS[o.getSpecies.p]
		if #o.take ~= 1 or sp.tier > Npc.tierIdx(Config, R.speciesMaxTier) or inv.seen[o.getSpecies.p] then
			no("règle de l'espèce manquante")
		elseif Config.PETS[o.take[1].p].tier ~= sp.tier or o.price ~= math.floor(Config.EGG_PRICE[sp.tier] * R.speciesFeeNum / R.speciesFeeDen) then
			no("rareté ou complément de l'espèce manquante")
		end
	elseif o.kind == "trade" then
		no("sous-type d'échange inconnu")
	end
	if o.getEgg and forbiddenTier(Config, o.getEgg) then
		no("œuf de rareté interdite offert")
	end
	if o.kind == "trade" and o.price < 0 then
		no("prix négatif")
	end
	return bad
end

return Npc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX112"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/Rewards
-- LOT 15 (G) : récompenses PURES (aucun service Roblox) : série de 7 jours (G.1), grâce et sauvetage (G.2), enveloppe du calendrier de 30 jours (Calendar.lua, lot 9b),
-- quêtes bonus et hebdomadaires (G.4), sac d'œufs (10 places, jamais de perte), rotation hebdomadaire de 9 semaines, événements (week-end chanceux, heure dorée, événements limités),
-- plumes d'événement avec plafonds par jour. Le SERVEUR fournit le jour UTC (os.time() // 86400) ; le client ne reçoit que des vues.
-- Config attendu : TIERS, TIER_GATE, EGG_PRICE, PETS, VIP_DAILY_MUL (existants) + STREAK, EGG_BAG, QUESTS, PLUMES, TIMED_EVENTS, EVENTS_CAL, WEEKLY_ROTATION*, FORBIDDEN_GIFT_TIERS (bloc « LOT 15 » de Config.lua).
-- Toute rareté est un NOM résolu par Config.TIERS : jamais d'indice codé en dur. Secret / Exclusif / Divin ne sont jamais donnés par la série ni par les quêtes.
-- États de profil : voir roblox/LOT15_INTEGRATION_NOTES.md (grace, weekly, event, eggBag ; daily / streak existants).
-- Style : pas de `+=`, pas de `continue`, valeurs douteuses gardées par type avant toute comparaison.
local Rewards = {}

local function isnum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function int(v, lo, hi, def)
	if not isnum(v) then
		return def
	end
	v = math.floor(v)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end
Rewards.int = int

---------------------------------------------------------------- Raretés par nom
function Rewards.tierIdx(Config, name)
	for i, t in ipairs(Config.TIERS) do
		if t.name == name then
			return i
		end
	end
	return nil
end

function Rewards.forbiddenTier(Config, t)
	local name = Config.TIERS[t] and Config.TIERS[t].name
	for _, n in ipairs(Config.FORBIDDEN_GIFT_TIERS or {}) do
		if n == name then
			return true
		end
	end
	return false
end

-- Rareté PUBLIÉE la plus proche vers le bas (Config.tierLive du lot 9 si présent) : un œuf n'est jamais d'une rareté sans espèce.
function Rewards.liveTier(Config, t)
	if type(Config.tierLive) ~= "function" then
		return t
	end
	while t > 1 and not Config.tierLive(t) do
		t = t - 1
	end
	return t
end

-- Rareté d'un œuf donné par la série / les quêtes : résolue par nom, jamais interdite (nil sinon), ramenée à une rareté publiée.
local function giftTier(Config, name)
	local t = Rewards.tierIdx(Config, name)
	if not t or Rewards.forbiddenTier(Config, t) then
		return nil
	end
	return Rewards.liveTier(Config, t)
end
Rewards.giftTier = giftTier

---------------------------------------------------------------- Temps UTC (jour = os.time() // 86400)
function Rewards.dow(day)
	return (math.floor(day) + 4) % 7 -- 0 = dimanche
end

function Rewards.weekOf(day)
	return math.floor((math.floor(day) + 3) / 7) -- semaines commençant le lundi
end

-- Date civile (année, mois, jour) d'un numéro de jour UTC (algorithme de H. Hinnant).
function Rewards.civil(day)
	local z = math.floor(day) + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local y = yoe + era * 400
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = mp < 10 and mp + 3 or mp - 9
	if m <= 2 then
		y = y + 1
	end
	return y, m, d
end

-- Numéro de jour UTC d'une date civile (inverse de `civil`).
function Rewards.daysFromCivil(y, m, d)
	if m <= 2 then
		y = y - 1
	end
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = m > 2 and m - 3 or m + 9
	local doy = math.floor((153 * mp + 2) / 5) + d - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

---------------------------------------------------------------- Sac d'œufs et placement (jamais de perte)
local function slotFree(slots, i)
	return slots[i] == nil or slots[i] == false
end

function Rewards.freeSlots(slots, cap)
	local n = 0
	for i = 1, cap do
		if slotFree(slots, i) then
			n = n + 1
		end
	end
	return n
end

-- Assainit un sac lu du profil : liste de rarétés entières valides, au plus `size` entrées.
function Rewards.sanitizeBag(Config, saved)
	local out = {}
	local size = Config.EGG_BAG.size
	if type(saved) == "table" then
		for _, t in ipairs(saved) do
			if #out < size and isnum(t) then
				local v = math.floor(t)
				if v >= 1 and v <= #Config.TIERS then
					out[#out + 1] = v
				end
			end
		end
	end
	return out
end

-- Peut-on ranger `n` œufs ? (base d'abord, puis le sac.)
function Rewards.canStore(Config, slots, cap, bag, n)
	return Rewards.freeSlots(slots, cap) + (Config.EGG_BAG.size - #bag) >= n
end

-- Range des œufs de façon ATOMIQUE : tout ou rien. `mkEgg(tier)` crée l'emplacement d'œuf (le serveur y met `ends`, `shield`) ; défaut { k = "e", t = tier }.
-- Retourne (true, { "slot" | "bag", ... }) ou (false, "bagFull") sans rien modifier.
function Rewards.storeEggs(Config, slots, cap, bag, tiers, mkEgg)
	if not Rewards.canStore(Config, slots, cap, bag, #tiers) then
		return false, "bagFull"
	end
	local where = {}
	local nextSlot = 1
	for _, t in ipairs(tiers) do
		while nextSlot <= cap and not slotFree(slots, nextSlot) do
			nextSlot = nextSlot + 1
		end
		if nextSlot <= cap then
			slots[nextSlot] = mkEgg and mkEgg(t) or { k = "e", t = t }
			where[#where + 1] = "slot"
		else
			bag[#bag + 1] = t
			where[#where + 1] = "bag"
		end
	end
	return true, where
end

-- Pose un œuf du sac dans la base (le plus ancien d'abord). Retourne (true, rareté, emplacement) ou (false, "empty" | "baseFull").
function Rewards.bagTake(slots, cap, bag, mkEgg)
	if #bag == 0 then
		return false, "empty"
	end
	for i = 1, cap do
		if slotFree(slots, i) then
			local t = table.remove(bag, 1)
			slots[i] = mkEgg and mkEgg(t) or { k = "e", t = t }
			return true, t, i
		end
	end
	return false, "baseFull"
end

---------------------------------------------------------------- Récompense (« grant ») : forme commune
local function newGrant()
	return { coins = 0, eggs = {}, fragments = 0, seasonXp = 0, plumes = 0 }
end

local function eggsFromNames(Config, names, grant)
	for _, name in ipairs(names or {}) do
		local t = giftTier(Config, name)
		if t then
			grant.eggs[#grant.eggs + 1] = t
		end
	end
end

-- Un grant ne contient jamais une rareté interdite (sauf `allow`, utilisé seulement pour l'Exclusif contre plumes et le calendrier). Retourne la liste des violations.
function Rewards.grantViolations(Config, grant, allow)
	local bad = {}
	for _, t in ipairs(grant.eggs or {}) do
		if type(t) ~= "number" or Config.TIERS[t] == nil then
			bad[#bad + 1] = "rareté inconnue"
		elseif Rewards.forbiddenTier(Config, t) and not allow then
			bad[#bad + 1] = "rareté interdite : " .. Config.TIERS[t].name
		end
	end
	return bad
end

---------------------------------------------------------------- G.1 Série de 7 jours
-- États de profil : d.daily (dernier jour UTC réclamé), d.streak (jours de suite), d.grace = { week, used, weeks, rweek } :
--   week / used = semaine du dernier jour de grâce consommé ; weeks = semaines de 7 jours terminées (Mythique à la 4e) ; rweek = semaine du dernier sauvetage payant.
function Rewards.sanitizeGrace(saved)
	local g = { week = 0, used = 0, weeks = 0, rweek = 0 }
	if type(saved) == "table" then
		g.week = int(saved.week, 0, 1e6, 0)
		g.used = int(saved.used, 0, 1, 0)
		g.weeks = int(saved.weeks, 0, 1e5, 0)
		g.rweek = int(saved.rweek, 0, 1e6, 0)
	end
	return g
end

local function graceAvailable(g, today)
	return not (g.week == Rewards.weekOf(today) and g.used >= 1)
end

-- Récompense d'un jour de la série (1 à 7). `weeks` = semaines terminées avant celle-ci ; `income` = pièces / s ; `vip` : pièces x VIP_DAILY_MUL (jamais les œufs).
function Rewards.streakReward(Config, day, weeks, income, vip)
	local S = Config.STREAK
	local def = S.days[day]
	local grant = newGrant()
	if not def then
		return grant
	end
	local month = (day == #S.days) and def.eggsMonth and ((weeks + 1) % S.mythicEveryWeeks == 0)
	eggsFromNames(Config, month and def.eggsMonth or def.eggs, grant)
	if def.c then
		local inc = (isnum(income) and income > 0) and income or 0
		local coins = math.floor(math.max(S.coinFloor, inc * 60 * def.c))
		if vip == true then
			coins = coins * (Config.VIP_DAILY_MUL or 1)
		end
		grant.coins = coins
	end
	grant.luck = def.luck and { minutes = def.luck.minutes, points = def.luck.points } or nil
	grant.boost = def.boost and { key = def.boost.key, mul = def.boost.mul, minutes = def.boost.minutes } or nil
	grant.fragments = def.fragments or 0
	grant.mythicWeek = month == true
	return grant
end

-- État de la série pour `today`. g = { daily, streak, grace }. ctx = { questsDone }.
-- state : done (déjà réclamée), ready (la suite normale ou le premier jour), grace (un jour manqué pardonné automatiquement), rescue (sauvetage : quêtes gratuites ou produit),
-- reset (3 jours manqués ou plus : retour au jour 1). day = jour de la série qui serait réclamé.
function Rewards.streakPlan(Config, g, today, ctx)
	local S = Config.STREAK
	local daily = isnum(g.daily) and g.daily or 0
	local streak = int(g.streak, 0, 1e6, 0)
	local plan = { state = "ready", day = 1, missed = 0, streak = streak }
	if daily == today or daily > today then
		plan.state = "done"
		plan.day = (streak % #S.days) + 1
		return plan
	end
	if daily <= 0 then
		return plan
	end
	local missed = today - daily - 1
	plan.missed = missed
	if missed <= 0 then
		plan.day = (streak % #S.days) + 1
	elseif missed == 1 and graceAvailable(g.grace, today) then
		plan.state = "grace"
		plan.day = (streak % #S.days) + 1
	elseif missed < S.resetAfterMissed then
		plan.state = "rescue"
		plan.day = (streak % #S.days) + 1
		local done = (type(ctx) == "table" and isnum(ctx.questsDone)) and ctx.questsDone or 0
		plan.canQuest = done >= S.restoreQuests
		plan.canProduct = true -- lot 16 (décision utilisateur : plus de plafond d'achat) : le sauvetage payant n'est plus limité à 1 par semaine ; rweek reste noté (mesure)
		plan.lost = streak
	else
		plan.state = "reset"
	end
	return plan
end

-- Réclame la série du jour (le serveur appelle ceci, jamais le client). how : nil (suite normale, ou jour de grâce automatique), "quest" (3 quêtes faites aujourd'hui),
-- "product" (produit StreakRestore DÉJÀ vérifié par reçu), "reset" (le joueur accepte de repartir du jour 1 au lieu de sauver sa série).
-- ctx : { income, vip, questsDone, slots, cap, bag, mkEgg }. Atomique : si l'octroi des œufs est impossible (base ET sac pleins) rien n'est modifié ("bagFull").
-- Retourne (true, { day, grant, state, where }) ou (false, code : done, rescue, noQuest, noProduct, bagFull).
function Rewards.streakClaim(Config, g, today, how, ctx)
	local S = Config.STREAK
	local plan = Rewards.streakPlan(Config, g, today, ctx)
	if plan.state == "done" then
		return false, "done"
	end
	local continues = true
	local useGrace, useProduct = false, false
	if plan.state == "grace" then
		useGrace = true
	elseif plan.state == "rescue" then
		if how == "quest" then
			if not plan.canQuest then
				return false, "noQuest"
			end
		elseif how == "product" then
			if not plan.canProduct then
				return false, "noProduct"
			end
			useProduct = true
		elseif how == "reset" then
			continues = false
		else
			return false, "rescue"
		end
	elseif plan.state == "reset" then
		continues = false
	end
	local day = continues and plan.day or 1
	local streakNow = continues and (int(g.streak, 0, 1e6, 0) + 1) or 1
	local weeks = continues and g.grace.weeks or 0
	local grant = Rewards.streakReward(Config, day, weeks, ctx and ctx.income, ctx and ctx.vip)
	local where
	if ctx and ctx.slots then
		local ok, w = Rewards.storeEggs(Config, ctx.slots, ctx.cap, ctx.bag, grant.eggs, ctx.mkEgg)
		if not ok then
			return false, w
		end
		where = w
	end
	g.daily = today
	g.streak = streakNow
	if useGrace then
		g.grace.week = Rewards.weekOf(today)
		g.grace.used = 1
	end
	if useProduct then
		g.grace.rweek = Rewards.weekOf(today)
	end
	if not continues then
		g.grace.weeks = 0
	end
	if day == #S.days then
		g.grace.weeks = g.grace.weeks + 1
	end
	return true, { day = day, grant = grant, state = plan.state, where = where }
end

---------------------------------------------------------------- Calendrier de 30 jours (Calendar.lua, lot 9b) : enveloppe avec sac d'œufs
-- Réutilise Calendar.check / plan / apply (module passé en paramètre) et ajoute le rangement atomique des œufs (base, puis sac). Les raretés du calendrier viennent de
-- Config.CALENDAR (le tirage du jour 30 peut donner un Secret : règle propre au calendrier, hors des interdits de la série et des quêtes).
-- Retourne (true, { plan, streak, where }) ou (false, code) ; codes de Calendar.check, plus bagFull.
function Rewards.calendarClaim(Config, Calendar, cal, today, day, how, eligible, rnd, income, store)
	local ok, why = Calendar.check(Config, cal, today, day, how, eligible)
	if not ok then
		return false, why
	end
	local plan = Calendar.plan(Config, day, rnd, income)
	local where
	if plan and plan.egg and store then
		local ok2, w = Rewards.storeEggs(Config, store.slots, store.cap, store.bag, { plan.egg }, store.mkEgg)
		if not ok2 then
			return false, w
		end
		where = w
	end
	local streak = Calendar.apply(Config, cal, today, day, how)
	return true, { plan = plan, streak = streak, where = where }
end

---------------------------------------------------------------- G.4 Quêtes bonus du jour
-- weekly.bq = { d = jour UTC, prog, claimed } ; l'option du jour est choisie par le numéro du jour (même résultat à chaque appel).
function Rewards.bonusQuest(Config, day, chapter)
	local B = Config.QUESTS.bonus
	local opt = B.options[(math.floor(day) % #B.options) + 1]
	local late = isnum(chapter) and chapter >= B.lateChapter
	local q = { kind = opt.kind, goal = opt.goal, text = opt.text, egg = giftTier(Config, late and B.eggLate or B.egg) }
	if opt.minTier then
		q.minTier = Rewards.tierIdx(Config, opt.minTier)
	end
	return q
end

local function newBonus(day)
	return { d = day, prog = 0, claimed = false }
end

-- Progression de la quête bonus : ev = { kind = "pve" } ou { kind = "hatch", tier }. Compte seulement si les 3 quêtes du jour sont faites (`unlocked`). Retourne (progrès, terminée).
function Rewards.bonusEvent(Config, wk, day, chapter, unlocked, ev)
	if type(wk.bq) ~= "table" or wk.bq.d ~= day then
		wk.bq = newBonus(day)
	end
	local q = Rewards.bonusQuest(Config, day, chapter)
	if unlocked == true and type(ev) == "table" and ev.kind == q.kind and not wk.bq.claimed then
		local ok = true
		if q.kind == "hatch" then
			ok = isnum(ev.tier) and q.minTier ~= nil and ev.tier >= q.minTier
		end
		if ok then
			wk.bq.prog = math.min(q.goal, wk.bq.prog + 1)
		end
	end
	return wk.bq.prog, wk.bq.prog >= q.goal
end

-- Réclame l'Œuf de la quête bonus (une seule fois par jour). store = { slots, cap, bag, mkEgg } facultatif. Retourne (true, grant) ou (false, code : notDone, claimed, bagFull).
function Rewards.bonusClaim(Config, wk, day, chapter, store)
	if type(wk.bq) ~= "table" or wk.bq.d ~= day then
		wk.bq = newBonus(day)
	end
	local q = Rewards.bonusQuest(Config, day, chapter)
	if wk.bq.claimed then
		return false, "claimed"
	end
	if wk.bq.prog < q.goal then
		return false, "notDone"
	end
	local grant = newGrant()
	grant.eggs[1] = q.egg
	if store then
		local ok, w = Rewards.storeEggs(Config, store.slots, store.cap, store.bag, grant.eggs, store.mkEgg)
		if not ok then
			return false, w
		end
		grant.where = w
	end
	wk.bq.claimed = true
	return true, grant
end

---------------------------------------------------------------- G.4 Quêtes de la semaine
-- weekly = { w = semaine UTC, prog = { 7 entiers }, c5, c7 (récompenses réclamées), bq }.
function Rewards.sanitizeWeekly(Config, saved)
	local themes = Config.QUESTS.weekly.themes
	local wk = { w = 0, prog = {}, c5 = false, c7 = false, bq = newBonus(0) }
	for i = 1, #themes do
		wk.prog[i] = 0
	end
	if type(saved) == "table" then
		wk.w = int(saved.w, 0, 1e6, 0)
		for i = 1, #themes do
			wk.prog[i] = int(type(saved.prog) == "table" and saved.prog[i] or 0, 0, themes[i].goal, 0)
		end
		wk.c5 = saved.c5 == true
		wk.c7 = saved.c7 == true
		if type(saved.bq) == "table" then
			wk.bq = { d = int(saved.bq.d, 0, 1e6, 0), prog = int(saved.bq.prog, 0, 99, 0), claimed = saved.bq.claimed == true }
		end
	end
	return wk
end

-- Nouvelle semaine : progression et réclamations remises à zéro.
function Rewards.weeklySync(Config, wk, week)
	if wk.w ~= week then
		local fresh = Rewards.sanitizeWeekly(Config, nil)
		wk.w = week
		wk.prog = fresh.prog
		wk.c5 = false
		wk.c7 = false
	end
end

-- Progression d'un thème (jamais au-delà de l'objectif). Retourne la progression, ou nil si le thème n'existe pas.
function Rewards.weeklyAdd(Config, wk, key, n)
	for i, th in ipairs(Config.QUESTS.weekly.themes) do
		if th.key == key then
			local add = isnum(n) and math.max(0, math.floor(n)) or 0
			wk.prog[i] = math.min(th.goal, wk.prog[i] + add)
			return wk.prog[i]
		end
	end
	return nil
end

function Rewards.weeklyDone(Config, wk)
	local n = 0
	for i, th in ipairs(Config.QUESTS.weekly.themes) do
		if wk.prog[i] >= th.goal then
			n = n + 1
		end
	end
	return n
end

-- Réclame le palier 5/7 (which = 5) ou 7/7 (which = 7) : une fois chacun par semaine. Retourne (true, grant) ou (false, code : notDone, claimed, bagFull, which).
function Rewards.weeklyClaim(Config, wk, which, store)
	local tier
	for _, r in ipairs(Config.QUESTS.weekly.rewards) do
		if r.need == which then
			tier = r
		end
	end
	if not tier then
		return false, "which"
	end
	local flag = which == 5 and "c5" or "c7"
	if wk[flag] then
		return false, "claimed"
	end
	if Rewards.weeklyDone(Config, wk) < tier.need then
		return false, "notDone"
	end
	local grant = newGrant()
	local t = giftTier(Config, tier.egg)
	if t then
		grant.eggs[1] = t
	end
	grant.seasonXp = tier.seasonXp or 0
	if store then
		local ok, w = Rewards.storeEggs(Config, store.slots, store.cap, store.bag, grant.eggs, store.mkEgg)
		if not ok then
			return false, w
		end
		grant.where = w
	end
	wk[flag] = true
	return true, grant
end

---------------------------------------------------------------- Rotation hebdomadaire (cycle de 9 semaines, identique pour tous les joueurs)
function Rewards.rotation(Config, week)
	local list = Config.WEEKLY_ROTATION
	local w = isnum(week) and math.floor(week) or 0
	local epoch = Config.WEEKLY_ROTATION_EPOCH or 0
	return list[((w - epoch) % #list) + 1], ((w - epoch) % #list) + 1
end

-- Poids d'un œuf après l'espèce vedette : x2 pour l'espèce de la semaine (nom de Config.PETS), inchangé sinon.
function Rewards.featuredWeight(Config, rot, petIdx, weight)
	local sp = Config.PETS[petIdx]
	if sp and rot and sp.name == rot.featured then
		return weight * (Config.WEEKLY_ROTATION_MULT or 2)
	end
	return weight
end

-- Espèce vedette appliquée APRÈS un tirage uniforme parmi les n espèces de la rareté obtenue (Rules.rollPet) : bascule vers l'espèce vedette avec la
-- probabilité (M - 1) / (n + M - 1) (M = WEEKLY_ROTATION_MULT ; M = 2 : 1 / (n + 1)). Résultat : P(vedette) = M / (n + M - 1), chaque autre espèce
-- 1 / (n + M - 1), exactement un poids x M. La rareté ne change jamais (la vedette n'est choisie que dans la rareté déjà tirée). Retourne l'indice d'espèce.
function Rewards.featuredPick(Config, rot, petIdx, rnd)
	local sp = Config.PETS[petIdx]
	if not (sp and rot and type(rot.featured) == "string") or sp.name == rot.featured then
		return petIdx
	end
	local featured, n = nil, 0
	for i, p in ipairs(Config.PETS) do
		if p.tier == sp.tier then
			n = n + 1
			if p.name == rot.featured then
				featured = i
			end
		end
	end
	local M = Config.WEEKLY_ROTATION_MULT or 2
	if featured and type(rnd) == "function" and rnd() < (M - 1) / (n + M - 1) then
		return featured
	end
	return petIdx
end

-- Multiplicateur de dégâts du type « en forme » : PvE seulement.
function Rewards.typeDamage(Config, rot, ty, pve)
	if pve == true and rot and rot.type == ty then
		return Config.WEEKLY_ROTATION_DAMAGE or 1.2
	end
	return 1
end

---------------------------------------------------------------- G.5 Événements
-- Week-end chanceux : samedi 00:00 -> lundi 00:00 UTC. Heure dorée : tous les jours de fromHour à toHour UTC. `now` = secondes UNIX.
function Rewards.isWeekend(Config, now)
	if not isnum(now) then
		return false
	end
	local d = Rewards.dow(math.floor(now / 86400))
	for _, x in ipairs(Config.TIMED_EVENTS.weekend.days) do
		if x == d then
			return true
		end
	end
	return false
end

function Rewards.isGoldenHour(Config, now)
	if not isnum(now) then
		return false
	end
	local h = math.floor((now % 86400) / 3600)
	local G = Config.TIMED_EVENTS.goldenHour
	return h >= G.fromHour and h < G.toHour
end

-- Événement limité actif ce jour-là (Config.EVENTS_CAL, dates « MM-JJ » de l'année en cours) : (entrée, clé « id.année ») ou nil.
function Rewards.limitedEvent(Config, today)
	if not isnum(today) then
		return nil
	end
	local y = Rewards.civil(today)
	for _, e in ipairs(Config.EVENTS_CAL) do
		local fm, fd = string.match(e.from, "^(%d+)%-(%d+)$")
		local tm, td = string.match(e.to, "^(%d+)%-(%d+)$")
		if fm and tm then
			local a = Rewards.daysFromCivil(y, tonumber(fm), tonumber(fd))
			local b = Rewards.daysFromCivil(y, tonumber(tm), tonumber(td))
			if today >= a and today <= b then
				return e, e.id .. "." .. y
			end
		end
	end
	return nil
end

-- Ensemble des effets actifs à l'instant `now` (secondes UNIX).
function Rewards.activeEvents(Config, now)
	local today = isnum(now) and math.floor(now / 86400) or 0
	local limited, key = Rewards.limitedEvent(Config, today)
	local W = Config.TIMED_EVENTS.weekend
	local weekend = Rewards.isWeekend(Config, now)
	return {
		weekend = weekend, upgradeBonus = weekend and W.upgradePoints or 0, beltSeconds = weekend and W.beltSeconds or W.beltDefault,
		golden = Rewards.isGoldenHour(Config, now), goldKey = Config.TIMED_EVENTS.goldenHour.key, limited = limited, limitedKey = key,
	}
end

---------------------------------------------------------------- Plumes d'événement
-- event = { k = clé de l'événement en cours (« id.année »), d = jour UTC des compteurs, q / v = plumes de quêtes / de victoires PvE aujourd'hui, l = connexion déjà créditée (0/1),
--           p = solde, x = Œufs Exclusifs obtenus pendant cet événement }.
function Rewards.sanitizeEvent(Config, saved)
	local P = Config.PLUMES
	local e = { k = "", d = 0, q = 0, v = 0, l = 0, p = 0, x = 0 }
	if type(saved) == "table" then
		if type(saved.k) == "string" and #saved.k <= 24 then
			e.k = saved.k
		end
		e.d = int(saved.d, 0, 1e6, 0)
		e.q = int(saved.q, 0, P.questCapDay, 0)
		e.v = int(saved.v, 0, P.pveCapDay, 0)
		e.l = int(saved.l, 0, 1, 0)
		e.p = int(saved.p, 0, P.balanceCap, 0)
		e.x = int(saved.x, 0, 99, 0)
	end
	return e
end

-- Synchronise avec le jour et l'événement actifs (`key` nil = aucun événement). Nouveau jour : compteurs du jour à zéro. Nouvel événement : solde et achats remis à zéro
-- (les plumes d'un événement terminé ne se reportent pas : décision documentée ; à changer en ajoutant un report ici).
function Rewards.plumeSync(Config, ev, today, key)
	if ev.d ~= today then
		ev.d = today
		ev.q = 0
		ev.v = 0
		ev.l = 0
	end
	if key and ev.k ~= key then
		ev.k = key
		ev.p = 0
		ev.x = 0
	end
end

-- Crédite des plumes avec les plafonds du jour. source : "quest" (10 par quête du jour, 40 au plus), "pve" (2 par victoire, 20 au plus), "login" (5, une fois). Retourne la quantité créditée.
-- Sans événement actif (`ev.k == ""` ou `active == false`) : rien.
function Rewards.plumeAdd(Config, ev, source, active)
	local P = Config.PLUMES
	if active ~= true or ev.k == "" then
		return 0
	end
	local add = 0
	if source == "quest" then
		add = math.min(P.perQuest, P.questCapDay - ev.q)
		add = math.max(0, add)
		ev.q = ev.q + add
	elseif source == "pve" then
		add = math.max(0, math.min(P.perPveWin, P.pveCapDay - ev.v))
		ev.v = ev.v + add
	elseif source == "login" then
		if ev.l == 0 then
			ev.l = 1
			add = P.login
		end
	end
	local room = math.max(0, P.balanceCap - ev.p)
	add = math.min(add, room)
	ev.p = ev.p + add
	return add
end

-- Œuf Exclusif contre 150 plumes (jamais plus de `maxExclusivePerEvent` par événement ; refusé tant que la rareté n'a aucune espèce publiée). store = { slots, cap, bag, mkEgg }.
-- Retourne (true, rareté, emplacement) ou (false, code : inactive, plumes, limit, notLive, bagFull).
function Rewards.plumeBuyExclusive(Config, ev, active, store)
	local P = Config.PLUMES
	if active ~= true or ev.k == "" then
		return false, "inactive"
	end
	if ev.x >= P.maxExclusivePerEvent then
		return false, "limit"
	end
	if ev.p < P.exclusiveCost then
		return false, "plumes"
	end
	local t = Rewards.tierIdx(Config, P.exclusiveName)
	if not t or Rewards.liveTier(Config, t) ~= t then
		return false, "notLive"
	end
	local where
	if store then
		local ok, w = Rewards.storeEggs(Config, store.slots, store.cap, store.bag, { t }, store.mkEgg)
		if not ok then
			return false, w
		end
		where = w[1]
	end
	ev.p = ev.p - P.exclusiveCost
	ev.x = ev.x + 1
	return true, t, where
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX113"><Properties><string name="Name">KioskData</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/KioskData
-- LOT 8B-kiosque : DONNEES PURES du kiosque central de la place (aucun service Roblox, aucune instance ; testé hors de Roblox). Source unique pour
-- ServerScriptService/Kiosk (construction, prompts, validation serveur) et pour le client (libellés des 4 panneaux).
-- Repères : Nord = -Z, Est = +X. Le « devant » du kiosque (comptoir, PanneauBoutique) regarde la halle (Config.Map2.hall).
local KioskData = {}

KioskData.ASSET_ID = 90238570290603 -- modèle Blender hub_kiosk (clé J.1 : hub.kiosk), 15,4 de large, 12,75 de haut, pieds à 0
KioskData.ASSET_GROUP, KioskData.ASSET_KEY = "hub", "kiosk" -- Config.Assets.models.hub.kiosk (préchargé et nettoyé par le module Assets)
KioskData.WIDTH, KioskData.HEIGHT = 15.4, 12.75
KioskData.RADIUS = 7.7 -- demi-largeur du socle : rayon d'emprise utilisé pour contrôler les obstacles
KioskData.GROUND_Y = 0.52 -- dessus du dallage de la place (Scenery.plaza : disque à y = 0,42, épaisseur 0,2)
KioskData.MODEL_NAME = "Kiosk"
KioskData.MAX_PARTS = 220 -- même plafond que Config.Assets.decorMaxParts ; au-delà le modèle est refusé (repli procédural)
KioskData.SIZE_TOLERANCE = 0.25 -- largeur mesurée du modèle à +-25 % de WIDTH, sinon mise à l'échelle (une fois) puis refus

-- Emplacement proposé (voir KIOSK_INTEGRATION_NOTES.md pour la vérification des obstacles) : sud-est du centre de la place, hors du tapis (z = 0, largeur 8),
-- des chemins B3 / B4, de la fontaine (10, -38) et des étals (z >= 36). Le comptoir regarde la halle (-40, 0).
KioskData.CENTER = { x = 14, z = 22 }
KioskData.FACE = { x = -40, z = 0 }

-- Les 4 interactions. `part` = nom de base de la pièce du modèle Blender (sans suffixe de couleur) ; `rel` = position locale du panneau dans le
-- repère du repli procédural (x = droite, z = vers l'arrière ; le comptoir est à z = -R) ; `ang` = rotation locale (rad) du panneau procédural.
local R = 6.3
KioskData.PANELS = {
	{ id = "shop", part = "PanneauBoutique", rel = { x = 0, z = -R }, ang = 0, action = "Ouvrir la boutique", object = "Boutique Robux", emoji = "💎", title = "BOUTIQUE", sub = "Robux et offres", color = { 255, 190, 60 } },
	{ id = "calendar", part = "PanneauCalendrier", rel = { x = 0, z = R }, ang = 3.14159265, action = "Voir le calendrier", object = "Calendrier des œufs", emoji = "📅", title = "CALENDRIER", sub = "Une récompense par jour", color = { 120, 200, 120 } },
	{ id = "odds", part = "PanneauProba", rel = { x = R, z = 0 }, ang = -1.5707963, action = "Voir les probabilités", object = "Probabilités et prix", emoji = "🎲", title = "PROBABILITÉS", sub = "Tapis et prix", color = { 120, 170, 255 } },
	{ id = "ranking", part = "PanneauClassement", rel = { x = -R, z = 0 }, ang = 1.5707963, action = "Voir le classement", object = "Classement de la saison", emoji = "🏆", title = "CLASSEMENT", sub = "Saison de l'Arène", color = { 255, 150, 90 } },
}
KioskData.LIGHT_PART = "Lueur" -- lanterne centrale du modèle (reçoit une PointLight si le modèle n'en a pas)
KioskData.BADGE_NAME = "PastilleCalendrier" -- pastille rouge posée au-dessus du panneau du calendrier

-- Prompts : distance d'activation côté client, portée de contrôle côté serveur (plus large : latence et marche), pause entre deux demandes d'un joueur.
KioskData.PROMPT = { hold = 0.2, distance = 11, requiresLineOfSight = false }
KioskData.SERVER_RANGE = 20 -- studs au centre du kiosque ; la validation serveur refuse au-delà
KioskData.COOLDOWN = 0.6 -- secondes entre deux actions acceptées d'un même joueur

-- Ambiance : kiosk_ambience (son approuvé fourni par la gestion du projet). Boucle, volume bas, atténuation par distance. Config.SOUNDS.kiosk_ambience, si
-- présent, remplace ces valeurs ; Config.SOUNDS_ENABLED = false : aucun Sound n'est créé.
KioskData.SOUND = { key = "kiosk_ambience", id = "rbxassetid://82723287691994", vol = 0.25, minDist = 14, maxDist = 75 }

KioskData.ACTIONS = { shop = true, calendar = true, odds = true, ranking = true }
KioskData.MAX_ENTRIES = 10 -- lignes du classement renvoyées

function KioskData.panel(id)
	for _, p in ipairs(KioskData.PANELS) do
		if p.id == id then
			return p
		end
	end
	return nil
end

-- Angle (radians, [-pi, pi]) du vecteur (x, z) dans le plan XZ, sans math.atan2 : atan(z / x) corrigé par quadrant.
function KioskData.angle(x, z)
	if type(x) ~= "number" or type(z) ~= "number" or x ~= x or z ~= z then
		return 0
	end
	if x == 0 then
		if z > 0 then
			return math.pi / 2
		elseif z < 0 then
			return -math.pi / 2
		end
		return 0
	end
	local a = math.atan(z / x)
	if x < 0 then
		if z >= 0 then
			return a + math.pi
		end
		return a - math.pi
	end
	return a
end

-- Rotation autour de Y (CFrame.Angles(0, theta, 0)) qui amène le vecteur local (lx, lz) sur la direction (ux, uz). Roblox : Y positif tourne (x, z) en
-- (x cos + z sin, -x sin + z cos), l'angle du vecteur DIMINUE de theta. Le repli procédural a son comptoir à (0, -1) (local -Z).
function KioskData.yawFor(lx, lz, ux, uz)
	if type(lx) ~= "number" or type(lz) ~= "number" or lx ~= lx or lz ~= lz or math.sqrt(lx * lx + lz * lz) < 1e-6 then
		lx, lz = 0, -1
	end
	local theta = KioskData.angle(lx, lz) - KioskData.angle(ux, uz)
	while theta > math.pi do
		theta = theta - 2 * math.pi
	end
	while theta < -math.pi do
		theta = theta + 2 * math.pi
	end
	return theta
end

-- Position monde d'un point local (lx, lz) du kiosque de centre (cx, cz) tourné de theta (même convention que yawFor).
function KioskData.toWorld(cx, cz, theta, lx, lz)
	local c, s = math.cos(theta), math.sin(theta)
	return cx + lx * c + lz * s, cz - lx * s + lz * c
end

-- Le disque (cx, cz, r) chevauche-t-il l'un des obstacles de Config.Map2 ? Retourne (false) ou (true, nom). margin = marge libre exigée (studs).
-- Obstacles : halle, fontaine, tapis et bac, étals, piste, portails, arrivée des tapis, bord de la place, chemins (distance au segment).
function KioskData.overlap(Map2, cx, cz, r, margin)
	margin = margin or 0
	local function d(ax, az)
		return math.sqrt((cx - ax) ^ 2 + (cz - az) ^ 2)
	end
	local function segDist(ax, az, bx, bz)
		local dx, dz = bx - ax, bz - az
		local len2 = dx * dx + dz * dz
		local t = len2 > 0 and math.max(0, math.min(1, ((cx - ax) * dx + (cz - az) * dz) / len2)) or 0
		return math.sqrt((cx - (ax + dx * t)) ^ 2 + (cz - (az + dz * t)) ^ 2)
	end
	local function rect(x0, x1, z0, z1)
		local nx, nz = math.max(x0, math.min(cx, x1)), math.max(z0, math.min(cz, z1))
		return math.sqrt((cx - nx) ^ 2 + (cz - nz) ^ 2)
	end
	local pl = Map2.plaza
	if d(pl.x, pl.z) + r + margin > pl.r then
		return true, "bord de la place"
	end
	if d(Map2.hall.x, Map2.hall.z) < Map2.hall.r + r + margin then
		return true, "halle"
	end
	if d(Map2.fountain.x, Map2.fountain.z) < Map2.fountain.r + r + margin then
		return true, "fontaine"
	end
	local b = Map2.belt
	if rect(b.x0, b.x1, b.z - b.width / 2, b.z + b.width / 2) < r + margin then
		return true, "tapis"
	end
	if d(b.bin.x, b.bin.z) < 6 + r + margin then
		return true, "bac du tapis"
	end
	for _, st in ipairs(Map2.stalls) do
		if rect(st.x - 5.5, st.x + 5.5, st.z - 4.3, st.z + 4.3) < r + margin then
			return true, "étal"
		end
	end
	local tk = Map2.track
	if rect(tk.x - tk.w / 2, tk.x + tk.w / 2, tk.z - tk.d / 2, tk.z + tk.d / 2) < r + margin then
		return true, "piste d'entraînement"
	end
	local ph = Map2.portalHub
	if rect(ph.x0 - 6, ph.x1 + 6, ph.z - 6, ph.z + 6) < r + margin then
		return true, "portails"
	end
	if d(Map2.plazaArrival.x, Map2.plazaArrival.z) < 4 + r + margin then
		return true, "arrivée des tapis"
	end
	for _, p in ipairs(Map2.paths) do
		if p.kind == "paved" and p.pts[1][1] == 0 and p.pts[1][2] == 0 then -- routes qui partent du centre de la place (B1 à B5)
			for k = 1, #p.pts - 1 do
				if segDist(p.pts[k][1], p.pts[k][2], p.pts[k + 1][1], p.pts[k + 1][2]) < Map2.pathHalf + r + margin then
					return true, "chemin " .. tostring(p.name)
				end
			end
		end
	end
	return false
end

return KioskData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX114"><Properties><string name="Name">DecorData</string><ProtectedString name="Source"><![CDATA[-- ModuleScript : ReplicatedStorage/Shared/DecorData
-- Lot 8B-décor : DONNÉES PURES des modèles Blender de décor de carte (lots 15, 16 et 17 de Assets-crees). Aucune logique, aucun service Roblox :
-- la logique est dans ServerScriptService/Decor (placement, budgets, repli procédural) et les tests dans tests/decor.luau.
-- Une « famille » = un modèle Blender + sa règle de pose RELATIVE à la carte (zone), sa taille cible, son empreinte, son quota et son repli procédural.
-- Les modèles déjà branchés AILLEURS ne sont PAS repris ici (voir `wired`) : maisons house.l2..l7 (Config.Assets.models.house), arbres lot 11
-- (models.trees), décor de village lot 12 (models.scenery). Les 12 modèles du lot 17 sont de NOUVELLES variétés qui s'ajoutent sans les remplacer.
--
-- Champs d'une famille :
--   id        identifiant InsertService du modèle (entier > 0) ; lot = lot de Assets-crees ; cap = plafond de Parts accepté au chargement
--   zone      règle de pose : "plazaRim" (couronne de la place du marché), "stallSide" (autour des étals), "region" (rectangle de la carte),
--             "pathSide" (le long des chemins pavés), "pathSign" (premier point d'un chemin hors de la place, avec libellé), "lakeShore",
--             "lakeWater", "lakeIsle", et les ANCRES "hall", "bigEgg", "arena", "belt" (superpositions d'un élément procédural existant)
--   count     nombre d'exemplaires voulus ; height | length = taille cible en studs (length = plus grande arête horizontale) ; r = rayon d'empreinte
--   share     part maximale du budget Blender (0..1) que la famille peut consommer ; fb = repli procédural { name, ... } ou nil (ancres : le procédural existe déjà)
--   fbMax     nombre maximal d'exemplaires de repli procédural pour la famille
local DecorData = {}

DecorData.version = 1
DecorData.keyPrefix = "m:decor." -- clé de statut Assets : "m:decor.<famille>" (rapport F3 : catégorie « decor »)

-- Budgets (Parts). `blender` = pire cas réel des modèles posés (coût MESURÉ au chargement, pas le plafond) ; `fallback` = Parts procédurales de repli.
-- Surchargés par Config.Assets.decorBudgetParts / decorFallbackParts. Somme <= 1240 : la carte reste sous Config.Map.totalBudgetParts (7000) (marge mesurée : 7000 - 4990 = 2010 dans le calcul de tests/run.luau).
DecorData.budget = { blender = 1000, fallback = 240 }

-- Kiosque central (autre mission) : disque réservé au centre de la place, rien n'y est posé. Surchargé par Config.Map2.kiosk ou Config.KIOSK ({ x, z, r }).
-- Mesure du modèle hub_kiosk : socle de diamètre 15,4 -> rayon 7,7 ; marge de circulation comprise.
DecorData.kiosk = { x = 0, z = 0, r = 12 }

-- Emprises déjà posées par Builder.dressArena (bancs et lampadaires de la place, positions fixes) : { x, z, r }.
DecorData.existing = {
	{ -20, -28, 3 }, { 20, 24, 3 }, { -18, 26, 3 }, { 48, 18, 3 }, -- props.bench
	{ 30, -22, 2.5 }, { -12, -42, 2.5 }, { -52, 22, 2.5 }, { 54, 8, 2.5 }, -- props.lamp
}

-- Fixtures de la place du marché (rayons d'exclusion, studs) ajoutés à ceux lus dans Config.Map2 (fontaine, halle, étals, tapis, bac, piste, portails, arrivée,
-- enclos de la poule, Grand Œuf, arches des bases, secrets). Marge de circulation autour de chaque élément.
DecorData.plaza = {
	fountainMargin = 4, hallMargin = 4, stallRadius = 8.5, portalPad = 8, arrivalRadius = 7, henRadius = 6, runeRadius = 5, archRadius = 8, secretRadius = 14,
	beltPad = { x0 = 3, x1 = 8, z0 = 14, z1 = 8 }, -- rectangle du tapis : x0 - x0pad .. bin.x + x1pad ; z : -(width/2 + z0) .. width/2 + z1 (panneau du tapis au nord)
	trackPad = 5,
}

-- Modèles déjà branchés ailleurs (NE PAS les poser ici) : clé Config.Assets.models.<groupe>.<clé> pour chaque modèle des lots 15 à 17 concerné.
DecorData.wired = {
	house_lvl2 = "house.l2", house_lvl3 = "house.l3", house_lvl4 = "house.l4", house_lvl5 = "house.l5", house_lvl6 = "house.l6", house_lvl7 = "house.l7",
}

-- Libellés des panneaux (sign_base est livré SANS lettrage : le texte est ajouté par le code), par chemin de Config.Map2.paths.
DecorData.signLabels = {
	B1 = "🏠 Base 1", B2 = "🏠 Base 2", B3 = "🏠 Base 3", B4 = "🏠 Base 4", B5 = "🏠 Base 5",
	Castle = "🏰 Château", Arena = "⚔️ Arène", MillLake = "🎣 Lac du Moulin",
}
DecorData.signPaths = { "B1", "B2", "B3", "B4", "B5", "Castle", "Arena", "MillLake" }

-- Ordre de pose = priorité sur le budget (les ancres d'abord : elles remplacent des éléments déjà là).
DecorData.order = {
	"hub_dome", "grand_oeuf", "arena_colosseum", "conveyor_belt",
	"stall_a", "stall_b", "flag_banner", "lantern_post", "crate_stack", "barrel_pair", "hay_bale", "well_small", "bush_round", "sign_base",
	"island_sakura", "lily_pad", "reeds",
	"bench_park", "flowerbed", "well_roofed", "boulder_cluster",
	"tree_wide", "tree_autumn", "tree_fork", "tree_pine_tier", "tree_dead", "stump_roots", "log_hollow",
}

local function rect(x0, x1, z0, z1)
	return { x0 = x0, x1 = x1, z0 = z0, z1 = z1 }
end

local F = {}
DecorData.families = F

---------------------------------------------------------------- Lot 15 : ancres (superpositions d'éléments procéduraux, repli = l'élément procédural reste)
-- Dôme du hall : 60 x 60 x 24,4 ramené à la largeur du hall (2 r + 2) et posé sur les 8 piliers (haut 15). Masque les gradins procéduraux HallDome / HallDomeTop.
F.hub_dome = { id = 106786001814640, lot = 15, cap = 250, zone = "hall", y0 = 15, spanPad = 2, share = 0.25, hide = { "HallDome", "HallDomeTop" }, dims = { 60, 24.4, 60 } }
-- Grand Œuf : 13,6 x 15,7 ; hauteur du Grand Œuf de la carte (Map2.bigEgg.h), posé sur la marche du monument (y 2,1) ; masque la Part GrandNid (lumière et étincelles restent).
F.grand_oeuf = { id = 140225439366673, lot = 15, cap = 150, zone = "bigEgg", y0 = 2.1, share = 0.15, hide = { "GrandNid" }, dims = { 13.6, 15.7, 13.6 } }
-- Colisée : 70,8 x 21 ramené au diamètre de l'arène (2 r), devant tourné vers l'entrée ; masque ArenaWall et ArenaSteps (les murs procéduraux gardent la collision).
F.arena_colosseum = { id = 105443469311651, lot = 15, cap = 300, zone = "arena", y0 = 0, share = 0.30, hide = { "ArenaWall", "ArenaSteps" }, dims = { 70.8, 21, 70.8 } }
-- Tapis roulant : tuiles de 12 x 4,1 x 1,5 (long axe X) posées en `lanes` rangées sur la longueur du tapis, + conveyor_end à l'extrémité (côté bac). Hauteur du dessus
-- <= topY (sous le centre des œufs : Main.BELT_Y = 3, œuf de 3 de haut -> dessous à 1,5). TOUT OU RIEN : si le coût total dépasse la part, le tapis procédural reste.
-- Masque CentralBelt, BeltRail, BeltMark. Les dimensions de conveyor_end ne sont pas données par la spec : mêmes que la tuile (à vérifier dans Studio).
F.conveyor_belt = { id = 110718997928428, lot = 15, cap = 60, zone = "belt", topY = 1.3, share = 0.25, hide = { "CentralBelt", "BeltRail", "BeltMark" }, dims = { 12, 1.5, 4.1 }, endKey = "conveyor_end" }
F.conveyor_end = { id = 107430030694559, lot = 15, cap = 60, zone = "beltEnd", share = 0, dims = { 12, 1.5, 4.1 } }

---------------------------------------------------------------- Lot 16 : accessoires de marché
-- Étals décoratifs (sans fonction de jeu) en couronne de la place, de face vers le centre ; les 3 étals interactifs procéduraux restent intacts.
F.stall_a = { id = 121243958605530, lot = 16, cap = 90, zone = "plazaRim", ring = { 30, 53 }, count = 1, height = 8, r = 6, gap = 2, share = 0.08, fb = { name = "stall", awning = { 214, 90, 80 } }, fbMax = 2 }
F.stall_b = { id = 94658977878853, lot = 16, cap = 90, zone = "plazaRim", ring = { 30, 53 }, count = 1, height = 8, r = 6, gap = 2, share = 0.08, fb = { name = "stall", awning = { 90, 160, 214 } }, fbMax = 2 }
