Config.SHIELD_PER_LEVEL = 10

function Config.stealTime(level)
	return 1.3 * 0.85 ^ level
end

function Config.walkSpeed(speedStat)
	return 16 + 44 * (1 - math.exp(-speedStat / 150))
end

function Config.rebirthCost(rb)
	return 5e7 * 7 ^ rb
end

