<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBXB368736F7C2A49908757AEDC1DD77758"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBXB0C67D308FDD48B090F9AB840BE09A99"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXDF66D2AF0A9340D0BD7102AD6E0D19D4"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX2EBCEEA7F9634753A0862BCD26E19948"><Properties><string name="Name">AnimLogic</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Logique pure des animations (testable hors Studio) : activation par Config.Animations,
-- exécution protégée (pcall) et fonctions de courbes/angles.

local AnimLogic = {}

function AnimLogic.enabled(cfg: any, key: string): boolean
	return type(cfg) == "table" and cfg.Enabled == true and cfg[key] == true
end

-- Exécute fn(...) seulement si l'animation `key` est active ; une erreur est capturée (le jeu continue).
function AnimLogic.run(cfg: any, key: string, fn: (...any) -> (), ...: any): boolean
	if not AnimLogic.enabled(cfg, key) then
		return false
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[FestinTRex] animation « " .. key .. " » : " .. tostring(err))
	end
	return ok
end

-- Rebond classique (0 -> 1) avec plusieurs rebonds amortis.
function AnimLogic.bounceOut(t: number): number
	t = math.clamp(t, 0, 1)
	if t < 1 / 2.75 then
		return 7.5625 * t * t
	elseif t < 2 / 2.75 then
		t -= 1.5 / 2.75
		return 7.5625 * t * t + 0.75
	elseif t < 2.5 / 2.75 then
		t -= 2.25 / 2.75
		return 7.5625 * t * t + 0.9375
	end
	t -= 2.625 / 2.75
	return 7.5625 * t * t + 0.984375
end

function AnimLogic.easeOutBack(t: number): number
	t = math.clamp(t, 0, 1)
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

-- Hauteur d'un objet qui rebondit : 0 en t=0, amortie, 0 en t=1.
function AnimLogic.bounceHeight(t: number, bounces: number, peak: number): number
	t = math.clamp(t, 0, 1)
	local decay = (1 - t) ^ 2
	return math.abs(math.sin(t * math.pi * bounces)) * peak * decay
end

-- Cap (yaw) pour qu'une tête en (hx,hz) regardant vers +Z se tourne vers (tx,tz), borné à ±maxAngle.
-- Une cible derrière la tête ne la tourne pas.
function AnimLogic.aimYaw(hx: number, hz: number, tx: number, tz: number, maxAngle: number): number
	local dx, dz = tx - hx, tz - hz
	if dz <= 0.001 then
		return 0
	end
	return math.clamp(math.atan2(dx, dz), -maxAngle, maxAngle)
end

-- Levée de patte d'un cycle de marche sur place : jamais négative (la patte ne passe pas sous le sol).
function AnimLogic.stompLift(t: number, amplitude: number, speed: number, phase: number): number
	return amplitude * math.max(0, math.sin(t * speed + phase))
end

return AnimLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDBAA2D1B86F44B64A49525DD27152D5F"><Properties><string name="Name">Ballistics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Balistique pure (nombres, pas de Vector3) : utilisée à l'identique par le serveur (validation)
-- et par les clients (animation), donc l'arc affiché correspond exactement à l'arc calculé.

local Ballistics = {}

function Ballistics.flightTime(distance: number, speed: number, minT: number, maxT: number): number
	return math.clamp(distance / speed, minT, maxT)
end

-- Vitesse initiale pour atteindre (tx,ty,tz) depuis (ox,oy,oz) en T secondes, gravité g (>0, vers -Y).
function Ballistics.launchVelocity(ox: number, oy: number, oz: number, tx: number, ty: number, tz: number, T: number, g: number): (number, number, number)
	return (tx - ox) / T, (ty - oy) / T + 0.5 * g * T, (tz - oz) / T
end

function Ballistics.position(ox: number, oy: number, oz: number, vx: number, vy: number, vz: number, t: number, g: number): (number, number, number)
	return ox + vx * t, oy + vy * t - 0.5 * g * t * t, oz + vz * t
end

return Ballistics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDCDA63FEC7A7458584A44F22427123AA"><Properties><string name="Name">CinematicLogic</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Logique pure des cinématiques (testable hors Studio) : règles de lancement (réglages, « une seule fois »,
-- délai de repos), état de lecture, durée maximale, reprise après « Passer », choix du plan et interpolation caméra.
-- Aucune dépendance Roblox : le client applique le résultat à la caméra.

local CinematicLogic = {}
CinematicLogic.__index = CinematicLogic

function CinematicLogic.new(cfg: any)
	return setmetatable({ cfg = cfg, playing = nil, startedAt = 0, duration = 0, last = {}, skipped = 0 }, CinematicLogic)
end

-- Durée totale d'une séquence (somme des plans), plafonnée à cfg.MaxSeconds.
function CinematicLogic.totalDuration(seq: any, maxSeconds: number): number
	local total = 0
	for _, shot in ipairs(seq) do
		total += shot.Dur
	end
	return math.min(total, maxSeconds)
end

local function isOnce(cfg: any, id: string): boolean
	for _, v in ipairs(cfg.Once) do
		if v == id then
			return true
		end
	end
	return false
end

-- Peut-on lancer la cinématique `id` ? Retourne (ok, raison).
-- `seen` : table des cinématiques déjà vues (persistée côté serveur).
function CinematicLogic.canPlay(self: any, id: string, now: number, seen: any): (boolean, string?)
	local cfg = self.cfg
	if type(cfg) ~= "table" or cfg.Enabled ~= true then
		return false, "désactivées"
	end
	local flagKey = if string.sub(id, 1, 5) == "zone_" then "Zone" else id
	if cfg.Flags[flagKey] ~= true then
		return false, "désactivée"
	end
	if self.playing then
		return false, "déjà en cours"
	end
	if isOnce(cfg, id) and seen and seen[id] then
		return false, "déjà vue"
	end
	local cooldown = cfg.Cooldowns[id]
	if cooldown and self.last[id] and now - self.last[id] < cooldown then
		return false, "repos"
	end
	return true, nil
end

-- Démarre. `seq` = liste de plans. Retourne (ok, durée).
function CinematicLogic.start(self: any, id: string, now: number, seen: any, seq: any): (boolean, number)
	local ok = CinematicLogic.canPlay(self, id, now, seen)
	if not ok or type(seq) ~= "table" or #seq == 0 then
		return false, 0
	end
	self.playing = id
	self.startedAt = now
	self.duration = CinematicLogic.totalDuration(seq, self.cfg.MaxSeconds)
	self.last[id] = now
	return true, self.duration
end

-- « Passer » : revient immédiatement à l'état libre (le joueur reprend la main), les autres cinématiques restent possibles.
function CinematicLogic.skip(self: any): boolean
	if not self.playing then
		return false
	end
	self.playing = nil
	self.skipped += 1
	return true
end

-- Fin normale ou erreur : même retour à l'état libre.
function CinematicLogic.finish(self: any)
	self.playing = nil
end

-- État à l'instant `now` : ("idle" | "playing" | "done", écoulé). Passe à "done" (et libère) à la fin de la durée.
function CinematicLogic.update(self: any, now: number): (string, number)
	if not self.playing then
		return "idle", 0
	end
	local elapsed = now - self.startedAt
	if elapsed >= self.duration then
		self.playing = nil
		return "done", self.duration
	end
	return "playing", elapsed
end

-- Plan courant : (index, avancement 0..1 dans le plan).
function CinematicLogic.shotAt(seq: any, elapsed: number): (number, number)
	local acc = 0
	for i, shot in ipairs(seq) do
		if elapsed < acc + shot.Dur then
			return i, math.clamp((elapsed - acc) / shot.Dur, 0, 1)
		end
		acc += shot.Dur
	end
	return #seq, 1
end

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Position caméra et point visé pour un plan à l'avancement t (interpolation douce).
function CinematicLogic.camera(shot: any, t: number): ({ number }, { number })
	local k = smooth(math.clamp(t, 0, 1))
	local from, to = shot.From, shot.To or shot.From
	local lookFrom, lookTo = shot.Look, shot.LookTo or shot.Look
	local pos, look = {}, {}
	for i = 1, 3 do
		pos[i] = from[i] + (to[i] - from[i]) * k
		look[i] = lookFrom[i] + (lookTo[i] - lookFrom[i]) * k
	end
	return pos, look
end

return CinematicLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46B6F9C0E1F240D38D0B73EDE039A896"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Configuration centrale du jeu « Festin du T-Rex ».
-- Toutes les valeurs d'équilibrage sont ici : aucune valeur magique dans les services.

