<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX4F7D80BE872D43349FB9904595BBB14D"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBXECD30ADA630D42B4815B21367B62B117"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX48467837DE8C4CC1B445699322ADEFCF"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX26135232574F4A9E98EB54E8A01BA498"><Properties><string name="Name">Ballistics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Balistique pure (nombres, pas de Vector3) : utilisée à l'identique par le serveur (validation)
-- et par les clients (animation), donc l'arc affiché correspond exactement à l'arc calculé.

local Ballistics = {}

function Ballistics.flightTime(distance: number, speed: number, minT: number, maxT: number): number
	return math.clamp(distance / speed, minT, maxT)
end

-- Vitesse initiale pour atteindre (tx,ty,tz) depuis (ox,oy,oz) en T secondes, gravité g (>0, vers -Y).
function Ballistics.launchVelocity(ox: number, oy: number, oz: number, tx: number, ty: number, tz: number, T: number, g: number): (number, number, number)
	return (tx - ox) / T, (ty - oy) / T + 0.5 * g * T, (tz - oz) / T
end

function Ballistics.position(ox: number, oy: number, oz: number, vx: number, vy: number, vz: number, t: number, g: number): (number, number, number)
	return ox + vx * t, oy + vy * t - 0.5 * g * t * t, oz + vz * t
end

return Ballistics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDF8093EF61674DEE8187D775C8F9F58B"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
