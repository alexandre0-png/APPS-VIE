}

-- Compagnons
Config.PetSlots = 3
Config.Rarities = {
	{ Id = "commun", Name = "Commun", Color = { 190, 190, 190 } },
	{ Id = "rare", Name = "Rare", Color = { 80, 160, 255 } },
	{ Id = "epique", Name = "Épique", Color = { 190, 90, 255 } },
